<?php

/**
 * @file
 * Install, update and uninstall functions for the markaspot profile.
 */

use Drupal\Component\Uuid\Uuid;
use Drupal\Core\Config\Entity\ConfigEntityInterface;
use Drupal\Component\Serialization\Yaml;
use Drupal\Core\Config\FileStorage;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\Node;
use Drupal\taxonomy\Entity\Term;
use Drupal\taxonomy\Entity\Vocabulary;
use Drupal\user\Entity\Role;

/**
 * Enables the twig_tweak and markaspot_trend modules.
 */
function markaspot_update_8001() {
  \Drupal::service('module_installer')->install(['twig_tweak']);
}

/**
 * Update the stats view.
 */
function markaspot_update_8002() {
  \Drupal::configFactory()->getEditable('views.view.stats')->delete();
  \Drupal::service('module_installer')->install(['markaspot_trend']);
}

/**
 * Enable Mark-a-Spot Front module.
 */
function markaspot_update_8003() {
  \Drupal::service('module_installer')->install(['markaspot_front']);
}

/**
 * Enable Mark-a-Spot Request ID module.
 */
function markaspot_update_8004() {
  \Drupal::service('module_installer')->install(['markaspot_request_id']);
  markaspot_update_ids();
}

/**
 * Move Service Request IDs.
 */
function markaspot_update_ids() {

  $nids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'service_request')->execute();
  $nodes = Node::loadMultiple($nids);

  foreach ($nodes as $node) {
    $node->set('request_id', $node->uuid());
    $node->save();
  }
  \Drupal::service('module_installer')->uninstall(['markaspot_uuid']);
}

/**
 * Disable Shariff module.
 */
function markaspot_update_9600() {
  \Drupal::service("module_installer")->uninstall(["shariff"]);
}

/**
 * Remove obsolete action configurations.
 */
function markaspot_update_9700() {
  // List of obsolete action configurations to delete.
  $obsolete_actions = [
    'system.action.comment_delete_action',
    'system.action.node_delete_action',
  ];

  $config_factory = \Drupal::configFactory();
  $count = 0;
  $deleted = [];

  foreach ($obsolete_actions as $config_name) {
    if ($config_factory->get($config_name)->get()) {
      $config_factory->getEditable($config_name)->delete();
      $deleted[] = $config_name;
      $count++;
    }
  }

  if ($count > 0) {
    return t('Removed @count obsolete action configurations: @names', [
      '@count' => $count,
      '@names' => implode(', ', $deleted),
    ]);
  }
  else {
    return t('No obsolete action configurations found.');
  }
}

/**
 * Mark-a-Spot Map module is now optional for headless setups.
 */
function markaspot_update_9701() {
  $module_handler = \Drupal::moduleHandler();

  // Check if markaspot_map is installed.
  if ($module_handler->moduleExists('markaspot_map')) {
    return t('The markaspot_map module is now optional. It is only needed if you use Drupal theme-based map blocks. For headless setups using markaspot_nuxt, all map configuration is now stored independently in markaspot_nuxt.settings. You can uninstall markaspot_map if you only use the Nuxt frontend: drush pm:uninstall markaspot_map');
  }

  return t('Mark-a-Spot Map module was not installed.');
}

/**
 * Uninstall deprecated markaspot_privacy module.
 */
function markaspot_update_9702() {
  $module_handler = \Drupal::moduleHandler();

  if ($module_handler->moduleExists('markaspot_privacy')) {
    \Drupal::service('module_installer')->uninstall(['markaspot_privacy']);
    return t('The markaspot_privacy module has been uninstalled. Privacy features are now handled by the Nuxt frontend.');
  }

  return t('The markaspot_privacy module was not installed.');
}

/**
 * Repair entity definitions that may be missing after database imports.
 *
 * This update fixes a common issue when importing production databases to
 * development environments. The entity.definitions.installed key_value entries
 * may be incomplete, causing subsequent module installations to fail with
 * errors like "Table information not available for the 'field_*' field".
 *
 * This must run before any update that installs modules depending on
 * entity field definitions (like markaspot_group which depends on gnode).
 */
function markaspot_update_11799() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $kv = \Drupal::keyValue('entity.definitions.installed');
  $field_manager = \Drupal::service('entity_field.manager');

  // Entity types with SQL storage that need field_storage_definitions.
  $content_entity_types = [
    'block_content', 'comment', 'file', 'media', 'node',
    'paragraph', 'path_alias', 'shortcut', 'taxonomy_term', 'user',
    'group', 'group_relationship',
  ];

  $fixed = [];
  foreach ($content_entity_types as $entity_type_id) {
    try {
      $def = $entity_type_manager->getDefinition($entity_type_id, FALSE);
      if (!$def) {
        continue;
      }

      // Store entity type definition if missing.
      $stored_type = $kv->get($entity_type_id . '.entity_type');
      if (!$stored_type) {
        $kv->set($entity_type_id . '.entity_type', $def);
        $fixed[] = $entity_type_id . '.entity_type';
      }

      // Store field storage definitions if missing.
      $stored_fields = $kv->get($entity_type_id . '.field_storage_definitions');
      if (!$stored_fields) {
        $field_defs = $field_manager->getFieldStorageDefinitions($entity_type_id);
        if (!empty($field_defs)) {
          $kv->set($entity_type_id . '.field_storage_definitions', $field_defs);
          $fixed[] = $entity_type_id . '.field_storage_definitions';
        }
      }
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot')->warning('Could not repair entity definitions for @type: @message', [
        '@type' => $entity_type_id,
        '@message' => $e->getMessage(),
      ]);
    }
  }

  if (!empty($fixed)) {
    return t('Repaired missing entity definitions: @items', [
      '@items' => implode(', ', $fixed),
    ]);
  }

  return t('All entity definitions were already in place.');
}

/**
 * Install json_form_widget module for markaspot_nuxt.
 *
 * This update must run before 11801 to ensure the json_form_widget module
 * is available. Sites upgrading from 11.7.x may not have it installed yet,
 * as markaspot_nuxt uses it as a soft dependency (conditional service
 * registration via MarkaspotNuxtServiceProvider).
 *
 * Note: This hook can be removed once all clients have passed schema
 * version 11800. Both upstream patches (#3563296, #3564474) are merged
 * in json_form_widget 1.0.0-alpha2. The dev/composer.json patches and
 * 1.x-dev pin can be dropped in favor of ^1.
 */
function markaspot_update_11800() {
  $module_handler = \Drupal::moduleHandler();

  // Check if markaspot_nuxt is enabled (indicating this is an upgrade).
  if (!$module_handler->moduleExists('markaspot_nuxt')) {
    return t('markaspot_nuxt module not installed. Skipping json_form_widget installation.');
  }

  // Install json_form_widget if not already present.
  if (!$module_handler->moduleExists('json_form_widget')) {
    try {
      \Drupal::service('module_installer')->install(['json_form_widget']);
      return t('Successfully installed json_form_widget module required by markaspot_nuxt.');
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot')->error('Failed to install json_form_widget: @message', [
        '@message' => $e->getMessage(),
      ]);
      return t('Failed to install json_form_widget: @message. Please install it manually: drush en json_form_widget', [
        '@message' => $e->getMessage(),
      ]);
    }
  }

  return t('json_form_widget module already installed.');
}

/**
 * Configure group type settings for legacy sites.
 *
 * Detects if the site uses legacy group type naming ('organisation' instead
 * of 'org', 'jurisdiction' instead of 'jur') and configures the settings
 * accordingly. This allows legacy sites to continue using their existing
 * group types without migration.
 *
 * Also creates a default jurisdiction group if none exists, populating it
 * with values from existing site configuration.
 */
function markaspot_update_11801() {
  // Check if Group module is installed.
  $module_handler = \Drupal::moduleHandler();
  if (!$module_handler->moduleExists('group')) {
    return t('Group module not installed. Skipping group type configuration.');
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  $group_type_storage = $entity_type_manager->getStorage('group_type');
  $group_storage = $entity_type_manager->getStorage('group');
  $config = \Drupal::configFactory()->getEditable('markaspot_open311.settings');
  $changes = [];

  // Detect legacy organisation naming.
  $has_organisation = $group_type_storage->load('organisation') !== NULL;
  $has_org = $group_type_storage->load('org') !== NULL;

  if ($has_organisation && !$has_org) {
    $config->set('group_filter_type', 'organisation');
    $changes[] = 'group_filter_type = organisation';
  }

  // Detect legacy jurisdiction naming.
  $has_jurisdiction = $group_type_storage->load('jurisdiction') !== NULL;
  $has_jur = $group_type_storage->load('jur') !== NULL;

  if ($has_jurisdiction && !$has_jur) {
    $config->set('jurisdiction_group_type', 'jurisdiction');
    $changes[] = 'jurisdiction_group_type = jurisdiction';
  }

  // Determine active jurisdiction group type.
  $jur_type = NULL;
  if ($has_jur) {
    $jur_type = 'jur';
  }
  elseif ($has_jurisdiction) {
    $jur_type = 'jurisdiction';
  }

  // Create default jurisdiction group if none exists.
  if ($jur_type) {
    $existing_groups = $group_storage->loadByProperties(['type' => $jur_type]);

    if (empty($existing_groups)) {
      $default_group = _markaspot_create_default_jurisdiction($jur_type, $group_storage);
      if ($default_group) {
        $changes[] = t('Created default jurisdiction group: @name', [
          '@name' => $default_group->label(),
        ]);
      }
    }
  }

  if (!empty($changes)) {
    $config->save();
    return implode("\n", $changes);
  }

  return t('No legacy group type naming detected. Using default settings.');
}

/**
 * Creates a default jurisdiction group from existing site configuration.
 *
 * @param string $group_type
 *   The jurisdiction group type ID ('jur' or 'jurisdiction').
 * @param \Drupal\Core\Entity\EntityStorageInterface $group_storage
 *   The group entity storage.
 *
 * @return \Drupal\group\Entity\GroupInterface|null
 *   The created group entity, or NULL on failure.
 */
function _markaspot_create_default_jurisdiction($group_type, $group_storage) {
  $config_factory = \Drupal::configFactory();

  // Get site name for the group label.
  $site_config = $config_factory->get('system.site');
  $site_name = $site_config->get('name') ?: 'Default Jurisdiction';

  // Generate slug from site name.
  $slug = \Drupal::service('transliteration')->transliterate($site_name);
  $slug = preg_replace('/[^a-z0-9]+/i', '-', strtolower($slug));
  $slug = trim($slug, '-');
  $slug = substr($slug, 0, 64);

  // Build nuxt_config from existing markaspot_nuxt.settings.
  $nuxt_config = $config_factory->get('markaspot_nuxt.settings');
  $nuxt_json = [];

  if ($nuxt_config && !$nuxt_config->isNew()) {
    // Map center.
    $center_lat = $nuxt_config->get('center_lat');
    $center_lng = $nuxt_config->get('center_lng');
    $zoom = $nuxt_config->get('zoom_initial');

    if ($center_lat !== NULL && $center_lng !== NULL) {
      $nuxt_json['map'] = [
        'center' => [$center_lng, $center_lat],
        'zoom' => $zoom ?: 13,
      ];
    }

    // Client info from site config.
    $nuxt_json['client'] = [
      'name' => $site_name,
      'shortName' => substr($site_name, 0, 20),
    ];
  }

  // Create the group entity.
  $group_data = [
    'type' => $group_type,
    'label' => $site_name,
    'status' => 1,
  ];

  $group = $group_storage->create($group_data);

  // Set field_slug if available.
  if ($group->hasField('field_slug')) {
    $group->set('field_slug', $slug);
  }

  // Set field_nuxt_config if available.
  if ($group->hasField('field_nuxt_config') && !empty($nuxt_json)) {
    $group->set('field_nuxt_config', json_encode($nuxt_json, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
  }

  try {
    $group->save();
    return $group;
  }
  catch (\Exception $e) {
    \Drupal::logger('markaspot')->error('Failed to create default jurisdiction: @message', [
      '@message' => $e->getMessage(),
    ]);
    return NULL;
  }
}

/**
 * Install markaspot_group module and create jur group field infrastructure.
 *
 * Sites upgrading from 7.x need the markaspot_group module installed and
 * the jur group type with all required fields for the Nuxt frontend.
 */
function markaspot_update_11802() {
  $module_handler = \Drupal::moduleHandler();
  $messages = [];

  // Step 1: Install markaspot_group module if not present.
  if (!$module_handler->moduleExists('markaspot_group')) {
    try {
      \Drupal::service('module_installer')->install(['markaspot_group']);
      // Drupal sets schema to the highest hook (11901) on fresh install,
      // which means hooks 11900/11901 never run. Reset to 11801 so they
      // execute during this update run (field_jurisdiction + backfill).
      \Drupal::keyValue('system.schema')->set('markaspot_group', 11801);
      $messages[] = t('Installed markaspot_group module with jur/org group types.');
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot')->error('Failed to install markaspot_group: @message', [
        '@message' => $e->getMessage(),
      ]);
      return t('Failed to install markaspot_group module: @message', [
        '@message' => $e->getMessage(),
      ]);
    }
  }
  else {
    $messages[] = t('markaspot_group module already installed.');
  }

  // Step 2: Create missing field storages not included in module's config.
  $entity_type_manager = \Drupal::entityTypeManager();
  $field_storage_config = $entity_type_manager->getStorage('field_storage_config');

  $missing_storages = [
    'field_slug' => [
      'field_name' => 'field_slug',
      'entity_type' => 'group',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => ['max_length' => 64],
    ],
    'field_logo_dark' => [
      'field_name' => 'field_logo_dark',
      'entity_type' => 'group',
      'type' => 'image',
      'cardinality' => 1,
      'settings' => [
        'uri_scheme' => 'public',
        'default_image' => [
          'uuid' => NULL,
          'alt' => '',
          'title' => '',
          'width' => NULL,
          'height' => NULL,
        ],
        'target_type' => 'file',
        'display_field' => FALSE,
        'display_default' => FALSE,
      ],
    ],
    'field_logo_light' => [
      'field_name' => 'field_logo_light',
      'entity_type' => 'group',
      'type' => 'image',
      'cardinality' => 1,
      'settings' => [
        'uri_scheme' => 'public',
        'default_image' => [
          'uuid' => NULL,
          'alt' => '',
          'title' => '',
          'width' => NULL,
          'height' => NULL,
        ],
        'target_type' => 'file',
        'display_field' => FALSE,
        'display_default' => FALSE,
      ],
    ],
    'field_font_body' => [
      'field_name' => 'field_font_body',
      'entity_type' => 'group',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => ['max_length' => 255],
    ],
    'field_font_heading' => [
      'field_name' => 'field_font_heading',
      'entity_type' => 'group',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => ['max_length' => 255],
    ],
    'field_custom_css' => [
      'field_name' => 'field_custom_css',
      'entity_type' => 'group',
      'type' => 'text_long',
      'cardinality' => 1,
      'module' => 'text',
    ],
  ];

  foreach ($missing_storages as $field_name => $definition) {
    $existing = $field_storage_config->load('group.' . $field_name);
    if (!$existing) {
      try {
        $field_storage_config->create($definition)->save();
        $messages[] = t('Created field storage: @field', ['@field' => $field_name]);
      }
      catch (\Exception $e) {
        \Drupal::logger('markaspot')->warning('Could not create field storage @field: @message', [
          '@field' => $field_name,
          '@message' => $e->getMessage(),
        ]);
      }
    }
  }

  // Step 3: Create field instances on jur group type.
  $field_config = $entity_type_manager->getStorage('field_config');
  $group_type_storage = $entity_type_manager->getStorage('group_type');

  // Determine jur group type (could be 'jur' or 'jurisdiction').
  $jur_type = NULL;
  if ($group_type_storage->load('jur')) {
    $jur_type = 'jur';
  }
  elseif ($group_type_storage->load('jurisdiction')) {
    $jur_type = 'jurisdiction';
  }

  if ($jur_type) {
    $field_instances = [
      'field_slug' => [
        'field_name' => 'field_slug',
        'entity_type' => 'group',
        'bundle' => $jur_type,
        'label' => 'URL Slug',
        'description' => 'Short identifier for URLs (e.g., "bonn", "koeln")',
        'required' => FALSE,
      ],
      'field_logo_dark' => [
        'field_name' => 'field_logo_dark',
        'entity_type' => 'group',
        'bundle' => $jur_type,
        'label' => 'Logo (Dark Mode)',
        'required' => FALSE,
      ],
      'field_logo_light' => [
        'field_name' => 'field_logo_light',
        'entity_type' => 'group',
        'bundle' => $jur_type,
        'label' => 'Logo (Light Mode)',
        'required' => FALSE,
      ],
      'field_font_body' => [
        'field_name' => 'field_font_body',
        'entity_type' => 'group',
        'bundle' => $jur_type,
        'label' => 'Body Font',
        'description' => 'Font family for body text',
        'required' => FALSE,
      ],
      'field_font_heading' => [
        'field_name' => 'field_font_heading',
        'entity_type' => 'group',
        'bundle' => $jur_type,
        'label' => 'Heading Font',
        'description' => 'Font family for headings',
        'required' => FALSE,
      ],
      'field_custom_css' => [
        'field_name' => 'field_custom_css',
        'entity_type' => 'group',
        'bundle' => $jur_type,
        'label' => 'Custom CSS',
        'description' => 'Custom CSS for this jurisdiction',
        'required' => FALSE,
      ],
    ];

    foreach ($field_instances as $field_name => $definition) {
      $existing = $field_config->load('group.' . $jur_type . '.' . $field_name);
      if (!$existing) {
        // Check if field storage exists.
        $storage = $field_storage_config->load('group.' . $field_name);
        if ($storage) {
          try {
            $field_config->create($definition)->save();
            $messages[] = t('Created field instance: @field on @type', [
              '@field' => $field_name,
              '@type' => $jur_type,
            ]);
          }
          catch (\Exception $e) {
            \Drupal::logger('markaspot')->warning('Could not create field @field: @message', [
              '@field' => $field_name,
              '@message' => $e->getMessage(),
            ]);
          }
        }
      }
    }
  }

  return empty($messages) ? t('Jur group infrastructure already complete.') : implode("\n", $messages);
}

/**
 * Create field_all_groups_member on user entity for Group 3 upgrade.
 *
 * This field allows marking users as automatic members of all groups.
 * Required after upgrading from Group 2.x to 3.x.
 */
function markaspot_update_11803() {
  $entity_type_manager = \Drupal::entityTypeManager();

  // Check if field storage already exists.
  $field_storage = $entity_type_manager
    ->getStorage('field_storage_config')
    ->load('user.field_all_groups_member');

  if (!$field_storage) {
    // Create field storage.
    $field_storage = $entity_type_manager
      ->getStorage('field_storage_config')
      ->create([
        'field_name' => 'field_all_groups_member',
        'entity_type' => 'user',
        'type' => 'boolean',
        'cardinality' => 1,
        'translatable' => TRUE,
        'settings' => [],
      ]);
    $field_storage->save();
    \Drupal::messenger()->addStatus(t('Created field_all_groups_member storage on user entity.'));
  }

  // Check if field instance exists.
  $field_config = $entity_type_manager
    ->getStorage('field_config')
    ->load('user.user.field_all_groups_member');

  if (!$field_config) {
    // Create field instance.
    $field_config = $entity_type_manager
      ->getStorage('field_config')
      ->create([
        'field_storage' => $field_storage,
        'bundle' => 'user',
        'label' => 'All Groups Member',
        'description' => 'When enabled, this user will automatically become a member of all existing and future groups with admin role.',
        'required' => FALSE,
        'default_value' => [['value' => 0]],
        'settings' => [
          'on_label' => t('Yes'),
          'off_label' => t('No'),
        ],
      ]);
    $field_config->save();
    \Drupal::messenger()->addStatus(t('Created field_all_groups_member field on user bundle.'));
  }

  return t('field_all_groups_member field ensured on user entity.');
}

/**
 * Add taxonomy jurisdiction isolation fields and migrate existing data.
 *
 * Creates field_jurisdiction on service_category (entity_reference to group
 * jur) and field_open311_mapping on service_status (list_string). Assigns
 * all existing terms to the first available jurisdiction and sets status
 * mapping values based on current markaspot_open311.settings config.
 */
function markaspot_update_11900() {
  $entity_type_manager = \Drupal::entityTypeManager();

  // Step 1: Create field_jurisdiction on service_category if missing.
  $field_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_jurisdiction');
  if (!$field_storage) {
    $field_storage = FieldStorageConfig::create([
      'field_name' => 'field_jurisdiction',
      'entity_type' => 'taxonomy_term',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'group'],
      'cardinality' => 1,
      'translatable' => FALSE,
    ]);
    $field_storage->save();
  }

  $field_config = FieldConfig::loadByName('taxonomy_term', 'service_category', 'field_jurisdiction');
  if (!$field_config) {
    FieldConfig::create([
      'field_storage' => $field_storage,
      'bundle' => 'service_category',
      'label' => 'Jurisdiction',
      'description' => 'The jurisdiction this category belongs to.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => ['jur' => 'jur'],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
  }

  // Step 1b: Create field_jurisdiction on service_status if missing.
  $field_config_status_jur = FieldConfig::loadByName('taxonomy_term', 'service_status', 'field_jurisdiction');
  if (!$field_config_status_jur) {
    FieldConfig::create([
      'field_storage' => $field_storage,
      'bundle' => 'service_status',
      'label' => 'Jurisdiction',
      'description' => 'The jurisdiction this status belongs to.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => ['jur' => 'jur'],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
  }

  // Step 2: Create field_open311_mapping on service_status if missing.
  $mapping_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_open311_mapping');
  if (!$mapping_storage) {
    $mapping_storage = FieldStorageConfig::create([
      'field_name' => 'field_open311_mapping',
      'entity_type' => 'taxonomy_term',
      'type' => 'list_string',
      'settings' => [
        'allowed_values' => [
          'open' => 'Open',
          'closed' => 'Closed',
          'initial' => 'Initial (new requests)',
        ],
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
      'module' => 'options',
    ]);
    $mapping_storage->save();
  }

  $mapping_field = FieldConfig::loadByName('taxonomy_term', 'service_status', 'field_open311_mapping');
  if (!$mapping_field) {
    FieldConfig::create([
      'field_storage' => $mapping_storage,
      'bundle' => 'service_status',
      'label' => 'Open311 Status Mapping',
      'description' => 'Maps this status to the Open311 open/closed value. "Initial" marks the default status for new requests.',
      'required' => TRUE,
      'default_value' => [['value' => 'open']],
      'settings' => [],
    ])->save();
  }

  // Step 3: Assign existing service_category terms to first jurisdiction.
  $groups = $entity_type_manager->getStorage('group')
    ->loadByProperties(['type' => 'jur']);
  $default_group = reset($groups);

  if ($default_group) {
    $default_gid = $default_group->id();
    $categories = $entity_type_manager->getStorage('taxonomy_term')
      ->loadByProperties(['vid' => 'service_category']);
    $cat_count = 0;
    foreach ($categories as $term) {
      if ($term->hasField('field_jurisdiction') && $term->get('field_jurisdiction')->isEmpty()) {
        $term->set('field_jurisdiction', $default_gid);
        $term->save();
        $cat_count++;
      }
    }
  }

  // Step 4: Set field_open311_mapping on existing service_status terms.
  $config = \Drupal::config('markaspot_open311.settings');
  $status_closed = array_values($config->get('status_closed') ?: []);
  $status_start = $config->get('status_open_start');

  $statuses = $entity_type_manager->getStorage('taxonomy_term')
    ->loadByProperties(['vid' => 'service_status']);
  $status_count = 0;
  foreach ($statuses as $term) {
    if ($term->hasField('field_open311_mapping') && $term->get('field_open311_mapping')->isEmpty()) {
      $tid = (string) $term->id();
      if ($tid === (string) $status_start) {
        $mapping = 'initial';
      }
      elseif (in_array($tid, $status_closed)) {
        $mapping = 'closed';
      }
      else {
        $mapping = 'open';
      }
      $term->set('field_open311_mapping', $mapping);
      $term->save();
      $status_count++;
    }
  }

  // Step 4b: Assign existing service_status terms to first jurisdiction.
  if ($default_group) {
    $status_jur_count = 0;
    foreach ($statuses as $term) {
      if ($term->hasField('field_jurisdiction') && $term->get('field_jurisdiction')->isEmpty()) {
        $term->set('field_jurisdiction', $default_gid);
        $term->save();
        $status_jur_count++;
      }
    }
  }

  // Step 5: Enable fields in taxonomy form displays.
  $category_display = EntityFormDisplay::load('taxonomy_term.service_category.default');
  if ($category_display) {
    $category_display->setComponent('field_jurisdiction', [
      'type' => 'entity_reference_autocomplete',
      'weight' => 8,
      'region' => 'content',
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
    ]);
    $category_display->save();
  }

  $status_display = EntityFormDisplay::load('taxonomy_term.service_status.default');
  if ($status_display) {
    $status_display->setComponent('field_jurisdiction', [
      'type' => 'entity_reference_autocomplete',
      'weight' => 6,
      'region' => 'content',
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
    ]);
    $status_display->setComponent('field_open311_mapping', [
      'type' => 'options_select',
      'weight' => 7,
      'region' => 'content',
      'settings' => [],
    ]);
    $status_display->save();
  }

  $messages = [];
  $messages[] = t('Created taxonomy jurisdiction isolation fields.');
  if (isset($cat_count)) {
    $messages[] = t('Assigned @count categories to jurisdiction "@name".', [
      '@count' => $cat_count,
      '@name' => $default_group ? $default_group->label() : 'none',
    ]);
  }
  if (isset($status_jur_count)) {
    $messages[] = t('Assigned @count statuses to jurisdiction "@name".', [
      '@count' => $status_jur_count,
      '@name' => $default_group ? $default_group->label() : 'none',
    ]);
  }
  $messages[] = t('Set Open311 mapping on @count status terms.', ['@count' => $status_count]);
  $messages[] = t('Updated form displays for taxonomy term editing.');

  return implode(' ', $messages);
}

/**
 * Converts field_category_gid from string to entity_reference (ORG groups).
 *
 * The field previously stored group IDs as plain text. This update converts it
 * to a proper entity_reference field targeting ORG groups, enabling the use of
 * an autocomplete widget in the taxonomy form and proper validation.
 */
function markaspot_update_11901() {
  $entity_type_manager = \Drupal::entityTypeManager();

  // Step 1: Backup existing data before deleting the field.
  $data = [];
  $terms = $entity_type_manager->getStorage('taxonomy_term')
    ->loadByProperties(['vid' => 'service_category']);
  foreach ($terms as $term) {
    if ($term->hasField('field_category_gid') && !$term->get('field_category_gid')->isEmpty()) {
      $data[$term->id()] = (int) $term->get('field_category_gid')->value;
    }
  }

  // Log backup data for disaster recovery.
  if (!empty($data)) {
    \Drupal::logger('markaspot')->notice(
      'field_category_gid migration backup (tid => gid): @data',
      ['@data' => json_encode($data)]
    );
    \Drupal::state()->set('markaspot_11901_backup', $data);
  }

  // Step 2: Delete existing field instance and storage.
  $field_config = FieldConfig::loadByName('taxonomy_term', 'service_category', 'field_category_gid');
  if ($field_config) {
    $field_config->delete();
  }

  $field_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_category_gid');
  if ($field_storage) {
    $field_storage->delete();
  }

  // Purge deleted field data so table names are freed for reuse.
  field_purge_batch(100);
  $entity_type_manager->clearCachedDefinitions();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();

  // Step 3: Detect ORG group type (legacy sites may use 'organisation').
  $group_type_storage = $entity_type_manager->getStorage('group_type');
  $org_type = 'org';
  if (!$group_type_storage->load('org') && $group_type_storage->load('organisation')) {
    $org_type = 'organisation';
  }

  // Step 4: Create new entity_reference field storage.
  $new_storage = FieldStorageConfig::create([
    'field_name' => 'field_category_gid',
    'entity_type' => 'taxonomy_term',
    'type' => 'entity_reference',
    'settings' => ['target_type' => 'group'],
    'cardinality' => 1,
    'translatable' => FALSE,
  ]);
  $new_storage->save();

  // Step 5: Create field instance on service_category targeting ORG groups.
  FieldConfig::create([
    'field_storage' => $new_storage,
    'bundle' => 'service_category',
    'label' => 'Category Group ID',
    'description' => 'The organisation (department) responsible for this category.',
    'required' => FALSE,
    'settings' => [
      'handler' => 'default:group',
      'handler_settings' => [
        'target_bundles' => [$org_type => $org_type],
        'sort' => ['field' => 'label', 'direction' => 'ASC'],
        'auto_create' => FALSE,
      ],
    ],
  ])->save();

  // Step 6: Restore data as entity references.
  $entity_type_manager->getStorage('taxonomy_term')->resetCache();
  $restored = 0;
  foreach ($data as $tid => $gid) {
    $group = $entity_type_manager->getStorage('group')->load($gid);
    if ($group) {
      $term = $entity_type_manager->getStorage('taxonomy_term')->load($tid);
      if ($term) {
        $term->set('field_category_gid', $gid);
        $term->save();
        $restored++;
      }
    }
    else {
      \Drupal::logger('markaspot')->warning(
        'field_category_gid migration: term @tid referenced non-existent group @gid, data dropped.',
        ['@tid' => $tid, '@gid' => $gid]
      );
    }
  }

  // Step 7: Update form display to use autocomplete widget.
  $form_display = EntityFormDisplay::load('taxonomy_term.service_category.default');
  if ($form_display) {
    $form_display->setComponent('field_category_gid', [
      'type' => 'entity_reference_autocomplete',
      'weight' => 5,
      'region' => 'content',
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
    ]);
    $form_display->save();
  }

  return t('Converted field_category_gid to entity_reference (@type groups). Migrated @count of @total values.', [
    '@type' => $org_type,
    '@count' => $restored,
    '@total' => count($data),
  ]);
}

/**
 * Add field_parent_jurisdiction to jur group type.
 *
 * Enables jurisdiction hierarchy: districts (with parent) vs top-level tenants
 * (without parent). Only districts are auto-assigned by geographic boundary.
 */
function markaspot_update_11902() {
  // Skip if markaspot_group module is not enabled.
  if (!\Drupal::moduleHandler()->moduleExists('markaspot_group')) {
    return t('markaspot_group not enabled, skipping.');
  }

  // Skip if group type jur doesn't exist.
  $group_type = \Drupal::entityTypeManager()->getStorage('group_type')->load('jur');
  if (!$group_type) {
    return t('Group type jur not found, skipping.');
  }

  // Create field storage if not exists.
  $storage = FieldStorageConfig::loadByName('group', 'field_parent_jurisdiction');
  if (!$storage) {
    $storage = FieldStorageConfig::create([
      'field_name' => 'field_parent_jurisdiction',
      'entity_type' => 'group',
      'type' => 'entity_reference',
      'cardinality' => 1,
      'settings' => ['target_type' => 'group'],
      'translatable' => FALSE,
    ]);
    $storage->save();
  }

  // Create field instance if not exists.
  $field = FieldConfig::loadByName('group', 'jur', 'field_parent_jurisdiction');
  if (!$field) {
    FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => 'jur',
      'label' => 'Parent Jurisdiction',
      'description' => 'Set for districts/subdivisions to indicate their parent jurisdiction. Leave empty for top-level jurisdictions (tenants in SaaS mode, or the root city).',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => ['jur' => 'jur'],
          'sort' => ['field' => '_none'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
  }

  // Add to form display.
  $form_display = EntityFormDisplay::load('group.jur.default');
  if ($form_display) {
    $form_display->setComponent('field_parent_jurisdiction', [
      'type' => 'entity_reference_autocomplete',
      'weight' => 2,
      'region' => 'content',
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
    ]);
    $form_display->save();
  }

  return t('Added field_parent_jurisdiction to jur group type for jurisdiction hierarchy support.');
}

/**
 * Enable markaspot_dashboard and markaspot_escalation on existing sites.
 *
 * These modules provide status note authoring (field_author on paragraphs),
 * internal remarks, and escalation routing. Previously optional, now part of
 * the standard profile to ensure the dashboard edit page works correctly.
 */
function markaspot_update_11903(): void {
  $installer = \Drupal::service('module_installer');
  $handler = \Drupal::moduleHandler();

  foreach (['markaspot_dashboard', 'markaspot_escalation'] as $module) {
    if (!$handler->moduleExists($module)) {
      $installer->install([$module]);
      \Drupal::logger('markaspot')->notice('Enabled @module.', ['@module' => $module]);
    }
  }
}

/**
 * Grant dashboard roles permission to view own unpublished content/media.
 *
 * Required to see AI-flagged (unpublished) photos and soft-limited
 * (unpublished) reports in the dashboard.
 */
function markaspot_update_11904(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('user_role');
  $roles = ['tenant_admin', 'editorial_board', 'moderator'];
  $perms = ['view own unpublished content', 'view own unpublished media'];
  foreach ($roles as $rid) {
    $role = $storage->load($rid);
    if ($role) {
      foreach ($perms as $perm) {
        $role->grantPermission($perm);
      }
      $role->save();
    }
  }
  \Drupal::logger('markaspot')->notice('Granted unpublished view permissions to dashboard roles.');
}

/**
 * Configure jurisdiction address field for organizational use.
 *
 * Hides givenName/familyName (jurisdictions are organizations, not persons)
 * and makes postalCode/addressLine1 optional to avoid validation errors
 * when saving partial address data from the dashboard.
 */
function markaspot_update_11905(): void {
  $field_config = \Drupal::configFactory()->getEditable('field.field.group.jur.field_jurisdiction_address');
  if ($field_config->isNew()) {
    \Drupal::logger('markaspot')->warning('field_jurisdiction_address config not found, skipping update.');
    return;
  }

  $field_config->set('settings.field_overrides', [
    'givenName' => ['override' => 'hidden'],
    'familyName' => ['override' => 'hidden'],
    'additionalName' => ['override' => 'hidden'],
    'postalCode' => ['override' => 'optional'],
    'addressLine1' => ['override' => 'optional'],
    'addressLine2' => ['override' => 'hidden'],
    'sortingCode' => ['override' => 'hidden'],
    'dependentLocality' => ['override' => 'hidden'],
  ]);
  $field_config->save();

  // Clean existing data: hidden fields must be empty
  // or entity validation fails.
  $database = \Drupal::database();
  foreach (['group__field_jurisdiction_address', 'group_revision__field_jurisdiction_address'] as $table) {
    if ($database->schema()->tableExists($table)) {
      $database->update($table)
        ->fields([
          'field_jurisdiction_address_given_name' => '',
          'field_jurisdiction_address_family_name' => '',
        ])
        ->execute();
    }
  }

  \Drupal::logger('markaspot')->notice('Configured jurisdiction address field: hidden name fields, optional postal/street. Cleared existing name data.');
}

/**
 * Enable JSON:API write operations (read_only: false).
 *
 * The dashboard needs JSON:API PATCH/POST/DELETE for editing requests,
 * managing status notes, and other write operations. Drupal's default
 * is read_only: true which blocks all mutations.
 */
function markaspot_update_11906(): void {
  $config = \Drupal::configFactory()->getEditable('jsonapi.settings');
  if ($config->get('read_only') !== FALSE) {
    $config->set('read_only', FALSE)->save();
    \Drupal::logger('markaspot')->notice('Set jsonapi.settings read_only to false.');
  }
}

/**
 * Create tenant_admin role and grant core permissions.
 *
 * On fresh installs via start.sh, config/optional may be skipped when
 * optional module dependencies are missing. This ensures the tenant_admin
 * role exists with all permissions that only require always-present modules.
 */
function markaspot_update_11907(): void {
  $role = Role::load('tenant_admin');
  if (!$role) {
    $role = Role::create([
      'id' => 'tenant_admin',
      'label' => 'Tenant Admin',
      'weight' => 4,
    ]);
    $role->save();
    \Drupal::logger('markaspot')->notice('Created tenant_admin role.');
  }

  // Grant all valid permissions from profile config.
  $profile_path = \Drupal::service('extension.list.profile')->getPath('markaspot');
  $config_file = $profile_path . '/config/install/user.role.tenant_admin.yml';
  if (file_exists($config_file)) {
    $yaml = Yaml::decode(file_get_contents($config_file));
    $permission_handler = \Drupal::service('user.permissions');
    $valid_permissions = array_keys($permission_handler->getPermissions());
    $added = 0;
    foreach ($yaml['permissions'] ?? [] as $perm) {
      if (in_array($perm, $valid_permissions) && !$role->hasPermission($perm)) {
        $role->grantPermission($perm);
        $added++;
      }
    }
    if ($added > 0) {
      $role->save();
      \Drupal::logger('markaspot')->notice('Added @count permissions to tenant_admin role.', ['@count' => $added]);
    }
  }
}

/**
 * Grant additional permissions to authenticated role.
 *
 * Adds edit own field_e_mail and edit terms in service_category
 * for authenticated users.
 */
function markaspot_update_11908(): void {
  $role = Role::load('authenticated');
  if (!$role) {
    return;
  }

  $perms_to_add = [
    'edit own field_e_mail',
    'edit terms in service_category',
  ];
  $permission_handler = \Drupal::service('user.permissions');
  $valid_permissions = array_keys($permission_handler->getPermissions());
  $added = 0;
  foreach ($perms_to_add as $perm) {
    if (in_array($perm, $valid_permissions) && !$role->hasPermission($perm)) {
      $role->grantPermission($perm);
      $added++;
    }
  }
  if ($added > 0) {
    $role->save();
    \Drupal::logger('markaspot')->notice('Added @count permissions to authenticated role.', ['@count' => $added]);
  }
}

/**
 * Implements hook_install() for the markaspot profile.
 *
 * Runs after all modules are installed and their config is imported. Repairs
 * field_permissions-based permissions that Drupal strips during install because
 * field_permissions registers its dynamic permissions from field_storage_config
 * entities, which are not yet loaded when role config is first imported.
 */
function markaspot_install() {
  _markaspot_repair_field_permissions();
}

/**
 * Repair field_permissions stripped during site install.
 *
 * During drush site:install, role config YAMLs are imported before
 * field_permissions has registered its dynamic permissions (which depend on
 * field_storage_config entities). Drupal validates permissions during role
 * import and strips any it considers "non-existent". This function re-reads
 * the intended permissions from config YAML files and re-grants them.
 *
 * This function is idempotent: it only grants permissions that are both
 * defined in the YAML files and currently valid in the permission system.
 */
function _markaspot_repair_field_permissions(): void {
  // Rebuild permission cache so field_permissions registers its dynamic
  // permissions from the now-loaded field_storage_config entities.
  \Drupal::service('plugin.manager.field.field_type')->clearCachedDefinitions();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  drupal_flush_all_caches();

  $permission_handler = \Drupal::service('user.permissions');
  $valid_permissions = array_keys($permission_handler->getPermissions());

  // Field permission pattern: (create|edit|edit own|view|view own) field_*.
  $field_perm_pattern = '/^(create|edit|edit own|view|view own) field_/';

  // Collect intended field permissions from both config/install and
  // config/optional YAML files.
  $profile_path = \Drupal::service('extension.list.profile')->getPath('markaspot');
  $role_files = [];
  foreach (['config/install', 'config/optional'] as $dir) {
    $path = $profile_path . '/' . $dir;
    if (is_dir($path)) {
      $files = glob($path . '/user.role.*.yml');
      foreach ($files as $file) {
        // Extract role ID from filename.
        $basename = basename($file, '.yml');
        $role_id = preg_replace('/^user\.role\./', '', $basename);
        // config/optional overrides config/install for the same role.
        $role_files[$role_id] = $file;
      }
    }
  }

  $role_storage = \Drupal::entityTypeManager()->getStorage('user_role');
  $repaired = [];

  foreach ($role_files as $role_id => $file) {
    $yaml = Yaml::decode(file_get_contents($file));
    if (empty($yaml['permissions'])) {
      continue;
    }

    $role = $role_storage->load($role_id);
    if (!$role) {
      continue;
    }

    $granted = 0;
    foreach ($yaml['permissions'] as $perm) {
      // Only process field_permissions-style permissions.
      if (!preg_match($field_perm_pattern, $perm)) {
        continue;
      }
      // Only grant if valid and not already present.
      if (in_array($perm, $valid_permissions, TRUE) && !$role->hasPermission($perm)) {
        $role->grantPermission($perm);
        $granted++;
      }
    }

    if ($granted > 0) {
      $role->save();
      $repaired[] = "$role_id (+$granted)";
    }
  }

  if (!empty($repaired)) {
    \Drupal::logger('markaspot')->notice(
      'Repaired field permissions stripped during install: @roles',
      ['@roles' => implode(', ', $repaired)]
    );
  }
}

/**
 * Repair field_permissions stripped during site install.
 *
 * Re-applies field_permissions-based permissions that were removed from roles
 * during site:install due to the install-order race condition where
 * field_permissions dynamic permissions are not yet registered when role
 * config is imported. Safe to run on existing sites (idempotent).
 */
function markaspot_update_11909(): void {
  _markaspot_repair_field_permissions();
}

/**
 * Migrate legacy 'organisation' group type to 'org'.
 *
 * Legacy Mark-a-Spot installations use the group type 'organisation'. The
 * current codebase (GroupMembersController, GroupInvitationController, etc.)
 * hardcodes 'org'. This hook migrates all database rows, config entities, and
 * key_value entries from 'organisation' to 'org' so every installation uses
 * the same short type name.
 *
 * Prerequisites: group.type.org must already exist (created by Phase 4b of
 * migrate-to-cloud.sh or by markaspot_group module install).
 *
 * Idempotent: safe to re-run. Skips if no 'organisation' group type exists.
 */
function markaspot_update_11910(): string {
  $state = \Drupal::state();
  if ($state->get('markaspot_update_11910.completed')) {
    return 'Migration already completed. Skipping.';
  }

  $database = \Drupal::database();
  $messages = [];

  // -------------------------------------------------------------------
  // Guard: skip if 'organisation' group type does not exist in the DB.
  // We check the database directly because Entity API may not be reliable
  // during update hooks.
  // -------------------------------------------------------------------
  $has_organisation = (bool) $database->select('config', 'c')
    ->fields('c', ['name'])
    ->condition('name', 'group.type.organisation')
    ->execute()
    ->fetchField();

  if (!$has_organisation) {
    return 'No legacy "organisation" group type found. Skipping migration.';
  }

  // -------------------------------------------------------------------
  // Warn if the site is not in maintenance mode.
  // -------------------------------------------------------------------
  if (!$state->get('system.maintenance_mode')) {
    \Drupal::logger('markaspot')->warning('markaspot_update_11910: Running group type migration without maintenance mode. Ensure no concurrent group operations.');
  }

  // -------------------------------------------------------------------
  // 1-2. Migrate entity tables inside a transaction.
  // -------------------------------------------------------------------
  $transaction = $database->startTransaction('update_11910');
  try {
    // 1. groups + groups_field_data: type column.
    foreach (['groups', 'groups_field_data'] as $table) {
      if ($database->schema()->tableExists($table)) {
        $updated = $database->update($table)
          ->fields(['type' => 'org'])
          ->condition('type', 'organisation')
          ->execute();
        if ($updated) {
          $messages[] = "$table: updated $updated rows (type organisation -> org)";
        }
      }
    }

    // 2. group_relationship + group_relationship_field_data.
    //    IMPORTANT: group_relationship has only: id, type, uuid, langcode.
    //    group_relationship_field_data has: type, group_type, and more.
    //    We must check column existence before updating.
    foreach (['group_relationship', 'group_relationship_field_data'] as $table) {
      if (!$database->schema()->tableExists($table)) {
        continue;
      }

      // 2a. group_type column (only on _field_data).
      if ($database->schema()->fieldExists($table, 'group_type')) {
        $updated = $database->update($table)
          ->fields(['group_type' => 'org'])
          ->condition('group_type', 'organisation')
          ->execute();
        if ($updated) {
          $messages[] = "$table.group_type: updated $updated rows";
        }
      }

      // 2b. type column: replace 'organisation-' prefix with 'org-'.
      if ($database->schema()->fieldExists($table, 'type')) {
        $types = $database->select($table, 't')
          ->fields('t', ['type'])
          ->condition('type', 'organisation-%', 'LIKE')
          ->distinct()
          ->execute()
          ->fetchCol();

        foreach ($types as $old_type) {
          $new_type = 'org-' . substr($old_type, strlen('organisation-'));
          $updated = $database->update($table)
            ->fields(['type' => $new_type])
            ->condition('type', $old_type)
            ->execute();
          if ($updated) {
            $messages[] = "$table.type: $old_type -> $new_type ($updated rows)";
          }
        }
      }
    }
  }
  catch (\Exception $e) {
    // Transaction auto-rolls back when $transaction is destroyed.
    throw $e;
  }
  unset($transaction);

  // -------------------------------------------------------------------
  // 3. Migrate config via direct SQL ONLY.
  //    Config API (getEditable/save/delete) triggers entity hooks that
  //    crash on partially migrated data (getName() on null, missing ID).
  //    Every config operation below is a direct DB query.
  // -------------------------------------------------------------------
  // 3a. Guard: ensure group.type.org exists before deleting organisation.
  $org_exists = (bool) $database->select('config', 'c')
    ->fields('c', ['name'])
    ->condition('name', 'group.type.org')
    ->execute()
    ->fetchField();

  if (!$org_exists) {
    throw new \Exception('markaspot_update_11910: group.type.org config does not exist. Cannot safely delete group.type.organisation. Aborting.');
  }

  // 3b. Delete group.type.organisation (org already exists from profile).
  $database->delete('config')
    ->condition('name', 'group.type.organisation')
    ->execute();
  $messages[] = 'Deleted config: group.type.organisation';

  // 3c. Delete legacy Group 2 artifacts (group_content_type_* patterns).
  $legacy_gc = $database->select('config', 'c')
    ->fields('c', ['name'])
    ->condition('name', 'group.relationship_type.group_content_type_%', 'LIKE')
    ->execute()
    ->fetchCol();
  foreach ($legacy_gc as $legacy_name) {
    $database->delete('config')->condition('name', $legacy_name)->execute();
    $messages[] = "Deleted legacy Group 2 config: $legacy_name";
  }

  // 3d. Process all remaining config names containing 'organisation'.
  $all_names = $database->select('config', 'c')
    ->fields('c', ['name'])
    ->condition('name', '%organisation%', 'LIKE')
    ->execute()
    ->fetchCol();

  foreach ($all_names as $old_name) {
    $new_name = _markaspot_update_11910_fix_config_name($old_name);

    if ($new_name === $old_name) {
      // Name stays, but data might still need fixing (handled in step 4).
      continue;
    }

    // Read old config data via SQL.
    $row = $database->select('config', 'c')
      ->fields('c', ['data'])
      ->condition('name', $old_name)
      ->execute()
      ->fetchField();
    if (!$row) {
      continue;
    }
    $data = unserialize($row);
    if (empty($data)) {
      continue;
    }

    // Check if target config already exists.
    $target_exists = (bool) $database->select('config', 'c')
      ->fields('c', ['name'])
      ->condition('name', $new_name)
      ->execute()
      ->fetchField();
    if ($target_exists) {
      // Target already exists (e.g., org-* created by profile install).
      // Delete the old config, keep the existing target.
      $database->delete('config')->condition('name', $old_name)->execute();
      $messages[] = "Config $old_name -> deleted (target $new_name already exists)";
      continue;
    }

    // Fix references inside config data.
    $data = _markaspot_update_11910_fix_config_data($data);

    // Write new config + delete old, all via direct SQL.
    $database->insert('config')->fields([
      'collection' => '',
      'name' => $new_name,
      'data' => serialize($data),
    ])->execute();
    $database->delete('config')->condition('name', $old_name)->execute();
    $messages[] = "Config renamed: $old_name -> $new_name";
  }

  // -------------------------------------------------------------------
  // 4. Fix config objects that reference 'organisation' internally
  //    (e.g., dependencies listing 'group.type.organisation') but
  //    whose config name does not contain 'organisation'.
  // -------------------------------------------------------------------
  $remaining = $database->select('config', 'c')
    ->fields('c', ['name', 'data'])
    ->condition('data', '%organisation%', 'LIKE')
    ->execute()
    ->fetchAllKeyed();

  foreach ($remaining as $name => $raw_data) {
    $data = unserialize($raw_data, ['allowed_classes' => FALSE]);
    if (!is_array($data)) {
      continue;
    }
    // Determine context: configs for group or group_relationship entities
    // can safely have bare 'organisation' replaced. All other configs
    // (taxonomy_term, node, etc.) must only get fully-qualified group.*
    // pattern replacements to avoid renaming taxonomy vocabulary references.
    $parts = explode('.', $name);
    $is_group_config = (
      ($parts[0] === 'group')
      || (count($parts) >= 3 && in_array($parts[2], ['group', 'group_relationship'], TRUE))
    );
    $fixed = _markaspot_update_11910_fix_config_data($data, $is_group_config);
    if ($fixed !== $data) {
      $database->update('config')
        ->fields(['data' => serialize($fixed)])
        ->condition('name', $name)
        ->execute();
      $messages[] = "Fixed internal references in config: $name";
    }
  }

  // -------------------------------------------------------------------
  // 5. Clean up markaspot_open311.settings: remove group_filter_type
  //    if set to 'organisation' (code now defaults to 'org').
  // -------------------------------------------------------------------
  $open311_row = $database->select('config', 'c')
    ->fields('c', ['data'])
    ->condition('name', 'markaspot_open311.settings')
    ->execute()
    ->fetchField();
  if ($open311_row) {
    $open311_data = unserialize($open311_row);
    if (is_array($open311_data) && ($open311_data['group_filter_type'] ?? '') === 'organisation') {
      unset($open311_data['group_filter_type']);
      $database->update('config')
        ->fields(['data' => serialize($open311_data)])
        ->condition('name', 'markaspot_open311.settings')
        ->execute();
      $messages[] = 'Removed group_filter_type=organisation from markaspot_open311.settings';
    }
  }

  // -------------------------------------------------------------------
  // 6. Fix key_value store: entity.definitions.installed may contain
  //    bundle info referencing 'organisation-*' plugin IDs.
  // -------------------------------------------------------------------
  $kv = \Drupal::keyValue('entity.definitions.installed');
  $gr_bundles = $kv->get('group_relationship.entity_type');
  if ($gr_bundles) {
    $fixed_value = _markaspot_update_11910_fix_config_data($gr_bundles);
    if ($fixed_value !== $gr_bundles) {
      $kv->set('group_relationship.entity_type', $fixed_value);
      $messages[] = 'Fixed group_relationship entity type definition in key_value store';
    }
  }

  $gr_fields = $kv->get('group_relationship.field_storage_definitions');
  if ($gr_fields) {
    $fixed_value = _markaspot_update_11910_fix_config_data($gr_fields);
    if ($fixed_value !== $gr_fields) {
      $kv->set('group_relationship.field_storage_definitions', $fixed_value);
      $messages[] = 'Fixed group_relationship field_storage_definitions in key_value store';
    }
  }

  // -------------------------------------------------------------------
  // 7. Clear all caches so Drupal picks up the changes.
  // -------------------------------------------------------------------
  drupal_flush_all_caches();
  $messages[] = 'Flushed all caches';

  // -------------------------------------------------------------------
  // 8. Prevent Group 2->3 upgrade path from running.
  //    group_update_10300 sets this to TRUE which causes 10301-10305 to
  //    attempt the Group 2->3 migration. Since our migration script
  //    already handled the table renames (Phase 13/14), force it to FALSE.
  // -------------------------------------------------------------------
  \Drupal::state()->set('group_update_10300_detected_legacy_version', FALSE);
  $messages[] = 'Set group_update_10300_detected_legacy_version to FALSE';

  $state->set('markaspot_update_11910.completed', TRUE);

  return implode("\n", $messages);
}

/**
 * Recursively fix 'organisation' references inside config data arrays.
 *
 * Only replaces 'organisation' in structural positions where it represents
 * the group type bundle name. Preserves field names like 'field_organisation'
 * and 'field_head_organisation_e_mail' untouched.
 *
 * Targeted replacements:
 * - String values equal to 'organisation' exactly (bundle/type references).
 * - Plugin ID prefixes: 'organisation-*' -> 'org-*'.
 * - Config entity name patterns: 'group.type.organisation',
 *   'group.content_type.organisation-*', etc.
 * - Dependency strings referencing 'group.type.organisation'.
 * - Array keys equal to 'organisation' exactly (e.g., target_bundles keys).
 *
 * @param mixed $data
 *   The config data (array or scalar).
 * @param bool $group_context
 *   TRUE when we know this config belongs to a group entity (safe to replace
 *   bare 'organisation' strings and array keys). FALSE when processing
 *   arbitrary configs (e.g., taxonomy_term configs) where bare 'organisation'
 *   must be preserved and only fully-qualified group.* patterns are replaced.
 *
 * @return mixed
 *   The fixed data with bundle-level 'organisation' replaced by 'org'.
 */
function _markaspot_update_11910_fix_config_data(mixed $data, bool $group_context = TRUE): mixed {
  if (is_string($data)) {
    return _markaspot_update_11910_fix_string($data, $group_context);
  }

  if (!is_array($data)) {
    return $data;
  }

  $result = [];
  foreach ($data as $key => $value) {
    // Only replace array keys that are exactly 'organisation' when we are
    // inside a known group config. In non-group configs (e.g., taxonomy_term
    // field configs), 'organisation' is a vocabulary name and must stay.
    $new_key = ($group_context && $key === 'organisation') ? 'org' : $key;
    $result[$new_key] = _markaspot_update_11910_fix_config_data($value, $group_context);
  }

  return $result;
}

/**
 * Fix a single string value, replacing 'organisation' only in bundle contexts.
 *
 * @param string $value
 *   The string to fix.
 * @param bool $group_context
 *   TRUE when we know this string comes from a group config (safe to replace
 *   bare 'organisation'). FALSE when the string may reference a taxonomy
 *   vocabulary or other non-group entity named 'organisation'.
 *
 * @return string
 *   The fixed string.
 */
function _markaspot_update_11910_fix_string(string $value, bool $group_context = TRUE): string {
  // Exact match: the entire string IS the bundle name.
  // Only safe when we know we are in a group config context, because
  // 'organisation' is also a taxonomy vocabulary name.
  if ($group_context && $value === 'organisation') {
    return 'org';
  }

  // Plugin ID prefix: 'organisation-group_membership' -> 'org-group_membership'
  // but NOT 'field_organisation-something'.
  // Only safe in group context (these are group_relationship type IDs).
  if ($group_context && str_starts_with($value, 'organisation-')) {
    return 'org-' . substr($value, strlen('organisation-'));
  }

  // Config entity name patterns where 'organisation' is a bundle segment.
  // Matches patterns like:
  //   group.type.organisation
  //   group.content_type.organisation-*
  //   field.field.group.organisation.*
  //   core.entity_form_display.group.organisation.*
  //   core.entity_view_display.group.organisation.*
  // Does NOT match:
  //   field.storage.group.field_organisation
  //   field.field.group.org.field_organisation.
  $patterns = [
    // 'group.type.organisation' at end of string or before a dot.
    '/\bgroup\.type\.organisation\b/' => 'group.type.org',
    // 'group.content_type.organisation-' prefix in config names.
    '/\bgroup\.content_type\.organisation-/' => 'group.content_type.org-',
    // 'group.role.organisation-' and 'group.relationship_type.organisation-'
    // in dependency arrays.
    '/\bgroup\.role\.organisation-/' => 'group.role.org-',
    '/\bgroup\.relationship_type\.organisation-/' => 'group.relationship_type.org-',
    // Bundle segment after entity type: '*.group.organisation.' or
    // '*.group.organisation' at end. Only when preceded by a known prefix.
    // Includes core.base_field_override.group for base field overrides.
    '/\b(field\.field\.group|core\.entity_form_display\.group|core\.entity_view_display\.group|core\.base_field_override\.group)\.organisation\b/' => '$1.org',
    // language.content_settings.group.organisation.
    '/\blanguage\.content_settings\.group\.organisation\b/' => 'language.content_settings.group.org',
    // Entity ID patterns: 'group.organisation' or 'group.organisation.*'
    // (e.g., base_field_override id = 'group.organisation.changed')
    // Must NOT match 'field_organisation' or 'taxonomy_term.organisation'.
    '/^group\.organisation\b/' => 'group.org',
  ];

  $result = $value;
  foreach ($patterns as $pattern => $replacement) {
    $result = preg_replace($pattern, $replacement, $result);
  }

  // Dependency references: 'group.type.organisation' anywhere in a string
  // that may contain a config dependency name.
  // This catches dependency arrays like ['group.type.organisation'].
  // Already handled by the first pattern above if standalone, but also catches
  // compound strings or serialized references.
  return $result;
}

/**
 * Fix a config name, replacing 'organisation' only in group-type positions.
 *
 * Config name patterns that ARE renamed (group type bundle):
 *   group.type.organisation -> group.type.org
 *   group.content_type.organisation-* -> group.content_type.org-*
 *   group.role.organisation-* -> group.role.org-*
 *   group.relationship_type.organisation-* -> group.relationship_type.org-*
 *   field.field.group.organisation.* -> field.field.group.org.*
 *   core.entity_form_display.group.organisation.* -> ...group.org.*
 *   core.entity_view_display.group.organisation.* -> ...group.org.*
 *   core.base_field_override.group.organisation.* -> ...group.org.*
 *   language.content_settings.group.organisation -> ...group.org.
 *
 * Config names that are NOT renamed (not group type references):
 *   taxonomy.vocabulary.organisation (taxonomy vocab, own ID)
 *   facets.facet.organisation (facet machine name)
 *   block.block.organisation (block machine name)
 *   core.base_field_override.taxonomy_term.organisation.* (taxonomy bundle)
 *   core.entity_form_display.taxonomy_term.organisation.* (taxonomy bundle)
 *   field.storage.group.field_organisation (field name, not bundle)
 *   field.field.group.org.field_organisation (field name on org bundle)
 *
 * @param string $name
 *   The config name.
 *
 * @return string
 *   The fixed config name.
 */
function _markaspot_update_11910_fix_config_name(string $name): string {
  // Split config name into segments for precise replacement.
  // Only rename configs where 'organisation' is the GROUP TYPE bundle.
  // Never rename taxonomy vocabularies, facets, blocks, or field names.
  $parts = explode('.', $name);

  // Pattern: group.type.organisation -> group.type.org.
  if (count($parts) >= 3 && $parts[0] === 'group' && $parts[1] === 'type' && $parts[2] === 'organisation') {
    $parts[2] = 'org';
    return implode('.', $parts);
  }

  // Pattern: group.content_type.organisation-* -> group.content_type.org-*.
  if (count($parts) >= 3 && $parts[0] === 'group' && $parts[1] === 'content_type' && str_starts_with($parts[2], 'organisation-')) {
    $parts[2] = 'org-' . substr($parts[2], strlen('organisation-'));
    return implode('.', $parts);
  }

  // Pattern: group.role.organisation-* -> group.role.org-*
  // Pattern: group.relationship_type.organisation-* -> group.relationship_type.org-*.
  if (count($parts) >= 3 && $parts[0] === 'group'
      && in_array($parts[1], ['role', 'relationship_type'])
      && str_starts_with($parts[2], 'organisation-')) {
    $parts[2] = 'org-' . substr($parts[2], strlen('organisation-'));
    return implode('.', $parts);
  }

  // Patterns where entity_type is 'group' and bundle is at index 3:
  //   field.field.group.organisation.* -> field.field.group.org.*
  //   core.entity_form_display.group.organisation.* -> ...group.org.*
  //   core.entity_view_display.group.organisation.* -> ...group.org.*
  //   core.base_field_override.group.organisation.* -> ...group.org.*
  // IMPORTANT: Only when entity_type (index 2) is 'group'.
  // NOT for taxonomy_term.organisation (that is a taxonomy vocabulary).
  $bundle_at_3_prefixes = [
    ['field', 'field', 'group'],
    ['core', 'entity_form_display', 'group'],
    ['core', 'entity_view_display', 'group'],
    ['core', 'base_field_override', 'group'],
  ];
  if (count($parts) >= 4) {
    foreach ($bundle_at_3_prefixes as $prefix) {
      if ($parts[0] === $prefix[0] && $parts[1] === $prefix[1] && $parts[2] === $prefix[2]) {
        if ($parts[3] === 'organisation') {
          $parts[3] = 'org';
          return implode('.', $parts);
        }
        break;
      }
    }
  }

  // Pattern: language.content_settings.group.organisation
  // Only for entity_type 'group', not taxonomy_term.
  if (count($parts) >= 4 && $parts[0] === 'language' && $parts[1] === 'content_settings'
      && $parts[2] === 'group' && $parts[3] === 'organisation') {
    $parts[3] = 'org';
    return implode('.', $parts);
  }

  // Everything else keeps its name. This explicitly excludes:
  //   - taxonomy.vocabulary.organisation (taxonomy vocab, not group type)
  //   - facets.facet.organisation (facet machine name)
  //   - block.block.organisation (block machine name)
  //   - core.base_field_override.taxonomy_term.organisation.* (taxonomy bundle)
  //   - core.entity_form_display.taxonomy_term.organisation.* (taxonomy bundle)
  //   - field.storage.group.field_organisation (field name, not bundle)
  //   - field.field.group.org.field_organisation (field name on org bundle)
  return $name;
}

/**
 * Uninstall legacy modules: markaspot_front, markaspot_privacy, markaspot_trend.
 *
 * These modules are no longer used. markaspot_front depends on Drupal 8 era
 * panels/page_manager. markaspot_privacy functionality has been replaced by
 * jurisdiction group entity fields. markaspot_trend was only used by
 * markaspot_front.
 */
function markaspot_update_11911(): string {
  $module_installer = \Drupal::service('module_installer');
  $module_handler = \Drupal::moduleHandler();
  $uninstalled = [];

  $legacy_modules = ['markaspot_front', 'markaspot_privacy', 'markaspot_trend'];
  foreach ($legacy_modules as $module) {
    if ($module_handler->moduleExists($module)) {
      try {
        $module_installer->uninstall([$module]);
        $uninstalled[] = $module;
        \Drupal::logger('markaspot')->notice('Uninstalled legacy module: @module', [
          '@module' => $module,
        ]);
      }
      catch (\Exception $e) {
        \Drupal::logger('markaspot')->warning('Failed to uninstall @module: @error', [
          '@module' => $module,
          '@error' => $e->getMessage(),
        ]);
      }
    }
  }

  if (empty($uninstalled)) {
    return 'No legacy modules found to uninstall.';
  }
  return 'Uninstalled legacy modules: ' . implode(', ', $uninstalled);
}

/**
 * Enable markaspot_mail on existing installations.
 *
 * The module ships the central hook_mail_alter dispatcher + branded HTML
 * builders (OTP, feedback, escalation, workspace, moderation, org
 * notification, ECA action mails) and was added to the profile after many
 * tenants were already installed. Without the module enabled the builder
 * registry never runs, so notification mails fall through to the Drupal
 * core plain-text template and reach users as "-- / Thank you!" footers.
 */
function markaspot_update_11912(): string {
  $handler = \Drupal::moduleHandler();
  if ($handler->moduleExists('markaspot_mail')) {
    return 'markaspot_mail already enabled; no action.';
  }
  \Drupal::service('module_installer')->install(['markaspot_mail']);
  return 'Enabled markaspot_mail module.';
}

/**
 * Ensure phpmailer_smtp sends HTML and uses phpmailer_smtp as formatter.
 *
 * Config/optional sets these at fresh install, but not on migrated tenants.
 * Intentionally enforces the platform default on all tenants: HTML mail is
 * non-negotiable for branded OTP and notification mails.
 *
 * @return string
 */
function markaspot_update_11913(): string {
  $changes = [];

  $config = \Drupal::configFactory()->getEditable('phpmailer_smtp.format');
  if ($config->get('format') !== 'html') {
    $config->set('format', 'html')->save();
    $changes[] = 'phpmailer_smtp.format → html';
  }

  $mailsystem = \Drupal::configFactory()->getEditable('mailsystem.settings');
  if ($mailsystem->get('defaults.formatter') !== 'phpmailer_smtp') {
    $mailsystem->set('defaults.formatter', 'phpmailer_smtp')->save();
    $changes[] = 'mailsystem.settings formatter → phpmailer_smtp';
  }

  return $changes ? implode(', ', $changes) . '.' : 'No changes needed.';
}

/**
 * Enable markaspot_health on existing installations.
 *
 * Fresh installs get the module from markaspot.info.yml. Existing tenants need
 * the same module enabled explicitly so the operational health checks and
 * repair commands are available after deploy.
 */
function markaspot_update_11914(): string {
  $handler = \Drupal::moduleHandler();
  if ($handler->moduleExists('markaspot_health')) {
    return 'markaspot_health already enabled; no action.';
  }

  \Drupal::service('module_installer')->install(['markaspot_health']);
  return 'Enabled markaspot_health module.';
}

/**
 * Ensure runtime mail config matches the platform default.
 *
 * Existing tenants may already have run markaspot_update_11913 before
 * markaspot_mail attachment policy was part of the health check. Keep this as
 * a separate update so the drift repair is reproducible through updatedb.
 */
function markaspot_update_11915(): string {
  $changes = [];

  $mailsystem = \Drupal::configFactory()->getEditable('mailsystem.settings');
  if ($mailsystem->get('defaults.sender') !== 'phpmailer_smtp') {
    $mailsystem->set('defaults.sender', 'phpmailer_smtp');
    $changes[] = 'mailsystem.settings defaults.sender=phpmailer_smtp';
  }
  if ($mailsystem->get('defaults.formatter') !== 'phpmailer_smtp') {
    $mailsystem->set('defaults.formatter', 'phpmailer_smtp');
    $changes[] = 'mailsystem.settings defaults.formatter=phpmailer_smtp';
  }
  if ($changes !== []) {
    $mailsystem->save();
  }

  $mail_settings = \Drupal::configFactory()->getEditable('markaspot_mail.settings');
  if ($mail_settings->get('attachments.enabled') !== TRUE) {
    $mail_settings->set('attachments.enabled', TRUE)->save();
    $changes[] = 'markaspot_mail.settings attachments.enabled=true';
  }

  return $changes ? implode(', ', $changes) . '.' : 'No mail config changes needed.';
}

/**
 * Enable markaspot_notification on existing installations.
 *
 * Fresh installs get the module from markaspot.info.yml. Existing tenants need
 * it enabled through the profile because update hooks in a disabled module do
 * not run. Also keep the REST resource and staff permission aligned for sites
 * where the module was enabled manually before this update.
 */
function markaspot_update_11916(): string {
  $changes = [];
  $module_handler = \Drupal::moduleHandler();
  $module_installer = \Drupal::service('module_installer');

  if (!$module_handler->moduleExists('markaspot_notification')) {
    $module_installer->install(['markaspot_notification']);
    $changes[] = 'enabled markaspot_notification';
  }

  $config = \Drupal::configFactory()->getEditable('rest.resource.mas_notifications');
  if ($config->isNew()) {
    $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_notification');
    $source = new FileStorage($module_path . '/config/install');
    $data = $source->read('rest.resource.mas_notifications');
    if (!is_array($data)) {
      throw new \RuntimeException('Could not read rest.resource.mas_notifications from markaspot_notification config/install.');
    }
    $config->setData($data)->save(TRUE);
    $changes[] = 'installed mas_notifications REST resource';
  }

  $permission = 'access dashboard notifications';
  $granted = [];
  foreach (['tenant_admin', 'editorial_board', 'moderator'] as $role_id) {
    $role = Role::load($role_id);
    if (!$role || $role->hasPermission($permission)) {
      continue;
    }
    $role->grantPermission($permission)->save();
    $granted[] = $role_id;
  }
  if ($granted !== []) {
    $changes[] = 'granted dashboard notification access to ' . implode(', ', $granted);
  }

  \Drupal::service('router.builder')->rebuild();

  return $changes ? implode('; ', $changes) . '.' : 'markaspot_notification already enabled and configured.';
}

/**
 * Restrict internal remark visibility to staff roles.
 */
function markaspot_update_11917(): string {
  $changes = [];

  $authenticated = Role::load('authenticated');
  if ($authenticated && $authenticated->hasPermission('view own field_internal_remark')) {
    $authenticated->revokePermission('view own field_internal_remark')->save();
    $changes[] = 'revoked own internal remark access from authenticated users';
  }

  $permission = 'view field_internal_remark';
  $granted = [];
  foreach (['tenant_admin', 'editorial_board', 'moderator'] as $role_id) {
    $role = Role::load($role_id);
    if (!$role || $role->hasPermission($permission)) {
      continue;
    }
    $role->grantPermission($permission)->save();
    $granted[] = $role_id;
  }

  if ($granted !== []) {
    $changes[] = 'granted internal remark access to ' . implode(', ', $granted);
  }

  return $changes ? implode('; ', $changes) . '.' : 'Internal remark role permissions already aligned.';
}

/**
 * Restore anonymous public report submission permissions.
 */
function markaspot_update_11918(): string {
  $role = Role::load('anonymous');
  if (!$role) {
    return 'Anonymous role not found; no permissions changed.';
  }

  // Explicit allowlist of the public report submission permissions, mirroring
  // config/optional/user.role.anonymous.yml. Kept hard-coded on purpose:
  // reading the set from a config file would let a later YAML edit silently
  // escalate anonymous privileges across all tenants on drush updb. Adding a
  // permission here must go through code review. The field_approved entries
  // back the consent checkbox on the public report form.
  $permissions = [
    'access content',
    'access open311 extension',
    'create field_address',
    'create field_approved',
    'create field_e_mail',
    'create field_request_media',
    'create media',
    'create request_image media',
    'create service_request content',
    'edit field_approved',
    'edit own field_approved',
    'restful get georeport_discovery_resource',
    'restful get georeport_request_index_resource',
    'restful get georeport_request_resource',
    'restful get georeport_service_index_resource',
    'view field_address',
    'view field_request_media',
    'view field_status',
    'view field_status_note',
    'view field_status_notes',
    'view media',
    'view own field_request_media',
    'view own field_status_note',
    'view own unpublished media',
  ];

  $granted = [];
  foreach ($permissions as $permission) {
    if ($role->hasPermission($permission)) {
      continue;
    }
    $role->grantPermission($permission);
    $granted[] = $permission;
  }

  if ($granted === []) {
    return 'Anonymous public report permissions already aligned.';
  }

  $role->save();
  return 'Granted anonymous public report permissions: ' . implode(', ', $granted) . '.';
}

/**
 * Repair config-entity UUIDs that landed as NULL/invalid from old dumps.
 *
 * Imports of pre-11.9 dumps (D10 with legacy config entities, fresh module
 * activations via SQL INSERT, etc.) regularly leave a subset of
 * config-entity rows without a valid uuid. When JSON:API then resolves a
 * relationship targeting one of these entities — typically
 * `paragraphs_type.internal_remark` referenced via
 * `paragraph.relationships.paragraph_type.data.id` — the response fails
 * core's ResourceResponseValidator schema check ("NULL value found, but a
 * string is required") and produces a 500 cascade in the dashboard.
 *
 * cp2 was hand-patched on 2026-05-18 via `drush cset`. This hook is the
 * portable version: idempotent, safe to re-run, generates UUIDs only where
 * missing/invalid, persists via the entity API so config_dependency caches
 * stay consistent.
 *
 * Same surface as scripts/repair-config-entity-uuids.php in client repos,
 * but a real post_update so `drush updb` picks it up on every tenant
 * without manual intervention.
 */
function markaspot_update_11919(): string {
  $entityTypeManager = \Drupal::entityTypeManager();
  $uuidService = \Drupal::service('uuid');
  $repaired = 0;
  $failed = [];

  foreach ($entityTypeManager->getDefinitions() as $entityTypeId => $definition) {
    if (!$definition->entityClassImplements(ConfigEntityInterface::class)) {
      continue;
    }

    try {
      $storage = $entityTypeManager->getStorage($entityTypeId);
      $entities = method_exists($storage, 'loadMultipleOverrideFree')
        ? $storage->loadMultipleOverrideFree()
        : $storage->loadMultiple();
    }
    catch (\Throwable $e) {
      $failed[] = "$entityTypeId: " . $e->getMessage();
      continue;
    }

    foreach ($entities as $entity) {
      if (!$entity instanceof ConfigEntityInterface) {
        continue;
      }
      $uuid = $entity->uuid();
      if (is_string($uuid) && Uuid::isValid($uuid)) {
        continue;
      }
      try {
        $entity->set('uuid', $uuidService->generate());
        $entity->save();
        $repaired++;
      }
      catch (\Throwable $e) {
        $failed[] = $entity->getConfigDependencyName() . ': ' . $e->getMessage();
      }
    }
  }

  $msg = sprintf('Repaired %d config-entity UUIDs (NULL/invalid).', $repaired);
  if (!empty($failed)) {
    $msg .= ' Failed: ' . implode('; ', array_slice($failed, 0, 5));
    if (count($failed) > 5) {
      $msg .= ' (and ' . (count($failed) - 5) . ' more)';
    }
  }
  return $msg;
}

/**
 * Restrict personal service-request fields to field_permissions access.
 */
function markaspot_update_11920(): string {
  $personal_fields = [
    'field_e_mail',
    'field_first_name',
    'field_gdpr',
    'field_last_name',
    'field_notification',
    'field_phone',
  ];
  $citizen_create_fields = [
    ...$personal_fields,
    'field_request_attributes',
  ];
  $changes = [];

  foreach ($personal_fields as $field_name) {
    $field_storage = FieldStorageConfig::loadByName('node', $field_name);
    if (!$field_storage) {
      continue;
    }

    $current = $field_storage->getThirdPartySetting('field_permissions', 'permission_type', 'public');
    if ($current === 'custom') {
      continue;
    }

    $field_storage->setThirdPartySetting('field_permissions', 'permission_type', 'custom');
    $field_storage->save();
    $changes[] = "set $field_name to custom field permissions";
  }

  // Rebuild dynamic field_permissions entries after changing storage config.
  \Drupal::service('plugin.manager.field.field_type')->clearCachedDefinitions();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  drupal_flush_all_caches();
  $valid_permissions = array_keys(\Drupal::service('user.permissions')->getPermissions());

  $revoked = [];
  $granted = [];
  foreach (['anonymous', 'authenticated'] as $role_id) {
    $role = Role::load($role_id);
    if (!$role) {
      continue;
    }

    $changed = FALSE;
    foreach ($personal_fields as $field_name) {
      foreach (['view', 'view own', 'edit', 'edit own'] as $operation) {
        $permission = "$operation $field_name";
        if (!$role->hasPermission($permission)) {
          continue;
        }
        $role->revokePermission($permission);
        $revoked[] = "$role_id: $permission";
        $changed = TRUE;
      }
    }

    foreach ($citizen_create_fields as $field_name) {
      $permission = "create $field_name";
      if (!in_array($permission, $valid_permissions, TRUE) || $role->hasPermission($permission)) {
        continue;
      }
      $role->grantPermission($permission);
      $granted[] = "$role_id: $permission";
      $changed = TRUE;
    }

    if ($changed) {
      $role->save();
    }
  }

  if ($revoked !== []) {
    $changes[] = 'revoked citizen private-field access: ' . implode(', ', $revoked);
  }

  foreach (['moderator', 'tenant_admin', 'editorial_board'] as $role_id) {
    $role = Role::load($role_id);
    if (!$role) {
      continue;
    }

    $changed = FALSE;
    foreach ($personal_fields as $field_name) {
      foreach (['create', 'view', 'view own', 'edit', 'edit own'] as $operation) {
        $permission = "$operation $field_name";
        if (!in_array($permission, $valid_permissions, TRUE) || $role->hasPermission($permission)) {
          continue;
        }
        $role->grantPermission($permission);
        $granted[] = "$role_id: $permission";
        $changed = TRUE;
      }
    }

    if ($changed) {
      $role->save();
    }
  }

  if ($granted !== []) {
    $changes[] = 'granted personal-field access: ' . implode(', ', $granted);
  }

  return $changes ? implode('; ', $changes) . '.' : 'Service-request personal field permissions already aligned.';
}

/**
 * Add jurisdiction-scoped taxonomy-backed internal request statuses.
 */
function markaspot_update_11921(): string {
  $changes = [];

  if (!Vocabulary::load('internal_status')) {
    Vocabulary::create([
      'vid' => 'internal_status',
      'name' => 'Internal Status',
      'description' => 'Jurisdiction-scoped internal processing statuses for service requests.',
      'weight' => 0,
    ])->save();
    $changes[] = 'created internal_status vocabulary';
  }

  $code_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_internal_status_code');
  if (!$code_storage) {
    $code_storage = FieldStorageConfig::create([
      'field_name' => 'field_internal_status_code',
      'entity_type' => 'taxonomy_term',
      'type' => 'string',
      'settings' => [
        'max_length' => 64,
        'is_ascii' => FALSE,
        'case_sensitive' => FALSE,
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
    ]);
    $code_storage->save();
    $changes[] = 'created field_internal_status_code storage';
  }

  if (!FieldConfig::loadByName('taxonomy_term', 'internal_status', 'field_internal_status_code')) {
    FieldConfig::create([
      'field_storage' => $code_storage,
      'bundle' => 'internal_status',
      'label' => 'Internal Status Code',
      'description' => 'Stable machine code used to migrate and integrate legacy internal status values.',
      'required' => TRUE,
      'translatable' => FALSE,
    ])->save();
    $changes[] = 'attached field_internal_status_code to internal_status terms';
  }

  $node_storage = FieldStorageConfig::loadByName('node', 'field_status_internal_term');
  if (!$node_storage) {
    $node_storage = FieldStorageConfig::create([
      'field_name' => 'field_status_internal_term',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'taxonomy_term',
      ],
      'cardinality' => 1,
      'translatable' => TRUE,
    ]);
    $node_storage->setThirdPartySetting('field_permissions', 'permission_type', 'custom');
    $node_storage->save();
    $changes[] = 'created field_status_internal_term storage';
  }
  elseif ($node_storage->getThirdPartySetting('field_permissions', 'permission_type', 'public') !== 'custom') {
    $node_storage->setThirdPartySetting('field_permissions', 'permission_type', 'custom');
    $node_storage->save();
    $changes[] = 'set field_status_internal_term to custom field permissions';
  }

  if (!FieldConfig::loadByName('node', 'service_request', 'field_status_internal_term')) {
    FieldConfig::create([
      'field_storage' => $node_storage,
      'bundle' => 'service_request',
      'label' => 'Internal Status',
      'description' => 'Jurisdiction-scoped internal processing status for dashboard workflows.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => [
            'internal_status' => 'internal_status',
          ],
          'sort' => [
            'field' => 'weight',
            'direction' => 'asc',
          ],
          'auto_create' => FALSE,
          'auto_create_bundle' => '',
        ],
      ],
    ])->save();
    $changes[] = 'attached field_status_internal_term to service_request';
  }

  $definition_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_status_definition');
  if ($definition_storage && !FieldConfig::loadByName('taxonomy_term', 'internal_status', 'field_status_definition')) {
    FieldConfig::create([
      'field_storage' => $definition_storage,
      'bundle' => 'internal_status',
      'label' => 'Status Definition Attributes',
      'description' => 'Internal process attributes to capture when this internal status is selected.',
      'required' => FALSE,
      'translatable' => TRUE,
      'settings' => [
        'allowed_formats' => [],
      ],
    ])->save();
    $changes[] = 'attached field_status_definition to internal_status terms';
  }
  elseif (!$definition_storage) {
    $changes[] = 'field_status_definition storage missing; skipped internal_status definition field';
  }

  $jurisdiction_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_jurisdiction');
  if (!$jurisdiction_storage) {
    $jurisdiction_storage = FieldStorageConfig::create([
      'field_name' => 'field_jurisdiction',
      'entity_type' => 'taxonomy_term',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'group'],
      'cardinality' => 1,
      'translatable' => FALSE,
    ]);
    $jurisdiction_storage->save();
    $changes[] = 'created taxonomy field_jurisdiction storage';
  }

  $jurisdiction_group_type = _markaspot_update_11921_jurisdiction_group_type();
  $group_type = \Drupal::entityTypeManager()
    ->getStorage('group_type')
    ->load($jurisdiction_group_type);
  if ($group_type && !FieldConfig::loadByName('taxonomy_term', 'internal_status', 'field_jurisdiction')) {
    FieldConfig::create([
      'field_storage' => $jurisdiction_storage,
      'bundle' => 'internal_status',
      'label' => 'Jurisdiction',
      'description' => 'The jurisdiction this internal status belongs to.',
      'required' => TRUE,
      'translatable' => TRUE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => [
            $jurisdiction_group_type => $jurisdiction_group_type,
          ],
          'sort' => [
            'field' => 'label',
            'direction' => 'ASC',
          ],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
    $changes[] = "attached field_jurisdiction to internal_status terms for $jurisdiction_group_type groups";
  }
  elseif (!$group_type) {
    $changes[] = "jurisdiction group type $jurisdiction_group_type missing; skipped internal_status jurisdiction field";
  }

  _markaspot_update_11921_sync_form_displays($changes);
  _markaspot_update_11923_expose_request_attributes_management_form($changes);
  _markaspot_update_11921_sync_open311_manager_fields($changes);
  _markaspot_update_11921_enable_internal_status_jsonapi_resource($changes);

  // Rebuild dynamic field_permissions entries after creating field storage.
  \Drupal::service('plugin.manager.field.field_type')->clearCachedDefinitions();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  drupal_flush_all_caches();
  $valid_permissions = array_keys(\Drupal::service('user.permissions')->getPermissions());

  $granted = _markaspot_update_11921_grant_internal_status_permissions($valid_permissions);
  if ($granted !== []) {
    $changes[] = 'granted internal status permissions: ' . implode(', ', $granted);
  }

  $migration = _markaspot_update_11921_migrate_legacy_internal_status();
  if ($migration['migrated'] > 0 || $migration['created_terms'] > 0 || $migration['skipped'] > 0) {
    $changes[] = sprintf(
      'migrated %d legacy internal status values into %d internal_status terms (%d skipped)',
      $migration['migrated'],
      $migration['created_terms'],
      $migration['skipped']
    );
  }

  return $changes ? implode('; ', $changes) . '.' : 'Taxonomy-backed internal statuses already aligned.';
}

/**
 * Gets the configured jurisdiction group type for update 11921.
 */
function _markaspot_update_11921_jurisdiction_group_type(): string {
  $configured = \Drupal::config('markaspot_open311.settings')->get('jurisdiction_group_type');
  return is_string($configured) && $configured !== '' ? $configured : 'jur';
}

/**
 * Updates form displays so the new field is primary and the legacy list is hidden.
 *
 * @param string[] $changes
 *   Human-readable update messages.
 */
function _markaspot_update_11921_sync_form_displays(array &$changes): void {
  $display = EntityFormDisplay::load('node.service_request.management');
  if ($display) {
    $display->setComponent('field_status_internal_term', [
      'type' => 'options_select',
      'weight' => 18,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ]);
    if ($display->getComponent('field_status_internal')) {
      $display->removeComponent('field_status_internal');
    }

    $group = $display->getThirdPartySetting('field_group', 'group_administration');
    if (is_array($group)) {
      $children = array_values(array_filter(
        $group['children'] ?? [],
        static fn($child): bool => $child !== 'field_status_internal'
      ));
      if (!in_array('field_status_internal_term', $children, TRUE)) {
        $status_index = array_search('field_status', $children, TRUE);
        $insert_at = $status_index === FALSE ? 0 : $status_index + 1;
        array_splice($children, $insert_at, 0, ['field_status_internal_term']);
      }
      $group['children'] = $children;
      $display->setThirdPartySetting('field_group', 'group_administration', $group);
    }

    $display->save();
    $changes[] = 'updated service_request management form display';
  }

  $term_display = EntityFormDisplay::load('taxonomy_term.internal_status.default');
  if (!$term_display) {
    $term_display = EntityFormDisplay::create([
      'targetEntityType' => 'taxonomy_term',
      'bundle' => 'internal_status',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $term_display
    ->setComponent('description', [
      'type' => 'text_textarea',
      'weight' => 1,
      'settings' => [
        'rows' => 5,
        'placeholder' => '',
      ],
    ])
    ->setComponent('field_internal_status_code', [
      'type' => 'string_textfield',
      'weight' => 2,
      'settings' => [
        'size' => 60,
        'placeholder' => '',
      ],
    ]);

  if (FieldConfig::loadByName('taxonomy_term', 'internal_status', 'field_jurisdiction')) {
    $term_display->setComponent('field_jurisdiction', [
      'type' => 'entity_reference_autocomplete',
      'weight' => 3,
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
    ]);
  }
  if (FieldConfig::loadByName('taxonomy_term', 'internal_status', 'field_status_definition')) {
    $term_display->setComponent('field_status_definition', [
      'type' => 'status_definition_json_form',
      'weight' => 4,
      'settings' => [
        'schema_type' => 'object',
        'schema_properties' => '',
      ],
    ]);
  }

  $term_display->save();
  $changes[] = 'updated internal_status taxonomy form display';
}

/**
 * Adds internal status fields to the GeoReport manager field contract.
 *
 * @param string[] $changes
 *   Human-readable update messages.
 */
function _markaspot_update_11921_sync_open311_manager_fields(array &$changes): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_open311.settings');
  $fields = $config->get('field_access.manager_fields');
  $fields = is_array($fields) ? array_values($fields) : [];
  $required = [
    'field_status_internal',
    'field_status_internal_term',
  ];
  $missing = array_values(array_diff($required, $fields));

  if ($missing === []) {
    return;
  }

  $config
    ->set('field_access.manager_fields', array_values(array_unique(array_merge($fields, $missing))))
    ->save(TRUE);
  $changes[] = 'added internal status fields to Open311 manager fields';
}

/**
 * Grants staff roles field and taxonomy permissions for internal statuses.
 *
 * @param string[] $valid_permissions
 *   Dynamic permissions currently known by Drupal.
 *
 * @return string[]
 *   Granted permissions in "role: permission" format.
 */
function _markaspot_update_11921_grant_internal_status_permissions(array $valid_permissions): array {
  $granted = [];
  $staff_roles = ['moderator', 'tenant_admin', 'editorial_board'];
  $field_permissions = [];
  foreach (['field_status_internal', 'field_status_internal_term'] as $field_name) {
    foreach (['create', 'view', 'view own', 'edit', 'edit own'] as $operation) {
      $field_permissions[] = "$operation $field_name";
    }
  }
  $dashboard_permissions = [
    'manage dashboard notes',
  ];
  $taxonomy_permissions = [
    'create terms in internal_status',
    'edit terms in internal_status',
    'delete terms in internal_status',
    'translate internal_status taxonomy_term',
  ];

  foreach ($staff_roles as $role_id) {
    $role = Role::load($role_id);
    if (!$role) {
      continue;
    }
    $changed = FALSE;
    foreach ($field_permissions as $permission) {
      if (!in_array($permission, $valid_permissions, TRUE) || $role->hasPermission($permission)) {
        continue;
      }
      $role->grantPermission($permission);
      $granted[] = "$role_id: $permission";
      $changed = TRUE;
    }

    foreach ($dashboard_permissions as $permission) {
      if (!in_array($permission, $valid_permissions, TRUE) || $role->hasPermission($permission)) {
        continue;
      }
      $role->grantPermission($permission);
      $granted[] = "$role_id: $permission";
      $changed = TRUE;
    }

    if (in_array($role_id, ['tenant_admin', 'editorial_board'], TRUE)) {
      foreach ($taxonomy_permissions as $permission) {
        if (!in_array($permission, $valid_permissions, TRUE) || $role->hasPermission($permission)) {
          continue;
        }
        $role->grantPermission($permission);
        $granted[] = "$role_id: $permission";
        $changed = TRUE;
      }
    }

    if ($changed) {
      $role->save();
    }
  }

  return $granted;
}

/**
 * Enables the internal status JSON:API resource for existing tenants.
 *
 * @param string[] $changes
 *   Human-readable update messages.
 */
function _markaspot_update_11921_enable_internal_status_jsonapi_resource(array &$changes): void {
  if (!\Drupal::moduleHandler()->moduleExists('markaspot_nuxt')) {
    $changes[] = 'markaspot_nuxt not installed; skipped internal_status JSON:API resource';
    return;
  }

  $config_name = 'jsonapi_extras.jsonapi_resource_config.taxonomy_term--internal_status';
  $config = \Drupal::configFactory()->getEditable($config_name);
  if (!$config->isNew() && $config->get('disabled') === FALSE) {
    return;
  }

  $source = new FileStorage(\Drupal::service('extension.list.module')->getPath('markaspot_nuxt') . '/config/optional');
  $seed = $source->read($config_name);
  if ($seed === FALSE) {
    $changes[] = 'internal_status JSON:API resource seed config missing';
    return;
  }

  if ($config->isNew()) {
    $config->setData($seed)->save(TRUE);
  }
  else {
    $config
      ->set('disabled', FALSE)
      ->set('path', $seed['path'] ?? 'taxonomy_term/internal_status')
      ->set('resourceType', $seed['resourceType'] ?? 'taxonomy_term--internal_status');
    if (!$config->get('resourceFields') && isset($seed['resourceFields'])) {
      $config->set('resourceFields', $seed['resourceFields']);
    }
    $config->save(TRUE);
  }

  $changes[] = 'enabled internal_status JSON:API resource';
}

/**
 * Returns legacy list values keyed by code for field_status_internal.
 *
 * @return array<string, string>
 *   Legacy code => label map.
 */
function _markaspot_update_11921_legacy_internal_status_values(): array {
  $storage = FieldStorageConfig::loadByName('node', 'field_status_internal');
  $allowed_values = $storage?->getSetting('allowed_values') ?? [];
  $values = [];

  foreach ($allowed_values as $key => $item) {
    if (is_array($item)) {
      $value = $item['value'] ?? $key;
      $label = $item['label'] ?? $value;
    }
    else {
      $value = $key;
      $label = $item;
    }
    if ($value === NULL || $value === '') {
      continue;
    }
    $values[(string) $value] = (string) $label;
  }

  return $values;
}

/**
 * Ensures an internal_status term exists for a legacy code and jurisdiction.
 */
function _markaspot_update_11921_ensure_internal_status_term(string $code, string $label, int $jurisdiction_id, int &$created_terms): ?Term {
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $has_jurisdiction_field = FieldConfig::loadByName('taxonomy_term', 'internal_status', 'field_jurisdiction') !== NULL;
  $term_ids = $term_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'internal_status')
    ->condition('field_internal_status_code', $code)
    ->execute();

  /** @var \Drupal\taxonomy\Entity\Term[] $terms */
  $terms = $term_ids ? Term::loadMultiple($term_ids) : [];
  foreach ($terms as $term) {
    if (!$has_jurisdiction_field) {
      _markaspot_update_11921_copy_status_definition($term, $label, $jurisdiction_id);
      return $term;
    }
    if (!$term->hasField('field_jurisdiction') || $term->get('field_jurisdiction')->isEmpty()) {
      continue;
    }
    if ((int) $term->get('field_jurisdiction')->target_id === $jurisdiction_id) {
      _markaspot_update_11921_copy_status_definition($term, $label, $jurisdiction_id);
      return $term;
    }
  }

  $values = [
    'vid' => 'internal_status',
    'name' => $label,
    'field_internal_status_code' => $code,
    'status' => 1,
  ];
  if (FieldConfig::loadByName('taxonomy_term', 'internal_status', 'field_jurisdiction')) {
    $values['field_jurisdiction'] = ['target_id' => $jurisdiction_id];
  }

  $term = Term::create($values);
  $term->save();
  $created_terms++;
  _markaspot_update_11921_copy_status_definition($term, $label, $jurisdiction_id);

  return $term;
}

/**
 * Copies a matching status definition to an internal status term if empty.
 */
function _markaspot_update_11921_copy_status_definition(Term $internal_status, string $label, int $jurisdiction_id): void {
  if (
    !$internal_status->hasField('field_status_definition') ||
    !$internal_status->get('field_status_definition')->isEmpty()
  ) {
    return;
  }

  $status_ids = \Drupal::entityQuery('taxonomy_term')
    ->accessCheck(FALSE)
    ->condition('vid', 'service_status')
    ->condition('name', $label)
    ->exists('field_status_definition');
  if (FieldConfig::loadByName('taxonomy_term', 'service_status', 'field_jurisdiction')) {
    $status_ids = $status_ids
      ->condition('field_jurisdiction', $jurisdiction_id)
      ->range(0, 1)
      ->execute();
  }
  else {
    $status_ids = $status_ids
      ->range(0, 2)
      ->execute();
    if (count($status_ids) !== 1) {
      return;
    }
  }

  if (!$status_ids) {
    return;
  }

  $status = Term::load(reset($status_ids));
  if (!$status || !$status->hasField('field_status_definition') || $status->get('field_status_definition')->isEmpty()) {
    return;
  }

  $source = $status->get('field_status_definition')->first();
  if (!$source) {
    return;
  }

  $definition_json = _markaspot_update_11921_normalize_status_definition_json((string) $source->value);
  if ($definition_json === NULL) {
    return;
  }

  $internal_status->set('field_status_definition', [
    'value' => $definition_json,
    'format' => $source->format ?? 'plain_text',
  ]);
  $internal_status->save();
}

/**
 * Normalizes legacy status definition JSON to the current schema object shape.
 */
function _markaspot_update_11921_normalize_status_definition_json(string $raw): ?string {
  $raw = trim($raw);
  if ($raw === '') {
    return NULL;
  }

  $definition = json_decode($raw, TRUE);
  if (!is_array($definition)) {
    return NULL;
  }

  if (array_is_list($definition)) {
    $definition = ['attributes' => array_values($definition)];
  }
  elseif (!isset($definition['attributes'])) {
    $definition['attributes'] = [];
  }
  elseif (!is_array($definition['attributes'])) {
    return NULL;
  }
  else {
    $definition['attributes'] = array_values($definition['attributes']);
  }

  return json_encode($definition, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT);
}

/**
 * Migrates legacy list_string internal statuses to jurisdiction-scoped terms.
 *
 * @return array{migrated:int, created_terms:int, skipped:int}
 *   Migration counts.
 */
function _markaspot_update_11921_migrate_legacy_internal_status(): array {
  if (
    !FieldConfig::loadByName('node', 'service_request', 'field_status_internal_term') ||
    !FieldConfig::loadByName('node', 'service_request', 'field_status_internal')
  ) {
    return ['migrated' => 0, 'created_terms' => 0, 'skipped' => 0];
  }

  $legacy_values = _markaspot_update_11921_legacy_internal_status_values();
  $node_ids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'service_request')
    ->exists('field_status_internal')
    ->notExists('field_status_internal_term')
    ->execute();

  $migrated = 0;
  $created_terms = 0;
  $skipped = 0;

  /** @var \Drupal\node\Entity\Node[] $nodes */
  $nodes = $node_ids ? Node::loadMultiple($node_ids) : [];
  foreach ($nodes as $node) {
    if (
      !$node->hasField('field_status_internal') ||
      !$node->hasField('field_status_internal_term') ||
      $node->get('field_status_internal')->isEmpty() ||
      !$node->get('field_status_internal_term')->isEmpty()
    ) {
      continue;
    }

    $legacy_code = (string) $node->get('field_status_internal')->value;
    if ($legacy_code === '') {
      continue;
    }

    if (!$node->hasField('field_jurisdiction') || $node->get('field_jurisdiction')->isEmpty()) {
      $skipped++;
      continue;
    }

    $jurisdiction_id = (int) $node->get('field_jurisdiction')->target_id;
    if ($jurisdiction_id <= 0) {
      $skipped++;
      continue;
    }

    $term = _markaspot_update_11921_ensure_internal_status_term(
      $legacy_code,
      $legacy_values[$legacy_code] ?? $legacy_code,
      $jurisdiction_id,
      $created_terms
    );
    if (!$term) {
      $skipped++;
      continue;
    }

    $node->set('field_status_internal_term', ['target_id' => $term->id()]);
    $node->save();
    $migrated++;
  }

  return [
    'migrated' => $migrated,
    'created_terms' => $created_terms,
    'skipped' => $skipped,
  ];
}

/**
 * Harden operational service-request fields used by dashboard APIs.
 */
function markaspot_update_11922(): string {
  $changes = [];
  $operational_fields = _markaspot_update_11922_operational_fields();

  foreach ($operational_fields as $field_name) {
    $field_storage = FieldStorageConfig::loadByName('node', $field_name);
    if (!$field_storage) {
      continue;
    }

    if ($field_storage->getThirdPartySetting('field_permissions', 'permission_type', 'public') === 'custom') {
      continue;
    }

    $field_storage->setThirdPartySetting('field_permissions', 'permission_type', 'custom');
    $field_storage->save();
    $changes[] = "set $field_name to custom field permissions";
  }

  \Drupal::service('plugin.manager.field.field_type')->clearCachedDefinitions();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  drupal_flush_all_caches();
  $valid_permissions = array_keys(\Drupal::service('user.permissions')->getPermissions());

  $granted = _markaspot_update_11922_grant_operational_field_permissions($valid_permissions);
  if ($granted !== []) {
    $changes[] = 'granted operational field access: ' . implode(', ', $granted);
  }

  return $changes ? implode('; ', $changes) . '.' : 'Operational service-request field permissions already aligned.';
}

/**
 * Lists service-request fields whose API access must be staff-only.
 *
 * @return string[]
 *   Field machine names.
 */
function _markaspot_update_11922_operational_fields(): array {
  return [
    'field_boilerplates_sp',
    'field_hazard_category',
    'field_hazard_level',
    'field_reassign_sp',
    'field_request_attributes',
    'field_risk_score',
    'field_sentiment',
    'field_service_provider_feedback',
    'field_service_provider_files',
    'field_service_provider_notes',
    'field_service_provider_status',
  ];
}

/**
 * Grants dashboard roles access to operational fields when they exist.
 *
 * @param string[] $valid_permissions
 *   Dynamic permissions currently known by Drupal.
 *
 * @return string[]
 *   Granted permissions in "role: permission" format.
 */
function _markaspot_update_11922_grant_operational_field_permissions(array $valid_permissions): array {
  $granted = [];
  $permissions = [];
  foreach (_markaspot_update_11922_operational_fields() as $field_name) {
    foreach (['create', 'view', 'view own', 'edit', 'edit own'] as $operation) {
      $permissions[] = "$operation $field_name";
    }
  }

  foreach (['moderator', 'tenant_admin', 'editorial_board'] as $role_id) {
    $role = Role::load($role_id);
    if (!$role) {
      continue;
    }

    $changed = FALSE;
    foreach ($permissions as $permission) {
      if (!in_array($permission, $valid_permissions, TRUE) || $role->hasPermission($permission)) {
        continue;
      }
      $role->grantPermission($permission);
      $granted[] = "$role_id: $permission";
      $changed = TRUE;
    }

    if ($changed) {
      $role->save();
    }
  }

  return $granted;
}

/**
 * Expose request attributes in the dashboard management form.
 */
function markaspot_update_11923(): string {
  $changes = [];
  _markaspot_update_11923_expose_request_attributes_management_form($changes);

  return $changes ? implode('; ', $changes) . '.' : 'Request attributes already visible in management form display.';
}

/**
 * Adds field_request_attributes to the management form display.
 *
 * The dashboard renders service-definition and internal-status attributes
 * from the management form-mode contract. Keeping the field visible here
 * lets field_permissions stay the access layer while avoiding hardcoded
 * frontend field allow-lists.
 *
 * @param string[] $changes
 *   Human-readable update messages.
 */
function _markaspot_update_11923_expose_request_attributes_management_form(array &$changes): void {
  $field_config = FieldConfig::loadByName('node', 'service_request', 'field_request_attributes');
  if (!$field_config) {
    $changes[] = 'skipped field_request_attributes management component: field instance missing';
    return;
  }

  $display = EntityFormDisplay::load('node.service_request.management');
  if (!$display) {
    $changes[] = 'skipped field_request_attributes management component: display missing';
    return;
  }

  $changed = FALSE;
  $component = $display->getComponent('field_request_attributes');
  if (!$component || ($component['region'] ?? 'content') === 'hidden') {
    $display->setComponent('field_request_attributes', [
      'type' => 'text_textarea',
      'weight' => 20,
      'region' => 'content',
      'settings' => [
        'rows' => 5,
        'placeholder' => '',
      ],
      'third_party_settings' => [],
    ]);
    $changed = TRUE;
  }

  $group = $display->getThirdPartySetting('field_group', 'group_internal');
  if (is_array($group)) {
    $children = array_values(array_filter(
      $group['children'] ?? [],
      static fn($child): bool => $child !== 'field_request_attributes'
    ));
    $internal_status_index = array_search('field_status_internal_term', $children, TRUE);
    $insert_at = $internal_status_index === FALSE ? 0 : $internal_status_index + 1;
    array_splice($children, $insert_at, 0, ['field_request_attributes']);
    if (($group['children'] ?? []) !== $children) {
      $group['children'] = $children;
      $display->setThirdPartySetting('field_group', 'group_internal', $group);
      $changed = TRUE;
    }
  }

  if ($changed) {
    $display->save();
    $changes[] = 'exposed field_request_attributes in service_request management form display';
  }
}

/**
 * Implements hook_requirements().
 */
function markaspot_requirements($phase) {
  $requirements = [];

  if ($phase == 'runtime') {
    $info = \Drupal::service('extension.list.profile')->get('markaspot');
    $requirements['markaspot_profile'] = [
      'title' => t('Mark-a-Spot'),
      'value' => $info->info['version'] ?? t('Unknown'),
      'severity' => REQUIREMENT_INFO,
    ];
  }

  return $requirements;
}
