#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Ilmoituksesi on ratkaistu"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Kiitos, että käytät vikailmoituspalvelua. Ilmoituksesi \"@title\" on käsitelty ja merkitty valmiiksi."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Oletko tyytyväinen lopputulokseen, vai tarvitaanko mielestäsi vielä toimenpiteitä? Arvostaisimme palautettasi suuresti."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Jos mielestäsi asiaasi ei ole vielä ratkaistu kokonaan, voit avata tapauksen uudelleen tämän linkin kautta."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Anna palautetta"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "Palautetta ilmoituksestasi @id"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Ilmoituksesi @id: palautetta toivotaan"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Ilmoitus"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "Sinut on kutsuttu ryhmään \"@group\""

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\" on @site."
msgstr "Sinut on kutsuttu liittymään ryhmään \"@group\" palvelussa @site."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\"."
msgstr "Sinut on kutsuttu liittymään ryhmään \"@group\"."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept your invitation to @group"
msgstr "Hyväksy kutsusi ryhmään @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "Liity ryhmään @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "Hyväksy tämä kutsu napsauttamalla alla olevaa painiketta. Linkki vanhenee 7 päivän kuluttua."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Jos et odottanut tätä kutsua, voit huoletta jättää tämän sähköpostin huomiotta."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Hyväksy kutsu"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "your organisation"
msgstr "organisaatiosi"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id assigned to @organisation"
msgstr "Ilmoitus #@request_id on osoitettu organisaatiolle @organisation"

#: src/Mail/Builder/AssigneeNotificationBuilder.php
msgid "Request #@request_id assigned to you"
msgstr "Ilmoitus #@request_id on osoitettu sinulle"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "This request has been assigned to your organisation for processing."
msgstr "Tämä ilmoitus on osoitettu organisaatiollesi käsiteltäväksi."

#: src/Mail/Builder/AssigneeNotificationBuilder.php
msgid "This request has been assigned to you for processing."
msgstr "Tämä ilmoitus on osoitettu sinulle käsiteltäväksi."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Description: @description"
msgstr "Kuvaus: @description"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request"
msgstr "Ilmoitus"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Category"
msgstr "Luokka"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Location"
msgstr "Sijainti"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Organisation"
msgstr "Organisaatio"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id was assigned to @organisation"
msgstr "Ilmoitus #@request_id osoitettiin organisaatiolle @organisation"

#: src/Mail/Builder/AssigneeNotificationBuilder.php
msgid "Request #@request_id was assigned to you"
msgstr "Ilmoitus #@request_id osoitettiin sinulle"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "A citizen request is ready for review."
msgstr "Kansalaisen ilmoitus on valmis tarkistettavaksi."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Open request"
msgstr "Avaa ilmoitus"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Ota käyttöön @site-työtilasi \"@name\""

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Ota työtilasi käyttöön"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Tervetuloa palveluun @site! Työtilasi \"@name\" on valmiina käyttöönotettavaksi."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Vahvista sähköpostiosoitteesi ja avaa työtila napsauttamalla alla olevaa painiketta."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Vahvistamattomat työtilat poistetaan automaattisesti @days päivän jälkeen."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "Vahvista sähköposti"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Napsauta aktivoidaksesi työtilasi @name"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "Demo-työtilasi \"@name\" vanhenee pian"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "Demo-työtila \"@name\" vanhenee @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Demosi vanhenee @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date unless you choose a plan."
msgstr "Demo-työtila \"@name\" poistetaan automaattisesti @date, ellet valitse tilausta."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "You can keep your workspace, history and settings for free. Choose a plan before it expires, including our Free tier at no cost. If you do nothing, the workspace will be removed."
msgstr "Voit säilyttää työtilasi, historiasi ja asetuksesi maksutta. Valitse tilaus ennen sen vanhentumista, mukaan lukien täysin maksuton Free-tilaus. Jos et tee mitään, työtila poistetaan."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Avaa työtilani"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Keep my workspace"
msgstr "Säilytä työtila"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Työtila"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Vanhenee"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Vahvistuskoodisi"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Vahvista tilisi"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Vahvistuskoodisi: @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Syötä tämä koodi seuraavien @minutes minuutin aikana. Jos et pyytänyt sitä, voit jättää tämän sähköpostin huomiotta."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Vahvistuskoodisi: @code\n\nSe vanhenee @minutes minuutin kuluttua."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Ilmoituksesi tarvitsee lisätietoja"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Tarvitsemme lisätietoja ilmoituksestasi"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Tarkenna ilmoitustasi"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Tarvitsemme vielä hieman lisätietoja voidaksemme käsitellä ilmoituksesi."

#: templates/mail-layout.html.twig
msgid "Docs"
msgstr "Dokumentaatio"

#: templates/mail-layout.html.twig
msgid "Impressum"
msgstr "Impressum"

#: templates/mail-layout.html.twig
msgid "Datenschutz"
msgstr "Datenschutz"

#: templates/mail-layout.html.twig
msgid "Legal notice"
msgstr "Oikeudelliset tiedot"

#: templates/mail-layout.html.twig
msgid "Privacy"
msgstr "Tietosuoja"

#: templates/mail-layout.html.twig
msgid "This e-mail was sent automatically by @name via the Mark-a-Spot platform."
msgstr "Tämä sähköposti lähetettiin automaattisesti palvelusta @name Mark-a-Spot-alustan kautta."

