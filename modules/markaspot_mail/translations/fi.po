msgstr "Päivitys on saatavilla: @wording_singular_title. Katso lisätiedot alustalta."

#: src/Mail/Builder/WorkspaceWelcomeBuilder.php
msgid "Try it out: create your first test @wording_singular directly on the map."
msgstr "Kokeile: luo testikohde suoraan kartalle. Tyyppi: @wording_singular."

#: src/Mail/Builder/WorkspaceWelcomeBuilder.php
msgid "A few demo @wording_plural are already in place. Edit or delete them anytime."
msgstr "Demosisältöä on jo saatavilla. Demo: @wording_plural. Voit muokata tai poistaa sitä milloin tahansa."

#: src/Mail/Builder/WorkspaceWelcomeBuilder.php
msgid "Manage incoming @wording_plural in your dashboard: <a href=\":url\" style=\"color:#2563eb; text-decoration:underline;\">:url</a>"
msgstr "Hallitse saapuvia kohteita hallintapaneelissa. @wording_plural: <a href=\":url\" style=\"color:#2563eb; text-decoration:underline;\">:url</a>"
