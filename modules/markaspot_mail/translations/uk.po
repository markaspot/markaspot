#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Ваше повідомлення опрацьовано"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Дякуємо, що користуєтеся сервісом повідомлень про проблеми. Ваше повідомлення \"@title\" опрацьовано й позначено як завершене."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Чи задоволені ви результатом, чи, на вашу думку, ще потрібні додаткові дії? Ми будемо дуже вдячні за ваш відгук."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Якщо ви вважаєте, що ваше питання ще не вирішено повністю, ви також можете знову відкрити його за цим посиланням."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Надіслати відгук"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "Чекаємо на ваш відгук щодо повідомлення @id"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Ваше повідомлення @id: чекаємо на ваш відгук"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Повідомлення"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "Вас запросили до \"@group\""

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\" on @site."
msgstr "Вас запросили приєднатися до \"@group\" на @site."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\"."
msgstr "Вас запросили приєднатися до \"@group\"."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept your invitation to @group"
msgstr "Прийняти запрошення до @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "Приєднатися до @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "Натисніть кнопку нижче, щоб прийняти це запрошення. Термін дії посилання спливає через 7 днів."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Якщо ви не очікували на це запрошення, можете просто проігнорувати цей лист."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Прийняти запрошення"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "your organisation"
msgstr "вашій організації"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id assigned to @organisation"
msgstr "Повідомлення №@request_id призначено @organisation"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "This request has been assigned to your organisation for processing."
msgstr "Це повідомлення призначено вашій організації для опрацювання."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Description: @description"
msgstr "Опис: @description"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request"
msgstr "Повідомлення"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Category"
msgstr "Категорія"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Location"
msgstr "Місце"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Organisation"
msgstr "Організація"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id was assigned to @organisation"
msgstr "Повідомлення №@request_id призначено @organisation"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "A citizen request is ready for review."
msgstr "Повідомлення від громадянина готове до перегляду."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Open request"
msgstr "Відкрити повідомлення"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Активуйте свій робочий простір \"@name\" у @site"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Активуйте свій робочий простір"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Вітаємо в @site! Ваш робочий простір \"@name\" готовий до активації."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Натисніть кнопку нижче, щоб підтвердити свою електронну адресу й розблокувати робочий простір."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Непідтверджені робочі простори автоматично видаляються через @days днів."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "Підтвердити електронну адресу"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Натисніть, щоб активувати свій робочий простір @name"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "Термін дії вашого демо-робочого простору \"@name\" скоро спливає"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "Термін дії демо-робочого простору \"@name\" спливає @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Термін дії вашого демо спливає @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date unless you choose a plan."
msgstr "Демо-робочий простір \"@name\" буде автоматично видалено @date, якщо ви не виберете план."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "You can keep your workspace, history and settings for free. Choose a plan before it expires, including our Free tier at no cost. If you do nothing, the workspace will be removed."
msgstr "Ви можете безкоштовно зберегти свій робочий простір, історію та налаштування. Виберіть план до завершення терміну дії, зокрема наш повністю безкоштовний план Free. Якщо ви нічого не зробите, робочий простір буде видалено."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Відкрити мій робочий простір"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Keep my workspace"
msgstr "Зберегти робочий простір"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Робочий простір"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Спливає"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Ваш код підтвердження"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Підтвердьте свій обліковий запис"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Ваш код підтвердження: @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Введіть цей код протягом наступних @minutes хвилин. Якщо ви його не запитували, можете проігнорувати цей лист."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Ваш код підтвердження: @code\n\nТермін його дії спливає через @minutes хвилин."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Вашому повідомленню потрібна додаткова інформація"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Нам потрібна додаткова інформація про ваше повідомлення"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Будь ласка, уточніть своє повідомлення"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Нам потрібно трохи більше інформації, щоб опрацювати ваше повідомлення."

#: templates/mail-layout.html.twig
msgid "Docs"
msgstr "Документація"

#: templates/mail-layout.html.twig
msgid "Impressum"
msgstr "Impressum"

#: templates/mail-layout.html.twig
msgid "Datenschutz"
msgstr "Datenschutz"

#: templates/mail-layout.html.twig
msgid "Legal notice"
msgstr "Правова інформація"

#: templates/mail-layout.html.twig
msgid "Privacy"
msgstr "Конфіденційність"

#: templates/mail-layout.html.twig
msgid "This e-mail was sent automatically by @name via the Mark-a-Spot platform."
msgstr "Цей електронний лист було автоматично надіслано @name через платформу Mark-a-Spot."

