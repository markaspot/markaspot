#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Bejelentése megoldódott"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Köszönjük, hogy használja a hibabejelentőt. \"@title\" bejelentését feldolgoztuk, és most lezártként van megjelölve."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Elégedett az eredménnyel, vagy az Ön megítélése szerint további intézkedésre van szükség? Nagyra értékelnénk visszajelzését."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Ha úgy gondolja, hogy ügyét még nem kezelték teljes körűen, ezen a linken újra megnyithatja azt."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Visszajelzés küldése"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "Visszajelzését várjuk a @id azonosítójú bejelentésről"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Az Ön @id azonosítójú bejelentése: visszajelzését várjuk"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Bejelentés"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "Meghívást kapott ide: \"@group\""

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\" on @site."
msgstr "Meghívást kapott, hogy csatlakozzon ehhez: \"@group\" itt: @site."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\"."
msgstr "Meghívást kapott, hogy csatlakozzon ehhez: \"@group\"."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept your invitation to @group"
msgstr "Fogadja el a @group csoportba szóló meghívását"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "Csatlakozás: @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "A meghívás elfogadásához kattintson az alábbi gombra. A link 7 nap múlva lejár."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Ha nem számított erre a meghívásra, nyugodtan figyelmen kívül hagyhatja ezt az e-mailt."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Meghívás elfogadása"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "your organisation"
msgstr "szervezete"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id assigned to @organisation"
msgstr "A(z) #@request_id számú bejelentés hozzá lett rendelve ehhez: @organisation"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "This request has been assigned to your organisation for processing."
msgstr "Ez a bejelentés feldolgozásra hozzá lett rendelve az Ön szervezetéhez."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Description: @description"
msgstr "Leírás: @description"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request"
msgstr "Bejelentés"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Category"
msgstr "Kategória"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Location"
msgstr "Helyszín"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Organisation"
msgstr "Szervezet"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id was assigned to @organisation"
msgstr "A(z) #@request_id számú bejelentés hozzá lett rendelve ehhez: @organisation"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "A citizen request is ready for review."
msgstr "Egy lakossági bejelentés felülvizsgálatra vár."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Open request"
msgstr "Bejelentés megnyitása"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Aktiválja @site \"@name\" munkaterületét"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Aktiválja a munkaterületét"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Üdvözöljük a @site oldalon! \"@name\" munkaterülete készen áll az aktiválásra."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Az e-mail-cím megerősítéséhez és a munkaterület feloldásához kattintson az alábbi gombra."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "A meg nem erősített munkaterületek @days nap után automatikusan törlődnek."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "E-mail megerősítése"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Kattintson ide a @name munkaterület aktiválásához"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "\"@name\" bemutató munkaterülete hamarosan lejár"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "\"@name\" bemutató munkaterülete ekkor jár le: @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "A bemutatója ekkor jár le: @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date unless you choose a plan."
msgstr "\"@name\" bemutató munkaterülete automatikusan törlődik ekkor: @date, hacsak nem választ csomagot."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "You can keep your workspace, history and settings for free. Choose a plan before it expires, including our Free tier at no cost. If you do nothing, the workspace will be removed."
msgstr "Munkaterületét, előzményeit és beállításait ingyenesen megtarthatja. Válasszon csomagot a lejárat előtt, többek között a teljesen ingyenes Free csomagot. Ha nem tesz semmit, a munkaterület törlődik."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Munkaterület megnyitása"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Keep my workspace"
msgstr "Munkaterület megtartása"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Munkaterület"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Lejár"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Az Ön ellenőrző kódja"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Erősítse meg a fiókját"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Az Ön ellenőrző kódja: @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Adja meg ezt a kódot a következő @minutes percben. Ha nem Ön kérte, nyugodtan figyelmen kívül hagyhatja ezt az e-mailt."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Az Ön ellenőrző kódja: @code\n\nA kód @minutes perc múlva lejár."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Bejelentéséhez további adatokra van szükség"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "További információra van szükségünk a bejelentéséről"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Kérjük, pontosítsa a bejelentését"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Még egy kis további információra van szükségünk a bejelentés feldolgozásához."

#: templates/mail-layout.html.twig
msgid "Docs"
msgstr "Dokumentáció"

#: templates/mail-layout.html.twig
msgid "Impressum"
msgstr "Impressum"

#: templates/mail-layout.html.twig
msgid "Datenschutz"
msgstr "Datenschutz"

#: templates/mail-layout.html.twig
msgid "Legal notice"
msgstr "Jogi tájékoztató"

#: templates/mail-layout.html.twig
msgid "Privacy"
msgstr "Adatvédelem"

#: templates/mail-layout.html.twig
msgid "This e-mail was sent automatically by @name via the Mark-a-Spot platform."
msgstr "Ezt az e-mailt a(z) @name automatikusan küldte a Mark-a-Spot platformon keresztül."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "@wording_singular_title was resolved"
msgstr "@wording_singular_title: az ügyintézés lezárult"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. @wording_singular_title \"@title\" has been processed and is now marked as completed."
msgstr "Köszönjük, hogy használja a hibabejelentőt. @wording_singular_title \"@title\": az ügyintézés lezárult."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome for @wording_singular_title @id"
msgstr "Visszajelzést várunk: @wording_singular_title @id"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "@wording_singular_title @id: feedback welcome"
msgstr "@wording_singular_title @id: visszajelzést várunk"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "More information needed: @wording_singular_title"
msgstr "További információ szükséges: @wording_singular_title"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "More information is needed: @wording_singular_title."
msgstr "Az ügyintézéshez további információ szükséges: @wording_singular_title."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify: @wording_singular_title"
msgstr "Kérjük, pontosítsa: @wording_singular_title"

#: markaspot_mail.module
msgid "Update: @wording_singular_title"
msgstr "Frissítés: @wording_singular_title"

#: markaspot_mail.module
msgid "There is an update: @wording_singular_title. Please check the platform for details."
msgstr "Frissítés érhető el: @wording_singular_title. A részleteket a platformon találja."

#: src/Mail/Builder/WorkspaceWelcomeBuilder.php
msgid "Try it out: create your first test @wording_singular directly on the map."
msgstr "Próbálja ki: hozzon létre egy tesztelemet közvetlenül a térképen. Típus: @wording_singular."

#: src/Mail/Builder/WorkspaceWelcomeBuilder.php
msgid "A few demo @wording_plural are already in place. Edit or delete them anytime."
msgstr "Demótartalom már rendelkezésre áll. Bemutató: @wording_plural. Bármikor szerkesztheti vagy törölheti."

#: src/Mail/Builder/WorkspaceWelcomeBuilder.php
msgid "Manage incoming @wording_plural in your dashboard: <a href=\":url\" style=\"color:#2563eb; text-decoration:underline;\">:url</a>"
msgstr "Kezelje a beérkező elemeket az irányítópultján. @wording_plural: <a href=\":url\" style=\"color:#2563eb; text-decoration:underline;\">:url</a>"
