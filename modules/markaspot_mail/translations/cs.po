#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Vaše hlášení bylo vyřešeno"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Děkujeme, že používáte systém hlášení. Vaše hlášení \"@title\" bylo zpracováno a je nyní označeno jako dokončené."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Jste s výsledkem spokojeni, nebo je podle vás ještě potřeba další postup? Vaši zpětnou vazbu velmi oceníme."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Pokud se domníváte, že vaše záležitost nebyla zcela vyřešena, můžete případ znovu otevřít prostřednictvím tohoto odkazu."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Odeslat zpětnou vazbu"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "Uvítáme zpětnou vazbu k vašemu hlášení @id"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Vaše hlášení @id: uvítáme zpětnou vazbu"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Hlášení"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "Byli jste pozváni do \"@group\""

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\" on @site."
msgstr "Byli jste pozváni, abyste se připojili k \"@group\" na @site."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\"."
msgstr "Byli jste pozváni, abyste se připojili k \"@group\"."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept your invitation to @group"
msgstr "Přijměte pozvánku do @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "Připojit se k @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "Kliknutím na tlačítko níže tuto pozvánku přijmete. Odkaz vyprší za 7 dní."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Pokud jste tuto pozvánku neočekávali, můžete tento e-mail bez obav ignorovat."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Přijmout pozvánku"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Aktivujte pracovní prostor \"@name\" na @site"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Aktivovat pracovní prostor"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Vítejte na @site! Váš pracovní prostor \"@name\" je připraven k aktivaci."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Kliknutím na tlačítko níže ověříte svůj e-mail a odemknete pracovní prostor."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Neověřené pracovní prostory jsou po @days dnech automaticky odstraněny."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "Ověřit e-mail"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Kliknutím aktivujete pracovní prostor @name"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "Váš demo pracovní prostor \"@name\" brzy vyprší"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "Demo pracovní prostor \"@name\" vyprší @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Vaše demo vyprší @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date."
msgstr "Demo pracovní prostor \"@name\" bude automaticky odstraněn dne @date."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Upgrade now to keep your workspace, history and settings, or ignore this email to let it expire."
msgstr "Upgradujte nyní, abyste zachovali pracovní prostor, historii a nastavení, nebo tento e-mail ignorujte a nechte demo vypršet."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Otevřít můj pracovní prostor"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Create a permanent workspace"
msgstr "Vytvořit trvalý pracovní prostor"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Pracovní prostor"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Vyprší"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Váš ověřovací kód"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Ověřte svůj účet"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Váš ověřovací kód: @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Zadejte tento kód během následujících @minutes minut. Pokud jste o něj nežádali, můžete tento e-mail ignorovat."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Váš ověřovací kód: @code\n\nVyprší za @minutes minut."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Vaše hlášení vyžaduje další informace"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Potřebujeme více informací k vašemu hlášení"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Upřesněte prosím své hlášení"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "K vyřízení vašeho hlášení potřebujeme ještě několik informací."

#: templates/mail-layout.html.twig
msgid "Docs"
msgstr "Dokumentace"

#: templates/mail-layout.html.twig
msgid "Impressum"
msgstr "Impressum"

#: templates/mail-layout.html.twig
msgid "Datenschutz"
msgstr "Datenschutz"

#: templates/mail-layout.html.twig
msgid "Legal notice"
msgstr "Právní informace"

#: templates/mail-layout.html.twig
