#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Ihre Meldung ist erledigt"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Danke, dass Sie den Mängel-Melder benutzen. Ihre Meldung \"@title\" wurde bearbeitet. Jetzt ist sie als erledigt markiert."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Sind Sie mit dem Ergebnis zufrieden? Oder muss noch etwas gemacht werden? Wir freuen uns über Ihre Rückmeldung."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Wenn Ihr Anliegen noch nicht ganz bearbeitet ist, können Sie den Fall über diesen Link wieder öffnen."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Rückmeldung geben"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "Ihre Rückmeldung zu Ihrer Meldung @id"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Ihre Meldung @id: Wir freuen uns über Ihre Rückmeldung"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Meldung"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "Sie wurden zu \"@group\" eingeladen"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\" on @site."
msgstr "Sie wurden eingeladen. Sie können \"@group\" auf @site beitreten."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\"."
msgstr "Sie wurden eingeladen. Sie können \"@group\" beitreten."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept your invitation to @group"
msgstr "Einladung zu @group annehmen"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "@group beitreten"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "Klicken Sie auf den Button unten. So nehmen Sie die Einladung an. Der Link ist 7 Tage gültig."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Wenn Sie diese Einladung nicht erwartet haben, können Sie diese E-Mail ignorieren."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Einladung annehmen"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "your organisation"
msgstr "Ihrer Organisation"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id assigned to @organisation"
msgstr "Meldung #@request_id wurde @organisation zugewiesen"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "This request has been assigned to your organisation for processing."
msgstr "Diese Meldung wurde Ihrer Organisation zur Bearbeitung zugewiesen."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Description: @description"
msgstr "Beschreibung: @description"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request"
msgstr "Meldung"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Category"
msgstr "Kategorie"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Location"
msgstr "Standort"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Organisation"
msgstr "Organisation"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id was assigned to @organisation"
msgstr "Meldung #@request_id wurde @organisation zugewiesen"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "A citizen request is ready for review."
msgstr "Eine Meldung ist zur Bearbeitung bereit."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Open request"
msgstr "Meldung öffnen"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Aktivieren Sie Ihren Arbeits-Bereich \"@name\" bei @site"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Arbeits-Bereich aktivieren"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Willkommen bei @site! Ihr Arbeits-Bereich \"@name\" kann jetzt aktiviert werden."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Klicken Sie auf den Button unten. So bestätigen Sie Ihre E-Mail-Adresse und schalten den Arbeits-Bereich frei."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Nicht bestätigte Arbeits-Bereiche werden nach @days Tagen automatisch gelöscht."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "E-Mail-Adresse bestätigen"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Klicken Sie hier, um Ihren Arbeits-Bereich @name zu aktivieren"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "Ihr Demo-Arbeits-Bereich \"@name\" läuft bald ab"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "Der Demo-Arbeits-Bereich \"@name\" läuft am @date ab"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Ihre Demo läuft am @date ab"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date unless you choose a plan."
msgstr "Der Demo-Arbeits-Bereich \"@name\" wird am @date automatisch gelöscht. Das passiert nur, wenn Sie keinen Tarif wählen."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "You can keep your workspace, history and settings for free. Choose a plan before it expires, including our Free tier at no cost. If you do nothing, the workspace will be removed."
msgstr "Sie können Ihren Arbeits-Bereich behalten. Auch Ihren Verlauf und Ihre Einstellungen. Das kostet nichts. Wählen Sie einen Tarif, bevor die Demo abläuft. Es gibt auch den Free-Tarif. Der Free-Tarif ist kostenlos. Wenn Sie nichts tun, wird der Arbeits-Bereich gelöscht."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Meinen Arbeits-Bereich öffnen"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Keep my workspace"
msgstr "Arbeits-Bereich behalten"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Arbeits-Bereich"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Läuft ab"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Ihr Bestätigungs-Code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Konto bestätigen"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Ihr Bestätigungs-Code: @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Geben Sie diesen Code in den nächsten @minutes Minuten ein. Wenn Sie den Code nicht angefordert haben, können Sie diese E-Mail ignorieren."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Ihr Bestätigungs-Code: @code\n\nEr läuft in @minutes Minuten ab."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Ihre Meldung braucht mehr Informationen"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Wir brauchen mehr Informationen zu Ihrer Meldung"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Bitte ergänzen Sie Ihre Meldung"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Wir brauchen noch ein paar Informationen, damit wir Ihre Meldung bearbeiten können."

