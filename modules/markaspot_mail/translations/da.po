#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Din indberetning er blevet løst"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Tak fordi du bruger fejlmelderen. Din indberetning \"@title\" er blevet behandlet og er nu markeret som afsluttet."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Er du tilfreds med resultatet, eller er der stadig behov for handling set fra dit perspektiv? Vi vil sætte stor pris på din feedback."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Hvis du mener, at din sag ikke er blevet fuldt behandlet, kan du også genåbne den via dette link."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Giv feedback"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "Vi vil gerne have feedback på din indberetning @id"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Din indberetning @id: feedback ønskes"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Indberetning"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "Du er blevet inviteret til \"@group\""

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\" on @site."
msgstr "Du er blevet inviteret til at deltage i \"@group\" på @site."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\"."
msgstr "Du er blevet inviteret til at deltage i \"@group\"."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept your invitation to @group"
msgstr "Accepter din invitation til @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "Deltag i @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "Klik på knappen nedenfor for at acceptere invitationen. Linket udløber om 7 dage."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Hvis du ikke forventede denne invitation, kan du roligt ignorere denne e-mail."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Accepter invitation"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "your organisation"
msgstr "din organisation"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id assigned to @organisation"
msgstr "Henvendelse #@request_id er tildelt @organisation"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "This request has been assigned to your organisation for processing."
msgstr "Denne henvendelse er tildelt din organisation til behandling."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Description: @description"
msgstr "Beskrivelse: @description"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request"
msgstr "Henvendelse"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Category"
msgstr "Kategori"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Location"
msgstr "Placering"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Organisation"
msgstr "Organisation"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id was assigned to @organisation"
msgstr "Henvendelse #@request_id blev tildelt @organisation"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "A citizen request is ready for review."
msgstr "En borgerhenvendelse er klar til gennemgang."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Open request"
msgstr "Åbn henvendelse"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Aktivér dit @site-arbejdsområde \"@name\""

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Aktivér dit arbejdsområde"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Velkommen til @site! Dit arbejdsområde \"@name\" er klar til at blive aktiveret."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Klik på knappen nedenfor for at bekræfte din e-mail og låse arbejdsområdet op."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Arbejdsområder, der ikke er bekræftet, fjernes automatisk efter @days dage."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "Bekræft e-mail"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Klik for at aktivere dit arbejdsområde @name"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "Dit demo-arbejdsområde \"@name\" udløber snart"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "Demo-arbejdsområdet \"@name\" udløber den @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Din demo udløber den @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date unless you choose a plan."
msgstr "Demo-arbejdsområdet \"@name\" fjernes automatisk den @date, medmindre du vælger en plan."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "You can keep your workspace, history and settings for free. Choose a plan before it expires, including our Free tier at no cost. If you do nothing, the workspace will be removed."
msgstr "Du kan beholde dit arbejdsområde, din historik og dine indstillinger gratis. Vælg en plan, før den udløber, herunder vores Free-plan helt uden omkostninger. Hvis du ikke gør noget, fjernes arbejdsområdet."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Åbn mit arbejdsområde"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Keep my workspace"
msgstr "Behold mit arbejdsområde"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Arbejdsområde"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Udløber"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Din bekræftelseskode"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Bekræft din konto"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Din bekræftelseskode: @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Indtast denne kode inden for de næste @minutes minutter. Hvis du ikke har anmodet om den, kan du ignorere denne e-mail."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Din bekræftelseskode: @code\n\nDen udløber om @minutes minutter."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Din indberetning kræver flere oplysninger"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Vi har brug for flere oplysninger om din indberetning"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Uddyb venligst din indberetning"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Vi har brug for lidt flere oplysninger for at kunne behandle din indberetning."

