#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Votre signalement a été traité"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Merci d'utiliser le service de signalement. Votre signalement \"@title\" a été traité et est désormais marqué comme terminé."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Êtes-vous satisfait du résultat ou estimez-vous qu'une action reste nécessaire ? Nous apprécierions beaucoup votre retour."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Si vous estimez que votre demande n'a pas été entièrement traitée, vous pouvez également rouvrir le dossier via ce lien."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Donner mon avis"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "Votre retour sur votre signalement @id"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Votre signalement @id : retour souhaité"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Signalement"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "Vous avez été invité à \"@group\""

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
