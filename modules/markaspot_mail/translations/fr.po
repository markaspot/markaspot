#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Activez votre espace de travail \"@name\" sur @site"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Activez votre espace de travail"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Bienvenue sur @site ! Votre espace de travail \"@name\" est prêt à être activé."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Cliquez sur le bouton ci-dessous pour vérifier votre adresse e-mail et déverrouiller l'espace de travail."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Les espaces de travail non vérifiés sont automatiquement supprimés après @days jours."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "Vérifier l'adresse e-mail"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Cliquez pour activer votre espace de travail @name"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "Votre espace de travail de démonstration \"@name\" expire bientôt"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "L'espace de travail de démonstration \"@name\" expire le @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Votre démonstration expire le @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date unless you choose a plan."
msgstr "L'espace de travail de démonstration \"@name\" sera automatiquement supprimé le @date, sauf si vous choisissez une formule."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "You can keep your workspace, history and settings for free. Choose a plan before it expires, including our Free tier at no cost. If you do nothing, the workspace will be removed."
msgstr "Vous pouvez conserver votre espace de travail, votre historique et vos paramètres gratuitement. Choisissez une formule avant son expiration, y compris notre formule Free, sans aucuns frais. Si vous ne faites rien, l'espace de travail sera supprimé."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Ouvrir mon espace de travail"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Keep my workspace"
msgstr "Conserver mon espace de travail"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Espace de travail"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Expire"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Votre code de vérification"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Vérifiez votre compte"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Votre code de vérification : @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Saisissez ce code dans les @minutes prochaines minutes. Si vous ne l'avez pas demandé, vous pouvez ignorer cet e-mail."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Votre code de vérification : @code\n\nIl expire dans @minutes minutes."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Votre signalement nécessite plus d'informations"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Nous avons besoin de plus d'informations sur votre signalement"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Veuillez préciser votre signalement"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Nous avons besoin d'un peu plus d'informations pour traiter votre signalement."

