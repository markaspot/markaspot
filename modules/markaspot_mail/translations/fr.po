#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Votre signalement a été traité"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Merci d'utiliser le service de signalement. Votre signalement \"@title\" a été traité et est désormais marqué comme terminé."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Êtes-vous satisfait du résultat ou estimez-vous qu'une action reste nécessaire ? Nous apprécierions beaucoup votre retour."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Si vous estimez que votre demande n'a pas été entièrement traitée, vous pouvez également rouvrir le dossier via ce lien."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Donner mon avis"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "Votre retour sur votre signalement @id"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Votre signalement @id : retour souhaité"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Signalement"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "Vous avez été invité à \"@group\""

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\" on @site."
msgstr "Vous avez été invité à rejoindre \"@group\" sur @site."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\"."
msgstr "Vous avez été invité à rejoindre \"@group\"."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept your invitation to @group"
msgstr "Acceptez votre invitation à @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "Rejoindre @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "Cliquez sur le bouton ci-dessous pour accepter cette invitation. Le lien expire dans 7 jours."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Si vous n'attendiez pas cette invitation, vous pouvez ignorer cet e-mail en toute sécurité."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Accepter l'invitation"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Activez votre espace de travail \"@name\" sur @site"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Activez votre espace de travail"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Bienvenue sur @site ! Votre espace de travail \"@name\" est prêt à être activé."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Cliquez sur le bouton ci-dessous pour vérifier votre adresse e-mail et déverrouiller l'espace de travail."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Les espaces de travail non vérifiés sont automatiquement supprimés après @days jours."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "Vérifier l'adresse e-mail"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Cliquez pour activer votre espace de travail @name"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "Votre espace de travail de démonstration \"@name\" expire bientôt"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "L'espace de travail de démonstration \"@name\" expire le @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Votre démonstration expire le @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date."
msgstr "L'espace de travail de démonstration \"@name\" sera automatiquement supprimé le @date."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Upgrade now to keep your workspace, history and settings, or ignore this email to let it expire."
msgstr "Passez à une offre supérieure dès maintenant pour conserver votre espace de travail, votre historique et vos paramètres, ou ignorez cet e-mail pour le laisser expirer."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Ouvrir mon espace de travail"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Create a permanent workspace"
msgstr "Créer un espace de travail permanent"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Espace de travail"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Expire"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Votre code de vérification"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Vérifiez votre compte"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Votre code de vérification : @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Saisissez ce code dans les @minutes prochaines minutes. Si vous ne l'avez pas demandé, vous pouvez ignorer cet e-mail."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Votre code de vérification : @code\n\nIl expire dans @minutes minutes."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Votre signalement nécessite plus d'informations"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Nous avons besoin de plus d'informations sur votre signalement"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Veuillez préciser votre signalement"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Nous avons besoin d'un peu plus d'informations pour traiter votre signalement."

