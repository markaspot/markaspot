msgstr "Arbeitsbereich"

msgid "Expires"
msgstr "Läuft ab"

msgid "@platform_name: Your verification code"
msgstr "@platform_name: Ihr Bestätigungscode"

msgid "Verify your account"
msgstr "Konto bestätigen"

msgid "Your verification code: @code"
msgstr "Ihr Bestätigungscode: @code"

msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Geben Sie diesen Code innerhalb der nächsten @minutes Minuten ein. Falls Sie den Code nicht angefordert haben, können Sie die E-Mail ignorieren."

msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Ihr Bestätigungscode: @code\n\nEr läuft in @minutes Minuten ab."

