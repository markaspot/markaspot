msgstr "Weitere Angaben werden benötigt: @wording_singular_title."

msgid "Please clarify your report"
msgstr "Bitte Meldung ergänzen"

msgid "Please clarify: @wording_singular_title"
msgstr "Bitte ergänzen: @wording_singular_title"

msgid "We need a bit more information to process your report."
msgstr "Wir benötigen noch ein paar Angaben, um Ihre Meldung weiterzubearbeiten."

msgid "Update: @wording_singular_title"
msgstr "Update: @wording_singular_title"

msgid "There is an update: @wording_singular_title. Please check the platform for details."
msgstr "Es gibt ein Update: @wording_singular_title. Bitte prüfen Sie die Plattform für Details."

