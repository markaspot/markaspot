msgstr "Esta incidencia se ha asignado a su organización para su tramitación."

#: src/Mail/Builder/AssigneeNotificationBuilder.php
msgid "This request has been assigned to you for processing."
msgstr "Esta incidencia se le ha asignado para su tramitación."

