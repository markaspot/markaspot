msgstr "Acepte su invitación a @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "Únase a @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "Haga clic en el botón de abajo para aceptar esta invitación. El enlace caduca en 7 días."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Si no esperaba esta invitación, puede ignorar este correo electrónico con total tranquilidad."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Aceptar invitación"

