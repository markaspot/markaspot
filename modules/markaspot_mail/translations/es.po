msgstr "Abrir incidencia"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Active su espacio de trabajo \"@name\" de @site"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Active su espacio de trabajo"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Bienvenido a @site. Su espacio de trabajo \"@name\" está listo para activarse."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Haga clic en el botón de abajo para verificar su correo electrónico y desbloquear el espacio de trabajo."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Los espacios de trabajo no verificados se eliminan automáticamente después de @days días."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "Verificar correo electrónico"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Haga clic para activar su espacio de trabajo @name"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "Su espacio de trabajo de demostración \"@name\" caduca pronto"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "El espacio de trabajo de demostración \"@name\" caduca el @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Su demostración caduca el @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date unless you choose a plan."
msgstr "El espacio de trabajo de demostración \"@name\" se eliminará automáticamente el @date, a menos que elijas un plan."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "You can keep your workspace, history and settings for free. Choose a plan before it expires, including our Free tier at no cost. If you do nothing, the workspace will be removed."
msgstr "Puedes conservar tu espacio de trabajo, historial y configuración de forma gratuita. Elige un plan antes de que caduque, incluido nuestro plan Free, sin coste alguno. Si no haces nada, el espacio de trabajo se eliminará."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Abrir mi espacio de trabajo"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Keep my workspace"
msgstr "Conservar mi espacio de trabajo"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Espacio de trabajo"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Caduca"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Su código de verificación"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Verifique su cuenta"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Su código de verificación: @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Introduzca este código en los próximos @minutes minutos. Si no lo solicitó, puede ignorar este correo electrónico."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Su código de verificación: @code\n\nCaduca en @minutes minutos."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Su incidencia necesita más información"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Necesitamos más información sobre su incidencia"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Aclare su incidencia, por favor"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Necesitamos un poco más de información para procesar su incidencia."

