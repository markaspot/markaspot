#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Bildiriminiz çözüldü"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Sorun bildirim sistemini kullandığınız için teşekkür ederiz. \"@title\" başlıklı bildiriminiz işlendi ve şimdi tamamlandı olarak işaretlendi."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Sonuçtan memnun musunuz, yoksa sizin açınızdan hâlâ bir işlem yapılması gerekiyor mu? Geri bildiriminiz bizim için çok değerli."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Konunuzun tam olarak ele alınmadığını düşünüyorsanız, bu bağlantı üzerinden kaydı yeniden açabilirsiniz."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Geri bildirim ver"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "@id numaralı bildiriminiz için geri bildiriminizi bekliyoruz"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Bildiriminiz @id: geri bildiriminizi bekliyoruz"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Bildirim"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "\"@group\" için davet aldınız"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\" on @site."
msgstr "@site üzerinde \"@group\" grubuna katılmanız için davet aldınız."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\"."
msgstr "\"@group\" grubuna katılmanız için davet aldınız."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept your invitation to @group"
msgstr "@group davetinizi kabul edin"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "@group grubuna katılın"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "Bu daveti kabul etmek için aşağıdaki düğmeye tıklayın. Bağlantının süresi 7 gün içinde dolacaktır."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Bu daveti beklemiyorduysanız, bu e-postayı güvenle yok sayabilirsiniz."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Daveti kabul et"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "your organisation"
msgstr "kuruluşunuz"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id assigned to @organisation"
msgstr "@request_id numaralı bildirim @organisation kuruluşuna atandı"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "This request has been assigned to your organisation for processing."
msgstr "Bu bildirim işlenmek üzere kuruluşunuza atandı."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Description: @description"
msgstr "Açıklama: @description"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request"
msgstr "Bildirim"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Category"
msgstr "Kategori"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Location"
msgstr "Konum"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Organisation"
msgstr "Kuruluş"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id was assigned to @organisation"
msgstr "@request_id numaralı bildirim @organisation kuruluşuna atandı"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "A citizen request is ready for review."
msgstr "Bir vatandaş bildirimi incelemeye hazır."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Open request"
msgstr "Bildirimi aç"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "@site üzerindeki \"@name\" çalışma alanınızı etkinleştirin"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Çalışma alanınızı etkinleştirin"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "@site'e hoş geldiniz! \"@name\" çalışma alanınız etkinleştirilmeye hazır."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "E-postanızı doğrulamak ve çalışma alanının kilidini açmak için aşağıdaki düğmeye tıklayın."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Doğrulanmamış çalışma alanları @days gün sonra otomatik olarak silinir."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "E-postayı doğrula"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "@name çalışma alanınızı etkinleştirmek için tıklayın"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "\"@name\" demo çalışma alanınızın süresi yakında dolacak"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "\"@name\" demo çalışma alanının süresi @date tarihinde doluyor"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Demonuzun süresi @date tarihinde doluyor"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date unless you choose a plan."
msgstr "\"@name\" demo çalışma alanı, bir plan seçmediğiniz takdirde @date tarihinde otomatik olarak silinecek."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "You can keep your workspace, history and settings for free. Choose a plan before it expires, including our Free tier at no cost. If you do nothing, the workspace will be removed."
msgstr "Çalışma alanınızı, geçmişinizi ve ayarlarınızı ücretsiz olarak saklayabilirsiniz. Süresi dolmadan bir plan seçin; tamamen ücretsiz olan Free planı da buna dahildir. Hiçbir şey yapmazsanız çalışma alanı silinecek."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Çalışma alanımı aç"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Keep my workspace"
msgstr "Çalışma alanımı sakla"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Çalışma alanı"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Süresi doluyor"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Doğrulama kodunuz"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Hesabınızı doğrulayın"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Doğrulama kodunuz: @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Bu kodu önümüzdeki @minutes dakika içinde girin. Bu isteği siz yapmadıysanız, bu e-postayı yok sayabilirsiniz."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Doğrulama kodunuz: @code\n\nKodun süresi @minutes dakika içinde dolacaktır."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Bildiriminiz için daha fazla bilgi gerekiyor"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Bildiriminiz hakkında daha fazla bilgiye ihtiyacımız var"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Lütfen bildiriminizi açıklığa kavuşturun"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Bildiriminizi işleyebilmemiz için biraz daha bilgiye ihtiyacımız var."

