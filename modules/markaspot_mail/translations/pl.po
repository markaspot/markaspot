#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Twoje zgłoszenie zostało rozwiązane"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Dziękujemy za skorzystanie z systemu zgłoszeń. Twoje zgłoszenie \"@title\" zostało przetworzone i jest teraz oznaczone jako zakończone."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Czy jesteś zadowolony z rezultatu, czy z Twojej perspektywy potrzebne są jeszcze dalsze działania? Będziemy bardzo wdzięczni za Twoją opinię."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Jeśli uważasz, że sprawa nie została w pełni rozwiązana, możesz również ponownie ją otworzyć za pomocą tego linku."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Prześlij opinię"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "Chętnie poznamy Twoją opinię o zgłoszeniu @id"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Twoje zgłoszenie @id: czekamy na opinię"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Zgłoszenie"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "Otrzymałeś zaproszenie do \"@group\""

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\" on @site."
msgstr "Otrzymałeś zaproszenie do dołączenia do \"@group\" w serwisie @site."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\"."
msgstr "Otrzymałeś zaproszenie do dołączenia do \"@group\"."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept your invitation to @group"
msgstr "Zaakceptuj zaproszenie do @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "Dołącz do @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "Kliknij przycisk poniżej, aby zaakceptować to zaproszenie. Link wygaśnie za 7 dni."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Jeśli nie spodziewałeś się tego zaproszenia, możesz bezpiecznie zignorować tę wiadomość."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Zaakceptuj zaproszenie"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Aktywuj swoją przestrzeń roboczą \"@name\" w @site"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Aktywuj swoją przestrzeń roboczą"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Witamy w @site! Twoja przestrzeń robocza \"@name\" jest gotowa do aktywacji."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Kliknij przycisk poniżej, aby potwierdzić swój adres e-mail i odblokować przestrzeń roboczą."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Niepotwierdzone przestrzenie robocze są automatycznie usuwane po @days dniach."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "Potwierdź adres e-mail"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Kliknij, aby aktywować swoją przestrzeń roboczą @name"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "Twoja demonstracyjna przestrzeń robocza \"@name\" wkrótce wygaśnie"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "Demonstracyjna przestrzeń robocza \"@name\" wygasa @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Twoje demo wygasa @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date unless you choose a plan."
msgstr "Demonstracyjna przestrzeń robocza \"@name\" zostanie automatycznie usunięta @date, chyba że wybierzesz plan."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "You can keep your workspace, history and settings for free. Choose a plan before it expires, including our Free tier at no cost. If you do nothing, the workspace will be removed."
msgstr "Możesz bezpłatnie zachować swoją przestrzeń roboczą, historię i ustawienia. Wybierz plan, zanim wygaśnie, w tym nasz całkowicie bezpłatny plan Free. Jeśli nic nie zrobisz, przestrzeń robocza zostanie usunięta."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Otwórz moją przestrzeń roboczą"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Keep my workspace"
msgstr "Zachowaj przestrzeń roboczą"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Przestrzeń robocza"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Wygasa"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Twój kod weryfikacyjny"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Zweryfikuj swoje konto"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Twój kod weryfikacyjny: @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Wprowadź ten kod w ciągu najbliższych @minutes minut. Jeśli go nie żądałeś, możesz zignorować tę wiadomość."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Twój kod weryfikacyjny: @code\n\nWygaśnie za @minutes minut."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Twoje zgłoszenie wymaga więcej informacji"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Potrzebujemy więcej informacji o Twoim zgłoszeniu"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Prosimy o doprecyzowanie zgłoszenia"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Potrzebujemy jeszcze trochę więcej informacji, aby przetworzyć Twoje zgłoszenie."

