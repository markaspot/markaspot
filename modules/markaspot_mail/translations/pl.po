#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Category"
msgstr "Kategoria"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Location"
msgstr "Lokalizacja"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Organisation"
msgstr "Organizacja"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
