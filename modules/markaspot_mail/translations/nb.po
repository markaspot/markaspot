msgstr "Melding #@request_id ble tildelt deg"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "A citizen request is ready for review."
msgstr "En innbyggermelding er klar for gjennomgang."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Open request"
msgstr "Åpne melding"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Aktiver @site-arbeidsområdet ditt \"@name\""

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Aktiver arbeidsområdet ditt"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Velkommen til @site! Arbeidsområdet ditt \"@name\" er klart til å aktiveres."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Klikk på knappen nedenfor for å bekrefte e-posten din og låse opp arbeidsområdet."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Arbeidsområder som ikke er bekreftet, fjernes automatisk etter @days dager."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "Bekreft e-post"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Klikk for å aktivere arbeidsområdet ditt @name"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "Demoarbeidsområdet ditt \"@name\" utløper snart"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "Demoarbeidsområdet \"@name\" utløper @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Demoen din utløper @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date unless you choose a plan."
msgstr "Demoarbeidsområdet \"@name\" blir automatisk slettet @date, med mindre du velger en plan."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "You can keep your workspace, history and settings for free. Choose a plan before it expires, including our Free tier at no cost. If you do nothing, the workspace will be removed."
msgstr "Du kan beholde arbeidsområdet, historikken og innstillingene dine gratis. Velg en plan før det utløper, inkludert vår Free-plan helt uten kostnad. Hvis du ikke gjør noe, blir arbeidsområdet slettet."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Åpne arbeidsområdet mitt"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Keep my workspace"
msgstr "Behold arbeidsområdet mitt"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Arbeidsområde"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Utløper"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Din bekreftelseskode"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Bekreft kontoen din"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Din bekreftelseskode: @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Skriv inn denne koden i løpet av de neste @minutes minuttene. Hvis du ikke har bedt om den, kan du ignorere denne e-posten."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Din bekreftelseskode: @code\n\nDen utløper om @minutes minutter."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Meldingen din trenger mer informasjon"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Vi trenger mer informasjon om meldingen din"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Vennligst utdyp meldingen din"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Vi trenger litt mer informasjon for å kunne behandle meldingen din."

