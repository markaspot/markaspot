msgid "Docs"
msgstr "Dokumentasjon"

#: templates/mail-layout.html.twig
msgid "Impressum"
msgstr "Impressum"

#: templates/mail-layout.html.twig
msgid "Datenschutz"
msgstr "Datenschutz"

#: templates/mail-layout.html.twig
msgid "Legal notice"
msgstr "Juridisk informasjon"

