#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Meldingen din er løst"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Takk for at du bruker feilmelderen. Meldingen din \"@title\" er behandlet og er nå merket som fullført."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Er du fornøyd med resultatet, eller mener du at det fortsatt trengs tiltak? Vi setter stor pris på tilbakemeldingen din."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Hvis du mener at saken din ikke er fullstendig behandlet, kan du også åpne saken på nytt via denne lenken."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Gi tilbakemelding"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "Vi ønsker tilbakemelding på meldingen din @id"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Meldingen din @id: tilbakemelding ønskes"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Melding"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "Du har blitt invitert til \"@group\""

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\" on @site."
msgstr "Du har blitt invitert til å bli med i \"@group\" på @site."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\"."
msgstr "Du har blitt invitert til å bli med i \"@group\"."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept your invitation to @group"
msgstr "Godta invitasjonen din til @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "Bli med i @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "Klikk på knappen nedenfor for å godta denne invitasjonen. Lenken utløper om 7 dager."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Hvis du ikke forventet denne invitasjonen, kan du trygt ignorere denne e-posten."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Godta invitasjon"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "your organisation"
msgstr "organisasjonen din"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id assigned to @organisation"
msgstr "Melding #@request_id er tildelt @organisation"

#: src/Mail/Builder/AssigneeNotificationBuilder.php
msgid "Request #@request_id assigned to you"
msgstr "Melding #@request_id er tildelt deg"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "This request has been assigned to your organisation for processing."
msgstr "Denne meldingen er tildelt organisasjonen din for behandling."

#: src/Mail/Builder/AssigneeNotificationBuilder.php
msgid "This request has been assigned to you for processing."
msgstr "Denne meldingen er tildelt deg for behandling."

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Description: @description"
msgstr "Beskrivelse: @description"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request"
msgstr "Melding"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Category"
msgstr "Kategori"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Location"
msgstr "Sted"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Organisation"
msgstr "Organisasjon"

#: src/Mail/Builder/GroupOrgNotificationBuilder.php
msgid "Request #@request_id was assigned to @organisation"
msgstr "Melding #@request_id ble tildelt @organisation"

#: src/Mail/Builder/AssigneeNotificationBuilder.php
