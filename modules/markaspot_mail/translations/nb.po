#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report was resolved"
msgstr "Meldingen din er løst"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Thank you for using the issue tracker. Your report \"@title\" has been processed and is now marked as completed."
msgstr "Takk for at du bruker feilmelderen. Meldingen din \"@title\" er behandlet og er nå merket som fullført."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Are you satisfied with the result, or is there still action needed from your perspective? We would greatly appreciate your feedback."
msgstr "Er du fornøyd med resultatet, eller mener du at det fortsatt trengs tiltak? Vi setter stor pris på tilbakemeldingen din."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "If you believe your concern has not been fully addressed, you can also reopen the case through this link."
msgstr "Hvis du mener at saken din ikke er fullstendig behandlet, kan du også åpne saken på nytt via denne lenken."

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Give feedback"
msgstr "Gi tilbakemelding"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Feedback welcome on your report @id"
msgstr "Vi ønsker tilbakemelding på meldingen din @id"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Your report @id: feedback welcome"
msgstr "Meldingen din @id: tilbakemelding ønskes"

#: src/Mail/Builder/FeedbackRequestBuilder.php
msgid "Report"
msgstr "Melding"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to \"@group\""
msgstr "Du har blitt invitert til \"@group\""

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\" on @site."
msgstr "Du har blitt invitert til å bli med i \"@group\" på @site."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "You have been invited to join \"@group\"."
msgstr "Du har blitt invitert til å bli med i \"@group\"."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept your invitation to @group"
msgstr "Godta invitasjonen din til @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Join @group"
msgstr "Bli med i @group"

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Click the button below to accept this invitation. The link expires in 7 days."
msgstr "Klikk på knappen nedenfor for å godta denne invitasjonen. Lenken utløper om 7 dager."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Hvis du ikke forventet denne invitasjonen, kan du trygt ignorere denne e-posten."

#: src/Mail/Builder/GroupMemberInvitationBuilder.php
msgid "Accept invitation"
msgstr "Godta invitasjon"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your @site workspace \"@name\""
msgstr "Aktiver @site-arbeidsområdet ditt \"@name\""

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Activate your workspace"
msgstr "Aktiver arbeidsområdet ditt"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Welcome to @site! Your workspace \"@name\" is ready to activate."
msgstr "Velkommen til @site! Arbeidsområdet ditt \"@name\" er klart til å aktiveres."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click the button below to verify your email and unlock the workspace."
msgstr "Klikk på knappen nedenfor for å bekrefte e-posten din og låse opp arbeidsområdet."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Unverified workspaces are automatically removed after @days days."
msgstr "Arbeidsområder som ikke er bekreftet, fjernes automatisk etter @days dager."

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Verify email"
msgstr "Bekreft e-post"

#: src/Mail/Builder/WorkspaceVerificationBuilder.php
msgid "Click to activate your @name workspace"
msgstr "Klikk for å aktivere arbeidsområdet ditt @name"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo workspace \"@name\" expires soon"
msgstr "Demoarbeidsområdet ditt \"@name\" utløper snart"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Demo workspace \"@name\" expires @date"
msgstr "Demoarbeidsområdet \"@name\" utløper @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Your demo expires @date"
msgstr "Demoen din utløper @date"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "The demo workspace \"@name\" will be automatically removed on @date."
msgstr "Demoarbeidsområdet \"@name\" blir automatisk slettet @date."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Upgrade now to keep your workspace, history and settings, or ignore this email to let it expire."
msgstr "Oppgrader nå for å beholde arbeidsområdet, historikken og innstillingene dine, eller ignorer denne e-posten og la det utløpe."

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Open my workspace"
msgstr "Åpne arbeidsområdet mitt"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Create a permanent workspace"
msgstr "Opprett et permanent arbeidsområde"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Workspace"
msgstr "Arbeidsområde"

#: src/Mail/Builder/DemoExpiryReminderBuilder.php
msgid "Expires"
msgstr "Utløper"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "@platform_name: Your verification code"
msgstr "@platform_name: Din bekreftelseskode"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Verify your account"
msgstr "Bekreft kontoen din"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code"
msgstr "Din bekreftelseskode: @code"

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email."
msgstr "Skriv inn denne koden i løpet av de neste @minutes minuttene. Hvis du ikke har bedt om den, kan du ignorere denne e-posten."

#: src/Mail/Builder/PasswordlessOtpBuilder.php
msgid "Your verification code: @code\n\nIt expires in @minutes minutes."
msgstr "Din bekreftelseskode: @code\n\nDen utløper om @minutes minutter."

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Your report needs more information"
msgstr "Meldingen din trenger mer informasjon"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need more information about your report"
msgstr "Vi trenger mer informasjon om meldingen din"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "Please clarify your report"
msgstr "Vennligst utdyp meldingen din"

#: src/Mail/Builder/ResubmissionRequestBuilder.php
msgid "We need a bit more information to process your report."
msgstr "Vi trenger litt mer informasjon for å kunne behandle meldingen din."

