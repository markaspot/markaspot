<?php

/**
 * @file
 * Module file for markaspot_mail.
 *
 * Thin shim that forwards classic hook_mail_alter + hook_theme to the OO
 * implementation. Attribute-based hooks aren't used for consistency with
 * markaspot_passwordless and other profile modules that still rely on
 * classic hooks.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function markaspot_mail_theme($existing, $type, $theme, $path) {
  return [
    'markaspot_mail_layout' => [
      'variables' => [
        'variant' => 'card_transactional',
        'branding' => [],
        'content' => [],
        'langcode' => 'en',
      ],
      'template' => 'mail-layout',
    ],
    'markaspot_mail_hero_code' => [
      'variables' => [
        'branding' => [],
        'content' => [],
      ],
      'template' => 'mail-hero-code',
    ],
    'markaspot_mail_card_transactional' => [
      'variables' => [
        'branding' => [],
        'content' => [],
      ],
      'template' => 'mail-card-transactional',
    ],
    'markaspot_mail_passthrough' => [
      'variables' => [
        'body' => '',
        'module' => '',
        'key' => '',
        'recipient' => '',
        'subject' => '',
      ],
      'template' => 'mail-passthrough',
    ],
  ];
}

/**
 * Implements hook_mail().
 *
 * Populates subject + body for markaspot_mail:notification_* mails from the
 * same MailTextResolver chain NotificationTextBuilder uses, so the
 * unbranded plaintext path (hook_mail_alter render failures fail closed to
 * whatever hook_mail() wrote here, see MailAlterHook) is never empty. Every
 * other ($module, $key) pair is left untouched.
 */
function markaspot_mail_mail(string $key, array &$message, array $params): void {
  if (!str_starts_with($key, 'notification_')) {
    return;
  }

  $node = $params['node'] ?? NULL;
  if (!$node instanceof \Drupal\node\NodeInterface) {
    return;
  }
  $notificationKey = trim((string) ($params['notification_key'] ?? substr($key, strlen('notification_'))));
  if ($notificationKey === '') {
    return;
  }

  $langcode = (string) ($message['langcode'] ?? 'en');

  /** @var \Drupal\markaspot_mail\Service\MailTextResolver $resolver */
  $resolver = \Drupal::service('markaspot_mail.text_resolver');
  $slots = $resolver->resolve('markaspot_mail.texts', $notificationKey, $langcode);
  $jurisdiction = _markaspot_mail_runtime_wording_jurisdiction($node);
  $slots = _markaspot_mail_replace_runtime_wording_slots($slots, $jurisdiction, $langcode);
  $slots = $resolver->replaceTokens($slots, ['node' => $node], $langcode);

  /** @var \Drupal\markaspot_nuxt\Service\CitizenWordingResolver $wordingResolver */
  $wordingResolver = \Drupal::service('markaspot_nuxt.citizen_wording_resolver');
  $wording = $wordingResolver->resolveMailTerms($jurisdiction, $langcode);
  $usesCustomWording = $wording['preset'] !== \Drupal\markaspot_nuxt\Service\CitizenWordingResolver::DEFAULT_PRESET;

  $message['subject'] = $slots['subject'] !== ''
    ? $slots['subject']
    : ($usesCustomWording
      ? (string) t('Update: @wording_singular_title', [
        '@wording_singular_title' => $wording['singular_title'],
      ], ['langcode' => $langcode])
      : (string) t('Update on your report', [], ['langcode' => $langcode]));

  $bodyParts = array_values(array_filter(
    [$slots['intro'], ...$slots['body_blocks']],
    static fn(string $part): bool => $part !== '',
  ));
  $message['body'] = $bodyParts !== []
    ? $bodyParts
    : [
      $usesCustomWording
        ? (string) t('There is an update: @wording_singular_title. Please check the platform for details.', [
          '@wording_singular_title' => $wording['singular_title'],
        ], ['langcode' => $langcode])
        : (string) t('There is an update on your report. Please check the platform for details.', [], ['langcode' => $langcode]),
    ];
}

/**
 * Replaces the opt-in terminology slots in notification mail templates.
 *
 * This mirrors NotificationTextBuilder for the unbranded hook_mail() fallback
 * path. That path only becomes visible if branded rendering fails, but it
 * must still never expose an unresolved placeholder in a citizen's inbox.
 *
 * @param array{subject: string, headline: string, intro: string, body_blocks: list<string>, cta_label: string, preheader: string} $slots
 *   Resolved notification template slots.
 * @param \Drupal\group\Entity\GroupInterface|null $jurisdiction
 *   The request's valid jurisdiction group, if any.
 * @param string $langcode
 *   Recipient language code.
 *
 * @return array{subject: string, headline: string, intro: string, body_blocks: list<string>, cta_label: string, preheader: string}
 *   Slots with deliberate runtime wording placeholders replaced.
 */
function _markaspot_mail_replace_runtime_wording_slots(array $slots, ?\Drupal\group\Entity\GroupInterface $jurisdiction, string $langcode): array {
  /** @var \Drupal\markaspot_nuxt\Service\CitizenWordingResolver $wordingResolver */
  $wordingResolver = \Drupal::service('markaspot_nuxt.citizen_wording_resolver');
  foreach (['subject', 'headline', 'intro', 'cta_label', 'preheader'] as $slot) {
    $slots[$slot] = $wordingResolver->replaceMailPlaceholders(
      $slots[$slot],
      $jurisdiction,
      $langcode,
    );
  }
  $slots['body_blocks'] = array_map(
    static fn(string $block): string => $wordingResolver->replaceMailPlaceholders(
      $block,
      $jurisdiction,
      $langcode,
    ),
    $slots['body_blocks'],
  );

  return $slots;
}

/**
 * Finds the jurisdiction group whose wording config applies to a node.
 *
 * The procedural hook_mail() fallback cannot use
 * ResolveJurisdictionFromNodeTrait, so it repeats its narrow validation: a
 * referenced GroupInterface with the configured jurisdiction bundle only.
 */
function _markaspot_mail_runtime_wording_jurisdiction(\Drupal\node\NodeInterface $node): ?\Drupal\group\Entity\GroupInterface {
  if (!$node->hasField('field_jurisdiction')) {
    return NULL;
  }
  $field = $node->get('field_jurisdiction');
  if (!$field instanceof \Drupal\Core\Field\EntityReferenceFieldItemListInterface || $field->isEmpty()) {
    return NULL;
  }
  $target = $field->referencedEntities()[0] ?? NULL;
  $configuredType = \Drupal::config('markaspot_open311.settings')->get('jurisdiction_group_type');
  $jurisdictionType = is_string($configuredType) && $configuredType !== '' ? $configuredType : 'jur';
  if (!$target instanceof \Drupal\group\Entity\GroupInterface
    || $target->getEntityTypeId() !== 'group'
    || $target->bundle() !== $jurisdictionType) {
    return NULL;
  }
  return $target;
}

/**
 * Implements hook_mail_alter().
 */
function markaspot_mail_mail_alter(&$message) {
  /** @var \Drupal\markaspot_mail\Hook\MailAlterHook $hook */
  $hook = \Drupal::service('markaspot_mail.mail_alter_hook');
  $hook->alter($message);

  // Non-prod recipient fence (markaspot-ui#388 L3). Must run AFTER the
  // branding hook: builders overwrite $message['subject'], and the override
  // prefix ("[DEV→original@example.com]") has to survive that overwrite.
  // Unlike the branding hook this one is unconditional (no builder gate, no
  // blocklist): when the override is configured, NO mail may keep its real
  // recipients, including password resets and contrib mails.
  /** @var \Drupal\markaspot_mail\Hook\RecipientOverrideHook $override_hook */
  $override_hook = \Drupal::service('markaspot_mail.recipient_override_hook');
  $override_hook->alter($message);
}

/**
 * Implements hook_cron().
 *
 * GDPR retention guard (markaspot-ui#388 review): the dev_logger mail mode
 * writes complete mails — recipient addresses and bodies included — into the
 * devel_mail_logger table, which has no retention of its own. Purge rows
 * older than 30 days so dev/test tenants don't accumulate citizen PII
 * indefinitely.
 *
 * Deliberately guarded instead of declared as a dependency: markaspot_mail
 * must keep working on tenants without devel_mail_logger. The logic stays
 * trivial (no service, no unit test) because everything interesting is in
 * the two guards; behavior is covered by the deploy smoke runbook
 * (markaspot-cloud/docs/mail-modes.md).
 */
function markaspot_mail_cron(): void {
  if (!\Drupal::moduleHandler()->moduleExists('devel_mail_logger')) {
    return;
  }
  $connection = \Drupal::database();
  // The module can be enabled while its schema is missing after partial
  // config imports; never let cron fatal on a missing table.
  if (!$connection->schema()->tableExists('devel_mail_logger')) {
    return;
  }
  $connection->delete('devel_mail_logger')
    ->condition('timestamp', \Drupal::time()->getRequestTime() - 30 * 86400, '<')
    ->execute();
}
