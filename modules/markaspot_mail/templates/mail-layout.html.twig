{#
/**
 * @file
 * Outer mail wrapper.
 *
 * Available variables:
 * - variant: 'hero_code' | 'card_transactional'
 * - branding: branding package (mode, platform_name, logo_url, primary_color,
 *   background_color, support_email, legal_notice_url, privacy_url,
 *   email_footer_html, reply_to, frontend_base_url, jurisdiction_slug,
 *   jurisdiction_label, platform_footer)
 * - content: variant-specific content
 * - langcode: active langcode for the rendered message
 *
 * Styling is inline to survive Gmail/Outlook. A <style> block in <head>
 * is used only for progressive enhancement (responsive breakpoint).
 *
 * Logo strategy:
 * - Platform mode: inline SVG (no external request, degrades to nothing in
 *   Gmail which strips <svg> tags — Zone-2 text links remain visible).
 * - Jurisdiction mode: uploaded SVG logos are inlined by MailBrandingService
 *   (branding.logo_svg_inline). PNG/JPEG logos fall back to <img src="...">.
 *   Inline SVG degrades gracefully: Gmail/Outlook strip <svg> silently,
 *   alt text stays readable; Apple Mail and iOS Mail render it natively.
 */
#}
<!DOCTYPE html>
<html lang="{{ langcode|default('en') }}" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ branding.platform_name }}</title>
{# Light-mode only for consistency across OTP and transactional. #}
<meta name="color-scheme" content="light">
<style>
  @media only screen and (max-width: 600px) {
    .mas-container { width: 100% !important; }
    .mas-card { padding: 24px !important; }
  }
</style>
</head>
<body style="margin:0; padding:0; background-color:{{ branding.background_color }}; -webkit-font-smoothing:antialiased; -webkit-text-size-adjust:100%;">

{# Preheader (hidden inbox preview snippet). #}
{% set preheader = content.preheader|default('') %}
{% if preheader %}
  <div style="display:none !important; visibility:hidden; opacity:0; color:transparent; height:0; width:0; overflow:hidden; mso-hide:all;">
    {{ preheader }}
  </div>
{% endif %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:{{ branding.background_color }};">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <table role="presentation" class="mas-container" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:560px;">

        {# Logo row. In platform mode we only render the MaS inline SVG
           when branding.platform_footer is set; otherwise we fall through
           to the uploaded logo_url or the platform_name text so a
           self-hosted enterprise mail carries no Civic Patches branding. #}
        <tr>
          <td align="center" style="padding:0 0 24px 0;">
            {% if branding.mode == 'platform' and branding.platform_footer %}
              <a href="{{ branding.platform_footer.mas_link }}" style="display:inline-block; text-decoration:none; border:0; outline:none;">
                {% include '@markaspot_mail/_mas-logo.html.twig' with { 'width': 140, 'height': 57 } only %}
              </a>
            {% elseif branding.logo_svg_inline %}
              {{ branding.logo_svg_inline }}
            {% elseif branding.logo_url %}
              <img src="{{ branding.logo_url }}" alt="{{ branding.platform_name }}" width="160" style="display:block; max-width:160px; height:auto; border:0; outline:none; text-decoration:none;">
            {% else %}
              <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; font-size:18px; font-weight:600; color:#111827;">
                {{ branding.platform_name }}
              </div>
            {% endif %}
          </td>
        </tr>

        {# Body slot. #}
        <tr>
          <td>
            {% if variant == 'hero_code' %}
              {% include '@markaspot_mail/mail-hero-code.html.twig' with { 'branding': branding, 'content': content } only %}
            {% else %}
              {% include '@markaspot_mail/mail-card-transactional.html.twig' with { 'branding': branding, 'content': content } only %}
            {% endif %}
          </td>
        </tr>

        {# Zone 1: Jurisdiction footer (only in jurisdiction mode). #}
        {% if branding.mode == 'jurisdiction' %}
          <tr>
            <td style="padding:24px 8px 0 8px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; line-height:20px; color:#475569;">
              {% if branding.email_footer_html %}
                <div class="mas-muted" style="color:#475569;">{{ branding.email_footer_html }}</div>
              {% endif %}
              <div class="mas-muted" style="margin-top:8px; color:#475569;">
                {% if branding.support_email %}
                  <a href="mailto:{{ branding.support_email }}" style="color:#475569; text-decoration:underline;">{{ branding.support_email }}</a>
                {% endif %}
              </div>
              <div class="mas-muted" style="margin-top:4px; color:#475569;">
                {% if branding.legal_notice_url %}
                  <a href="{{ branding.legal_notice_url }}" style="color:#475569; text-decoration:underline;">{{ 'Legal notice'|trans({}, {'langcode': langcode}) }}</a>
                {% endif %}
                {% if branding.legal_notice_url and branding.privacy_url %} &middot; {% endif %}
                {% if branding.privacy_url %}
                  <a href="{{ branding.privacy_url }}" style="color:#475569; text-decoration:underline;">{{ 'Privacy'|trans({}, {'langcode': langcode}) }}</a>
                {% endif %}
              </div>
            </td>
          </tr>
        {% endif %}

        {# Zone 1b: Platform-mode fallback legal links. Only rendered when
           platform_footer is suppressed AND we're in platform mode (Zone 1
           above only renders in jurisdiction mode). Without this block, a
           self-hosted enterprise running an OTP fallback in platform mode
           with show_platform_footer=false would ship a transactional mail
           with no Impressum link anywhere, which violates TMG/DDG §5 in
           German deployments. Operators override
           markaspot_mail.settings:platform.legal_notice_url and
           platform.privacy_url to point at their own pages so this block
           carries the correct links. #}
        {% if branding.mode == 'platform' and not branding.platform_footer %}
          <tr>
            <td style="padding:24px 8px 0 8px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; line-height:20px; color:#475569;">
              <div class="mas-muted" style="margin-top:4px; color:#475569;">
                {% if branding.legal_notice_url %}
                  <a href="{{ branding.legal_notice_url }}" style="color:#475569; text-decoration:underline;">{{ 'Legal notice'|trans({}, {'langcode': langcode}) }}</a>
                {% endif %}
                {% if branding.legal_notice_url and branding.privacy_url %} &middot; {% endif %}
                {% if branding.privacy_url %}
                  <a href="{{ branding.privacy_url }}" style="color:#475569; text-decoration:underline;">{{ 'Privacy'|trans({}, {'langcode': langcode}) }}</a>
                {% endif %}
              </div>
            </td>
          </tr>
        {% endif %}

        {# Zone 2: Platform footer (Civic Patches attribution). Hidden when
           features.show_platform_footer is false — self-hosted enterprise
           installations and paid CivicSpot tiers opt out because Civic
           Patches GmbH is not the legal operator of those sites; keeping
           the civicpatches.de/impressum link would be DSGVO-wrong.
           Inline SVG logo degrades gracefully in Gmail / Outlook.com
           (SVG stripped, text links remain visible). #}
        {% if branding.platform_footer %}
        <tr>
          <td style="padding:24px 8px 8px 8px; border-top:1px solid #e2e8f0; margin-top:16px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; line-height:18px; color:#64748b;">
            <div style="margin-bottom:10px;">
              <a href="{{ branding.platform_footer.mas_link }}" style="display:inline-block; text-decoration:none; border:0; outline:none;">
                {% include '@markaspot_mail/_mas-logo.html.twig' with { 'width': 80, 'height': 32 } only %}
              </a>
            </div>
            <div style="margin-top:4px;">
              <a href="{{ branding.platform_footer.mas_link }}" style="color:#64748b; text-decoration:none;">mark-a-spot.com</a>
              &nbsp;&middot;&nbsp;
              <a href="{{ branding.platform_footer.docs_link }}" style="color:#64748b; text-decoration:none;">{{ 'Docs'|trans({}, {'langcode': langcode}) }}</a>
              &nbsp;&middot;&nbsp;
              <a href="{{ branding.platform_footer.civicspot_link }}" style="color:#64748b; text-decoration:none;">civicspot.io</a>
            </div>
            <div style="margin-top:6px;">
              <a href="{{ branding.platform_footer.impressum_link }}" style="color:#64748b; text-decoration:underline;">{{ 'Impressum'|trans({}, {'langcode': langcode}) }}</a>
              &nbsp;&middot;&nbsp;
              <a href="{{ branding.platform_footer.datenschutz_link }}" style="color:#64748b; text-decoration:underline;">{{ 'Datenschutz'|trans({}, {'langcode': langcode}) }}</a>
            </div>
            <div style="margin-top:6px; color:#94a3b8;">
              {{ branding.platform_footer.copyright }}
            </div>
          </td>
        </tr>
        {% endif %}

      </table>
    </td>
  </tr>
</table>

</body>
</html>
