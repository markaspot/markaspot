<?php

/**
 * @file
 * Install and update hooks for markaspot_mail.
 */

declare(strict_types=1);

use Drupal\locale\Gettext;
use Drupal\Core\Config\ConfigFactoryInterface;
use Drupal\Core\Extension\ModuleHandlerInterface;
use Drupal\Component\Serialization\Yaml;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\language\ConfigurableLanguageManagerInterface;
use Drupal\markaspot_mail\Service\NotificationTextWordingMigrationGuard;
use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function markaspot_mail_install(): void {
  $config_factory = \Drupal::configFactory();
  $module_handler = \Drupal::moduleHandler();
  $target_backend = _markaspot_mail_resolve_backend($module_handler, $config_factory);

  $system_mail = $config_factory->getEditable('system.mail');
  if ($system_mail->get('interface.default') !== $target_backend) {
    $system_mail->set('interface.default', $target_backend)->save();
  }

  $mailsystem = $config_factory->getEditable('mailsystem.settings');
  $mailsystem_changed = FALSE;
  foreach (['defaults.sender', 'defaults.formatter'] as $key) {
    if ($mailsystem->get($key) !== $target_backend) {
      $mailsystem->set($key, $target_backend);
      $mailsystem_changed = TRUE;
    }
  }
  if ($mailsystem_changed) {
    $mailsystem->save();
  }

  if ($target_backend === 'phpmailer_smtp') {
    _markaspot_mail_ensure_phpmailer_html_format();
  }
  _markaspot_mail_seed_attachment_defaults();
}

/**
 * Switch phpmailer_smtp default format to html on existing installs.
 *
 * The phpmailer_smtp contrib module ships with `format: text_plain` as its
 * install default. Its PhpMailerSmtp::format() plugin only DOWNGRADES to
 * plain when the hook_mail_alter pipeline explicitly sets Content-Type:
 * text/plain. It never UPGRADES to html from a Content-Type: text/html
 * header. Result: every branded HTML mail produced by our builders lands
 * in inboxes as a naive html-to-text conversion that keeps inline <style>
 * block content as visible noise.
 *
 * Fresh enablements of markaspot_mail import the html default via
 * config/optional/phpmailer_smtp.format.yml. This update hook handles
 * tenants that already had markaspot_mail enabled before the optional
 * config shipped (e.g. the demo tenant, manually enabled during
 * diagnosis). Idempotent: no-op if format is already html or if
 * phpmailer_smtp is not installed.
 */
function markaspot_mail_update_10001(): string {
  if (!\Drupal::moduleHandler()->moduleExists('phpmailer_smtp')) {
    return 'phpmailer_smtp not enabled; no action.';
  }
  if (!_markaspot_mail_ensure_phpmailer_html_format()) {
    return 'phpmailer_smtp.format.format already html; no action.';
  }
  return 'Switched phpmailer_smtp.format.format to html.';
}

/**
 * Seed attachments.* defaults into markaspot_mail.settings.
 *
 * Fresh installs get the new block via config/install. Existing installs
 * miss it entirely — without these defaults, AttachmentResolver falls
 * back to its hard-coded constants (safe but invisible to operators
 * trying to audit "what gets attached"). This hook only fills missing
 * keys so a site-admin override of e.g. max_total_bytes survives.
 */
function markaspot_mail_update_10002(): string {
  $added = _markaspot_mail_seed_attachment_defaults();
  if ($added === []) {
    return 'attachments.* already present; no action.';
  }
  return 'Seeded attachments defaults: ' . implode(', ', $added) . '.';
}

/**
 * Seeds missing markaspot_mail attachment defaults.
 *
 * @return list<string>
 *   Added attachment setting keys.
 */
function _markaspot_mail_seed_attachment_defaults(): array {
  $config = \Drupal::configFactory()->getEditable('markaspot_mail.settings');
  $current = $config->get('attachments') ?? [];
  $defaults = [
    'enabled' => TRUE,
    'max_per_file_bytes' => 5242880,
    'max_total_bytes' => 20971520,
    'allowed_mime' => [
      'image/jpeg',
      'image/png',
      'image/gif',
      'application/pdf',
      'application/msword',
      'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      'message/rfc822',
      'text/plain',
    ],
  ];
  $added = [];
  foreach ($defaults as $key => $value) {
    if (!array_key_exists($key, $current)) {
      $current[$key] = $value;
      $added[] = $key;
    }
  }
  if ($added !== []) {
    $config->set('attachments', $current)->save();
  }
  return $added;
}

/**
 * Import updated shipped translations for organisation assignment mails.
 *
 * Drupal imports module-local .po files when a module or language is first
 * enabled. Existing tenants need an update hook when we extend those files,
 * otherwise new $this->t() strings keep falling back to English until an
 * operator manually runs locale:check + locale:update.
 */
function markaspot_mail_update_10003(): string {
  return _markaspot_mail_import_shipped_translations();
}

/**
 * Re-import shipped translations for tenants that already ran update 10003.
 */
function markaspot_mail_update_10004(): string {
  return _markaspot_mail_import_shipped_translations();
}

/**
 * Route Drupal mail through the HTML-capable PHPMailer SMTP plugin.
 *
 * Legacy tenant database imports can restore Core/Maillog mail plugins. Core's
 * php_mail formatter always converts message bodies through htmlToText(), so
 * our branded mail builders end up with Content-Type: text/html but no HTML
 * tags left in the body. Keep the sender and formatter aligned.
 */
function markaspot_mail_update_10005(): string {
  $module_handler = \Drupal::moduleHandler();
  $missing = [];
  foreach (['mailsystem', 'phpmailer_smtp'] as $module) {
    if (!$module_handler->moduleExists($module)) {
      $missing[] = $module;
    }
  }
  if ($missing !== []) {
    $deleted_stale = _markaspot_mail_delete_stale_mail_config($missing);
    \Drupal::service('module_installer')->install($missing);
    $module_handler->resetImplementations();
    $still_missing = [];
    foreach ($missing as $module) {
      if (!$module_handler->moduleExists($module)) {
        $still_missing[] = $module;
      }
    }
    if ($still_missing !== []) {
      throw new \RuntimeException('Could not enable required mail modules: ' . implode(', ', $still_missing));
    }
  }

  $config_factory = \Drupal::configFactory();
  $target_backend = _markaspot_mail_resolve_backend($module_handler, $config_factory);
  $changed = [];
  if ($missing !== []) {
    $changed[] = 'enabled modules: ' . implode(', ', $missing);
    if ($deleted_stale !== []) {
      $changed[] = 'removed stale config: ' . implode(', ', $deleted_stale);
    }
  }

  $system_mail = $config_factory->getEditable('system.mail');
  if ($system_mail->get('interface.default') !== $target_backend) {
    $system_mail->set('interface.default', $target_backend)->save();
    $changed[] = 'system.mail.interface.default';
  }

  $mailsystem = $config_factory->getEditable('mailsystem.settings');
  foreach (['defaults.sender', 'defaults.formatter'] as $key) {
    if ($mailsystem->get($key) !== $target_backend) {
      $mailsystem->set($key, $target_backend);
      $changed[] = 'mailsystem.settings.' . $key;
    }
  }
  if (array_intersect($changed, [
    'mailsystem.settings.defaults.sender',
    'mailsystem.settings.defaults.formatter',
  ])) {
    $mailsystem->save();
  }

  if ($target_backend === 'phpmailer_smtp' && _markaspot_mail_ensure_phpmailer_html_format()) {
    $changed[] = 'phpmailer_smtp.format.format';
  }

  $attachment_defaults = _markaspot_mail_seed_attachment_defaults();
  foreach ($attachment_defaults as $key) {
    $changed[] = 'markaspot_mail.settings.attachments.' . $key;
  }
  $mail_settings = $config_factory->getEditable('markaspot_mail.settings');
  if ($mail_settings->get('attachments.enabled') !== TRUE) {
    $mail_settings->set('attachments.enabled', TRUE)->save();
    $changed[] = 'markaspot_mail.settings.attachments.enabled';
  }

  if ($changed === []) {
    return 'HTML mail backend already aligned; no action.';
  }
  return 'Aligned HTML mail backend: ' . implode(', ', $changed) . '.';
}

/**
 * Installs the new markaspot_mail.texts notification config.
 *
 * Config/install only seeds fresh module installs; every tenant that
 * already had markaspot_mail enabled before this config object was added
 * needs an update hook to get it, otherwise NotificationTextBuilder and
 * hook_mail() would resolve every slot to an empty string until an
 * operator manually ran `drush cim`. Idempotent: skipped entirely once
 * markaspot_mail.texts exists (an admin's later edits are never
 * overwritten by a re-run), and the German language override is imported
 * separately so English-only tenants that never enable the language
 * module still get the default-language texts.
 */
function markaspot_mail_update_10006(): string {
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('markaspot_mail.texts');
  if (!$config->isNew()) {
    return 'markaspot_mail.texts already exists; no action.';
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_mail');
  $shipped_path = $module_path . '/config/install/markaspot_mail.texts.yml';
  $shipped = is_file($shipped_path)
    ? Yaml::decode(file_get_contents($shipped_path))
    : NULL;
  if (!is_array($shipped)) {
    return 'Could not read shipped markaspot_mail.texts.yml; nothing installed.';
  }

  $config->setData($shipped)->save();
  $changed = ['markaspot_mail.texts'];

  if (\Drupal::moduleHandler()->moduleExists('language')) {
    $override_path = $module_path . '/config/install/language/de/markaspot_mail.texts.yml';
    $override_data = is_file($override_path)
      ? Yaml::decode(file_get_contents($override_path))
      : NULL;
    if (is_array($override_data)) {
      unset($override_data['langcode']);
      /** @var \Drupal\language\ConfigurableLanguageManagerInterface $language_manager */
      $language_manager = \Drupal::languageManager();
      if ($language_manager instanceof ConfigurableLanguageManagerInterface
        && in_array('de', array_keys($language_manager->getLanguages()), TRUE)) {
        $language_manager->getLanguageConfigOverride('de', 'markaspot_mail.texts')
          ->setData($override_data)
          ->save();
        $changed[] = 'language/de/markaspot_mail.texts';
      }
    }
  }

  return 'Installed: ' . implode(', ', $changed) . '.';
}

/**
 * Grants 'administer markaspot mail texts' to the tenant_admin role.
 *
 * The permission itself has existed since Phase 1
 * (markaspot_mail.permissions.yml); only the mail-text dashboard editor
 * (markaspot_dashboard's `/api/dashboard/mail-texts*` routes) makes it
 * something a tenant_admin is expected to hold day-to-day. Fresh installs
 * get the grant via config/optional/user.role.tenant_admin.yml and
 * markaspot_tenant_admin's own config/install/user.role.tenant_admin.yml;
 * this hook backfills existing tenants. Idempotent: grantPermission() is a
 * no-op if the role already has the permission, and a missing tenant_admin
 * role (self-hosted sites that never installed markaspot_tenant_admin) is
 * skipped rather than fabricated. Deliberately NOT granted to moderator or
 * editorial_board (unlike 'split service requests'), and NEVER granted by
 * markaspot_fastmap's workspace provisioning: mail-text wording is a
 * tenant-admin-level capability, not a general staff or FastMap workspace
 * one.
 */
function markaspot_mail_update_10007(): string {
  $role = Role::load('tenant_admin');
  if ($role === NULL) {
    return 'tenant_admin role does not exist; no action.';
  }
  if ($role->hasPermission('administer markaspot mail texts')) {
    return 'tenant_admin already has administer markaspot mail texts; no action.';
  }
  $role->grantPermission('administer markaspot mail texts');
  $role->save();
  return 'Granted administer markaspot mail texts to tenant_admin.';
}

/**
 * Adds runtime citizen-wording placeholders to untouched mail defaults.
 *
 * NotificationTextBuilder replaces the explicit moustache placeholders in
 * the current shipped templates with the wording selected for the request's
 * jurisdiction. Existing sites already store a mutable
 * markaspot_mail.texts config object, so changing config/install alone would
 * leave them on the historic "report" copy. This update uses strict full
 * array equality against the prior EN and DE shipped data. It therefore
 * updates only known boilerplate and preserves every administrator-authored
 * or ECA-migrated template exactly as it was.
 */
function markaspot_mail_update_10008(): string {
  $configFactory = \Drupal::configFactory();
  $modulePath = \Drupal::service('extension.list.module')->getPath('markaspot_mail');
  $guard = new NotificationTextWordingMigrationGuard();
  $results = [];

  $updatedDefault = _markaspot_mail_read_notification_texts_file(
    $modulePath . '/config/install/markaspot_mail.texts.yml',
    TRUE,
  );
  $activeDefault = $configFactory->getEditable('markaspot_mail.texts');
  if ($updatedDefault === NULL || $activeDefault->isNew()) {
    $results[] = 'default notification texts unavailable; no change';
  }
  else {
    $replacement = $guard->replacementForExactLegacyDefault(
      $activeDefault->getRawData(),
      _markaspot_mail_legacy_notification_texts('en'),
      $updatedDefault,
    );
    if ($replacement !== NULL) {
      $activeDefault->setData($replacement)->save();
      $results[] = 'default notification texts migrated';
    }
    elseif ($activeDefault->getRawData() === $updatedDefault) {
      $results[] = 'default notification texts already current';
    }
    else {
      $results[] = 'default notification texts customized; preserved';
    }
  }

  $languageManager = \Drupal::languageManager();
  if (!$languageManager instanceof ConfigurableLanguageManagerInterface
    || !in_array('de', array_keys($languageManager->getLanguages()), TRUE)) {
    $results[] = 'German override unavailable; no change';
    return implode('; ', $results) . '.';
  }

  $updatedGerman = _markaspot_mail_read_notification_texts_file(
    $modulePath . '/config/install/language/de/markaspot_mail.texts.yml',
    FALSE,
  );
  if ($updatedGerman === NULL) {
    $results[] = 'German shipped notification texts unavailable; no change';
    return implode('; ', $results) . '.';
  }

  $germanOverride = $languageManager->getLanguageConfigOverride('de', 'markaspot_mail.texts');
  $replacement = $guard->replacementForExactLegacyDefault(
    $germanOverride->getRawData(),
    _markaspot_mail_legacy_notification_texts('de'),
    $updatedGerman,
  );
  if ($replacement !== NULL) {
    $germanOverride->setData($replacement)->save();
    $results[] = 'German notification texts migrated';
  }
  elseif ($germanOverride->getRawData() === $updatedGerman) {
    $results[] = 'German notification texts already current';
  }
  else {
    $results[] = 'German notification texts customized or absent; preserved';
  }

  return implode('; ', $results) . '.';
}

/**
 * Imports German custom-wording mail translations for existing tenants.
 *
 * The non-report Feedback, Resubmission, and notification-fallback sources
 * are new $this->t() strings. Fresh module installs import module-local PO
 * files automatically, but a tenant that already enabled markaspot_mail
 * needs this explicit reimport after update 10008 introduces the runtime
 * wording paths.
 */
function markaspot_mail_update_10009(): string {
  return _markaspot_mail_import_shipped_translations();
}

/**
 * Imports shared mail-layout labels for existing tenant databases.
 *
 * Some long-lived tenants enabled Locale or their German language after an
 * earlier translation-import hook had already run. Re-import the complete
 * shipped catalog so legal footer labels such as "Legal notice" and
 * "Privacy" do not fall back to English in otherwise German mail.
 */
function markaspot_mail_update_10010(): string {
  return _markaspot_mail_import_shipped_translations();
}

/**
 * Re-imports workspace mail labels without HTML inside translated strings.
 *
 * Locale rejects placeholder URLs in translated href attributes. Existing
 * tenants that already ran update 10010 therefore need one clean re-import
 * after the link markup moved into WorkspaceWelcomeBuilder.
 */
function markaspot_mail_update_10011(): string {
  return _markaspot_mail_import_shipped_translations();
}

/**
 * Adds per-recipient flood defaults without overriding operator settings.
 */
function markaspot_mail_update_10012(): string {
  $config = \Drupal::configFactory()->getEditable('markaspot_mail.settings');
  $recipient_flood = $config->get('recipient_flood');
  $recipient_flood = is_array($recipient_flood) ? $recipient_flood : [];
  $changed = FALSE;

  if (!array_key_exists('limit', $recipient_flood)) {
    $recipient_flood['limit'] = 5;
    $changed = TRUE;
  }
  if (!array_key_exists('window', $recipient_flood)) {
    $recipient_flood['window'] = 3600;
    $changed = TRUE;
  }

  if (!$changed) {
    return 'The recipient flood settings already exist.';
  }

  $config->set('recipient_flood', $recipient_flood)->save();
  return 'Added the default recipient flood settings.';
}

/**
 * Reads one current shipped notification-template data set from YAML.
 *
 * @param bool $keepLangcode
 *   TRUE for the base config object, FALSE for a language override.
 *
 * @return array<string, mixed>|null
 *   Decoded current shipped data, or NULL when the file is unreadable.
 */
function _markaspot_mail_read_notification_texts_file(string $path, bool $keepLangcode): ?array {
  $contents = @file_get_contents($path);
  $data = $contents === FALSE ? NULL : Yaml::decode($contents);
  if (!is_array($data)) {
    return NULL;
  }
  if (!$keepLangcode) {
    unset($data['langcode']);
  }
  return $data;
}

/**
 * Returns the historical notification templates used before update 10008.
 *
 * This frozen snapshot is deliberately kept in code rather than inferred
 * from the current install YAML: exact comparison is the safety boundary
 * that lets the update distinguish shipped defaults from authored templates.
 *
 * @return array<string, mixed>
 *   The previous EN base config or DE language override data.
 */
function _markaspot_mail_legacy_notification_texts(string $langcode): array {
  if ($langcode === 'de') {
    return [
      'report_confirmation' => [
        'subject' => 'Ihre Meldung #[node:request_id] ist eingegangen',
        'headline' => 'Wir haben Ihre Meldung erhalten',
        'intro' => 'Ihre Meldung #[node:request_id] ist bei uns eingegangen.',
        'body_blocks' => [
          'Kategorie: [node:field_category:entity:name]',
          '[node:initial_status_note]',
        ],
        'cta_label' => 'Meldung ansehen',
        'preheader' => 'Wir haben Ihre Meldung erhalten und halten Sie auf dem Laufenden.',
      ],
      'status_open' => [
        'subject' => 'Update zu Ihrer Meldung #[node:request_id]',
        'headline' => 'Ihre Meldung wird bearbeitet',
        'intro' => 'Vielen Dank für Ihre Meldung. Sie wurde an die zuständige Stelle weitergeleitet und wird nun bearbeitet.',
        'body_blocks' => ['Sobald Ihre Meldung erledigt ist, erhalten Sie eine weitere Benachrichtigung.'],
        'cta_label' => 'Meldung ansehen',
        'preheader' => 'Ihre Meldung wird jetzt bearbeitet.',
      ],
      'status_closed' => [
        'subject' => 'Ihre Meldung #[node:request_id] wurde erledigt',
        'headline' => 'Ihre Meldung wurde erledigt',
        'intro' => 'Gute Nachrichten! Ihre Meldung #[node:request_id] wurde erledigt.',
        'body_blocks' => ['Bei einem dringenden Notfall oder einer unmittelbaren Gefahr wenden Sie sich bitte direkt an die Polizei (110) oder die Feuerwehr (112).'],
        'cta_label' => 'Meldung ansehen',
        'preheader' => 'Ihre Meldung wurde erledigt.',
      ],
      'status_not_responsible' => [
        'subject' => 'Ihre Meldung #[node:request_id]: nicht in unserer Zuständigkeit',
        'headline' => 'Wir sind nicht zuständig',
        'intro' => 'Ihre Meldung #[node:request_id] wurde geprüft. Leider sind wir für diese Art von Anliegen nicht zuständig.',
        'body_blocks' => ['Bei einem dringenden Notfall oder einer unmittelbaren Gefahr wenden Sie sich bitte direkt an die Polizei (110) oder die Feuerwehr (112).'],
        'cta_label' => 'Meldung ansehen',
        'preheader' => 'Wir sind für diese Meldung nicht zuständig.',
      ],
    ];
  }

  return [
    'langcode' => 'en',
    'report_confirmation' => [
      'subject' => 'Your report #[node:request_id] has been received',
      'headline' => 'We received your report',
      'intro' => 'Your report #[node:request_id] has been received.',
      'body_blocks' => [
        'Category: [node:field_category:entity:name]',
        '[node:initial_status_note]',
      ],
      'cta_label' => 'View your report',
      'preheader' => 'We received your report and will keep you updated.',
    ],
    'status_open' => [
      'subject' => 'Update on your report #[node:request_id]',
      'headline' => 'Your report is being processed',
      'intro' => 'Thank you for your report. It has been forwarded to the responsible department and is now being processed.',
      'body_blocks' => ['You will receive another notification once it has been resolved.'],
      'cta_label' => 'View your report',
      'preheader' => 'Your report is now being processed.',
    ],
    'status_closed' => [
      'subject' => 'Your report #[node:request_id] has been resolved',
      'headline' => 'Your report has been resolved',
      'intro' => 'Good news! Your report #[node:request_id] has been resolved.',
      'body_blocks' => ['If your matter is an urgent emergency or poses an immediate threat, please contact the police (110) or the fire department (112) directly.'],
      'cta_label' => 'View your report',
      'preheader' => 'Your report has been resolved.',
    ],
    'status_not_responsible' => [
      'subject' => 'Your report #[node:request_id]: not our responsibility',
      'headline' => 'We are not responsible for this report',
      'intro' => 'Your report #[node:request_id] has been reviewed. Unfortunately, we are not responsible for this type of request.',
      'body_blocks' => ['If your matter is an urgent emergency or poses an immediate threat, please contact the police (110) or the fire department (112) directly.'],
      'cta_label' => 'View your report',
      'preheader' => 'We are not responsible for this report.',
    ],
  ];
}

/**
 * Resolves the backend that should own the runtime mail stack.
 */
function _markaspot_mail_resolve_backend(
  ModuleHandlerInterface $module_handler,
  ConfigFactoryInterface $config_factory,
): string {
  $system_mail = $config_factory->get('system.mail');
  $mailsystem = $config_factory->get('mailsystem.settings');
  $system_default = $system_mail->isNew() ? '' : (string) $system_mail->get('interface.default');
  $sender = $mailsystem->isNew() ? '' : (string) $mailsystem->get('defaults.sender');
  $formatter = $mailsystem->isNew() ? '' : (string) $mailsystem->get('defaults.formatter');

  if ($module_handler->moduleExists('smtp')
    && $system_default === 'smtp'
    && $sender === 'smtp'
    && $formatter === 'smtp') {
    return 'smtp';
  }

  return 'phpmailer_smtp';
}

/**
 * Deletes stale mail config before installing mail modules.
 *
 * @param list<string> $modules
 *   Module IDs about to be installed.
 *
 * @return list<string>
 *   Deleted config names.
 */
function _markaspot_mail_delete_stale_mail_config(array $modules): array {
  $config_by_module = [
    'mailsystem' => ['mailsystem.settings'],
    'phpmailer_smtp' => ['phpmailer_smtp.settings', 'phpmailer_smtp.format'],
  ];

  $deleted = [];
  foreach ($modules as $module) {
    foreach ($config_by_module[$module] ?? [] as $config_name) {
      $config = \Drupal::configFactory()->getEditable($config_name);
      if ($config->isNew()) {
        continue;
      }
      $config->delete();
      $deleted[] = $config_name;
    }
  }

  return $deleted;
}

/**
 * Deletes stale PHPMailer config before installing the module.
 *
 * @return list<string>
 *   Deleted config names.
 */
function _markaspot_mail_delete_stale_phpmailer_smtp_config(): array {
  return _markaspot_mail_delete_stale_mail_config(['phpmailer_smtp']);
}

/**
 * Imports shipped markaspot_mail translations into Drupal locale storage.
 */
function _markaspot_mail_import_shipped_translations(): string {
  if (!\Drupal::moduleHandler()->moduleExists('locale')) {
    return 'locale not enabled; no markaspot_mail translations imported.';
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_mail');
  $translation_dir = DRUPAL_ROOT . '/' . $module_path . '/translations';
  if (!is_dir($translation_dir)) {
    return 'markaspot_mail translation directory not found; no action.';
  }

  $not_customized = defined('LOCALE_NOT_CUSTOMIZED')
    ? (int) constant('LOCALE_NOT_CUSTOMIZED')
    : 0;
  $options = [
    'overwrite_options' => [
      'not_customized' => TRUE,
      'customized' => FALSE,
    ],
    'customized' => $not_customized,
  ];

  $imported = [];
  $imported_langcodes = [];
  $updated_lids = [];
  foreach (array_keys(\Drupal::languageManager()->getLanguages()) as $langcode) {
    if ($langcode === 'en') {
      continue;
    }
    $uri = $translation_dir . '/' . $langcode . '.po';
    if (!is_file($uri)) {
      continue;
    }

    try {
      $report = Gettext::fileToDatabase((object) [
        'langcode' => $langcode,
        'uri' => $uri,
      ], $options);
    }
    catch (\Throwable $e) {
      throw new \RuntimeException(sprintf(
        'Failed to import markaspot_mail translations for %s: %s',
        $langcode,
        $e->getMessage(),
      ), 0, $e);
    }

    $skips = (int) ($report['skips'] ?? 0);
    if ($skips > 0) {
      throw new \RuntimeException(sprintf(
        'Rejected %d unsafe or malformed markaspot_mail translation(s) for %s.',
        $skips,
        $langcode,
      ));
    }

    $changed = (int) ($report['additions'] ?? 0) + (int) ($report['updates'] ?? 0);
    if ($changed > 0) {
      $imported[] = $langcode . ':' . $changed;
      $imported_langcodes[] = $langcode;
      $strings = $report['strings'] ?? [];
      if (is_array($strings)) {
        $updated_lids = array_merge($updated_lids, $strings);
      }
    }
  }

  if ($imported === []) {
    return 'markaspot_mail translations already up to date; no action.';
  }

  if (function_exists('_locale_refresh_translations')) {
    _locale_refresh_translations($imported_langcodes, array_unique($updated_lids));
  }

  return 'Imported markaspot_mail translations: ' . implode(', ', $imported) . '.';
}

/**
 * Ensures PHPMailer keeps message bodies as HTML.
 */
function _markaspot_mail_ensure_phpmailer_html_format(): bool {
  $config = \Drupal::configFactory()->getEditable('phpmailer_smtp.format');
  $changed = FALSE;
  if ($config->isNew()) {
    $config->set('dependencies.module', ['phpmailer_smtp']);
    $config->set('force_html', 0);
    $changed = TRUE;
  }
  if ($config->get('format') !== 'html') {
    $config->set('format', 'html');
    $changed = TRUE;
  }
  if ($changed) {
    $config->save();
  }
  return $changed;
}

/**
 * Restores the ECA entity token on migrated notification mail actions.
 *
 * The mail-text migration shipped in update 10007ff rewrote legacy
 * action_send_email_action actions onto markaspot_mail_send_notification but
 * dropped the ECA `object` configuration key. Without it, ECA resolves no
 * acted-upon entity for the action (see EcaObject::getEntities()), execute()
 * receives NULL and silently skips every send. Unit tests pass the node
 * directly and cannot catch this; only real ECA execution does.
 */
function markaspot_mail_update_10013(): string {
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('eca')) {
    return 'Skipped: the ECA module is not installed, no models to heal.';
  }

  $healed = [];
  foreach ($entity_type_manager->getStorage('eca')->loadMultiple() as $eca) {
    $actions = $eca->get('actions') ?? [];
    $changed = FALSE;
    foreach ($actions as $activity_id => $action) {
      if (($action['plugin'] ?? '') !== 'markaspot_mail_send_notification') {
        continue;
      }
      if (trim((string) ($action['configuration']['object'] ?? '')) !== '') {
        continue;
      }
      $actions[$activity_id]['configuration'] = ['object' => 'entity'] + (array) ($action['configuration'] ?? []);
      $changed = TRUE;
    }
    if ($changed) {
      $eca->set('actions', $actions);
      $eca->save();
      $healed[] = $eca->id();
    }
  }

  return $healed
    ? sprintf('Restored the ECA entity token on notification mail actions in: %s.', implode(', ', $healed))
    : 'All notification mail actions already carry an entity token.';
}

/**
 * Adds the operator-owned status notification key field.
 *
 * Empty values intentionally remain valid because not every status transition
 * should send citizen mail.
 */
function markaspot_mail_update_10014(): string {
  $created = [];

  if (!FieldStorageConfig::loadByName('taxonomy_term', 'field_notification_key')) {
    FieldStorageConfig::create([
      'field_name' => 'field_notification_key',
      'entity_type' => 'taxonomy_term',
      'type' => 'string',
      'settings' => [
        'max_length' => 64,
        'is_ascii' => FALSE,
        'case_sensitive' => FALSE,
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
      'dependencies' => [
        'enforced' => [
          'module' => ['markaspot_mail'],
        ],
      ],
    ])->save();
    $created[] = 'field_notification_key storage';
  }

  if (!FieldConfig::loadByName('taxonomy_term', 'service_status', 'field_notification_key')) {
    FieldConfig::create([
      'field_name' => 'field_notification_key',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'service_status',
      'label' => 'Notification key',
      'description' => 'Mail text key sent when a request enters this status. Leave empty to send no mail.',
      'required' => FALSE,
      'translatable' => FALSE,
      'dependencies' => [
        'enforced' => [
          'module' => ['markaspot_mail'],
        ],
      ],
    ])->save();
    $created[] = 'field_notification_key on service_status';
  }

  return $created
    ? 'Created ' . implode(' and ', $created) . '.'
    : 'The service status notification key field already exists.';
}

/**
 * Exposes the status notification key to operators on the term form.
 *
 * Existing installs already own this display config, so a module default alone
 * cannot add the widget after update 10014 created the field.
 */
function markaspot_mail_update_10015(): string {
  $field = FieldConfig::loadByName('taxonomy_term', 'service_status', 'field_notification_key');
  if (!$field) {
    return 'Skipped the notification key widget because the field is absent.';
  }

  $description = 'Standard keys: status_open, status_closed, status_not_responsible. Leave empty to send no mail.';
  $description_updated = FALSE;
  if ($field->getDescription() !== $description) {
    $field->setDescription($description)->save();
    $description_updated = TRUE;
  }

  $display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('taxonomy_term.service_status.default');
  if (!$display) {
    return $description_updated
      ? 'Updated the notification key description; the service status form display is absent.'
      : 'Skipped the notification key widget because the service status form display is absent.';
  }
  if ($display->getComponent('field_notification_key') !== NULL) {
    return $description_updated
      ? 'Updated the notification key description; the widget already exists.'
      : 'The service status notification key widget already exists.';
  }

  $display->setComponent('field_notification_key', [
    'type' => 'string_textfield',
    'weight' => 6,
    'region' => 'content',
    'settings' => [
      'size' => 64,
      'placeholder' => '',
    ],
    'third_party_settings' => [],
  ])->save();

  return 'Added the notification key text field to the service status form.';
}
