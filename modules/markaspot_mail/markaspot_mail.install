<?php

/**
 * @file
 * Install and update hooks for markaspot_mail.
 */

declare(strict_types=1);

/**
 * Switch phpmailer_smtp default format to html on existing installs.
 *
 * The phpmailer_smtp contrib module ships with `format: text_plain` as its
 * install default. Its PhpMailerSmtp::format() plugin only DOWNGRADES to
 * plain when the hook_mail_alter pipeline explicitly sets Content-Type:
 * text/plain. It never UPGRADES to html from a Content-Type: text/html
 * header. Result: every branded HTML mail produced by our builders lands
 * in inboxes as a naive html-to-text conversion that keeps inline <style>
 * block content as visible noise.
 *
 * Fresh enablements of markaspot_mail import the html default via
 * config/optional/phpmailer_smtp.format.yml. This update hook handles
 * tenants that already had markaspot_mail enabled before the optional
 * config shipped (e.g. the demo tenant, manually enabled during
 * diagnosis). Idempotent: no-op if format is already html or if
 * phpmailer_smtp is not installed.
 */
function markaspot_mail_update_10001(): string {
  if (!\Drupal::moduleHandler()->moduleExists('phpmailer_smtp')) {
    return 'phpmailer_smtp not enabled; no action.';
  }
  $config = \Drupal::configFactory()->getEditable('phpmailer_smtp.format');
  if ($config->get('format') === 'html') {
    return 'phpmailer_smtp.format.format already html; no action.';
  }
  $config->set('format', 'html')->save();
  return 'Switched phpmailer_smtp.format.format to html.';
}

/**
 * Seed attachments.* defaults into markaspot_mail.settings.
 *
 * Fresh installs get the new block via config/install. Existing installs
 * miss it entirely — without these defaults, AttachmentResolver falls
 * back to its hard-coded constants (safe but invisible to operators
 * trying to audit "what gets attached"). This hook only fills missing
 * keys so a site-admin override of e.g. max_total_bytes survives.
 */
function markaspot_mail_update_10002(): string {
  $config = \Drupal::configFactory()->getEditable('markaspot_mail.settings');
  $current = $config->get('attachments') ?? [];
  $defaults = [
    'enabled' => TRUE,
    'max_per_file_bytes' => 5242880,
    'max_total_bytes' => 20971520,
    'allowed_mime' => [
      'image/jpeg',
      'image/png',
      'image/gif',
      'application/pdf',
      'application/msword',
      'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      'message/rfc822',
      'text/plain',
    ],
  ];
  $added = [];
  foreach ($defaults as $key => $value) {
    if (!array_key_exists($key, $current)) {
      $current[$key] = $value;
      $added[] = $key;
    }
  }
  if ($added === []) {
    return 'attachments.* already present; no action.';
  }
  $config->set('attachments', $current)->save();
  return 'Seeded attachments defaults: ' . implode(', ', $added) . '.';
}

/**
 * Import updated shipped translations for organisation assignment mails.
 *
 * Drupal imports module-local .po files when a module or language is first
 * enabled. Existing tenants need an update hook when we extend those files,
 * otherwise new $this->t() strings keep falling back to English until an
 * operator manually runs locale:check + locale:update.
 */
function markaspot_mail_update_10003(): string {
  if (!\Drupal::moduleHandler()->moduleExists('locale')) {
    return 'locale not enabled; no markaspot_mail translations imported.';
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_mail');
  $translation_dir = DRUPAL_ROOT . '/' . $module_path . '/translations';
  if (!is_dir($translation_dir)) {
    return 'markaspot_mail translation directory not found; no action.';
  }

  $not_customized = defined('LOCALE_NOT_CUSTOMIZED')
    ? (int) constant('LOCALE_NOT_CUSTOMIZED')
    : 0;
  $options = [
    'overwrite_options' => [
      'not_customized' => TRUE,
      'customized' => FALSE,
    ],
    'customized' => $not_customized,
  ];

  $imported = [];
  $imported_langcodes = [];
  $updated_lids = [];
  foreach (array_keys(\Drupal::languageManager()->getLanguages()) as $langcode) {
    if ($langcode === 'en') {
      continue;
    }
    $uri = $translation_dir . '/' . $langcode . '.po';
    if (!is_file($uri)) {
      continue;
    }

    try {
      $report = \Drupal\locale\Gettext::fileToDatabase((object) [
        'langcode' => $langcode,
        'uri' => $uri,
      ], $options);
    }
    catch (\Throwable $e) {
      \Drupal::logger('markaspot_mail')->warning('Failed to import markaspot_mail translations for @langcode: @message', [
        '@langcode' => $langcode,
        '@message' => $e->getMessage(),
      ]);
      continue;
    }

    $changed = (int) ($report['additions'] ?? 0) + (int) ($report['updates'] ?? 0);
    if ($changed > 0) {
      $imported[] = $langcode . ':' . $changed;
      $imported_langcodes[] = $langcode;
      $strings = $report['strings'] ?? [];
      if (is_array($strings)) {
        $updated_lids = array_merge($updated_lids, $strings);
      }
    }
  }

  if ($imported === []) {
    return 'markaspot_mail translations already up to date; no action.';
  }

  if (function_exists('_locale_refresh_translations')) {
    _locale_refresh_translations($imported_langcodes, array_unique($updated_lids));
  }

  return 'Imported markaspot_mail translations: ' . implode(', ', $imported) . '.';
}
