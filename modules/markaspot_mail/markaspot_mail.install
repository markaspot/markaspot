<?php

/**
 * @file
 * Install and update hooks for markaspot_mail.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 */
function markaspot_mail_install(): void {
  $config_factory = \Drupal::configFactory();
  $module_handler = \Drupal::moduleHandler();
  $target_backend = _markaspot_mail_resolve_backend($module_handler, $config_factory);

  $system_mail = $config_factory->getEditable('system.mail');
  if ($system_mail->get('interface.default') !== $target_backend) {
    $system_mail->set('interface.default', $target_backend)->save();
  }

  $mailsystem = $config_factory->getEditable('mailsystem.settings');
  $mailsystem_changed = FALSE;
  foreach (['defaults.sender', 'defaults.formatter'] as $key) {
    if ($mailsystem->get($key) !== $target_backend) {
      $mailsystem->set($key, $target_backend);
      $mailsystem_changed = TRUE;
    }
  }
  if ($mailsystem_changed) {
    $mailsystem->save();
  }

  if ($target_backend === 'phpmailer_smtp') {
    _markaspot_mail_ensure_phpmailer_html_format();
  }
  _markaspot_mail_seed_attachment_defaults();
}

/**
 * Switch phpmailer_smtp default format to html on existing installs.
 *
 * The phpmailer_smtp contrib module ships with `format: text_plain` as its
 * install default. Its PhpMailerSmtp::format() plugin only DOWNGRADES to
 * plain when the hook_mail_alter pipeline explicitly sets Content-Type:
 * text/plain. It never UPGRADES to html from a Content-Type: text/html
 * header. Result: every branded HTML mail produced by our builders lands
 * in inboxes as a naive html-to-text conversion that keeps inline <style>
 * block content as visible noise.
 *
 * Fresh enablements of markaspot_mail import the html default via
 * config/optional/phpmailer_smtp.format.yml. This update hook handles
 * tenants that already had markaspot_mail enabled before the optional
 * config shipped (e.g. the demo tenant, manually enabled during
 * diagnosis). Idempotent: no-op if format is already html or if
 * phpmailer_smtp is not installed.
 */
function markaspot_mail_update_10001(): string {
  if (!\Drupal::moduleHandler()->moduleExists('phpmailer_smtp')) {
    return 'phpmailer_smtp not enabled; no action.';
  }
  if (!_markaspot_mail_ensure_phpmailer_html_format()) {
    return 'phpmailer_smtp.format.format already html; no action.';
  }
  return 'Switched phpmailer_smtp.format.format to html.';
}

/**
 * Seed attachments.* defaults into markaspot_mail.settings.
 *
 * Fresh installs get the new block via config/install. Existing installs
 * miss it entirely — without these defaults, AttachmentResolver falls
 * back to its hard-coded constants (safe but invisible to operators
 * trying to audit "what gets attached"). This hook only fills missing
 * keys so a site-admin override of e.g. max_total_bytes survives.
 */
function markaspot_mail_update_10002(): string {
  $added = _markaspot_mail_seed_attachment_defaults();
  if ($added === []) {
    return 'attachments.* already present; no action.';
  }
  return 'Seeded attachments defaults: ' . implode(', ', $added) . '.';
}

/**
 * Seeds missing markaspot_mail attachment defaults.
 *
 * @return list<string>
 *   Added attachment setting keys.
 */
function _markaspot_mail_seed_attachment_defaults(): array {
  $config = \Drupal::configFactory()->getEditable('markaspot_mail.settings');
  $current = $config->get('attachments') ?? [];
  $defaults = [
    'enabled' => TRUE,
    'max_per_file_bytes' => 5242880,
    'max_total_bytes' => 20971520,
    'allowed_mime' => [
      'image/jpeg',
      'image/png',
      'image/gif',
      'application/pdf',
      'application/msword',
      'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      'message/rfc822',
      'text/plain',
    ],
  ];
  $added = [];
  foreach ($defaults as $key => $value) {
    if (!array_key_exists($key, $current)) {
      $current[$key] = $value;
      $added[] = $key;
    }
  }
  if ($added !== []) {
    $config->set('attachments', $current)->save();
  }
  return $added;
}

/**
 * Import updated shipped translations for organisation assignment mails.
 *
 * Drupal imports module-local .po files when a module or language is first
 * enabled. Existing tenants need an update hook when we extend those files,
 * otherwise new $this->t() strings keep falling back to English until an
 * operator manually runs locale:check + locale:update.
 */
function markaspot_mail_update_10003(): string {
  return _markaspot_mail_import_shipped_translations();
}

/**
 * Re-import shipped translations for tenants that already ran update 10003.
 */
function markaspot_mail_update_10004(): string {
  return _markaspot_mail_import_shipped_translations();
}

/**
 * Route Drupal mail through the HTML-capable PHPMailer SMTP plugin.
 *
 * Legacy tenant database imports can restore Core/Maillog mail plugins. Core's
 * php_mail formatter always converts message bodies through htmlToText(), so
 * our branded mail builders end up with Content-Type: text/html but no HTML
 * tags left in the body. Keep the sender and formatter aligned.
 */
function markaspot_mail_update_10005(): string {
  $module_handler = \Drupal::moduleHandler();
  $missing = [];
  foreach (['mailsystem', 'phpmailer_smtp'] as $module) {
    if (!$module_handler->moduleExists($module)) {
      $missing[] = $module;
    }
  }
  if ($missing !== []) {
    $deleted_stale = _markaspot_mail_delete_stale_mail_config($missing);
    \Drupal::service('module_installer')->install($missing);
    $module_handler->resetImplementations();
    $still_missing = [];
    foreach ($missing as $module) {
      if (!$module_handler->moduleExists($module)) {
        $still_missing[] = $module;
      }
    }
    if ($still_missing !== []) {
      throw new \RuntimeException('Could not enable required mail modules: ' . implode(', ', $still_missing));
    }
  }

  $config_factory = \Drupal::configFactory();
  $target_backend = _markaspot_mail_resolve_backend($module_handler, $config_factory);
  $changed = [];
  if ($missing !== []) {
    $changed[] = 'enabled modules: ' . implode(', ', $missing);
    if ($deleted_stale !== []) {
      $changed[] = 'removed stale config: ' . implode(', ', $deleted_stale);
    }
  }

  $system_mail = $config_factory->getEditable('system.mail');
  if ($system_mail->get('interface.default') !== $target_backend) {
    $system_mail->set('interface.default', $target_backend)->save();
    $changed[] = 'system.mail.interface.default';
  }

  $mailsystem = $config_factory->getEditable('mailsystem.settings');
  foreach (['defaults.sender', 'defaults.formatter'] as $key) {
    if ($mailsystem->get($key) !== $target_backend) {
      $mailsystem->set($key, $target_backend);
      $changed[] = 'mailsystem.settings.' . $key;
    }
  }
  if (array_intersect($changed, [
    'mailsystem.settings.defaults.sender',
    'mailsystem.settings.defaults.formatter',
  ])) {
    $mailsystem->save();
  }

  if ($target_backend === 'phpmailer_smtp' && _markaspot_mail_ensure_phpmailer_html_format()) {
    $changed[] = 'phpmailer_smtp.format.format';
  }

  $attachment_defaults = _markaspot_mail_seed_attachment_defaults();
  foreach ($attachment_defaults as $key) {
    $changed[] = 'markaspot_mail.settings.attachments.' . $key;
  }
  $mail_settings = $config_factory->getEditable('markaspot_mail.settings');
  if ($mail_settings->get('attachments.enabled') !== TRUE) {
    $mail_settings->set('attachments.enabled', TRUE)->save();
    $changed[] = 'markaspot_mail.settings.attachments.enabled';
  }

  if ($changed === []) {
    return 'HTML mail backend already aligned; no action.';
  }
  return 'Aligned HTML mail backend: ' . implode(', ', $changed) . '.';
}

/**
 * Resolves the backend that should own the runtime mail stack.
 */
function _markaspot_mail_resolve_backend(
  \Drupal\Core\Extension\ModuleHandlerInterface $module_handler,
  \Drupal\Core\Config\ConfigFactoryInterface $config_factory,
): string {
  $system_mail = $config_factory->get('system.mail');
  $mailsystem = $config_factory->get('mailsystem.settings');
  $system_default = $system_mail->isNew() ? '' : (string) $system_mail->get('interface.default');
  $sender = $mailsystem->isNew() ? '' : (string) $mailsystem->get('defaults.sender');
  $formatter = $mailsystem->isNew() ? '' : (string) $mailsystem->get('defaults.formatter');

  if ($module_handler->moduleExists('smtp')
    && $system_default === 'smtp'
    && $sender === 'smtp'
    && $formatter === 'smtp') {
    return 'smtp';
  }

  return 'phpmailer_smtp';
}

/**
 * Deletes stale mail config before installing mail modules.
 *
 * @param list<string> $modules
 *   Module IDs about to be installed.
 *
 * @return list<string>
 *   Deleted config names.
 */
function _markaspot_mail_delete_stale_mail_config(array $modules): array {
  $config_by_module = [
    'mailsystem' => ['mailsystem.settings'],
    'phpmailer_smtp' => ['phpmailer_smtp.settings', 'phpmailer_smtp.format'],
  ];

  $deleted = [];
  foreach ($modules as $module) {
    foreach ($config_by_module[$module] ?? [] as $config_name) {
      $config = \Drupal::configFactory()->getEditable($config_name);
      if ($config->isNew()) {
        continue;
      }
      $config->delete();
      $deleted[] = $config_name;
    }
  }

  return $deleted;
}

/**
 * Deletes stale PHPMailer config before installing the module.
 *
 * @return list<string>
 *   Deleted config names.
 */
function _markaspot_mail_delete_stale_phpmailer_smtp_config(): array {
  return _markaspot_mail_delete_stale_mail_config(['phpmailer_smtp']);
}

/**
 * Imports shipped markaspot_mail translations into Drupal locale storage.
 */
function _markaspot_mail_import_shipped_translations(): string {
  if (!\Drupal::moduleHandler()->moduleExists('locale')) {
    return 'locale not enabled; no markaspot_mail translations imported.';
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_mail');
  $translation_dir = DRUPAL_ROOT . '/' . $module_path . '/translations';
  if (!is_dir($translation_dir)) {
    return 'markaspot_mail translation directory not found; no action.';
  }

  $not_customized = defined('LOCALE_NOT_CUSTOMIZED')
    ? (int) constant('LOCALE_NOT_CUSTOMIZED')
    : 0;
  $options = [
    'overwrite_options' => [
      'not_customized' => TRUE,
      'customized' => FALSE,
    ],
    'customized' => $not_customized,
  ];

  $imported = [];
  $imported_langcodes = [];
  $updated_lids = [];
  foreach (array_keys(\Drupal::languageManager()->getLanguages()) as $langcode) {
    if ($langcode === 'en') {
      continue;
    }
    $uri = $translation_dir . '/' . $langcode . '.po';
    if (!is_file($uri)) {
      continue;
    }

    try {
      $report = \Drupal\locale\Gettext::fileToDatabase((object) [
        'langcode' => $langcode,
        'uri' => $uri,
      ], $options);
    }
    catch (\Throwable $e) {
      \Drupal::logger('markaspot_mail')->warning('Failed to import markaspot_mail translations for @langcode: @message', [
        '@langcode' => $langcode,
        '@message' => $e->getMessage(),
      ]);
      continue;
    }

    $changed = (int) ($report['additions'] ?? 0) + (int) ($report['updates'] ?? 0);
    if ($changed > 0) {
      $imported[] = $langcode . ':' . $changed;
      $imported_langcodes[] = $langcode;
      $strings = $report['strings'] ?? [];
      if (is_array($strings)) {
        $updated_lids = array_merge($updated_lids, $strings);
      }
    }
  }

  if ($imported === []) {
    return 'markaspot_mail translations already up to date; no action.';
  }

  if (function_exists('_locale_refresh_translations')) {
    _locale_refresh_translations($imported_langcodes, array_unique($updated_lids));
  }

  return 'Imported markaspot_mail translations: ' . implode(', ', $imported) . '.';
}

/**
 * Ensures PHPMailer keeps message bodies as HTML.
 */
function _markaspot_mail_ensure_phpmailer_html_format(): bool {
  $config = \Drupal::configFactory()->getEditable('phpmailer_smtp.format');
  $changed = FALSE;
  if ($config->isNew()) {
    $config->set('dependencies.module', ['phpmailer_smtp']);
    $config->set('force_html', 0);
    $changed = TRUE;
  }
  if ($config->get('format') !== 'html') {
    $config->set('format', 'html');
    $changed = TRUE;
  }
  if ($changed) {
    $config->save();
  }
  return $changed;
}
