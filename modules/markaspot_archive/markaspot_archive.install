<?php

/**
 * @file
 * Install, update and uninstall functions for the Mark‑a‑Spot Archive module.
 */

use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;

/**
 * Implements hook_requirements().
 */
function markaspot_archive_requirements($phase) {
  $requirements = [];
  if ($phase !== 'runtime') {
    return $requirements;
  }

  $config = \Drupal::config('markaspot_archive.settings');
  /** @var \Drupal\markaspot_archive\ArchiveServiceInterface $archive */
  $archive = \Drupal::service('markaspot_archive.archive');
  $fields = $archive->normalizeConfiguredFields(
    (array) $config->get('anonymize_fields')
  );
  if ((bool) $config->get('anonymize') && $fields === []) {
    $requirements['markaspot_archive_anonymize_fields'] = [
      'title' => t('Mark-a-Spot Archive anonymization'),
      'value' => t('No anonymization fields configured'),
      'description' => t('Anonymization is enabled but no fields are configured; contact data will NOT be cleared.'),
      'severity' => REQUIREMENT_WARNING,
    ];
  }

  return $requirements;
}

/**
 * Adds an integer field 'field_archive_days' to the 'service_category' vocabulary.
 *
 * @return bool
 *   TRUE on success, FALSE on failure.
 */
function markaspot_archive_update_9001() {
  // Create field storage if it does not already exist.
  $storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_archive_days');
  if (!$storage) {
    $storage = FieldStorageConfig::create([
      'field_name' => 'field_archive_days',
      'entity_type' => 'taxonomy_term',
      'type' => 'integer',
      'settings' => [
        'min' => 1,
        'max' => NULL,
        'prefix' => '',
        'suffix' => '',
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
      'persist_with_no_fields' => FALSE,
      'locked' => FALSE,
    ]);
    $storage->save();
  }

  // Determine default_days from module config.
  $config = \Drupal::config('markaspot_archive.settings');
  $default_days = (int) $config->get('default_days') ?: 0;
  // Create or update field instance on the service_category bundle.
  $instance = FieldConfig::loadByName('taxonomy_term', 'service_category', 'field_archive_days');
  if (!$instance) {
    $instance = FieldConfig::create([
      'field_name' => 'field_archive_days',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'service_category',
      'label' => 'Archive period (days)',
      'description' => 'Override the default archive period for this category. Leave empty to use global default.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [],
      'default_value' => [['value' => $default_days]],
      'default_value_callback' => '',
    ]);
    $instance->save();
  }
  else {
    // Update existing field to set default value.
    $instance->set('default_value', [['value' => $default_days]]);
    $instance->save();
  }

  // Optionally, add to form and view displays.
  // Add to the default form display as a number field.
  if ($storage && $instance) {
    /** @var \Drupal\Core\Entity\EntityDisplayRepositoryInterface $display_repo */
    $display_repo = \Drupal::service('entity_display.repository');
    $form_display = $display_repo
      ->getFormDisplay('taxonomy_term', 'service_category', 'default');
    $form_display->setComponent('field_archive_days', [
      'type' => 'number',
      'weight' => 10,
      'settings' => [],
    ])->save();

    $view_display = $display_repo
      ->getViewDisplay('taxonomy_term', 'service_category', 'default');
    $view_display->setComponent('field_archive_days', [
      'type' => 'number_integer',
      'weight' => 10,
      'label' => 'above',
      'settings' => [],
    ])->save();
  }

  return TRUE;
}

/**
 * Add cron_always_run setting with default FALSE to existing config.
 */
function markaspot_archive_update_9002() {
  $config = \Drupal::configFactory()->getEditable('markaspot_archive.settings');
  // Only set if not present yet.
  if ($config->get('cron_always_run') === NULL) {
    $config->set('cron_always_run', 0)->save();
  }
  return TRUE;
}

/**
 * Migrates legacy numeric anonymize_fields config to explicit contact fields.
 *
 * Older installs stored numeric ids in anonymize_fields; the runtime used to
 * expand them to a hard-coded field list. The expansion is gone, so numeric
 * entries would silently disable anonymization. Address data intentionally
 * stays out of the list: the report location is public operational data.
 */
function markaspot_archive_update_9003() {
  $config = \Drupal::configFactory()->getEditable('markaspot_archive.settings');
  $fields = (array) $config->get('anonymize_fields');
  $has_numeric = FALSE;
  $explicit = [];
  foreach ($fields as $key => $value) {
    if (is_numeric($key) && is_numeric($value)) {
      $has_numeric = TRUE;
      continue;
    }
    $name = is_numeric($key) ? (string) $value : (string) $key;
    if ($name !== '') {
      $explicit[$name] = $name;
    }
  }
  if (!$has_numeric) {
    return (string) t('No legacy numeric anonymize_fields entries found.');
  }
  $defaults = [
    'field_e_mail',
    'field_first_name',
    'field_last_name',
    'field_phone',
    'field_notification',
  ];
  foreach ($defaults as $name) {
    $explicit[$name] = $name;
  }
  $config->set('anonymize_fields', $explicit)->save();
  return (string) t('Replaced legacy numeric anonymize_fields entries with explicit contact fields: @fields', [
    '@fields' => implode(', ', array_keys($explicit)),
  ]);
}
