<?php

/**
 * @file
 * Contains markaspot_archive.module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\State\StateInterface;
use Drupal\markaspot_archive\Plugin\QueueWorker\ArchiveQueueWorker;

/**
 * Implements hook_help().
 */
function markaspot_archive_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the markaspot_archive module.
    case 'help.page.markaspot_archive':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Mark-a-Spot Archive') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_cron().
 */
function markaspot_archive_cron() {
  // Get the configuration and check if cron‐based archiving is enabled.
  $config = \Drupal::config('markaspot_archive.settings');
  // Bail out only if cron_enable is explicitly disabled (0).
  if ($config->get('cron_enable') === 0) {
    return;
  }
  // Always run flag.
  $always = (bool) $config->get('cron_always_run');
  // Throttle interval (seconds).
  $interval = (int) $config->get('cron_interval');
  $state = \Drupal::state();
  $now = \Drupal::time()->getRequestTime();
  $failed_nids = markaspot_archive_active_failed_nids($state, $now);
  if (!$always && $interval > 0) {
    $last_run = $state->get('markaspot_archive.last_run', 0);
    if (($now - $last_run) < $interval) {
      // Not yet time to run again.
      return;
    }
    // Update last run time immediately to avoid race conditions.
    $state->set('markaspot_archive.last_run', $now);
  }
  // Determine what "archived" status is.
  $archived_status = $config->get('status_archived');

  // Get all nodes eligible for archiving from your service.
  $archivables = \Drupal::service('markaspot_archive.archive')->load();

  // Get the queue for the archive worker.
  $queue = \Drupal::queue('markaspot_archive_queue_worker');
  $count = 0;
  $enqueued = [];

  foreach ($archivables as $archivable) {
    $nid = (int) $archivable->id();
    // Check if the node is already archived.
    if (
      !isset($failed_nids[$nid])
      && !isset($enqueued[$nid])
      && $archivable->get('field_status')->target_id != $archived_status
    ) {
      // Only enqueue nodes that are not archived.
      $queue->createItem([
        'nid' => $nid,
        'attempts' => 1,
      ]);
      $enqueued[$nid] = TRUE;
      $count++;
    }
  }

  \Drupal::logger('markaspot_archive')->notice(
    'Enqueued @count nodes for archiving.',
    ['@count' => $count]
  );
}

/**
 * Anonymize configured fields on a service_request node.
 *
 * @param \Drupal\Core\Entity\EntityInterface $archivable
 *   The node entity to anonymize.
 * @param string[] $anonymize_fields
 *   Array of field machine names to anonymize.
 *
 * @return \Drupal\Core\Entity\EntityInterface
 *   The modified node.
 */
function markaspot_archive_anonymize(
  EntityInterface $archivable,
  array $anonymize_fields,
) {
  \Drupal::service('markaspot_archive.archive')->anonymize(
    $archivable,
    $anonymize_fields
  );
  return $archivable;
}

/**
 * Returns active queue failures and expires entries older than the retry TTL.
 *
 * @param \Drupal\Core\State\StateInterface $state
 *   State service.
 * @param int $now
 *   Current request timestamp.
 *
 * @return array<int, int>
 *   Failed node ids keyed by node id with their failure timestamp.
 */
function markaspot_archive_active_failed_nids(
  StateInterface $state,
  int $now,
): array {
  $stored = (array) $state->get(ArchiveQueueWorker::FAILED_NIDS_STATE, []);
  $active = [];
  $cutoff = $now - ArchiveQueueWorker::FAILED_NIDS_TTL;
  foreach ($stored as $nid => $timestamp) {
    if ((int) $timestamp >= $cutoff) {
      $active[(int) $nid] = (int) $timestamp;
    }
  }
  if ($active != $stored) {
    $state->set(ArchiveQueueWorker::FAILED_NIDS_STATE, $active);
  }
  return $active;
}
