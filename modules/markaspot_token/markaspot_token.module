<?php

/**
 * @file
 * Contains markaspot_token.module.
 */

use Drupal\Component\Utility\Html;
use Drupal\node\Entity\NodeType;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Render\BubbleableMetadata;

/**
 * Implements hook_help().
 */
function markaspot_token_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the markaspot_token module.
    case 'help.page.markaspot_token':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Adds custom token') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_token_info().
 */
function markaspot_token_token_info() {
  // Add any new tokens.
  $type = [
    'name' => t('Nodes'),
    'description' => t('Tokens related to individual content items, or "nodes".'),
    'needs-data' => 'node',
  ];

  // Core tokens for nodes.
  $node['uuid'] = [
    'name' => t("Content UUID"),
    'description' => t('The global unique ID of the content item, or "node".'),
  // Return them.
  ];
  $node['request_id'] = [
    'name' => t("Service Request ID"),
    'description' => t('The Request ID of 311 Service requests.'),
    // Return them.
  ];
  $node['initial_status_note'] = [
    'name' => t("Initial Status Note"),
    'description' => t('The text of the first status note on the service request.'),
  ];
  $node['latest_status_note'] = [
    'name' => t("Latest Status Note"),
    'description' => t('The text of the most recent status note on the service request. Use this in citizen-facing mails to deliver the manager-written feedback for the current status transition.'),
  ];

  return [
    'types' => ['node' => $type],
    'tokens' => ['node' => $node],
  ];
}

/**
 * Implements hook_tokens().
 */
function markaspot_token_tokens(
  $type,
  $tokens,
  array $data,
  array $options,
  BubbleableMetadata $bubbleable_metadata,
) {

  $replacements = [];

  // Node tokens.
  if ($type == 'node' && !empty($data['node'])) {
    /** @var \Drupal\node\NodeInterface $node */
    $node = $data['node'];

    foreach ($tokens as $name => $original) {
      switch ($name) {
        // Simple key values on the node.
        case 'uuid':
          $replacements[$original] = $node->uuid();
          break;

        case 'request_id':
          $replacements[$original] = $node->request_id->value;
          break;

        case 'initial_status_note':
          $replacements[$original] = '';
          if ($node->hasField('field_status_notes') && !$node->get('field_status_notes')->isEmpty()) {
            $entities = $node->get('field_status_notes')->referencedEntities();
            $first = reset($entities) ?: NULL;
            if ($first && $first->hasField('field_status_note') && !$first->get('field_status_note')->isEmpty()) {
              $replacements[$original] = _markaspot_token_status_note_value($first->get('field_status_note')->value);
              $bubbleable_metadata->addCacheableDependency($first);
              $bubbleable_metadata->addCacheableDependency($node);
            }
          }
          break;

        case 'latest_status_note':
          $replacements[$original] = '';
          if ($node->hasField('field_status_notes') && !$node->get('field_status_notes')->isEmpty()) {
            $entities = $node->get('field_status_notes')->referencedEntities();
            $last = end($entities) ?: NULL;
            if ($last && $last->hasField('field_status_note') && !$last->get('field_status_note')->isEmpty()) {
              $replacements[$original] = _markaspot_token_status_note_value($last->get('field_status_note')->value);
              $bubbleable_metadata->addCacheableDependency($last);
              $bubbleable_metadata->addCacheableDependency($node);
            }
          }
          break;
      }
    }

    // Chained token relationships.
    if (($parent_tokens = \Drupal::token()->findWithPrefix($tokens, 'source')) && $source_node = $node->getUntranslated()) {
      $replacements += \Drupal::token()->generate('node', $parent_tokens, ['node' => $source_node], $options, $bubbleable_metadata);
    }
    if (($node_type_tokens = \Drupal::token()->findWithPrefix($tokens, 'content-type')) && $node_type = NodeType::load($node->bundle())) {
      $replacements += \Drupal::token()->generate('content-type', $node_type_tokens, ['node_type' => $node_type], $options, $bubbleable_metadata);
    }
    if (($url_tokens = \Drupal::token()->findWithPrefix($tokens, 'url'))) {
      $replacements += \Drupal::token()->generate('url', $url_tokens, ['url' => $node->toUrl()], $options, $bubbleable_metadata);
    }
  }
  return $replacements;

}

/**
 * Sanitises a status note paragraph body for use in mail tokens.
 *
 * Strips CR/LF before HTML-escaping so the value is safe in both mail
 * bodies and mail subject lines (the token may end up in either,
 * depending on how an ECA action template is configured). Without the
 * newline strip, a manager who writes "ok\nBcc: attacker@example.com"
 * could inject mail headers if the token is ever placed in a subject:
 * field — Html::escape() encodes HTML metacharacters but leaves
 * newlines intact (CWE-93).
 *
 * Newlines are replaced with a single space rather than removed so word
 * boundaries are preserved when the value is rendered inline in a body
 * paragraph; the body Twig path runs Xss::filter and re-paragraphs via
 * SplitParagraphsTrait, which works on blank-line separators not single
 * newlines, so the visual result is unchanged for body usage.
 */
function _markaspot_token_status_note_value(string $raw): string {
  return Html::escape(str_replace(["\r\n", "\r", "\n"], ' ', $raw));
}
