<?php

/**
 * @file
 * Server-side geocoding for Mark-a-Spot service requests.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\markaspot_geocoder\Service\MarkaspotGeocoderService;
use Drupal\taxonomy\Entity\Term;

/**
 * Implements hook_ENTITY_TYPE_presave() for node entities.
 *
 * Geocode coordinates to address before saving, then apply district mappings.
 */
function markaspot_geocoder_node_presave(EntityInterface $node) {
  if ($node->bundle() !== 'service_request') {
    return;
  }

  try {
    $isNew = $node->isNew();

    if (!$node->hasField('field_geolocation') || $node->get('field_geolocation')->isEmpty()) {
      return;
    }

    $lat = $node->get('field_geolocation')->lat;
    $lng = $node->get('field_geolocation')->lng;

    // Check if the geolocation fields have changed (only for existing nodes).
    $geolocationChanged = FALSE;
    if (!$isNew && isset($node->original)) {
      $original_lat = $node->original->get('field_geolocation')->lat ?? NULL;
      $original_lng = $node->original->get('field_geolocation')->lng ?? NULL;
      $geolocationChanged = $lat !== $original_lat || $lng !== $original_lng;
    }

    // Check if address is missing.
    $addressMissing = $node->hasField('field_address') &&
      ($node->get('field_address')->isEmpty() ||
       empty($node->get('field_address')->address_line1));

    // Check if any district mapping fields are empty.
    /** @var \Drupal\markaspot_geocoder\Service\MarkaspotGeocoderService $geocoder_service */
    $geocoder_service = \Drupal::service('markaspot_geocoder.geocoder');
    $districtFieldsEmpty = _markaspot_geocoder_has_empty_district_fields($node, $geocoder_service);

    // Geocode when the node is new, its coordinates moved, the address is
    // missing, or any mapped district field is still empty.
    if (($isNew || $geolocationChanged || $addressMissing || $districtFieldsEmpty) && isset($lat, $lng)) {
      $address = $geocoder_service->getAddressFromCoordinates($lat, $lng);

      if ($address) {
        // Only update address if it was missing or geolocation changed.
        if ($isNew || $geolocationChanged || $addressMissing) {
          $node->field_address->country_code = $address['country_code'];
          $node->field_address->locality = $address['locality'];
          $node->field_address->address_line1 = $address['address_line1'];
          $node->field_address->postal_code = $address['postal_code'];
        }

        // Apply district taxonomy mappings. Pre-filled fields stay sticky
        // unless the geolocation has moved in this save — a pin-move must
        // trigger re-evaluation so district references follow the new point.
        $districtProperties = $address['district_properties'] ?? [];
        if (!empty($districtProperties)) {
          _markaspot_geocoder_apply_district_mappings($node, $districtProperties, $geocoder_service, $geolocationChanged);
        }

        \Drupal::logger('markaspot_geocoder')->info('Geocoded address for node #@id', ['@id' => $node->id() ?? 'new']);
      }
    }
  }
  catch (\Exception $e) {
    \Drupal::logger('markaspot_geocoder')->error('Fatal error in geocoder: @message at @file:@line', [
      '@message' => $e->getMessage(),
      '@file' => $e->getFile(),
      '@line' => $e->getLine(),
    ]);
  }
}

/**
 * Checks if any configured district mapping fields are empty on the node.
 *
 * @param \Drupal\Core\Entity\EntityInterface $node
 *   The service request node.
 * @param \Drupal\markaspot_geocoder\Service\MarkaspotGeocoderService $geocoder_service
 *   The geocoder service for accessing mapping config.
 *
 * @return bool
 *   TRUE if at least one mapped field is empty.
 */
function _markaspot_geocoder_has_empty_district_fields(EntityInterface $node, MarkaspotGeocoderService $geocoder_service): bool {
  $mappings = $geocoder_service->getDistrictMappings();
  foreach ($mappings as $mapping) {
    $fieldName = $mapping['field'] ?? '';
    if ($fieldName && $node->hasField($fieldName) && $node->get($fieldName)->isEmpty()) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Applies district mapping configuration to a service request node.
 *
 * Iterates over configured district mappings, matches geocoder response
 * properties to taxonomy terms, and sets the corresponding entity reference
 * fields on the node. When the geolocation has changed the mapped fields are
 * re-evaluated even if they are already populated — stale district references
 * bound to the previous pin are the exception we want to overwrite.
 *
 * @param \Drupal\Core\Entity\EntityInterface $node
 *   The service request node.
 * @param array $properties
 *   Raw geocoder properties (e.g. suburb, quarter, city_district).
 * @param \Drupal\markaspot_geocoder\Service\MarkaspotGeocoderService $geocoder_service
 *   The geocoder service for accessing mapping config.
 * @param bool $geolocationChanged
 *   Whether the node's coordinates changed in this save. True enables
 *   re-evaluation of already-populated fields.
 */
function _markaspot_geocoder_apply_district_mappings(EntityInterface $node, array $properties, MarkaspotGeocoderService $geocoder_service, bool $geolocationChanged = FALSE): void {
  $mappings = $geocoder_service->getDistrictMappings();

  if (empty($mappings)) {
    return;
  }

  foreach ($mappings as $mapping) {
    $fieldName = $mapping['field'] ?? '';
    $vocabulary = $mapping['vocabulary'] ?? '';
    $geocoderProperties = $mapping['geocoder_properties'] ?? [];
    $autoCreate = $mapping['auto_create'] ?? FALSE;

    if (empty($fieldName) || empty($vocabulary) || empty($geocoderProperties)) {
      continue;
    }

    if (!$node->hasField($fieldName)) {
      continue;
    }

    // Skip if the field already has a value AND the location has not moved.
    // Manual selections made without a pin-move stay sticky; location changes
    // force a re-evaluation so district references follow the pin.
    if (!$node->get($fieldName)->isEmpty() && !$geolocationChanged) {
      continue;
    }

    // Walk the fallback chain to find a matching property value.
    $matchedValue = NULL;
    foreach ($geocoderProperties as $property) {
      if (!empty($properties[$property])) {
        $matchedValue = $properties[$property];
        break;
      }
    }

    if ($matchedValue === NULL) {
      // Location moved but the new point has no matching property — clear
      // the stale value so the field no longer references the previous pin.
      // Manual selections without a pin-move are protected by the earlier
      // !$geolocationChanged guard and never reach this branch.
      if ($geolocationChanged && !$node->get($fieldName)->isEmpty()) {
        $node->set($fieldName, NULL);
        \Drupal::logger('markaspot_geocoder')->info('Cleared @field: location changed, new geocoder response has no matching property', [
          '@field' => $fieldName,
        ]);
      }
      continue;
    }

    // Look up the taxonomy term by name in the target vocabulary.
    $term = _markaspot_geocoder_find_or_create_term($matchedValue, $vocabulary, $autoCreate);

    if ($term) {
      $node->set($fieldName, ['target_id' => $term->id()]);
      \Drupal::logger('markaspot_geocoder')->info('Mapped @property="@value" to @field (term @tid)', [
        '@property' => implode('|', $geocoderProperties),
        '@value' => $matchedValue,
        '@field' => $fieldName,
        '@tid' => $term->id(),
      ]);
    }
  }
}

/**
 * Finds a taxonomy term by name, optionally creating it.
 *
 * @param string $name
 *   The term name to search for.
 * @param string $vocabulary
 *   The vocabulary machine name.
 * @param bool $autoCreate
 *   Whether to create the term if not found.
 *
 * @return \Drupal\taxonomy\Entity\Term|null
 *   The matched or created term, or NULL.
 */
function _markaspot_geocoder_find_or_create_term(string $name, string $vocabulary, bool $autoCreate): ?Term {
  // Truncate to Drupal's max term name length (255 chars).
  $name = mb_substr(trim($name), 0, 255);
  if ($name === '') {
    return NULL;
  }

  // Try exact match first (efficient, no full vocabulary load).
  $exact = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->loadByProperties([
      'vid' => $vocabulary,
      'name' => $name,
      'status' => 1,
    ]);

  if (!empty($exact)) {
    return reset($exact);
  }

  // Fallback: case-insensitive lookup via database query.
  $tids = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', $vocabulary)
    ->condition('status', 1)
    ->condition('name', $name, 'LIKE')
    ->range(0, 1)
    ->execute();

  if (!empty($tids)) {
    return Term::load(reset($tids));
  }

  if ($autoCreate) {
    $term = Term::create([
      'vid' => $vocabulary,
      'name' => $name,
    ]);
    $term->save();
    \Drupal::logger('markaspot_geocoder')->info('Auto-created term "@name" in vocabulary "@vocab"', [
      '@name' => $name,
      '@vocab' => $vocabulary,
    ]);
    return $term;
  }

  return NULL;
}
