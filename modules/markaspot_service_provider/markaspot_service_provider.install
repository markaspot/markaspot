  if (!$field_instance) {
    $field_values = [
      'langcode' => 'en',
      'status' => TRUE,
      'dependencies' => [
        'config' => [
          'field.storage.taxonomy_term.field_organisation',
          'group.type.org',
          'taxonomy.vocabulary.service_provider',
        ],
        'module' => [
          'group',
        ],
      ],
      'id' => 'taxonomy_term.service_provider.field_organisation',
      'field_name' => 'field_organisation',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'service_provider',
      'label' => 'Organisations',
      'description' => 'Limit this service provider to specific organisations. Leave empty to make the provider available across the jurisdiction.',
