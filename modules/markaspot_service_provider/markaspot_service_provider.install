/**
 * Create field_boilerplates_sp on service requests.
 *
 * The dashboard persists the selected service-provider boilerplate so agents
 * can see which template populated the provider notes.
 */
function _markaspot_service_provider_create_sp_boilerplates_field() {
  if (!\Drupal::entityTypeManager()->getStorage('node_type')->load('boilerplate')) {
    \Drupal::logger('markaspot_service_provider')->warning('Skipped field_boilerplates_sp creation because the boilerplate content type is missing.');
    return;
  }

  $field_storage = FieldStorageConfig::loadByName('node', 'field_boilerplates_sp');
  if (!$field_storage) {
    FieldStorageConfig::create([
      'langcode' => 'en',
      'status' => TRUE,
      'dependencies' => [
        'module' => [
          'field_permissions',
          'node',
        ],
      ],
      'third_party_settings' => [
        'field_permissions' => [
          'permission_type' => 'custom',
        ],
      ],
      'id' => 'node.field_boilerplates_sp',
      'field_name' => 'field_boilerplates_sp',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'node',
      ],
      'module' => 'core',
      'locked' => FALSE,
      'cardinality' => 1,
      'translatable' => FALSE,
      'indexes' => [],
      'persist_with_no_fields' => FALSE,
      'custom_storage' => FALSE,
    ])->save();
    \Drupal::logger('markaspot_service_provider')->notice('Created field_boilerplates_sp field storage on node entity type.');
  }

  $field_instance = FieldConfig::loadByName('node', 'service_request', 'field_boilerplates_sp');
  if (!$field_instance) {
    FieldConfig::create([
      'langcode' => 'en',
      'status' => TRUE,
      'dependencies' => [
        'config' => [
          'field.storage.node.field_boilerplates_sp',
          'node.type.boilerplate',
          'node.type.service_request',
        ],
      ],
      'id' => 'node.service_request.field_boilerplates_sp',
      'field_name' => 'field_boilerplates_sp',
      'entity_type' => 'node',
      'bundle' => 'service_request',
      'label' => 'Service Provider Boilerplate',
      'description' => 'Selected boilerplate used to populate service provider notes.',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [],
      'default_value_callback' => '',
      'settings' => [
        'handler' => 'default:node',
        'handler_settings' => [
          'target_bundles' => [
            'boilerplate' => 'boilerplate',
          ],
          'sort' => [
            'field' => 'title',
            'direction' => 'ASC',
          ],
          'auto_create' => FALSE,
        ],
      ],
      'field_type' => 'entity_reference',
    ])->save();
    \Drupal::logger('markaspot_service_provider')->notice('Created field_boilerplates_sp field instance on service_request content type.');
  }
}

/**
 * Helper function to create field_sp_email field.
 *
 * Creates an email field with unlimited cardinality on service_provider terms.
 */
function _markaspot_service_provider_create_sp_email_field() {
  // Check if field storage already exists.
  $field_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_sp_email');
  if (!$field_storage) {
    $field_storage_values = [
      'langcode' => 'en',
      'status' => TRUE,
      'dependencies' => [
        'module' => [
          'taxonomy',
