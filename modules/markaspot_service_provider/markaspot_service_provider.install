      'translatable' => FALSE,
      'default_value' => [],
      'default_value_callback' => '',
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => [
            'org' => 'org',
          ],
          'sort' => [
            'field' => 'label',
            'direction' => 'ASC',
          ],
          'auto_create' => FALSE,
          'auto_create_bundle' => '',
        ],
      ],
      'field_type' => 'entity_reference',
    ];

    FieldConfig::create($field_values)->save();
    \Drupal::logger('markaspot_service_provider')->notice('Created field_organisation field instance on service_provider vocabulary.');
  }

  // Add field to entity displays if it exists.
  $field_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_organisation');
  $field_instance = FieldConfig::loadByName('taxonomy_term', 'service_provider', 'field_organisation');

  if ($field_storage && $field_instance) {
    /** @var \Drupal\Core\Entity\EntityDisplayRepositoryInterface $display_repo */
    $display_repo = \Drupal::service('entity_display.repository');

    // Add to form display (default).
    $form_display = $display_repo->getFormDisplay('taxonomy_term', 'service_provider', 'default');
    if (!$form_display->getComponent('field_organisation')) {
      $form_display->setComponent('field_organisation', [
        'type' => 'entity_reference_autocomplete',
        'weight' => 2,
        'region' => 'content',
        'settings' => [
          'match_operator' => 'CONTAINS',
          'match_limit' => 10,
          'size' => 60,
          'placeholder' => '',
        ],
        'third_party_settings' => [],
      ])->save();
      \Drupal::logger('markaspot_service_provider')->notice('Added field_organisation to service_provider form display.');
    }

    // Add to view display (default).
    $view_display = $display_repo->getViewDisplay('taxonomy_term', 'service_provider', 'default');
    if (!$view_display->getComponent('field_organisation')) {
      $view_display->setComponent('field_organisation', [
        'type' => 'entity_reference_label',
        'weight' => 2,
        'region' => 'content',
        'label' => 'above',
        'settings' => [
          'link' => TRUE,
        ],
        'third_party_settings' => [],
      ])->save();
      \Drupal::logger('markaspot_service_provider')->notice('Added field_organisation to service_provider view display.');
    }
  }
}

/**
 * Ensure service provider fields are available in the management form mode.
 */
function _markaspot_service_provider_ensure_management_form_mode() {
  $display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.service_request.management');

  if (!$display) {
    return FALSE;
  }

  $changed = FALSE;
  $components = [
    'field_service_provider' => [
      'type' => 'options_select',
      'weight' => 19,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ],
    'field_boilerplates_sp' => [
      'type' => 'entity_reference_autocomplete',
      'weight' => 20,
      'region' => 'content',
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
      'third_party_settings' => [],
    ],
    'field_service_provider_status' => [
      'type' => 'options_select',
      'weight' => 21,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ],
    'field_service_provider_notes' => [
      'type' => 'text_textarea',
      'weight' => 22,
      'region' => 'content',
      'settings' => [
        'rows' => 4,
        'placeholder' => '',
      ],
      'third_party_settings' => [],
    ],
    'field_service_provider_feedback' => [
      'type' => 'text_textarea',
      'weight' => 23,
      'region' => 'content',
      'settings' => [
        'rows' => 4,
        'placeholder' => '',
      ],
      'third_party_settings' => [],
    ],
    'field_sp_attachment' => [
      'type' => 'file_generic',
      'weight' => 24,
      'region' => 'content',
      'settings' => [
        'progress_indicator' => 'throbber',
      ],
      'third_party_settings' => [],
    ],
  ];

  foreach ($components as $field_name => $component) {
    if (!FieldConfig::loadByName('node', 'service_request', $field_name)) {
      continue;
    }
    if ($display->getComponent($field_name)) {
      continue;
    }

    $display->setComponent($field_name, $component);
    $changed = TRUE;
  }

  $field_group_settings = $display->getThirdPartySettings('field_group');
  $service_provider_children = array_values(array_filter(array_keys($components), function ($field_name) {
    return (bool) FieldConfig::loadByName('node', 'service_request', $field_name);
  }));

  if ($service_provider_children) {
    if (!isset($field_group_settings['group_service_provider'])) {
      $field_group_settings['group_service_provider'] = [
        'parent_name' => 'group_administration',
        'children' => $service_provider_children,
        'format_type' => 'details',
        'label' => 'Dienstleister',
        'weight' => 15,
        'format_settings' => [
          'open' => FALSE,
          'required_fields' => TRUE,
        ],
      ];
      $changed = TRUE;
    }
    else {
      $existing_children = $field_group_settings['group_service_provider']['children'] ?? [];
      $merged_children = array_values(array_unique(array_merge($existing_children, $service_provider_children)));
      if ($merged_children !== $existing_children) {
        $field_group_settings['group_service_provider']['children'] = $merged_children;
        $changed = TRUE;
      }
    }

    if (isset($field_group_settings['group_administration'])) {
      $administration_children = $field_group_settings['group_administration']['children'] ?? [];
      if (!in_array('group_service_provider', $administration_children, TRUE)) {
        $administration_children[] = 'group_service_provider';
        $field_group_settings['group_administration']['children'] = $administration_children;
        $changed = TRUE;
      }
    }

    foreach ($field_group_settings as $group_id => $group_settings) {
      $display->setThirdPartySetting('field_group', $group_id, $group_settings);
    }
  }

  if ($changed) {
    $display->save();
  }

  return $changed;
}

/**
 * Ensure field_boilerplates_sp is exposed in JSON:API resource config.
 */
function _markaspot_service_provider_ensure_sp_boilerplates_jsonapi() {
  $config = \Drupal::configFactory()
    ->getEditable('jsonapi_extras.jsonapi_resource_config.node--service_request');
  if ($config->isNew()) {
    return FALSE;
  }

  $resource_fields = $config->get('resourceFields') ?: [];
  $existing_field = $resource_fields['field_boilerplates_sp'] ?? [];

  $resource_fields['field_boilerplates_sp'] = [
    'disabled' => FALSE,
    'fieldName' => 'field_boilerplates_sp',
    'publicName' => 'field_boilerplates_sp',
    'enhancer' => [
      'id' => '',
    ],
  ];
  if ($existing_field === $resource_fields['field_boilerplates_sp']) {
    return FALSE;
  }

  $config->set('resourceFields', $resource_fields)->save(TRUE);

  return TRUE;
}

/**
 * Ensure field_organisation is exposed on the service_provider taxonomy resource.
 *
 * Existing tenants installed the JSON:API resource config before #429 added
 * field_organisation, so the scoped provider fetch silently fell back to a
 * jurisdiction-wide list. Re-expose the field for them.
 */
function _markaspot_service_provider_ensure_sp_organisation_jsonapi() {
  $config = \Drupal::configFactory()
    ->getEditable('jsonapi_extras.jsonapi_resource_config.taxonomy_term--service_provider');
  if ($config->isNew()) {
    return FALSE;
  }

  $resource_fields = $config->get('resourceFields') ?: [];
  $existing_field = $resource_fields['field_organisation'] ?? [];

  $resource_fields['field_organisation'] = [
    'disabled' => FALSE,
    'fieldName' => 'field_organisation',
    'publicName' => 'field_organisation',
    'enhancer' => [
      'id' => '',
    ],
  ];
  if ($existing_field === $resource_fields['field_organisation']) {
    return FALSE;
  }

  $config->set('resourceFields', $resource_fields)->save(TRUE);

  return TRUE;
}

/**
 * Expose org groups so boilerplate organisation references include UUIDs.
 */
function _markaspot_service_provider_ensure_org_group_jsonapi() {
  $config = \Drupal::configFactory()
    ->getEditable('jsonapi_extras.jsonapi_resource_config.group--org');

  $data = [
    'langcode' => 'en',
    'status' => TRUE,
    'dependencies' => [
      'config' => [
        'group.type.org',
      ],
    ],
    'id' => 'group--org',
    'disabled' => FALSE,
    'path' => 'group/org',
    'resourceType' => 'group--org',
    'resourceFields' => _markaspot_service_provider_org_group_jsonapi_resource_fields(),
  ];

  if ($config->isNew()) {
    $config->setData($data)->save(TRUE);
    return TRUE;
  }

  $changed = FALSE;
  foreach (['status', 'disabled', 'path', 'resourceType'] as $key) {
    if ($config->get($key) !== $data[$key]) {
      $config->set($key, $data[$key]);
      $changed = TRUE;
    }
  }
  $resource_fields = $config->get('resourceFields') ?? [];
  $resource_fields = is_array($resource_fields) ? $resource_fields : [];
  $mail_field = $resource_fields['field_head_organisation_e_mail'] ?? [];
  $mail_field = is_array($mail_field) ? $mail_field : [];
  $mail_field += _markaspot_service_provider_org_group_jsonapi_resource_fields()['field_head_organisation_e_mail'];
  $mail_field['disabled'] = TRUE;
  $resource_fields['field_head_organisation_e_mail'] = $mail_field;
  if ($config->get('resourceFields') !== $resource_fields) {
    $config->set('resourceFields', $resource_fields);
    $changed = TRUE;
  }

  if ($changed) {
    $config->save(TRUE);
  }

  return $changed;
}

/**
 * Gets org group JSON:API resource field overrides.
 */
function _markaspot_service_provider_org_group_jsonapi_resource_fields(): array {
  return [
    'field_head_organisation_e_mail' => [
      'disabled' => TRUE,
      'fieldName' => 'field_head_organisation_e_mail',
      'publicName' => 'field_head_organisation_e_mail',
      'enhancer' => [
        'id' => '',
      ],
    ],
  ];
}

/**
 * Remove the internal reassign trigger from the management form mode.
 */
function _markaspot_service_provider_remove_reassign_sp_from_management_form_mode() {
  $display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.service_request.management');

  if (!$display) {
    return FALSE;
  }

  $changed = FALSE;
  if ($display->getComponent('field_reassign_sp')) {
    $display->removeComponent('field_reassign_sp');
    $changed = TRUE;
  }

  $field_group_settings = $display->getThirdPartySettings('field_group');
  foreach ($field_group_settings as $group_id => $group_settings) {
    $children = $group_settings['children'] ?? NULL;
    if (!is_array($children) || !in_array('field_reassign_sp', $children, TRUE)) {
      continue;
    }

    $group_settings['children'] = array_values(array_diff($children, ['field_reassign_sp']));
    $display->setThirdPartySetting('field_group', $group_id, $group_settings);
    $changed = TRUE;
  }

  if ($changed) {
    $display->save();
  }

  return $changed;
}

/**
 * Keep service provider assignment fields out of public request form modes.
 *
 * These fields are managed through the dashboard management form mode. Exposing
 * them through public request form modes makes scoped providers selectable
 * before a service request has an organisation, which the backend correctly
 * rejects.
 */
function _markaspot_service_provider_remove_sp_fields_from_public_form_modes() {
  $changed = FALSE;
  $service_provider_fields = [
    'field_service_provider',
    'field_boilerplates_sp',
    'field_service_provider_status',
    'field_service_provider_notes',
    'field_service_provider_feedback',
    'field_reassign_sp',
    'field_sp_attachment',
  ];

  foreach (['default', 'nuxt'] as $form_mode) {
    $display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load("node.service_request.$form_mode");

    if (!$display) {
      continue;
    }

    $display_changed = FALSE;
    foreach ($service_provider_fields as $field_name) {
      if ($display->getComponent($field_name)) {
        $display->removeComponent($field_name);
        $display_changed = TRUE;
      }
    }

    $field_group_settings = $display->getThirdPartySettings('field_group');
    if (isset($field_group_settings['group_service_provider'])) {
      $display->unsetThirdPartySetting('field_group', 'group_service_provider');
      unset($field_group_settings['group_service_provider']);
      $display_changed = TRUE;
    }

    $removed_children = array_merge(['group_service_provider'], $service_provider_fields);
    foreach ($field_group_settings as $group_id => $group_settings) {
      $children = $group_settings['children'] ?? NULL;
      if (!is_array($children)) {
        continue;
      }

      $filtered_children = array_values(array_diff($children, $removed_children));
      if ($filtered_children === $children) {
        continue;
      }

      $group_settings['children'] = $filtered_children;
      $display->setThirdPartySetting('field_group', $group_id, $group_settings);
      $display_changed = TRUE;
    }

    if ($display_changed) {
      $display->save();
      $changed = TRUE;
    }
  }

  return $changed;
}

/**
 * Update hook to fix field_reassign_sp cardinality from unlimited to 1.
 */
function markaspot_service_provider_update_9001() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $field_storage = $entity_type_manager->getStorage('field_storage_config');

  $field_reassign_sp = $field_storage->load('node.field_reassign_sp');

  if ($field_reassign_sp && $field_reassign_sp->getCardinality() == -1) {
    // Cannot change cardinality if there are existing values
    // Log a warning and provide instructions.
    \Drupal::logger('markaspot_service_provider')->warning('field_reassign_sp has unlimited cardinality but should be 1 (single value). Please manually update the field storage configuration if no data exists, or contact an administrator.');

    return t('The field_reassign_sp field has unlimited cardinality but should be limited to 1. This cannot be automatically changed if data exists. Please review the field configuration.');
  }

  return t('field_reassign_sp field cardinality check completed.');
}

/**
 * Create service_provider vocabulary if missing.
 */
function markaspot_service_provider_update_9002() {
  _markaspot_service_provider_create_vocabulary();
  return t('Ensured service_provider vocabulary exists.');
}

/**
 * Create all required fields if missing.
 */
function markaspot_service_provider_update_9003() {
  $messages = [];

  // Create field_service_provider_notes.
  $field_storage = FieldStorageConfig::loadByName('node', 'field_service_provider_notes');
  if (!$field_storage) {
    _markaspot_service_provider_create_service_provider_notes_field();
    $messages[] = 'Created field_service_provider_notes field.';
  }
  else {
    $messages[] = 'field_service_provider_notes field already exists.';
  }

  // Create field_reassign_sp.
  $field_storage = FieldStorageConfig::loadByName('node', 'field_reassign_sp');
  if (!$field_storage) {
    _markaspot_service_provider_create_reassign_sp_field();
    $messages[] = 'Created field_reassign_sp field.';
  }
  else {
    $messages[] = 'field_reassign_sp field already exists.';
  }

  // Create field_sp_email.
  $field_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_sp_email');
  if (!$field_storage) {
    _markaspot_service_provider_create_sp_email_field();
    $messages[] = 'Created field_sp_email field.';
  }
  else {
    $messages[] = 'field_sp_email field already exists.';
  }

  return implode(' ', $messages);
}

/**
 * Add optional organisation scoping to service provider terms.
 */
function markaspot_service_provider_update_9004() {
  _markaspot_service_provider_create_sp_organisation_field();
  return t('Ensured service_provider terms can be scoped to organisation groups.');
}

/**
 * Move service provider assignment fields out of public request form modes.
 */
function markaspot_service_provider_update_9005() {
  $management_changed = _markaspot_service_provider_ensure_management_form_mode();
  $public_changed = _markaspot_service_provider_remove_sp_fields_from_public_form_modes();

  if ($management_changed || $public_changed) {
    return t('Moved service provider assignment fields to the management form mode.');
  }

  return t('Service provider assignment fields are already limited to the management form mode.');
}

/**
 * Add service-provider boilerplate assignment and hide reassign trigger.
 */
function markaspot_service_provider_update_9006() {
  _markaspot_service_provider_create_sp_boilerplates_field();
  $org_group_jsonapi_changed = _markaspot_service_provider_ensure_org_group_jsonapi();
  $jsonapi_changed = _markaspot_service_provider_ensure_sp_boilerplates_jsonapi();
  $management_changed = _markaspot_service_provider_ensure_management_form_mode();
  $reassign_removed = _markaspot_service_provider_remove_reassign_sp_from_management_form_mode();
  $public_changed = _markaspot_service_provider_remove_sp_fields_from_public_form_modes();

  if ($org_group_jsonapi_changed || $jsonapi_changed || $management_changed || $reassign_removed || $public_changed) {
    return t('Enabled service-provider boilerplates in the management form mode and removed the reassign trigger field from it.');
  }

  return t('Service-provider boilerplate form mode configuration already up to date.');
}

/**
 * Expose field_organisation on the service_provider taxonomy JSON:API resource (#429).
 */
function markaspot_service_provider_update_9007() {
  if (_markaspot_service_provider_ensure_sp_organisation_jsonapi()) {
    return t('Exposed field_organisation on the service_provider taxonomy JSON:API resource so provider org-scoping reaches existing tenants.');
  }

  return t('field_organisation is already exposed on the service_provider taxonomy JSON:API resource.');
}
