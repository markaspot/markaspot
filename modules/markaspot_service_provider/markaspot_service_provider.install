      'entity_type' => 'taxonomy_term',
      'bundle' => 'service_provider',
      'label' => 'Email Address(es)',
      'description' => 'Email addresses for this service provider. Multiple addresses can be added.',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [],
      'default_value_callback' => '',
      'settings' => [],
      'field_type' => 'email',
