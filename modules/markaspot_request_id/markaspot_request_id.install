<?php

/**
 * @file
 * Install, update and uninstall functions for markaspot_request_id module.
 */

/**
 * Implements hook_install().
 */
function markaspot_request_id_install() {
  // Define the initial table schema.
  $schema = [
    'description' => 'Mark-a-Spot request_id',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary Key: Unique request_id serial ID.',
      ],
      'jurisdiction_id' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Root jurisdiction group ID. 0 = single-tenant.',
      ],
      'seq' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Per-jurisdiction sequence number.',
      ],
      'request_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => "The combined request_id.",
      ],
      'uid' => [
        'description' => '{users}.uid for user.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'timestamp' => [
        'description' => 'Timestamp.',
        'type' => 'int',
        'unsigned' => FALSE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'offset' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'Legacy rollover offset.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'jurisdiction_seq' => ['jurisdiction_id', 'seq'],
      'jurisdiction_timestamp' => ['jurisdiction_id', 'timestamp'],
    ],
  ];

  // Create table from schema.
  $connection = \Drupal::database();
  $connection->schema()->createTable('markaspot_request_id', $schema);

  // Query for the last service_request to retrieve last service request.
  $query = \Drupal::entityQuery('node')
    ->condition('type', 'service_request')
    ->accessCheck(FALSE)
    ->sort('nid', 'DESC')
    ->range(0, 1);

  $entity_ids = $query->execute();
  $last_request_nid = reset($entity_ids);
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  // Now load the last service_request and get the last request_id.
  $service_request = $node_storage->load($last_request_nid);
  $last_request_id = '';
  $id = NULL;
  $seq = 0;
  if ($service_request && isset($service_request->request_id->value)) {
    $last_request_id = $service_request->request_id->value;
    $id_parts = explode('-', $last_request_id);
    if (isset($id_parts[0]) && is_numeric($id_parts[0])) {
      $id = (int) $id_parts[0];
      $seq = $id;
    }
  }

  if ($id !== NULL && $last_request_id !== '') {
    try {
      $connection = \Drupal::database();
      $connection->insert('markaspot_request_id')
        ->fields([
          'id' => $id,
          'jurisdiction_id' => 0,
          'seq' => $seq,
          'request_id' => $last_request_id,
        ])
        ->execute();
      \Drupal::logger('markaspot_request_id')
        ->notice("Last Request ID: " . $last_request_id . " saved as initial value to new table.");
    }
    catch (\Exception $e) {
      return FALSE;
    }
  }
}

/**
 * Add a new column to save offset for serial ID rollover.
 */
function markaspot_request_id_update_9600() {
  $schema = \Drupal::database()->schema();
  $schema->addField('markaspot_request_id', 'offset', [
    'type' => 'int',
    'not null' => FALSE,
    'description' => "Offset",
  ]);
}

/**
 * Add jurisdiction_id and seq columns for per-jurisdiction ID sequences.
 *
 * Migrates from global auto-increment to per-jurisdiction sequence tracking.
 * Backfills seq from existing request_id strings and optionally resolves
 * jurisdiction_id from node category terms (multi-tenant dev environments).
 */
function markaspot_request_id_update_11800() {
  $schema = \Drupal::database()->schema();
  $connection = \Drupal::database();
  $messages = [];

  // Add jurisdiction_id column.
  if (!$schema->fieldExists('markaspot_request_id', 'jurisdiction_id')) {
    $schema->addField('markaspot_request_id', 'jurisdiction_id', [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Root jurisdiction group ID. 0 = single-tenant.',
    ]);
    $messages[] = 'Added jurisdiction_id column.';
  }

  // Add seq column.
  if (!$schema->fieldExists('markaspot_request_id', 'seq')) {
    $schema->addField('markaspot_request_id', 'seq', [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Per-jurisdiction sequence number.',
    ]);
    $messages[] = 'Added seq column.';
  }

  // Backfill seq from existing request_id strings.
  $config = \Drupal::config('markaspot_request_id.settings');
  $delimiter = $config->get('delimiter') ?? '-';

  $rows = $connection->select('markaspot_request_id', 'r')
    ->fields('r', ['id', 'request_id'])
    ->condition('seq', 0)
    ->execute()
    ->fetchAll();

  $seqUpdated = 0;
  foreach ($rows as $row) {
    if (empty($row->request_id)) {
      continue;
    }
    $parts = explode($delimiter, $row->request_id);
    $seq = (isset($parts[0]) && is_numeric($parts[0])) ? (int) $parts[0] : 0;
    if ($seq > 0) {
      $connection->update('markaspot_request_id')
        ->fields(['seq' => $seq])
        ->condition('id', $row->id)
        ->execute();
      $seqUpdated++;
    }
  }
  $messages[] = "Backfilled seq on $seqUpdated rows.";

  // Backfill jurisdiction_id from nodes if markaspot_group is installed.
  // Uses SQL instead of entity loading for performance (scales to 100k+ nodes).
  if (\Drupal::moduleHandler()->moduleExists('markaspot_group')) {
    try {
      // Check how many jurisdictions exist.
      $jurisdictions = $connection->select('groups_field_data', 'g')
        ->fields('g', ['id'])
        ->condition('type', 'jur')
        ->execute()
        ->fetchCol();

      $jurCount = count($jurisdictions);

      if ($jurCount === 1) {
        // Single jurisdiction: assign all rows directly, no JOINs needed.
        $jid = (int) reset($jurisdictions);
        $updated = $connection->update('markaspot_request_id')
          ->fields(['jurisdiction_id' => $jid])
          ->condition('jurisdiction_id', 0)
          ->execute();
        $messages[] = "Assigned $updated rows to jurisdiction $jid (single-tenant).";
      }
      elseif ($jurCount > 1) {
        // Multi-tenant: resolve jurisdiction via category term field_jurisdiction.
        // Uses a temporary index on request_id for JOIN performance.
        $hasIndex = FALSE;
        try {
          $connection->query("CREATE INDEX tmp_req_id_backfill ON {node_field_data} (request_id(32))");
          $hasIndex = TRUE;
        }
        catch (\Exception $e) {
          // Index may already exist or request_id column missing.
        }

        $updated = $connection->query("
          UPDATE {markaspot_request_id} rid
          INNER JOIN {node_field_data} nfd ON nfd.request_id = rid.request_id AND nfd.type = 'service_request'
          INNER JOIN {node__field_category} nfc ON nfc.entity_id = nfd.nid
          INNER JOIN {taxonomy_term__field_jurisdiction} ttfj ON ttfj.entity_id = nfc.field_category_target_id
          LEFT JOIN {group__field_parent_jurisdiction} gpj ON gpj.entity_id = ttfj.field_jurisdiction_target_id
          SET rid.jurisdiction_id = COALESCE(gpj.field_parent_jurisdiction_target_id, ttfj.field_jurisdiction_target_id)
          WHERE rid.jurisdiction_id = 0
            AND ttfj.field_jurisdiction_target_id > 0
        ")->rowCount();

        if ($hasIndex) {
          try {
            $connection->query("DROP INDEX tmp_req_id_backfill ON {node_field_data}");
          }
          catch (\Exception $e) {
            // Ignore cleanup errors.
          }
        }
        $messages[] = "Resolved $updated rows across $jurCount jurisdictions (multi-tenant).";
      }
      else {
        $messages[] = 'No jurisdictions found, skipping backfill.';
      }
    }
    catch (\Exception $e) {
      $messages[] = 'Jurisdiction backfill skipped: ' . $e->getMessage();
    }
  }
  else {
    $messages[] = 'markaspot_group not installed, skipping jurisdiction backfill.';
  }

  // Add composite indexes.
  $spec = [
    'fields' => [
      'jurisdiction_id' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'seq' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'timestamp' => [
        'type' => 'int',
        'unsigned' => FALSE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
  ];

  if (!$schema->indexExists('markaspot_request_id', 'jurisdiction_seq')) {
    $schema->addIndex('markaspot_request_id', 'jurisdiction_seq', [
      'jurisdiction_id', 'seq',
    ], $spec);
    $messages[] = 'Added jurisdiction_seq index.';
  }

  if (!$schema->indexExists('markaspot_request_id', 'jurisdiction_timestamp')) {
    $schema->addIndex('markaspot_request_id', 'jurisdiction_timestamp', [
      'jurisdiction_id', 'timestamp',
    ], $spec);
    $messages[] = 'Added jurisdiction_timestamp index.';
  }

  return implode(' ', $messages);
}

/**
 * Add optional request ID prefixes to jurisdiction groups.
 */
function markaspot_request_id_update_11900(): string {
  $messages = [];
  _markaspot_request_id_expand_node_request_id_columns($messages);

  if (!\Drupal::moduleHandler()->moduleExists('group')) {
    $messages[] = 'Skipped request ID prefix field because group module is not installed.';
    return implode(' ', $messages);
  }

  $etm = \Drupal::entityTypeManager();

  try {
    $jur_type = $etm->getStorage('group_type')->load('jur');
  }
  catch (\Exception $e) {
    $messages[] = 'Skipped request ID prefix field because group entity storage is not available.';
    return implode(' ', $messages);
  }

  if (!$jur_type) {
    $messages[] = 'Skipped request ID prefix field because jur group type does not exist.';
    return implode(' ', $messages);
  }

  $field_storage = $etm->getStorage('field_storage_config');
  $storage = $field_storage->load('group.field_request_id_prefix');
  if (!$storage) {
    $storage = $field_storage->create([
      'field_name' => 'field_request_id_prefix',
      'entity_type' => 'group',
      'type' => 'string',
      'settings' => [
        'max_length' => 16,
        'is_ascii' => TRUE,
        'case_sensitive' => FALSE,
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
    ]);
    $storage->save();
    $messages[] = 'Created group.field_request_id_prefix storage.';
  }

  $field_config = $etm->getStorage('field_config');
  if (!$field_config->load('group.jur.field_request_id_prefix')) {
    $field_config->create([
      'field_storage' => $storage,
      'bundle' => 'jur',
      'label' => 'Request ID Prefix',
      'description' => 'Optional uppercase prefix for visible request IDs on multi-jurisdiction servers, for example BONN or AWB. Existing request IDs are not rewritten.',
      'required' => FALSE,
      'translatable' => FALSE,
    ])->save();
    $messages[] = 'Created group.jur.field_request_id_prefix field.';
  }

  $form_display_storage = $etm->getStorage('entity_form_display');
  $form_display = $form_display_storage->load('group.jur.default');
  if (!$form_display) {
    $form_display = $form_display_storage->create([
      'targetEntityType' => 'group',
      'bundle' => 'jur',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }

  if (!$form_display->getComponent('field_request_id_prefix')) {
    $form_display->setComponent('field_request_id_prefix', [
      'type' => 'string_textfield',
      'weight' => 3,
      'region' => 'content',
      'settings' => [
        'size' => 16,
        'placeholder' => 'BONN',
      ],
      'third_party_settings' => [],
    ]);
    $form_display->save();
    $messages[] = 'Added request ID prefix field to the jurisdiction form display.';
  }

  if ($messages === []) {
    return 'Request ID prefix field already exists.';
  }

  return implode(' ', $messages);
}

/**
 * Expands the node request_id storage for prefixed request IDs.
 *
 * Existing installs may already have service request data in node tables. Drupal
 * refuses a generic base-field definition update in that state, but increasing a
 * varchar length from 32 to 64 is a safe in-place schema change.
 *
 * @param array<int, string> $messages
 *   Update-hook status messages.
 */
function _markaspot_request_id_expand_node_request_id_columns(array &$messages): void {
  $schema = \Drupal::database()->schema();
  $column_spec = [
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
    'description' => 'The generated request ID.',
  ];

  $changed = 0;
  $seen = 0;
  $tables = ['node_field_data', 'node_field_revision'];
  foreach ($tables as $table) {
    if (!$schema->tableExists($table) || !$schema->fieldExists($table, 'request_id')) {
      continue;
    }
    $seen++;

    $current_length = _markaspot_request_id_current_varchar_length($table, 'request_id');
    if ($current_length !== NULL && $current_length > 64) {
      $messages[] = "Skipped $table.request_id expansion because it is already wider than 64 characters.";
      continue;
    }
    if ($current_length === 64) {
      $messages[] = "$table.request_id already supports 64 characters.";
      continue;
    }

    $schema->changeField($table, 'request_id', 'request_id', $column_spec);
    $messages[] = "Expanded $table.request_id to 64 characters.";
    $changed++;
  }

  $node_field_definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('node');
  if ($seen === count($tables) && isset($node_field_definitions['request_id'])) {
    \Drupal::service('entity.last_installed_schema.repository')
      ->setLastInstalledFieldStorageDefinition($node_field_definitions['request_id']);
    $messages[] = 'Updated installed schema metadata for node.request_id.';
  }
  elseif ($seen > 0) {
    $messages[] = 'Skipped installed schema metadata for node.request_id because expected storage columns are incomplete.';
  }

  if ($seen === 0) {
    $messages[] = 'Skipped node.request_id column expansion because no storage columns were found.';
  }
}

/**
 * Gets the current varchar length for a database column when available.
 *
 * @param string $table
 *   The Drupal table name without braces.
 * @param string $field
 *   The column name.
 *
 * @return int|null
 *   The varchar length, or NULL when it cannot be detected portably.
 */
function _markaspot_request_id_current_varchar_length(string $table, string $field): ?int {
  $connection = \Drupal::database();
  if ($connection->databaseType() !== 'mysql') {
    return NULL;
  }

  try {
    $length = $connection->query(
      'SELECT CHARACTER_MAXIMUM_LENGTH FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = :table AND COLUMN_NAME = :field',
      [
        ':table' => $connection->prefixTables('{' . $table . '}'),
        ':field' => $field,
      ]
    )->fetchField();
  }
  catch (\Throwable) {
    return NULL;
  }

  return $length === FALSE || $length === NULL ? NULL : (int) $length;
}
