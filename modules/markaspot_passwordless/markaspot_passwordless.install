<?php

/**
 * @file
 * Markaspot Passwordless install, update and uninstall functions.
 */

/**
 * Implements hook_schema().
 */
function markaspot_passwordless_schema() {
  $schema['markaspot_passwordless_codes'] = [
    'description' => 'Stores OTP codes for passwordless authentication.',
    'fields' => [
      'id' => [
        'description' => 'Primary Key: Unique code ID.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'email' => [
        'description' => 'Email address.',
        'type' => 'varchar',
        'length' => 254,
        'not null' => TRUE,
      ],
      'code' => [
        'description' => 'The bcrypt-hashed OTP code.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'attempts' => [
        'description' => 'Number of verification attempts.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'created' => [
        'description' => 'Unix timestamp when code was created.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'expires' => [
        'description' => 'Unix timestamp when code expires.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'verified' => [
        'description' => 'Whether the code has been verified (0=pending, 1=verified, 2=invalidated).',
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'jurisdiction_id' => [
        'description' => 'Jurisdiction group ID this code is bound to. 0 means single-tenant / unscoped. Lookups must filter by this to prevent cross-tenant OTP reuse.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'email' => ['email'],
      'expires' => ['expires'],
      'email_verified' => ['email', 'verified'],
      'verified' => ['verified'],
      'email_jurisdiction_verified' => ['email', 'jurisdiction_id', 'verified', 'created'],
    ],
  ];

  return $schema;
}

/**
 * Install mail template config for translatable verification emails.
 */
function markaspot_passwordless_update_11901() {
  $config = \Drupal::configFactory()->getEditable('markaspot_passwordless.mail');
  if ($config->isNew()) {
    $config
      ->set('langcode', 'en')
      ->set('verification_code', [
        'subject' => '@platform_name: Your verification code',
        'body' => "Your verification code is: @code\n\nThis code will expire in @expires_in minutes.\n\nIf you did not request this code, please ignore this email.\n",
      ])
      ->save();
  }

  // Install German translation.
  $language_manager = \Drupal::languageManager();
  if ($language_manager->getLanguage('de')) {
    $override = $language_manager->getLanguageConfigOverride('de', 'markaspot_passwordless.mail');
    if ($override->isNew()) {
      $override
        ->set('verification_code', [
          'subject' => '@platform_name: Ihr Bestätigungscode',
          'body' => "Ihr Bestätigungscode lautet: @code\n\nDieser Code ist @expires_in Minuten gültig.\n\nFalls Sie diesen Code nicht angefordert haben, können Sie diese E-Mail ignorieren.\n",
        ])
        ->save();
    }
  }
}

/**
 * Install mail template translations for all supported languages.
 */
function markaspot_passwordless_update_11902() {
  $language_manager = \Drupal::languageManager();

  $translations = [
    'nl' => [
      'subject' => '@platform_name: Uw verificatiecode',
      'body' => "Uw verificatiecode is: @code\n\nDeze code verloopt over @expires_in minuten.\n\nAls u deze code niet heeft aangevraagd, kunt u deze e-mail negeren.\n",
    ],
    'fr' => [
      'subject' => '@platform_name: Votre code de vérification',
      'body' => "Votre code de vérification est : @code\n\nCe code expirera dans @expires_in minutes.\n\nSi vous n'avez pas demandé ce code, veuillez ignorer cet e-mail.\n",
    ],
    'es' => [
      'subject' => '@platform_name: Su código de verificación',
      'body' => "Su código de verificación es: @code\n\nEste código caducará en @expires_in minutos.\n\nSi no ha solicitado este código, ignore este correo electrónico.\n",
    ],
    'pt' => [
      'subject' => '@platform_name: O seu código de verificação',
      'body' => "O seu código de verificação é: @code\n\nEste código expira em @expires_in minutos.\n\nSe não solicitou este código, ignore este e-mail.\n",
    ],
    'pl' => [
      'subject' => '@platform_name: Twój kod weryfikacyjny',
      'body' => "Twój kod weryfikacyjny to: @code\n\nTen kod wygaśnie za @expires_in minut.\n\nJeśli nie prosiłeś o ten kod, zignoruj tę wiadomość.\n",
    ],
    'tr' => [
      'subject' => '@platform_name: Doğrulama kodunuz',
      'body' => "Doğrulama kodunuz: @code\n\nBu kodun geçerlilik süresi @expires_in dakikadır.\n\nBu kodu siz talep etmediyseniz, lütfen bu e-postayı dikkate almayın.\n",
    ],
    'ar' => [
      'subject' => '@platform_name: رمز التحقق الخاص بك',
      'body' => "رمز التحقق الخاص بك هو: @code\n\nستنتهي صلاحية هذا الرمز خلال @expires_in دقائق.\n\nإذا لم تطلب هذا الرمز، يرجى تجاهل هذا البريد الإلكتروني.\n",
    ],
    'da' => [
      'subject' => '@platform_name: Din bekræftelseskode',
      'body' => "Din bekræftelseskode er: @code\n\nDenne kode udløber om @expires_in minutter.\n\nHvis du ikke har anmodet om denne kode, kan du ignorere denne e-mail.\n",
    ],
    'sv' => [
      'subject' => '@platform_name: Din verifieringskod',
      'body' => "Din verifieringskod är: @code\n\nDenna kod upphör att gälla om @expires_in minuter.\n\nOm du inte har begärt denna kod kan du ignorera detta e-postmeddelande.\n",
    ],
    'nb' => [
      'subject' => '@platform_name: Din bekreftelseskode',
      'body' => "Din bekreftelseskode er: @code\n\nDenne koden utløper om @expires_in minutter.\n\nHvis du ikke har bedt om denne koden, kan du se bort fra denne e-posten.\n",
    ],
    'fi' => [
      'subject' => '@platform_name: Vahvistuskoodisi',
      'body' => "Vahvistuskoodisi on: @code\n\nTämä koodi vanhenee @expires_in minuutin kuluttua.\n\nJos et pyytänyt tätä koodia, voit jättää tämän sähköpostin huomiotta.\n",
    ],
    'uk' => [
      'subject' => '@platform_name: Ваш код підтвердження',
      'body' => "Ваш код підтвердження: @code\n\nТермін дії цього коду спливає через @expires_in хвилин.\n\nЯкщо ви не запитували цей код, просто проігноруйте цей лист.\n",
    ],
    'it' => [
      'subject' => '@platform_name: Il tuo codice di verifica',
      'body' => "Il tuo codice di verifica è: @code\n\nQuesto codice scadrà tra @expires_in minuti.\n\nSe non hai richiesto questo codice, ignora questa e-mail.\n",
    ],
  ];

  $installed = 0;
  foreach ($translations as $langcode => $strings) {
    if ($language_manager->getLanguage($langcode)) {
      $override = $language_manager->getLanguageConfigOverride($langcode, 'markaspot_passwordless.mail');
      if ($override->isNew()) {
        $override
          ->set('verification_code', $strings)
          ->save();
        $installed++;
      }
    }
  }

  return t('Installed @count mail template translations.', ['@count' => $installed]);
}

/**
 * Widen code column to varchar(255) for bcrypt hashed OTP codes.
 */
function markaspot_passwordless_update_11903() {
  $schema = \Drupal::database()->schema();

  // Drop the email_code index first (it references the code column and
  // is no longer useful since hashed codes cannot be queried directly).
  if ($schema->indexExists('markaspot_passwordless_codes', 'email_code')) {
    $schema->dropIndex('markaspot_passwordless_codes', 'email_code');
  }

  // Widen the code column from varchar(6) to varchar(255) to hold
  // bcrypt hashes (60 chars, but 255 provides future-proofing).
  $schema->changeField('markaspot_passwordless_codes', 'code', 'code', [
    'description' => 'The bcrypt-hashed OTP code.',
    'type' => 'varchar',
    'length' => 255,
    'not null' => TRUE,
  ]);

  // Add email_verified index (replaces email_code which was dropped above).
  if (!$schema->indexExists('markaspot_passwordless_codes', 'email_verified')) {
    $schema->addIndex('markaspot_passwordless_codes', 'email_verified', ['email', 'verified'], [
      'fields' => [
        'email' => [
          'type' => 'varchar',
          'length' => 254,
          'not null' => TRUE,
        ],
        'verified' => [
          'type' => 'int',
          'size' => 'tiny',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
    ]);
  }
}

/**
 * Add email_verified index for sites that already ran update_11903.
 */
function markaspot_passwordless_update_11904() {
  $schema = \Drupal::database()->schema();

  if (!$schema->indexExists('markaspot_passwordless_codes', 'email_verified')) {
    $schema->addIndex('markaspot_passwordless_codes', 'email_verified', ['email', 'verified'], [
      'fields' => [
        'email' => [
          'type' => 'varchar',
          'length' => 254,
          'not null' => TRUE,
        ],
        'verified' => [
          'type' => 'int',
          'size' => 'tiny',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
    ]);
  }
}

/**
 * Bind OTP codes to a jurisdiction to prevent cross-tenant reuse.
 */
function markaspot_passwordless_update_11905() {
  $schema = \Drupal::database()->schema();

  if (!$schema->fieldExists('markaspot_passwordless_codes', 'jurisdiction_id')) {
    $schema->addField('markaspot_passwordless_codes', 'jurisdiction_id', [
      'description' => 'Jurisdiction group ID this code is bound to. 0 means single-tenant / unscoped. Lookups must filter by this to prevent cross-tenant OTP reuse.',
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }

  if (!$schema->indexExists('markaspot_passwordless_codes', 'email_jurisdiction_verified')) {
    $schema->addIndex('markaspot_passwordless_codes', 'email_jurisdiction_verified', ['email', 'jurisdiction_id', 'verified', 'created'], [
      'fields' => [
        'email' => [
          'type' => 'varchar',
          'length' => 254,
          'not null' => TRUE,
        ],
        'jurisdiction_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
        'verified' => [
          'type' => 'int',
          'size' => 'tiny',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
        'created' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
      ],
    ]);
  }

  // Invalidate every pending code that predates the migration. They landed
  // on jurisdiction_id=0 via the column default, and the new SQL filter
  // would otherwise still consume them on the unscoped / single-tenant
  // path. Collapsing the deploy window to zero is defense-in-depth on top
  // of the assertPasswordlessEnabled() gate, which already rejects verify
  // calls that cannot resolve to a passwordless-enabled jurisdiction.
  \Drupal::database()->update('markaspot_passwordless_codes')
    ->fields(['verified' => 2])
    ->condition('verified', 0)
    ->condition('jurisdiction_id', 0)
    ->execute();
}

/**
 * Install Czech passwordless mail translation for existing sites.
 */
function markaspot_passwordless_update_11906() {
  $language_manager = \Drupal::languageManager();

  if (!$language_manager->getLanguage('cs')) {
    return t('Czech language is not installed, skipped passwordless mail translation.');
  }

  $override = $language_manager->getLanguageConfigOverride('cs', 'markaspot_passwordless.mail');
  if (!$override->isNew()) {
    return t('Czech passwordless mail translation already exists.');
  }

  $override
    ->set('verification_code', [
      'subject' => '@platform_name: Váš ověřovací kód',
      'body' => "Váš ověřovací kód je: @code\n\nTento kód vyprší za @expires_in minut.\n\nPokud jste o tento kód nežádali, tento e-mail ignorujte.\n",
    ])
    ->save();

  return t('Installed Czech passwordless mail translation.');
}

/**
 * Repair German passwordless mail copy for existing sites.
 */
function markaspot_passwordless_update_11907() {
  $language_manager = \Drupal::languageManager();

  $base_config = \Drupal::configFactory()->getEditable('markaspot_passwordless.mail');
  $base_mail = $base_config->get('verification_code') ?? [];
  $base_legacy_body = is_string($base_mail['body'] ?? NULL) ? $base_mail['body'] : '';
  $base_defaults = [
    'subject' => '@platform_name: Your verification code',
    'preheader' => 'Your verification code expires in @minutes minutes.',
    'headline' => 'Verify your account',
    'subtext' => 'Enter this code in the next @minutes minutes. If you did not request this, you can ignore this email.',
    'plain_text' => trim($base_legacy_body) !== '' ? $base_legacy_body : "Your verification code: @code\n\nIt expires in @minutes minutes.",
    'body' => "Your verification code is: @code\n\nThis code will expire in @expires_in minutes.\n\nIf you did not request this code, please ignore this email.\n",
  ];
  $base_added = [];
  foreach ($base_defaults as $key => $value) {
    if (empty($base_mail[$key]) || ($key === 'preheader' && $base_mail[$key] === 'Your verification code: @code')) {
      $base_mail[$key] = $value;
      $base_added[] = $key;
    }
  }
  if ($base_added !== []) {
    $base_config->set('verification_code', $base_mail)->save();
  }

  if (!$language_manager->getLanguage('de')) {
    return t('German language is not installed; seeded English OTP mail defaults only.');
  }

  $override = $language_manager->getLanguageConfigOverride('de', 'markaspot_passwordless.mail');
  $mail = $override->get('verification_code') ?? [];
  $de_legacy_body = is_string($mail['body'] ?? NULL) ? $mail['body'] : '';
  $de_defaults = [
    'subject' => '@platform_name: Ihr Bestätigungscode',
    'preheader' => 'Ihr Bestätigungscode ist @minutes Minuten gültig.',
    'headline' => 'Konto bestätigen',
    'subtext' => 'Geben Sie diesen Code innerhalb der nächsten @minutes Minuten ein. Falls Sie den Code nicht angefordert haben, können Sie die E-Mail ignorieren.',
    'plain_text' => trim($de_legacy_body) !== '' ? $de_legacy_body : "Ihr Bestätigungscode: @code\n\nEr läuft in @minutes Minuten ab.",
    'body' => "Ihr Bestätigungscode lautet: @code\n\nDieser Code ist @expires_in Minuten gültig.\n\nFalls Sie diesen Code nicht angefordert haben, können Sie diese E-Mail ignorieren.\n",
  ];
  $de_added = [];
  foreach ($de_defaults as $key => $value) {
    if (empty($mail[$key]) || ($key === 'preheader' && $mail[$key] === 'Ihr Bestätigungscode: @code')) {
      $mail[$key] = $value;
      $de_added[] = $key;
    }
  }
  if ($de_added === []) {
    return t('German passwordless mail copy already complete.');
  }

  $override->set('verification_code', $mail)->save();
  return t('Seeded German passwordless mail copy: @keys.', [
    '@keys' => implode(', ', $de_added),
  ]);
}

/**
 * Re-run the idempotent German mail repair after language setup.
 *
 * Some existing sites ran update 11907 before German was installed. Drupal
 * records that skipped update as complete, so the language override remained
 * absent and passwordless messages fell back to the English base config.
 */
function markaspot_passwordless_update_11908() {
  return markaspot_passwordless_update_11907();
}
