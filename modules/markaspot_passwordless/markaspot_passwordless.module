<?php

/**
 * @file
 * Module file for markaspot_passwordless.
 */

use Drupal\Core\Render\Markup;

/**
 * Implements hook_mail().
 */
function markaspot_passwordless_mail($key, &$message, $params) {
  switch ($key) {
    case 'verification_code':
      $langcode = $message['langcode'] ?? 'en';

      // Load mail config in the message's language.
      $mail_config = \Drupal::languageManager()
        ->getLanguageConfigOverride($langcode, 'markaspot_passwordless.mail')
        ->get($key);

      // Fallback to default language if translation doesn't exist.
      if (empty($mail_config)) {
        $mail_config = \Drupal::config('markaspot_passwordless.mail')->get($key);
      }

      // Token replacements.
      $replacements = [
        '@code' => $params['code'] ?? '',
        '@expires_in' => $params['expires_in'] ?? '10',
        '@platform_name' => $params['platform_name'] ?? 'Mark-a-Spot',
      ];

      $message['subject'] = strtr($mail_config['subject'], $replacements);
      $message['body'][] = strtr($mail_config['body'], $replacements);

      // Append jurisdiction email footer if available.
      if (!empty($params['email_footer'])) {
        $message['body'][] = '--' . "\n" . $params['email_footer'];
      }
      break;
  }
}
