<?php

/**
 * @file
 * Install, update and uninstall functions for markaspot_resubmission module.
 */

use Drupal\Component\Serialization\Yaml;
use Drupal\Core\Config\FileStorage;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\markaspot_resubmission\Entity\ResubmissionReminder;

/**
 * Implements hook_install().
 */
function markaspot_resubmission_install() {
  // Entity schema is auto-created by Drupal for content entities.
  // Create field_resubmission_days on taxonomy_term.service_category.
  _markaspot_resubmission_create_resubmission_days_field();

  \Drupal::messenger()->addStatus(t('Mark-a-Spot Resubmission module installed successfully.'));
}

/**
 * Implements hook_uninstall().
 */
function markaspot_resubmission_uninstall() {
  // Delete all resubmission reminder entities.
  // This is correct: custom entity types created by the module should be
  // cleaned up on uninstall to avoid orphaned data.
  $storage = \Drupal::entityTypeManager()->getStorage('resubmission_reminder');
  $entities = $storage->loadMultiple();

  if (!empty($entities)) {
    $storage->delete($entities);
    \Drupal::logger('markaspot_resubmission')->notice('Deleted @count resubmission reminder records.', [
      '@count' => count($entities),
    ]);
  }

  // Clean up state variables.
  \Drupal::state()->delete('markaspot_resubmission.next_execution');
  \Drupal::state()->delete('markaspot_resubmission.last_category_index');

  // Clean up configuration.
  \Drupal::configFactory()->getEditable('markaspot_resubmission.settings')->delete();
  \Drupal::configFactory()->getEditable('markaspot_resubmission.mail')->delete();

  // Note: We intentionally do NOT delete field_resubmission_days or its data.
  // This follows Drupal best practices: fields are content/data and should
  // be preserved when modules are uninstalled. Site administrators can
  // manually delete fields via the Field UI if desired.
  \Drupal::logger('markaspot_resubmission')->notice('Module uninstalled. Field field_resubmission_days and its data have been preserved.');

  \Drupal::messenger()->addStatus(t('Mark-a-Spot Resubmission module uninstalled. Resubmission reminder entities have been deleted. The field_resubmission_days field and its data have been preserved. To remove the field, use the Field UI at /admin/structure/taxonomy/manage/service_category/overview/fields or run: drush field:delete taxonomy_term.service_category.field_resubmission_days'));
}

/**
 * Implements hook_schema().
 *
 * Note: For content entities, Drupal auto-generates the schema.
 * This is provided for documentation purposes.
 */
function markaspot_resubmission_schema() {
  // Schema is auto-generated from entity field definitions.
  // See ResubmissionReminder::baseFieldDefinitions() for field structure.
  return [];
}

/**
 * Add resubmission reminder tracking table.
 */
function markaspot_resubmission_update_9001() {
  // Install the new entity type.
  \Drupal::entityDefinitionUpdateManager()->installEntityType(
    \Drupal::entityTypeManager()->getDefinition('resubmission_reminder')
  );

  return t('Installed resubmission reminder tracking entity.');
}

/**
 * Add reminder interval configuration to settings.
 */
function markaspot_resubmission_update_9002() {
  $config = \Drupal::configFactory()->getEditable('markaspot_resubmission.settings');

  // Add default reminder interval (7 days) if not set.
  if (!$config->get('reminder_interval')) {
    // 7 days in seconds
    $config->set('reminder_interval', 604800);
  }

  // Add default max reminders (unlimited = 0) if not set.
  if (!$config->get('max_reminders')) {
    $config->set('max_reminders', 0);
  }

  $config->save();

  return t('Added reminder interval configuration settings.');
}

/**
 * Migrate per-category days config to field_resubmission_days on terms.
 */
function markaspot_resubmission_update_9003() {
  $messages = [];

  // Install field storage if it doesn't exist.
  $field_storage_config = \Drupal::configFactory()->getEditable('field.storage.taxonomy_term.field_resubmission_days');
  if ($field_storage_config->isNew()) {
    $field_storage_values = [
      'langcode' => 'en',
      'status' => TRUE,
      'dependencies' => ['module' => ['taxonomy']],
      'id' => 'taxonomy_term.field_resubmission_days',
      'field_name' => 'field_resubmission_days',
      'entity_type' => 'taxonomy_term',
      'type' => 'integer',
      'settings' => [
        'min' => 1,
        'max' => NULL,
        'prefix' => '',
        'suffix' => '',
      ],
      'module' => 'core',
      'locked' => FALSE,
      'cardinality' => 1,
      'translatable' => FALSE,
      'indexes' => [],
      'persist_with_no_fields' => FALSE,
      'custom_storage' => FALSE,
    ];

    FieldStorageConfig::create($field_storage_values)->save();
    $messages[] = t('Created field storage for field_resubmission_days.');
  }

  // Install field on service_category bundle if it doesn't exist.
  $field_config = \Drupal::configFactory()->getEditable('field.field.taxonomy_term.service_category.field_resubmission_days');
  if ($field_config->isNew()) {
    $field_values = [
      'langcode' => 'en',
      'status' => TRUE,
      'dependencies' => [
        'config' => ['field.storage.taxonomy_term.field_resubmission_days'],
        'module' => ['markaspot_resubmission'],
      ],
      'id' => 'taxonomy_term.service_category.field_resubmission_days',
      'field_name' => 'field_resubmission_days',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'service_category',
      'label' => 'Resubmission reminder period (days)',
      'description' => 'Override the default reminder period for this category. Leave empty to use global default (42 days).',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [['value' => 42]],
      'default_value_callback' => '',
      'settings' => [],
      'field_type' => 'integer',
    ];

    FieldConfig::create($field_values)->save();
    $messages[] = t('Created field instance on service_category taxonomy.');
  }

  // Migrate old days configuration to term fields.
  $config = \Drupal::configFactory()->getEditable('markaspot_resubmission.settings');
  $old_days = $config->get('days');

  if (!empty($old_days) && is_array($old_days)) {
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $migrated_count = 0;

    foreach ($old_days as $tid => $days_value) {
      $term = $term_storage->load($tid);
      if ($term && $term->hasField('field_resubmission_days')) {
        // Only set if the field is empty to avoid overwriting manual edits.
        if ($term->get('field_resubmission_days')->isEmpty()) {
          $term->set('field_resubmission_days', (int) $days_value);
          $term->save();
          $migrated_count++;
        }
      }
    }

    $messages[] = t('Migrated @count category reminder periods to term fields.', ['@count' => $migrated_count]);

    // Remove old days config.
    $config->clear('days');
  }

  // Set default_resubmission_days if not already set.
  if (!$config->get('default_resubmission_days')) {
    $config->set('default_resubmission_days', 42);
    $messages[] = t('Set default_resubmission_days to 42 days.');
  }

  $config->save();

  // Add field to form and view displays.
  $field_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_resubmission_days');
  $field_instance = FieldConfig::loadByName('taxonomy_term', 'service_category', 'field_resubmission_days');

  if ($field_storage && $field_instance) {
    /** @var \Drupal\Core\Entity\EntityDisplayRepositoryInterface $display_repo */
    $display_repo = \Drupal::service('entity_display.repository');

    // Add to form display.
    $form_display = $display_repo->getFormDisplay('taxonomy_term', 'service_category', 'default');
    $form_display->setComponent('field_resubmission_days', [
      'type' => 'number',
      'weight' => 10,
      'region' => 'content',
      'settings' => [
        'placeholder' => '',
      ],
    ])->save();

    // Add to view display.
    $view_display = $display_repo->getViewDisplay('taxonomy_term', 'service_category', 'default');
    $view_display->setComponent('field_resubmission_days', [
      'type' => 'number_integer',
      'weight' => 10,
      'region' => 'content',
      'label' => 'above',
      'settings' => [
        'thousand_separator' => '',
        'prefix_suffix' => TRUE,
      ],
    ])->save();

    $messages[] = t('Added field_resubmission_days to entity displays.');
  }

  return implode(' ', $messages);
}

/**
 * Import resubmission reminders view.
 */
function markaspot_resubmission_update_9004() {
  // Import the view configuration.
  \Drupal::service('config.installer')
    ->installOptionalConfig(NULL, ['markaspot_resubmission']);

  // Rebuild menu links.
  \Drupal::service('plugin.manager.menu.link')->rebuild();

  return t('Imported resubmission reminders view configuration.');
}

/**
 * Import mail template configuration for existing installations.
 */
function markaspot_resubmission_update_9005() {
  $messages = [];

  // Get module path.
  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_resubmission');
  $config_path = $module_path . '/config/install';

  // Import English mail config.
  $source = new FileStorage($config_path);
  $config_factory = \Drupal::configFactory();

  if ($data = $source->read('markaspot_resubmission.mail')) {
    $config_factory->getEditable('markaspot_resubmission.mail')
      ->setData($data)
      ->save();
    $messages[] = t('Imported English mail templates.');
  }

  // Import German language overrides if locale module is enabled.
  if (\Drupal::moduleHandler()->moduleExists('locale')) {
    $lang_path = $config_path . '/language/de';
    $lang_source = new FileStorage($lang_path);

    if ($lang_data = $lang_source->read('markaspot_resubmission.mail')) {
      \Drupal::languageManager()
        ->getLanguageConfigOverride('de', 'markaspot_resubmission.mail')
        ->setData($lang_data)
        ->save();
      $messages[] = t('Imported German mail template translations.');
    }
  }

  return !empty($messages) ? implode(' ', $messages) : t('Mail template configuration already up to date.');
}

/**
 * Add reminder scope to reminder audit records and seed scope settings.
 */
function markaspot_resubmission_update_9006(): string {
  $parts = [];
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  if ($update_manager->getFieldStorageDefinition('reminder_scope', 'resubmission_reminder') === NULL) {
    $definition = BaseFieldDefinition::create('list_string')
      ->setLabel(t('Reminder Scope'))
      ->setDescription(t('The recipient scope resolved for this reminder.'))
      ->setSetting('allowed_values', [
        ResubmissionReminder::REMINDER_SCOPE_ORG => t('Organisation'),
        ResubmissionReminder::REMINDER_SCOPE_USER => t('User'),
      ])
      ->setDefaultValue(ResubmissionReminder::REMINDER_SCOPE_ORG)
      ->setInitialValue(ResubmissionReminder::REMINDER_SCOPE_ORG)
      ->setRequired(TRUE);

    $update_manager->installFieldStorageDefinition('reminder_scope', 'resubmission_reminder', 'markaspot_resubmission', $definition);
    $parts[] = 'Installed reminder_scope field storage.';
  }

  $config = \Drupal::configFactory()->getEditable('markaspot_resubmission.settings');
  if ($config->get('default_reminder_scope') === NULL) {
    $config->set('default_reminder_scope', ResubmissionReminder::REMINDER_SCOPE_ORG);
    $config->save(TRUE);
    $parts[] = 'Seeded default_reminder_scope=org.';
  }

  return $parts !== []
    ? implode(' ', $parts)
    : (string) t('Reminder scope field and settings already present.');
}

/**
 * Adds runtime citizen-wording placeholders to untouched reminder templates.
 *
 * Existing active mail configuration must be migrated from the prior shipped
 * report/Meldung templates, but only when it matches an exact known default.
 * The German install update historically wrote both a config shape with and
 * without langcode, so both are recognized and their original shape is kept.
 * Tenant-authored subjects and bodies are never modified.
 */
function markaspot_resubmission_update_9007(): string {
  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_resubmission');
  $config_factory = \Drupal::configFactory();
  $parts = [];

  $replacement = _markaspot_resubmission_shipped_mail_template($module_path, 'en', TRUE);
  $config = $config_factory->getEditable('markaspot_resubmission.mail');
  if ($replacement === NULL || $config->isNew()) {
    $parts[] = 'English reminder template unavailable; no change';
  }
  elseif ($config->getRawData() === _markaspot_resubmission_legacy_mail_template('en', TRUE)) {
    $config->setData($replacement)->save();
    $parts[] = 'English reminder template migrated';
  }
  elseif ($config->getRawData() === $replacement) {
    $parts[] = 'English reminder template already current';
  }
  else {
    $parts[] = 'English reminder template customized; preserved';
  }

  $language_manager = \Drupal::languageManager();
  if (!in_array('de', array_keys($language_manager->getLanguages()), TRUE)) {
    $parts[] = 'German reminder override unavailable; no change';
    return implode('; ', $parts) . '.';
  }

  $replacement_with_langcode = _markaspot_resubmission_shipped_mail_template($module_path, 'de', TRUE);
  if ($replacement_with_langcode === NULL) {
    $parts[] = 'German shipped reminder template unavailable; no change';
    return implode('; ', $parts) . '.';
  }
  $replacement_without_langcode = $replacement_with_langcode;
  unset($replacement_without_langcode['langcode']);

  $override = $language_manager->getLanguageConfigOverride('de', 'markaspot_resubmission.mail');
  $current = $override->getRawData();
  if ($current === _markaspot_resubmission_legacy_mail_template('de', TRUE)) {
    $override->setData($replacement_with_langcode)->save();
    $parts[] = 'German reminder template migrated';
  }
  elseif ($current === _markaspot_resubmission_legacy_mail_template('de', FALSE)) {
    $override->setData($replacement_without_langcode)->save();
    $parts[] = 'German reminder template migrated';
  }
  elseif ($current === $replacement_with_langcode || $current === $replacement_without_langcode) {
    $parts[] = 'German reminder template already current';
  }
  else {
    $parts[] = 'German reminder template customized or absent; preserved';
  }

  return implode('; ', $parts) . '.';
}

/**
 * Reads a shipped resubmission mail config in base or override data shape.
 *
 * @return array<string, mixed>|null
 *   The decoded config or NULL when the shipped file is unreadable.
 */
function _markaspot_resubmission_shipped_mail_template(string $module_path, string $langcode, bool $keep_langcode): ?array {
  $path = $langcode === 'de'
    ? $module_path . '/config/install/language/de'
    : $module_path . '/config/install';
  $data = (new FileStorage($path))->read('markaspot_resubmission.mail');
  if (!is_array($data)) {
    return NULL;
  }
  if (!$keep_langcode) {
    unset($data['langcode']);
  }
  return $data;
}

/**
 * Returns the exact templates shipped before update 9007.
 *
 * @return array<string, mixed>
 *   Base config data or one of the two historical German override shapes.
 */
function _markaspot_resubmission_legacy_mail_template(string $langcode, bool $with_langcode): array {
  $yaml = $langcode === 'de'
    ? <<<'YAML'
langcode: de
resubmit_request:
  subject: 'Erinnerung: [node:title]'
  body: |
    Guten Tag,

    diese Meldung wurde vor mehr als 6 Wochen in unserem System erfasst und ist noch unbearbeitet:

    Titel: [node:title]
    Kategorie: [node:field_category:entity:name]
    Status: [node:field_status:entity:name]
    Gemeldet am: [node:created:medium]
    Letzte Änderung: [node:changed:medium]

    Link zur Meldung: [node:url]

    Bitte prüfen Sie den Status dieser Meldung und aktualisieren Sie diese entsprechend.

    Mit freundlichen Grüßen
    Ihr Mängelmelder-Team

YAML
    : <<<'YAML'
langcode: en
resubmit_request:
  subject: 'Reminder: [node:title]'
  body: |
    Hello,

    This report was submitted more than 6 weeks ago and is still unprocessed in our system:

    Title: [node:title]
    Category: [node:field_category:entity:name]
    Status: [node:field_status:entity:name]
    Reported on: [node:created:medium]
    Last changed: [node:changed:medium]

    Link to report: [node:url]

    Please review the status of this report and update it accordingly.

    Best regards,
    Your Issue Tracking Team

YAML;
  $data = Yaml::decode($yaml);
  if (!is_array($data)) {
    return [];
  }
  if (!$with_langcode) {
    unset($data['langcode']);
  }
  return $data;
}

/**
 * Helper function to create field_resubmission_days field.
 *
 * Used by both hook_install() and update hook 9003.
 */
function _markaspot_resubmission_create_resubmission_days_field() {
  // Check if field storage already exists.
  $field_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_resubmission_days');
  if (!$field_storage) {
    $field_storage_values = [
      'langcode' => 'en',
      'status' => TRUE,
      'dependencies' => ['module' => ['taxonomy']],
      'id' => 'taxonomy_term.field_resubmission_days',
      'field_name' => 'field_resubmission_days',
      'entity_type' => 'taxonomy_term',
      'type' => 'integer',
      'settings' => [
        'min' => 1,
        'max' => NULL,
        'prefix' => '',
        'suffix' => '',
      ],
      'module' => 'core',
      'locked' => FALSE,
      'cardinality' => 1,
      'translatable' => FALSE,
      'indexes' => [],
      'persist_with_no_fields' => FALSE,
      'custom_storage' => FALSE,
    ];

    FieldStorageConfig::create($field_storage_values)->save();
  }

  // Check if field instance already exists.
  $field_instance = FieldConfig::loadByName('taxonomy_term', 'service_category', 'field_resubmission_days');
  if (!$field_instance) {
    $field_values = [
      'langcode' => 'en',
      'status' => TRUE,
      'dependencies' => [
        'config' => ['field.storage.taxonomy_term.field_resubmission_days'],
        'module' => ['markaspot_resubmission'],
      ],
      'id' => 'taxonomy_term.service_category.field_resubmission_days',
      'field_name' => 'field_resubmission_days',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'service_category',
      'label' => 'Resubmission reminder period (days)',
      'description' => 'Override the default reminder period for this category. Leave empty to use global default (42 days).',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [['value' => 42]],
      'default_value_callback' => '',
      'settings' => [],
      'field_type' => 'integer',
    ];

    FieldConfig::create($field_values)->save();
  }

  // Add field to entity displays if it exists.
  $field_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_resubmission_days');
  $field_instance = FieldConfig::loadByName('taxonomy_term', 'service_category', 'field_resubmission_days');

  if ($field_storage && $field_instance) {
    /** @var \Drupal\Core\Entity\EntityDisplayRepositoryInterface $display_repo */
    $display_repo = \Drupal::service('entity_display.repository');

    // Add to form display.
    $form_display = $display_repo->getFormDisplay('taxonomy_term', 'service_category', 'default');
    if (!$form_display->getComponent('field_resubmission_days')) {
      $form_display->setComponent('field_resubmission_days', [
        'type' => 'number',
        'weight' => 10,
        'region' => 'content',
        'settings' => [
          'placeholder' => '',
        ],
      ])->save();
    }

    // Add to view display.
    $view_display = $display_repo->getViewDisplay('taxonomy_term', 'service_category', 'default');
    if (!$view_display->getComponent('field_resubmission_days')) {
      $view_display->setComponent('field_resubmission_days', [
        'type' => 'number_integer',
        'weight' => 10,
        'region' => 'content',
        'label' => 'above',
        'settings' => [
          'thousand_separator' => '',
          'prefix_suffix' => TRUE,
        ],
      ])->save();
    }
  }

  // Set default_resubmission_days in config if not already set.
  $config = \Drupal::configFactory()->getEditable('markaspot_resubmission.settings');
  if (!$config->get('default_resubmission_days')) {
    $config->set('default_resubmission_days', 42);
    $config->save();
  }
}

/**
 * Helper function to delete field_resubmission_days field.
 *
 * DEPRECATED: This function is no longer called by hook_uninstall().
 * Fields should be preserved when modules are uninstalled, following
 * Drupal best practices. Site administrators can manually delete fields
 * via the Field UI if desired.
 *
 * Kept for reference only.
 */
function _markaspot_resubmission_delete_resubmission_days_field() {
  // Delete the field instance first.
  $field_instance = FieldConfig::loadByName('taxonomy_term', 'service_category', 'field_resubmission_days');
  if ($field_instance) {
    $field_instance->delete();
    \Drupal::logger('markaspot_resubmission')->notice('Deleted field_resubmission_days field instance from service_category taxonomy.');
  }

  // Delete the field storage.
  // Note: Field storage should only be deleted if no other bundles use it.
  $field_storage = FieldStorageConfig::loadByName('taxonomy_term', 'field_resubmission_days');
  if ($field_storage) {
    $field_storage->delete();
    \Drupal::logger('markaspot_resubmission')->notice('Deleted field_resubmission_days field storage from taxonomy_term entity type.');
  }

  // Purge field data from database tables.
  field_purge_batch(100);
}
