<?php

/**
 * @file
 * Contains service_request.module.
 *
 * This is a content type to run an georeport v2 server.
 */

use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Implements hook_node_presave().
 */
function service_request_node_presave(EntityInterface $node) {
  if ($node->bundle() !== 'service_request') {
    return;
  }

  _service_request_sanitize_address($node);
  _service_request_normalize_intake_metadata($node);

  // Enforce the configured default language for new service requests.
  // This respects the Drupal content type language settings:
  // Structure > Content types > Service Request > Language settings
  // Recommended: "Not specified" (und) for language-neutral citizen content.
  // This overrides any langcode provided by API clients (JSON:API, GeoReport).
  if ($node->isNew()) {
    $language_settings = \Drupal::config('language.content_settings.node.service_request');
    $default_langcode = $language_settings->get('default_langcode');

    if ($default_langcode === 'und') {
      $node->set('langcode', 'und');
    }
    elseif ($default_langcode === 'site_default') {
      $site_default = \Drupal::languageManager()->getDefaultLanguage()->getId();
      $node->set('langcode', $site_default);
    }
    elseif ($default_langcode && $default_langcode !== 'current_interface') {
      // Explicit language code (e.g., 'de', 'en').
      $node->set('langcode', $default_langcode);
    }
    // 'current_interface' is left as-is (Drupal default behavior).
  }

  $config = \Drupal::configFactory()->get('markaspot_open311.settings');
  $auto_create = $config->get('status_note_auto_create') ?? TRUE;

  // Service Request Creation.
  if (!$node->id()) {
    _service_request_handle_creation($node, $config, $auto_create);
  }
  // Service Request Update.
  else {
    _service_request_handle_update($node, $config, $auto_create);
  }
}

/**
 * Strips markup from citizen-supplied address components before persistence.
 *
 * Anonymous users can write field_address through both the Open311 API and
 * JSON:API. The Open311 parser sanitizes its own path, but a direct JSON:API
 * write reaches field_address unfiltered. Running on every save
 * closes every entry point at once, including future ones. Address
 * components are plain text, so any tag is dropped rather than escaped.
 *
 * Hook order relative to markaspot_geocoder_node_presave() is irrelevant:
 * the geocoder only ever writes clean provider data, so the stored value is
 * markup-free whether this runs before or after it. country_code is left to
 * the address module's country constraint.
 */
function _service_request_sanitize_address(EntityInterface $node): void {
  if (!$node instanceof FieldableEntityInterface
    || !$node->hasField('field_address')
    || $node->get('field_address')->isEmpty()) {
    return;
  }

  $item = $node->get('field_address')->first();
  // Sanitize every free-text address component that was set. country_code is
  // an enum guarded by the address module's country constraint and left
  // untouched. Iterating the value array covers every property a client can
  // submit (including name fields via JSON:API) without a hardcoded list.
  // Entities are decoded before stripping so encoded markup ("&lt;img&gt;")
  // is caught too, matching the Open311 addressParser() sanitizer.
  foreach ($item->getValue() as $property => $value) {
    if ($property === 'country_code' || !is_string($value) || $value === '') {
      continue;
    }
    $clean = trim(strip_tags(html_entity_decode($value, ENT_QUOTES, 'UTF-8')));
    if ($clean !== $value) {
      $item->{$property} = $clean;
    }
  }
}

/**
 * Normalizes request source/channel metadata on every service_request save.
 */
function _service_request_normalize_intake_metadata(EntityInterface $node): void {
  $account = \Drupal::currentUser();
  $is_dashboard_staff = $account->hasPermission('manage dashboard notes')
    || $account->hasPermission('administer nodes');
  $can_set_source = $is_dashboard_staff
    || $account->hasPermission('update open311 plus all properties');

  if ($node->hasField('field_source')) {
    $source = (string) ($node->get('field_source')->value ?? '');
    if ($node->isNew() && $is_dashboard_staff) {
      $node->set('field_source', 'staff');
    }
    elseif (!$can_set_source && $source !== '') {
      $node->set('field_source', 'web');
    }
  }

  if (!$node->hasField('field_request_attributes') || $node->get('field_request_attributes')->isEmpty()) {
    return;
  }

  $raw = (string) ($node->get('field_request_attributes')->value ?? '');
  $attributes = json_decode($raw, TRUE);
  if (!is_array($attributes)) {
    return;
  }

  $changed = FALSE;
  if (!$is_dashboard_staff && array_key_exists('_markaspot_channel', $attributes)) {
    unset($attributes['_markaspot_channel']);
    $changed = TRUE;
  }
  elseif ($is_dashboard_staff && $node->isNew() && ($attributes['_markaspot_channel'] ?? NULL) !== 'staff') {
    $attributes['_markaspot_channel'] = 'staff';
    $changed = TRUE;
  }

  if ($changed) {
    $node->set('field_request_attributes', $attributes === [] ? NULL : json_encode($attributes));
  }
}

/**
 * Handles status note creation for new service requests.
 */
function _service_request_handle_creation(EntityInterface $node, $config, bool $auto_create): void {
  $status_open_start = $config->get('status_open_start');

  // Always set initial status if not already set.
  // Note: markaspot_group_node_presave may have already set a
  // jurisdiction-specific initial status. Only fall back to config default
  // when the field is still empty.
  if ($node->field_status->isEmpty()) {
    $node->field_status = [
      ['target_id' => $status_open_start],
    ];
  }

  // Skip status note creation if disabled or already added by frontend/API.
  if (!$auto_create || !$node->field_status_notes->isEmpty()) {
    return;
  }

  // Use the node's actual status TID for the paragraph (may have been set
  // by markaspot_group to a jurisdiction-specific value).
  $actual_status_tid = (int) $node->get('field_status')->target_id;

  /** @var \Drupal\markaspot_open311\Service\GeoreportProcessorServiceInterface $processor */
  $processor = \Drupal::service('markaspot_open311.processor');
  $langcode = _service_request_status_note_default_langcode();

  // Resolve jurisdiction from category for boilerplate lookup.
  $boilerplate_id = NULL;
  if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $category_term = $node->get('field_category')->entity;
    if ($category_term && $category_term->hasField('field_jurisdiction')
        && !$category_term->get('field_jurisdiction')->isEmpty()) {
      $jur_id = (int) $category_term->get('field_jurisdiction')->target_id;
      $boilerplate_id = $processor->getInitialBoilerplateId($jur_id);
    }
  }

  $fields = ['status_term_id' => $actual_status_tid];
  if ($boilerplate_id) {
    $fields['boilerplate_id'] = $boilerplate_id;
  }
  // Falls back to status term description, then t() string if all empty.
  $paragraph = $processor->createStatusNoteParagraph($fields, $langcode);
  if ($paragraph->get('field_status_note')->isEmpty()) {
    $paragraph->set('field_status_note', [
      'value' => t('The service request has been created.', [], ['langcode' => $langcode]),
      'format' => 'plain_text',
    ]);
    $paragraph->save();
  }

  $node->field_status_notes = [
    [
      'target_id' => $paragraph->id(),
      'target_revision_id' => $paragraph->getRevisionId(),
    ],
  ];
}

/**
 * Returns the language for system-generated status note fallback text.
 */
function _service_request_status_note_default_langcode(): string {
  return \Drupal::languageManager()->getDefaultLanguage()->getId();
}

/**
 * Handles status note creation for updated service requests.
 */
function _service_request_handle_update(EntityInterface $node, $config, bool $auto_create): void {
  if (!$auto_create) {
    return;
  }

  $newStatus = $node->field_status->target_id;
  $original = $node->original;
  $originalStatus = $original ? $original->field_status->target_id : NULL;

  // Only process if status has actually changed.
  if (!$newStatus || !$originalStatus || $newStatus === $originalStatus) {
    return;
  }

  // Check if frontend/API already added a status note for this change.
  if (!$node->field_status_notes->isEmpty()) {
    $lastParagraph = $node->field_status_notes->last()->entity;
    if ($lastParagraph && $lastParagraph->hasField('field_status_term')) {
      $lastParagraphStatus = $lastParagraph->field_status_term->target_id;

      // Skip if last paragraph already has the new status.
      if ($lastParagraphStatus == $newStatus) {
        return;
      }

      // Skip if paragraph was just created (within 5 seconds).
      // This prevents duplicates when frontend sends status note with update.
      $isRecentlyCreated = $lastParagraph->isNew() ||
        (time() - $lastParagraph->getCreatedTime() < 5);
      if ($isRecentlyCreated) {
        return;
      }
    }
  }

  /** @var \Drupal\markaspot_open311\Service\GeoreportProcessorServiceInterface $processor */
  $processor = \Drupal::service('markaspot_open311.processor');

  // Use the site default language rather than the node language. Node
  // language is unreliable for tenant content — legacy/imported nodes
  // may be tagged 'en' on a German-only tenant, in which case
  // t('Status changed.', langcode: 'en') resolves to the English source
  // and surfaces in citizen mails as untranslated text.
  $languageManager = \Drupal::languageManager();
  $defaultLangcode = $languageManager->getDefaultLanguage()->getId();

  // Note is omitted so the factory uses the status term's description.
  // Falls back to t() string if term description is empty.
  $paragraph = $processor->createStatusNoteParagraph([
    'status_term_id' => $newStatus,
  ], $defaultLangcode);
  if ($paragraph->get('field_status_note')->isEmpty()) {
    $paragraph->set('field_status_note', [
      'value' => t('Status changed.', [], ['langcode' => $defaultLangcode]),
      'format' => 'plain_text',
    ]);
  }

  // Add translations for every other enabled language so that
  // [node:latest_status_note] renders localized in citizen mails
  // regardless of recipient language. Falls back to the localized t()
  // string when the status term has no description in that language.
  foreach ($languageManager->getLanguages() as $lang) {
    $lc = $lang->getId();
    if ($lc === $defaultLangcode || $paragraph->hasTranslation($lc)) {
      continue;
    }
    $translation = $paragraph->addTranslation($lc, $paragraph->toArray());
    $translation->set('field_status_note', [
      'value' => _service_request_resolve_status_note_text((int) $newStatus, $lc),
      'format' => 'plain_text',
    ]);
  }
  $paragraph->save();

  $node->field_status_notes->appendItem([
    'target_id' => $paragraph->id(),
    'target_revision_id' => $paragraph->getRevisionId(),
  ]);
}

/**
 * Resolves a status note body for a given status term + langcode.
 *
 * Prefers the status term's description in the requested language. Falls back
 * to the localized t() string "Status changed." when the term has no
 * description for that language. Keeps the multilingual status-note path
 * out of GeoreportProcessorService's private helpers.
 *
 * @param int $termId
 *   The taxonomy term ID of the new status.
 * @param string $langcode
 *   Target language code.
 *
 * @return string
 *   Localized status note body (plain text).
 */
function _service_request_resolve_status_note_text(int $termId, string $langcode): string {
  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($termId);
  if ($term) {
    if ($langcode === 'und') {
      $langcode = \Drupal::languageManager()->getDefaultLanguage()->getId();
    }
    if ($term->hasTranslation($langcode)) {
      $term = $term->getTranslation($langcode);
    }
    $description = $term->getDescription();
    if (!empty($description)) {
      return strip_tags($description);
    }
  }
  return (string) t('Status changed.', [], ['langcode' => $langcode]);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * Registers an entity builder that derives every newly added status-note
 * paragraph's field_status_term from the node's field_status. This replaces
 * the former client-side JS that synced the node status radios with the
 * paragraph subform select; the JS was needed only until Paragraphs 8.x-1.3
 * exposed #paragraph_type on widget elements
 * (https://www.drupal.org/project/paragraphs/issues/2868155). Scoped to the
 * service_request node add/edit forms instead of altering every form.
 */
function service_request_form_node_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }

  $node = $form_object->getEntity();
  if (!$node instanceof NodeInterface || $node->bundle() !== 'service_request') {
    return;
  }

  $form['#entity_builders'][] = '_service_request_derive_status_paragraph_terms';
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 *
 * Hides the field_status_term select inside status-note paragraph subforms.
 * The term is a derived value set server-side from the node's field_status by
 * the entity builder registered in service_request_form_node_form_alter(), so
 * it must not be edited by hand. Paragraphs >= 8.x-1.3 exposes the paragraph
 * bundle on the widget element as #paragraph_type. Existing notes keep their
 * stored term because a hidden (#access FALSE) widget retains its default.
 */
function service_request_field_widget_single_element_form_alter(array &$element, FormStateInterface $form_state, array $context) {
  if (($element['#paragraph_type'] ?? NULL) !== 'status') {
    return;
  }

  if (isset($element['subform']['field_status_term'])) {
    $element['subform']['field_status_term']['#access'] = FALSE;
  }
}

/**
 * Entity builder: derives status-note paragraph terms from the node status.
 *
 * Runs after the node form (including its ParagraphsWidget-built status-note
 * paragraphs) is assembled but before save. Only paragraphs added on this
 * submission (isNew()) are touched, so historical notes keep the status they
 * recorded at the time.
 *
 * @param string $entity_type_id
 *   The node entity type ID.
 * @param \Drupal\Core\Entity\EntityInterface $node
 *   The service_request node being built from the form.
 * @param array $form
 *   The node form structure.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current form state.
 */
function _service_request_derive_status_paragraph_terms(string $entity_type_id, EntityInterface $node, array &$form, FormStateInterface $form_state): void {
  if (!$node instanceof FieldableEntityInterface) {
    return;
  }
  if (!$node->hasField('field_status') || $node->get('field_status')->isEmpty()) {
    return;
  }
  if (!$node->hasField('field_status_notes')) {
    return;
  }

  $status_tid = (int) $node->get('field_status')->target_id;
  foreach ($node->get('field_status_notes') as $item) {
    $paragraph = $item->entity;
    if ($paragraph instanceof ParagraphInterface
      && $paragraph->isNew()
      && $paragraph->bundle() === 'status'
      && $paragraph->hasField('field_status_term')) {
      $paragraph->set('field_status_term', $status_tid);
    }
  }
}
