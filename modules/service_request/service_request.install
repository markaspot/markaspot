/**
 * Add field_sublocality_terms to the organisation (org) group bundle.
 *
 * This entity_reference field lists the sublocality (Stadtteil) terms an
 * organisation handles. It backs the
 * service_request_assign_organisation_from_sublocality action, which derives
 * the responsible organisation from the geocoded node sublocality.
 *
 * On fresh installs the field ships via config/optional. This hook backfills
 * already-installed tenants. It is guarded so it is a no-op when the group
 * entity type, the org bundle, or the sublocality vocabulary are absent, and
 * it is idempotent (skips creation when the field already exists).
 */
function service_request_update_11017(): string {
  $messages = [];

  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('group')) {
    return 'Group entity type not available, skipped field_sublocality_terms.';
  }

  // Require the org group bundle.
  $group_types = $entity_type_manager->getStorage('group_type')->loadMultiple();
  if (!isset($group_types['org'])) {
    return 'Group bundle "org" not available, skipped field_sublocality_terms.';
  }

  // Require the sublocality vocabulary.
  if (!\Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary')->load('sublocality')) {
    return 'Vocabulary "sublocality" not available, skipped field_sublocality_terms.';
  }

  // 1. Create field storage if missing.
  if (!FieldStorageConfig::loadByName('group', 'field_sublocality_terms')) {
    FieldStorageConfig::create([
      'field_name' => 'field_sublocality_terms',
      'entity_type' => 'group',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'taxonomy_term',
      ],
      'cardinality' => -1,
      'translatable' => TRUE,
    ])->save();
    $messages[] = 'Created field storage: group.field_sublocality_terms';
  }

  // 2. Create field instance on the org bundle if missing.
  if (!FieldConfig::loadByName('group', 'org', 'field_sublocality_terms')) {
    FieldConfig::create([
      'field_name' => 'field_sublocality_terms',
      'entity_type' => 'group',
      'bundle' => 'org',
      'label' => 'Sublocalities',
      'description' => 'The sublocalities (Stadtteile) this organisation handles. Used for jurisdiction-aware org derivation from the geocoded sublocality.',
      'required' => FALSE,
      'translatable' => TRUE,
      'default_value' => [],
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => [
            'sublocality' => 'sublocality',
          ],
          'sort' => [
            'field' => 'name',
            'direction' => 'ASC',
          ],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
    $messages[] = 'Created field instance: group.org.field_sublocality_terms';
  }

  return empty($messages) ? 'field_sublocality_terms already exists.' : implode("\n", $messages);
}

/**
 * Enable new revisions by default on the service_request content type.
 *
 * The dashboard edits service requests via JSON:API PATCH (not the GeoReport
 * PUT). Whether those edits create a new revision — and whether the editing
 * user is recorded as the revision author — depends on the bundle's
 * new_revision default. With it disabled, "last edited by" would always show
 * the original creator instead of the actual editor.
 *
 * Fresh installs already ship new_revision = true via config/install. This
 * hook backfills already-installed tenants. It is guarded and idempotent:
 * a no-op when the content type is missing or already set to true.
 */
function service_request_update_11018(): string {
  $config = \Drupal::configFactory()->getEditable('node.type.service_request');

  if (!$config || $config->isNew()) {
    return 'node.type.service_request config not found, nothing to do.';
  }

  if ($config->get('new_revision') === TRUE) {
    return 'node.type.service_request already creates new revisions by default.';
  }

  $config->set('new_revision', TRUE)->save(TRUE);

  return 'Enabled new_revision on node.type.service_request so dashboard edits record the editing user.';
}

/**
 * Localizes existing initial status note fallback text.
 */
function service_request_update_11019(): string {
  $messages = [_service_request_import_shipped_translations()];
  $source = 'The service request has been created.';
  $langcode = \Drupal::languageManager()->getDefaultLanguage()->getId();
  $translated = (string) t('The service request has been created.', [], ['langcode' => $langcode]);

  if ($translated === $source) {
    $messages[] = 'No localized initial status note available for default language ' . $langcode . '.';
    return implode("\n", $messages);
  }

  $current_ids = _service_request_initial_status_note_row_ids(
    'paragraph__field_status_note',
    'node__field_status_notes',
    'field_status_notes_target_id',
    'entity_id',
    $source
  );
  $revision_ids = _service_request_initial_status_note_row_ids(
    'paragraph_revision__field_status_note',
    'node_revision__field_status_notes',
    'field_status_notes_target_revision_id',
    'revision_id',
    $source
  );

  $updated = _service_request_localize_status_note_rows(
    'paragraph__field_status_note',
    'entity_id',
    $current_ids,
    $source,
    $translated
  );
  $updated += _service_request_localize_status_note_rows(
    'paragraph_revision__field_status_note',
    'revision_id',
    $revision_ids,
    $source,
    $translated
  );

  $messages[] = sprintf(
    'Localized %d existing initial status note field rows to %s.',
    $updated,
    $langcode
  );
  return implode("\n", $messages);
}

/**
 * Finds first status-note paragraph rows that carry the default source text.
 *
 * @return int[]
 *   Current paragraph ids or paragraph revision ids from the note table.
 */
function _service_request_initial_status_note_row_ids(
  string $note_table,
  string $reference_table,
  string $reference_target_column,
  string $note_id_column,
  string $source,
): array {
  $database = \Drupal::database();
  $schema = $database->schema();
  foreach ([$note_table, $reference_table, 'paragraphs_item_field_data'] as $table) {
    if (!$schema->tableExists($table)) {
      return [];
    }
  }

  $query = $database->select($note_table, 'note')->distinct();
  $query->innerJoin(
    $reference_table,
    'ref',
    "ref.$reference_target_column = note.$note_id_column"
  );
  $query->innerJoin(
    'paragraphs_item_field_data',
    'paragraph',
    'paragraph.id = note.entity_id'
  );
  $query
    ->fields('note', [$note_id_column])
    ->condition('note.field_status_note_value', $source)
    ->condition('note.field_status_note_format', 'plain_text')
    ->condition('note.deleted', 0)
    ->condition('note.delta', 0)
    ->condition('ref.bundle', 'service_request')
    ->condition('ref.deleted', 0)
    ->condition('ref.delta', 0)
    ->condition('paragraph.type', 'status')
    ->condition('paragraph.parent_type', 'node')
    ->condition('paragraph.parent_field_name', 'field_status_notes');

  return array_map('intval', $query->execute()->fetchCol());
}

/**
 * Updates exact status-note rows by id.
 *
 * @param int[] $ids
 *   Paragraph ids or paragraph revision ids.
 */
function _service_request_localize_status_note_rows(
  string $table,
  string $id_column,
  array $ids,
  string $source,
  string $translated,
): int {
  if ($ids === [] || !\Drupal::database()->schema()->tableExists($table)) {
    return 0;
  }

  return (int) \Drupal::database()->update($table)
    ->fields([
      'field_status_note_value' => $translated,
      'field_status_note_format' => 'plain_text',
    ])
    ->condition($id_column, $ids, 'IN')
    ->condition('field_status_note_value', $source)
    ->condition('field_status_note_format', 'plain_text')
    ->condition('deleted', 0)
    ->condition('delta', 0)
    ->execute();
}

/**
 * Imports shipped service_request translations for enabled site languages.
 */
function _service_request_import_shipped_translations(): string {
  if (!\Drupal::moduleHandler()->moduleExists('locale')) {
    return 'locale module not installed, skipping translation import.';
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('service_request');
  $translation_dir = \Drupal::root() . '/' . $module_path . '/translations';
  if (!is_dir($translation_dir)) {
    return 'service_request translation directory not found, skipping.';
  }

  $not_customized = defined('LOCALE_NOT_CUSTOMIZED')
    ? (int) constant('LOCALE_NOT_CUSTOMIZED')
    : 0;
  $options = [
    'overwrite_options' => [
      'not_customized' => TRUE,
      'customized' => FALSE,
    ],
    'customized' => $not_customized,
    'finish_feedback' => FALSE,
  ];

  \Drupal::moduleHandler()->loadInclude('locale', 'inc', 'locale.bulk');
  $imported = [];
  $imported_langcodes = [];
  $updated_lids = [];
  foreach (array_keys(\Drupal::languageManager()->getLanguages()) as $langcode) {
    if ($langcode === 'en') {
      continue;
    }

    $po_file = $translation_dir . '/' . $langcode . '.po';
    if (!is_readable($po_file)) {
      continue;
    }

    $report = Gettext::fileToDatabase((object) [
      'uri' => $po_file,
      'filename' => basename($po_file),
      'langcode' => $langcode,
      'project' => 'service_request',
    ], $options);
    $changed = (int) ($report['additions'] ?? 0) + (int) ($report['updates'] ?? 0);
    if ($changed > 0) {
      $imported[] = $langcode . ':' . $changed;
      $imported_langcodes[] = $langcode;
      if (isset($report['strings']) && is_array($report['strings'])) {
        $updated_lids = array_merge($updated_lids, $report['strings']);
      }
    }
  }

  if ($updated_lids && function_exists('_locale_refresh_translations')) {
    _locale_refresh_translations($imported_langcodes, array_unique($updated_lids));
  }

  return $imported
    ? 'Imported service_request translations: ' . implode(', ', $imported) . '.'
    : 'service_request translations already up to date.';
}

/**
 * Loads profile update helpers from the parent install profile.
 */
function _service_request_load_markaspot_profile_updates(): void {
  if (
    function_exists('markaspot_update_11920') &&
    function_exists('markaspot_update_11921') &&
    function_exists('markaspot_update_11922') &&
    function_exists('markaspot_update_11923') &&
    function_exists('markaspot_update_11924')
  ) {
    return;
  }

  $profile_install = dirname(__DIR__, 2) . '/markaspot.install';
  if (is_readable($profile_install)) {
    require_once $profile_install;
  }
}
