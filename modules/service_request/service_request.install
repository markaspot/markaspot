<?php

/**
 * @file
 * Install file for service_request.
 */

use Drupal\locale\Gettext;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;
use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 *
 * We don't want users to be able to delete our locked_content_type content
 * type. So therefore we have to tell Drupal that this is the case. This
 * can't be done in the content type's configuration YAML file, so we have to
 * do it in code, here.
 *
 * @ingroup service_request
 */
function service_request_install() {
  // Do not allow the locked content type to be deleted.
  $locked = Drupal::state()->get('node.type.locked');
  $locked['locked_content_type'] = 'locked_content_type';
  Drupal::state()->set('node.type.locked', $locked);
}

/**
 * Implements hook_uninstall().
 *
 * Our content types will live on in the Drupal installation, even after this
 * module is uninstalled. This is a good thing, since it allows the user to
 * make decisions about their fate. Therefore we should give the user the
 * option of deleting them.
 *
 * Since we told Drupal that our locked_content_type is locked, we now have
 * to tell it to unlock.
 *
 * @ingroup service_request
 */
function service_request_uninstall() {
  // Allow locked_content_type to be deleted.
  $locked = Drupal::state()->get('node.type.locked');
  unset($locked['locked_content_type']);
  Drupal::state()->set('node.type.locked', $locked);

  \Drupal::configFactory()->getEditable('node.settings')->set('use_admin_theme', TRUE)->save(TRUE);

}

/**
 * Fix allowed_formats for body field to support Open311 API updates.
 *
 * In Drupal 11, when allowed_formats is set to an empty array, it means
 * no formats are allowed, which causes validation errors when the Open311
 * API tries to update service requests with text fields.
 */
function service_request_update_11001() {
  $config = \Drupal::configFactory()->getEditable('field.field.node.service_request.body');

  if ($config && $config->get('id') === 'node.service_request.body') {
    $settings = $config->get('settings') ?: [];

    // Set allowed_formats to allow common text formats.
    $settings['allowed_formats'] = [
      'plain_text' => 'plain_text',
      'basic_html' => 'basic_html',
      'full_html' => 'full_html',
    ];

    $config->set('settings', $settings)->save(TRUE);

    return t('Updated body field configuration to allow text formats for Open311 API compatibility.');
  }

  return t('Body field configuration not found or already updated.');
}

/**
 * Install hazard_level field on service_request nodes.
 *
 * This field stores the aggregated hazard level from AI image analysis.
 * Uses list_integer type with allowed values: 0=None, 1=Low, 2=Medium,
 * 3=High, 4=Critical.
 *
 * Requires field_permissions module for custom access control.
 */
function service_request_update_11002(&$sandbox) {
  $messages = [];

  // Check if field_permissions module is available.
  $module_handler = \Drupal::moduleHandler();
  $has_field_permissions = $module_handler->moduleExists('field_permissions');

  // Field Storage: field_hazard_level (list_integer).
  if (!FieldStorageConfig::loadByName('node', 'field_hazard_level')) {
    $storage_config = [
      'field_name' => 'field_hazard_level',
      'entity_type' => 'node',
      'type' => 'list_integer',
      'settings' => [
        'allowed_values' => [
          0 => 'None',
          1 => 'Low',
          2 => 'Medium',
          3 => 'High',
          4 => 'Critical',
        ],
        'allowed_values_function' => '',
      ],
      'cardinality' => 1,
      'translatable' => TRUE,
    ];

    // Add field_permissions if module is available.
    if ($has_field_permissions) {
      $storage_config['third_party_settings'] = [
        'field_permissions' => [
          'permission_type' => 'custom',
        ],
      ];
    }

    FieldStorageConfig::create($storage_config)->save();
    $messages[] = 'Created field storage: node.field_hazard_level';
  }

  // Field Instance: node.service_request.field_hazard_level.
  if (!FieldConfig::loadByName('node', 'service_request', 'field_hazard_level')) {
    FieldConfig::create([
      'field_name' => 'field_hazard_level',
      'entity_type' => 'node',
      'bundle' => 'service_request',
      'label' => 'Hazard Level',
      'description' => 'AI-detected hazard severity level based on image analysis.',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [['value' => 0]],
      'settings' => [],
    ])->save();
    $messages[] = 'Created field instance: node.service_request.field_hazard_level';
  }

  return empty($messages) ? 'Hazard level field already exists.' : implode("\n", $messages);
}

/**
 * Install field_priority on service_request and grant JSON:API write access.
 *
 * Creates the boolean priority field (High/Low) with field_permissions custom
 * access, and ensures both moderator and editorial_board roles can read/write
 * it via JSON:API.
 */
function service_request_update_11003() {
  $messages = [];
  $module_handler = \Drupal::moduleHandler();
  $has_field_permissions = $module_handler->moduleExists('field_permissions');

  // 1. Create field storage if missing.
  if (!FieldStorageConfig::loadByName('node', 'field_priority')) {
    $storage_config = [
      'field_name' => 'field_priority',
      'entity_type' => 'node',
      'type' => 'boolean',
      'settings' => [],
      'cardinality' => 1,
      'translatable' => TRUE,
    ];

    if ($has_field_permissions) {
      $storage_config['third_party_settings'] = [
        'field_permissions' => [
          'permission_type' => 'custom',
        ],
      ];
    }

    FieldStorageConfig::create($storage_config)->save();
    $messages[] = 'Created field storage: node.field_priority';
  }
  else {
    // Field exists but may not have field_permissions set. Ensure it does.
    $storage = FieldStorageConfig::loadByName('node', 'field_priority');
    if ($has_field_permissions && !$storage->getThirdPartySetting('field_permissions', 'permission_type')) {
      $storage->setThirdPartySetting('field_permissions', 'permission_type', 'custom');
      $storage->save();
      $messages[] = 'Enabled custom field_permissions on existing field_priority storage';
    }
  }

  // 2. Create field instance if missing.
  if (!FieldConfig::loadByName('node', 'service_request', 'field_priority')) {
    FieldConfig::create([
      'field_name' => 'field_priority',
      'entity_type' => 'node',
      'bundle' => 'service_request',
      'label' => 'Priority',
      'description' => 'Check if this request is high priority.',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [['value' => 0]],
      'settings' => [
        'on_label' => 'High',
        'off_label' => 'Low',
      ],
    ])->save();
    $messages[] = 'Created field instance: node.service_request.field_priority';
  }

  // 3. Grant field_priority permissions to moderator and editorial_board.
  $priority_permissions = [
    'create field_priority',
    'edit field_priority',
    'edit own field_priority',
    'view field_priority',
    'view own field_priority',
  ];

  foreach (['moderator', 'editorial_board'] as $role_id) {
    $role = Role::load($role_id);

    // Create editorial_board role if it doesn't exist.
    if (!$role && $role_id === 'editorial_board') {
      $role = Role::create([
        'id' => 'editorial_board',
        'label' => 'Editorial board',
        'weight' => -4,
      ]);
      $role->grantPermission('access content');
      $role->grantPermission('access content overview');
      $role->grantPermission('access toolbar');
      $role->grantPermission('edit any service_request content');
      $role->grantPermission('edit own service_request content');
      $role->grantPermission('view own unpublished content');
      $role->grantPermission('view the administration theme');
      $role->save();
      $messages[] = 'Created editorial_board role';
    }

    if ($role) {
      $granted = [];
      foreach ($priority_permissions as $perm) {
        if (!$role->hasPermission($perm)) {
          $role->grantPermission($perm);
          $granted[] = $perm;
        }
      }
      if ($granted) {
        $role->save();
        $messages[] = "Granted to $role_id: " . implode(', ', $granted);
      }
    }
  }

  return empty($messages) ? 'field_priority already configured.' : implode("\n", $messages);
}

/**
 * Make field_address subfields optional on service_request nodes.
 *
 * The address field is auto-populated by the geocoder (reverse geocode from
 * coordinates), so its subfields should not be required. This update changes
 * the address field settings from the legacy `fields` format to
 * `field_overrides` with optional subfields, and hides name/organization
 * subfields that are not used for service requests.
 *
 * @see https://github.com/markaspot/markaspot/issues/130
 */
function service_request_update_11004() {
  $config = \Drupal::configFactory()->getEditable('field.field.node.service_request.field_address');

  if (!$config || $config->isNew()) {
    return 'field_address config not found.';
  }

  $messages = [];

  // Ensure the field itself is not required.
  if ($config->get('required') !== FALSE) {
    $config->set('required', FALSE);
    $messages[] = 'Set field_address required to FALSE.';
  }

  // Update settings to use field_overrides with optional subfields.
  $settings = $config->get('settings') ?: [];
  $settings['langcode_override'] = $settings['langcode_override'] ?? 'en';
  $settings['field_overrides'] = [
    'givenName' => ['override' => 'hidden'],
    'additionalName' => ['override' => 'hidden'],
    'familyName' => ['override' => 'hidden'],
    'organization' => ['override' => 'hidden'],
    'addressLine1' => ['override' => 'optional'],
    'addressLine2' => ['override' => 'optional'],
    'postalCode' => ['override' => 'optional'],
    'locality' => ['override' => 'optional'],
  ];
  // Clear legacy fields format.
  $settings['fields'] = [];

  $config->set('settings', $settings)->save(TRUE);
  $messages[] = 'Updated field_overrides: addressLine1, addressLine2, postalCode, locality set to optional; name/organization fields hidden.';

  return implode("\n", $messages);
}

/**
 * Fix geolocation widget compatibility across form displays.
 *
 * The nuxt form display may reference geolocation_mapbox_widget even when only
 * geolocation_nominatim is installed. This causes fatal errors when update
 * hooks trigger form display re-validation.
 *
 * This hook switches all service_request form displays from
 * geolocation_mapbox_widget to geolocation_nominatim_widget when the
 * geolocation_mapbox module is not installed.
 */
function service_request_update_11005() {
  $module_handler = \Drupal::moduleHandler();

  // Only fix if mapbox is NOT installed and nominatim IS installed.
  if ($module_handler->moduleExists('geolocation_mapbox')) {
    return 'geolocation_mapbox is installed, no widget migration needed.';
  }
  if (!$module_handler->moduleExists('geolocation_nominatim')) {
    return 'geolocation_nominatim is not installed, cannot migrate widget.';
  }

  $messages = [];
  $etm = \Drupal::entityTypeManager();

  // Settings that nominatim supports but mapbox does not.
  $nominatim_defaults = [
    'maplibre' => '1',
    'addressFormat' => '${address.house_number}, ${address.road}, ${address.hamlet}, ${address.village}, ${address.suburb}, ${address.town}, ${address.city}, ${address.county}, ${address.postcode}',
    'serviceUrl' => 'https://nominatim.openstreetmap.org/',
    'LocationIQToken' => '',
  ];

  // Find all service_request form displays dynamically (covers custom modes).
  $form_displays = $etm->getStorage('entity_form_display')
    ->loadByProperties([
      'targetEntityType' => 'node',
      'bundle' => 'service_request',
    ]);

  foreach ($form_displays as $form_display) {
    $display_id = $form_display->id();

    $component = $form_display->getComponent('field_geolocation');
    if (!$component || ($component['type'] ?? '') !== 'geolocation_mapbox_widget') {
      continue;
    }

    // Switch widget type.
    $component['type'] = 'geolocation_nominatim_widget';

    // Add nominatim-specific settings with defaults.
    $settings = $component['settings'] ?? [];
    foreach ($nominatim_defaults as $key => $default) {
      if (!isset($settings[$key])) {
        $settings[$key] = $default;
      }
    }
    $component['settings'] = $settings;

    $form_display->setComponent('field_geolocation', $component);
    // Dependencies are recalculated automatically by save().
    $form_display->save();
    $messages[] = "Migrated $display_id from geolocation_mapbox_widget to geolocation_nominatim_widget.";
  }

  return empty($messages) ? 'No form displays needed migration.' : implode("\n", $messages);
}

/**
 * Add group_contact fieldset to management form display.
 *
 * Moves field_e_mail from group_citizen_input into a new group_contact
 * fieldset nested under group_citizen_input. This aligns the Drupal form
 * display with the frontend DashboardEditForm expectations.
 *
 * @see https://github.com/markaspot/markaspot/issues/224
 */
function service_request_update_11006() {
  $form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.service_request.management');

  if (!$form_display) {
    return 'Management form display not found.';
  }

  $field_groups = $form_display->getThirdPartySettings('field_group');

  // Skip if group_contact already exists.
  if (isset($field_groups['group_contact'])) {
    return 'group_contact already exists in management form display.';
  }

  // Verify group_citizen_input exists.
  if (!isset($field_groups['group_citizen_input'])) {
    return 'group_citizen_input not found in management form display.';
  }

  // Verify field_e_mail is a component of the form display.
  $components = $form_display->getComponents();
  if (!isset($components['field_e_mail'])) {
    return 'field_e_mail is not a component of management form display. Skipping.';
  }

  // Remove field_e_mail from group_citizen_input children.
  $citizen_children = $field_groups['group_citizen_input']['children'] ?? [];
  $citizen_children = array_values(array_filter($citizen_children, function ($child) {
    return $child !== 'field_e_mail';
  }));

  // Add group_contact as a child of group_citizen_input.
  $citizen_children[] = 'group_contact';
  $field_groups['group_citizen_input']['children'] = $citizen_children;

  // Create the group_contact fieldset.
  $field_groups['group_contact'] = [
    'children' => ['field_e_mail'],
    'label' => 'Contact',
    'region' => 'content',
    'parent_name' => 'group_citizen_input',
    'weight' => 20,
    'format_type' => 'fieldset',
    'format_settings' => [
      'classes' => '',
      'id' => '',
      'label_as_html' => FALSE,
      'description' => '',
      'required_fields' => TRUE,
    ],
  ];

  // Save all field_group settings back.
  foreach ($field_groups as $group_name => $group_settings) {
    $form_display->setThirdPartySetting('field_group', $group_name, $group_settings);
  }

  $form_display->save();

  return 'Added group_contact fieldset to management form display and moved field_e_mail into it.';
}

/**
 * Install field_sublocality and sublocality vocabulary on service_request.
 *
 * Adds a second geographic taxonomy reference field for finer-grained location
 * classification. field_district handles coarse areas (e.g., Bezirke),
 * field_sublocality handles fine-grained areas (e.g., Ortsteile/Stadtteile).
 * Both are independently populated by the geocoder district mapping feature.
 *
 * @see https://github.com/markaspot/markaspot-ui/issues/277
 */
function service_request_update_11007() {
  $messages = [];
  $module_handler = \Drupal::moduleHandler();
  $has_field_permissions = $module_handler->moduleExists('field_permissions');

  // 1. Create sublocality vocabulary if missing.
  $vocab_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary');
  if (!$vocab_storage->load('sublocality')) {
    $vocab_storage->create([
      'vid' => 'sublocality',
      'name' => 'Sublocality',
      'description' => 'Sublocalities for service requests',
    ])->save();
    $messages[] = 'Created vocabulary: sublocality';
  }

  // 2. Create field storage if missing.
  if (!FieldStorageConfig::loadByName('node', 'field_sublocality')) {
    $storage_config = [
      'field_name' => 'field_sublocality',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'taxonomy_term',
      ],
      'cardinality' => 1,
      'translatable' => TRUE,
    ];

    if ($has_field_permissions) {
      $storage_config['third_party_settings'] = [
        'field_permissions' => [
          'permission_type' => 'public',
        ],
      ];
    }

    FieldStorageConfig::create($storage_config)->save();
    $messages[] = 'Created field storage: node.field_sublocality';
  }

  // 3. Create field instance if missing.
  if (!FieldConfig::loadByName('node', 'service_request', 'field_sublocality')) {
    $instance_config = [
      'field_name' => 'field_sublocality',
      'entity_type' => 'node',
      'bundle' => 'service_request',
      'label' => 'Sublocality',
      'description' => '',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [],
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => [
            'sublocality' => 'sublocality',
          ],
          'sort' => [
            'field' => '_none',
          ],
          'auto_create' => FALSE,
          'auto_create_bundle' => '',
        ],
      ],
    ];

    // field_permissions reads permission_type from the FieldConfig instance,
    // not the FieldStorage. The storage-level setting is kept for consistency
    // with other legacy fields, but the instance-level one is what JSON:API
    // and field-level access checks honor.
    if ($has_field_permissions) {
      $instance_config['third_party_settings'] = [
        'field_permissions' => [
          'permission_type' => 'public',
        ],
      ];
    }

    FieldConfig::create($instance_config)->save();
    $messages[] = 'Created field instance: node.service_request.field_sublocality';
  }

  return empty($messages) ? 'field_sublocality already exists.' : implode("\n", $messages);
}

/**
 * Set field_permissions public on district/sublocality field instances.
 *
 * Earlier update hooks set the permission_type on the field storage, where
 * the field_permissions module does not read it. As a result JSON:API's
 * field-level access check returned FORBIDDEN for reads through
 * /jsonapi/node/service_request?include=field_district,field_sublocality,
 * which in turn caused the dashboard edit form to render the dropdowns as
 * empty even when the taxonomy references were set on the node.
 *
 * This hook copies the intended public permission type onto the FieldConfig
 * instances on service_request so JSON:API honors it. It is safe to re-run.
 */
function service_request_update_11008(): string {
  if (!\Drupal::moduleHandler()->moduleExists('field_permissions')) {
    return 'field_permissions module not installed, nothing to do.';
  }

  $messages = [];
  $field_names = ['field_district', 'field_sublocality'];

  foreach ($field_names as $field_name) {
    $field = FieldConfig::loadByName('node', 'service_request', $field_name);
    if (!$field) {
      $messages[] = "Skipped {$field_name}: field instance not present.";
      continue;
    }

    $existing = $field->getThirdPartySetting('field_permissions', 'permission_type');
    if ($existing === 'public') {
      $messages[] = "Skipped {$field_name}: already public.";
      continue;
    }

    $field->setThirdPartySetting('field_permissions', 'permission_type', 'public');
    $field->save();
    $messages[] = "Set permission_type=public on node.service_request.{$field_name}.";
  }

  return implode("\n", $messages);
}

/**
 * Implements hook_update_N().
 *
 * Upgrade management form_display to include Priority, Service Provider,
 * Internal Remark, Escalation groups + components. Idempotent: only adds
 * components for fields that actually exist on the service_request bundle.
 *
 * Upstream of this hook the profile's config/install shipped a minimal
 * management form_display (4 groups: citizen_input + administration +
 * contact + edit_service_request). The dashboard edit page relies on
 * field_group assignments — fields without a group are not rendered.
 *
 * This hook is additive: it merges new groups + components into any
 * existing management form_display and only touches components that are
 * not yet configured, preserving tenant customizations.
 */
function service_request_update_11009(): string {
  $display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.service_request.management');

  if (!$display) {
    return 'node.service_request.management form_display missing, nothing to do.';
  }

  $messages = [];

  // Components to add if the bundle field exists + not yet configured.
  $components = [
    'field_priority' => [
      'type' => 'boolean_checkbox',
      'weight' => 10,
      'region' => 'content',
      'settings' => ['display_label' => TRUE],
      'third_party_settings' => [],
    ],
    'field_service_provider' => [
      'type' => 'options_select',
      'weight' => 19,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ],
    'field_service_provider_status' => [
      'type' => 'options_select',
      'weight' => 20,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ],
    'field_service_provider_notes' => [
      'type' => 'text_textarea',
      'weight' => 21,
      'region' => 'content',
      'settings' => ['rows' => 4, 'placeholder' => ''],
      'third_party_settings' => [],
    ],
    'field_service_provider_feedback' => [
      'type' => 'text_textarea',
      'weight' => 22,
      'region' => 'content',
      'settings' => ['rows' => 4, 'placeholder' => ''],
      'third_party_settings' => [],
    ],
    'field_sp_attachment' => [
      'type' => 'file_generic',
      'weight' => 23,
      'region' => 'content',
      'settings' => ['progress_indicator' => 'throbber'],
      'third_party_settings' => [],
    ],
    'field_internal_remark' => [
      'type' => 'paragraphs',
      'weight' => 24,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ],
    'field_escalation' => [
      'type' => 'entity_reference_autocomplete',
      'weight' => 25,
      'region' => 'content',
      'settings' => ['match_operator' => 'CONTAINS', 'size' => 60, 'placeholder' => ''],
      'third_party_settings' => [],
    ],
  ];

  foreach ($components as $field_name => $config) {
    if (!FieldConfig::loadByName('node', 'service_request', $field_name)) {
      $messages[] = "Skipped {$field_name}: field instance not present.";
      continue;
    }
    if ($display->getComponent($field_name)) {
      $messages[] = "Skipped {$field_name}: component already set.";
      continue;
    }
    $display->setComponent($field_name, $config);
    $messages[] = "Added {$field_name} to management form_display.";
  }

  // Field groups: merge into existing third_party_settings.field_group.
  $tps = $display->getThirdPartySettings('field_group');

  // New groups. Only add if not yet present and if at least one child field
  // exists on the bundle (else the group is empty and confusing).
  $groups_to_add = [
    'group_status' => [
      'parent_name' => 'group_administration',
      'children' => ['field_status', 'field_status_notes'],
      'format_type' => 'details',
      'label' => 'Status',
      'weight' => 11,
      'format_settings' => ['open' => TRUE, 'required_fields' => TRUE],
    ],
    'group_service_provider' => [
      'parent_name' => 'group_administration',
      'children' => [
        'field_service_provider',
        'field_service_provider_status',
        'field_service_provider_notes',
        'field_service_provider_feedback',
        'field_sp_attachment',
      ],
      'format_type' => 'details',
      'label' => 'Dienstleister',
      'weight' => 15,
      'format_settings' => ['open' => FALSE, 'required_fields' => TRUE],
    ],
    'group_internal' => [
      'parent_name' => 'group_administration',
      'children' => ['field_internal_remark', 'field_priority', 'field_escalation'],
      'format_type' => 'details',
      'label' => 'Intern',
      'weight' => 20,
      'format_settings' => ['open' => FALSE, 'required_fields' => TRUE],
    ],
  ];

  foreach ($groups_to_add as $gid => $gdef) {
    // Filter desired children to those whose field instances actually exist.
    $valid_children = array_filter($gdef['children'], function ($fn) {
      return (bool) FieldConfig::loadByName('node', 'service_request', $fn);
    });
    if (empty($valid_children)) {
      $messages[] = "Skipped group {$gid}: no child fields present.";
      continue;
    }
    $valid_children = array_values($valid_children);

    if (isset($tps[$gid])) {
      // Group exists: merge any missing valid children into it.
      $existing = $tps[$gid]['children'] ?? [];
      $missing = array_values(array_diff($valid_children, $existing));
      if (empty($missing)) {
        $messages[] = "Skipped group {$gid}: already has all valid children.";
        continue;
      }
      $tps[$gid]['children'] = array_values(array_unique(array_merge($existing, $missing)));
      $messages[] = "Merged group {$gid} with new children: " . implode(', ', $missing);
      continue;
    }

    // New group.
    $gdef['children'] = $valid_children;
    $tps[$gid] = $gdef;

    // Register as child of parent group.
    if (isset($tps[$gdef['parent_name']])) {
      $parent_children = $tps[$gdef['parent_name']]['children'] ?? [];
      if (!in_array($gid, $parent_children, TRUE)) {
        $parent_children[] = $gid;
        $tps[$gdef['parent_name']]['children'] = $parent_children;
      }
    }
    $messages[] = "Added group {$gid} with children: " . implode(', ', $valid_children);
  }

  foreach ($tps as $gid => $def) {
    $display->setThirdPartySetting('field_group', $gid, $def);
  }
  $display->save();

  return implode("\n", $messages);
}

/**
 * Repair group_service_provider: add field_sp_attachment, drop field_service_provider_files.
 *
 * Update_11009 incorrectly listed field_service_provider_files as the SP file
 * field and omitted field_sp_attachment. This hook corrects existing form
 * displays on tenants that already ran 11009.
 */
function service_request_update_11010(): string {
  $display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.service_request.management');

  if (!$display) {
    return 'node.service_request.management form_display missing, nothing to do.';
  }

  $messages = [];
  $changed = FALSE;

  // Ensure field_sp_attachment component is present.
  if (FieldConfig::loadByName('node', 'service_request', 'field_sp_attachment') && !$display->getComponent('field_sp_attachment')) {
    $display->setComponent('field_sp_attachment', [
      'type' => 'file_generic',
      'weight' => 23,
      'region' => 'content',
      'settings' => ['progress_indicator' => 'throbber'],
      'third_party_settings' => [],
    ]);
    $messages[] = 'Added field_sp_attachment component.';
    $changed = TRUE;
  }

  // Fix group_service_provider children: add field_sp_attachment, remove field_service_provider_files.
  $tps = $display->getThirdPartySettings('field_group');
  if (isset($tps['group_service_provider'])) {
    $children = $tps['group_service_provider']['children'] ?? [];
    $original = $children;

    // Remove legacy field.
    $children = array_values(array_diff($children, ['field_service_provider_files']));

    // Add correct field if missing and the field instance exists.
    if (!in_array('field_sp_attachment', $children, TRUE) &&
        FieldConfig::loadByName('node', 'service_request', 'field_sp_attachment')) {
      $children[] = 'field_sp_attachment';
    }

    if ($children !== $original) {
      $tps['group_service_provider']['children'] = $children;
      foreach ($tps as $gid => $def) {
        $display->setThirdPartySetting('field_group', $gid, $def);
      }
      $messages[] = 'Repaired group_service_provider children: removed field_service_provider_files, added field_sp_attachment.';
      $changed = TRUE;
    }
    else {
      $messages[] = 'group_service_provider already correct, no changes.';
    }
  }
  else {
    $messages[] = 'group_service_provider not found, update_11009 may not have run yet.';
  }

  if ($changed) {
    $display->save();
  }

  return implode("\n", $messages);
}

/**
 * Imports the German "Status changed." translation for existing tenants.
 *
 * The translation file ships with the module (translations/de.po) and is
 * picked up automatically on a fresh install, but tenants that upgrade
 * an already-installed module need an explicit import. The string is
 * emitted by service_request.module:_service_request_status_change()
 * as the fallback body for an auto-generated status_note paragraph
 * when the manager triggers a transition without writing a Rückmeldung.
 * Surfaced in citizen mails via [node:latest_status_note], so leaving
 * it untranslated leaves "Status changed." in German citizen mails.
 */
function service_request_update_11011(): string {
  if (!\Drupal::moduleHandler()->moduleExists('locale')) {
    return 'locale module not installed, skipping translation import.';
  }
  if (!\Drupal::languageManager()->getLanguage('de')) {
    return 'No de language enabled on this site, skipping.';
  }

  $modulePath = \Drupal::service('extension.list.module')->getPath('service_request');
  $poFile = \Drupal::root() . '/' . $modulePath . '/translations/de.po';

  if (!is_readable($poFile)) {
    return 'No de.po shipped with service_request, skipping.';
  }

  // Use the same import path Drupal core uses for module translations
  // so the strings land in the locales_source/locales_target tables.
  $file = (object) [
    'uri' => $poFile,
    'filename' => basename($poFile),
    'langcode' => 'de',
    'project' => 'service_request',
  ];
  $options = [
    'overwrite_options' => ['not_customized' => TRUE, 'customized' => FALSE],
    'customized' => 0,
    'finish_feedback' => FALSE,
  ];
  \Drupal::moduleHandler()->loadInclude('locale', 'inc', 'locale.bulk');
  Gettext::fileToDatabase($file, $options);

  return 'Imported service_request/translations/de.po.';
}

