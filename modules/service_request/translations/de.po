# Default body for an auto-generated status note when the manager
# triggers a status transition without providing a Rückmeldung text.
# Surfaced in citizen update mails via [node:latest_status_note] when
# the resolved status term has no description either.
msgid "Status changed."
msgstr "Status wurde geändert."

# Default body for the initial auto-generated status note when the initial
# status term has no description.
msgid "The service request has been created."
msgstr "Die Meldung wurde erstellt."
