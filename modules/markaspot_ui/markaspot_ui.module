<?php

/**
 * @file
 * Provides a toolbar integration for Mark-a-Spot modules.
 */

use Drupal\Core\Asset\AttachedAssetsInterface;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Extension\ThemeSettingsProvider;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_help().
 */
function markaspot_ui_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.markaspot_ui':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Mark-a-Spot UI module provides a consolidated toolbar interface for accessing all Mark-a-Spot module settings.') . '</p>';
      return $output;
  }
}

/**
 * Implements hook_toolbar().
 */
function markaspot_ui_toolbar() {
  if (!\Drupal::currentUser()->hasPermission('administer site configuration')) {
    return [];
  }

  // Build the toolbar item.
  $items['markaspot'] = [
    '#type' => 'toolbar_item',
    '#weight' => 99,
    'tab' => [
      '#type' => 'link',
      '#title' => t('Mark-a-Spot'),
      '#url' => Url::fromRoute('markaspot_ui.settings'),
      '#attributes' => [
        'title' => t('Mark-a-Spot settings'),
        'class' => ['toolbar-icon', 'toolbar-icon-markaspot-ui'],
      ],
    ],
    'tray' => [
      '#heading' => t('Mark-a-Spot settings'),
      'content' => [
        '#lazy_builder' => ['markaspot_ui.toolbar_builder:buildToolbarTray', []],
        '#create_placeholder' => TRUE,
      ],
    ],
    '#attached' => [
      'library' => ['markaspot_ui/toolbar'],
    ],
    '#cache' => [
      'contexts' => ['user.permissions'],
    ],
  ];

  return $items;
}

/**
 * Implements hook_theme().
 */
function markaspot_ui_theme() {
  return [
    'markaspot_ui_settings_overview' => [
      'variables' => [
        'modules' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_entity_prepare_form().
 */
function markaspot_ui_entity_prepare_form(EntityInterface $entity, $operation, FormStateInterface $form_state): void {
  /** @var \Drupal\markaspot_ui\Service\ManagementFormDisplaySwitcher $switcher */
  $switcher = \Drupal::service('markaspot_ui.management_form_display_switcher');
  $switcher->prepareForm($entity, (string) $operation, $form_state);
}

/**
 * Implements hook_views_pre_view().
 *
 * On SaaS instances the Drupal management view stays a read/single-edit
 * surface for tenant-facing roles: mass mutation across all tenants via bulk
 * operations is removed unless the account is a trusted operator. Self-hosted
 * installations are single tenant and keep the bulk field. The handler is only
 * dropped from the in-memory display, nothing is written to configuration.
 */
function markaspot_ui_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
  if ($view->id() !== 'management') {
    return;
  }
  /** @var \Drupal\markaspot_ui\Service\ManagementAccessGate $gate */
  $gate = \Drupal::service('markaspot_ui.management_access_gate');
  if (!$gate->allowFullManagement()) {
    $view->removeHandler($display_id, 'field', 'views_bulk_operations_bulk_form');
  }
}

/**
 * Implements hook_modules_installed().
 */
function markaspot_ui_modules_installed($modules) {
  // Clear caches when modules are installed to update the toolbar.
  Cache::invalidateTags(['markaspot_ui']);
}

/**
 * Implements hook_modules_uninstalled().
 */
function markaspot_ui_modules_uninstalled($modules) {
  // Clear caches when modules are uninstalled to update the toolbar.
  Cache::invalidateTags(['markaspot_ui']);
}

/**
 * Implements hook_menu_local_tasks_alter().
 */
function markaspot_ui_menu_local_tasks_alter(&$data, $route_name) {
  // Override the View tab link for service request nodes to point to frontend.
  if ($route_name == 'entity.node.edit_form' && isset($data['tabs'][0]['entity.node.canonical'])) {
    $node = \Drupal::routeMatch()->getParameter('node');
    if ($node && $node->bundle() == 'service_request' && !empty($node->request_id->value) && $node->isPublished()) {
      /** @var \Drupal\markaspot_nuxt\Service\FrontendUrlService $frontend_url_service */
      $frontend_url_service = \Drupal::service('markaspot_nuxt.frontend_url');
      $frontend_url = $frontend_url_service->getFrontendBaseUrl();

      // Only override the View tab when frontend URL generation is enabled.
      if (!$frontend_url) {
        return;
      }

      // Build jurisdiction-prefixed path.
      $jur_slug = '';
      if ($node->hasField('field_jurisdiction') && !$node->get('field_jurisdiction')->isEmpty()) {
        $jur = $node->get('field_jurisdiction')->entity;
        if ($jur && $jur->hasField('field_slug') && !$jur->get('field_slug')->isEmpty()) {
          $jur_slug = rawurlencode($jur->get('field_slug')->value) . '/';
        }
      }

      $request_id = rawurlencode($node->request_id->value);
      $url = Url::fromUri($frontend_url . '/' . $jur_slug . 'requests/' . $request_id);

      $data['tabs'][0]['entity.node.canonical']['#link']['url'] = $url;
      // Add cache dependency on the frontend config.
      $data['tabs'][0]['entity.node.canonical']['#cache']['tags'] = Cache::mergeTags(
        $data['tabs'][0]['entity.node.canonical']['#cache']['tags'] ?? [],
        ['config:markaspot_nuxt.settings']
      );
    }
  }
}

/**
 * Implements hook_node_view().
 */
function markaspot_ui_node_view(array &$build, $node, $display, $view_mode) {
  if ($node->bundle() == 'service_request' && $view_mode == 'full') {
    $build['#attached']['library'][] = 'markaspot_ui/node_view';
  }
}

/**
 * Implements hook_js_settings_alter().
 *
 * Gin Login builds absolute URLs from the current request host, and the login
 * page does not vary by host. When an internal request (health check, Nuxt
 * server via the nginx container name) renders it first, the cached page sends
 * every visitor's browser to a host such as http://127.0.0.1:8080. This alter
 * runs after all page attachments, so it needs no module ordering.
 */
function markaspot_ui_js_settings_alter(array &$settings, AttachedAssetsInterface $assets): void {
  if (!isset($settings['gin_login']['path'])) {
    return;
  }
  $path = \Drupal::service('extension.list.module')->getPath('gin_login');
  $settings['gin_login']['path'] = base_path() . $path;
}

/**
 * Implements hook_theme_registry_alter().
 *
 * Gin Login pins its preprocess functions on the login page hooks, so a plain
 * preprocess hook would never run there. Append ours right after it.
 */
function markaspot_ui_theme_registry_alter(array &$theme_registry): void {
  foreach ($theme_registry as &$info) {
    $functions = $info['preprocess functions'] ?? [];
    $position = array_search('gin_login_preprocess_ginlogin', $functions, TRUE);
    if ($position === FALSE || in_array('markaspot_ui_preprocess_gin_login_icon', $functions, TRUE)) {
      continue;
    }
    array_splice($functions, $position + 1, 0, ['markaspot_ui_preprocess_gin_login_icon']);
    $info['preprocess functions'] = $functions;
  }
}

/**
 * Preprocess callback for the Gin Login pages: a root-relative logo URL.
 *
 * Mirrors the source selection of gin_login_preprocess_ginlogin(), which uses
 * generateAbsoluteString() and so embeds the request host.
 */
function markaspot_ui_preprocess_gin_login_icon(array &$variables): void {
  if (empty($variables['icon_path'])) {
    return;
  }
  $theme = \Drupal::theme()->getActiveTheme()->getName();
  $theme_settings = \Drupal::service(ThemeSettingsProvider::class);
  $source = NULL;
  $use_default = $theme_settings->getSetting('icon_default', $theme);
  $theme_icon = $theme_settings->getSetting('icon_path', $theme);
  if ($use_default === NULL) {
    $use_default = $theme_settings->getSetting('logo.use_default', $theme);
    $theme_icon = $theme_settings->getSetting('logo.path', $theme);
  }
  if (!$use_default && !empty($theme_icon)) {
    $source = $theme_icon;
  }
  $logo = \Drupal::config('gin_login.settings')->get('logo');
  if (isset($logo['use_default']) && $logo['use_default'] == '0' && !empty($logo['path'])) {
    $source = $logo['path'];
  }
  if ($source !== NULL) {
    $variables['icon_path'] = \Drupal::service('file_url_generator')->generateString($source);
  }
}
