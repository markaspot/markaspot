{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "service_definition.schema.json",
  "type": "object",
  "properties": {
    "attributes": {
      "type": "array",
      "title": "Attributes",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Unique identifier for this attribute (e.g. 'vehicle_color')",
            "pattern": "^[a-z][a-z0-9_]*$",
            "minLength": 1
          },
          "variable": {
            "type": "boolean",
            "title": "Variable",
            "description": "Whether this attribute is user-editable (true) or informational only (false)",
            "default": true
          },
          "datatype": {
            "type": "string",
            "title": "Datatype",
            "enum": [
              "string",
              "number",
              "text",
              "datetime",
              "singlevaluelist",
              "multivaluelist",
              "imagelist"
            ],
            "default": "string"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "description": "Whether this attribute must be filled in",
            "default": false
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Human-readable label or question shown to the user",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "title": "Order",
            "description": "Display order (lower numbers first)",
            "default": 0
          },
          "values": {
            "type": "array",
            "title": "Values",
            "description": "Options for singlevaluelist and multivaluelist datatypes",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "title": "Key"
                },
                "name": {
                  "type": "string",
                  "title": "Name"
                }
              },
              "required": ["key", "name"]
            }
          },
          "media_type": {
            "type": "string",
            "title": "Media Type",
            "description": "Drupal Media Type machine name. Required for imagelist datatype. The frontend loads all media entities of this type as selectable options.",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "media_group": {
            "type": "string",
            "title": "Media Group",
            "description": "Optional filter: only show media entities whose field_definition_group matches this value. Allows one media type to serve multiple imagelist attributes with different image subsets.",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "datatype_description": {
            "type": "string",
            "title": "Helper Text",
            "description": "Optional helper text shown below the field label"
          },
          "default_value": {
            "type": "string",
            "title": "Default Value",
            "description": "Pre-filled value when category is selected. For multivaluelist: comma-separated keys."
          },
          "validation": {
            "type": "object",
            "title": "Validation Rules",
            "properties": {
              "pattern": {
                "type": "string",
                "title": "Pattern (Regex)",
                "description": "Regex the value must match (string/text types)"
              },
              "pattern_message": {
                "type": "string",
                "title": "Pattern Error Message",
                "description": "Custom error when pattern fails"
              },
              "min": {
                "type": "integer",
                "title": "Minimum",
                "description": "Min value (number) or min length (string)"
              },
              "max": {
                "type": "integer",
                "title": "Maximum",
                "description": "Max value (number) or max length (string)"
              }
            }
          },
          "conditions": {
            "type": "object",
            "title": "Visibility Conditions",
            "properties": {
              "show_when": {
                "type": "array",
                "title": "Show When",
                "description": "All conditions must be true (AND logic)",
                "items": {
                  "type": "object",
                  "properties": {
                    "attribute_code": {
                      "type": "string",
                      "title": "Depends on Attribute"
                    },
                    "operator": {
                      "type": "string",
                      "enum": ["equals", "not_equals", "contains", "not_empty"],
                      "default": "equals"
                    },
                    "value": {
                      "type": "string",
                      "title": "Value"
                    }
                  },
                  "required": ["attribute_code", "operator"]
                }
              }
            }
          }
        },
        "required": ["code", "datatype", "description"],
        "if": {
          "properties": { "datatype": { "const": "imagelist" } }
        },
        "then": {
          "required": ["media_type"]
        }
      }
    }
  }
}
