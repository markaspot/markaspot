{
  "attributes": {
    "ui:options": {
      "title": "Service Definition Attributes",
      "description": "Define additional form fields for this category. Each attribute becomes a form field in the reporting form."
    },
    "items": {
      "code": {
        "ui:options": {
          "placeholder": "e.g. vehicle_color",
          "description": "Unique machine name (lowercase, underscores)"
        }
      },
      "variable": {
        "ui:options": {
          "description": "Set to false for read-only informational attributes"
        }
      },
      "datatype": {
        "ui:options": {
          "description": "string = short text, number = numeric, text = long text, datetime = date/time picker, singlevaluelist = dropdown, multivaluelist = checkboxes, imagelist = image selection grid (requires media_type)"
        }
      },
      "required": {
        "ui:options": {
          "description": "If checked, the user must fill in this field"
        }
      },
      "description": {
        "ui:options": {
          "placeholder": "e.g. What color is the vehicle?",
          "description": "Label or question shown to the user"
        }
      },
      "order": {
        "ui:options": {
          "placeholder": "0",
          "description": "Lower numbers are shown first"
        }
      },
      "values": {
        "ui:options": {
          "title": "Options",
          "description": "Only for singlevaluelist and multivaluelist"
        },
        "items": {
          "key": {
            "ui:options": {
              "placeholder": "e.g. red"
            }
          },
          "name": {
            "ui:options": {
              "placeholder": "e.g. Red"
            }
          }
        }
      },
      "media_type": {
        "ui:options": {
          "placeholder": "e.g. systemskizze",
          "description": "Machine name of a Drupal Media Type. Only for imagelist datatype."
        }
      },
      "datatype_description": {
        "ui:options": {
          "widget": "textarea",
          "rows": 2,
          "placeholder": "e.g. Enter the 6-digit number from the metal plate"
        }
      },
      "default_value": {
        "ui:options": {
          "placeholder": "e.g. asphalt (for multivaluelist: key1, key2)"
        }
      },
      "validation": {
        "ui:options": {
          "title": "Validation Rules",
          "description": "Optional constraints for this attribute"
        },
        "pattern": {
          "ui:options": {
            "placeholder": "e.g. ^[0-9]{6}$"
          }
        },
        "pattern_message": {
          "ui:options": {
            "placeholder": "e.g. Must be exactly 6 digits"
          }
        },
        "min": {
          "ui:options": {
            "placeholder": "e.g. 0"
          }
        },
        "max": {
          "ui:options": {
            "placeholder": "e.g. 100"
          }
        }
      },
      "conditions": {
        "ui:options": {
          "title": "Visibility Conditions",
          "description": "Show this attribute only when conditions are met"
        },
        "show_when": {
          "ui:options": {
            "title": "Show When (AND logic)",
            "description": "All conditions must be true"
          },
          "items": {
            "attribute_code": {
              "ui:options": {
                "placeholder": "e.g. damage_type"
              }
            },
            "value": {
              "ui:options": {
                "placeholder": "e.g. graffiti"
              }
            }
          }
        }
      }
    }
  }
}
