<?php

/**
 * @file
 * Contains markaspot_open311.module.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Database\Query\SelectInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Sql\SqlEntityStorageInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\group\Entity\GroupInterface;
use Drupal\group\Entity\GroupMembership;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_query_TAG_alter() for anonymous workspace visibility.
 *
 * EntityQuery field conditions operate on individual rows. Because
 * field_jurisdiction is multi-value, a normal NOT IN would still match the
 * public row of a request also assigned to a restricted workspace. Excluding
 * base NIDs through a subquery makes any restrictive assignment win without
 * materializing every matching request ID in PHP.
 *
 * The field table and target column come from Drupal's SQL table mapping, not
 * naming conventions. Once restricted IDs are present, inability to resolve
 * or query that mapping must fail closed: silently omitting the condition
 * would expose requests that an operator explicitly made non-public.
 */
function markaspot_open311_query_markaspot_open311_workspace_visibility_alter(AlterableInterface $query): void {
  if (!$query instanceof SelectInterface
    || $query->getMetaData('entity_type') !== 'node') {
    return;
  }

  $restricted = $query->getMetaData('markaspot_open311_restricted_jurisdiction_ids');
  if (!is_array($restricted) || $restricted === []) {
    return;
  }
  $restricted = array_values(array_unique(array_map('intval', $restricted)));

  $entity_type_manager = \Drupal::entityTypeManager();
  $node_storage = $entity_type_manager->getStorage('node');
  $field_storage_definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('node');
  $field_storage = $field_storage_definitions['field_jurisdiction'] ?? NULL;
  if (!$node_storage instanceof SqlEntityStorageInterface || $field_storage === NULL) {
    $query->where('1 = 0');
    return;
  }

  try {
    $table_mapping = $node_storage->getTableMapping();
    $field_table = $table_mapping->getFieldTableName('field_jurisdiction');
    $target_column = $table_mapping->getFieldColumnName(
      $field_storage,
      'target_id',
    );
    $field_table_columns = $table_mapping->getAllColumns($field_table);
    $schema = \Drupal::database()->schema();
    $field_table_exists = $schema->tableExists($field_table);
    $physical_columns_exist = $field_table_exists
      && $schema->fieldExists($field_table, 'entity_id')
      && $schema->fieldExists($field_table, 'deleted')
      && $schema->fieldExists($field_table, $target_column);
  }
  catch (\Throwable) {
    $query->where('1 = 0');
    return;
  }

  // Unlimited configurable fields use a dedicated Field API table. Validate
  // its stable metadata columns as well as the mapped target column before
  // constructing SQL. A missing table is an incomplete schema update and must
  // fail closed because restrictions are already known to exist.
  if (!in_array('entity_id', $field_table_columns, TRUE)
    || !in_array('deleted', $field_table_columns, TRUE)
    || !in_array($target_column, $field_table_columns, TRUE)
    || !$physical_columns_exist) {
    $query->where('1 = 0');
    return;
  }

  $base_alias = NULL;
  foreach ($query->getTables() as $alias => $table) {
    if ($table['join type'] === NULL) {
      $base_alias = $alias;
      break;
    }
  }
  if ($base_alias === NULL) {
    $query->where('1 = 0');
    return;
  }

  $restricted_nodes = \Drupal::database()
    ->select($field_table, 'restricted_workspace');
  $restricted_nodes->addField('restricted_workspace', 'entity_id');
  $restricted_nodes
    ->condition('restricted_workspace.deleted', 0)
    ->condition(
      'restricted_workspace.' . $target_column,
      $restricted,
      'IN',
    );
  $query->condition($base_alias . '.nid', $restricted_nodes, 'NOT IN');
}

/**
 * Implements hook_help().
 */
function markaspot_open311_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the markaspot_open311 module.
    case 'help.page.markaspot_open311':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('GeoReport v2 Endpoint') . '</p>';
      return $output;
  }
}

/**
 * Implements hook_theme().
 */
function markaspot_open311_theme() {
  $theme = [];

  return $theme;
}

/**
 * Implements hook_entity_access().
 */
function markaspot_open311_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResult {
  if (
    $entity->getEntityTypeId() !== 'taxonomy_term' ||
    $entity->bundle() !== 'internal_status' ||
    !in_array($operation, ['view', 'update', 'delete'], TRUE)
  ) {
    return AccessResult::neutral();
  }

  if ($account->hasPermission('administer taxonomy')) {
    return AccessResult::neutral()->cachePerPermissions();
  }

  if (!$account->hasPermission('manage dashboard notes')) {
    return AccessResult::forbidden('Internal status terms are restricted to dashboard staff.')
      ->addCacheContexts(['user.permissions']);
  }

  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $entity;
  $jurisdiction = _markaspot_open311_term_jurisdiction($term);
  if ($jurisdiction === NULL) {
    return AccessResult::neutral()
      ->cachePerPermissions()
      ->addCacheableDependency($term);
  }

  $is_member = FALSE;
  foreach (GroupMembership::loadByUser($account) as $membership) {
    if ((int) $membership->getGroupId() === (int) $jurisdiction->id()) {
      $is_member = TRUE;
      break;
    }
  }

  $membership_cache_tags = [
    'group_relationship_list:plugin:group_membership:group:' . $jurisdiction->id(),
    'group_relationship_list:plugin:group_membership:entity:' . $account->id(),
  ];
  $membership_cache_context = 'user.is_group_member:' . $jurisdiction->id();
  if (!$is_member) {
    return AccessResult::forbidden('Internal status terms are scoped to the jurisdiction.')
      ->cachePerPermissions()
      ->addCacheContexts(['user', $membership_cache_context])
      ->addCacheableDependency($term)
      ->addCacheableDependency($jurisdiction)
      ->addCacheTags($membership_cache_tags);
  }

  return AccessResult::neutral()
    ->cachePerPermissions()
    ->addCacheContexts(['user', $membership_cache_context])
    ->addCacheableDependency($term)
    ->addCacheableDependency($jurisdiction)
    ->addCacheTags($membership_cache_tags);
}

/**
 * Implements hook_entity_create_access().
 */
function markaspot_open311_entity_create_access(AccountInterface $account, array $context, $entity_bundle): AccessResult {
  if (($context['entity_type_id'] ?? NULL) !== 'taxonomy_term' || $entity_bundle !== 'internal_status') {
    return AccessResult::neutral();
  }

  if ($account->hasPermission('administer taxonomy')) {
    return AccessResult::neutral()->cachePerPermissions();
  }

  if (!$account->hasPermission('manage dashboard notes')) {
    return AccessResult::forbidden('Internal status terms are restricted to dashboard staff.')
      ->addCacheContexts(['user.permissions']);
  }

  return AccessResult::neutral()->cachePerPermissions();
}

/**
 * Implements hook_entity_field_access().
 */
function markaspot_open311_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResult {
  $field_target_bundle = $field_definition->getTargetBundle();
  $field_entity = NULL;
  if ($field_target_bundle === NULL && $items !== NULL) {
    $field_entity = $items->getEntity();
    if ($field_entity !== NULL && $field_entity->getEntityTypeId() === $field_definition->getTargetEntityTypeId()) {
      $field_target_bundle = $field_entity->bundle();
    }
  }

  // The raw node author relationship exposes editor identities through
  // JSON:API include=uid. Dashboard creator display must use the Open311
  // manager shape, where tenant scoping is explicit and fail-closed.
  if (
    $operation === 'view'
    && $field_definition->getName() === 'uid'
    && $field_definition->getTargetEntityTypeId() === 'node'
    && $field_target_bundle === 'service_request'
  ) {
    if (!$account->hasPermission('access open311 advanced properties')) {
      return AccessResult::forbidden('Service request authors require dashboard manager access.')
        ->cachePerPermissions();
    }

    if ($items === NULL || $items->getEntity() === NULL) {
      return AccessResult::forbidden('Service request author access requires an entity context.')
        ->cachePerPermissions()
        ->addCacheContexts(['user'])
        ->setCacheMaxAge(0);
    }

    $entity = $field_entity ?? $items->getEntity();
    /** @var \Drupal\markaspot_open311\Service\GeoreportProcessorServiceInterface $processor */
    $processor = \Drupal::service('markaspot_open311.processor');
    $jurisdictionId = $processor->resolveNodeJurisdictionId($entity);

    if ($jurisdictionId === NULL) {
      if ($processor->hasJurisdictionGroups()) {
        return AccessResult::forbidden('Service request author access requires a resolvable jurisdiction.')
          ->cachePerPermissions()
          ->addCacheContexts(['user'])
          ->addCacheableDependency($entity)
          ->setCacheMaxAge(0);
      }
      return AccessResult::neutral()
        ->cachePerPermissions()
        ->addCacheContexts(['user'])
        ->addCacheableDependency($entity)
        ->setCacheMaxAge(0);
    }

    if (!$processor->isJurisdictionMember($jurisdictionId, $account)) {
      return AccessResult::forbidden('Service request authors are restricted to the request jurisdiction.')
        ->cachePerPermissions()
        ->addCacheContexts(['user'])
        ->addCacheableDependency($entity)
        ->setCacheMaxAge(0);
    }

    return AccessResult::neutral()
      ->cachePerPermissions()
      ->addCacheContexts(['user'])
      ->addCacheableDependency($entity)
      ->setCacheMaxAge(0);
  }

  // field_status_attributes stores internal process data on status paragraphs.
  // field_permissions already gates it, but a misconfiguration there would
  // leak captured values through JSON:API. This fail-closed branch hard-denies
  // view/edit for anyone lacking the explicit field permission, independent of
  // field_permissions, so internal data can never reach citizens.
  if (
    in_array($operation, ['view', 'edit'], TRUE)
    && $field_definition->getName() === 'field_status_attributes'
    && $field_definition->getTargetEntityTypeId() === 'paragraph'
    && $field_definition->getTargetBundle() === 'status'
  ) {
    // The feature-flag gate for status attributes lives in
    // StatusNoteController, which is the only legitimate writer. It persists
    // the field programmatically via Paragraph::set()/save(), and programmatic
    // set/save do not invoke hook_entity_field_access. Interactive writes
    // (JSON:API PATCH on paragraph--status, entity forms) would otherwise
    // bypass that controller-side flag check entirely, so edit is hard-denied
    // here for everyone regardless of permission or feature flag.
    if ($operation === 'edit') {
      return AccessResult::forbidden('Status attributes are written programmatically by the dashboard status-note endpoint only.')
        ->addCacheContexts(['user.permissions']);
    }
    if (!$account->hasPermission('view field_status_attributes')) {
      return AccessResult::forbidden('Internal status attributes require explicit field access.')
        ->addCacheContexts(['user.permissions']);
    }
    return AccessResult::neutral()->cachePerPermissions();
  }

  if (
    !in_array($operation, ['view', 'edit'], TRUE)
    || $field_definition->getName() !== 'field_status_definition'
    || $field_definition->getTargetEntityTypeId() !== 'taxonomy_term'
    || !in_array($field_definition->getTargetBundle(), ['service_status', 'internal_status'], TRUE)
  ) {
    return AccessResult::neutral();
  }

  // Platform operators keep normal taxonomy access so they can prepare tenant
  // definitions before enabling the tenant-facing feature flag.
  if ($account->hasPermission('administer taxonomy')) {
    return AccessResult::neutral()->cachePerPermissions();
  }

  // field_status_definition holds the internal status-attribute schema. It is
  // staff-only: non-operators must hold the dashboard-staff permission
  // 'manage dashboard notes'. Anonymous and citizen accounts never qualify,
  // so they can never read or write the definition through JSON:API even when
  // the tenant has opted into the feature.
  if (!$account->hasPermission('manage dashboard notes')) {
    return AccessResult::forbidden('Internal status definitions are restricted to dashboard staff.')
      ->addCacheContexts(['user.permissions']);
  }

  if ($items === NULL || !$items->getEntity() instanceof TermInterface) {
    return AccessResult::forbidden()
      ->addCacheContexts(['user.permissions']);
  }

  $term = $items->getEntity();
  $jurisdiction = _markaspot_open311_term_jurisdiction($term);
  /** @var \Drupal\markaspot_nuxt\Service\FeatureFlagChecker $feature_checker */
  $feature_checker = \Drupal::service('markaspot_nuxt.feature_flag_checker');
  $enabled = $feature_checker->isEnabled('features.statusAttributes', $jurisdiction, FALSE);

  $result = $enabled ? AccessResult::neutral() : AccessResult::forbidden();
  $result
    ->addCacheableDependency($term)
    ->addCacheContexts(['user.permissions']);

  if ($jurisdiction) {
    $result->addCacheableDependency($jurisdiction);
  }

  return $result;
}

/**
 * Resolves the jurisdiction group from a taxonomy term.
 */
function _markaspot_open311_term_jurisdiction(TermInterface $term): ?GroupInterface {
  if (!$term->hasField('field_jurisdiction') || $term->get('field_jurisdiction')->isEmpty()) {
    return NULL;
  }

  $entity = $term->get('field_jurisdiction')->entity;
  return $entity instanceof GroupInterface ? $entity : NULL;
}

/**
 * Implements hook_ENTITY_TYPE_delete() for media entities.
 *
 * Drops the manual publication mark that updateMediaPublishedStatus() records
 * for explicit GeoReport publish/unpublish decisions, so the keyvalue
 * collection does not accumulate entries for deleted media.
 */
function markaspot_open311_media_delete(EntityInterface $media): void {
  \Drupal::keyValue('markaspot_open311.media_publication_manual')->delete($media->id());
}
