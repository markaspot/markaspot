<?php

/**
 * @file
 * Install, update and uninstall functions for the markaspot_open311 module.
 */

use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Implements hook_install().
 */
function markaspot_open311_install(): void {
  // Grant anonymous the create permission for field_request_attributes.
  // Authenticated gets this via profile config YAML, but anonymous does not.
  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('anonymous');
  if ($role && !$role->hasPermission('create field_request_attributes')) {
    $role->grantPermission('create field_request_attributes');
    $role->save();
  }

  _markaspot_open311_configure_status_attribute_surfaces();
}

/**
 * Configures UI, permissions, and JSON:API exposure for status attributes.
 *
 * @return string[]
 *   Human-readable messages about changed configuration.
 */
function _markaspot_open311_configure_status_attribute_surfaces(): array {
  $messages = [];
  $entity_type_manager = \Drupal::entityTypeManager();

  if ($entity_type_manager->getStorage('field_config')->load('taxonomy_term.service_status.field_status_definition')) {
    $status_form_display = $entity_type_manager->getStorage('entity_form_display')
      ->load('taxonomy_term.service_status.default');
    if ($status_form_display) {
      $has_json_widget = \Drupal::service('plugin.manager.field.widget')
        ->hasDefinition('status_definition_json_form');
      $status_form_display->setComponent('field_status_definition', [
        'type' => $has_json_widget ? 'status_definition_json_form' : 'text_textarea',
        'weight' => 20,
        'settings' => $has_json_widget ? [] : [
          'rows' => 5,
          'placeholder' => '',
        ],
      ])->save();
      $messages[] = $has_json_widget
        ? 'Added status_definition_json_form widget to service_status form display.'
        : 'Added text_textarea fallback widget to service_status form display.';
    }
  }

  if ($entity_type_manager->getStorage('field_config')->load('paragraph.status.field_status_attributes')) {
    $paragraph_form_display = $entity_type_manager->getStorage('entity_form_display')
      ->load('paragraph.status.default');
    if ($paragraph_form_display) {
      $paragraph_form_display->removeComponent('field_status_attributes')->save();
      $messages[] = 'Hid field_status_attributes from the Drupal paragraph form.';
    }
  }

  $role_storage = $entity_type_manager->getStorage('user_role');
  // Staff roles need create/edit to persist captured attributes through the
  // Entity API (field_permissions "custom" gates every operation), plus view
  // to read them back. Granting view alone silently drops staff writes.
  $attribute_permissions = [
    'view field_status_attributes',
    'create field_status_attributes',
    'edit field_status_attributes',
  ];
  foreach (['moderator', 'editorial_board', 'tenant_admin'] as $role_id) {
    $role = $role_storage->load($role_id);
    if (!$role) {
      continue;
    }
    $role_changed = FALSE;
    foreach ($attribute_permissions as $permission) {
      if (!$role->hasPermission($permission)) {
        $role->grantPermission($permission);
        $messages[] = "Granted $role_id $permission permission.";
        $role_changed = TRUE;
      }
    }
    if ($role_changed) {
      $role->save();
    }
  }

  $config_factory = \Drupal::configFactory();
  $status_resource = $config_factory->getEditable('jsonapi_extras.jsonapi_resource_config.taxonomy_term--service_status');
  if (!$status_resource->isNew()) {
    $status_resource->set('resourceFields.field_status_definition', [
      'disabled' => FALSE,
      'fieldName' => 'field_status_definition',
      'publicName' => 'field_status_definition',
      'enhancer' => ['id' => ''],
    ])->save();
    $messages[] = 'Exposed field_status_definition on the service_status JSON:API resource.';
  }

  $paragraph_resource = $config_factory->getEditable('jsonapi_extras.jsonapi_resource_config.paragraph--status');
  if (!$paragraph_resource->isNew()) {
    $paragraph_resource->set('resourceFields.field_status_attributes', [
      'disabled' => FALSE,
      'fieldName' => 'field_status_attributes',
      'publicName' => 'field_status_attributes',
      'enhancer' => ['id' => ''],
    ])->save();
    $messages[] = 'Exposed field_status_attributes on the status paragraph JSON:API resource.';
  }

  return $messages;
}

/**
 * Add response_visibility config for configurable jurisdiction/organisation.
 */
function markaspot_open311_update_11801() {
  $config = \Drupal::configFactory()->getEditable('markaspot_open311.settings');
  $changed = FALSE;

  if ($config->get('response_visibility') === NULL) {
    $config->set('response_visibility', [
      'public_jurisdiction' => FALSE,
      'public_organisation' => FALSE,
      'jurisdiction_display' => 'leaf',
    ]);
    $changed = TRUE;
  }
  else {
    // Ensure jurisdiction_display exists on sites with partial config.
    if ($config->get('response_visibility.jurisdiction_display') === NULL) {
      $config->set('response_visibility.jurisdiction_display', 'leaf');
      $changed = TRUE;
    }
    // Remove show_in_list if present (moved to per-jurisdiction config).
    if ($config->get('response_visibility.show_in_list') !== NULL) {
      $config->clear('response_visibility.show_in_list');
      $changed = TRUE;
    }
  }

  if ($changed) {
    $config->save();
    return t('Added or updated response_visibility configuration.');
  }

  return t('response_visibility configuration already up to date.');
}

/**
 * Install service definition and request attributes fields.
 */
function markaspot_open311_update_11802() {
  $messages = [];

  // Install field_service_definition on taxonomy_term (service_category).
  $entity_type_manager = \Drupal::entityTypeManager();

  // Create field storage for field_service_definition.
  $field_storage = $entity_type_manager->getStorage('field_storage_config');
  if (!$field_storage->load('taxonomy_term.field_service_definition')) {
    $field_storage->create([
      'field_name' => 'field_service_definition',
      'entity_type' => 'taxonomy_term',
      'type' => 'text_long',
      'cardinality' => 1,
      'translatable' => TRUE,
    ])->save();
    $messages[] = 'Created field_service_definition storage.';
  }

  // Create field instance on service_category bundle.
  $field_config = $entity_type_manager->getStorage('field_config');
  if (!$field_config->load('taxonomy_term.service_category.field_service_definition')) {
    $field_config->create([
      'field_name' => 'field_service_definition',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'service_category',
      'label' => 'Service Definition Attributes',
      'description' => 'Open311 service definition attributes for custom form fields per category.',
      'required' => FALSE,
      'translatable' => TRUE,
    ])->save();
    $messages[] = 'Created field_service_definition on service_category.';
  }

  // Set widget on form display.
  $form_display = $entity_type_manager->getStorage('entity_form_display')
    ->load('taxonomy_term.service_category.default');
  if ($form_display) {
    $form_display->setComponent('field_service_definition', [
      'type' => 'service_definition_json_form',
      'weight' => 20,
    ])->save();
    $messages[] = 'Set service_definition_json_form widget on form display.';
  }

  // Create field storage for field_request_attributes on node.
  if (!$field_storage->load('node.field_request_attributes')) {
    $storage = $field_storage->create([
      'field_name' => 'field_request_attributes',
      'entity_type' => 'node',
      'type' => 'text_long',
      'cardinality' => 1,
      'translatable' => FALSE,
    ]);
    $storage->setThirdPartySetting('field_permissions', 'permission_type', 'custom');
    $storage->save();
    $messages[] = 'Created field_request_attributes storage with custom permissions.';
  }

  // Create field instance on service_request bundle.
  if (!$field_config->load('node.service_request.field_request_attributes')) {
    $field_config->create([
      'field_name' => 'field_request_attributes',
      'entity_type' => 'node',
      'bundle' => 'service_request',
      'label' => 'Request Attributes',
      'description' => 'JSON-encoded service definition attribute values submitted with the request.',
      'required' => FALSE,
    ])->save();
    $messages[] = 'Created field_request_attributes on service_request.';
  }

  // Hide field_request_attributes from node form display (API-only).
  $node_form_display = $entity_type_manager->getStorage('entity_form_display')
    ->load('node.service_request.default');
  if ($node_form_display) {
    $node_form_display->removeComponent('field_request_attributes')->save();
    $messages[] = 'Hidden field_request_attributes from node form display.';
  }

  // Grant anonymous and authenticated permission for field_request_attributes.
  $role_storage = $entity_type_manager->getStorage('user_role');
  foreach (['anonymous', 'authenticated'] as $role_id) {
    $role = $role_storage->load($role_id);
    if ($role) {
      $role->grantPermission('create field_request_attributes');
      $role->save();
      $messages[] = "Granted $role_id create field_request_attributes permission.";
    }
  }

  return implode(' ', $messages) ?: t('Service definition fields already installed.');
}

/**
 * Make field_service_definition translatable for multilingual attribute labels.
 */
function markaspot_open311_update_11803() {
  $field_config = \Drupal::entityTypeManager()
    ->getStorage('field_config')
    ->load('taxonomy_term.service_category.field_service_definition');

  if ($field_config && !$field_config->isTranslatable()) {
    $field_config->setTranslatable(TRUE);
    $field_config->save();
    return t('Made field_service_definition translatable.');
  }

  return t('field_service_definition already translatable or not installed.');
}

/**
 * Enable field_permissions on field_request_attributes, fix role permissions.
 */
function markaspot_open311_update_11804() {
  $messages = [];
  $entity_type_manager = \Drupal::entityTypeManager();

  // Enable custom field permissions on field_request_attributes storage.
  $field_storage = $entity_type_manager->getStorage('field_storage_config')
    ->load('node.field_request_attributes');
  if ($field_storage) {
    $current = $field_storage->getThirdPartySetting('field_permissions', 'permission_type');
    if ($current !== 'custom') {
      $field_storage->setThirdPartySetting('field_permissions', 'permission_type', 'custom');
      $field_storage->save();
      $messages[] = 'Enabled custom field permissions on field_request_attributes.';
    }
  }

  // Grant create permission to anonymous and authenticated roles.
  // Remove incorrect permission name if present from earlier updates.
  $role_storage = $entity_type_manager->getStorage('user_role');
  foreach (['anonymous', 'authenticated'] as $role_id) {
    $role = $role_storage->load($role_id);
    if (!$role) {
      continue;
    }
    if (!$role->hasPermission('create field_request_attributes')) {
      $role->grantPermission('create field_request_attributes');
      $role->save();
      $messages[] = "Granted $role_id create field_request_attributes permission.";
    }
  }

  return implode(' ', $messages) ?: t('field_request_attributes permissions already configured.');
}

/**
 * Add public_district to response_visibility config.
 *
 * Enables district and sublocality fields in the GeoReport API response
 * for all users by default.
 */
function markaspot_open311_update_11805() {
  $config = \Drupal::configFactory()->getEditable('markaspot_open311.settings');

  if ($config->get('response_visibility.public_district') === NULL) {
    $config->set('response_visibility.public_district', TRUE);
    $config->save();
    return t('Added public_district to response_visibility configuration.');
  }

  return t('public_district configuration already exists.');
}

/**
 * Sync field_address storage definition after Address module schema changes.
 *
 * The Address module added address_line3 to its field type schema but provides
 * no update hook to call updateFieldStorageDefinition(). Without this, upgraded
 * sites produce "Undefined property: stdClass::$field_address_address_line3"
 * warnings and InvalidArgumentException on JSON:API requests.
 */
function markaspot_open311_update_11806(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $field_storage_definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('node');
  if (isset($field_storage_definitions['field_address'])) {
    $manager->updateFieldStorageDefinition($field_storage_definitions['field_address']);
  }
}

/**
 * Drop dead status_note_created + status_note_changed config keys.
 *
 * Both keys were exposed in the Open311 settings form and persisted on
 * save, but no consumer ever read them — the citizen-facing note bodies
 * are produced by service_request.module via translatable t() defaults
 * (with status-term description and field_initial_boilerplate as the
 * customisation path). Leaving the keys in tenant config after removing
 * their schema declarations would surface as schema warnings on every
 * cex/cim, so this hook clears them defensively. Tenants that never
 * touched the form already have no entries; nothing is lost in either
 * direction.
 */
function markaspot_open311_update_11807(): TranslatableMarkup {
  $config = \Drupal::configFactory()->getEditable('markaspot_open311.settings');
  $cleared = [];
  foreach (['status_note_created', 'status_note_changed'] as $key) {
    if ($config->get($key) !== NULL) {
      $config->clear($key);
      $cleared[] = $key;
    }
  }
  if ($cleared !== []) {
    // Plain save() — the cleared keys are no longer in the data array, so
    // schema validation iterates only over the remaining (well-schemaed)
    // keys. Avoid save(TRUE), whose trusted-data flag would mask future
    // schema regressions in unrelated keys.
    $config->save();
    return t('Cleared dead config keys: @keys.', ['@keys' => implode(', ', $cleared)]);
  }
  return t('No dead status_note_* config keys present; nothing to clear.');
}

/**
 * Grant 'access open311 full export' to the editorial_board role.
 *
 * The GeoReport API ?full parameter returns the complete service request
 * entity, including citizen PII. The gate now requires the dedicated
 * 'access open311 full export' permission instead of the broad
 * 'access open311 advanced properties' permission (which moderators also
 * hold). On fresh installs editorial_board receives the permission via its
 * shipped role config; this hook backfills existing sites. The administrator
 * role gets it implicitly through is_admin, so no explicit grant is needed
 * there. Moderator is intentionally left without the permission.
 */
function markaspot_open311_update_11808(): TranslatableMarkup {
  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('editorial_board');
  if ($role === NULL) {
    return t('Role editorial_board not present; nothing to grant.');
  }
  if ($role->hasPermission('access open311 full export')) {
    return t('Role editorial_board already has the full export permission.');
  }
  $role->grantPermission('access open311 full export')->save();
  return t('Granted "access open311 full export" to the editorial_board role.');
}

/**
 * Add gated internal status definition and status attribute fields.
 */
function markaspot_open311_update_11809(): TranslatableMarkup {
  $messages = [];
  $entity_type_manager = \Drupal::entityTypeManager();
  $field_storage = $entity_type_manager->getStorage('field_storage_config');
  $field_config = $entity_type_manager->getStorage('field_config');

  if (!$field_storage->load('taxonomy_term.field_status_definition')) {
    $field_storage->create([
      'field_name' => 'field_status_definition',
      'entity_type' => 'taxonomy_term',
      'type' => 'text_long',
      'cardinality' => 1,
      'translatable' => TRUE,
    ])->save();
    $messages[] = 'Created field_status_definition storage.';
  }

  if (!$field_config->load('taxonomy_term.service_status.field_status_definition')) {
    $field_config->create([
      'field_name' => 'field_status_definition',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'service_status',
      'label' => 'Status Definition Attributes',
      'description' => 'Internal process attributes to capture when this status is selected.',
      'required' => FALSE,
      'translatable' => TRUE,
    ])->save();
    $messages[] = 'Created field_status_definition on service_status.';
  }

  if (!$field_storage->load('paragraph.field_status_attributes')) {
    $storage = $field_storage->create([
      'field_name' => 'field_status_attributes',
      'entity_type' => 'paragraph',
      'type' => 'text_long',
      'cardinality' => 1,
      'translatable' => FALSE,
    ]);
    $storage->setThirdPartySetting('field_permissions', 'permission_type', 'custom');
    $storage->save();
    $messages[] = 'Created field_status_attributes storage with custom permissions.';
  }

  if (!$field_config->load('paragraph.status.field_status_attributes')) {
    $field_config->create([
      'field_name' => 'field_status_attributes',
      'entity_type' => 'paragraph',
      'bundle' => 'status',
      'label' => 'Status Attributes',
      'description' => 'JSON-encoded internal attributes captured during this status transition.',
      'required' => FALSE,
    ])->save();
    $messages[] = 'Created field_status_attributes on status paragraphs.';
  }

  $messages = array_merge($messages, _markaspot_open311_configure_status_attribute_surfaces());

  return new TranslatableMarkup('@messages', [
    '@messages' => implode(' ', $messages) ?: 'Status attribute fields already installed.',
  ]);
}

/**
 * Add api_key_auth to GET supported_auth for all GeoReport REST resources.
 *
 * The install configs only listed 'cookie' for GET methods. services_api_key_auth
 * headers are now used by the Nuxt proxy, so api_key_auth must also be allowed
 * or Drupal returns 403 "authentication method not allowed on this route".
 */
function markaspot_open311_update_11810(): TranslatableMarkup {
  $messages = [];
  $config_factory = \Drupal::configFactory();

  $rest_resources = [
    'rest.resource.georeport_request_resource',
    'rest.resource.georeport_request_index_resource',
    'rest.resource.georeport_service_index_resource',
    'rest.resource.georeport_discovery_resource',
  ];

  foreach ($rest_resources as $config_name) {
    $config = $config_factory->getEditable($config_name);
    if ($config->isNew()) {
      $messages[] = "$config_name not found, skipping.";
      continue;
    }

    $supported_auth = $config->get('configuration.GET.supported_auth') ?? [];
    if (!in_array('api_key_auth', $supported_auth, TRUE)) {
      array_unshift($supported_auth, 'api_key_auth');
      $config->set('configuration.GET.supported_auth', $supported_auth)->save();
      $messages[] = "Added api_key_auth to GET for $config_name.";
    }
    else {
      $messages[] = "$config_name already has api_key_auth for GET.";
    }
  }

  return new TranslatableMarkup('@messages', [
    '@messages' => implode(' ', $messages),
  ]);
}
