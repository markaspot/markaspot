<?php

/**
 * @file
 * Install, update and uninstall functions for markaspot_mail_inbound.
 *
 * The module ships the inbound_mail staging content entity. Drupal does not
 * auto-create the SQL schema for a content entity on a CONFIG-only install of
 * the module, so the schema is installed explicitly here in hook_install() for
 * fresh installs and via an update hook for sites that already had an earlier
 * version of this module.
 */

declare(strict_types=1);

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\markaspot_mail_inbound\Entity\InboundMail;

/**
 * Implements hook_requirements().
 *
 * Surfaces the active fidelity level of the email intake (the discoverability
 * promise from the rebuild design): whether IMAP is configured, whether the
 * geocoder is available, and the AI suggestion status. Runtime phase only.
 */
function markaspot_mail_inbound_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  $requirements = [];

  // The individual checks live in the shared fidelity service so the
  // dashboard API's "fidelity" block and this report never drift (#482).
  /** @var \Drupal\markaspot_mail_inbound\Service\MailIntakeFidelity $fidelity */
  $fidelity = \Drupal::service('markaspot_mail_inbound.fidelity');

  // IMAP mailbox configuration.
  /** @var \Drupal\markaspot_mail_inbound\Service\MailboxResolver $resolver */
  $resolver = \Drupal::service('markaspot_mail_inbound.mailbox_resolver');
  $mailboxes = $resolver->getMailboxes(TRUE);
  $withImap = $fidelity->imapConfigured()
    ? array_filter(
      $mailboxes,
      static fn(array $mailbox): bool => !empty($mailbox['imap']['host']) && !empty($mailbox['imap']['username'])
    )
    : [];

  if ($mailboxes === []) {
    $requirements['markaspot_mail_inbound_imap'] = [
      'title' => t('Mark-a-Spot inbound mail: IMAP'),
      'value' => t('No enabled mailbox configured'),
      'description' => t('Email intake is enabled but no mailbox is configured. Configure an IMAP mailbox at the inbound mail settings, or disable the module if intake is not wanted.'),
      'severity' => REQUIREMENT_WARNING,
    ];
  }
  elseif ($withImap === []) {
    $requirements['markaspot_mail_inbound_imap'] = [
      'title' => t('Mark-a-Spot inbound mail: IMAP'),
      'value' => t('Mailbox(es) configured without IMAP credentials'),
      'description' => t('Mailboxes exist but none have an IMAP host and username, so cron cannot fetch mail. Complete the IMAP connection or supply the credentials out-of-band.'),
      'severity' => REQUIREMENT_WARNING,
    ];
  }
  else {
    $requirements['markaspot_mail_inbound_imap'] = [
      'title' => t('Mark-a-Spot inbound mail: IMAP'),
      'value' => t('@count mailbox(es) ready to fetch', ['@count' => count($withImap)]),
      'severity' => REQUIREMENT_OK,
    ];
  }

  // Geocoder availability (info: ungeolocated fallback when absent).
  $hasGeocoder = \Drupal::hasService('markaspot_geocoder.geocoder');
  $requirements['markaspot_mail_inbound_geocoder'] = [
    'title' => t('Mark-a-Spot inbound mail: geocoding'),
    'value' => $hasGeocoder
      ? t('Geocoder available')
      : t('Geocoder unavailable (reports stay ungeolocated)'),
    'description' => $hasGeocoder
      ? t('Promoted mails with a trivial address in the text are geocoded; the rest are completed in moderation.')
      : t('The markaspot_geocoder module is not available, so promoted email reports have no coordinates and are located in the moderation queue.'),
    'severity' => REQUIREMENT_OK,
  ];

  // AI suggestion status (Phase 2: suggest-first, auto-promote default off).
  /** @var \Drupal\markaspot_mail_inbound\Service\MailIntakeFidelity $fidelity */
  $aiAvailable = $fidelity->aiAvailable();
  $settings = \Drupal::config('markaspot_mail_inbound.settings');
  $autoPromote = (bool) ($settings->get('auto_promote_enabled') ?? FALSE);
  if ($aiAvailable) {
    $requirements['markaspot_mail_inbound_categorization'] = [
      'title' => t('Mark-a-Spot inbound mail: AI categorization'),
      'value' => $autoPromote
        ? t('AI suggestions active (auto-promote ON, threshold @threshold)', [
          '@threshold' => $settings->get('auto_promote_confidence_threshold') ?? 0.85,
        ])
        : t('AI suggestions active (auto-promote OFF – manual promotion required)'),
      'description' => t('Staged emails receive an AI category suggestion. Moderators see the suggestion in the triage inbox. Auto-promote is separately gated by the confidence threshold and requires a promotable (coded) category.'),
      'severity' => REQUIREMENT_OK,
    ];
  }
  else {
    $requirements['markaspot_mail_inbound_categorization'] = [
      'title' => t('Mark-a-Spot inbound mail: AI categorization'),
      'value' => t('AI suggestions inactive'),
      'description' => t('AI category suggestions are disabled (ai_suggestions_enabled=false) or no AI service is wired (markaspot_vision / markaspot_ai). Staged emails are categorized manually.'),
      'severity' => REQUIREMENT_INFO,
    ];
  }

  // Outbound return channel (#482): when no mail plugin is configured the
  // reply endpoints degrade to record-only ("in-system notes only, no send").
  $hasOutbound = $fidelity->outboundAvailable();
  $requirements['markaspot_mail_inbound_outbound'] = [
    'title' => t('Mark-a-Spot inbound mail: return channel'),
    'value' => $hasOutbound
      ? t('Outbound mail available (replies and auto-replies are sent)')
      : t('Outbound mail unavailable (replies are recorded as in-system notes only)'),
    'description' => $hasOutbound
      ? t('Staff replies, the missing-location auto-reply and status notifications to email citizens go out over the configured mail system.')
      : t('No default mail plugin is configured, so the triage reply channel records replies on the conversation log without sending. Configure the mail system (e.g. PHPMailer SMTP) to enable the return channel.'),
    'severity' => $hasOutbound ? REQUIREMENT_OK : REQUIREMENT_WARNING,
  ];

  // Private filesystem: staged citizen photos must not be publicly reachable
  // before a moderator promotes the mail (review HIGH 1). Without the private
  // filesystem they are stored in a public subdir only protected by an
  // .htaccess deny rule, which not every web server honors.
  $hasPrivate = $fidelity->privateFilesystemConfigured();
  $requirements['markaspot_mail_inbound_private_files'] = [
    'title' => t('Mark-a-Spot inbound mail: staged attachment privacy'),
    'value' => $hasPrivate
      ? t('Private filesystem configured (staged photos are access-restricted)')
      : t('Private filesystem NOT configured'),
    'description' => $hasPrivate
      ? t('Staged email attachments are kept in private://mail-inbound-staged/ until promotion, so citizen photos are not downloadable before moderation.')
      : t('Staged email attachments fall back to a public subdir hardened only with an .htaccess deny rule. Configure the private filesystem (settings.php: $settings["file_private_path"]) so staged citizen photos are properly access-restricted before moderation.'),
    'severity' => $hasPrivate ? REQUIREMENT_OK : REQUIREMENT_WARNING,
  ];

  // Permission scoping: resolved in Phase 2 (#482/#489). The
  // InboundMailAccessControlHandler scopes view/update/delete on a mail to
  // members of its jurisdiction; the dashboard API additionally scopes its
  // collection query. Global admins (uid 1 / administrator) bypass. If the
  // scope validator is unavailable, scoped mail fails closed for non-global
  // users rather than falling back to global triage access.
  $scopeValidatorAvailable = \Drupal::hasService('markaspot_group.jurisdiction_scope_validator');
  $requirements['markaspot_mail_inbound_permission_scope'] = [
    'title' => t('Mark-a-Spot inbound mail: permission scope'),
    'value' => $scopeValidatorAvailable
      ? t('Triage access is jurisdiction-scoped')
      : t('Scope validator unavailable (scoped mail fails closed)'),
    'description' => $scopeValidatorAvailable
      ? t('A "triage inbound mail" holder can only see and act on mail of jurisdictions they are a member of (plus mail without a jurisdiction). Site administrators see everything.')
      : t('The jurisdiction scope validator service is unavailable. Non-admin triage users can only see mail without a jurisdiction until markaspot_group scope services are restored.'),
    'severity' => $scopeValidatorAvailable ? REQUIREMENT_INFO : REQUIREMENT_WARNING,
  ];

  return $requirements;
}

/**
 * Implements hook_install().
 *
 * Installs the inbound_mail entity schema for fresh installs.
 */
function markaspot_mail_inbound_install(): void {
  _markaspot_mail_inbound_install_inbound_mail_entity();
  _markaspot_mail_inbound_configure_service_request_source_jsonapi();
}

/**
 * Implements hook_uninstall().
 *
 * Removes all inbound_mail entities AND their attachment files. Staged
 * attachments are PERMANENT managed files without a usage entry (see
 * MailIngestOrchestrator::persistAttachmentFiles(): temporary files would be
 * garbage-collected mid-triage), so file GC never touches them — they must be
 * deleted explicitly here. Promoted mails carry no attachment references any
 * more (their files belong to request_image media and survive). The entity
 * type's SQL schema is removed by core when the entity type definition
 * disappears with the module.
 */
function markaspot_mail_inbound_uninstall(): void {
  $entityTypeManager = \Drupal::entityTypeManager();
  if (!$entityTypeManager->hasDefinition('inbound_mail')) {
    return;
  }
  $storage = $entityTypeManager->getStorage('inbound_mail');
  $fileStorage = $entityTypeManager->hasDefinition('file')
    ? $entityTypeManager->getStorage('file')
    : NULL;

  // Delete in bounded batches rather than loading every record at once
  // (review LOW 10): a busy mailbox can accumulate a large backlog, and an
  // unpaginated loadMultiple() would exhaust memory on uninstall.
  $deleted = 0;
  do {
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->range(0, 50)
      ->execute();
    if ($ids === []) {
      break;
    }
    $mails = $storage->loadMultiple($ids);
    if ($fileStorage !== NULL) {
      $fids = [];
      foreach ($mails as $mail) {
        foreach ($mail->get('attachment_files') as $item) {
          if (!empty($item->target_id)) {
            $fids[] = (int) $item->target_id;
          }
        }
      }
      if ($fids !== []) {
        $files = $fileStorage->loadMultiple(array_unique($fids));
        if ($files !== []) {
          $fileStorage->delete($files);
        }
      }
    }
    $storage->delete($mails);
    $deleted += count($ids);
  } while (count($ids) === 50);

  if ($deleted > 0) {
    \Drupal::logger('markaspot_mail_inbound')->notice('Deleted @count inbound mail record(s) on uninstall.', [
      '@count' => $deleted,
    ]);
  }
}

/**
 * Installs the inbound_mail content entity schema.
 *
 * Idempotent: only installs the entity type when its schema is not yet known
 * to the entity definition update manager.
 */
function _markaspot_mail_inbound_install_inbound_mail_entity(): void {
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  if ($updateManager->getEntityType('inbound_mail') !== NULL) {
    // Already installed.
    return;
  }
  $entityType = \Drupal::entityTypeManager()->getDefinition('inbound_mail');
  $updateManager->installEntityType($entityType);
}

/**
 * Install the inbound_mail staging entity (rebuild, issue #467).
 *
 * Sites that ran an earlier cut of markaspot_mail_inbound (which created a
 * service request directly and had no staging entity) get the new
 * inbound_mail table here.
 */
function markaspot_mail_inbound_update_11901(): string {
  _markaspot_mail_inbound_install_inbound_mail_entity();
  return (string) t('Installed the inbound_mail staging entity schema.');
}

/**
 * Enable the missing-location auto-reply by default (Phase 2, #482).
 *
 * Fresh installs get the flag from config/install; sites that installed the
 * Phase 1 cut receive the documented default (TRUE) here. Operators can turn
 * it off on the inbound mail settings form.
 */
function markaspot_mail_inbound_update_11902(): string {
  $config = \Drupal::configFactory()->getEditable('markaspot_mail_inbound.settings');
  if ($config->get('auto_reply_missing_location') === NULL) {
    $config->set('auto_reply_missing_location', TRUE)->save(TRUE);
  }
  return (string) t('Enabled the missing-location auto-reply (default).');
}

/**
 * Disable the inbound_mail JSON:API resource on existing installs (#482).
 *
 * The inbound_mail entity carries unredacted citizen content; its only HTTP
 * surface is the custom triage API. Fresh installs get the disabled
 * jsonapi_extras.jsonapi_resource_config from config/install; existing
 * installs receive it here. Idempotent: an existing resource config (however
 * configured) is left untouched.
 */
function markaspot_mail_inbound_update_11903(): string {
  if (!\Drupal::moduleHandler()->moduleExists('jsonapi_extras')) {
    // jsonapi_extras is a profile guarantee (and now an info.yml dependency),
    // but never break updb over a missing optional surface tweak.
    return (string) t('jsonapi_extras is not installed; nothing to do.');
  }
  $storage = \Drupal::entityTypeManager()->getStorage('jsonapi_resource_config');
  if ($storage->load('inbound_mail--inbound_mail') !== NULL) {
    return (string) t('The inbound_mail JSON:API resource config already exists; left untouched.');
  }
  $storage->create([
    'id' => 'inbound_mail--inbound_mail',
    'disabled' => TRUE,
    'path' => 'inbound_mail/inbound_mail',
    'resourceType' => 'inbound_mail--inbound_mail',
    'resourceFields' => [],
  ])->save();
  return (string) t('Disabled the inbound_mail JSON:API resource.');
}

/**
 * Add AI suggestion fields to inbound_mail and seed the new settings (#482).
 *
 * Installs four new base fields:
 *   - suggested_category (entity_reference → taxonomy_term)
 *   - suggestion_confidence (float, nullable)
 *   - suggestion_status (list_string: none|pending|done|failed|skipped)
 *   - suggested_address (string, nullable)
 *
 * Also seeds the three new config keys for existing installs (fresh installs
 * receive them from config/install):
 *   - ai_suggestions_enabled  (default TRUE)
 *   - auto_promote_enabled    (default FALSE)
 *   - auto_promote_confidence_threshold (default 0.85)
 */
function markaspot_mail_inbound_update_11904(): string {
  $updateManager = \Drupal::entityDefinitionUpdateManager();

  $fields = [];

  // suggested_category: entity_reference → taxonomy_term.
  $fields['suggested_category'] = BaseFieldDefinition::create('entity_reference')
    ->setLabel(t('Suggested category'))
    ->setDescription(t('The AI-suggested service category term.'))
    ->setSetting('target_type', 'taxonomy_term')
    ->setSetting('handler', 'default');

  // suggestion_confidence: float (nullable).
  $fields['suggestion_confidence'] = BaseFieldDefinition::create('float')
    ->setLabel(t('Suggestion confidence'))
    ->setDescription(t('Confidence score (0–1) for the AI category suggestion.'));

  // suggestion_status: list_string with default "none".
  $fields['suggestion_status'] = BaseFieldDefinition::create('list_string')
    ->setLabel(t('Suggestion status'))
    ->setDescription(t('Lifecycle of the AI categorization attempt.'))
    ->setSetting('allowed_values', [
      InboundMail::SUGGESTION_NONE => t('None'),
      InboundMail::SUGGESTION_PENDING => t('Pending'),
      InboundMail::SUGGESTION_DONE => t('Done'),
      InboundMail::SUGGESTION_FAILED => t('Failed'),
      InboundMail::SUGGESTION_SKIPPED => t('Skipped'),
    ])
    ->setDefaultValue(InboundMail::SUGGESTION_NONE);

  // suggested_address: plain string (nullable).
  $fields['suggested_address'] = BaseFieldDefinition::create('string')
    ->setLabel(t('Suggested address'))
    ->setDescription(t('NER-extracted address from AI text classification.'))
    ->setSetting('max_length', 500);

  $installed = [];
  foreach ($fields as $name => $definition) {
    if ($updateManager->getFieldStorageDefinition($name, 'inbound_mail') === NULL) {
      $updateManager->installFieldStorageDefinition($name, 'inbound_mail', 'markaspot_mail_inbound', $definition);
      $installed[] = $name;
    }
  }

  // Seed the three new config keys for existing installs. Fresh installs
  // already receive them from config/install/markaspot_mail_inbound.settings.yml.
  $config = \Drupal::configFactory()->getEditable('markaspot_mail_inbound.settings');
  $seeded = [];
  if ($config->get('ai_suggestions_enabled') === NULL) {
    $config->set('ai_suggestions_enabled', TRUE);
    $seeded[] = 'ai_suggestions_enabled=true';
  }
  if ($config->get('auto_promote_enabled') === NULL) {
    $config->set('auto_promote_enabled', FALSE);
    $seeded[] = 'auto_promote_enabled=false';
  }
  if ($config->get('auto_promote_confidence_threshold') === NULL) {
    $config->set('auto_promote_confidence_threshold', 0.85);
    $seeded[] = 'auto_promote_confidence_threshold=0.85';
  }
  if ($seeded !== []) {
    $config->save(TRUE);
  }

  $parts = [];
  if ($installed !== []) {
    $parts[] = 'Installed fields: ' . implode(', ', $installed) . '.';
  }
  if ($seeded !== []) {
    $parts[] = 'Seeded config: ' . implode(', ', $seeded) . '.';
  }
  return $parts !== []
    ? implode(' ', $parts)
    : (string) t('AI suggestion fields and config already installed; nothing to do.');
}

/**
 * Add suggested_description field to inbound_mail (#482).
 *
 * Stores the AI-generated neutral problem description that replaces the raw
 * mail text in the promoted node's public body. When the field is non-empty,
 * the promoter uses it as the description; otherwise it falls back to the
 * original mail text (today's behavior). The citizen's exact wording is ALWAYS
 * preserved as an internal remark on promotion regardless of which path was
 * taken.
 */
function markaspot_mail_inbound_update_11905(): string {
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  if ($updateManager->getFieldStorageDefinition('suggested_description', 'inbound_mail') !== NULL) {
    return (string) t('The suggested_description field already exists; nothing to do.');
  }
  $definition = BaseFieldDefinition::create('string_long')
    ->setLabel(t('Suggested description'))
    ->setDescription(t('AI-generated neutral problem description for the public report, without salutation, sign-off, names or other PII. Used as the promoted node body when non-empty; falls back to the original mail text.'));
  $updateManager->installFieldStorageDefinition('suggested_description', 'inbound_mail', 'markaspot_mail_inbound', $definition);
  return (string) t('Installed the suggested_description field on inbound_mail.');
}

/**
 * Expose the service_request source channel in JSON:API (#467).
 *
 * Existing tenants already have the node--service_request resource config; the
 * fresh-install config/optional change alone would not update them. Load and
 * mutate that config entity so jsonapi_extras rebuilds its resource metadata.
 */
function markaspot_mail_inbound_update_11906(): string {
  return _markaspot_mail_inbound_configure_service_request_source_jsonapi();
}

/**
 * Enables field_source and pins raw email message-id off for service requests.
 *
 * @return string
 *   Human-readable result for update hooks.
 */
function _markaspot_mail_inbound_configure_service_request_source_jsonapi(): string {
  if (!\Drupal::entityTypeManager()->hasDefinition('jsonapi_resource_config')) {
    return (string) t('Skipped node--service_request JSON:API resource config: jsonapi_extras not enabled on this tenant.');
  }

  $storage = \Drupal::entityTypeManager()->getStorage('jsonapi_resource_config');
  $resource = $storage->load('node--service_request');
  if (!$resource) {
    return (string) t('Skipped node--service_request JSON:API resource config: resource not enabled on this tenant.');
  }

  $fields = $resource->get('resourceFields') ?? [];
  $fields = is_array($fields) ? $fields : [];
  $original_fields = $fields;
  $fields['field_source'] = [
    'disabled' => FALSE,
    'fieldName' => 'field_source',
    'publicName' => 'field_source',
    'enhancer' => [
      'id' => '',
    ],
  ];
  $fields['field_email_message_id'] = [
    'disabled' => TRUE,
    'fieldName' => 'field_email_message_id',
    'publicName' => 'field_email_message_id',
    'enhancer' => [
      'id' => '',
    ],
  ];

  if ($original_fields === $fields) {
    return (string) t('The service_request source JSON:API resource field is already configured.');
  }

  $resource->set('resourceFields', $fields);
  $resource->save();

  return (string) t('Enabled service_request field_source and disabled field_email_message_id on the JSON:API resource.');
}
