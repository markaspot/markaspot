<?php

/**
 * @file
 * Inbound email-to-report pipeline for Mark-a-Spot.
 *
 * Cron fetches unseen messages from configured IMAP mailboxes and enqueues
 * the raw sources. Parsing and staging into the inbound_mail triage inbox
 * happen in the queue worker (markaspot_mail_inbound), never in cron itself.
 * Promotion of a staged mail to a service request is a separate, explicit
 * moderator action in the triage inbox.
 */

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function markaspot_mail_inbound_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.markaspot_mail_inbound':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Citizens email a configured address, cron fetches the mailbox via IMAP and each genuine message is staged as an inbound mail in the triage inbox. A moderator categorizes a staged mail to promote it to an unpublished service request, or discards it. Auto-replies, bulk and mailing-list mail are filtered out by a heuristic. Replies thread back onto the staged mail or onto the promoted request via Message-ID matching.') . '</p>';
      $output .= '<p>' . t('Test locally without IMAP: <code>drush markaspot:mail-inbound:ingest message.eml --mailbox=ID</code>.') . '</p>';
      return $output;
  }
  return NULL;
}

/**
 * Implements hook_mail().
 *
 * The return channel (#482): triage_reply (a staff answer to a staged mail)
 * and auto_reply_missing_location (the automatic location request after an
 * ungeolocated promotion). InboundMailReplyService assembles the params:
 * subject, body, the threading headers (Message-ID / In-Reply-To /
 * References) and the jurisdiction From / Reply-To. When markaspot_mail is
 * enabled its MailAlterHook re-brands the body via the tagged
 * TriageReplyBuilder and re-asserts Reply-To from the jurisdiction branding
 * (the same field_jurisdiction_e_mail address set here, so the jurisdiction
 * address wins on both paths).
 */
function markaspot_mail_inbound_mail(string $key, array &$message, array $params): void {
  if (!in_array($key, ['triage_reply', 'auto_reply_missing_location'], TRUE)) {
    return;
  }
  $message['subject'] = (string) ($params['subject'] ?? '');
  $message['body'][] = (string) ($params['body'] ?? '');
  foreach (($params['headers'] ?? []) as $name => $value) {
    // Values are pre-sanitized by InboundMailReplyService; strip CR/LF/NUL
    // again as the last line of defense against header injection.
    $message['headers'][$name] = str_replace(["\r", "\n", "\0"], '', (string) $value);
  }
  if (!empty($params['from'])) {
    $message['from'] = str_replace(["\r", "\n", "\0"], '', (string) $params['from']);
  }
}

/**
 * Implements hook_mail_alter().
 *
 * Threads OTHER modules' outgoing node mails (status notifications, ECA
 * action mails) into an email-origin citizen's conversation by adding
 * Message-ID / In-Reply-To / References headers from the inbound mail's
 * thread chain. Conservative: only acts when the message demonstrably
 * relates to a promoted email-origin service request AND goes to the
 * verified reporter; everything else is left untouched. See
 * OutboundMailThreader.
 */
function markaspot_mail_inbound_mail_alter(array &$message): void {
  \Drupal::service('markaspot_mail_inbound.outbound_threader')->alter($message);
}

/**
 * Implements hook_cron().
 *
 * Keeps cron lean: connect, enqueue raw messages, done. A failing mailbox is
 * logged by the fetcher and never crashes cron or blocks other mailboxes.
 */
function markaspot_mail_inbound_cron(): void {
  /** @var \Drupal\markaspot_mail_inbound\Service\MailboxResolver $resolver */
  $resolver = \Drupal::service('markaspot_mail_inbound.mailbox_resolver');
  /** @var \Drupal\markaspot_mail_inbound\Service\MailboxFetcher $fetcher */
  $fetcher = \Drupal::service('markaspot_mail_inbound.fetcher');

  foreach ($resolver->getMailboxes() as $mailbox) {
    if (empty($mailbox['imap']['host']) || empty($mailbox['imap']['username'])) {
      continue;
    }
    $fetcher->fetchMailbox($mailbox);
  }
}
