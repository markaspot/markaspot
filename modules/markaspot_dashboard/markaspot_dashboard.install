<?php

/**
 * @file
 * Install and update functions for markaspot_dashboard.
 */

use Drupal\Core\Config\FileStorage;

/**
 * Implements hook_schema().
 */
function markaspot_dashboard_schema(): array {
  $schema['markaspot_request_links'] = [
    'description' => 'Links a service request to a sibling created via staff split (#512). Direction is meaningful: source_nid is always the original request, target_nid the split-off child.',
    'fields' => [
      'id' => [
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'source_nid' => [
        'description' => 'Node ID of the original service request.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'target_nid' => [
        'description' => 'Node ID of the split-off child service request.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'link_type' => [
        'description' => 'The link relationship type, e.g. "split".',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'split',
      ],
      'uid' => [
        'description' => 'User ID who performed the split.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'created' => [
        'description' => 'Unix timestamp when the link was created.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'source_target_type' => ['source_nid', 'target_nid', 'link_type'],
    ],
    'indexes' => [
      'source' => ['source_nid'],
      'target' => ['target_nid'],
    ],
    'foreign keys' => [
      'source_node' => [
        'table' => 'node',
        'columns' => ['source_nid' => 'nid'],
      ],
      'target_node' => [
        'table' => 'node',
        'columns' => ['target_nid' => 'nid'],
      ],
      'author' => [
        'table' => 'users',
        'columns' => ['uid' => 'uid'],
      ],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 *
 * Ensures field_author exists on the status and internal_remark paragraph
 * types on fresh installs. Update hooks do not run on a fresh site install,
 * so without this hook a clean install could lack the field, breaking the Pro
 * dashboard request detail (JSON:API includes field_status_notes.field_author
 * and field_internal_remark.field_author).
 */
function markaspot_dashboard_install(): void {
  _markaspot_dashboard_ensure_field_author('status');
  _markaspot_dashboard_ensure_field_author('internal_remark');
  _markaspot_dashboard_grant_contractor_status_note_permission();
}

/**
 * Grants the dashboard note-create permission after the module is enabled.
 *
 * The profile creates the contractor role even when this optional module is
 * disabled. Drupal drops permissions owned by disabled modules, so the role
 * must be repaired when markaspot_dashboard is enabled later.
 *
 * @return bool
 *   TRUE when the contractor role was changed.
 */
function _markaspot_dashboard_grant_contractor_status_note_permission(): bool {
  $role = \Drupal::entityTypeManager()
    ->getStorage('user_role')
    ->load('contractor');
  if (!$role || $role->hasPermission('add dashboard status notes')) {
    return FALSE;
  }

  $role->grantPermission('add dashboard status notes');
  $role->save();
  return TRUE;
}

/**
 * Add field_author (entity_reference to user) on status paragraph type.
 *
 * StatusNoteController sets field_author on paragraph creation. This hook
 * ensures the field storage and instance exist on sites that enabled the
 * module before the field config was shipped.
 */
function markaspot_dashboard_update_11900(): void {
  _markaspot_dashboard_ensure_field_author('status');
}

/**
 * Creates the markaspot_request_links table and grants the split permission.
 *
 * Sites that already ran hook_install() before #512 shipped need the table
 * created here (hook_schema() only creates it on a fresh install). Grants
 * 'split service requests' to existing tenant_admin/moderator/editorial_board
 * roles, mirroring markaspot_ai_update_11900()'s AI-permission backfill: the
 * config/optional grants only apply on install, never to a pre-existing role.
 */
function markaspot_dashboard_update_11901(): string {
  $schema = \Drupal::database()->schema();

  if (!$schema->tableExists('markaspot_request_links')) {
    // Inlined rather than calling markaspot_dashboard_schema(): an update
    // hook must stay self-contained even if the current schema function
    // changes later (matches markaspot_ai_update_10001's convention).
    $table_schema = [
      'description' => 'Links a service request to a sibling created via staff split (#512). Direction is meaningful: source_nid is always the original request, target_nid the split-off child.',
      'fields' => [
        'id' => [
          'description' => 'Primary key.',
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'source_nid' => [
          'description' => 'Node ID of the original service request.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'target_nid' => [
          'description' => 'Node ID of the split-off child service request.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'link_type' => [
          'description' => 'The link relationship type, e.g. "split".',
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'default' => 'split',
        ],
        'uid' => [
          'description' => 'User ID who performed the split.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
        'created' => [
          'description' => 'Unix timestamp when the link was created.',
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
      'primary key' => ['id'],
      'unique keys' => [
        'source_target_type' => ['source_nid', 'target_nid', 'link_type'],
      ],
      'indexes' => [
        'source' => ['source_nid'],
        'target' => ['target_nid'],
      ],
      'foreign keys' => [
        'source_node' => [
          'table' => 'node',
          'columns' => ['source_nid' => 'nid'],
        ],
        'target_node' => [
          'table' => 'node',
          'columns' => ['target_nid' => 'nid'],
        ],
        'author' => [
          'table' => 'users',
          'columns' => ['uid' => 'uid'],
        ],
      ],
    ];
    $schema->createTable('markaspot_request_links', $table_schema);
  }

  $role_storage = \Drupal::entityTypeManager()->getStorage('user_role');
  $granted = [];
  foreach (['tenant_admin', 'moderator', 'editorial_board'] as $role_id) {
    $role = $role_storage->load($role_id);
    if (!$role || $role->hasPermission('split service requests')) {
      continue;
    }
    $role->grantPermission('split service requests');
    $role->save();
    $granted[] = $role_id;
  }

  return $granted
    ? 'Created markaspot_request_links table and granted "split service requests" to: ' . implode(', ', $granted) . '.'
    : 'Created markaspot_request_links table. No target roles needed the permission grant.';
}

/**
 * Restores field_author on the status and internal_remark paragraph types.
 *
 * Sites whose config sync never carried the field lose it on the next config
 * import, even after 11900 and markaspot_escalation_update_10003 created it
 * (fastmap). The dashboard requests both author includes on every detail view,
 * so a missing instance costs one 400 and a retry each, and status notes are
 * written without their author. Idempotent; missing bundles are skipped.
 */
function markaspot_dashboard_update_11902(): void {
  _markaspot_dashboard_ensure_field_author('status');
  _markaspot_dashboard_ensure_field_author('internal_remark');
}

/**
 * Creates field_author on a paragraph bundle if missing.
 *
 * Shared helper: field storage is created once, instances per bundle. Both
 * are seeded from the YAML shipped in markaspot_status_paragraph, so a site
 * repaired here exports the same config as a site installed from it.
 *
 * @param string $bundle
 *   The paragraph type machine name.
 */
function _markaspot_dashboard_ensure_field_author(string $bundle): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_dashboard');

  // Skip if the paragraph type does not exist.
  if (!$etm->getStorage('paragraphs_type')->load($bundle)) {
    $logger->notice('Paragraph type @bundle not found, skipping field_author.', [
      '@bundle' => $bundle,
    ]);
    return;
  }

  $source = new FileStorage(dirname(__DIR__) . '/markaspot_status_paragraph/config/install');

  // Ensure field storage exists.
  $storage_handler = $etm->getStorage('field_storage_config');
  $field_storage = $storage_handler->load('paragraph.field_author');
  if (!$field_storage) {
    $record = $source->read('field.storage.paragraph.field_author');
    $field_storage = $record
      ? $storage_handler->createFromStorageRecord($record)
      : $storage_handler->create([
        'field_name' => 'field_author',
        'entity_type' => 'paragraph',
        'type' => 'entity_reference',
        'settings' => ['target_type' => 'user'],
        'cardinality' => 1,
      ]);
    $field_storage->save();
    $logger->info('Created field storage paragraph.field_author.');
  }

  // Create field instance.
  $field_handler = $etm->getStorage('field_config');
  if (!$field_handler->load("paragraph.{$bundle}.field_author")) {
    $record = $source->read("field.field.paragraph.{$bundle}.field_author");
    $field = $record
      ? $field_handler->createFromStorageRecord($record)
      : $field_handler->create([
        'field_storage' => $field_storage,
        'bundle' => $bundle,
        'label' => 'Author',
        'description' => 'The user who created this paragraph.',
        'required' => FALSE,
        'translatable' => TRUE,
        'settings' => [
          'handler' => 'default:user',
          'handler_settings' => ['include_anonymous' => FALSE],
        ],
      ]);
    $field->save();
    $logger->info('Created field instance paragraph.@bundle.field_author.', [
      '@bundle' => $bundle,
    ]);
  }
}
