<?php

/**
 * @file
 * Access hooks for the Mark-a-Spot dashboard module.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\group\Entity\GroupInterface;
use Drupal\node\NodeInterface;
use Symfony\Component\Routing\RouteCollection;

/**
 * Implements hook_route_alter().
 *
 * The maintenance switch itself is dashboard-owned and must always retain the
 * Core CSRF-token endpoint, even on installations that do not enable the
 * optional passwordless module. Without this exemption the cookie + CSRF
 * protected PATCH route cannot bring the installation back online.
 */
function markaspot_dashboard_route_alter(RouteCollection $collection): void {
  $route = $collection->get('system.csrftoken');
  if ($route) {
    $route->setOption('_maintenance_access', TRUE);
  }
}

/**
 * Implements hook_entity_access().
 *
 * Three layers of defense for internal_remark paragraphs:
 *  - view/update/delete require the corresponding field_permissions grant,
 *    view additionally membership in the request's jurisdiction
 *  - update/delete additionally require authorship OR 'administer nodes'
 *    so a staff member with the bare grant cannot rewrite peers' remarks
 *    via direct JSON:API PATCH/DELETE
 *  - create is gated separately in hook_entity_create_access() below
 */
function markaspot_dashboard_entity_access(EntityInterface $entity, $operation, AccountInterface $account): AccessResultInterface {
  if ($entity->getEntityTypeId() !== 'paragraph' || $entity->bundle() !== 'internal_remark') {
    return AccessResult::neutral();
  }

  $permissions = [
    'view' => 'view field_internal_remark',
    'update' => 'edit field_internal_remark',
    'delete' => 'edit field_internal_remark',
  ];
  if (!isset($permissions[$operation])) {
    return AccessResult::neutral();
  }

  if (!$account->hasPermission($permissions[$operation])) {
    return AccessResult::forbidden()->cachePerPermissions();
  }

  if ($operation === 'view') {
    $parent = method_exists($entity, 'getParentEntity') ? $entity->getParentEntity() : NULL;
    return _markaspot_dashboard_jurisdiction_staff_access($account, $parent, $permissions['view'])
      ->addCacheableDependency($entity);
  }

  // Authorship gate for write operations. The custom InternalRemarkController
  // applies the same check, but the direct JSON:API path bypasses that
  // controller — without this gate any staff member with the bare grant
  // could silently rewrite peers' remarks (IDOR).
  if (in_array($operation, ['update', 'delete'], TRUE)) {
    if ($account->hasPermission('administer nodes')) {
      return AccessResult::neutral()->cachePerPermissions();
    }
    $author_id = (int) ($entity->get('field_author')->target_id ?? 0);
    $is_author = $author_id !== 0 && $author_id === (int) $account->id();
    $result = $is_author
      ? AccessResult::neutral()
      : AccessResult::forbidden('Only the remark author or an administrator may modify this remark.');
    return $result
      ->cachePerUser()
      ->addCacheableDependency($entity);
  }

  return AccessResult::neutral()->cachePerPermissions();
}

/**
 * Implements hook_entity_create_access().
 *
 * hook_entity_access() never receives the "create" operation, so creation of
 * internal_remark paragraphs is gated here. Staff create remarks through the
 * route-gated InternalRemarkController; this closes direct creation paths
 * (e.g. JSON:API) for accounts without edit access.
 */
function markaspot_dashboard_entity_create_access(AccountInterface $account, array $context, $entity_bundle): AccessResultInterface {
  if (($context['entity_type_id'] ?? NULL) !== 'paragraph' || $entity_bundle !== 'internal_remark') {
    return AccessResult::neutral();
  }

  return AccessResult::forbiddenIf(!$account->hasPermission('edit field_internal_remark'))
    ->cachePerPermissions();
}

/**
 * Implements hook_entity_field_access().
 *
 * Backstop for the node-level field_internal_remark reference field. It does
 * not depend on the field_permissions UI setting, mirroring the gate that
 * markaspot_open311 applies to field_status_attributes, so the remark text
 * stays staff-only even if that setting is changed. Viewing is further
 * limited to staff of the request's jurisdiction: self-signup sites grant
 * the remark permissions through a global role to every workspace admin.
 */
function markaspot_dashboard_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  if (
    $field_definition->getName() === 'field_author'
    && $field_definition->getTargetEntityTypeId() === 'paragraph'
  ) {
    return _markaspot_dashboard_paragraph_author_access($operation, $account, $items);
  }

  if (
    in_array($operation, ['view', 'edit'], TRUE)
    && $field_definition->getName() === 'field_internal_remark'
    && $field_definition->getTargetEntityTypeId() === 'node'
  ) {
    if ($operation === 'view') {
      return _markaspot_dashboard_jurisdiction_staff_access($account, $items?->getEntity(), 'view field_internal_remark');
    }
    return AccessResult::forbiddenIf(!$account->hasPermission('edit field_internal_remark'))
      ->cachePerPermissions();
  }

  return AccessResult::neutral();
}

/**
 * Field access for field_author on status and internal_remark paragraphs.
 *
 * The author is set server-side only, and it doubles as the authorship gate
 * for internal remarks, so edit is always forbidden. JSON:API falls back to a
 * label-only user object when view access to the user is denied, and user
 * labels are usernames (email addresses on self-signup sites), so view is
 * restricted like the node uid in markaspot_open311_entity_field_access().
 */
function _markaspot_dashboard_paragraph_author_access(string $operation, AccountInterface $account, ?FieldItemListInterface $items): AccessResultInterface {
  if ($operation !== 'view') {
    return AccessResult::forbidden('The paragraph author is set server-side only.');
  }

  $paragraph = $items?->getEntity();
  $parent = $paragraph && method_exists($paragraph, 'getParentEntity') ? $paragraph->getParentEntity() : NULL;
  $result = _markaspot_dashboard_jurisdiction_staff_access($account, $parent, 'access open311 advanced properties');
  return $paragraph ? $result->addCacheableDependency($paragraph) : $result;
}

/**
 * Limits access to staff currently responsible for the service request.
 *
 * Site operators with 'administer nodes' pass. Everyone else needs the given
 * permission and membership in the jurisdiction the request resolves to now,
 * or in one of its responsible organisations. Responsibility is checked
 * against the request's current assignment, so after a handover the new
 * jurisdiction or organisation sees earlier remarks and the previous one
 * loses them unless it is still a member. Fails closed without a request,
 * which covers filters and sorts.
 *
 * @param \Drupal\Core\Session\AccountInterface $account
 *   The viewer.
 * @param \Drupal\Core\Entity\EntityInterface|null $node
 *   The service request, or NULL when there is no entity context.
 * @param string $permission
 *   The staff permission required besides membership.
 */
function _markaspot_dashboard_jurisdiction_staff_access(AccountInterface $account, ?EntityInterface $node, string $permission): AccessResultInterface {
  if ($account->hasPermission('administer nodes')) {
    return AccessResult::neutral()->cachePerPermissions();
  }

  if (!$account->hasPermission($permission)) {
    return AccessResult::forbidden('Restricted to dashboard staff.')
      ->cachePerPermissions();
  }

  if (!$node instanceof NodeInterface) {
    return AccessResult::forbidden('Staff access requires a service request context.')
      ->cachePerPermissions()
      ->addCacheContexts(['user'])
      ->setCacheMaxAge(0);
  }

  /** @var \Drupal\markaspot_open311\Service\GeoreportProcessorServiceInterface $processor */
  $processor = \Drupal::service('markaspot_open311.processor');
  $jurisdictionId = $processor->resolveNodeJurisdictionId($node);
  $allowed = $jurisdictionId === NULL
    ? !$processor->hasJurisdictionGroups()
    : $processor->isJurisdictionMember($jurisdictionId, $account);

  if (!$allowed && $node->hasField('field_organisation')) {
    foreach ($node->get('field_organisation')->referencedEntities() as $organisation) {
      if ($organisation instanceof GroupInterface && $organisation->getMember($account)) {
        $allowed = TRUE;
        break;
      }
    }
  }

  $result = $allowed
    ? AccessResult::neutral()
    : AccessResult::forbidden('Restricted to staff responsible for the request.');
  return $result
    ->cachePerPermissions()
    ->addCacheContexts(['user'])
    ->addCacheableDependency($node)
    ->setCacheMaxAge(0);
}

/**
 * Implements hook_node_delete().
 *
 * Purges markaspot_request_links rows referencing the deleted node on
 * either side (source or target), mirroring markaspot_ai_node_delete's
 * cleanup of markaspot_ai_duplicate_matches.
 */
function markaspot_dashboard_node_delete(NodeInterface $node): void {
  if ($node->bundle() !== 'service_request') {
    return;
  }

  try {
    /** @var \Drupal\markaspot_dashboard\Service\RequestLinkServiceInterface $request_link_service */
    $request_link_service = \Drupal::service('markaspot_dashboard.request_link');
    $deleted = $request_link_service->deleteForNode((int) $node->id());
    if ($deleted > 0) {
      \Drupal::logger('markaspot_dashboard')->info('Purged @count split-link rows for deleted node @nid.', [
        '@count' => $deleted,
        '@nid' => $node->id(),
      ]);
    }
  }
  catch (\Exception $e) {
    \Drupal::logger('markaspot_dashboard')->error('Failed to purge split-link rows for deleted node @nid: @message', [
      '@nid' => $node->id(),
      '@message' => $e->getMessage(),
    ]);
  }
}
