<?php

/**
 * @file
 * Provides failure and relationship hooks for tenant importer tests.
 */

declare(strict_types=1);

use Drupal\group\Entity\GroupRelationshipInterface;
use Drupal\group\Entity\GroupInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\file\FileInterface;

/**
 * Implements hook_group_relationship_insert().
 */
function markaspot_tenant_import_test_group_relationship_insert(GroupRelationshipInterface $relationship): void {
  if ($relationship->getPluginId() === 'group_membership'
    && $relationship->getGroup()->bundle() === 'jur'
    && $relationship->get('group_roles')->isEmpty()) {
    \Drupal::state()->set(
      'markaspot_tenant_import_test.empty_jurisdiction_roles_on_insert',
      TRUE,
    );
  }
}

/**
 * Implements hook_taxonomy_term_presave().
 */
function markaspot_tenant_import_test_taxonomy_term_presave(TermInterface $term): void {
  $name = \Drupal::state()->get('markaspot_tenant_import_test.fail_status');
  if (is_string($name)
    && $term->bundle() === 'service_status'
    && $term->label() === $name) {
    throw new RuntimeException('Injected status save failure.');
  }
}

/**
 * Implements hook_group_presave().
 */
function markaspot_tenant_import_test_group_presave(GroupInterface $group): void {
  if (\Drupal::state()->get('markaspot_tenant_import_test.fail_logo')
    && $group->hasField('field_logo_light')
    && !$group->get('field_logo_light')->isEmpty()) {
    throw new RuntimeException('Injected logo save failure.');
  }
}

/**
 * Implements hook_file_presave().
 */
function markaspot_tenant_import_test_file_presave(FileInterface $file): void {
  $hash = \Drupal::state()->get('markaspot_tenant_import_test.fail_logo_file_hash');
  if (is_string($hash) && str_ends_with($file->getFileUri(), '/' . $hash . '.png')) {
    \Drupal::state()->set('markaspot_tenant_import_test.logo_file_bytes_existed', is_file($file->getFileUri()));
    throw new RuntimeException('Injected logo file save failure.');
  }
}
