<?php

/**
 * @file
 * Install, update and uninstall functions for the markaspot_media module.
 */

use Drupal\Component\Serialization\Yaml;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;

/**
 * Implements hook_install().
 *
 * Adds field_request_media to the service_request form display on fresh
 * installs. The form display is owned by the service_request module and still
 * ships the deprecated field_request_image; this hook replaces it.
 */
function markaspot_media_install(): void {
  _markaspot_media_ensure_image_field();
  _markaspot_media_ensure_form_display();
}

/**
 * Ensures the request_image media type and its image field are present.
 *
 * Media.type.request_image and field_media_image ship in this module's
 * config/install and normally arrive automatically. On an interrupted /
 * partial profile install the module can register as installed while its
 * config/install was skipped, leaving field_media_image absent. The GeoReport
 * POST handler then crashes in GeoreportProcessorService::handleMediaUrls()
 * with "Call to a member function getSetting() on null" whenever a media_url
 * is supplied, surfacing as a redacted 502. This repair re-creates the media
 * type and image field from this module's own config/install so media-bearing
 * reports succeed. Idempotent: each piece is skipped when already present.
 */
function _markaspot_media_ensure_image_field(): void {
  $path = \Drupal::service('extension.list.module')->getPath('markaspot_media') . '/config/install';

  // 1. field_media_image storage on the media entity type.
  if (!FieldStorageConfig::loadByName('media', 'field_media_image')) {
    $file = $path . '/field.storage.media.field_media_image.yml';
    if (file_exists($file)) {
      $data = Yaml::decode(file_get_contents($file));
      unset($data['uuid'], $data['_core']);
      FieldStorageConfig::create($data)->save();
    }
  }

  // 2. request_image media type bundle.
  $media_type_storage = \Drupal::entityTypeManager()->getStorage('media_type');
  foreach (['request_image', 'catalog_image'] as $bundle) {
    if (!$media_type_storage->load($bundle)) {
      $file = $path . '/media.type.' . $bundle . '.yml';
      if (file_exists($file)) {
        $data = Yaml::decode(file_get_contents($file));
        unset($data['uuid'], $data['_core']);
        $media_type_storage->create($data)->save();
      }
    }
  }

  // 3. field_media_image bundle binding on each media type.
  foreach (['request_image', 'catalog_image'] as $bundle) {
    if (!$media_type_storage->load($bundle)) {
      continue;
    }
    if (!FieldConfig::loadByName('media', $bundle, 'field_media_image')) {
      $file = $path . '/field.field.media.' . $bundle . '.field_media_image.yml';
      if (file_exists($file)) {
        $data = Yaml::decode(file_get_contents($file));
        unset($data['uuid'], $data['_core']);
        FieldConfig::create($data)->save();
      }
    }
  }

  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
}

/**
 * Add field_request_media to service_request default form display.
 *
 * The field existed but was missing from the form display config/install.
 * Uses inline_entity_form_simple widget matching the template project config.
 */
function markaspot_media_update_11901(): void {
  $display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.service_request.default');

  if (!$display) {
    return;
  }

  if ($display->getComponent('field_request_media')) {
    return;
  }

  $display->setComponent('field_request_media', [
    'type' => 'inline_entity_form_simple',
    'weight' => 0,
    'region' => 'content',
    'settings' => [
      'form_mode' => 'default',
      'override_labels' => FALSE,
      'label_singular' => '',
      'label_plural' => '',
      'collapsible' => FALSE,
      'collapsed' => FALSE,
      'revision' => FALSE,
    ],
  ]);
  $display->save();

  \Drupal::logger('markaspot_media')->info('Added field_request_media to service_request default form display.');
}

/**
 * Increase field_request_media cardinality from 1 to 3.
 */
function markaspot_media_update_11902(): void {
  $storage = FieldStorageConfig::load('node.field_request_media');
  if ($storage && $storage->getCardinality() < 3) {
    $storage->setCardinality(3);
    $storage->save();
    \Drupal::logger('markaspot_media')->info('Increased field_request_media cardinality to 3.');
  }
}

/**
 * Shared helper: ensure field_request_media is on the form display.
 *
 * Used by hook_install() on fresh installs.
 * Also removes the deprecated field_request_image if present.
 */
function _markaspot_media_ensure_form_display(): void {
  $display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.service_request.default');

  if (!$display) {
    return;
  }

  $changed = FALSE;

  // Remove deprecated field_request_image.
  if ($display->getComponent('field_request_image')) {
    $display->removeComponent('field_request_image');
    $changed = TRUE;
    \Drupal::logger('markaspot_media')->info('Removed deprecated field_request_image from service_request form display.');
  }

  // Add field_request_media if missing.
  if (!$display->getComponent('field_request_media')) {
    $display->setComponent('field_request_media', [
      'type' => 'inline_entity_form_simple',
      'weight' => 0,
      'region' => 'content',
      'settings' => [
        'form_mode' => 'default',
        'override_labels' => FALSE,
        'label_singular' => '',
        'label_plural' => '',
        'collapsible' => FALSE,
        'collapsed' => FALSE,
        'revision' => FALSE,
      ],
    ]);
    $changed = TRUE;
    \Drupal::logger('markaspot_media')->info('Added field_request_media to service_request default form display.');
  }

  if ($changed) {
    $display->save();
  }
}

/**
 * Add field_definition_group to catalog_image media type.
 */
function markaspot_media_update_11903(): void {
  $entity_type_manager = \Drupal::entityTypeManager();

  // Skip if catalog_image media type doesn't exist (not all instances use it).
  $media_type = $entity_type_manager->getStorage('media_type')->load('catalog_image');
  if (!$media_type) {
    \Drupal::messenger()->addStatus('Media type catalog_image not found. Skipping field_definition_group setup.');
    return;
  }

  // Create field storage if it doesn't exist.
  if (!FieldStorageConfig::loadByName('media', 'field_definition_group')) {
    FieldStorageConfig::create([
      'field_name' => 'field_definition_group',
      'entity_type' => 'media',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => [
        'max_length' => 128,
        'is_ascii' => TRUE,
        'case_sensitive' => FALSE,
      ],
      'translatable' => FALSE,
    ])->save();
  }

  // Create field instance on catalog_image if it doesn't exist.
  if (!FieldConfig::loadByName('media', 'catalog_image', 'field_definition_group')) {
    FieldConfig::create([
      'field_name' => 'field_definition_group',
      'entity_type' => 'media',
      'bundle' => 'catalog_image',
      'label' => 'Definition Group',
      'description' => 'Group identifier for filtering in imagelist attributes (e.g. radbuegel_bautypen, lastenrad_stellplatz).',
      'required' => FALSE,
    ])->save();
  }

  // Add to form display.
  $form_display = $entity_type_manager->getStorage('entity_form_display')
    ->load('media.catalog_image.default');
  if ($form_display && !$form_display->getComponent('field_definition_group')) {
    $form_display->setComponent('field_definition_group', [
      'type' => 'string_textfield',
      'weight' => 5,
      'settings' => [
        'size' => 60,
        'placeholder' => 'e.g. radbuegel_bautypen',
      ],
    ])->save();
  }
}

/**
 * Switch field_request_media to the request_media:media selection handler.
 *
 * The handler and the request_media:media plugin already ship with this
 * module, but config/install only applies on a fresh install. Existing
 * tenants keep the core default:media handler, which access-filters
 * referenceable entities by publish status. Report photos are uploaded
 * unpublished on purpose (privacy: not public before AI screening), so the
 * default handler makes an anonymous reporter's just-uploaded media
 * unreferenceable and the report submit fails ValidReferenceConstraint with
 * HTTP 422. request_media:media keeps the request_image bundle restriction
 * and the existence check but drops the publish-status filter.
 */
function markaspot_media_update_11904(): void {
  $config = \Drupal::configFactory()
    ->getEditable('field.field.node.service_request.field_request_media');
  if ($config->isNew()) {
    return;
  }

  $changed = FALSE;

  if ($config->get('settings.handler') !== 'request_media:media') {
    $config->set('settings.handler', 'request_media:media');
    $changed = TRUE;
  }

  // The handler plugin is provided by this module, so the field config must
  // declare the dependency. It is hand-maintained on purpose: the raw config
  // write is used precisely because an entity-API FieldConfig::save() re-runs
  // calculateDependencies(), which does not resolve selection-handler plugin
  // providers and would silently drop this entry. Do not "fix" this into a
  // FieldConfig::save() — that would reintroduce the bug.
  $modules = $config->get('dependencies.module') ?? [];
  if (!in_array('markaspot_media', $modules, TRUE)) {
    $modules[] = 'markaspot_media';
    sort($modules);
    $config->set('dependencies.module', $modules);
    $changed = TRUE;
  }

  if (!$changed) {
    return;
  }
  $config->save();

  // A raw config write fires no FieldConfig entity hooks, so EntityFieldManager
  // still serves the cached field definition with the old handler. Invalidate
  // it explicitly so the new handler takes effect without a full cache rebuild.
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();

  \Drupal::logger('markaspot_media')->info('Switched field_request_media selection handler to request_media:media (allows referencing unpublished request_image media during AI screening).');
}

/**
 * Repairs a missing request_image media type / field_media_image field.
 *
 * Fixes installs where this module's config/install was skipped (partial
 * profile install), leaving field_media_image absent and every media_url POST
 * failing with a redacted 502. Idempotent and a no-op on healthy installs.
 */
function markaspot_media_update_11905(): string {
  $had_field = (bool) FieldStorageConfig::loadByName('media', 'field_media_image');
  _markaspot_media_ensure_image_field();
  $has_field = (bool) FieldStorageConfig::loadByName('media', 'field_media_image');

  if (!$had_field && $has_field) {
    return 'Restored missing request_image media type and field_media_image field.';
  }
  return 'request_image media type and field_media_image field already present; nothing to repair.';
}

/**
 * Align catalog-image media config with sync before drush deploy imports.
 *
 * Some upgraded tenant dumps already have this module schema marked past
 * 11903, but still miss the catalog_image field configs. drush deploy then runs
 * update hooks, creates the media type, and the following config import sees a
 * UUID conflict: delete the freshly created bundle but update field configs
 * whose active target is missing. Create missing config entities from sync and
 * align UUIDs now, while updatedb still runs before config import.
 */
function markaspot_media_update_11906(): string {
  $sync = \Drupal::service('config.storage.sync');
  $active = \Drupal::service('config.storage');
  $entity_type_manager = \Drupal::entityTypeManager();
  $created = [];
  $aligned = [];

  $media_type_data = $sync->read('media.type.catalog_image');
  if (is_array($media_type_data) && !$entity_type_manager->getStorage('media_type')->load('catalog_image')) {
    $entity_type_manager->getStorage('media_type')->create($media_type_data)->save();
    $created[] = 'media.type.catalog_image';
  }

  $field_storage_names = [
    'field.storage.media.field_media_image' => ['media', 'field_media_image'],
    'field.storage.media.field_definition_group' => ['media', 'field_definition_group'],
  ];
  foreach ($field_storage_names as $config_name => [$entity_type, $field_name]) {
    $data = $sync->read($config_name);
    if (!is_array($data) || FieldStorageConfig::loadByName($entity_type, $field_name)) {
      continue;
    }
    FieldStorageConfig::create($data)->save();
    $created[] = $config_name;
  }

  $field_config_names = [
    'field.field.media.catalog_image.field_media_image' => ['media', 'catalog_image', 'field_media_image'],
    'field.field.media.catalog_image.field_definition_group' => ['media', 'catalog_image', 'field_definition_group'],
  ];
  foreach ($field_config_names as $config_name => [$entity_type, $bundle, $field_name]) {
    $data = $sync->read($config_name);
    if (!is_array($data) || FieldConfig::loadByName($entity_type, $bundle, $field_name)) {
      continue;
    }
    FieldConfig::create($data)->save();
    $created[] = $config_name;
  }

  $entity_form_display_data = $sync->read('core.entity_form_display.media.catalog_image.default');
  if (is_array($entity_form_display_data)
    && !$entity_type_manager->getStorage('entity_form_display')->load('media.catalog_image.default')) {
    $entity_type_manager->getStorage('entity_form_display')->create($entity_form_display_data)->save();
    $created[] = 'core.entity_form_display.media.catalog_image.default';
  }

  $uuid_aligned_names = [
    'media.type.catalog_image',
    'field.storage.media.field_media_image',
    'field.storage.media.field_definition_group',
    'field.field.media.catalog_image.field_media_image',
    'field.field.media.catalog_image.field_definition_group',
    'core.entity_form_display.media.catalog_image.default',
  ];
  foreach ($uuid_aligned_names as $config_name) {
    $sync_data = $sync->read($config_name);
    $active_data = $active->read($config_name);
    if (!is_array($sync_data) || !is_array($active_data) || empty($sync_data['uuid'])) {
      continue;
    }
    if (($active_data['uuid'] ?? NULL) === $sync_data['uuid']) {
      continue;
    }
    $active_data['uuid'] = $sync_data['uuid'];
    $active->write($config_name, $active_data);
    $aligned[] = $config_name;
  }

  if ($created || $aligned) {
    \Drupal::service('config.factory')->reset();
    \Drupal::service('cache.config')->deleteAll();
    \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  }

  return sprintf(
    'Catalog image media config prepared: created=%d, uuid_aligned=%d.',
    count($created),
    count($aligned)
  );
}
