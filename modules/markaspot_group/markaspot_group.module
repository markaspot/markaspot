<?php

/**
 * @file
 * Mark-a-Spot Group module.
 *
 * Provides group-based access control for service requests using the Group
 * module. Includes auto-membership functionality for users with the
 * "All Groups Member" field enabled.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\group\Entity\Group;
use Drupal\group\Entity\GroupInterface;
use Drupal\group\Entity\GroupMembership as GroupMembershipEntity;
use Drupal\group\Entity\GroupRelationshipInterface;
use Drupal\markaspot_group\Entity\ProtectedGroup;
use Drupal\markaspot_group\MembershipRoleNormalizer;
use Drupal\markaspot_group\Service\TenantAdminHelper;
use Drupal\markaspot_validation\Plugin\Validation\Geo\GeoJsonBoundary;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\user\Entity\User;
use Drupal\user\UserInterface;

/**
 * Implements hook_mail().
 */
function markaspot_group_mail(string $key, array &$message, array $params): void {
  if ($key === 'org_notification') {
    $message['subject'] = (string) ($params['subject'] ?? 'A service request was assigned to your organisation');
    $message['body'][] = (string) ($params['message'] ?? 'A service request has been assigned to your organisation.');
    return;
  }

  if ($key === 'member_invitation') {
    $langcode = $message['langcode'] ?? $params['langcode'] ?? 'en';

    // Load mail config in the message's language.
    $mail_config = \Drupal::languageManager()
      ->getLanguageConfigOverride($langcode, 'markaspot_group.mail')
      ->get($key);

    // Fallback to default language if translation doesn't exist.
    if (empty($mail_config)) {
      $mail_config = \Drupal::config('markaspot_group.mail')->get($key);
    }

    // Final fallback: hardcoded English templates.
    if (empty($mail_config)) {
      $mail_config = [
        'subject' => '@site_name: You have been invited to "@group_name"',
        'body' => "You have been invited to join the group \"@group_name\" on @site_name.\n\nClick the link below to accept the invitation:\n@claim_url\n\nThis invitation expires in 7 days.\n\nIf you did not expect this invitation, please ignore this email.",
      ];
    }

    $replacements = [
      '@site_name' => $params['site_name'] ?? 'Mark-a-Spot',
      '@group_name' => $params['group_name'] ?? '',
      '@claim_url' => $params['claim_url'] ?? '',
    ];

    $message['subject'] = strtr($mail_config['subject'], $replacements);
    $message['body'][] = strtr($mail_config['body'], $replacements);
  }
}

/**
 * Implements hook_entity_presave().
 *
 * Handles presave logic for:
 * - taxonomy_term: Redirects child jurisdiction references to root parent.
 * - group (jur bundle): Validates field_service_categories belong to the
 *   correct root jurisdiction.
 */
function markaspot_group_entity_presave(EntityInterface $entity): void {
  _markaspot_group_presave_obsolete_eca($entity);

  if ($entity instanceof TermInterface) {
    _markaspot_group_presave_taxonomy_term($entity);
  }
  if ($entity instanceof GroupInterface && _markaspot_group_is_jurisdiction_group($entity)) {
    _markaspot_group_presave_jur_service_categories($entity);
  }
}

/**
 * Prevents obsolete ECA models from being re-enabled.
 *
 * These models were replaced by code-based jurisdiction and organisation
 * assignment. Keeping them disabled avoids duplicate or token-derived stamps
 * when the optional ECA config is imported on older tenants.
 */
function _markaspot_group_presave_obsolete_eca(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'eca') {
    return;
  }

  if (!in_array((string) $entity->id(), _markaspot_group_obsolete_eca_ids(), TRUE)) {
    return;
  }

  if (!method_exists($entity, 'status') || !$entity->status()) {
    return;
  }

  if (!method_exists($entity, 'setStatus')) {
    return;
  }

  $entity->setStatus(FALSE);
  \Drupal::logger('markaspot_group')->warning(
    'Prevented obsolete ECA rule @id from being enabled.',
    ['@id' => $entity->id()]
  );
}

/**
 * Gets obsolete ECA models that must stay disabled.
 *
 * @return string[]
 *   ECA config entity IDs.
 */
function _markaspot_group_obsolete_eca_ids(): array {
  return ['process_apply_group'];
}

/**
 * Presave handler for taxonomy terms: jurisdiction inheritance enforcement.
 *
 * Enforces taxonomy inheritance rule: child jurisdictions (those with
 * field_parent_jurisdiction set) must not have their own taxonomy terms.
 * If a term's field_jurisdiction points to a child jurisdiction, the reference
 * is automatically redirected to the root parent jurisdiction.
 *
 * This prevents mixed taxonomy catalogs in hierarchical deployments
 * (Landkreis model) where all subdivisions share the parent's service catalog.
 *
 * @param \Drupal\taxonomy\TermInterface $entity
 *   The taxonomy term being saved.
 *
 * @see https://markaspot-docs/architecture/multi-jurisdiction.md
 */
function _markaspot_group_presave_taxonomy_term(TermInterface $entity): void {
  // Only process terms with a field_jurisdiction reference.
  if (!$entity->hasField('field_jurisdiction') || $entity->get('field_jurisdiction')->isEmpty()) {
    return;
  }

  $jurisdiction_id = (int) $entity->get('field_jurisdiction')->target_id;
  if ($jurisdiction_id <= 0) {
    return;
  }

  // Load the referenced jurisdiction group.
  $group = \Drupal::entityTypeManager()->getStorage('group')->load($jurisdiction_id);
  if (!_markaspot_group_is_jurisdiction_group($group)) {
    return;
  }

  // Check if this jurisdiction has a parent (is a child/subdivision).
  if (!$group->hasField('field_parent_jurisdiction') || $group->get('field_parent_jurisdiction')->isEmpty()) {
    // Root jurisdiction, no redirect needed.
    return;
  }

  // Traverse up to the root jurisdiction.
  /** @var \Drupal\markaspot_group\Service\JurisdictionHierarchyResolverInterface $resolver */
  $resolver = \Drupal::service('markaspot_group.hierarchy_resolver');
  $root_id = $resolver->getRootJurisdictionId($jurisdiction_id);
  if ($root_id === NULL) {
    return;
  }

  // Redirect field_jurisdiction to the root parent.
  $entity->set('field_jurisdiction', $root_id);

  \Drupal::logger('markaspot_group')->notice(
    'Taxonomy term "@term" (vid: @vid): redirected field_jurisdiction from child @child to root @root.',
    [
      '@term' => $entity->label() ?? '(new)',
      '@vid' => $entity->bundle(),
      '@child' => $jurisdiction_id,
      '@root' => $root_id,
    ]
  );
}

/**
 * Presave handler for jur groups: validates field_service_categories.
 *
 * Ensures that selected service categories belong to the correct root
 * jurisdiction. Invalid categories (those with field_jurisdiction pointing
 * to a different root) are silently removed and a warning is logged.
 *
 * This prevents data inconsistency where a child jurisdiction references
 * categories from an unrelated jurisdiction tree.
 *
 * @param \Drupal\group\Entity\GroupInterface $group
 *   The jurisdiction group being saved.
 */
function _markaspot_group_presave_jur_service_categories(GroupInterface $group): void {
  // Only validate if service categories are set.
  if (!$group->hasField('field_service_categories') || $group->get('field_service_categories')->isEmpty()) {
    return;
  }

  // Determine the root jurisdiction ID.
  $group_id = $group->isNew() ? NULL : (int) $group->id();
  $root_jurisdiction_id = NULL;

  /** @var \Drupal\markaspot_group\Service\JurisdictionHierarchyResolverInterface $resolver */
  $resolver = \Drupal::service('markaspot_group.hierarchy_resolver');

  if ($group_id !== NULL) {
    $root_jurisdiction_id = $resolver->getRootJurisdictionId($group_id);
  }
  elseif ($group->hasField('field_parent_jurisdiction') && !$group->get('field_parent_jurisdiction')->isEmpty()) {
    // New group with a parent: resolve from the parent.
    $parent_id = (int) $group->get('field_parent_jurisdiction')->target_id;
    $root_jurisdiction_id = $resolver->getRootJurisdictionId($parent_id);
  }

  if ($root_jurisdiction_id === NULL) {
    return;
  }

  // Validate each referenced category term.
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $valid_items = [];
  $removed_tids = [];

  foreach ($group->get('field_service_categories') as $item) {
    $tid = (int) $item->target_id;
    $term = $term_storage->load($tid);

    if (!$term) {
      $removed_tids[] = $tid;
      continue;
    }

    // Check that the term belongs to the correct root jurisdiction.
    if (!$term->hasField('field_jurisdiction') || $term->get('field_jurisdiction')->isEmpty()) {
      $removed_tids[] = $tid;
      continue;
    }

    $term_jurisdiction_id = (int) $term->get('field_jurisdiction')->target_id;

    // The term's jurisdiction should match the root. Use the resolver in case
    // the term itself points to a child (which would be unusual but possible).
    $term_root_id = $resolver->getRootJurisdictionId($term_jurisdiction_id);

    if ($term_root_id === $root_jurisdiction_id) {
      $valid_items[] = ['target_id' => $tid];
    }
    else {
      $removed_tids[] = $tid;
    }
  }

  // If invalid categories were found, clean them out and log a warning.
  if (!empty($removed_tids)) {
    $group->set('field_service_categories', $valid_items);

    $message = t('Removed @count invalid service categories (not in root jurisdiction @root): @tids.', [
      '@count' => count($removed_tids),
      '@root' => $root_jurisdiction_id,
      '@tids' => implode(', ', $removed_tids),
    ]);

    \Drupal::logger('markaspot_group')->warning(
      'Jurisdiction "@group" (id=@gid): @message',
      [
        '@group' => $group->label() ?? '(new)',
        '@gid' => $group_id ?? 'new',
        '@message' => $message,
      ]
    );
    \Drupal::messenger()->addWarning($message);
  }
}

/**
 * Presave handler for service requests: jurisdiction-aware initial status.
 *
 * When a new service request is created via JSON:API, the field_status default
 * comes from field configuration (a single global TID). In multi-tenant setups
 * each jurisdiction has its own "initial" status term. This handler detects
 * when a new node has the wrong initial status and corrects it based on the
 * node's category jurisdiction.
 *
 * Only fires for NEW nodes. Existing nodes keep their current status.
 *
 * Resolution path:
 *   node -> field_category -> term -> field_jurisdiction -> root jur ID
 *   -> getInitialStatusTid(root_jur_id) -> correct status TID
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node being saved.
 */
function _markaspot_group_presave_service_request_status(NodeInterface $node): void {
  // Only correct status on new nodes. Existing nodes keep their status.
  if (!$node->isNew()) {
    return;
  }

  // Need a category to determine jurisdiction.
  if (!$node->hasField('field_category') || $node->get('field_category')->isEmpty()) {
    return;
  }

  // Need a status field to correct.
  if (!$node->hasField('field_status')) {
    return;
  }

  // Load the category term to find its jurisdiction.
  $category_term = $node->get('field_category')->entity;
  if (!$category_term || !$category_term->hasField('field_jurisdiction') || $category_term->get('field_jurisdiction')->isEmpty()) {
    return;
  }

  $category_jur_id = (int) $category_term->get('field_jurisdiction')->target_id;
  if ($category_jur_id <= 0) {
    return;
  }

  // Get the jurisdiction-correct initial status.
  /** @var \Drupal\markaspot_open311\Service\GeoreportProcessorServiceInterface $processor */
  $processor = \Drupal::service('markaspot_open311.processor');
  $correct_status_tid = $processor->getInitialStatusTid($category_jur_id);

  if (!$correct_status_tid) {
    return;
  }

  // Get the current status TID (may be empty, or the global default).
  $current_status_tid = $node->get('field_status')->isEmpty()
    ? NULL
    : (int) $node->get('field_status')->target_id;

  // If the correct status is already set, nothing to do.
  if ($current_status_tid === $correct_status_tid) {
    return;
  }

  // Set the jurisdiction-correct initial status.
  $node->set('field_status', ['target_id' => $correct_status_tid]);

  \Drupal::logger('markaspot_group')->notice(
    'Service request "@title": redirected field_status from TID=@old to TID=@new (jurisdiction @jur).',
    [
      '@title' => $node->label() ?? '(new)',
      '@old' => $current_status_tid ?? 'empty',
      '@new' => $correct_status_tid,
      '@jur' => $category_jur_id,
    ]
  );
}

/**
 * Implements hook_form_FORM_ID_alter() for user_form.
 *
 * Hides field_all_groups_member on the user edit form unless the edited
 * user is uid=1 or has the 'administrator' role. The field should only
 * be visible (and editable) for those accounts.
 */
function markaspot_group_form_user_form_alter(array &$form, FormStateInterface $form_state): void {
  if (!isset($form['field_all_groups_member'])) {
    return;
  }

  $user = $form_state->getFormObject()->getEntity();
  $uid = (int) $user->id();

  // Only show for uid=1 or administrators.
  if ($uid === 1 || $user->hasRole('administrator')) {
    return;
  }

  $form['field_all_groups_member']['#access'] = FALSE;
}

/**
 * Implements hook_user_insert().
 *
 * When a new user is created with the "All Groups Member" field enabled,
 * automatically add them to all existing groups with the admin role.
 */
function markaspot_group_user_insert(UserInterface $account): void {
  _markaspot_group_handle_user_membership($account);
}

/**
 * Implements hook_user_update().
 *
 * When an existing user is updated with the "All Groups Member" field enabled,
 * automatically add them to all groups they are not yet a member of.
 */
function markaspot_group_user_update(UserInterface $account): void {
  $original = $account->original ?? NULL;
  $original_roles = $original instanceof UserInterface ? $original->getRoles() : [];
  $new_roles = $account->getRoles();
  if (in_array('tenant_admin', $original_roles, TRUE) && !in_array('tenant_admin', $new_roles, TRUE)) {
    $stripped = TenantAdminHelper::stripAllGroupRoles($account);
    if ($stripped > 0) {
      \Drupal::logger('markaspot_group')->notice(
        'Removed jur-tenant_admin group role from @count jurisdiction membership(s) for user @name after tenant_admin Drupal role removal.',
        [
          '@count' => $stripped,
          '@name' => $account->getAccountName(),
        ]
      );
    }
  }

  // Check if the field exists before accessing it.
  if (!$account->hasField('field_all_groups_member')) {
    return;
  }

  // Check if the field value changed from FALSE to TRUE.
  $original_value = $original?->hasField('field_all_groups_member')
    ? (bool) $original->get('field_all_groups_member')->value
    : FALSE;
  $new_value = (bool) $account->get('field_all_groups_member')->value;

  // Only process if the field was just enabled.
  if ($new_value && !$original_value) {
    _markaspot_group_handle_user_membership($account);
  }
}

/**
 * Implements hook_user_delete().
 *
 * Group membership relationships reference users through entity_id. Clean them
 * up explicitly so deleted users do not leave orphan group memberships behind.
 */
function markaspot_group_user_delete(UserInterface $account): void {
  $uid = (int) $account->id();
  if ($uid <= 0) {
    return;
  }

  $relationships = \Drupal::entityTypeManager()
    ->getStorage('group_relationship')
    ->loadByProperties([
      'entity_id' => $uid,
      'plugin_id' => 'group_membership',
    ]);

  foreach ($relationships as $relationship) {
    if ($relationship instanceof GroupRelationshipInterface) {
      $relationship->delete();
    }
  }
}

/**
 * Implements hook_entity_type_alter().
 */
function markaspot_group_entity_type_alter(array &$entity_types): void {
  if (!isset($entity_types['group'])) {
    return;
  }

  if ($entity_types['group']->getClass() === Group::class) {
    $entity_types['group']->setClass(ProtectedGroup::class);
  }

  $entity_types['group']->addConstraint('OrgRootJurisdictionReference');
  $entity_types['group']->addConstraint('JurisdictionParentReference');
}

/**
 * Implements hook_ENTITY_TYPE_access() for group entities.
 */
function markaspot_group_group_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResult {
  if (!$entity instanceof GroupInterface
    || $operation !== 'delete'
    || !_markaspot_group_is_protected_group_bundle($entity->bundle())) {
    return AccessResult::neutral();
  }

  $blockers = _markaspot_group_delete_blockers($entity, TRUE);
  if ($blockers === []) {
    return AccessResult::neutral()->setCacheMaxAge(0);
  }

  return AccessResult::forbidden(_markaspot_group_delete_refusal_message($entity, $blockers))
    ->setCacheMaxAge(0);
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for group entities.
 *
 * Jurisdiction and organisation groups are tenant boundaries. Refuse deleting
 * them while references still exist instead of letting storage or Group cleanup
 * cascade content relationships implicitly.
 */
function markaspot_group_group_predelete(GroupInterface $group): void {
  if (!_markaspot_group_is_protected_group_bundle($group->bundle())) {
    return;
  }

  $blockers = _markaspot_group_delete_blockers($group);
  if ($blockers === []) {
    return;
  }

  throw new EntityStorageException((string) _markaspot_group_delete_refusal_message($group, $blockers));
}

/**
 * Builds the shared delete-refusal message.
 *
 * @param string[] $blockers
 *   Blocker labels with counts.
 */
function _markaspot_group_delete_refusal_message(GroupInterface $group, array $blockers): string {
  return (string) t('Cannot delete @type group "@label" (id @id) while it is still referenced by: @blockers. Reassign or remove these references first.', [
    '@type' => $group->bundle(),
    '@label' => $group->label() ?? '',
    '@id' => (string) $group->id(),
    '@blockers' => implode(', ', $blockers),
  ]);
}

/**
 * Collects human-readable blockers for group deletion.
 *
 * @param bool $include_relationships
 *   Whether to include group content relationships. Access checks run before
 *   Group::preDelete() removes relationships; entity predelete hooks run after.
 *
 * @return string[]
 *   Blocker labels with counts.
 */
function _markaspot_group_delete_blockers(GroupInterface $group, bool $include_relationships = FALSE): array {
  $group_id = (int) $group->id();
  if ($group_id <= 0) {
    return [];
  }

  $counts = [];

  if (_markaspot_group_is_jurisdiction_group($group)) {
    $counts['service requests via field_jurisdiction'] = _markaspot_group_count_node_field_reference('node__field_jurisdiction', 'field_jurisdiction_target_id', $group_id, 'service_request');
    $counts['service request revisions via field_jurisdiction'] = _markaspot_group_count_node_field_reference('node_revision__field_jurisdiction', 'field_jurisdiction_target_id', $group_id, 'service_request');
    $counts['other content via field_jurisdiction'] = _markaspot_group_count_node_field_reference('node__field_jurisdiction', 'field_jurisdiction_target_id', $group_id, NULL, ['service_request']);
    $counts['other content revisions via field_jurisdiction'] = _markaspot_group_count_node_field_reference('node_revision__field_jurisdiction', 'field_jurisdiction_target_id', $group_id, NULL, ['service_request']);
    $counts['service requests via field_escalation'] = _markaspot_group_count_node_field_reference('node__field_escalation', 'field_escalation_target_id', $group_id, 'service_request');
    $counts['service request revisions via field_escalation'] = _markaspot_group_count_node_field_reference('node_revision__field_escalation', 'field_escalation_target_id', $group_id, 'service_request');
    $counts['organisation groups'] = _markaspot_group_count_group_field_reference('group__field_jurisdiction', 'field_jurisdiction_target_id', $group_id, 'org');
    $counts['organisation group revisions'] = _markaspot_group_count_group_field_reference('group_revision__field_jurisdiction', 'field_jurisdiction_target_id', $group_id, 'org');
    $jur_type = _markaspot_group_jurisdiction_group_type();
    $counts['child jurisdictions'] = _markaspot_group_count_group_field_reference('group__field_parent_jurisdiction', 'field_parent_jurisdiction_target_id', $group_id, $jur_type);
    $counts['child jurisdiction revisions'] = _markaspot_group_count_group_field_reference('group_revision__field_parent_jurisdiction', 'field_parent_jurisdiction_target_id', $group_id, $jur_type);
    $counts['taxonomy terms via field_jurisdiction'] = _markaspot_group_count_reference('taxonomy_term__field_jurisdiction', 'field_jurisdiction_target_id', $group_id);
    $counts['taxonomy term revisions via field_jurisdiction'] = _markaspot_group_count_reference('taxonomy_term_revision__field_jurisdiction', 'field_jurisdiction_target_id', $group_id);
    $counts['taxonomy terms via field_escalation_target'] = _markaspot_group_count_reference('taxonomy_term__field_escalation_target', 'field_escalation_target_id', $group_id);
    $counts['taxonomy term revisions via field_escalation_target'] = _markaspot_group_count_reference('taxonomy_term_revision__field_escalation_target', 'field_escalation_target_id', $group_id);
  }
  elseif ($group->bundle() === 'org') {
    $counts['service requests via field_organisation'] = _markaspot_group_count_node_field_reference('node__field_organisation', 'field_organisation_target_id', $group_id, 'service_request');
    $counts['service request revisions via field_organisation'] = _markaspot_group_count_node_field_reference('node_revision__field_organisation', 'field_organisation_target_id', $group_id, 'service_request');
    $counts['other content via field_organisation'] = _markaspot_group_count_node_field_reference('node__field_organisation', 'field_organisation_target_id', $group_id, NULL, ['service_request']);
    $counts['other content revisions via field_organisation'] = _markaspot_group_count_node_field_reference('node_revision__field_organisation', 'field_organisation_target_id', $group_id, NULL, ['service_request']);
    $counts['category mappings via field_category_gid'] = _markaspot_group_count_reference('taxonomy_term__field_category_gid', 'field_category_gid_target_id', $group_id);
    $counts['category mapping revisions via field_category_gid'] = _markaspot_group_count_reference('taxonomy_term_revision__field_category_gid', 'field_category_gid_target_id', $group_id);
  }

  if ($include_relationships) {
    $counts['group content relationships'] = _markaspot_group_count_group_content_relationships($group_id);
  }

  $blockers = [];
  foreach ($counts as $label => $count) {
    if ($count > 0) {
      $blockers[] = $count . ' ' . $label;
    }
  }

  return $blockers;
}

/**
 * Counts node field references to a group.
 *
 * @param string[] $excluded_bundles
 *   Node bundles to exclude when no positive bundle filter is supplied.
 */
function _markaspot_group_count_node_field_reference(string $table, string $target_column, int $group_id, ?string $bundle = NULL, array $excluded_bundles = []): int {
  $database = \Drupal::database();
  $schema = $database->schema();
  if (!$schema->tableExists($table) || !$schema->fieldExists($table, $target_column)) {
    return 0;
  }

  $query = $database->select($table, 'f');
  $query->addExpression('COUNT(DISTINCT f.entity_id)');
  $query->condition("f.$target_column", $group_id);
  if ($schema->fieldExists($table, 'deleted')) {
    $query->condition('f.deleted', 0);
  }

  if ($schema->tableExists('node_field_data')) {
    $query->innerJoin('node_field_data', 'n', 'n.nid = f.entity_id');
    if ($bundle !== NULL) {
      $query->condition('n.type', $bundle);
    }
    elseif ($excluded_bundles !== []) {
      $query->condition('n.type', $excluded_bundles, 'NOT IN');
    }
  }
  elseif ($bundle !== NULL || $excluded_bundles !== []) {
    return 0;
  }

  return (int) $query->execute()->fetchField();
}

/**
 * Counts group field references to a group.
 */
function _markaspot_group_count_group_field_reference(string $table, string $target_column, int $group_id, ?string $bundle = NULL): int {
  $database = \Drupal::database();
  $schema = $database->schema();
  if (!$schema->tableExists($table) || !$schema->fieldExists($table, $target_column)) {
    return 0;
  }

  $query = $database->select($table, 'f');
  $query->addExpression('COUNT(DISTINCT f.entity_id)');
  $query->condition("f.$target_column", $group_id);
  if ($schema->fieldExists($table, 'deleted')) {
    $query->condition('f.deleted', 0);
  }

  if ($bundle !== NULL) {
    if (!$schema->tableExists('groups')) {
      return 0;
    }
    $query->innerJoin('groups', 'g', 'g.id = f.entity_id');
    $query->condition('g.type', $bundle);
  }

  return (int) $query->execute()->fetchField();
}

/**
 * Counts simple field references to a group.
 */
function _markaspot_group_count_reference(string $table, string $target_column, int $group_id): int {
  $database = \Drupal::database();
  $schema = $database->schema();
  if (!$schema->tableExists($table) || !$schema->fieldExists($table, $target_column)) {
    return 0;
  }

  $query = $database->select($table, 'f');
  $query->addExpression('COUNT(DISTINCT f.entity_id)');
  $query->condition("f.$target_column", $group_id);
  if ($schema->fieldExists($table, 'deleted')) {
    $query->condition('f.deleted', 0);
  }

  return (int) $query->execute()->fetchField();
}

/**
 * Counts group content relationships for a group without blocking memberships.
 */
function _markaspot_group_count_group_content_relationships(int $group_id): int {
  $database = \Drupal::database();
  $schema = $database->schema();
  if (!$schema->tableExists('group_relationship_field_data')) {
    return 0;
  }

  $query = $database->select('group_relationship_field_data', 'gr');
  $query->addExpression('COUNT(DISTINCT gr.id)');
  $query->condition('gr.gid', $group_id);
  $query->condition('gr.plugin_id', 'group_node:%', 'LIKE');

  return (int) $query->execute()->fetchField();
}

/**
 * Implements hook_ENTITY_TYPE_insert() for group entities.
 *
 * When a new group is created, automatically add all users with
 * the "All Groups Member" field enabled as members with the admin role.
 */
function markaspot_group_group_insert(GroupInterface $group): void {
  _markaspot_group_add_all_groups_members_to_group($group);
  _markaspot_group_add_root_admin_to_group($group);
}

/**
 * Implements hook_ENTITY_TYPE_update() for group entities.
 */
function markaspot_group_group_update(GroupInterface $group): void {
  if ($group->bundle() !== _markaspot_group_get_org_group_type()) {
    return;
  }

  if (!isset($group->original) || !$group->original instanceof GroupInterface) {
    return;
  }

  $new_jurisdiction_id = _markaspot_group_group_jurisdiction_id($group);
  $original_jurisdiction_id = _markaspot_group_group_jurisdiction_id($group->original);
  if ($new_jurisdiction_id === $original_jurisdiction_id) {
    return;
  }

  _markaspot_group_restamp_service_requests_for_org_move(
    (int) $group->id(),
    $new_jurisdiction_id,
    $original_jurisdiction_id,
  );
  _markaspot_group_resync_org_memberships_for_org_move(
    $group,
    $new_jurisdiction_id,
    $original_jurisdiction_id,
  );
}

/**
 * Gets a group's field_jurisdiction target ID.
 */
function _markaspot_group_group_jurisdiction_id(GroupInterface $group): ?int {
  if (!$group->hasField('field_jurisdiction') || $group->get('field_jurisdiction')->isEmpty()) {
    return NULL;
  }

  return (int) $group->get('field_jurisdiction')->target_id;
}

/**
 * Checks whether a jurisdiction ID points at a root jurisdiction.
 */
function _markaspot_group_is_root_jurisdiction_id(int $jurisdiction_id): bool {
  $group = \Drupal::entityTypeManager()->getStorage('group')->load($jurisdiction_id);

  return $group instanceof GroupInterface
    && _markaspot_group_is_jurisdiction_group($group)
    && !_markaspot_group_group_has_parent_jurisdiction($group);
}

/**
 * Checks whether a jurisdiction group has a parent jurisdiction.
 */
function _markaspot_group_group_has_parent_jurisdiction(GroupInterface $group): bool {
  return $group->hasField('field_parent_jurisdiction') && !$group->get('field_parent_jurisdiction')->isEmpty();
}

/**
 * Re-stamps service requests when their organisation moves jurisdiction.
 */
function _markaspot_group_restamp_service_requests_for_org_move(
  int $org_group_id,
  ?int $new_jurisdiction_id,
  ?int $original_jurisdiction_id,
): void {
  if ($org_group_id <= 0) {
    return;
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  if ($new_jurisdiction_id !== NULL) {
    $new_jurisdiction = $entity_type_manager->getStorage('group')->load($new_jurisdiction_id);
    if (!_markaspot_group_is_jurisdiction_group($new_jurisdiction)) {
      \Drupal::logger('markaspot_group')->error(
        'Cannot re-stamp service requests for org @org: target jurisdiction @new does not exist or is not a jurisdiction group.',
        [
          '@org' => $org_group_id,
          '@new' => $new_jurisdiction_id,
        ]
      );
      return;
    }
    if (_markaspot_group_group_has_parent_jurisdiction($new_jurisdiction)) {
      \Drupal::logger('markaspot_group')->error(
        'Cannot re-stamp service requests for org @org: target jurisdiction @new is a child jurisdiction.',
        [
          '@org' => $org_group_id,
          '@new' => $new_jurisdiction_id,
        ]
      );
      return;
    }
  }

  if ($original_jurisdiction_id === NULL) {
    \Drupal::logger('markaspot_group')->warning(
      'Cannot re-stamp service requests for org @org: original jurisdiction is empty.',
      ['@org' => $org_group_id]
    );
    return;
  }

  if (!_markaspot_group_is_root_jurisdiction_id($original_jurisdiction_id)) {
    \Drupal::logger('markaspot_group')->warning(
      'Cannot re-stamp service requests for org @org: original jurisdiction @old is missing or not a root jurisdiction.',
      [
        '@org' => $org_group_id,
        '@old' => $original_jurisdiction_id,
      ]
    );
    return;
  }

  $node_storage = $entity_type_manager->getStorage('node');
  $nids = $node_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'service_request')
    ->condition('field_organisation', $org_group_id)
    ->execute();
  if (empty($nids)) {
    return;
  }

  $restamped = 0;
  foreach (array_chunk(array_map('intval', $nids), 50) as $chunk) {
    foreach ($chunk as $node_id) {
      $synced = _markaspot_group_with_service_request_sync_lock($node_id, static function () use (
        $node_id,
        $node_storage,
        $org_group_id,
        $new_jurisdiction_id,
        $original_jurisdiction_id,
        &$restamped,
      ): void {
        $node_storage->resetCache([$node_id]);
        $node = $node_storage->load($node_id);
        if (!$node instanceof NodeInterface || $node->bundle() !== 'service_request') {
          return;
        }
        if (!$node->hasField('field_organisation') || !$node->hasField('field_jurisdiction')) {
          return;
        }

        $org_ids = _markaspot_group_field_target_ids($node, 'field_organisation');
        $node_jurisdiction_id = _markaspot_group_node_jurisdiction_id($node);
        $node_matches_original_scope = _markaspot_group_jurisdiction_matches_scope($node_jurisdiction_id, $original_jurisdiction_id);
        if (!$node_matches_original_scope) {
          \Drupal::logger('markaspot_group')->warning(
            'Skipped service request @nid during org @org re-stamp because current jurisdiction @current is outside original org jurisdiction @old.',
            [
              '@nid' => $node->id(),
              '@org' => $org_group_id,
              '@current' => $node_jurisdiction_id ?? 'none',
              '@old' => $original_jurisdiction_id ?? 'none',
            ]
          );
          return;
        }

        $restamp_values = _markaspot_group_org_move_restamp_values(
          $org_ids,
          $org_group_id,
          $new_jurisdiction_id,
          $node_jurisdiction_id,
          $node_matches_original_scope,
        );
        if ($restamp_values === NULL) {
          return;
        }

        if ($restamp_values['org_ids'] !== $org_ids) {
          $node->set(
            'field_organisation',
            $restamp_values['org_ids'] ? array_map(static fn(int $id) => ['target_id' => $id], $restamp_values['org_ids']) : NULL,
          );
        }
        if ($restamp_values['jurisdiction_id'] !== NULL
          && $restamp_values['jurisdiction_id'] !== $node_jurisdiction_id) {
          $node->set('field_jurisdiction', ['target_id' => $restamp_values['jurisdiction_id']]);
        }

        try {
          $node->save();
          $restamped++;
        }
        catch (\Throwable $throwable) {
          \Drupal::logger('markaspot_group')->error(
            'Failed to re-stamp service request @nid after org @org moved from jurisdiction @old to @new: @error',
            [
              '@nid' => $node->id(),
              '@org' => $org_group_id,
              '@old' => $original_jurisdiction_id ?? 'none',
              '@new' => $new_jurisdiction_id ?? 'none',
              '@error' => $throwable->getMessage(),
            ]
          );
        }
      });
      if (!$synced) {
        \Drupal::logger('markaspot_group')->warning(
          'Skipped service request @nid during org @org re-stamp because another sync still holds the node lock.',
          [
            '@nid' => $node_id,
            '@org' => $org_group_id,
          ]
        );
      }
    }
  }

  if ($restamped > 0) {
    \Drupal::logger('markaspot_group')->notice(
      'Re-stamped @count service requests after org @org moved from jurisdiction @old to @new.',
      [
        '@count' => $restamped,
        '@org' => $org_group_id,
        '@old' => $original_jurisdiction_id ?? 'none',
        '@new' => $new_jurisdiction_id ?? 'none',
      ]
    );
  }
}

/**
 * Determines field changes for a service request affected by an org move.
 *
 * @param array<int, int> $org_ids
 *   Current service request organisation IDs.
 * @param int $org_group_id
 *   Moved organisation group ID.
 * @param int|null $new_jurisdiction_id
 *   New organisation jurisdiction ID, or NULL when the org became unresolved.
 * @param int|null $node_jurisdiction_id
 *   Current service request jurisdiction ID.
 * @param bool $node_matches_original_scope
 *   TRUE when the service request belongs to the original org jurisdiction
 *   scope.
 *
 * @return array{jurisdiction_id:int|null, org_ids:array<int, int>}|null
 *   New field values, or NULL when no restamp is needed.
 */
function _markaspot_group_org_move_restamp_values(
  array $org_ids,
  int $org_group_id,
  ?int $new_jurisdiction_id,
  ?int $node_jurisdiction_id,
  bool $node_matches_original_scope,
): ?array {
  if (!$node_matches_original_scope || !in_array($org_group_id, $org_ids, TRUE)) {
    return NULL;
  }

  if ($new_jurisdiction_id === NULL) {
    return [
      'jurisdiction_id' => $node_jurisdiction_id,
      'org_ids' => array_values(array_diff($org_ids, [$org_group_id])),
    ];
  }

  if ($node_jurisdiction_id === $new_jurisdiction_id) {
    return NULL;
  }

  return [
    'jurisdiction_id' => $new_jurisdiction_id,
    'org_ids' => $org_ids,
  ];
}

/**
 * Checks whether a jurisdiction belongs to a scope jurisdiction.
 */
function _markaspot_group_jurisdiction_matches_scope(?int $jurisdiction_id, int $scope_jurisdiction_id): bool {
  if ($jurisdiction_id === NULL) {
    return FALSE;
  }

  if ($jurisdiction_id === $scope_jurisdiction_id) {
    return TRUE;
  }

  $root_jurisdiction_id = \Drupal::service('markaspot_group.hierarchy_resolver')
    ->getRootJurisdictionId($jurisdiction_id);

  return $root_jurisdiction_id !== NULL && $root_jurisdiction_id === $scope_jurisdiction_id;
}

/**
 * Helper function to add a user to all groups if they have the field enabled.
 *
 * Applies different rules based on group type:
 * - JUR (Jurisdiction): Only user 1 (uid=1) is automatically added.
 * - ORG (Organisation): All users with field_all_groups_member are added.
 *
 * @param \Drupal\user\UserInterface $account
 *   The user account to process.
 */
function _markaspot_group_handle_user_membership(UserInterface $account): void {
  // Check if user has the "All Groups Member" field enabled.
  if (!$account->hasField('field_all_groups_member')) {
    return;
  }

  $is_all_groups_member = (bool) $account->get('field_all_groups_member')->value;
  if (!$is_all_groups_member) {
    return;
  }

  // Load all groups and add the user as a member with admin role.
  $groups = Group::loadMultiple();
  foreach ($groups as $group) {
    // Check if user is allowed to be added to this group type.
    if (_markaspot_group_user_allowed_for_group($account, $group)) {
      _markaspot_group_add_member_to_group($group, $account);
    }
  }
}

/**
 * Helper function to add all "All Groups Member" users to a new group.
 *
 * Applies different rules based on group type:
 * - JUR (Jurisdiction): Only user 1 (uid=1) is automatically added.
 * - ORG (Organisation): All users with field_all_groups_member are added.
 *
 * @param \Drupal\group\Entity\GroupInterface $group
 *   The group to add members to.
 */
function _markaspot_group_add_all_groups_members_to_group(GroupInterface $group): void {
  /** @var \Drupal\Core\Entity\EntityTypeManagerInterface $entity_type_manager */
  $entity_type_manager = \Drupal::entityTypeManager();

  // Load all users with the "All Groups Member" field enabled.
  $user_storage = $entity_type_manager->getStorage('user');
  $query = $user_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('field_all_groups_member', TRUE)
    ->condition('status', 1);

  $uids = $query->execute();
  if (empty($uids)) {
    return;
  }

  /** @var \Drupal\user\UserInterface[] $users */
  $users = $user_storage->loadMultiple($uids);
  foreach ($users as $user) {
    // Check if user is allowed to be added to this group type.
    if (_markaspot_group_user_allowed_for_group($user, $group)) {
      _markaspot_group_add_member_to_group($group, $user);
    }
  }
}

/**
 * Checks if a user is allowed to be auto-added to a group.
 *
 * Called by _markaspot_group_add_all_groups_members_to_group() for users
 * with field_all_groups_member enabled. Currently allows all group types.
 *
 * @param \Drupal\user\UserInterface $account
 *   The user account to check.
 * @param \Drupal\group\Entity\GroupInterface $group
 *   The group to check against.
 *
 * @return bool
 *   TRUE if the user is allowed to be added, FALSE otherwise.
 */
function _markaspot_group_user_allowed_for_group(UserInterface $account, GroupInterface $group): bool {
  // JUR groups: only uid=1 is auto-added as member.
  if (_markaspot_group_is_jurisdiction_group($group)) {
    return (int) $account->id() === 1;
  }
  // ORG groups: all users with field_all_groups_member are added.
  return TRUE;
}

/**
 * Helper function to add a user to a group as member.
 *
 * In Group 3.x, admin permissions are handled via 'insider' scope roles
 * which automatically apply to all group members. Therefore we simply
 * add the user as a member without specifying a role.
 *
 * @param \Drupal\group\Entity\GroupInterface $group
 *   The group to add the member to.
 * @param \Drupal\user\UserInterface $account
 *   The user account to add.
 */
function _markaspot_group_add_member_to_group(GroupInterface $group, UserInterface $account): void {
  // Skip if user is already a member.
  if ($group->getMember($account)) {
    return;
  }

  // Add user as member. Admin permissions come from insider scope roles.
  $group->addMember($account);

  \Drupal::logger('markaspot_group')->notice(
    'Added user @user to group @group as member.',
    [
      '@user' => $account->getDisplayName(),
      '@group' => $group->label(),
    ]
  );
}

/**
 * Adds uid 1 to a new jur/org group.
 *
 * Admin permissions come from insider-scoped group roles mapped to the Drupal
 * administrator role. Explicitly writing those roles to group_roles would feed
 * non-individual roles into the individual permission calculator.
 */
function _markaspot_group_add_root_admin_to_group(GroupInterface $group): void {
  if (!in_array($group->bundle(), _markaspot_group_root_admin_group_types(), TRUE)) {
    return;
  }

  $account = User::load(1);
  if (!$account instanceof UserInterface || $account->isBlocked()) {
    return;
  }
  if (!$account->hasRole('administrator')) {
    \Drupal::logger('markaspot_group')->warning('Cannot auto-onboard uid 1 to group @gid: uid 1 lacks the administrator role.', [
      '@gid' => $group->id(),
    ]);
    return;
  }
  if ($group->getMember($account)) {
    return;
  }

  $group->addMember($account);
  \Drupal::logger('markaspot_group')->notice('Auto-onboarded uid 1 as member on group @gid (@label).', [
    '@gid' => $group->id(),
    '@label' => $group->label(),
  ]);
}

/**
 * Returns group types where uid 1 must keep runtime admin membership.
 *
 * @return string[]
 *   Group bundle machine names.
 */
function _markaspot_group_root_admin_group_types(): array {
  $jurisdiction_type = \Drupal::config('markaspot_open311.settings')->get('jurisdiction_group_type') ?: 'jur';
  return array_values(array_unique([$jurisdiction_type, 'org']));
}

/**
 * Implements hook_node_presave().
 *
 * Handles two presave operations for service_request nodes:
 * 1. Corrects initial status for multi-tenant jurisdictions (new nodes only).
 * 2. Syncs field_organisation to group relationship.
 *
 * This hook runs BEFORE service_request_node_presave (module weight order),
 * ensuring the status is corrected before the status note paragraph is created.
 */
function markaspot_group_node_presave(NodeInterface $node): void {
  // Only process service_request nodes.
  if ($node->bundle() !== 'service_request') {
    return;
  }

  // 1. Correct initial status for jurisdiction-aware multi-tenant setups.
  _markaspot_group_presave_service_request_status($node);

  // Check if we're already syncing from relationship to field.
  // This prevents infinite loops.
  if (_markaspot_group_is_syncing()) {
    return;
  }

  if (!$node->isNew()) {
    if (!_markaspot_group_acquire_service_request_sync_lock($node)) {
      throw new EntityStorageException(sprintf('Cannot acquire group sync lock for service_request %d.', $node->id()));
    }
    $node->_markaspot_group_sync_lock_held = TRUE;
    drupal_register_shutdown_function('_markaspot_group_release_service_request_sync_lock', (int) $node->id());
  }

  // 2. Detect field_jurisdiction changes and schedule jur relationship sync.
  if (!$node->isNew() && $node->hasField('field_jurisdiction')) {
    $new_jur_id = !$node->get('field_jurisdiction')->isEmpty()
      ? (int) $node->get('field_jurisdiction')->target_id
      : NULL;
    $original_jur_id = NULL;
    if (isset($node->original) && $node->original->hasField('field_jurisdiction') && !$node->original->get('field_jurisdiction')->isEmpty()) {
      $original_jur_id = (int) $node->original->get('field_jurisdiction')->target_id;
    }

    if ($new_jur_id !== $original_jur_id) {
      $node->_markaspot_group_jur_sync_needed = TRUE;
      $node->_markaspot_group_new_jur_id = $new_jur_id;
      $node->_markaspot_group_original_jur_id = $original_jur_id;
    }
  }

  // 3. Detect field_organisation changes and schedule org relationship sync.
  if (!$node->hasField('field_organisation')) {
    return;
  }

  _markaspot_group_rederive_org_on_category_change($node);
  _markaspot_group_filter_organisation_field_by_jurisdiction($node, TRUE);

  // Get ALL new organisation group IDs from the multi-value field.
  // Cast to int as JSON:API may pass string values.
  // Deduplicate to prevent redundant relationship operations.
  $new_group_ids = _markaspot_group_field_target_ids($node, 'field_organisation');

  // Write the deduped list back so JSON:API responses and Views don't carry
  // duplicate target_ids when upstream appenders (ECA process_apply_group,
  // API payload) add a GID that was already selected.
  $raw_ids = array_map('intval', array_column($node->get('field_organisation')->getValue(), 'target_id'));
  if (count($raw_ids) !== count($new_group_ids)) {
    $node->set('field_organisation', array_map(static fn(int $id) => ['target_id' => $id], array_values($new_group_ids)));
  }

  // For new nodes, we can't sync yet - need to wait until after save.
  // The relationships will be created in hook_node_insert.
  if ($node->isNew()) {
    // Store the group IDs for later processing in hook_node_insert.
    $node->_markaspot_group_pending_sync = $new_group_ids;
    return;
  }

  // For existing nodes, check the original values.
  // Cast to int as JSON:API may pass string values.
  $original_group_ids = [];
  if (isset($node->original) && $node->original->hasField('field_organisation') && !$node->original->get('field_organisation')->isEmpty()) {
    $original_group_ids = _markaspot_group_field_target_ids($node->original, 'field_organisation');
  }

  // If nothing changed, skip sync.
  $added = array_diff($new_group_ids, $original_group_ids);
  $removed = array_diff($original_group_ids, $new_group_ids);
  if (empty($added) && empty($removed)) {
    return;
  }

  // Schedule sync for hook_node_update (we need the node to exist first).
  $node->_markaspot_group_sync_needed = TRUE;
  $node->_markaspot_group_added_group_ids = array_values($added);
  $node->_markaspot_group_removed_group_ids = array_values($removed);
}

/**
 * Removes organisation references that do not match the request jurisdiction.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service request node.
 * @param bool $clear_when_unresolved
 *   TRUE to clear organisations when the node jurisdiction is unresolved.
 */
function _markaspot_group_filter_organisation_field_by_jurisdiction(
  NodeInterface $node,
  bool $clear_when_unresolved = FALSE,
): void {
  if (!$node->hasField('field_organisation') || $node->get('field_organisation')->isEmpty()) {
    return;
  }

  $jurisdiction_id = _markaspot_group_node_jurisdiction_id($node);
  if ($jurisdiction_id === NULL) {
    if ($clear_when_unresolved) {
      \Drupal::logger('markaspot_group')->warning(
        'Node @nid: cannot resolve field_jurisdiction. Removing field_organisation to avoid cross-tenant drift.',
        ['@nid' => $node->id() ? (int) $node->id() : 'new']
      );
      $node->set('field_organisation', NULL);
    }
    return;
  }

  $org_ids = _markaspot_group_field_target_ids($node, 'field_organisation');
  $filtered_ids = _markaspot_group_filter_org_ids_by_jurisdiction(
    $org_ids,
    $jurisdiction_id,
    $node->id() ? (int) $node->id() : NULL,
  );
  if ($filtered_ids === $org_ids) {
    return;
  }

  $node->set(
    'field_organisation',
    $filtered_ids ? array_map(static fn(int $id) => ['target_id' => $id], $filtered_ids) : NULL,
  );
}

/**
 * Filters organisation IDs to those that can be assigned to a jurisdiction.
 *
 * @param array<int, int> $org_ids
 *   Organisation group IDs.
 * @param int|null $jurisdiction_id
 *   Node jurisdiction ID.
 * @param int|null $node_id
 *   Node ID for logging, or NULL for new nodes.
 *
 * @return array<int, int>
 *   Valid organisation group IDs.
 */
function _markaspot_group_filter_org_ids_by_jurisdiction(
  array $org_ids,
  ?int $jurisdiction_id,
  ?int $node_id = NULL,
): array {
  if ($jurisdiction_id === NULL || empty($org_ids)) {
    return $org_ids;
  }

  $groups = \Drupal::entityTypeManager()
    ->getStorage('group')
    ->loadMultiple($org_ids);

  $valid_ids = [];
  foreach ($org_ids as $org_id) {
    $group = $groups[$org_id] ?? NULL;
    if (!$group instanceof GroupInterface || $group->bundle() !== _markaspot_group_get_org_group_type()) {
      \Drupal::logger('markaspot_group')->warning(
        'Node @nid: field_organisation references invalid org group @gid. Removing from field.',
        [
          '@nid' => $node_id ?? 'new',
          '@gid' => $org_id,
        ]
      );
      continue;
    }

    if (!_markaspot_group_org_group_matches_jurisdiction($group, $jurisdiction_id)) {
      $org_jurisdiction_id = $group->hasField('field_jurisdiction') && !$group->get('field_jurisdiction')->isEmpty()
        ? (int) $group->get('field_jurisdiction')->target_id
        : 'none';
      \Drupal::logger('markaspot_group')->warning(
        'Cross-tenant mismatch: node @nid (jur=@node_jur) assigned to org @gid (jur=@org_jur). Removing from field_organisation.',
        [
          '@nid' => $node_id ?? 'new',
          '@node_jur' => $jurisdiction_id,
          '@gid' => $org_id,
          '@org_jur' => $org_jurisdiction_id,
        ]
      );
      continue;
    }

    $valid_ids[] = $org_id;
  }

  return $valid_ids;
}

/**
 * Re-derives field_organisation when an existing request changes category.
 */
function _markaspot_group_rederive_org_on_category_change(NodeInterface $node): void {
  if ($node->isNew()
    || !_markaspot_group_field_target_changed($node, 'field_category')
    || _markaspot_group_field_target_changed($node, 'field_organisation')) {
    return;
  }

  $current_jurisdiction_id = NULL;
  if ($node->hasField('field_jurisdiction') && !$node->get('field_jurisdiction')->isEmpty()) {
    $current_jurisdiction_id = (int) $node->get('field_jurisdiction')->target_id;
  }

  $original_jurisdiction_id = NULL;
  if (isset($node->original)
    && $node->original instanceof NodeInterface
    && $node->original->hasField('field_jurisdiction')
    && !$node->original->get('field_jurisdiction')->isEmpty()) {
    $original_jurisdiction_id = (int) $node->original->get('field_jurisdiction')->target_id;
  }

  $old_org_group_id = _markaspot_group_derive_org_from_category($node->original, $original_jurisdiction_id);
  $new_org_group_id = _markaspot_group_derive_org_from_category($node, $current_jurisdiction_id);

  $updated_org_ids = _markaspot_group_field_target_ids($node, 'field_organisation');
  if ($old_org_group_id) {
    $updated_org_ids = array_values(array_diff($updated_org_ids, [$old_org_group_id]));
  }

  if ($new_org_group_id) {
    if (_markaspot_group_org_matches_jurisdiction($new_org_group_id, $current_jurisdiction_id)) {
      $updated_org_ids[] = $new_org_group_id;
    }
    else {
      \Drupal::logger('markaspot_group')->warning(
        'Category change derived org @gid outside node jurisdiction @jur_id. Leaving field_organisation without that org.',
        [
          '@gid' => $new_org_group_id,
          '@jur_id' => $current_jurisdiction_id ?? 'none',
        ]
      );
    }
  }

  $updated_org_ids = array_values(array_unique(array_filter(array_map('intval', $updated_org_ids))));
  $node->set('field_organisation', $updated_org_ids ? array_map(static fn(int $id) => ['target_id' => $id], $updated_org_ids) : NULL);
}

/**
 * Gets the node's field_jurisdiction target ID.
 */
function _markaspot_group_node_jurisdiction_id(NodeInterface $node): ?int {
  if (!$node->hasField('field_jurisdiction') || $node->get('field_jurisdiction')->isEmpty()) {
    return NULL;
  }

  return (int) $node->get('field_jurisdiction')->target_id;
}

/**
 * Checks whether an org group can be assigned to the given jurisdiction.
 */
function _markaspot_group_org_matches_jurisdiction(int $org_group_id, ?int $jurisdiction_id): bool {
  $group = \Drupal::entityTypeManager()->getStorage('group')->load($org_group_id);
  return $group instanceof GroupInterface && _markaspot_group_org_group_matches_jurisdiction($group, $jurisdiction_id);
}

/**
 * Checks whether an org group entity can be assigned to the jurisdiction.
 */
function _markaspot_group_org_group_matches_jurisdiction(GroupInterface $group, ?int $jurisdiction_id): bool {
  if (!$group || $group->bundle() !== _markaspot_group_get_org_group_type()) {
    return FALSE;
  }

  if ($jurisdiction_id === NULL) {
    return FALSE;
  }

  if (!$group->hasField('field_jurisdiction') || $group->get('field_jurisdiction')->isEmpty()) {
    return FALSE;
  }

  $org_jurisdiction_id = (int) $group->get('field_jurisdiction')->target_id;
  if ($org_jurisdiction_id === $jurisdiction_id) {
    return TRUE;
  }

  $root_jurisdiction_id = \Drupal::service('markaspot_group.hierarchy_resolver')
    ->getRootJurisdictionId($jurisdiction_id);

  return $root_jurisdiction_id !== NULL && $org_jurisdiction_id === $root_jurisdiction_id;
}

/**
 * Gets unique integer target IDs from an entity reference field.
 */
function _markaspot_group_field_target_ids(NodeInterface $node, string $field_name): array {
  if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
    return [];
  }

  $ids = array_unique(array_filter(
    array_map('intval', array_column($node->get($field_name)->getValue(), 'target_id'))
  ));
  sort($ids);
  return array_values($ids);
}

/**
 * Checks whether an entity reference field changed on an existing node.
 */
function _markaspot_group_field_target_changed(NodeInterface $node, string $field_name): bool {
  if (!isset($node->original) || !$node->original instanceof NodeInterface) {
    return FALSE;
  }

  return _markaspot_group_field_target_ids($node, $field_name) !== _markaspot_group_field_target_ids($node->original, $field_name);
}

/**
 * Implements hook_node_insert().
 *
 * Handles all group assignments for new service_request nodes:
 * 1. Assigns sub-jurisdictions by geographic boundary
 * 2. Assigns root jurisdiction (fallback when no sub-jur matched)
 * 3. Derives organisation from category (jurisdiction-aware)
 * 4. Syncs field_organisation to org group relationship
 * 5. Saves node if org was derived.
 *
 * The sub-jurisdiction assignment runs first so that org derivation can
 * check whether a child jurisdiction has its own org handling the category.
 */
function markaspot_group_node_insert(NodeInterface $node): void {
  // Only process service_request nodes.
  if ($node->bundle() !== 'service_request') {
    return;
  }

  // 1. Auto-assign to sub-jurisdictions based on geographic boundaries.
  // Returns the child jur group ID (int) or FALSE if no sub-jur matched.
  // Run this BEFORE org derivation so we know which jurisdiction to check
  // for jurisdiction-specific org assignments.
  $child_jur_id = _markaspot_group_assign_sub_jurisdictions($node);

  // 2. Set field_jurisdiction based on configured strategy before any
  // organisation-derived assignment can trust submitted field_organisation.
  $jur_set = FALSE;
  if ($node->hasField('field_jurisdiction') && $node->get('field_jurisdiction')->isEmpty()) {
    $jur_set = _markaspot_group_set_jurisdiction_field($node, $child_jur_id);
  }

  // Presave can run before field_jurisdiction is derived for new nodes. Once
  // insert has resolved it, re-apply the org guard and update pending sync.
  if ($node->hasField('field_organisation')) {
    _markaspot_group_filter_organisation_field_by_jurisdiction($node, TRUE);
    $node->_markaspot_group_pending_sync = _markaspot_group_field_target_ids($node, 'field_organisation');
  }

  // 3. Auto-assign to root jurisdiction group (only if no child jur was found).
  // Skip entirely when a sub-jurisdiction was assigned: the reporting jur
  // (e.g. Noord) is the authoritative one. Adding the root (e.g. Amsterdam)
  // would make escalation meaningless because the request already belongs
  // to the parent's scope.
  if (!$child_jur_id) {
    _markaspot_group_assign_root_jurisdiction($node);
  }

  // 4. Derive organisation from category if not already set.
  //    Replaces ECA rule process_apply_group which read
  //    [node:field_category:entity:field_category_gid].
  //    Now jurisdiction-aware: use the resolved field_jurisdiction so root
  //    and child requests both check org field_service_categories before
  //    falling back to the category's field_category_gid.
  $org_derived = FALSE;
  if ($node->hasField('field_organisation') && $node->get('field_organisation')->isEmpty()) {
    $org_jurisdiction_id = _markaspot_group_node_jurisdiction_id($node) ?? ($child_jur_id ?: NULL);
    $org_group_id = _markaspot_group_derive_org_from_category($node, $org_jurisdiction_id);
    if ($org_group_id) {
      $node->set('field_organisation', ['target_id' => $org_group_id]);
      $node->_markaspot_group_pending_sync = $org_group_id;
      $org_derived = TRUE;
    }
  }

  if ($node->hasField('field_organisation')) {
    _markaspot_group_filter_organisation_field_by_jurisdiction($node, TRUE);
    $filtered_org_ids = _markaspot_group_field_target_ids($node, 'field_organisation');
    $node->_markaspot_group_pending_sync = $filtered_org_ids;
    if ($org_derived && !in_array((int) $org_group_id, $filtered_org_ids, TRUE)) {
      $org_derived = FALSE;
    }
  }

  // 5. Sync field_organisation to org group relationships.
  if (isset($node->_markaspot_group_pending_sync) && !_markaspot_group_is_syncing()) {
    $pending = $node->_markaspot_group_pending_sync;
    // Support both legacy single ID and new array format.
    $group_ids = is_array($pending) ? $pending : [$pending];
    foreach ($group_ids as $group_id) {
      if (!empty($group_id)) {
        _markaspot_group_sync_field_to_relationship($node, $group_id, NULL);
      }
    }
  }

  // Organisation notifications are emitted when the org relationship is
  // created. That covers dashboard, JSON:API, admin UI, Drush and legacy ECA
  // writes without double-sending on freshly inserted nodes.

  // 6. Save the node if org was derived or jurisdiction was set.
  if ($org_derived || $jur_set) {
    // Prevent recursive hooks during this save.
    _markaspot_group_set_syncing(TRUE);
    try {
      $node->save();
    }
    finally {
      _markaspot_group_set_syncing(FALSE);
    }
  }

  // New nodes can receive field_jurisdiction during hook_node_insert. Run the
  // central reconciler after the optional second save so persisted field values
  // and group relationships end in the same state as regular updates.
  if ($node->hasField('field_jurisdiction') && !$node->get('field_jurisdiction')->isEmpty()) {
    _markaspot_group_reconcile_service_request_relationships($node);
  }
}

/**
 * Implements hook_node_update().
 *
 * Updates group relationships when field_organisation or field_jurisdiction
 * changes on a service_request node.
 */
function markaspot_group_node_update(NodeInterface $node): void {
  // Only process service_request nodes.
  if ($node->bundle() !== 'service_request') {
    return;
  }

  // Check if we're already syncing.
  if (_markaspot_group_is_syncing()) {
    return;
  }

  try {
    _markaspot_group_reconcile_service_request_relationships($node);
  }
  finally {
    if (!empty($node->_markaspot_group_sync_lock_held)) {
      _markaspot_group_release_service_request_sync_lock($node);
      unset($node->_markaspot_group_sync_lock_held);
    }
  }
}

/**
 * Reconciles service request group relationships from current node fields.
 *
 * The node update path must not replay presave diffs after waiting for a lock:
 * another write may have changed the stored node meanwhile. Re-load inside the
 * lock and make relationships match the current field_jurisdiction and
 * field_organisation values.
 *
 * @param \Drupal\node\NodeInterface|int $node
 *   The service request node or node ID to reconcile.
 */
function _markaspot_group_reconcile_service_request_relationships(NodeInterface|int $node): void {
  $synced = _markaspot_group_with_service_request_sync_lock($node, static function () use ($node): void {
    $node_id = $node instanceof NodeInterface ? (int) $node->id() : (int) $node;
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    $node_storage->resetCache([$node_id]);
    $fresh = $node_storage->load($node_id);
    if (!$fresh instanceof NodeInterface || $fresh->bundle() !== 'service_request') {
      return;
    }

    _markaspot_group_set_syncing(TRUE);
    try {
      $etm = \Drupal::entityTypeManager();
      $group_storage = $etm->getStorage('group');
      $relationship_storage = $etm->getStorage('group_relationship');
      $plugin_id = 'group_node:service_request';
      $desired_jur_id = _markaspot_group_node_jurisdiction_id($fresh);
      $desired_org_ids = $fresh->hasField('field_organisation')
        ? _markaspot_group_field_target_ids($fresh, 'field_organisation')
        : [];
      $desired_org_ids = _markaspot_group_filter_org_ids_by_jurisdiction(
        $desired_org_ids,
        $desired_jur_id,
        (int) $fresh->id(),
      );

      $relationships = $relationship_storage->loadByProperties([
        'entity_id' => $fresh->id(),
        'plugin_id' => $plugin_id,
      ]);
      $actual_jur_ids = [];
      $actual_org_ids = [];
      foreach ($relationships as $relationship) {
        $group = $relationship->getGroup();
        if (!$group instanceof GroupInterface) {
          continue;
        }
        $gid = (int) $group->id();
        if (_markaspot_group_is_jurisdiction_group($group)) {
          if ($desired_jur_id === NULL || $gid !== $desired_jur_id) {
            $relationship->delete();
            continue;
          }
          $actual_jur_ids[$gid] = TRUE;
        }
        elseif ($group->bundle() === _markaspot_group_get_org_group_type()) {
          if (!in_array($gid, $desired_org_ids, TRUE)) {
            $relationship->delete();
            continue;
          }
          $actual_org_ids[$gid] = TRUE;
        }
      }

      if ($desired_jur_id !== NULL && empty($actual_jur_ids[$desired_jur_id])) {
        $group = $group_storage->load($desired_jur_id);
        if (_markaspot_group_is_jurisdiction_group($group)) {
          $group->addRelationship($fresh, $plugin_id);
        }
      }

      foreach ($desired_org_ids as $org_id) {
        if (!empty($actual_org_ids[$org_id])) {
          continue;
        }
        $group = $group_storage->load($org_id);
        if ($group instanceof GroupInterface
          && $group->bundle() === _markaspot_group_get_org_group_type()
          && _markaspot_group_org_group_matches_jurisdiction($group, $desired_jur_id)) {
          $group->addRelationship($fresh, $plugin_id);
        }
      }
    }
    finally {
      _markaspot_group_set_syncing(FALSE);
    }
  });
  if (!$synced) {
    $node_id = $node instanceof NodeInterface ? (int) $node->id() : (int) $node;
    throw new EntityStorageException(sprintf('Cannot acquire group sync lock for service_request %d.', $node_id));
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for group_relationship entities.
 *
 * Syncs group relationship to field_organisation when a service_request
 * is added to an org group. Also syncs jur-tenant_admin group role to
 * the tenant_admin Drupal role.
 */
function markaspot_group_group_relationship_insert(GroupRelationshipInterface $relationship): void {
  _markaspot_group_sync_relationship_to_field($relationship, 'insert');
  _markaspot_group_notify_service_request_org_relationship($relationship, _markaspot_group_is_syncing());
  _markaspot_group_sync_org_membership_to_jurisdiction($relationship);
  _markaspot_group_tenant_admin_sync_role($relationship, 'insert');
}

/**
 * Implements hook_ENTITY_TYPE_update() for group_relationship entities.
 *
 * When a membership's group roles change, sync tenant_admin accordingly.
 */
function markaspot_group_group_relationship_update(GroupRelationshipInterface $relationship): void {
  _markaspot_group_tenant_admin_sync_role($relationship, 'update');
}

/**
 * Implements hook_ENTITY_TYPE_delete() for group_relationship entities.
 *
 * Clears field_organisation when a service_request is removed from an org group.
 * Also removes tenant_admin Drupal role if no jur-tenant_admin memberships remain.
 */
function markaspot_group_group_relationship_delete(GroupRelationshipInterface $relationship): void {
  _markaspot_group_sync_relationship_to_field($relationship, 'delete');
  _markaspot_group_cleanup_org_membership_jurisdiction($relationship);
  _markaspot_group_tenant_admin_sync_role($relationship, 'delete');
}

/**
 * Materializes the jurisdiction membership implied by an org membership.
 *
 * Org memberships are scoped by the org group's field_jurisdiction. Persisting
 * the matching jur membership keeps auth_user.groups and backend scope checks
 * aligned for dashboard APIs that operate on jurisdiction ids.
 *
 * @param \Drupal\group\Entity\GroupRelationshipInterface $relationship
 *   The inserted group relationship.
 */
function _markaspot_group_sync_org_membership_to_jurisdiction(GroupRelationshipInterface $relationship): void {
  if ($relationship->getPluginId() !== 'group_membership') {
    return;
  }

  $org_group = $relationship->getGroup();
  if (!$org_group instanceof GroupInterface || $org_group->bundle() !== _markaspot_group_get_org_group_type()) {
    return;
  }

  $user = $relationship->getEntity();
  if (!$user instanceof UserInterface) {
    return;
  }

  $jur_group = _markaspot_group_resolve_org_membership_jurisdiction($org_group);
  if (!$jur_group instanceof GroupInterface) {
    \Drupal::logger('markaspot_group')->error(
      'Cannot sync org membership @relationship to jurisdiction membership because org group @group has no valid field_jurisdiction.',
      [
        '@relationship' => $relationship->id(),
        '@group' => $org_group->id(),
      ]
    );
    return;
  }

  if ($jur_group->getMember($user)) {
    _markaspot_group_add_derived_jurisdiction_role($jur_group, $user);
    return;
  }

  $jur_group->addMember($user, ['group_roles' => [_markaspot_group_derived_jurisdiction_role_id($jur_group)]]);
  \Drupal::logger('markaspot_group')->notice(
    'Added user @uid to jurisdiction group @jur_gid because they joined organisation group @org_gid.',
    [
      '@uid' => $user->id(),
      '@jur_gid' => $jur_group->id(),
      '@org_gid' => $org_group->id(),
    ]
  );
}

/**
 * Cleans up derived jurisdiction membership after an org membership is removed.
 *
 * @param \Drupal\group\Entity\GroupRelationshipInterface $relationship
 *   The deleted org membership relationship.
 */
function _markaspot_group_cleanup_org_membership_jurisdiction(GroupRelationshipInterface $relationship): void {
  if ($relationship->getPluginId() !== 'group_membership') {
    return;
  }

  $org_group = $relationship->getGroup();
  if (!$org_group instanceof GroupInterface || $org_group->bundle() !== _markaspot_group_get_org_group_type()) {
    return;
  }

  $user = $relationship->getEntity();
  if (!$user instanceof UserInterface) {
    return;
  }

  $jur_group = _markaspot_group_resolve_org_membership_jurisdiction($org_group);
  if (!$jur_group instanceof GroupInterface) {
    return;
  }

  if (_markaspot_group_user_has_org_membership_for_jurisdiction($user, (int) $jur_group->id(), (int) $relationship->id())) {
    return;
  }

  _markaspot_group_remove_derived_jurisdiction_role($jur_group, $user);
}

/**
 * Re-syncs derived memberships when an org group moves jurisdictions.
 *
 * @param \Drupal\group\Entity\GroupInterface $org_group
 *   The moved organisation group.
 * @param int|null $new_jurisdiction_id
 *   The new jurisdiction id.
 * @param int|null $original_jurisdiction_id
 *   The previous jurisdiction id.
 */
function _markaspot_group_resync_org_memberships_for_org_move(GroupInterface $org_group, ?int $new_jurisdiction_id, ?int $original_jurisdiction_id): void {
  $relationship_ids = \Drupal::entityTypeManager()
    ->getStorage('group_relationship')
    ->getQuery()
    ->accessCheck(FALSE)
    ->condition('gid', (int) $org_group->id())
    ->condition('plugin_id', 'group_membership')
    ->execute();
  if (empty($relationship_ids)) {
    return;
  }

  $relationships = \Drupal::entityTypeManager()
    ->getStorage('group_relationship')
    ->loadMultiple($relationship_ids);
  $old_root_jurisdiction_id = $original_jurisdiction_id !== NULL
    ? \Drupal::service('markaspot_group.hierarchy_resolver')->getRootJurisdictionId($original_jurisdiction_id)
    : NULL;
  $old_jur_group = $old_root_jurisdiction_id !== NULL ? Group::load($old_root_jurisdiction_id) : NULL;
  $new_jur_group = $new_jurisdiction_id !== NULL ? _markaspot_group_resolve_org_membership_jurisdiction($org_group) : NULL;

  foreach ($relationships as $relationship) {
    if (!$relationship instanceof GroupRelationshipInterface) {
      continue;
    }
    $user = $relationship->getEntity();
    if (!$user instanceof UserInterface) {
      continue;
    }

    if ($old_jur_group instanceof GroupInterface
      && !_markaspot_group_user_has_org_membership_for_jurisdiction($user, (int) $old_jur_group->id())) {
      _markaspot_group_remove_derived_jurisdiction_role($old_jur_group, $user);
    }

    if ($new_jur_group instanceof GroupInterface) {
      if ($new_jur_group->getMember($user)) {
        _markaspot_group_add_derived_jurisdiction_role($new_jur_group, $user);
      }
      else {
        $new_jur_group->addMember($user, ['group_roles' => [_markaspot_group_derived_jurisdiction_role_id($new_jur_group)]]);
      }
    }
  }
}

/**
 * Adds the internal derived role to an existing jurisdiction membership.
 *
 * @param \Drupal\group\Entity\GroupInterface $jur_group
 *   The jurisdiction group.
 * @param \Drupal\user\UserInterface $user
 *   The user account.
 */
function _markaspot_group_add_derived_jurisdiction_role(GroupInterface $jur_group, UserInterface $user): void {
  $relationship = GroupMembershipEntity::loadSingle($jur_group, $user);
  if (!$relationship instanceof GroupRelationshipInterface) {
    return;
  }

  if ($relationship->bundle() !== _markaspot_group_jurisdiction_membership_bundle($jur_group)) {
    \Drupal::logger('markaspot_group')->error(
      'Refusing to add derived jur role to mismatched relationship @relationship with bundle @bundle on jurisdiction group @gid.',
      [
        '@relationship' => $relationship->id(),
        '@bundle' => $relationship->bundle(),
        '@gid' => $jur_group->id(),
      ]
    );
    return;
  }
  if (!$relationship->hasField('group_roles')) {
    return;
  }

  $role_ids = array_column($relationship->get('group_roles')->getValue(), 'target_id');
  $derived_role_id = _markaspot_group_derived_jurisdiction_role_id($jur_group);
  if (in_array($derived_role_id, $role_ids, TRUE)) {
    return;
  }

  $role_ids = array_values(array_filter(
    $role_ids,
    static fn(string $role_id): bool => $role_id !== MembershipRoleNormalizer::ORG_DERIVED_JUR_ROLE_ID
      || $derived_role_id === MembershipRoleNormalizer::ORG_DERIVED_JUR_ROLE_ID
  ));
  $role_ids[] = $derived_role_id;
  $relationship->set('group_roles', array_values(array_unique($role_ids)));
  $relationship->save();
}

/**
 * Removes the internal derived role and drops empty derived memberships.
 *
 * @param \Drupal\group\Entity\GroupInterface $jur_group
 *   The jurisdiction group.
 * @param \Drupal\user\UserInterface $user
 *   The user account.
 */
function _markaspot_group_remove_derived_jurisdiction_role(GroupInterface $jur_group, UserInterface $user): void {
  $relationship = GroupMembershipEntity::loadSingle($jur_group, $user);
  if (!$relationship instanceof GroupRelationshipInterface) {
    return;
  }

  if ($relationship->bundle() !== _markaspot_group_jurisdiction_membership_bundle($jur_group)) {
    \Drupal::logger('markaspot_group')->error(
      'Refusing to remove derived jur role from mismatched relationship @relationship with bundle @bundle on jurisdiction group @gid.',
      [
        '@relationship' => $relationship->id(),
        '@bundle' => $relationship->bundle(),
        '@gid' => $jur_group->id(),
      ]
    );
    return;
  }
  if (!$relationship->hasField('group_roles')) {
    return;
  }

  $role_ids = array_column($relationship->get('group_roles')->getValue(), 'target_id');
  $derived_role_ids = _markaspot_group_derived_jurisdiction_role_ids($jur_group);
  if (empty(array_intersect($derived_role_ids, $role_ids))) {
    return;
  }

  $remaining_roles = array_values(array_filter(
    $role_ids,
    static fn(string $role_id): bool => !in_array($role_id, $derived_role_ids, TRUE)
  ));

  if (empty($remaining_roles)) {
    $jur_group->removeMember($user);
    return;
  }

  $relationship->set('group_roles', $remaining_roles);
  $relationship->save();
}

/**
 * Checks whether a user has another org membership in a jurisdiction.
 *
 * @param \Drupal\user\UserInterface $user
 *   The user account.
 * @param int $jurisdiction_id
 *   The jurisdiction group id.
 * @param int|null $exclude_relationship_id
 *   Optional relationship id to ignore.
 *
 * @return bool
 *   TRUE when another org membership still implies the jurisdiction.
 */
function _markaspot_group_user_has_org_membership_for_jurisdiction(UserInterface $user, int $jurisdiction_id, ?int $exclude_relationship_id = NULL): bool {
  $memberships = GroupMembershipEntity::loadByUser($user);
  foreach ($memberships as $membership) {
    $relationship = $membership;
    if ($exclude_relationship_id !== NULL && (int) $relationship->id() === $exclude_relationship_id) {
      continue;
    }

    $group = $membership->getGroup();
    if (!$group instanceof GroupInterface || $group->bundle() !== _markaspot_group_get_org_group_type()) {
      continue;
    }

    $jur_group = _markaspot_group_resolve_org_membership_jurisdiction($group);
    if ($jur_group instanceof GroupInterface && (int) $jur_group->id() === $jurisdiction_id) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Resolves the jurisdiction group for an organisation group membership.
 *
 * @param \Drupal\group\Entity\GroupInterface $org_group
 *   The organisation group.
 *
 * @return \Drupal\group\Entity\GroupInterface|null
 *   The referenced jurisdiction group, or NULL when unresolved.
 */
function _markaspot_group_resolve_org_membership_jurisdiction(GroupInterface $org_group): ?GroupInterface {
  if (!$org_group->hasField('field_jurisdiction') || $org_group->get('field_jurisdiction')->isEmpty()) {
    return NULL;
  }

  $jurisdiction_id = (int) $org_group->get('field_jurisdiction')->target_id;
  if ($jurisdiction_id <= 0) {
    return NULL;
  }

  $root_jurisdiction_id = \Drupal::service('markaspot_group.hierarchy_resolver')
    ->getRootJurisdictionId($jurisdiction_id);
  if ($root_jurisdiction_id === NULL) {
    return NULL;
  }

  $jur_group = Group::load($root_jurisdiction_id);
  if (!_markaspot_group_is_jurisdiction_group($jur_group)) {
    return NULL;
  }

  return $jur_group;
}

/**
 * Syncs field_organisation to group relationship.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node.
 * @param int|null $new_group_id
 *   The new group ID to add the relationship to, or NULL to remove.
 * @param int|null $original_group_id
 *   The original group ID to remove the relationship from, or NULL.
 */
function _markaspot_group_sync_field_to_relationship(NodeInterface $node, ?int $new_group_id, ?int $original_group_id): void {
  $synced = _markaspot_group_with_service_request_sync_lock($node, function () use ($node, $new_group_id, $original_group_id): void {
    // Set syncing flag to prevent loops.
    _markaspot_group_set_syncing(TRUE);

    try {
      $entity_type_manager = \Drupal::entityTypeManager();
      $relationship_storage = $entity_type_manager->getStorage('group_relationship');
      $group_type = _markaspot_group_get_org_group_type();
      $plugin_id = 'group_node:service_request';

      // Remove existing relationship if group changed or was cleared.
      if ($original_group_id !== NULL) {
        // Find and delete the old relationship.
        $old_relationships = $relationship_storage->loadByProperties([
          'entity_id' => $node->id(),
          'gid' => $original_group_id,
          'plugin_id' => $plugin_id,
        ]);

        foreach ($old_relationships as $relationship) {
          $group = $relationship->getGroup();
          if ($group instanceof GroupInterface && $group->bundle() === $group_type) {
            $relationship->delete();
          }
        }
      }

      // Create new relationship if a group was set.
      if ($new_group_id !== NULL) {
        // Load the target group.
        $group = $entity_type_manager->getStorage('group')->load($new_group_id);

        if ($group && $group->bundle() === $group_type) {
          // Cross-tenant guard: verify the org belongs to the same jurisdiction
          // as the node. Prevents accidental assignment across tenants.
          $node_jur_id = _markaspot_group_node_jurisdiction_id($node);
          if ($node_jur_id === NULL) {
            \Drupal::logger('markaspot_group')->warning(
              'Node @nid: cannot sync org group @gid because field_jurisdiction is unresolved.',
              [
                '@nid' => $node->id(),
                '@gid' => $new_group_id,
              ]
            );
            return;
          }

          if (!_markaspot_group_org_group_matches_jurisdiction($group, $node_jur_id)) {
            $org_jur_id = $group->hasField('field_jurisdiction') && !$group->get('field_jurisdiction')->isEmpty()
              ? (int) $group->get('field_jurisdiction')->target_id
              : 'none';
            \Drupal::logger('markaspot_group')->warning(
              'Cross-tenant mismatch: node @nid (jur=@node_jur) assigned to org @gid (jur=@org_jur). Skipping relationship.',
              [
                '@nid' => $node->id(),
                '@node_jur' => $node_jur_id,
                '@gid' => $new_group_id,
                '@org_jur' => $org_jur_id,
              ]
            );
            return;
          }

          // Check if relationship already exists.
          $existing = $relationship_storage->loadByProperties([
            'entity_id' => $node->id(),
            'gid' => $new_group_id,
            'plugin_id' => $plugin_id,
          ]);

          if (empty($existing)) {
            // Create the relationship.
            $group->addRelationship($node, $plugin_id);

            \Drupal::logger('markaspot_group')->notice(
              'Created group relationship for node @nid in group @group (synced from field_organisation).',
              [
                '@nid' => $node->id(),
                '@group' => $group->label(),
              ]
            );
          }
        }
        elseif ($group) {
          \Drupal::logger('markaspot_group')->error(
            'Node @nid: field_organisation references group @gid with bundle "@bundle", expected "@expected". Skipping sync.',
            [
              '@nid' => $node->id(),
              '@gid' => $new_group_id,
              '@bundle' => $group->bundle(),
              '@expected' => $group_type,
            ]
          );
        }
      }
    }
    finally {
      // Always reset syncing flag.
      _markaspot_group_set_syncing(FALSE);
    }
  });
  if (!$synced) {
    throw new EntityStorageException(sprintf('Cannot acquire group sync lock for service_request %d.', $node->id()));
  }
}

/**
 * Syncs the jurisdiction group relationship when field_jurisdiction changes.
 *
 * Removes the old jur group relationship and creates a new one pointing to
 * the jurisdiction referenced by field_jurisdiction. This prevents drift
 * between field_jurisdiction and the group_relationship_field_data table.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node.
 * @param int|null $new_jur_id
 *   The new jurisdiction group ID.
 * @param int|null $original_jur_id
 *   The previous jurisdiction group ID, or NULL if none was set.
 */
function _markaspot_group_sync_jurisdiction_relationship(NodeInterface $node, ?int $new_jur_id, ?int $original_jur_id): void {
  $synced = _markaspot_group_with_service_request_sync_lock($node, function () use ($node, $new_jur_id, $original_jur_id): void {
    _markaspot_group_set_syncing(TRUE);

    try {
      $etm = \Drupal::entityTypeManager();
      $group_storage = $etm->getStorage('group');
      $relationship_storage = $etm->getStorage('group_relationship');
      $plugin_id = 'group_node:service_request';

      // Remove the old jurisdiction relationship if it exists.
      if ($original_jur_id !== NULL) {
        $old_relationships = $relationship_storage->loadByProperties([
          'entity_id' => $node->id(),
          'gid' => $original_jur_id,
          'plugin_id' => $plugin_id,
        ]);
        foreach ($old_relationships as $relationship) {
          // Only delete if the group is a jur group (not an org relationship).
          $group = $relationship->getGroup();
          if (_markaspot_group_is_jurisdiction_group($group)) {
            $relationship->delete();
          }
        }
      }

      // Create the new jurisdiction relationship.
      if ($new_jur_id !== NULL) {
        $new_group = $group_storage->load($new_jur_id);
        if (!_markaspot_group_is_jurisdiction_group($new_group)) {
          \Drupal::logger('markaspot_group')->warning(
            'Cannot sync jurisdiction relationship for node @nid: group @gid does not exist or is not a jurisdiction group.',
            ['@nid' => $node->id(), '@gid' => $new_jur_id]
          );
          return;
        }

        // Check if relationship already exists (idempotent).
        $existing = $relationship_storage->loadByProperties([
          'entity_id' => $node->id(),
          'gid' => $new_jur_id,
          'plugin_id' => $plugin_id,
        ]);

        if (empty($existing)) {
          $new_group->addRelationship($node, $plugin_id);
          \Drupal::logger('markaspot_group')->notice(
            'Synced jurisdiction relationship for node @nid: moved from group @old to group @new (@label).',
            [
              '@nid' => $node->id(),
              '@old' => $original_jur_id ?? 'none',
              '@new' => $new_jur_id,
              '@label' => $new_group->label(),
            ]
          );
        }
      }
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot_group')->error(
        'Failed to sync jurisdiction relationship for node @nid: @error',
        ['@nid' => $node->id(), '@error' => $e->getMessage()]
      );
    }
    finally {
      _markaspot_group_set_syncing(FALSE);
    }
  });
  if (!$synced) {
    throw new EntityStorageException(sprintf('Cannot acquire group sync lock for service_request %d.', $node->id()));
  }
}

/**
 * Syncs group relationship changes back to field_organisation.
 *
 * @param \Drupal\group\Entity\GroupRelationshipInterface $relationship
 *   The group relationship entity.
 * @param string $operation
 *   The operation: 'insert' or 'delete'.
 */
function _markaspot_group_sync_relationship_to_field(GroupRelationshipInterface $relationship, string $operation): void {
  // Only process service_request node relationships.
  if ($relationship->getPluginId() !== 'group_node:service_request') {
    return;
  }

  // Get the group type and check if it's an org type.
  $group = $relationship->getGroup();
  if (!$group) {
    return;
  }

  $group_type = _markaspot_group_get_org_group_type();
  if ($group->bundle() !== $group_type) {
    return;
  }

  // Check if we're already syncing.
  if (_markaspot_group_is_syncing()) {
    return;
  }

  $entity_id = (int) $relationship->getEntityId();
  if ($entity_id <= 0) {
    return;
  }

  $synced = _markaspot_group_with_service_request_sync_lock($entity_id, function () use ($relationship, $operation, $group): void {
    // Re-load the node inside the lock. The relationship entity can carry a
    // stale node instance when a node PATCH races the relationship hook.
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    $node_storage->resetCache([$relationship->getEntityId()]);
    $entity = $node_storage->load($relationship->getEntityId());
    if (!$entity instanceof NodeInterface) {
      return;
    }

    // Check if node has the field.
    if (!$entity->hasField('field_organisation')) {
      return;
    }

    // Set syncing flag.
    _markaspot_group_set_syncing(TRUE);

    try {
      $current_ids = array_map('intval', array_column($entity->get('field_organisation')->getValue(), 'target_id'));
      $group_id = (int) $group->id();

      if ($operation === 'insert') {
        $node_jur_id = _markaspot_group_node_jurisdiction_id($entity);
        if ($node_jur_id === NULL || !_markaspot_group_org_group_matches_jurisdiction($group, $node_jur_id)) {
          $org_jur_id = $group->hasField('field_jurisdiction') && !$group->get('field_jurisdiction')->isEmpty()
            ? (int) $group->get('field_jurisdiction')->target_id
            : 'none';
          \Drupal::logger('markaspot_group')->warning(
            'Cross-tenant mismatch: relationship @rid org @gid (jur=@org_jur) cannot be synced to node @nid (jur=@node_jur). Deleting relationship.',
            [
              '@rid' => $relationship->id() ?? 'new',
              '@gid' => $group_id,
              '@org_jur' => $org_jur_id,
              '@nid' => $entity->id(),
              '@node_jur' => $node_jur_id ?? 'none',
            ]
          );
          $relationship->delete();
          return;
        }

        // Append the group if not already present.
        if (!in_array($group_id, $current_ids, TRUE)) {
          $current_ids[] = $group_id;
          $entity->set('field_organisation', array_map(static fn(int $id) => ['target_id' => $id], $current_ids));
          $entity->save();

          \Drupal::logger('markaspot_group')->notice(
            'Appended group @group to field_organisation on node @nid (synced from relationship).',
            [
              '@nid' => $entity->id(),
              '@group' => $group->label(),
            ]
          );
        }
      }
      elseif ($operation === 'delete') {
        // Remove only this group from the multi-value field.
        $updated_ids = array_values(array_diff($current_ids, [$group_id]));
        if (count($updated_ids) !== count($current_ids)) {
          $value = empty($updated_ids) ? NULL : array_map(static fn(int $id) => ['target_id' => $id], $updated_ids);
          $entity->set('field_organisation', $value);
          $entity->save();

          \Drupal::logger('markaspot_group')->notice(
            'Removed group @group from field_organisation on node @nid (synced from relationship deletion).',
            [
              '@nid' => $entity->id(),
              '@group' => $group->label(),
            ]
          );
        }
      }
    }
    finally {
      _markaspot_group_set_syncing(FALSE);
    }
  });
  if (!$synced) {
    throw new EntityStorageException(sprintf('Cannot acquire group sync lock for service_request %d.', $entity_id));
  }
}

/**
 * Gets the configured jurisdiction group type.
 */
function _markaspot_group_jurisdiction_group_type(): string {
  return \Drupal::config('markaspot_open311.settings')
    ->get('jurisdiction_group_type') ?: 'jur';
}

/**
 * Gets the membership relationship bundle for a jurisdiction group.
 */
function _markaspot_group_jurisdiction_membership_bundle(?GroupInterface $group = NULL): string {
  $group_type = $group instanceof GroupInterface
    ? $group->bundle()
    : _markaspot_group_jurisdiction_group_type();

  return $group_type . '-group_membership';
}

/**
 * Gets the internal derived org-member role ID for a jurisdiction group.
 */
function _markaspot_group_derived_jurisdiction_role_id(?GroupInterface $group = NULL): string {
  $group_type = $group instanceof GroupInterface
    ? $group->bundle()
    : _markaspot_group_jurisdiction_group_type();

  return MembershipRoleNormalizer::orgDerivedJurRoleId($group_type);
}

/**
 * Gets accepted derived role IDs, including the legacy default role ID.
 */
function _markaspot_group_derived_jurisdiction_role_ids(?GroupInterface $group = NULL): array {
  return array_values(array_unique([
    _markaspot_group_derived_jurisdiction_role_id($group),
    MembershipRoleNormalizer::ORG_DERIVED_JUR_ROLE_ID,
  ]));
}

/**
 * Checks whether a group uses the configured jurisdiction group type.
 */
function _markaspot_group_is_jurisdiction_group(mixed $group): bool {
  return $group instanceof GroupInterface
    && $group->bundle() === _markaspot_group_jurisdiction_group_type();
}

/**
 * Checks whether a group bundle carries tenant-boundary protections.
 */
function _markaspot_group_is_protected_group_bundle(string $bundle): bool {
  return in_array($bundle, [
    _markaspot_group_jurisdiction_group_type(),
    _markaspot_group_get_org_group_type(),
  ], TRUE);
}

/**
 * Gets the organisation group type for field_organisation sync.
 *
 * Always returns 'org' because field_organisation must only reference
 * organisation groups, never jurisdiction groups. The group_filter_type
 * config controls API scoping and is intentionally not used here.
 *
 * @return string
 *   The group type machine name ('org').
 */
function _markaspot_group_get_org_group_type(): string {
  return 'org';
}

/**
 * Runs a callback under the per-service-request group sync lock.
 *
 * @param \Drupal\node\NodeInterface|int $node
 *   The service request node or node ID to lock.
 * @param callable $callback
 *   Callback to execute after the lock is acquired.
 *
 * @return bool
 *   TRUE when the callback ran, FALSE when the lock could not be acquired.
 */
function _markaspot_group_with_service_request_sync_lock(NodeInterface|int $node, callable $callback): bool {
  $lock_name = _markaspot_group_service_request_sync_lock_name($node);
  if ($lock_name === NULL) {
    $callback();
    return TRUE;
  }

  $held_locks = &drupal_static('_markaspot_group_service_request_sync_locks', []);
  if (!empty($held_locks[$lock_name])) {
    $callback();
    return TRUE;
  }

  if (!_markaspot_group_acquire_service_request_sync_lock($node)) {
    return FALSE;
  }

  try {
    $callback();
  }
  finally {
    _markaspot_group_release_service_request_sync_lock($node);
  }
  return TRUE;
}

/**
 * Builds the lock name for a service request sync.
 *
 * @param \Drupal\node\NodeInterface|int $node
 *   The service request node or node ID to lock.
 *
 * @return string|null
 *   Lock name, or NULL when no valid node ID is available.
 */
function _markaspot_group_service_request_sync_lock_name(NodeInterface|int $node): ?string {
  $node_id = $node instanceof NodeInterface ? (int) $node->id() : (int) $node;
  if ($node_id <= 0) {
    return NULL;
  }

  return 'markaspot_group:service_request_sync:' . $node_id;
}

/**
 * Acquires the per-service-request group sync lock.
 *
 * @param \Drupal\node\NodeInterface|int $node
 *   The service request node or node ID to lock.
 *
 * @return bool
 *   TRUE when the lock is held by this request.
 */
function _markaspot_group_acquire_service_request_sync_lock(NodeInterface|int $node): bool {
  $node_id = $node instanceof NodeInterface ? (int) $node->id() : (int) $node;
  $lock_name = _markaspot_group_service_request_sync_lock_name($node);
  if ($lock_name === NULL) {
    return TRUE;
  }

  $held_locks = &drupal_static('_markaspot_group_service_request_sync_locks', []);
  if (!empty($held_locks[$lock_name])) {
    return TRUE;
  }

  $lock = \Drupal::lock();
  if (!$lock->acquire($lock_name, 30.0)) {
    $lock->wait($lock_name, 1);
    if (!$lock->acquire($lock_name, 30.0)) {
      \Drupal::logger('markaspot_group')->warning(
        'Skipped group sync for service_request @nid because another sync still holds the node lock.',
        ['@nid' => $node_id]
      );
      return FALSE;
    }
  }

  $held_locks[$lock_name] = TRUE;
  return TRUE;
}

/**
 * Releases the per-service-request group sync lock if held by this request.
 *
 * @param \Drupal\node\NodeInterface|int $node
 *   The service request node or node ID to unlock.
 */
function _markaspot_group_release_service_request_sync_lock(NodeInterface|int $node): void {
  $lock_name = _markaspot_group_service_request_sync_lock_name($node);
  if ($lock_name === NULL) {
    return;
  }

  $held_locks = &drupal_static('_markaspot_group_service_request_sync_locks', []);
  if (empty($held_locks[$lock_name])) {
    return;
  }

  unset($held_locks[$lock_name]);
  \Drupal::lock()->release($lock_name);
}

/**
 * Checks if we're currently in a sync operation.
 *
 * Uses a static variable to prevent infinite loops during bidirectional sync.
 *
 * @return bool
 *   TRUE if currently syncing, FALSE otherwise.
 */
function _markaspot_group_is_syncing(): bool {
  return drupal_static(__FUNCTION__, FALSE);
}

/**
 * Sets the sync flag.
 *
 * @param bool $syncing
 *   Whether syncing is in progress.
 */
function _markaspot_group_set_syncing(bool $syncing): void {
  $static = &drupal_static('_markaspot_group_is_syncing', FALSE);
  $static = $syncing;
}

/**
 * Derives the organisation group from a node's category term.
 *
 * When a jurisdiction ID is provided, first searches for an org in that
 * jurisdiction that declares the category in its field_service_categories.
 * If no jurisdiction-specific org is found, falls back to the legacy
 * root-level org from field_category_gid on the category term.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node.
 * @param int|null $jurisdiction_id
 *   Optional jurisdiction group ID. When provided, the function first checks
 *   for an org in this jurisdiction that handles the node's category.
 *
 * @return int|null
 *   The org group ID, or NULL if no mapping exists.
 */
function _markaspot_group_derive_org_from_category(NodeInterface $node, ?int $jurisdiction_id = NULL): ?int {
  if (!$node->hasField('field_category') || $node->get('field_category')->isEmpty()) {
    return NULL;
  }

  $term = $node->get('field_category')->entity;
  if (!$term) {
    return NULL;
  }

  $category_tid = (int) $term->id();
  $group_storage = \Drupal::entityTypeManager()->getStorage('group');

  // Strategy 1: Jurisdiction-aware lookup.
  // Look for an org in the resolved request jurisdiction that declares this
  // category in field_service_categories.
  if ($jurisdiction_id) {
    $org_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'org')
      ->condition('field_jurisdiction', $jurisdiction_id)
      ->condition('field_service_categories', $category_tid)
      ->execute();

    if (!empty($org_ids)) {
      $org_id = (int) reset($org_ids);
      \Drupal::logger('markaspot_group')->notice(
        'Jurisdiction-aware org derivation: category TID=@tid matched org @org_id in jurisdiction @jur_id.',
        [
          '@tid' => $category_tid,
          '@org_id' => $org_id,
          '@jur_id' => $jurisdiction_id,
        ]
      );
      return $org_id;
    }
  }

  // Strategy 2: Fallback to root-level org via field_category_gid.
  if (!$term->hasField('field_category_gid') || $term->get('field_category_gid')->isEmpty()) {
    \Drupal::logger('markaspot_group')->warning(
      'Cannot derive organisation for service request @nid: category term @tid has no org mapping for jurisdiction @jur_id and field_category_gid is empty.',
      [
        '@nid' => $node->id() ?? 'new',
        '@tid' => $category_tid,
        '@jur_id' => $jurisdiction_id ?? 'none',
      ]
    );
    return NULL;
  }

  $org_group_id = _markaspot_group_category_gid_value($term);
  if ($org_group_id === NULL) {
    \Drupal::logger('markaspot_group')->warning(
      'Category term @tid has no numeric group mapping in field_category_gid.',
      ['@tid' => $term->id()]
    );
    return NULL;
  }

  // Verify the referenced group exists and is an org group.
  $group = $group_storage->load($org_group_id);
  if (!$group || $group->bundle() !== 'org') {
    \Drupal::logger('markaspot_group')->warning(
      'Category term @tid references non-existent or non-org group @gid via field_category_gid.',
      ['@tid' => $term->id(), '@gid' => $org_group_id]
    );
    return NULL;
  }

  return $org_group_id;
}

/**
 * Reads a numeric organisation group ID from field_category_gid.
 *
 * Newer sites store the field as an entity reference target_id. Older tenants
 * store the same mapping as a string value. This helper supports both shapes.
 */
function _markaspot_group_category_gid_value(TermInterface $term): ?int {
  if (!$term->hasField('field_category_gid') || $term->get('field_category_gid')->isEmpty()) {
    return NULL;
  }

  foreach ($term->get('field_category_gid')->getValue() as $item) {
    $raw_value = $item['target_id'] ?? $item['value'] ?? NULL;
    if ($raw_value === NULL) {
      continue;
    }

    $value = trim((string) $raw_value);
    if ($value === '' || strtolower($value) === 'n/a' || !ctype_digit($value)) {
      continue;
    }

    $group_id = (int) $value;
    if ($group_id > 0) {
      return $group_id;
    }
  }

  return NULL;
}

/**
 * Sends notification email when a service_request is added to an org group.
 *
 * This is the canonical delivery path for organisation assignment mail. It is
 * intentionally tied to the materialized relationship instead of one writer,
 * so dashboard edits, JSON:API writes, admin UI changes, Drush scripts and
 * legacy ECA paths behave the same way.
 *
 * @param \Drupal\group\Entity\GroupRelationshipInterface $relationship
 *   The inserted group relationship.
 * @param bool $trust_relationship_node
 *   TRUE when the relationship was created by the guarded field-to-relationship
 *   sync path and the in-memory node carries not-yet-persisted insert values.
 */
function _markaspot_group_notify_service_request_org_relationship(GroupRelationshipInterface $relationship, bool $trust_relationship_node = FALSE): void {
  if (!$trust_relationship_node) {
    $relationship = _markaspot_group_reload_persisted_relationship($relationship);
    if (!$relationship instanceof GroupRelationshipInterface) {
      return;
    }
  }

  if ($relationship->getPluginId() !== 'group_node:service_request') {
    return;
  }

  $group = $relationship->getGroup();
  if (!$group instanceof GroupInterface || $group->bundle() !== _markaspot_group_get_org_group_type()) {
    return;
  }

  if ($trust_relationship_node) {
    $node = $relationship->getEntity();
  }
  else {
    $entity_id = (int) $relationship->getEntityId();
    if ($entity_id <= 0) {
      return;
    }
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    $node_storage->resetCache([$entity_id]);
    $node = $node_storage->load($entity_id);
  }
  if (!$node instanceof NodeInterface || $node->bundle() !== 'service_request') {
    return;
  }

  if (!$node->hasField('field_organisation')
    || !in_array((int) $group->id(), _markaspot_group_field_target_ids($node, 'field_organisation'), TRUE)) {
    return;
  }

  if (_markaspot_group_has_active_org_notification_eca()) {
    return;
  }

  _markaspot_group_notify_organisation_group($node, $group);
}

/**
 * Reloads a relationship after sync to ensure it still exists.
 */
function _markaspot_group_reload_persisted_relationship(GroupRelationshipInterface $relationship): ?GroupRelationshipInterface {
  $relationship_id = $relationship->id();
  if ($relationship_id === NULL) {
    return NULL;
  }

  $relationship_storage = \Drupal::entityTypeManager()->getStorage('group_relationship');
  $relationship_storage->resetCache([$relationship_id]);
  $persisted_relationship = $relationship_storage->load($relationship_id);

  return $persisted_relationship instanceof GroupRelationshipInterface
    ? $persisted_relationship
    : NULL;
}

/**
 * Checks whether tenant ECA config still owns organisation notification mail.
 *
 * Some legacy tenants keep a custom ECA process with tenant-specific wording
 * and PII policy. The profile-level relationship fallback must not double-send
 * while such a process is active.
 */
function _markaspot_group_has_active_org_notification_eca(): bool {
  $config_factory = \Drupal::configFactory();
  foreach ($config_factory->listAll('eca.eca.') as $config_name) {
    $config = $config_factory->get($config_name);
    if (!$config->get('status')) {
      continue;
    }

    $actions = $config->get('actions');
    if (!is_array($actions)) {
      continue;
    }

    foreach ($actions as $action) {
      if (!is_array($action)) {
        continue;
      }
      $plugin = (string) ($action['plugin'] ?? '');
      $configuration = is_array($action['configuration'] ?? NULL) ? $action['configuration'] : [];
      if ($plugin === 'service_request_sync_organisations'
        && trim((string) ($configuration['subject'] ?? '')) !== ''
        && trim((string) ($configuration['message'] ?? '')) !== '') {
        return TRUE;
      }
      if ($config_name === 'eca.eca.process_apply_group'
        && $plugin === 'action_send_email_action'
        && trim((string) ($configuration['recipient'] ?? '')) !== ''
        && trim((string) ($configuration['subject'] ?? '')) !== ''
        && trim((string) ($configuration['message'] ?? '')) !== '') {
        return TRUE;
      }
    }
  }

  return FALSE;
}

/**
 * Sends notification email to all or selected assigned organisations.
 *
 * Replaces the email action from the ECA rule process_apply_group. New code
 * should prefer relationship-created notification to avoid writer-specific
 * behavior; this wrapper remains useful for explicit backfills.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node with field_organisation set.
 * @param int[]|null $organisation_ids
 *   Optional organisation group IDs to notify. When NULL, all referenced
 *   organisations are notified.
 */
function _markaspot_group_notify_organisation(NodeInterface $node, ?array $organisation_ids = NULL): void {
  if (!$node->hasField('field_organisation') || $node->get('field_organisation')->isEmpty()) {
    return;
  }

  $allowed_ids = NULL;
  if ($organisation_ids !== NULL) {
    $allowed_ids = array_values(array_unique(array_filter(array_map('intval', $organisation_ids))));
    if ($allowed_ids === []) {
      return;
    }
  }

  // Notify assigned organisations.
  foreach ($node->get('field_organisation')->referencedEntities() as $org_group) {
    if (!$org_group instanceof GroupInterface) {
      continue;
    }
    if ($allowed_ids !== NULL && !in_array((int) $org_group->id(), $allowed_ids, TRUE)) {
      continue;
    }

    _markaspot_group_notify_organisation_group($node, $org_group);
  }
}

/**
 * Sends the organisation assignment email to one organisation group.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The assigned service_request node.
 * @param \Drupal\group\Entity\GroupInterface $org_group
 *   The assigned organisation group.
 */
function _markaspot_group_notify_organisation_group(NodeInterface $node, GroupInterface $org_group): void {
  if ($org_group->bundle() !== _markaspot_group_get_org_group_type()) {
    return;
  }

  $node_jurisdiction_id = _markaspot_group_node_jurisdiction_id($node);
  if ($node_jurisdiction_id === NULL || !_markaspot_group_org_group_matches_jurisdiction($org_group, $node_jurisdiction_id)) {
    return;
  }

  $recipients = _markaspot_group_organisation_notification_recipients($org_group);
  if ($recipients === []) {
    \Drupal::logger('markaspot_group')->notice(
      'No organisation notification recipient found for org group @gid on node @nid.',
      [
        '@gid' => $org_group->id(),
        '@nid' => $node->id(),
      ]
    );
    return;
  }

  $langcode = _markaspot_group_organisation_notification_langcode($node);

  /** @var \Drupal\Core\Mail\MailManagerInterface $mail_manager */
  $mail_manager = \Drupal::service('plugin.manager.mail');
  $fallback_message = _markaspot_group_build_organisation_notification_fallback($node, $org_group);

  foreach ($recipients as $email) {
    $result = $mail_manager->mail('markaspot_group', 'org_notification', $email, $langcode, [
      'subject' => $fallback_message['subject'],
      'message' => $fallback_message['message'],
      'node' => $node,
      'organisation' => $org_group,
    ]);
    if (($result['result'] ?? FALSE) !== TRUE) {
      \Drupal::logger('markaspot_group')->error(
        'Failed to send organisation notification for org group @gid on node @nid.',
        [
          '@gid' => $org_group->id(),
          '@nid' => $node->id(),
        ]
      );
    }
  }
}

/**
 * Builds the plain fallback mail body for organisation notifications.
 *
 * markaspot_mail normally replaces this in hook_mail_alter() with branded,
 * localized HTML. Keep the original Drupal mail actionable so render failures
 * still notify the organisation with enough context to process the request.
 *
 * @return array{subject: string, message: string}
 *   Fallback mail subject and body.
 */
function _markaspot_group_build_organisation_notification_fallback(NodeInterface $node, GroupInterface $org_group): array {
  $request_id = _markaspot_group_sanitize_for_email(
    (string) ($node->hasField('request_id') && !$node->get('request_id')->isEmpty()
      ? $node->get('request_id')->getString()
      : $node->id())
  );
  $organisation = _markaspot_group_sanitize_for_email((string) $org_group->label());
  $category = '';
  if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $category_entity = $node->get('field_category')->entity ?? NULL;
    if (is_object($category_entity) && method_exists($category_entity, 'label')) {
      $category = _markaspot_group_sanitize_for_email((string) $category_entity->label());
    }
  }
  $address = _markaspot_group_sanitize_for_email(
    (string) ($node->hasField('field_address') && !$node->get('field_address')->isEmpty()
      ? $node->get('field_address')->getString()
      : '')
  );
  $description = _markaspot_group_sanitize_for_email(
    (string) ($node->hasField('body') && !$node->get('body')->isEmpty()
      ? $node->get('body')->getString()
      : '')
  );

  $edit_url = '';
  try {
    $edit_url = \Drupal\Core\Url::fromRoute('entity.node.edit_form', ['node' => $node->id()], ['absolute' => TRUE])->toString();
  }
  catch (\Throwable) {
    // Keep the fallback mail sendable even in CLI or partially bootstrapped
    // contexts where route generation is not available.
  }

  $lines = [
    'Hello,',
    '',
    'A citizen request has been assigned to your organisation.',
    '',
    'Request: #' . $request_id,
  ];
  if ($category !== '') {
    $lines[] = 'Category: ' . $category;
  }
  if ($address !== '') {
    $lines[] = 'Location: ' . $address;
  }
  if ($organisation !== '') {
    $lines[] = 'Organisation: ' . $organisation;
  }
  if ($description !== '') {
    $lines[] = 'Description: ' . $description;
  }
  if ($edit_url !== '') {
    $lines[] = '';
    $lines[] = 'Open request: ' . $edit_url;
  }
  $lines[] = '';
  $lines[] = 'This is an automatically generated email and cannot be replied to.';

  return [
    'subject' => 'Request #' . $request_id . ' assigned to ' . ($organisation !== '' ? $organisation : 'your organisation'),
    'message' => implode("\n", $lines),
  ];
}

/**
 * Resolves the language used for organisation assignment notification mail.
 *
 * The jurisdiction's Nuxt language setting is the same source the frontend
 * uses for dashboard locale selection. Falling back to Drupal's default
 * language keeps older single-tenant installs working when no jurisdiction
 * config exists yet.
 */
function _markaspot_group_organisation_notification_langcode(NodeInterface $node): string {
  $jurisdiction = _markaspot_group_node_jurisdiction_group($node);
  if ($jurisdiction instanceof GroupInterface) {
    $configured_langcode = _markaspot_group_jurisdiction_default_langcode($jurisdiction);
    if ($configured_langcode !== NULL) {
      return $configured_langcode;
    }
  }

  if (\Drupal::hasService('language_manager')) {
    return \Drupal::languageManager()->getDefaultLanguage()->getId();
  }

  return 'en';
}

/**
 * Resolves the jurisdiction group referenced by a service request node.
 */
function _markaspot_group_node_jurisdiction_group(NodeInterface $node): ?GroupInterface {
  if (!$node->hasField('field_jurisdiction') || $node->get('field_jurisdiction')->isEmpty()) {
    return NULL;
  }

  $field = $node->get('field_jurisdiction');
  $entity = $field->entity ?? NULL;
  if (_markaspot_group_is_jurisdiction_group($entity)) {
    return $entity;
  }

  $target_id = (int) ($field->target_id ?? 0);
  if ($target_id <= 0 || !\Drupal::hasService('entity_type.manager')) {
    return NULL;
  }

  $group = \Drupal::entityTypeManager()
    ->getStorage('group')
    ->load($target_id);

  return _markaspot_group_is_jurisdiction_group($group) ? $group : NULL;
}

/**
 * Extracts the jurisdiction's default frontend language from field_nuxt_config.
 */
function _markaspot_group_jurisdiction_default_langcode(GroupInterface $jurisdiction): ?string {
  if (!$jurisdiction->hasField('field_nuxt_config') || $jurisdiction->get('field_nuxt_config')->isEmpty()) {
    return NULL;
  }

  $decoded = json_decode((string) $jurisdiction->get('field_nuxt_config')->value, TRUE);
  if (!is_array($decoded)) {
    return NULL;
  }

  $langcode = $decoded['languages']['default'] ?? NULL;
  if (!is_string($langcode)) {
    return NULL;
  }

  return _markaspot_group_normalize_notification_langcode($langcode);
}

/**
 * Normalizes a configured frontend language to an installed Drupal langcode.
 */
function _markaspot_group_normalize_notification_langcode(string $langcode): ?string {
  $langcode = strtolower(trim($langcode));
  if (!preg_match('/^[a-z]{2,3}(?:-[a-z0-9]{2,8})?$/', $langcode)) {
    return NULL;
  }

  if (!\Drupal::hasService('language_manager')) {
    return $langcode;
  }

  $languages = \Drupal::languageManager()->getLanguages();
  if (isset($languages[$langcode])) {
    return $langcode;
  }

  $base_langcode = strtok($langcode, '-');
  return is_string($base_langcode) && isset($languages[$base_langcode])
    ? $base_langcode
    : NULL;
}

/**
 * Gets notification recipients for an organisation group.
 *
 * Uses the explicit organisation mailbox when configured. If the group has no
 * mailbox, falls back to active group members so assignment notifications do
 * not silently disappear on membership-driven tenants.
 *
 * @return string[]
 *   Valid recipient addresses.
 */
function _markaspot_group_organisation_notification_recipients(GroupInterface $org_group): array {
  $field_recipients = _markaspot_group_email_field_values($org_group, 'field_head_organisation_e_mail');
  if ($field_recipients !== []) {
    return $field_recipients;
  }

  $member_recipients = [];
  $membership_relationships = \Drupal::entityTypeManager()
    ->getStorage('group_relationship')
    ->loadByProperties([
      'gid' => $org_group->id(),
      'plugin_id' => 'group_membership',
    ]);

  foreach ($membership_relationships as $membership_relationship) {
    if (!$membership_relationship instanceof GroupRelationshipInterface) {
      continue;
    }
    $user = $membership_relationship->getEntity();
    if (!$user instanceof UserInterface || !$user->isActive()) {
      continue;
    }
    $email = _markaspot_group_normalize_notification_email((string) $user->getEmail());
    if ($email !== NULL) {
      $member_recipients[$email] = $email;
    }
  }

  return array_values($member_recipients);
}

/**
 * Gets valid e-mail values from a field.
 *
 * @return string[]
 *   Valid recipient addresses.
 */
function _markaspot_group_email_field_values(GroupInterface $group, string $field_name): array {
  if (!$group->hasField($field_name) || $group->get($field_name)->isEmpty()) {
    return [];
  }

  $recipients = [];
  foreach ($group->get($field_name)->getValue() as $item) {
    $email = _markaspot_group_normalize_notification_email((string) ($item['value'] ?? $item['email'] ?? ''));
    if ($email !== NULL) {
      $recipients[$email] = $email;
    }
  }

  return array_values($recipients);
}

/**
 * Normalizes and validates an organisation notification address.
 */
function _markaspot_group_normalize_notification_email(string $email): ?string {
  $email = trim($email);
  if ($email === '') {
    return NULL;
  }
  if (!\Drupal::service('email.validator')->isValid($email)) {
    return NULL;
  }

  return strtolower($email);
}

/**
 * Strips HTML tags and CRLF sequences from text for safe email embedding.
 *
 * Prevents header injection and XSS in email bodies.
 */
function _markaspot_group_sanitize_for_email(string $text): string {
  return str_replace(["\r\n", "\r", "\n"], ' ', strip_tags($text));
}

/**
 * Assigns a service request to its root jurisdiction group.
 *
 * Determines the root jurisdiction via three strategies:
 * 1. From the node's field_organisation: if the org group has a
 *    field_jurisdiction reference, resolve upward to the root jur.
 * 2. From the node's field_category: if the category term has a
 *    field_jurisdiction reference, resolve upward to the root jur.
 * 3. Fallback: find the single root jur group (no field_parent_jurisdiction).
 *
 * Replaces the former ECA rule process_apply_jurisdiction which hardcoded
 * group_id 1 for all service requests.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node.
 */
function _markaspot_group_assign_root_jurisdiction(NodeInterface $node): void {
  $plugin_id = 'group_node:service_request';
  $etm = \Drupal::entityTypeManager();
  $group_storage = $etm->getStorage('group');
  $relationship_storage = $etm->getStorage('group_relationship');

  $root_jur = NULL;

  // Strategy 1: Trust the already resolved request jurisdiction.
  if ($node->hasField('field_jurisdiction') && !$node->get('field_jurisdiction')->isEmpty()) {
    $root_id = \Drupal::service('markaspot_group.hierarchy_resolver')
      ->getRootJurisdictionId((int) $node->get('field_jurisdiction')->target_id);
    if ($root_id === NULL) {
      return;
    }
    $root_jur = $group_storage->load($root_id);
  }

  // Strategy 2: Derive from field_organisation -> org group -> field_jurisdiction.
  if (!$root_jur && $node->hasField('field_organisation') && !$node->get('field_organisation')->isEmpty()) {
    $org_id = (int) $node->get('field_organisation')->target_id;
    $org_group = $group_storage->load($org_id);
    if ($org_group && $org_group->hasField('field_jurisdiction') && !$org_group->get('field_jurisdiction')->isEmpty()) {
      $jur_id = (int) $org_group->get('field_jurisdiction')->target_id;
      // Resolve upward to root using the hierarchy resolver service.
      $root_id = \Drupal::service('markaspot_group.hierarchy_resolver')
        ->getRootJurisdictionId($jur_id);
      if ($root_id === NULL) {
        return;
      }
      $root_jur = $group_storage->load($root_id);
    }
  }

  // Strategy 3: Derive from category term's field_jurisdiction.
  // Category terms reference their root jurisdiction, so this resolves
  // correctly even when field_organisation is not yet set.
  if (!$root_jur && $node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $term = $node->get('field_category')->entity;
    if ($term && $term->hasField('field_jurisdiction') && !$term->get('field_jurisdiction')->isEmpty()) {
      $root_id = \Drupal::service('markaspot_group.hierarchy_resolver')
        ->getRootJurisdictionId((int) $term->get('field_jurisdiction')->target_id);
      if ($root_id === NULL) {
        return;
      }
      $root_jur = $group_storage->load($root_id);
    }
  }

  // Strategy 4: Fallback to the single root jur (no parent jurisdiction).
  if (!$root_jur) {
    $root_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', _markaspot_group_jurisdiction_group_type())
      ->notExists('field_parent_jurisdiction')
      ->execute();

    if (count($root_ids) === 1) {
      $root_jur = $group_storage->load(reset($root_ids));
    }
    elseif (count($root_ids) > 1) {
      // Multiple root jurisdictions without org context. Try the configured
      // default jurisdiction before giving up.
      $default_jur_id = (int) \Drupal::config('markaspot_group.settings')
        ->get('default_jurisdiction_id');

      if ($default_jur_id > 0) {
        $default_jur = $group_storage->load($default_jur_id);
        if (_markaspot_group_is_jurisdiction_group($default_jur) && $default_jur->get('field_parent_jurisdiction')->isEmpty()) {
          $root_jur = $default_jur;
          \Drupal::logger('markaspot_group')->notice(
            'Using default jurisdiction "@group" (id=@gid) for node @nid (multiple roots, no org context).',
            [
              '@group' => $root_jur->label(),
              '@gid' => $root_jur->id(),
              '@nid' => $node->id(),
            ]
          );
        }
        else {
          \Drupal::logger('markaspot_group')->warning(
            'Configured default_jurisdiction_id @id is invalid, not a jur group, or not a root jurisdiction. Skipping assignment for node @nid.',
            ['@id' => $default_jur_id, '@nid' => $node->id()]
          );
          return;
        }
      }
      else {
        // No default configured. Log warning and skip assignment.
        \Drupal::logger('markaspot_group')->warning(
          'Cannot auto-assign root jurisdiction for node @nid: @count root jurisdictions exist but node has no organisation set. Configure default_jurisdiction_id in markaspot_group.settings to set a fallback.',
          ['@nid' => $node->id(), '@count' => count($root_ids)]
        );
        return;
      }
    }
    else {
      return;
    }
  }

  if (!$root_jur) {
    return;
  }

  // Check if relationship already exists.
  $existing = $relationship_storage->loadByProperties([
    'entity_id' => $node->id(),
    'gid' => $root_jur->id(),
    'plugin_id' => $plugin_id,
  ]);

  if (!empty($existing)) {
    return;
  }

  try {
    $root_jur->addRelationship($node, $plugin_id);
    \Drupal::logger('markaspot_group')->notice(
      'Auto-assigned node @nid to root jurisdiction "@group" (id=@gid).',
      [
        '@nid' => $node->id(),
        '@group' => $root_jur->label(),
        '@gid' => $root_jur->id(),
      ]
    );
  }
  catch (\Exception $e) {
    \Drupal::logger('markaspot_group')->error(
      'Failed to assign node @nid to root jurisdiction "@group": @error',
      [
        '@nid' => $node->id(),
        '@group' => $root_jur->label(),
        '@error' => $e->getMessage(),
      ]
    );
  }
}

/**
 * Assigns a service request to sub-jurisdictions based on boundaries.
 *
 * Loads all jurisdiction groups with a field_boundary, checks if the node's
 * coordinates fall within each boundary polygon, and creates group
 * relationships for matches. Skips top-level jurisdictions (assigned by
 * _markaspot_group_assign_root_jurisdiction).
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node.
 *
 * @return int|false
 *   The child jurisdiction group ID if one was assigned, FALSE otherwise.
 *   When multiple sub-jurisdictions match (nested boundaries), the deepest
 *   (most specific) child in the hierarchy is returned.
 */
function _markaspot_group_assign_sub_jurisdictions(NodeInterface $node): int|false {
  // Get coordinates from the node.
  if (!$node->hasField('field_geolocation') || $node->get('field_geolocation')->isEmpty()) {
    return FALSE;
  }

  $geolocation = $node->get('field_geolocation')->first();
  $lat = (float) $geolocation->get('lat')->getValue();
  $lng = (float) $geolocation->get('lng')->getValue();

  if ($lat === 0.0 && $lng === 0.0) {
    return FALSE;
  }

  // Load all jurisdiction groups with boundaries.
  $group_storage = \Drupal::entityTypeManager()->getStorage('group');
  $group_ids = $group_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', _markaspot_group_jurisdiction_group_type())
    ->exists('field_boundary')
    ->execute();

  if (empty($group_ids)) {
    return FALSE;
  }

  $groups = $group_storage->loadMultiple($group_ids);
  $plugin_id = 'group_node:service_request';
  $relationship_storage = \Drupal::entityTypeManager()->getStorage('group_relationship');
  // Collect all matched child jurisdiction IDs (nested boundaries can match
  // multiple levels, e.g. both "Bournemouth Town Council" and "Queens Park
  // Ward" when the point lies inside the ward polygon).
  $matched_child_jur_ids = [];

  foreach ($groups as $group) {
    if ($group->get('field_boundary')->isEmpty()) {
      continue;
    }

    // Skip top-level jurisdictions (no parent). These are tenants or root
    // cities, assigned by _markaspot_group_assign_root_jurisdiction(). Only
    // districts/subdivisions (with a parent) get auto-assigned by boundary.
    if (!$group->hasField('field_parent_jurisdiction')
        || $group->get('field_parent_jurisdiction')->isEmpty()) {
      continue;
    }

    $boundary_json = $group->get('field_boundary')->value;
    $boundary = GeoJsonBoundary::fromJson($boundary_json);
    if (!$boundary) {
      \Drupal::logger('markaspot_group')->warning(
        'Invalid boundary GeoJSON on jurisdiction group @gid.',
        ['@gid' => $group->id()]
      );
      continue;
    }

    if (!$boundary->contains($lng, $lat)) {
      continue;
    }

    $matched_child_jur_ids[] = (int) $group->id();

    // Check if relationship already exists.
    $existing = $relationship_storage->loadByProperties([
      'entity_id' => $node->id(),
      'gid' => $group->id(),
      'plugin_id' => $plugin_id,
    ]);

    if (!empty($existing)) {
      continue;
    }

    // Add node to this jurisdiction.
    try {
      $group->addRelationship($node, $plugin_id);
      \Drupal::logger('markaspot_group')->notice(
        'Auto-assigned node @nid to sub-jurisdiction "@group" (point in boundary).',
        [
          '@nid' => $node->id(),
          '@group' => $group->label(),
        ]
      );
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot_group')->error(
        'Failed to assign node @nid to sub-jurisdiction "@group": @error',
        [
          '@nid' => $node->id(),
          '@group' => $group->label(),
          '@error' => $e->getMessage(),
        ]
      );
    }
  }

  if (empty($matched_child_jur_ids)) {
    return FALSE;
  }

  // When multiple child jurisdictions match (nested boundaries), find the
  // most specific one: the deepest in the hierarchy. A child whose ID is
  // referenced as parent by another match is NOT the deepest.
  if (count($matched_child_jur_ids) === 1) {
    return $matched_child_jur_ids[0];
  }

  $matched_groups = $group_storage->loadMultiple($matched_child_jur_ids);
  $parent_ids_in_set = [];
  foreach ($matched_groups as $g) {
    if ($g->hasField('field_parent_jurisdiction') && !$g->get('field_parent_jurisdiction')->isEmpty()) {
      $parent_ids_in_set[(int) $g->get('field_parent_jurisdiction')->target_id] = TRUE;
    }
  }
  // The deepest is the one that is NOT a parent of any other match.
  foreach ($matched_child_jur_ids as $id) {
    if (!isset($parent_ids_in_set[$id])) {
      return $id;
    }
  }

  // Fallback: return first match if all are parents (shouldn't happen).
  return $matched_child_jur_ids[0];
}

/**
 * Sets field_jurisdiction on a service_request based on configured strategy.
 *
 * Strategy is read from markaspot_group.settings.jurisdiction_field_strategy:
 * - 'most_specific' (default): Uses child jur if assigned, else root.
 * - 'root': Always resolves to root jurisdiction.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node.
 * @param int|false $child_jur_id
 *   Child jurisdiction ID from sub-jur assignment, or FALSE.
 *
 * @return bool
 *   TRUE if field_jurisdiction was set, FALSE otherwise.
 */
function _markaspot_group_set_jurisdiction_field(NodeInterface $node, int|false $child_jur_id): bool {
  $strategy = \Drupal::config('markaspot_group.settings')
    ->get('jurisdiction_field_strategy') ?? 'most_specific';

  $jur_type = \Drupal::config('markaspot_open311.settings')
    ->get('jurisdiction_group_type') ?? 'jur';

  $jur_id = NULL;

  if ($strategy === 'most_specific' && $child_jur_id) {
    // Child jur is the most specific. Use it directly.
    $jur_id = $child_jur_id;
  }
  elseif ($strategy === 'root' && $child_jur_id) {
    // Resolve child to root jurisdiction.
    /** @var \Drupal\markaspot_group\Service\JurisdictionHierarchyResolverInterface $resolver */
    $resolver = \Drupal::service('markaspot_group.hierarchy_resolver');
    $jur_id = $resolver->getRootJurisdictionId($child_jur_id);
    if ($jur_id === NULL) {
      return FALSE;
    }
  }

  // No child jur (or strategy is 'root' without child): find root via lookup.
  if (!$jur_id) {
    $etm = \Drupal::entityTypeManager();
    $group_storage = $etm->getStorage('group');

    // Guard: only use notExists() if the field storage actually exists.
    // Without this, single-tenant sites without field_parent_jurisdiction
    // would get a database exception.
    $has_parent_field = $etm->getStorage('field_storage_config')
      ->load('group.field_parent_jurisdiction') !== NULL;

    $query = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', $jur_type);

    if ($has_parent_field) {
      $query->notExists('field_parent_jurisdiction');
    }

    $root_ids = $query->execute();

    if (count($root_ids) === 1) {
      $jur_id = (int) reset($root_ids);
    }
    elseif (count($root_ids) > 1) {
      // Multiple roots without child context. Try deriving from category.
      if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
        $term = $node->get('field_category')->entity;
        if ($term && $term->hasField('field_jurisdiction') && !$term->get('field_jurisdiction')->isEmpty()) {
          /** @var \Drupal\markaspot_group\Service\JurisdictionHierarchyResolverInterface $resolver */
          $resolver = \Drupal::service('markaspot_group.hierarchy_resolver');
          $jur_id = $resolver->getRootJurisdictionId((int) $term->get('field_jurisdiction')->target_id);
          if ($jur_id === NULL) {
            return FALSE;
          }
        }
      }
    }
  }

  if (!$jur_id) {
    return FALSE;
  }

  $node->set('field_jurisdiction', ['target_id' => $jur_id]);

  \Drupal::logger('markaspot_group')->notice(
    'Set field_jurisdiction on node @nid to jurisdiction @jur_id (strategy: @strategy).',
    [
      '@nid' => $node->id() ?? '(new)',
      '@jur_id' => $jur_id,
      '@strategy' => $strategy,
    ]
  );

  return TRUE;
}

/**
 * Syncs the jurisdiction tenant-admin group role to the Drupal role.
 *
 * @param \Drupal\group\Entity\GroupRelationshipInterface $relationship
 *   The group relationship entity.
 * @param string $operation
 *   One of 'insert', 'update', or 'delete'.
 */
function _markaspot_group_tenant_admin_sync_role(GroupRelationshipInterface $relationship, string $operation): void {
  // Only process membership relationships in jurisdiction groups.
  if ($relationship->getPluginId() !== 'group_membership') {
    return;
  }
  $group = $relationship->getGroup();
  $jur_type = \Drupal::config('markaspot_open311.settings')
    ->get('jurisdiction_group_type') ?? 'jur';
  if (!$group || $group->bundle() !== $jur_type) {
    return;
  }

  $user_entity = $relationship->getEntity();
  if (!$user_entity instanceof UserInterface) {
    return;
  }

  // Reload the user to ensure fresh role state.
  $user = User::load($user_entity->id());
  if (!$user) {
    return;
  }

  // Check if this membership has the configured tenant-admin role.
  $group_roles = array_column(
    $relationship->get('group_roles')->getValue(),
    'target_id'
  );
  $has_jur_admin = (bool) array_intersect(
    TenantAdminHelper::getTenantAdminRoleIds(),
    $group_roles
  );

  if ($operation === 'delete' || ($operation === 'update' && !$has_jur_admin)) {
    // Membership removed or tenant-admin role removed from membership.
    // Check if user still has tenant-admin in any other jurisdiction group.
    $exclude_id = ($operation === 'delete') ? (int) $relationship->id() : NULL;
    $still_has_admin = TenantAdminHelper::userHasJurAdminInAnyGroup($user, $exclude_id);

    if (!$still_has_admin && $user->hasRole('tenant_admin')) {
      $user->removeRole('tenant_admin');
      $user->save();
      \Drupal::logger('markaspot_group')->notice(
        'Removed tenant_admin role from user @name (no remaining jurisdiction tenant-admin memberships).',
        ['@name' => $user->getAccountName()]
      );
    }
  }
  elseif ($has_jur_admin && !$user->hasRole('tenant_admin')) {
    $user->addRole('tenant_admin');
    $user->save();
    \Drupal::logger('markaspot_group')->notice(
      'Granted tenant_admin role to user @name (jurisdiction tenant-admin in @group).',
      [
        '@name' => $user->getAccountName(),
        '@group' => $group->label(),
      ]
    );
  }
}

/**
 * Implements hook_query_TAG_alter() for taxonomy_term_access.
 *
 * Filters taxonomy term queries to show only terms belonging to the current
 * user's jurisdictions. Full Drupal admins are unaffected.
 *
 * Child jurisdictions inherit taxonomy terms from their root parent, so the
 * filter resolves each direct jurisdiction to its full ancestor tree via
 * JurisdictionHierarchyResolver::getTermJurisdictionIds().
 */
function markaspot_group_query_taxonomy_term_access_alter(AlterableInterface $query): void {
  // Avoid double-altering during migration when the old module is still active.
  if (\Drupal::moduleHandler()->moduleExists('markaspot_tenant_admin')) {
    return;
  }

  $current_user = \Drupal::currentUser();

  // Full admins see everything.
  if ($current_user->hasPermission('administer taxonomy')) {
    return;
  }

  // Only filter for tenant_admin users.
  if (!in_array('tenant_admin', $current_user->getRoles(), TRUE)) {
    return;
  }

  $jur_ids = TenantAdminHelper::getUserJurisdictionIds($current_user);
  if (empty($jur_ids)) {
    // Fallback for tenant_admin users whose Drupal role was assigned outside
    // the jur-tenant_admin group role sync (e.g., manually or pre-2.x).
    // In that case, show terms for any jur group they are a member of.
    $user = User::load($current_user->id());
    if ($user) {
      foreach (\Drupal\group\Entity\GroupMembership::loadByUser($user) as $membership) {
        if (_markaspot_group_is_jurisdiction_group($membership->getGroup())) {
          $jur_ids[] = (int) $membership->getGroupId();
        }
      }
    }
  }
  if (empty($jur_ids)) {
    // No jurisdictions at all: add an impossible condition to show nothing.
    $query->where('1 = 0');
    return;
  }

  // Resolve each direct jurisdiction to include the full tree (root + all
  // descendants). Child jurisdictions inherit their root parent's taxonomy
  // terms, so a Queens Park Ward admin (id=10) also needs to see BCP
  // Council's terms (id=8).
  $resolver = \Drupal::service('markaspot_group.hierarchy_resolver');
  $all_jur_ids = [];
  foreach ($jur_ids as $jur_id) {
    $all_jur_ids = array_merge($all_jur_ids, $resolver->getTermJurisdictionIds($jur_id));
  }
  $jur_ids = array_unique($all_jur_ids);

  // Find the base table alias dynamically. TermStorage::loadTree() uses 't',
  // but getNodeTerms() uses 'td' and Views may use other aliases.
  $tables = $query->getTables();
  $base_alias = NULL;
  foreach ($tables as $alias => $info) {
    if ($info['table'] === 'taxonomy_term_field_data') {
      $base_alias = $alias;
      break;
    }
  }
  if (!$base_alias) {
    // Cannot safely alter this query (e.g., no taxonomy_term_field_data table).
    return;
  }

  // Join field_jurisdiction and filter to user's jurisdictions.
  $query->leftJoin(
    'taxonomy_term__field_jurisdiction',
    'fj',
    "[$base_alias].[tid] = [fj].[entity_id]"
  );

  // Show terms belonging to user's jurisdictions OR unassigned terms.
  $or = $query->orConditionGroup()
    ->condition('fj.field_jurisdiction_target_id', $jur_ids, 'IN')
    ->isNull('fj.field_jurisdiction_target_id');
  $query->condition($or);
}

/**
 * Implements hook_taxonomy_term_access().
 *
 * Grants tenant admins view access to unpublished terms in managed
 * vocabularies (service_category, service_status). Without this, Drupal's
 * TermAccessControlHandler denies view access to unpublished terms for
 * non-admins, which blocks the content_translation "Translate" operation
 * link from appearing.
 */
function markaspot_group_taxonomy_term_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResult {
  // Only handle the 'view' operation for managed vocabularies.
  if ($operation !== 'view') {
    return AccessResult::neutral();
  }

  $managed_vocabs = ['service_category', 'service_status'];
  if (!in_array($entity->bundle(), $managed_vocabs, TRUE)) {
    return AccessResult::neutral();
  }

  // Only apply to tenant_admin users.
  if (!in_array('tenant_admin', $account->getRoles(), TRUE)) {
    return AccessResult::neutral();
  }

  // Grant view access to unpublished terms so the taxonomy overview and
  // translation operations work correctly. Only grant access if the term
  // belongs to the user's jurisdiction or is unassigned (shared).
  if (!$entity->isPublished()) {
    $jur_ids = TenantAdminHelper::getUserJurisdictionIds($account);
    $term_jur = $entity->hasField('field_jurisdiction') && !$entity->get('field_jurisdiction')->isEmpty()
      ? (int) $entity->get('field_jurisdiction')->target_id
      : NULL;

    // Allow if term is unassigned (shared across jurisdictions) or belongs
    // to one of the user's jurisdictions.
    if ($term_jur === NULL || in_array($term_jur, $jur_ids, TRUE)) {
      return AccessResult::allowed()
        ->addCacheableDependency($entity)
        ->cachePerPermissions()
        ->addCacheContexts(['user.roles']);
    }
  }

  return AccessResult::neutral();
}
