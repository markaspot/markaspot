<?php

/**
 * @file
 * Mark-a-Spot Group module.
 *
 * Provides group-based access control for service requests using the Group
 * module. Includes auto-membership functionality for users with the
 * "All Groups Member" field enabled.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\markaspot_validation\Plugin\Validation\Geo\GeoJsonBoundary;
use Drupal\group\Entity\Group;
use Drupal\group\Entity\GroupInterface;
use Drupal\group\Entity\GroupRelationshipInterface;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_mail().
 */
function markaspot_group_mail(string $key, array &$message, array $params): void {
  if ($key === 'org_notification') {
    $message['subject'] = $params['subject'];
    $message['body'][] = $params['message'];
  }
}

/**
 * Implements hook_entity_presave().
 *
 * Handles presave logic for:
 * - taxonomy_term: Redirects child jurisdiction references to root parent.
 * - group (jur bundle): Validates field_service_categories belong to the
 *   correct root jurisdiction.
 */
function markaspot_group_entity_presave(EntityInterface $entity): void {
  if ($entity instanceof TermInterface) {
    _markaspot_group_presave_taxonomy_term($entity);
  }
  if ($entity instanceof GroupInterface && $entity->bundle() === 'jur') {
    _markaspot_group_presave_jur_service_categories($entity);
  }
}

/**
 * Presave handler for taxonomy terms: jurisdiction inheritance enforcement.
 *
 * Enforces taxonomy inheritance rule: child jurisdictions (those with
 * field_parent_jurisdiction set) must not have their own taxonomy terms.
 * If a term's field_jurisdiction points to a child jurisdiction, the reference
 * is automatically redirected to the root parent jurisdiction.
 *
 * This prevents mixed taxonomy catalogs in hierarchical deployments
 * (Landkreis model) where all subdivisions share the parent's service catalog.
 *
 * @param \Drupal\taxonomy\TermInterface $entity
 *   The taxonomy term being saved.
 *
 * @see https://markaspot-docs/architecture/multi-jurisdiction.md
 */
function _markaspot_group_presave_taxonomy_term(TermInterface $entity): void {
  // Only process terms with a field_jurisdiction reference.
  if (!$entity->hasField('field_jurisdiction') || $entity->get('field_jurisdiction')->isEmpty()) {
    return;
  }

  $jurisdiction_id = (int) $entity->get('field_jurisdiction')->target_id;
  if ($jurisdiction_id <= 0) {
    return;
  }

  // Load the referenced jurisdiction group.
  $group = \Drupal::entityTypeManager()->getStorage('group')->load($jurisdiction_id);
  if (!$group || $group->bundle() !== 'jur') {
    return;
  }

  // Check if this jurisdiction has a parent (is a child/subdivision).
  if (!$group->hasField('field_parent_jurisdiction') || $group->get('field_parent_jurisdiction')->isEmpty()) {
    // Root jurisdiction, no redirect needed.
    return;
  }

  // Traverse up to the root jurisdiction.
  /** @var \Drupal\markaspot_group\Service\JurisdictionHierarchyResolverInterface $resolver */
  $resolver = \Drupal::service('markaspot_group.hierarchy_resolver');
  $root_id = $resolver->getRootJurisdictionId($jurisdiction_id);

  // Redirect field_jurisdiction to the root parent.
  $entity->set('field_jurisdiction', $root_id);

  \Drupal::logger('markaspot_group')->notice(
    'Taxonomy term "@term" (vid: @vid): redirected field_jurisdiction from child @child to root @root.',
    [
      '@term' => $entity->label() ?? '(new)',
      '@vid' => $entity->bundle(),
      '@child' => $jurisdiction_id,
      '@root' => $root_id,
    ]
  );
}

/**
 * Presave handler for jur groups: validates field_service_categories.
 *
 * Ensures that selected service categories belong to the correct root
 * jurisdiction. Invalid categories (those with field_jurisdiction pointing
 * to a different root) are silently removed and a warning is logged.
 *
 * This prevents data inconsistency where a child jurisdiction references
 * categories from an unrelated jurisdiction tree.
 *
 * @param \Drupal\group\Entity\GroupInterface $group
 *   The jurisdiction group being saved.
 */
function _markaspot_group_presave_jur_service_categories(GroupInterface $group): void {
  // Only validate if service categories are set.
  if (!$group->hasField('field_service_categories') || $group->get('field_service_categories')->isEmpty()) {
    return;
  }

  // Determine the root jurisdiction ID.
  $group_id = $group->isNew() ? NULL : (int) $group->id();
  $root_jurisdiction_id = NULL;

  /** @var \Drupal\markaspot_group\Service\JurisdictionHierarchyResolverInterface $resolver */
  $resolver = \Drupal::service('markaspot_group.hierarchy_resolver');

  if ($group_id !== NULL) {
    $root_jurisdiction_id = $resolver->getRootJurisdictionId($group_id);
  }
  elseif ($group->hasField('field_parent_jurisdiction') && !$group->get('field_parent_jurisdiction')->isEmpty()) {
    // New group with a parent: resolve from the parent.
    $parent_id = (int) $group->get('field_parent_jurisdiction')->target_id;
    $root_jurisdiction_id = $resolver->getRootJurisdictionId($parent_id);
  }

  if ($root_jurisdiction_id === NULL) {
    return;
  }

  // Validate each referenced category term.
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $valid_items = [];
  $removed_tids = [];

  foreach ($group->get('field_service_categories') as $item) {
    $tid = (int) $item->target_id;
    $term = $term_storage->load($tid);

    if (!$term) {
      $removed_tids[] = $tid;
      continue;
    }

    // Check that the term belongs to the correct root jurisdiction.
    if (!$term->hasField('field_jurisdiction') || $term->get('field_jurisdiction')->isEmpty()) {
      $removed_tids[] = $tid;
      continue;
    }

    $term_jurisdiction_id = (int) $term->get('field_jurisdiction')->target_id;

    // The term's jurisdiction should match the root. Use the resolver in case
    // the term itself points to a child (which would be unusual but possible).
    $term_root_id = $resolver->getRootJurisdictionId($term_jurisdiction_id);

    if ($term_root_id === $root_jurisdiction_id) {
      $valid_items[] = ['target_id' => $tid];
    }
    else {
      $removed_tids[] = $tid;
    }
  }

  // If invalid categories were found, clean them out and log a warning.
  if (!empty($removed_tids)) {
    $group->set('field_service_categories', $valid_items);

    $message = t('Removed @count invalid service categories (not in root jurisdiction @root): @tids.', [
      '@count' => count($removed_tids),
      '@root' => $root_jurisdiction_id,
      '@tids' => implode(', ', $removed_tids),
    ]);

    \Drupal::logger('markaspot_group')->warning(
      'Jurisdiction "@group" (id=@gid): @message',
      [
        '@group' => $group->label() ?? '(new)',
        '@gid' => $group_id ?? 'new',
        '@message' => $message,
      ]
    );
    \Drupal::messenger()->addWarning($message);
  }
}

/**
 * Presave handler for service requests: jurisdiction-aware initial status.
 *
 * When a new service request is created via JSON:API, the field_status default
 * comes from field configuration (a single global TID). In multi-tenant setups
 * each jurisdiction has its own "initial" status term. This handler detects
 * when a new node has the wrong initial status and corrects it based on the
 * node's category jurisdiction.
 *
 * Only fires for NEW nodes. Existing nodes keep their current status.
 *
 * Resolution path:
 *   node -> field_category -> term -> field_jurisdiction -> root jur ID
 *   -> getInitialStatusTid(root_jur_id) -> correct status TID
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node being saved.
 */
function _markaspot_group_presave_service_request_status(NodeInterface $node): void {
  // Only correct status on new nodes. Existing nodes keep their status.
  if (!$node->isNew()) {
    return;
  }

  // Need a category to determine jurisdiction.
  if (!$node->hasField('field_category') || $node->get('field_category')->isEmpty()) {
    return;
  }

  // Need a status field to correct.
  if (!$node->hasField('field_status')) {
    return;
  }

  // Load the category term to find its jurisdiction.
  $category_term = $node->get('field_category')->entity;
  if (!$category_term || !$category_term->hasField('field_jurisdiction') || $category_term->get('field_jurisdiction')->isEmpty()) {
    return;
  }

  $category_jur_id = (int) $category_term->get('field_jurisdiction')->target_id;
  if ($category_jur_id <= 0) {
    return;
  }

  // Get the jurisdiction-correct initial status.
  /** @var \Drupal\markaspot_open311\Service\GeoreportProcessorServiceInterface $processor */
  $processor = \Drupal::service('markaspot_open311.processor');
  $correct_status_tid = $processor->getInitialStatusTid($category_jur_id);

  if (!$correct_status_tid) {
    return;
  }

  // Get the current status TID (may be empty, or the global default).
  $current_status_tid = $node->get('field_status')->isEmpty()
    ? NULL
    : (int) $node->get('field_status')->target_id;

  // If the correct status is already set, nothing to do.
  if ($current_status_tid === $correct_status_tid) {
    return;
  }

  // Set the jurisdiction-correct initial status.
  $node->set('field_status', ['target_id' => $correct_status_tid]);

  \Drupal::logger('markaspot_group')->notice(
    'Service request "@title": redirected field_status from TID=@old to TID=@new (jurisdiction @jur).',
    [
      '@title' => $node->label() ?? '(new)',
      '@old' => $current_status_tid ?? 'empty',
      '@new' => $correct_status_tid,
      '@jur' => $category_jur_id,
    ]
  );
}

/**
 * Implements hook_form_FORM_ID_alter() for user_form.
 *
 * Hides field_all_groups_member on the user edit form unless the edited
 * user is uid=1 or has the 'administrator' role. The field should only
 * be visible (and editable) for those accounts.
 */
function markaspot_group_form_user_form_alter(array &$form, FormStateInterface $form_state): void {
  if (!isset($form['field_all_groups_member'])) {
    return;
  }

  $user = $form_state->getFormObject()->getEntity();
  $uid = (int) $user->id();

  // Only show for uid=1 or administrators.
  if ($uid === 1 || $user->hasRole('administrator')) {
    return;
  }

  $form['field_all_groups_member']['#access'] = FALSE;
}

/**
 * Implements hook_user_insert().
 *
 * When a new user is created with the "All Groups Member" field enabled,
 * automatically add them to all existing groups with the admin role.
 */
function markaspot_group_user_insert(UserInterface $account): void {
  _markaspot_group_handle_user_membership($account);
}

/**
 * Implements hook_user_update().
 *
 * When an existing user is updated with the "All Groups Member" field enabled,
 * automatically add them to all groups they are not yet a member of.
 */
function markaspot_group_user_update(UserInterface $account): void {
  // Check if the field exists before accessing it.
  if (!$account->hasField('field_all_groups_member')) {
    return;
  }

  // Check if the field value changed from FALSE to TRUE.
  $original = $account->original ?? NULL;
  $original_value = $original?->hasField('field_all_groups_member')
    ? (bool) $original->get('field_all_groups_member')->value
    : FALSE;
  $new_value = (bool) $account->get('field_all_groups_member')->value;

  // Only process if the field was just enabled.
  if ($new_value && !$original_value) {
    _markaspot_group_handle_user_membership($account);
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for group entities.
 *
 * When a new group is created, automatically add all users with
 * the "All Groups Member" field enabled as members with the admin role.
 */
function markaspot_group_group_insert(GroupInterface $group): void {
  _markaspot_group_add_all_groups_members_to_group($group);
}

/**
 * Helper function to add a user to all groups if they have the field enabled.
 *
 * Applies different rules based on group type:
 * - JUR (Jurisdiction): Only user 1 (uid=1) is automatically added.
 * - ORG (Organisation): All users with field_all_groups_member are added.
 *
 * @param \Drupal\user\UserInterface $account
 *   The user account to process.
 */
function _markaspot_group_handle_user_membership(UserInterface $account): void {
  // Check if user has the "All Groups Member" field enabled.
  if (!$account->hasField('field_all_groups_member')) {
    return;
  }

  $is_all_groups_member = (bool) $account->get('field_all_groups_member')->value;
  if (!$is_all_groups_member) {
    return;
  }

  // Load all groups and add the user as a member with admin role.
  $groups = Group::loadMultiple();
  foreach ($groups as $group) {
    // Check if user is allowed to be added to this group type.
    if (_markaspot_group_user_allowed_for_group($account, $group)) {
      _markaspot_group_add_member_to_group($group, $account);
    }
  }
}

/**
 * Helper function to add all "All Groups Member" users to a new group.
 *
 * Applies different rules based on group type:
 * - JUR (Jurisdiction): Only user 1 (uid=1) is automatically added.
 * - ORG (Organisation): All users with field_all_groups_member are added.
 *
 * @param \Drupal\group\Entity\GroupInterface $group
 *   The group to add members to.
 */
function _markaspot_group_add_all_groups_members_to_group(GroupInterface $group): void {
  /** @var \Drupal\Core\Entity\EntityTypeManagerInterface $entity_type_manager */
  $entity_type_manager = \Drupal::entityTypeManager();

  // Load all users with the "All Groups Member" field enabled.
  $user_storage = $entity_type_manager->getStorage('user');
  $query = $user_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('field_all_groups_member', TRUE)
    ->condition('status', 1);

  $uids = $query->execute();
  if (empty($uids)) {
    return;
  }

  /** @var \Drupal\user\UserInterface[] $users */
  $users = $user_storage->loadMultiple($uids);
  foreach ($users as $user) {
    // Check if user is allowed to be added to this group type.
    if (_markaspot_group_user_allowed_for_group($user, $group)) {
      _markaspot_group_add_member_to_group($group, $user);
    }
  }
}

/**
 * Checks if a user is allowed to be auto-added to a group.
 *
 * Called by _markaspot_group_add_all_groups_members_to_group() for users
 * with field_all_groups_member enabled. Currently allows all group types.
 *
 * @param \Drupal\user\UserInterface $account
 *   The user account to check.
 * @param \Drupal\group\Entity\GroupInterface $group
 *   The group to check against.
 *
 * @return bool
 *   TRUE if the user is allowed to be added, FALSE otherwise.
 */
function _markaspot_group_user_allowed_for_group(UserInterface $account, GroupInterface $group): bool {
  // JUR groups: only uid=1 is auto-added as member.
  if ($group->bundle() === 'jur') {
    return (int) $account->id() === 1;
  }
  // ORG groups: all users with field_all_groups_member are added.
  return TRUE;
}

/**
 * Helper function to add a user to a group as member.
 *
 * In Group 3.x, admin permissions are handled via 'insider' scope roles
 * which automatically apply to all group members. Therefore we simply
 * add the user as a member without specifying a role.
 *
 * @param \Drupal\group\Entity\GroupInterface $group
 *   The group to add the member to.
 * @param \Drupal\user\UserInterface $account
 *   The user account to add.
 */
function _markaspot_group_add_member_to_group(GroupInterface $group, UserInterface $account): void {
  // Skip if user is already a member.
  if ($group->getMember($account)) {
    return;
  }

  // Add user as member. Admin permissions come from insider scope roles.
  $group->addMember($account);

  \Drupal::logger('markaspot_group')->notice(
    'Added user @user to group @group as member.',
    [
      '@user' => $account->getDisplayName(),
      '@group' => $group->label(),
    ]
  );
}

/**
 * Implements hook_node_presave().
 *
 * Handles two presave operations for service_request nodes:
 * 1. Corrects initial status for multi-tenant jurisdictions (new nodes only).
 * 2. Syncs field_organisation to group relationship.
 *
 * This hook runs BEFORE service_request_node_presave (module weight order),
 * ensuring the status is corrected before the status note paragraph is created.
 */
function markaspot_group_node_presave(NodeInterface $node): void {
  // Only process service_request nodes.
  if ($node->bundle() !== 'service_request') {
    return;
  }

  // 1. Correct initial status for jurisdiction-aware multi-tenant setups.
  _markaspot_group_presave_service_request_status($node);

  // Check if field_organisation exists on this node.
  if (!$node->hasField('field_organisation')) {
    return;
  }

  // Check if we're already syncing from relationship to field.
  // This prevents infinite loops.
  if (_markaspot_group_is_syncing()) {
    return;
  }

  // Get the new organisation group ID from the field.
  // Cast to int as JSON:API may pass string values.
  $new_group_id = NULL;
  if (!$node->get('field_organisation')->isEmpty()) {
    $new_group_id = (int) $node->get('field_organisation')->target_id;
  }

  // For new nodes, we can't sync yet - need to wait until after save.
  // The relationship will be created in hook_node_insert.
  if ($node->isNew()) {
    // Store the group ID for later processing in hook_node_insert.
    $node->_markaspot_group_pending_sync = $new_group_id;
    return;
  }

  // For existing nodes, check the original value.
  // Cast to int as JSON:API may pass string values.
  $original_group_id = NULL;
  if (isset($node->original) && $node->original->hasField('field_organisation') && !$node->original->get('field_organisation')->isEmpty()) {
    $original_group_id = (int) $node->original->get('field_organisation')->target_id;
  }

  // If nothing changed, skip sync.
  if ($new_group_id === $original_group_id) {
    return;
  }

  // Schedule sync for hook_node_update (we need the node to exist first).
  $node->_markaspot_group_sync_needed = TRUE;
  $node->_markaspot_group_new_group_id = $new_group_id;
  $node->_markaspot_group_original_group_id = $original_group_id;
}

/**
 * Implements hook_node_insert().
 *
 * Handles all group assignments for new service_request nodes:
 * 1. Assigns sub-jurisdictions by geographic boundary
 * 2. Assigns root jurisdiction (fallback when no sub-jur matched)
 * 3. Derives organisation from category (jurisdiction-aware)
 * 4. Syncs field_organisation to org group relationship
 * 5. Sends notification email to the assigned organisation
 * 6. Saves node if org was derived.
 *
 * The sub-jurisdiction assignment runs first so that org derivation can
 * check whether a child jurisdiction has its own org handling the category.
 */
function markaspot_group_node_insert(NodeInterface $node): void {
  // Only process service_request nodes.
  if ($node->bundle() !== 'service_request') {
    return;
  }

  // 1. Auto-assign to sub-jurisdictions based on geographic boundaries.
  // Returns the child jur group ID (int) or FALSE if no sub-jur matched.
  // Run this BEFORE org derivation so we know which jurisdiction to check
  // for jurisdiction-specific org assignments.
  $child_jur_id = _markaspot_group_assign_sub_jurisdictions($node);

  // 2. Auto-assign to root jurisdiction group (only if no child jur was found).
  // Skip entirely when a sub-jurisdiction was assigned: the reporting jur
  // (e.g. Noord) is the authoritative one. Adding the root (e.g. Amsterdam)
  // would make escalation meaningless because the request already belongs
  // to the parent's scope.
  if (!$child_jur_id) {
    _markaspot_group_assign_root_jurisdiction($node);
  }

  // 3. Derive organisation from category if not already set.
  //    Replaces ECA rule process_apply_group which read
  //    [node:field_category:entity:field_category_gid].
  //    Now jurisdiction-aware: if a child jur was assigned, checks for an
  //    org in that jurisdiction that handles the category before falling
  //    back to the root-level org from field_category_gid.
  $org_derived = FALSE;
  if ($node->hasField('field_organisation') && $node->get('field_organisation')->isEmpty()) {
    $org_group_id = _markaspot_group_derive_org_from_category($node, $child_jur_id ?: NULL);
    if ($org_group_id) {
      $node->set('field_organisation', ['target_id' => $org_group_id]);
      $node->_markaspot_group_pending_sync = $org_group_id;
      $org_derived = TRUE;
    }
  }

  // 4. Sync field_organisation to org group relationship.
  if (isset($node->_markaspot_group_pending_sync)) {
    $group_id = $node->_markaspot_group_pending_sync;
    if (!empty($group_id) && !_markaspot_group_is_syncing()) {
      _markaspot_group_sync_field_to_relationship($node, $group_id, NULL);
    }
  }

  // 5. Notify the assigned organisation via email.
  if ($org_derived) {
    _markaspot_group_notify_organisation($node);
  }

  // 6. Save the node if we derived the organisation (field_organisation changed).
  if ($org_derived) {
    // Prevent recursive hooks during this save.
    _markaspot_group_set_syncing(TRUE);
    try {
      $node->save();
    }
    finally {
      _markaspot_group_set_syncing(FALSE);
    }
  }
}

/**
 * Implements hook_node_update().
 *
 * Updates group relationship when field_organisation changes on a
 * service_request node.
 */
function markaspot_group_node_update(NodeInterface $node): void {
  // Only process service_request nodes.
  if ($node->bundle() !== 'service_request') {
    return;
  }

  // Check if sync was flagged in presave.
  if (empty($node->_markaspot_group_sync_needed)) {
    return;
  }

  // Check if we're already syncing.
  if (_markaspot_group_is_syncing()) {
    return;
  }

  $new_group_id = $node->_markaspot_group_new_group_id ?? NULL;
  $original_group_id = $node->_markaspot_group_original_group_id ?? NULL;

  // Perform the sync.
  _markaspot_group_sync_field_to_relationship($node, $new_group_id, $original_group_id);
}

/**
 * Implements hook_ENTITY_TYPE_insert() for group_relationship entities.
 *
 * Syncs group relationship to field_organisation when a service_request
 * is added to an org group.
 */
function markaspot_group_group_relationship_insert(GroupRelationshipInterface $relationship): void {
  _markaspot_group_sync_relationship_to_field($relationship, 'insert');
}

/**
 * Implements hook_ENTITY_TYPE_delete() for group_relationship entities.
 *
 * Clears field_organisation when a service_request is removed from an org group.
 */
function markaspot_group_group_relationship_delete(GroupRelationshipInterface $relationship): void {
  _markaspot_group_sync_relationship_to_field($relationship, 'delete');
}

/**
 * Syncs field_organisation to group relationship.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node.
 * @param int|null $new_group_id
 *   The new group ID to add the relationship to, or NULL to remove.
 * @param int|null $original_group_id
 *   The original group ID to remove the relationship from, or NULL.
 */
function _markaspot_group_sync_field_to_relationship(NodeInterface $node, ?int $new_group_id, ?int $original_group_id): void {
  // Set syncing flag to prevent loops.
  _markaspot_group_set_syncing(TRUE);

  try {
    $entity_type_manager = \Drupal::entityTypeManager();
    $relationship_storage = $entity_type_manager->getStorage('group_relationship');
    $group_type = _markaspot_group_get_org_group_type();
    $plugin_id = 'group_node:service_request';

    // Remove existing relationship if group changed or was cleared.
    if ($original_group_id !== NULL) {
      // Find and delete the old relationship.
      $old_relationships = $relationship_storage->loadByProperties([
        'entity_id' => $node->id(),
        'gid' => $original_group_id,
        'plugin_id' => $plugin_id,
      ]);

      foreach ($old_relationships as $relationship) {
        $relationship->delete();
      }
    }

    // Create new relationship if a group was set.
    if ($new_group_id !== NULL) {
      // Load the target group.
      $group = $entity_type_manager->getStorage('group')->load($new_group_id);

      if ($group && $group->bundle() === $group_type) {
        // Check if relationship already exists.
        $existing = $relationship_storage->loadByProperties([
          'entity_id' => $node->id(),
          'gid' => $new_group_id,
          'plugin_id' => $plugin_id,
        ]);

        if (empty($existing)) {
          // Create the relationship.
          $group->addRelationship($node, $plugin_id);

          \Drupal::logger('markaspot_group')->notice(
            'Created group relationship for node @nid in group @group (synced from field_organisation).',
            [
              '@nid' => $node->id(),
              '@group' => $group->label(),
            ]
          );
        }
      }
      elseif ($group) {
        \Drupal::logger('markaspot_group')->error(
          'Node @nid: field_organisation references group @gid with bundle "@bundle", expected "@expected". Skipping sync.',
          [
            '@nid' => $node->id(),
            '@gid' => $new_group_id,
            '@bundle' => $group->bundle(),
            '@expected' => $group_type,
          ]
        );
      }
    }
  }
  finally {
    // Always reset syncing flag.
    _markaspot_group_set_syncing(FALSE);
  }
}

/**
 * Syncs group relationship changes back to field_organisation.
 *
 * @param \Drupal\group\Entity\GroupRelationshipInterface $relationship
 *   The group relationship entity.
 * @param string $operation
 *   The operation: 'insert' or 'delete'.
 */
function _markaspot_group_sync_relationship_to_field(GroupRelationshipInterface $relationship, string $operation): void {
  // Only process service_request node relationships.
  if ($relationship->getPluginId() !== 'group_node:service_request') {
    return;
  }

  // Get the group type and check if it's an org type.
  $group = $relationship->getGroup();
  if (!$group) {
    return;
  }

  $group_type = _markaspot_group_get_org_group_type();
  if ($group->bundle() !== $group_type) {
    return;
  }

  // Check if we're already syncing.
  if (_markaspot_group_is_syncing()) {
    return;
  }

  // Get the node.
  $entity = $relationship->getEntity();
  if (!$entity || !($entity instanceof NodeInterface)) {
    return;
  }

  // Check if node has the field.
  if (!$entity->hasField('field_organisation')) {
    return;
  }

  // Set syncing flag.
  _markaspot_group_set_syncing(TRUE);

  try {
    $current_value = $entity->get('field_organisation')->isEmpty() ? NULL : (int) $entity->get('field_organisation')->target_id;
    $group_id = (int) $group->id();

    if ($operation === 'insert') {
      // Set the field to the new group.
      if ($current_value !== $group_id) {
        $entity->set('field_organisation', $group_id);
        $entity->save();

        \Drupal::logger('markaspot_group')->notice(
          'Updated field_organisation on node @nid to group @group (synced from relationship).',
          [
            '@nid' => $entity->id(),
            '@group' => $group->label(),
          ]
        );
      }
    }
    elseif ($operation === 'delete') {
      // Clear the field only if it points to this group.
      if ($current_value === $group_id) {
        $entity->set('field_organisation', NULL);
        $entity->save();

        \Drupal::logger('markaspot_group')->notice(
          'Cleared field_organisation on node @nid (synced from relationship deletion).',
          [
            '@nid' => $entity->id(),
          ]
        );
      }
    }
  }
  finally {
    _markaspot_group_set_syncing(FALSE);
  }
}

/**
 * Gets the organisation group type for field_organisation sync.
 *
 * Always returns 'org' because field_organisation must only reference
 * organisation groups, never jurisdiction groups. The group_filter_type
 * config controls API scoping and is intentionally not used here.
 *
 * @return string
 *   The group type machine name ('org').
 */
function _markaspot_group_get_org_group_type(): string {
  return 'org';
}

/**
 * Checks if we're currently in a sync operation.
 *
 * Uses a static variable to prevent infinite loops during bidirectional sync.
 *
 * @return bool
 *   TRUE if currently syncing, FALSE otherwise.
 */
function _markaspot_group_is_syncing(): bool {
  return drupal_static(__FUNCTION__, FALSE);
}

/**
 * Sets the sync flag.
 *
 * @param bool $syncing
 *   Whether syncing is in progress.
 */
function _markaspot_group_set_syncing(bool $syncing): void {
  $static = &drupal_static('_markaspot_group_is_syncing', FALSE);
  $static = $syncing;
}

/**
 * Derives the organisation group from a node's category term.
 *
 * When a child jurisdiction ID is provided, first searches for an org in
 * that jurisdiction that declares the category in its field_service_categories.
 * If no jurisdiction-specific org is found, falls back to the root-level org
 * from field_category_gid on the category term.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node.
 * @param int|null $child_jur_id
 *   Optional child jurisdiction group ID. When provided, the function first
 *   checks for an org in this jurisdiction that handles the node's category.
 *
 * @return int|null
 *   The org group ID, or NULL if no mapping exists.
 */
function _markaspot_group_derive_org_from_category(NodeInterface $node, ?int $child_jur_id = NULL): ?int {
  if (!$node->hasField('field_category') || $node->get('field_category')->isEmpty()) {
    return NULL;
  }

  $term = $node->get('field_category')->entity;
  if (!$term) {
    return NULL;
  }

  $category_tid = (int) $term->id();
  $group_storage = \Drupal::entityTypeManager()->getStorage('group');

  // Strategy 1: Jurisdiction-aware lookup.
  // If the node was assigned to a child jurisdiction, look for an org in that
  // jurisdiction that declares this category in field_service_categories.
  if ($child_jur_id) {
    $org_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'org')
      ->condition('field_jurisdiction', $child_jur_id)
      ->condition('field_service_categories', $category_tid)
      ->execute();

    if (!empty($org_ids)) {
      $org_id = (int) reset($org_ids);
      \Drupal::logger('markaspot_group')->notice(
        'Jurisdiction-aware org derivation: category TID=@tid matched org @org_id in child jur @jur_id.',
        [
          '@tid' => $category_tid,
          '@org_id' => $org_id,
          '@jur_id' => $child_jur_id,
        ]
      );
      return $org_id;
    }
  }

  // Strategy 2: Fallback to root-level org via field_category_gid.
  if (!$term->hasField('field_category_gid') || $term->get('field_category_gid')->isEmpty()) {
    return NULL;
  }

  $org_group_id = (int) $term->get('field_category_gid')->target_id;

  // Verify the referenced group exists and is an org group.
  $group = $group_storage->load($org_group_id);
  if (!$group || $group->bundle() !== 'org') {
    \Drupal::logger('markaspot_group')->warning(
      'Category term @tid references non-existent or non-org group @gid via field_category_gid.',
      ['@tid' => $term->id(), '@gid' => $org_group_id]
    );
    return NULL;
  }

  return $org_group_id;
}

/**
 * Sends notification email to the assigned organisation.
 *
 * Replaces the email action from the ECA rule process_apply_group.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node with field_organisation set.
 */
function _markaspot_group_notify_organisation(NodeInterface $node): void {
  if (!$node->hasField('field_organisation') || $node->get('field_organisation')->isEmpty()) {
    return;
  }

  $org_group = $node->get('field_organisation')->entity;
  if (!$org_group || !$org_group->hasField('field_head_organisation_e_mail')) {
    return;
  }

  $email = $org_group->get('field_head_organisation_e_mail')->isEmpty()
    ? NULL
    : $org_group->get('field_head_organisation_e_mail')->value;

  if (!$email) {
    return;
  }

  $request_id = _markaspot_group_sanitize_for_email(
    (string) ($node->hasField('request_id') ? $node->get('request_id')->value ?? $node->id() : $node->id())
  );
  $category = _markaspot_group_sanitize_for_email(
    $node->hasField('field_category') && !$node->get('field_category')->isEmpty()
      ? $node->get('field_category')->entity->label()
      : ''
  );
  $address = _markaspot_group_sanitize_for_email(
    $node->hasField('field_address') ? $node->get('field_address')->value ?? '' : ''
  );
  $body_text = _markaspot_group_sanitize_for_email(
    $node->hasField('body') && !$node->get('body')->isEmpty()
      ? $node->get('body')->value
      : ''
  );
  $site_url = \Drupal::request()->getSchemeAndHttpHost();

  $subject = "A request #$request_id for the category $category";
  $message = "Hello,\na citizen request has been assigned to your organization:\n\n"
    . "Category: {$node->label()}\n"
    . "Detailed Description: $body_text\n"
    . "Location of the request: $address\n\n"
    . "To process the request, please click on the following link:\n"
    . "$site_url/{$node->id()}/edit\n\n"
    . "Not registered yet today? $site_url/{$node->id()}/user\n\n"
    . "--\nThis is an automatically generated email and cannot be replied to.";

  /** @var \Drupal\Core\Mail\MailManagerInterface $mail_manager */
  $mail_manager = \Drupal::service('plugin.manager.mail');
  $mail_manager->mail('markaspot_group', 'org_notification', $email, 'en', [
    'subject' => $subject,
    'message' => $message,
  ]);
}

/**
 * Strips HTML tags and CRLF sequences from text for safe email embedding.
 *
 * Prevents header injection and XSS in email bodies.
 */
function _markaspot_group_sanitize_for_email(string $text): string {
  return str_replace(["\r\n", "\r", "\n"], ' ', strip_tags($text));
}

/**
 * Assigns a service request to its root jurisdiction group.
 *
 * Determines the root jurisdiction via two strategies:
 * 1. From the node's field_organisation: if the org group has a
 *    field_jurisdiction reference, resolve upward to the root jur.
 * 2. Fallback: find the single root jur group (no field_parent_jurisdiction).
 *
 * Replaces the former ECA rule process_apply_jurisdiction which hardcoded
 * group_id 1 for all service requests.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node.
 */
function _markaspot_group_assign_root_jurisdiction(NodeInterface $node): void {
  $plugin_id = 'group_node:service_request';
  $etm = \Drupal::entityTypeManager();
  $group_storage = $etm->getStorage('group');
  $relationship_storage = $etm->getStorage('group_relationship');

  $root_jur = NULL;

  // Strategy 1: Derive from field_organisation -> org group -> field_jurisdiction.
  if ($node->hasField('field_organisation') && !$node->get('field_organisation')->isEmpty()) {
    $org_id = (int) $node->get('field_organisation')->target_id;
    $org_group = $group_storage->load($org_id);
    if ($org_group && $org_group->hasField('field_jurisdiction') && !$org_group->get('field_jurisdiction')->isEmpty()) {
      $jur_id = (int) $org_group->get('field_jurisdiction')->target_id;
      // Resolve upward to root using the hierarchy resolver service.
      $root_id = \Drupal::service('markaspot_group.hierarchy_resolver')
        ->getRootJurisdictionId($jur_id);
      $root_jur = $group_storage->load($root_id);
    }
  }

  // Strategy 2: Fallback to the single root jur (no parent jurisdiction).
  if (!$root_jur) {
    $root_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'jur')
      ->notExists('field_parent_jurisdiction')
      ->execute();

    if (count($root_ids) === 1) {
      $root_jur = $group_storage->load(reset($root_ids));
    }
    elseif (count($root_ids) > 1) {
      // Multiple root jurisdictions without org context. Cannot determine which
      // one to use. Log a warning and skip assignment.
      \Drupal::logger('markaspot_group')->warning(
        'Cannot auto-assign root jurisdiction for node @nid: @count root jurisdictions exist but node has no organisation set.',
        ['@nid' => $node->id(), '@count' => count($root_ids)]
      );
      return;
    }
    else {
      return;
    }
  }

  if (!$root_jur) {
    return;
  }

  // Check if relationship already exists.
  $existing = $relationship_storage->loadByProperties([
    'entity_id' => $node->id(),
    'gid' => $root_jur->id(),
    'plugin_id' => $plugin_id,
  ]);

  if (!empty($existing)) {
    return;
  }

  try {
    $root_jur->addRelationship($node, $plugin_id);
    \Drupal::logger('markaspot_group')->notice(
      'Auto-assigned node @nid to root jurisdiction "@group" (id=@gid).',
      [
        '@nid' => $node->id(),
        '@group' => $root_jur->label(),
        '@gid' => $root_jur->id(),
      ]
    );
  }
  catch (\Exception $e) {
    \Drupal::logger('markaspot_group')->error(
      'Failed to assign node @nid to root jurisdiction "@group": @error',
      [
        '@nid' => $node->id(),
        '@group' => $root_jur->label(),
        '@error' => $e->getMessage(),
      ]
    );
  }
}

/**
 * Assigns a service request to sub-jurisdictions based on boundaries.
 *
 * Loads all jurisdiction groups with a field_boundary, checks if the node's
 * coordinates fall within each boundary polygon, and creates group
 * relationships for matches. Skips top-level jurisdictions (assigned by
 * _markaspot_group_assign_root_jurisdiction).
 *
 * @param \Drupal\node\NodeInterface $node
 *   The service_request node.
 *
 * @return int|false
 *   The child jurisdiction group ID if one was assigned, FALSE otherwise.
 *   When multiple sub-jurisdictions match (overlapping boundaries), the
 *   first matched child jur ID is returned.
 */
function _markaspot_group_assign_sub_jurisdictions(NodeInterface $node): int|false {
  // Get coordinates from the node.
  if (!$node->hasField('field_geolocation') || $node->get('field_geolocation')->isEmpty()) {
    return FALSE;
  }

  $geolocation = $node->get('field_geolocation')->first();
  $lat = (float) $geolocation->get('lat')->getValue();
  $lng = (float) $geolocation->get('lng')->getValue();

  if ($lat === 0.0 && $lng === 0.0) {
    return FALSE;
  }

  // Load all jurisdiction groups with boundaries.
  $group_storage = \Drupal::entityTypeManager()->getStorage('group');
  $group_ids = $group_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'jur')
    ->exists('field_boundary')
    ->execute();

  if (empty($group_ids)) {
    return FALSE;
  }

  $groups = $group_storage->loadMultiple($group_ids);
  $plugin_id = 'group_node:service_request';
  $relationship_storage = \Drupal::entityTypeManager()->getStorage('group_relationship');
  // Track the first matched child jurisdiction group ID.
  $assigned_child_jur_id = FALSE;

  foreach ($groups as $group) {
    if ($group->get('field_boundary')->isEmpty()) {
      continue;
    }

    // Skip top-level jurisdictions (no parent). These are tenants or root
    // cities, assigned by _markaspot_group_assign_root_jurisdiction(). Only
    // districts/subdivisions (with a parent) get auto-assigned by boundary.
    if (!$group->hasField('field_parent_jurisdiction')
        || $group->get('field_parent_jurisdiction')->isEmpty()) {
      continue;
    }

    $boundary_json = $group->get('field_boundary')->value;
    $boundary = GeoJsonBoundary::fromJson($boundary_json);
    if (!$boundary) {
      \Drupal::logger('markaspot_group')->warning(
        'Invalid boundary GeoJSON on jurisdiction group @gid.',
        ['@gid' => $group->id()]
      );
      continue;
    }

    if (!$boundary->contains($lng, $lat)) {
      continue;
    }

    // Record the first matched child jur ID for org derivation.
    if ($assigned_child_jur_id === FALSE) {
      $assigned_child_jur_id = (int) $group->id();
    }

    // Check if relationship already exists.
    $existing = $relationship_storage->loadByProperties([
      'entity_id' => $node->id(),
      'gid' => $group->id(),
      'plugin_id' => $plugin_id,
    ]);

    if (!empty($existing)) {
      continue;
    }

    // Add node to this jurisdiction.
    try {
      $group->addRelationship($node, $plugin_id);
      \Drupal::logger('markaspot_group')->notice(
        'Auto-assigned node @nid to sub-jurisdiction "@group" (point in boundary).',
        [
          '@nid' => $node->id(),
          '@group' => $group->label(),
        ]
      );
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot_group')->error(
        'Failed to assign node @nid to sub-jurisdiction "@group": @error',
        [
          '@nid' => $node->id(),
          '@group' => $group->label(),
          '@error' => $e->getMessage(),
        ]
      );
    }
  }

  return $assigned_child_jur_id;
}
