<?php

/**
 * @file
 * Install, update and uninstall functions for markaspot_group module.
 */

use Drupal\Component\Serialization\Yaml;
use Drupal\user\Entity\Role;

/**
 * Implements hook_requirements().
 */
function markaspot_group_requirements(string $phase): array {
  $requirements = [];

  if ($phase !== 'runtime') {
    return $requirements;
  }

  $issues = _markaspot_group_obsolete_eca_runtime_issues();
  $requirements['markaspot_group_obsolete_eca'] = [
    'title' => t('Mark-a-Spot obsolete ECA models'),
    'value' => empty($issues) ? t('Disabled') : t('@count issue(s)', [
      '@count' => count($issues),
    ]),
    'severity' => empty($issues)
      ? \Drupal\Core\Extension\Requirement\RequirementSeverity::OK
      : \Drupal\Core\Extension\Requirement\RequirementSeverity::Warning,
  ];

  if (!empty($issues)) {
    $requirements['markaspot_group_obsolete_eca']['description'] = t('Obsolete ECA models replaced by code-based group assignment are active or still subscribed: @issues', [
      '@issues' => implode('; ', $issues),
    ]);
  }

  return $requirements;
}

/**
 * Gets runtime issues for obsolete ECA models.
 *
 * @return string[]
 *   Human-readable issue summaries.
 */
function _markaspot_group_obsolete_eca_runtime_issues(): array {
  $issues = [];
  foreach (['process_apply_group'] as $eca_id) {
    $config = \Drupal::configFactory()->get("eca.eca.{$eca_id}");
    if (!$config->isNew() && $config->get('status') !== FALSE) {
      $issues[] = "eca.eca.{$eca_id} is enabled";
    }

    $subscribed = \Drupal::state()->get('eca.subscribed', []);
    if (_markaspot_group_eca_subscription_contains($subscribed, $eca_id)) {
      $issues[] = "eca.subscribed references {$eca_id}";
    }
  }

  return $issues;
}

/**
 * Checks whether an ECA subscribed-events state tree contains an ECA ID.
 *
 * @param mixed $subscribed
 *   ECA subscribed-events state.
 * @param string $eca_id
 *   ECA config entity ID.
 *
 * @return bool
 *   TRUE if the state tree references the ECA ID.
 */
function _markaspot_group_eca_subscription_contains(mixed $subscribed, string $eca_id): bool {
  if (!is_array($subscribed)) {
    return FALSE;
  }

  foreach ($subscribed as $key => $value) {
    if ((string) $key === $eca_id) {
      return TRUE;
    }
    if (_markaspot_group_eca_subscription_contains($value, $eca_id)) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Removes obsolete ECA IDs from ECA subscribed-events state.
 *
 * @return int
 *   Number of obsolete ECA IDs that were found and pruned.
 */
function _markaspot_group_prune_obsolete_eca_subscriptions(): int {
  $state = \Drupal::state();
  $subscribed = $state->get('eca.subscribed', []);
  if (!is_array($subscribed)) {
    return 0;
  }

  $pruned = 0;
  foreach (['process_apply_group'] as $eca_id) {
    if (_markaspot_group_eca_subscription_contains($subscribed, $eca_id)) {
      $pruned++;
      $subscribed = _markaspot_group_prune_eca_subscription_id($subscribed, $eca_id);
    }
  }

  if ($pruned > 0) {
    $state->set('eca.subscribed', $subscribed);
  }

  return $pruned;
}

/**
 * Removes a single ECA ID from a subscribed-events state tree.
 *
 * @param mixed $subscribed
 *   ECA subscribed-events state tree.
 * @param string $eca_id
 *   ECA config entity ID.
 *
 * @return mixed
 *   Pruned subscribed-events state tree.
 */
function _markaspot_group_prune_eca_subscription_id(mixed $subscribed, string $eca_id): mixed {
  if (!is_array($subscribed)) {
    return $subscribed;
  }

  foreach ($subscribed as $key => $value) {
    if ((string) $key === $eca_id) {
      unset($subscribed[$key]);
      continue;
    }

    $subscribed[$key] = _markaspot_group_prune_eca_subscription_id($value, $eca_id);
    if (is_array($subscribed[$key]) && $subscribed[$key] === []) {
      unset($subscribed[$key]);
    }
  }

  return $subscribed;
}

/**
 * Rebuilds ECA subscribed-events state when the ECA module is available.
 */
function _markaspot_group_rebuild_eca_subscribed_events(): bool {
  if (!\Drupal::moduleHandler()->moduleExists('eca')) {
    return FALSE;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('eca');
  if (!method_exists($storage, 'rebuildSubscribedEvents')) {
    return FALSE;
  }

  $storage->rebuildSubscribedEvents();
  return TRUE;
}

/**
 * Implements hook_schema().
 */
function markaspot_group_schema(): array {
  $schema['markaspot_group_invitations'] = [
    'description' => 'Stores pending group membership invitations.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'token' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Unique invitation token (hex-encoded random bytes).',
      ],
      'email' => [
        'type' => 'varchar',
        'length' => 254,
        'not null' => TRUE,
        'description' => 'Invitee email address.',
      ],
      'group_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Target group entity ID.',
      ],
      'roles' => [
        'type' => 'text',
        'not null' => TRUE,
        'description' => 'JSON array of group role IDs.',
      ],
      'invited_by' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'UID of the user who created the invitation.',
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Timestamp when the invitation was created.',
      ],
      'expires' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Timestamp when the invitation expires.',
      ],
      'claimed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'default' => NULL,
        'description' => 'Timestamp when the invitation was claimed, NULL if pending.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'token' => ['token'],
    ],
    'indexes' => [
      'email_group' => ['email', 'group_id'],
    ],
  ];

  return $schema;
}

/**
 * Fix jur-admin and org-admin group role scopes to individual.
 *
 * Previously jur-admin had scope=insider (all members became admins) and
 * org-admin had scope=outsider. Both need scope=individual so the admin role
 * can be assigned explicitly to specific members.
 */
function markaspot_group_update_11800(): void {
  $fixes = [
    'group.role.jur-admin' => 'individual',
    'group.role.org-admin' => 'individual',
  ];

  foreach ($fixes as $config_name => $scope) {
    $config = \Drupal::configFactory()->getEditable($config_name);
    if ($config->isNew()) {
      continue;
    }
    if ($config->get('scope') !== $scope) {
      $config->set('scope', $scope)->save();
      \Drupal::logger('markaspot_group')->info('Fixed @role scope to @scope.', [
        '@role' => $config_name,
        '@scope' => $scope,
      ]);
    }
  }
}

/**
 * Add 'edit group' permission to org-admin role.
 */
function markaspot_group_update_11801(): void {
  $config = \Drupal::configFactory()->getEditable('group.role.org-admin');
  if ($config->isNew()) {
    return;
  }
  $permissions = $config->get('permissions') ?? [];
  if (!in_array('edit group', $permissions)) {
    $permissions[] = 'edit group';
    $config->set('permissions', $permissions)->save();
  }
}

/**
 * Add field_jurisdiction to org group type and disable ECA rules.
 *
 * Creates an entity reference field on organisation groups pointing to
 * jurisdiction groups. Supports both legacy ('organisation') and modern ('org')
 * group type names via markaspot_open311.settings config.
 *
 * Also disables ECA rules replaced by code-based group assignment.
 */
function markaspot_group_update_11900(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $config = \Drupal::configFactory()->get('markaspot_open311.settings');
  $logger = \Drupal::logger('markaspot_group');

  // Read bundle names from config (legacy: 'organisation'/'jurisdiction').
  $org_type = $config->get('group_filter_type') ?? 'org';
  $jur_type = $config->get('jurisdiction_group_type') ?? 'jur';

  // Verify the org group type exists.
  $org_group_type = $entity_type_manager->getStorage('group_type')->load($org_type);
  if (!$org_group_type) {
    $logger->warning('Org group type "@type" not found. Skipping field_jurisdiction creation.', [
      '@type' => $org_type,
    ]);
    return;
  }

  // 1. Create field storage if it does not exist.
  $storage_id = 'group.field_jurisdiction';
  $field_storage = $entity_type_manager->getStorage('field_storage_config')
    ->load($storage_id);

  if (!$field_storage) {
    $field_storage = $entity_type_manager->getStorage('field_storage_config')
      ->create([
        'field_name' => 'field_jurisdiction',
        'entity_type' => 'group',
        'type' => 'entity_reference',
        'settings' => [
          'target_type' => 'group',
        ],
        'cardinality' => 1,
      ]);
    $field_storage->save();
    $logger->info('Created field storage group.field_jurisdiction.');
  }

  // 2. Create field instance on the detected org bundle.
  $field_id = "group.{$org_type}.field_jurisdiction";
  $field_config = $entity_type_manager->getStorage('field_config')
    ->load($field_id);

  if (!$field_config) {
    $field_config = $entity_type_manager->getStorage('field_config')
      ->create([
        'field_storage' => $field_storage,
        'bundle' => $org_type,
        'label' => 'Jurisdiction',
        'description' => 'The jurisdiction (city/district) this organisation belongs to.',
        'required' => FALSE,
        'settings' => [
          'handler' => 'default:group',
          'handler_settings' => [
            'target_bundles' => [$jur_type => $jur_type],
            'sort' => ['field' => 'label', 'direction' => 'ASC'],
            'auto_create' => FALSE,
          ],
        ],
      ]);
    $field_config->save();
    $logger->info('Created field instance @id.', ['@id' => $field_id]);
  }

  // 3. Add field to org form display.
  $form_display = $entity_type_manager->getStorage('entity_form_display')
    ->load("group.{$org_type}.default");

  if (!$form_display) {
    $form_display = $entity_type_manager->getStorage('entity_form_display')
      ->create([
        'targetEntityType' => 'group',
        'bundle' => $org_type,
        'mode' => 'default',
        'status' => TRUE,
      ]);
  }

  $form_display->setComponent('field_jurisdiction', [
    'type' => 'entity_reference_autocomplete',
    'weight' => 5,
    'settings' => [
      'match_operator' => 'CONTAINS',
      'match_limit' => 10,
      'size' => 60,
      'placeholder' => '',
    ],
  ]);
  $form_display->save();

  // 4. Disable ECA rules replaced by code-based group assignment.
  $eca_rules = [
    'eca.eca.process_apply_jurisdiction' => 'root jurisdiction assignment',
    'eca.eca.process_apply_group' => 'organisation assignment + notification',
  ];
  foreach ($eca_rules as $config_name => $description) {
    $eca_config = \Drupal::configFactory()->getEditable($config_name);
    if (!$eca_config->isNew()) {
      $eca_config->set('status', FALSE)->save();
      $logger->info(
        'Disabled ECA rule @name (replaced by code-based @desc).',
        ['@name' => $config_name, '@desc' => $description]
      );
    }
  }
}

/**
 * Backfill org->jur references and jur group memberships for existing data.
 *
 * Uses $sandbox for batch processing to handle sites with 100k+ nodes.
 *
 * Phase 1 (first call): Sets field_jurisdiction on all org groups.
 * Phase 2 (subsequent calls): Adds service_request nodes to root jur group
 * in batches of 100.
 */
function markaspot_group_update_11901(array &$sandbox): void {
  $etm = \Drupal::entityTypeManager();
  $group_storage = $etm->getStorage('group');
  $config = \Drupal::configFactory()->get('markaspot_open311.settings');
  $logger = \Drupal::logger('markaspot_group');

  // Resolve group type names.
  $org_type = $config->get('group_filter_type') ?? 'org';
  $jur_type = $config->get('jurisdiction_group_type') ?? 'jur';

  // First call: initialize sandbox.
  if (!isset($sandbox['phase'])) {
    $sandbox['phase'] = 'init';
    $sandbox['root_jur_id'] = NULL;
    $sandbox['processed'] = 0;
    $sandbox['added'] = 0;
    $sandbox['skipped_existing'] = 0;
    $sandbox['total'] = 0;
  }

  // --- Phase: init (find root jur, validate) ---
  if ($sandbox['phase'] === 'init') {
    // Check if field_parent_jurisdiction is configured for this group type.
    $has_parent_field = $etm->getStorage('field_config')
      ->load("group.{$jur_type}.field_parent_jurisdiction") !== NULL;

    if ($has_parent_field) {
      $root_jur_ids = $group_storage->getQuery()
        ->accessCheck(FALSE)
        ->condition('type', $jur_type)
        ->notExists('field_parent_jurisdiction')
        ->execute();
    }
    else {
      // No parent field means all jur groups are roots.
      $root_jur_ids = $group_storage->getQuery()
        ->accessCheck(FALSE)
        ->condition('type', $jur_type)
        ->execute();
    }

    if (empty($root_jur_ids)) {
      $logger->warning('No root jurisdiction group found. Skipping backfill.');
      $sandbox['#finished'] = 1;
      return;
    }

    if (count($root_jur_ids) > 1) {
      $logger->warning(
        'Multiple root jurisdictions found (@count). Skipping automatic backfill. Assign field_jurisdiction on org groups manually.',
        ['@count' => count($root_jur_ids)]
      );
      $sandbox['#finished'] = 1;
      return;
    }

    $sandbox['root_jur_id'] = (int) reset($root_jur_ids);
    $root_jur = $group_storage->load($sandbox['root_jur_id']);

    $logger->info('Backfilling with root jurisdiction "@name" (id=@id).', [
      '@name' => $root_jur->label(),
      '@id' => $sandbox['root_jur_id'],
    ]);

    // Phase: org backfill (set field_jurisdiction on org groups).
    $org_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', $org_type)
      ->execute();

    $org_count = 0;
    foreach ($group_storage->loadMultiple($org_ids) as $org_group) {
      if (!$org_group->hasField('field_jurisdiction')) {
        continue;
      }
      if (!$org_group->get('field_jurisdiction')->isEmpty()) {
        continue;
      }
      $org_group->set('field_jurisdiction', ['target_id' => $sandbox['root_jur_id']]);
      $org_group->save();
      $org_count++;
    }

    if ($org_count > 0) {
      $logger->info('Set field_jurisdiction on @count org groups.', ['@count' => $org_count]);
    }

    // Prepare node backfill: find nodes NOT yet in the root jur group.
    $plugin_id = 'group_node:service_request';
    $db = \Drupal::database();

    // Direct DB query for existing nids (avoids loading 100k+ entities).
    $existing_nids = $db->select('group_relationship_field_data', 'gr')
      ->fields('gr', ['entity_id'])
      ->condition('gid', $sandbox['root_jur_id'])
      ->condition('plugin_id', $plugin_id)
      ->execute()
      ->fetchAllKeyed(0, 0);

    $all_nids = $etm->getStorage('node')->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'service_request')
      ->sort('nid', 'ASC')
      ->execute();

    $sandbox['missing_nids'] = array_values(array_diff($all_nids, array_keys($existing_nids)));
    $sandbox['total'] = count($sandbox['missing_nids']);
    $sandbox['processed'] = 0;
    $sandbox['phase'] = 'nodes';

    if ($sandbox['total'] === 0) {
      $logger->info('All service requests already assigned to root jurisdiction.');
      $sandbox['#finished'] = 1;
      return;
    }

    $logger->info('Starting node backfill: @count nodes to add.', [
      '@count' => $sandbox['total'],
    ]);
  }

  // --- Phase: nodes (batch add to jur group) ---
  if ($sandbox['phase'] === 'nodes') {
    $batch_size = 100;
    $root_jur = $group_storage->load($sandbox['root_jur_id']);
    $plugin_id = 'group_node:service_request';
    $db = \Drupal::database();

    $offset = $sandbox['processed'];
    $chunk = array_slice($sandbox['missing_nids'], $offset, $batch_size);

    if (empty($chunk)) {
      $sandbox['#finished'] = 1;
      return;
    }

    $nodes = $etm->getStorage('node')->loadMultiple($chunk);
    $existing_nids = [];
    if ($chunk !== []) {
      $existing_nids = $db->select('group_relationship_field_data', 'gr')
        ->fields('gr', ['entity_id'])
        ->condition('gid', $sandbox['root_jur_id'])
        ->condition('plugin_id', $plugin_id)
        ->condition('entity_id', $chunk, 'IN')
        ->execute()
        ->fetchAllKeyed(0, 0);
    }
    $added = 0;

    foreach ($nodes as $node) {
      if (isset($existing_nids[(int) $node->id()])) {
        $sandbox['skipped_existing']++;
        continue;
      }

      try {
        $root_jur->addRelationship($node, $plugin_id);
        $added++;
        $sandbox['added']++;
      }
      catch (\Exception $e) {
        // Cardinality constraint or other issue. Log and continue.
        $logger->error('Failed to add node @nid to jur group: @msg', [
          '@nid' => $node->id(),
          '@msg' => $e->getMessage(),
        ]);
      }
    }

    $sandbox['processed'] += count($chunk);

    // Free memory between batches.
    $etm->getStorage('node')->resetCache($chunk);
    $etm->getStorage('group_relationship')->resetCache();

    $sandbox['#finished'] = $sandbox['total'] > 0
      ? $sandbox['processed'] / $sandbox['total']
      : 1;

    if ($sandbox['#finished'] >= 1) {
      $logger->info('Backfill complete: processed @processed of @total nodes; added @added and skipped @skipped_existing already-existing relationships.', [
        '@processed' => $sandbox['processed'],
        '@total' => $sandbox['total'],
        '@added' => $sandbox['added'],
        '@skipped_existing' => $sandbox['skipped_existing'],
      ]);
    }
  }
}

/**
 * Set jur-admin and org-admin group roles to insider scope with global_role.
 *
 * Reverses update_11800 which set scope=individual. Insider scope ensures
 * that Drupal administrators automatically get group admin permissions in
 * all groups they are members of, without explicit per-group role assignment.
 */
function markaspot_group_update_11902(): void {
  $logger = \Drupal::logger('markaspot_group');
  $storage = \Drupal::entityTypeManager()->getStorage('group_role');

  $role_ids = ['jur-admin', 'org-admin'];

  foreach ($role_ids as $role_id) {
    /** @var \Drupal\group\Entity\GroupRoleInterface|null $role */
    $role = $storage->load($role_id);
    if (!$role) {
      $logger->warning('Group role @id not found, skipping.', ['@id' => $role_id]);
      continue;
    }

    $changed = FALSE;

    if ($role->getScope() !== 'insider') {
      $role->set('scope', 'insider');
      $changed = TRUE;
    }

    if ($role->get('global_role') !== 'administrator') {
      $role->set('global_role', 'administrator');
      $changed = TRUE;
    }

    if ($changed) {
      $role->save();
      $logger->info('Updated @id: scope=insider, global_role=administrator.', [
        '@id' => $role_id,
      ]);
    }
  }
}

/**
 * Add field_service_categories to org groups and delete obsolete ECA rules.
 *
 * Creates a multi-value entity reference field on org groups that maps each
 * organisation to the service categories it handles. This enables
 * jurisdiction-aware org derivation: when a request is created in a child
 * jurisdiction (e.g. Noord), the system first checks for an org in that
 * jurisdiction handling the category before falling back to the root-level org.
 *
 * Also deletes the ECA rules process_apply_jurisdiction and process_apply_group
 * which were only disabled in 11900 but still fired on cascading entity events.
 */
function markaspot_group_update_11903(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_group');
  $config = \Drupal::configFactory()->get('markaspot_open311.settings');
  $org_type = $config->get('group_filter_type') ?? 'org';

  // 1. Create field storage if it does not exist.
  $storage_id = 'group.field_service_categories';
  $field_storage = $etm->getStorage('field_storage_config')->load($storage_id);

  if (!$field_storage) {
    $field_storage = $etm->getStorage('field_storage_config')->create([
      'field_name' => 'field_service_categories',
      'entity_type' => 'group',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'taxonomy_term'],
      'cardinality' => -1,
    ]);
    $field_storage->save();
    $logger->info('Created field storage group.field_service_categories.');
  }

  // 2. Create field instance on org bundle.
  $field_id = "group.{$org_type}.field_service_categories";
  $field_config = $etm->getStorage('field_config')->load($field_id);

  if (!$field_config) {
    $field_config = $etm->getStorage('field_config')->create([
      'field_storage' => $field_storage,
      'bundle' => $org_type,
      'label' => 'Service Categories',
      'description' => 'The service categories this organisation handles. Used for jurisdiction-aware org derivation.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => ['service_category' => 'service_category'],
          'sort' => ['field' => 'name', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ]);
    $field_config->save();
    $logger->info('Created field instance @id.', ['@id' => $field_id]);
  }

  // 3. Add field to org form display.
  $form_display = $etm->getStorage('entity_form_display')
    ->load("group.{$org_type}.default");

  if ($form_display) {
    $form_display->setComponent('field_service_categories', [
      'type' => 'entity_reference_autocomplete',
      'weight' => 6,
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
    ]);
    $form_display->save();
  }

  // 4. Delete obsolete ECA rules (disabling alone is insufficient due to
  // cascading entity event bug where disabled ECA models still execute).
  // ECA is an optional, module-gated module (absent on some tenants, e.g.
  // FastMap tiers). getStorage('eca') throws on a missing entity type and would
  // abort updb there; nothing to clean up without the module, so skip step 4.
  // This is the last step of the hook, so an early return is safe.
  if (!\Drupal::entityTypeManager()->hasDefinition('eca')) {
    return;
  }
  $eca_rules = [
    'process_apply_jurisdiction',
    'process_apply_group',
  ];
  $eca_storage = $etm->getStorage('eca');
  foreach ($eca_rules as $eca_id) {
    // Log full config data before deletion for recovery purposes.
    $raw_config = \Drupal::configFactory()->getEditable("eca.eca.{$eca_id}");
    if (!$raw_config->isNew()) {
      $logger->notice('Pre-deletion backup of @name: @data', [
        '@name' => "eca.eca.{$eca_id}",
        '@data' => json_encode($raw_config->getRawData()),
      ]);
    }
    $eca = $eca_storage->load($eca_id);
    if ($eca) {
      $eca->delete();
      $logger->info('Deleted obsolete ECA rule @id.', ['@id' => $eca_id]);
    }
    elseif (!$raw_config->isNew()) {
      // Entity load failed but raw config exists: clean up directly.
      $raw_config->delete();
    }
  }
}

/**
 * Add group relationship for pages and field_jurisdiction on page nodes.
 *
 * Makes pages jurisdiction-aware so each tenant can have its own welcome
 * content and info pages. Creates field_jurisdiction on page nodes,
 * the jur-group_node-page relationship type, and assigns existing promoted
 * pages to the root jurisdiction.
 */
function markaspot_group_update_11904(): void {
  $etm = \Drupal::entityTypeManager();
  $config = \Drupal::configFactory()->get('markaspot_open311.settings');
  $logger = \Drupal::logger('markaspot_group');

  $jur_type = $config->get('jurisdiction_group_type') ?? 'jur';

  // 1. Create field storage for node.field_jurisdiction if it does not exist.
  $storage_id = 'node.field_jurisdiction';
  $field_storage = $etm->getStorage('field_storage_config')->load($storage_id);

  if (!$field_storage) {
    $field_storage = $etm->getStorage('field_storage_config')->create([
      'field_name' => 'field_jurisdiction',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'group',
      ],
      'cardinality' => -1,
    ]);
    $field_storage->save();
    $logger->info('Created field storage node.field_jurisdiction.');
  }
  elseif ($field_storage->getCardinality() === 1) {
    // Upgrade: allow multiple jurisdictions per page.
    $field_storage->setCardinality(-1);
    $field_storage->save();
    $logger->info('Updated node.field_jurisdiction cardinality to unlimited.');
  }

  // 2. Create field instance on the page bundle.
  $field_id = 'node.page.field_jurisdiction';
  $field_config = $etm->getStorage('field_config')->load($field_id);

  if (!$field_config) {
    $field_config = $etm->getStorage('field_config')->create([
      'field_storage' => $field_storage,
      'bundle' => 'page',
      'label' => 'Jurisdiction',
      'description' => 'The jurisdiction this page belongs to.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => [$jur_type => $jur_type],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ]);
    $field_config->save();
    $logger->info('Created field instance node.page.field_jurisdiction.');
  }

  // 3. Create group relationship type jur-group_node-page.
  $relationship_type_id = 'jur-group_node-page';
  $existing = $etm->getStorage('group_relationship_type')->load($relationship_type_id);

  if (!$existing) {
    $relationship_type = $etm->getStorage('group_relationship_type')->create([
      'id' => $relationship_type_id,
      'group_type' => $jur_type,
      'content_plugin' => 'group_node:page',
      'plugin_config' => [
        'group_cardinality' => 0,
        'entity_cardinality' => 0,
        'use_creation_wizard' => FALSE,
      ],
    ]);
    $relationship_type->save();
    $logger->info('Created group relationship type @id.', ['@id' => $relationship_type_id]);
  }
  else {
    // Upgrade: allow pages in multiple jurisdictions.
    $plugin_config = $existing->get('plugin_config');
    if (($plugin_config['entity_cardinality'] ?? 0) === 1) {
      $plugin_config['entity_cardinality'] = 0;
      $existing->set('plugin_config', $plugin_config);
      $existing->save();
      $logger->info('Updated @id entity_cardinality to unlimited.', ['@id' => $relationship_type_id]);
    }
  }

  // 4. Find root jurisdiction and assign promoted pages.
  $group_storage = $etm->getStorage('group');

  $has_parent_field = $etm->getStorage('field_config')
    ->load("group.{$jur_type}.field_parent_jurisdiction") !== NULL;

  if ($has_parent_field) {
    $root_jur_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', $jur_type)
      ->notExists('field_parent_jurisdiction')
      ->execute();
  }
  else {
    $root_jur_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', $jur_type)
      ->execute();
  }

  if (empty($root_jur_ids)) {
    $logger->warning('No root jurisdiction group found. Skipping page assignment.');
    return;
  }

  if (count($root_jur_ids) > 1) {
    $logger->warning(
      'Multiple root jurisdictions found (@count). Skipping automatic page assignment.',
      ['@count' => count($root_jur_ids)]
    );
    return;
  }

  $root_jur_id = (int) reset($root_jur_ids);
  $root_jur = $group_storage->load($root_jur_id);

  // Find promoted page nodes.
  $page_nids = $etm->getStorage('node')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'page')
    ->condition('promote', 1)
    ->sort('nid', 'ASC')
    ->execute();

  if (empty($page_nids)) {
    $logger->info('No promoted pages found to assign.');
    return;
  }

  $pages = $etm->getStorage('node')->loadMultiple($page_nids);
  $plugin_id = 'group_node:page';
  $assigned = 0;
  $first_page = NULL;

  foreach ($pages as $page) {
    if ($first_page === NULL) {
      $first_page = $page;
    }

    // Set field_jurisdiction on the page node.
    if ($page->hasField('field_jurisdiction') && $page->get('field_jurisdiction')->isEmpty()) {
      $page->set('field_jurisdiction', ['target_id' => $root_jur_id]);
      $page->save();
    }

    // Create group relationship (skip if already exists).
    $existing = $root_jur->getRelationshipsByEntity($page, $plugin_id);
    if (empty($existing)) {
      try {
        $root_jur->addRelationship($page, $plugin_id);
        $assigned++;
      }
      catch (\Exception $e) {
        $logger->error('Failed to add page @nid to jur group: @msg', [
          '@nid' => $page->id(),
          '@msg' => $e->getMessage(),
        ]);
      }
    }
  }

  $logger->info('Assigned @count pages to root jurisdiction "@name".', [
    '@count' => $assigned,
    '@name' => $root_jur->label(),
  ]);

  // 5. Set the first page as sticky (welcome/landing page).
  // Only if no page is already sticky (respect existing admin choices).
  $existing_sticky = $etm->getStorage('node')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'page')
    ->condition('sticky', 1)
    ->range(0, 1)
    ->execute();

  if (empty($existing_sticky) && $first_page) {
    $first_page->set('sticky', 1);
    $first_page->save();
    $logger->info('Set page "@title" (nid=@nid) as sticky.', [
      '@title' => $first_page->label(),
      '@nid' => $first_page->id(),
    ]);
  }

  // 5b. Migrate mas_custom block body into the sticky welcome page.
  // For existing installations, the mas_custom block holds the welcome content
  // that should now live in the sticky page.
  $sticky_nids = $existing_sticky ?: ($first_page ? [$first_page->id()] : []);
  if (!empty($sticky_nids)) {
    $sticky_page = $etm->getStorage('node')->load(reset($sticky_nids));
    $mas_custom_blocks = $etm->getStorage('block_content')
      ->loadByProperties(['type' => 'mas_custom']);

    if (!empty($mas_custom_blocks)) {
      $mas_block = reset($mas_custom_blocks);
      $block_body = $mas_block->get('body')->value ?? '';

      if (!empty($block_body) && $sticky_page) {
        // Migrate default language.
        $sticky_page->set('title', 'Welcome');
        $sticky_page->set('body', [
          'value' => $block_body,
          'format' => $mas_block->get('body')->format ?? 'full_html',
        ]);
        $sticky_page->save();

        // Migrate translations.
        foreach ($mas_block->getTranslationLanguages() as $langcode => $lang) {
          if ($langcode === $sticky_page->language()->getId()) {
            continue;
          }
          $block_trans = $mas_block->getTranslation($langcode);
          $trans_body = $block_trans->get('body')->value ?? '';
          if (empty($trans_body)) {
            continue;
          }
          $page_trans = $sticky_page->hasTranslation($langcode)
            ? $sticky_page->getTranslation($langcode)
            : $sticky_page->addTranslation($langcode);
          $page_trans->set('title', 'Welcome');
          $page_trans->set('body', [
            'value' => $trans_body,
            'format' => $block_trans->get('body')->format ?? 'full_html',
          ]);
          $page_trans->save();
        }

        $logger->info('Migrated mas_custom block body (+ @count translations) into sticky page "@title" (nid=@nid).', [
          '@title' => $sticky_page->label(),
          '@nid' => $sticky_page->id(),
          '@count' => count($mas_block->getTranslationLanguages()) - 1,
        ]);
      }
    }
  }

  // 6. Add field_jurisdiction to the page form display.
  $form_display = $etm->getStorage('entity_form_display')
    ->load('node.page.default');

  if (!$form_display) {
    $form_display = $etm->getStorage('entity_form_display')->create([
      'targetEntityType' => 'node',
      'bundle' => 'page',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }

  $form_display->setComponent('field_jurisdiction', [
    'type' => 'entity_reference_autocomplete',
    'weight' => 4,
    'region' => 'content',
    'settings' => [
      'match_operator' => 'CONTAINS',
      'match_limit' => 10,
      'size' => 60,
      'placeholder' => '',
    ],
  ]);
  $form_display->save();

  // 7. Update JSON:API resource config for node--page to include
  // field_jurisdiction.
  $jsonapi_config = \Drupal::configFactory()
    ->getEditable('jsonapi_extras.jsonapi_resource_config.node--page');

  if (!$jsonapi_config->isNew()) {
    $resource_fields = $jsonapi_config->get('resourceFields') ?? [];
    if (!isset($resource_fields['field_jurisdiction'])) {
      $resource_fields['field_jurisdiction'] = [
        'disabled' => FALSE,
        'fieldName' => 'field_jurisdiction',
        'publicName' => 'field_jurisdiction',
        'enhancer' => ['id' => ''],
      ];
      $jsonapi_config->set('resourceFields', $resource_fields)->save();
      $logger->info('Added field_jurisdiction to JSON:API node--page resource config.');
    }
  }
  else {
    $logger->notice('JSON:API resource config for node--page not found. field_jurisdiction will be available via default JSON:API config.');
  }

  // 8. Add page permissions to jur group roles.
  // Without these, group access control blocks anonymous page viewing.
  $role_storage = $etm->getStorage('group_role');
  $page_permissions = [
    "{$jur_type}-anonymous" => ['view group_node:page entity'],
    "{$jur_type}-outsider" => ['view group_node:page entity'],
    "{$jur_type}-moderator" => [
      'view group_node:page entity',
      'view group_node:page relationship',
    ],
    "{$jur_type}-member" => [
      'view group_node:page entity',
      'view group_node:page relationship',
      'create group_node:page entity',
      'update own group_node:page entity',
    ],
    "{$jur_type}-editorial" => [
      'view group_node:page entity',
      'view group_node:page relationship',
      'create group_node:page entity',
      'create group_node:page relationship',
      'update any group_node:page entity',
      'update own group_node:page entity',
      'delete any group_node:page entity',
    ],
    "{$jur_type}-tenant_admin" => [
      'view group_node:page entity',
      'view group_node:page relationship',
      'create group_node:page entity',
      'create group_node:page relationship',
      'update any group_node:page entity',
      'update own group_node:page entity',
      'delete any group_node:page entity',
    ],
    "{$jur_type}-admin" => [
      'view group_node:page entity',
      'view group_node:page relationship',
      'create group_node:page entity',
      'create group_node:page relationship',
      'update any group_node:page entity',
      'update own group_node:page entity',
      'delete any group_node:page entity',
      'delete own group_node:page entity',
    ],
  ];

  foreach ($page_permissions as $role_id => $new_perms) {
    $role = $role_storage->load($role_id);
    if (!$role) {
      continue;
    }
    $existing = $role->getPermissions();
    $added = 0;
    foreach ($new_perms as $perm) {
      if (!in_array($perm, $existing)) {
        $existing[] = $perm;
        $added++;
      }
    }
    if ($added > 0) {
      $role->set('permissions', $existing);
      $role->save();
      $logger->info('Added @count page permissions to @role.', [
        '@count' => $added,
        '@role' => $role_id,
      ]);
    }
  }
}

/**
 * Add jurisdiction metadata fields and field_jurisdiction on service_request.
 *
 * Phase 1: Creates field_platform_name and field_email_footer on jur groups.
 * Phase 2: Creates field_jurisdiction instance on service_request nodes.
 * Phase 3: Installs markaspot_group.settings config.
 * Phase 4: Backfills field_jurisdiction on existing service_requests.
 * Phase 5: Populates field_platform_name from field_nuxt_config JSON.
 */
function markaspot_group_update_11905(array &$sandbox): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_group');
  $config_factory = \Drupal::configFactory();

  // Read group type names from config (consistent with earlier update hooks).
  $o311_config = $config_factory->get('markaspot_open311.settings');
  $jur_type = $o311_config->get('jurisdiction_group_type') ?? 'jur';

  // Initialize sandbox on first call.
  if (!isset($sandbox['phase'])) {
    $sandbox['phase'] = 'fields';
  }

  // --- Phase: fields (create new fields, config, form displays) ---
  if ($sandbox['phase'] === 'fields') {

    // 1. field_platform_name on jur groups.
    $storage_id = 'group.field_platform_name';
    $field_storage = $etm->getStorage('field_storage_config')->load($storage_id);
    if (!$field_storage) {
      $field_storage = $etm->getStorage('field_storage_config')->create([
        'field_name' => 'field_platform_name',
        'entity_type' => 'group',
        'type' => 'string',
        'settings' => [
          'max_length' => 255,
          'is_ascii' => FALSE,
          'case_sensitive' => FALSE,
        ],
        'cardinality' => 1,
      ]);
      $field_storage->save();
      $logger->info('Created field storage group.field_platform_name.');
    }

    $field_id = "group.{$jur_type}.field_platform_name";
    if (!$etm->getStorage('field_config')->load($field_id)) {
      $etm->getStorage('field_config')->create([
        'field_storage' => $field_storage,
        'bundle' => $jur_type,
        'label' => 'Platform Name',
        'description' => 'Brand name for emails and UI (e.g. "Mängelmelder Bonn", "Mark-a-Spot").',
        'required' => FALSE,
        'translatable' => TRUE,
        'settings' => [],
      ])->save();
      $logger->info('Created field instance group.jur.field_platform_name.');
    }

    // 2. field_email_footer on jur groups.
    $storage_id = 'group.field_email_footer';
    $field_storage_footer = $etm->getStorage('field_storage_config')->load($storage_id);
    if (!$field_storage_footer) {
      $field_storage_footer = $etm->getStorage('field_storage_config')->create([
        'field_name' => 'field_email_footer',
        'entity_type' => 'group',
        'type' => 'string_long',
        'settings' => [],
        'cardinality' => 1,
      ]);
      $field_storage_footer->save();
      $logger->info('Created field storage group.field_email_footer.');
    }

    $field_id = "group.{$jur_type}.field_email_footer";
    if (!$etm->getStorage('field_config')->load($field_id)) {
      $etm->getStorage('field_config')->create([
        'field_storage' => $field_storage_footer,
        'bundle' => $jur_type,
        'label' => 'Email Footer',
        'description' => 'Closing text for citizen notification emails (e.g. "Your City Administration").',
        'required' => FALSE,
        'translatable' => TRUE,
        'settings' => [],
      ])->save();
      $logger->info('Created field instance group.jur.field_email_footer.');
    }

    // 3. Add new fields to jur form display.
    $form_display = $etm->getStorage('entity_form_display')
      ->load("group.{$jur_type}.default");
    if ($form_display) {
      if (!$form_display->getComponent('field_platform_name')) {
        $form_display->setComponent('field_platform_name', [
          'type' => 'string_textfield',
          'weight' => 22,
          'region' => 'content',
          'settings' => [
            'size' => 60,
            'placeholder' => 'e.g. Mängelmelder Bonn',
          ],
        ]);
      }
      if (!$form_display->getComponent('field_email_footer')) {
        $form_display->setComponent('field_email_footer', [
          'type' => 'string_textarea',
          'weight' => 23,
          'region' => 'content',
          'settings' => [
            'rows' => 3,
            'placeholder' => 'e.g. Your City Administration',
          ],
        ]);
      }
      $form_display->save();
      $logger->info('Added field_platform_name and field_email_footer to jur form display.');
    }

    // 4. field_jurisdiction instance on service_request.
    // Field storage already exists (created in update 11904 for pages).
    $sr_field_id = 'node.service_request.field_jurisdiction';
    if (!$etm->getStorage('field_config')->load($sr_field_id)) {
      $node_jur_storage = $etm->getStorage('field_storage_config')
        ->load('node.field_jurisdiction');
      if ($node_jur_storage) {
        $etm->getStorage('field_config')->create([
          'field_storage' => $node_jur_storage,
          'bundle' => 'service_request',
          'label' => 'Jurisdiction',
          'description' => 'The jurisdiction this service request belongs to. Set automatically on creation.',
          'required' => FALSE,
          'translatable' => FALSE,
          'settings' => [
            'handler' => 'default:group',
            'handler_settings' => [
              'target_bundles' => [$jur_type => $jur_type],
              'sort' => ['field' => 'label', 'direction' => 'ASC'],
              'auto_create' => FALSE,
            ],
          ],
        ])->save();
        $logger->info('Created field instance node.service_request.field_jurisdiction.');
      }
      else {
        $logger->warning('Field storage node.field_jurisdiction not found. Run update 11904 first.');
      }
    }

    // 5. Add field_jurisdiction to service_request form display.
    $sr_form_display = $etm->getStorage('entity_form_display')
      ->load('node.service_request.default');
    if ($sr_form_display && !$sr_form_display->getComponent('field_jurisdiction')) {
      $sr_form_display->setComponent('field_jurisdiction', [
        'type' => 'entity_reference_autocomplete',
        'weight' => 25,
        'region' => 'content',
        'settings' => [
          'match_operator' => 'CONTAINS',
          'match_limit' => 10,
          'size' => 60,
          'placeholder' => '',
        ],
      ]);
      $sr_form_display->save();
      $logger->info('Added field_jurisdiction to service_request form display.');
    }

    // 6. Update JSON:API resource config to expose field_jurisdiction.
    $jsonapi_config = $config_factory
      ->getEditable('jsonapi_extras.jsonapi_resource_config.node--service_request');
    if (!$jsonapi_config->isNew()) {
      $resource_fields = $jsonapi_config->get('resourceFields') ?? [];
      if (!isset($resource_fields['field_jurisdiction'])) {
        $resource_fields['field_jurisdiction'] = [
          'disabled' => FALSE,
          'fieldName' => 'field_jurisdiction',
          'publicName' => 'field_jurisdiction',
          'enhancer' => ['id' => ''],
        ];
        $jsonapi_config->set('resourceFields', $resource_fields)->save();
        $logger->info('Added field_jurisdiction to JSON:API node--service_request resource config.');
      }
    }

    // 7. Install markaspot_group.settings config if not present.
    $settings_config = $config_factory->getEditable('markaspot_group.settings');
    if ($settings_config->isNew()) {
      $settings_config->set('jurisdiction_field_strategy', 'most_specific')->save();
      $logger->info('Installed markaspot_group.settings with strategy=most_specific.');
    }

    // Move to backfill phase. Return to avoid cascading into next phase
    // within the same PHP request (prevents timeout on large datasets).
    $sandbox['phase'] = 'backfill_init';
    $sandbox['#finished'] = 0;
    return;
  }

  // --- Phase: backfill_init (count nodes to backfill) ---
  if ($sandbox['phase'] === 'backfill_init') {
    // Only store the count and a cursor (last processed NID), not all NIDs.
    // This keeps $sandbox small even for 70k+ nodes.
    $total = (int) $etm->getStorage('node')->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'service_request')
      ->notExists('field_jurisdiction')
      ->count()
      ->execute();

    $sandbox['backfill_total'] = $total;
    $sandbox['backfill_processed'] = 0;
    $sandbox['backfill_last_nid'] = 0;

    if ($total === 0) {
      $logger->info('No service requests need field_jurisdiction backfill.');
      $sandbox['phase'] = 'populate';
    }
    else {
      $logger->info('Starting field_jurisdiction backfill for @count service requests.', [
        '@count' => $total,
      ]);
      $sandbox['phase'] = 'backfill';
    }
  }

  // --- Phase: backfill (batch-fill field_jurisdiction) ---
  if ($sandbox['phase'] === 'backfill') {
    $batch_size = 50;
    $node_storage = $etm->getStorage('node');
    $relationship_storage = $etm->getStorage('group_relationship');

    // Cursor-based: query next batch starting after last processed NID.
    $nids = $node_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'service_request')
      ->notExists('field_jurisdiction')
      ->condition('nid', $sandbox['backfill_last_nid'], '>')
      ->sort('nid', 'ASC')
      ->range(0, $batch_size)
      ->execute();

    if (empty($nids)) {
      $logger->info('Backfill complete: processed @count service requests.', [
        '@count' => $sandbox['backfill_processed'],
      ]);
      $sandbox['phase'] = 'populate';
      $sandbox['#finished'] = 0;
      return;
    }
    else {
      $nodes = $node_storage->loadMultiple($nids);

      foreach ($nodes as $node) {
        $sandbox['backfill_last_nid'] = (int) $node->id();

        if (!$node->hasField('field_jurisdiction')) {
          $sandbox['backfill_processed']++;
          continue;
        }
        if (!$node->get('field_jurisdiction')->isEmpty()) {
          $sandbox['backfill_processed']++;
          continue;
        }

        // Find jur group relationships for this node.
        $jur_relationships = $relationship_storage->loadByProperties([
          'entity_id' => $node->id(),
          'plugin_id' => 'group_node:service_request',
        ]);

        // Collect all child jur IDs from relationships.
        $child_jur_ids = [];
        foreach ($jur_relationships as $rel) {
          $group = $rel->getGroup();
          if ($group && $group->bundle() === $jur_type) {
            if ($group->hasField('field_parent_jurisdiction')
                && !$group->get('field_parent_jurisdiction')->isEmpty()) {
              $child_jur_ids[] = (int) $group->id();
            }
          }
        }

        // Find the deepest child (not referenced as parent by another match).
        $child_jur_id = FALSE;
        if (count($child_jur_ids) === 1) {
          $child_jur_id = $child_jur_ids[0];
        }
        elseif (count($child_jur_ids) > 1) {
          $child_groups = $etm->getStorage('group')->loadMultiple($child_jur_ids);
          $parent_ids_in_set = [];
          foreach ($child_groups as $cg) {
            if ($cg->hasField('field_parent_jurisdiction') && !$cg->get('field_parent_jurisdiction')->isEmpty()) {
              $parent_ids_in_set[(int) $cg->get('field_parent_jurisdiction')->target_id] = TRUE;
            }
          }
          foreach ($child_jur_ids as $cid) {
            if (!isset($parent_ids_in_set[$cid])) {
              $child_jur_id = $cid;
              break;
            }
          }
          if ($child_jur_id === FALSE) {
            $child_jur_id = $child_jur_ids[0];
          }
        }

        // Use the helper function to set field_jurisdiction.
        if (_markaspot_group_set_jurisdiction_field($node, $child_jur_id)) {
          _markaspot_group_set_syncing(TRUE);
          try {
            $node->save();
          }
          finally {
            _markaspot_group_set_syncing(FALSE);
          }
        }

        $sandbox['backfill_processed']++;
      }

      // Free memory between batches.
      $node_storage->resetCache(array_values($nids));
      $relationship_storage->resetCache();
    }
  }

  // --- Phase: populate (fill field_platform_name from field_nuxt_config) ---
  if ($sandbox['phase'] === 'populate') {
    $group_storage = $etm->getStorage('group');
    $jur_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', $jur_type)
      ->execute();

    $populated = 0;
    foreach ($group_storage->loadMultiple($jur_ids) as $jur) {
      // Populate field_platform_name from field_nuxt_config JSON.
      if ($jur->hasField('field_platform_name')
          && $jur->get('field_platform_name')->isEmpty()
          && $jur->hasField('field_nuxt_config')
          && !$jur->get('field_nuxt_config')->isEmpty()) {
        $json = $jur->get('field_nuxt_config')->value;
        $config_data = json_decode($json, TRUE);
        $client_name = $config_data['client']['name'] ?? NULL;
        if ($client_name) {
          $jur->set('field_platform_name', $client_name);
          $jur->save();
          $populated++;
          $logger->info('Set field_platform_name on jur "@label" to "@name" (from field_nuxt_config).', [
            '@label' => $jur->label(),
            '@name' => $client_name,
          ]);
        }
      }
    }

    if ($populated > 0) {
      $logger->info('Populated field_platform_name on @count jur groups from field_nuxt_config.', [
        '@count' => $populated,
      ]);
    }

    $sandbox['phase'] = 'done';
  }

  // Calculate progress.
  if ($sandbox['phase'] === 'done') {
    $sandbox['#finished'] = 1;
  }
  elseif ($sandbox['phase'] === 'backfill' && ($sandbox['backfill_total'] ?? 0) > 0) {
    $sandbox['#finished'] = $sandbox['backfill_processed'] / $sandbox['backfill_total'];
  }
  else {
    // Still in field creation or populate phase.
    $sandbox['#finished'] = 0;
  }
}

/**
 * Grant tenant_admin role field permissions and escalation access.
 *
 * Tenant admins need field-level permissions to manage service requests via
 * the dashboard API. Without these, PATCH requests for custom-permission
 * fields like field_status or field_priority silently fail.
 *
 * Also grants escalation and delegation permissions so tenant admins can
 * route requests within their jurisdiction hierarchy.
 */
function markaspot_group_update_11906(): void {
  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('tenant_admin');
  if (!$role) {
    \Drupal::logger('markaspot_group')->notice('Role tenant_admin not found, skipping permission update.');
    return;
  }

  // Field permissions: fields a tenant admin needs to view and edit
  // via the dashboard API within their jurisdiction scope.
  $managed_fields = [
    'field_status',
    'field_priority',
    'field_internal_remark',
    'field_notes',
    'field_escalation',
    'field_address',
    'field_e_mail',
    'field_status_notes',
    'field_status_note',
    'field_request_media',
    'field_approved',
    'field_attachment',
  ];

  $all_perms = \Drupal::service('user.permissions')->getPermissions();
  $granted = [];
  foreach ($managed_fields as $field_name) {
    $ops = [
      "create $field_name",
      "edit $field_name",
      "edit own $field_name",
      "view $field_name",
      "view own $field_name",
    ];
    foreach ($ops as $perm) {
      // Only grant if the permission actually exists (field might not be
      // installed on all sites).
      if (isset($all_perms[$perm]) && !$role->hasPermission($perm)) {
        $role->grantPermission($perm);
        $granted[] = $perm;
      }
    }
  }

  // Escalation and delegation permissions.
  $workflow_perms = [
    'escalate service requests',
    'delegate service requests',
    'access open311 advanced properties',
  ];
  foreach ($workflow_perms as $perm) {
    if (isset($all_perms[$perm]) && !$role->hasPermission($perm)) {
      $role->grantPermission($perm);
      $granted[] = $perm;
    }
  }

  if (!empty($granted)) {
    $role->save();
    \Drupal::logger('markaspot_group')->notice(
      'Granted @count permissions to tenant_admin: @perms',
      ['@count' => count($granted), '@perms' => implode(', ', $granted)]
    );
  }
  else {
    \Drupal::logger('markaspot_group')->notice('tenant_admin already has all required permissions.');
  }
}

/**
 * Ensure jur/org group types and all required fields exist.
 *
 * Reconciliation hook for sites upgrading from 11.7.x or earlier where:
 * - markaspot_group was added to core.extension via SQL bypass (config/install
 *   never ran, so group types and fields are missing)
 * - Earlier update hooks (11903-11905) failed because jur/org types did not
 *   exist yet
 * - field_nuxt_config and field_boundary were only in config/install YMLs,
 *   never created by any update hook.
 *
 * This hook is idempotent: it checks each entity before creating.
 */
function markaspot_group_update_11907(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_group');
  $config_factory = \Drupal::configFactory();

  // --- 1. Ensure jur group type exists ---
  $jur_type = $etm->getStorage('group_type')->load('jur');
  if (!$jur_type) {
    $jur_type = $etm->getStorage('group_type')->create([
      'id' => 'jur',
      'label' => 'Jurisdiction',
      'description' => 'A jurisdiction group for multi-tenant setups.',
      'creator_membership' => TRUE,
      'creator_wizard' => FALSE,
    ]);
    $jur_type->save();
    $logger->info('Created group type: jur');
  }

  // --- 2. Ensure org group type exists ---
  $org_type = $etm->getStorage('group_type')->load('org');
  if (!$org_type) {
    $org_type = $etm->getStorage('group_type')->create([
      'id' => 'org',
      'label' => 'Organisation',
      'description' => 'An organisation group.',
      'creator_membership' => TRUE,
      'creator_wizard' => FALSE,
    ]);
    $org_type->save();
    $logger->info('Created group type: org');
  }

  // --- 3. Ensure all jur field storages exist ---
  $fsc = $etm->getStorage('field_storage_config');

  $storages = [
    'field_nuxt_config' => [
      'field_name' => 'field_nuxt_config',
      'entity_type' => 'group',
      'type' => 'text_long',
      'module' => 'text',
      'cardinality' => 1,
    ],
    'field_boundary' => [
      'field_name' => 'field_boundary',
      'entity_type' => 'group',
      'type' => 'text_long',
      'module' => 'text',
      'cardinality' => 1,
    ],
    'field_custom_css' => [
      'field_name' => 'field_custom_css',
      'entity_type' => 'group',
      'type' => 'text_long',
      'module' => 'text',
      'cardinality' => 1,
    ],
    'field_slug' => [
      'field_name' => 'field_slug',
      'entity_type' => 'group',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => ['max_length' => 64],
    ],
    'field_logo_dark' => [
      'field_name' => 'field_logo_dark',
      'entity_type' => 'group',
      'type' => 'image',
      'cardinality' => 1,
      'settings' => [
        'uri_scheme' => 'public',
        'default_image' => ['uuid' => NULL, 'alt' => '', 'title' => '', 'width' => NULL, 'height' => NULL],
        'target_type' => 'file',
      ],
    ],
    'field_logo_light' => [
      'field_name' => 'field_logo_light',
      'entity_type' => 'group',
      'type' => 'image',
      'cardinality' => 1,
      'settings' => [
        'uri_scheme' => 'public',
        'default_image' => ['uuid' => NULL, 'alt' => '', 'title' => '', 'width' => NULL, 'height' => NULL],
        'target_type' => 'file',
      ],
    ],
    'field_font_body' => [
      'field_name' => 'field_font_body',
      'entity_type' => 'group',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => ['max_length' => 255],
    ],
    'field_font_heading' => [
      'field_name' => 'field_font_heading',
      'entity_type' => 'group',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => ['max_length' => 255],
    ],
    'field_parent_jurisdiction' => [
      'field_name' => 'field_parent_jurisdiction',
      'entity_type' => 'group',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'group'],
      'cardinality' => 1,
    ],
  ];

  foreach ($storages as $name => $definition) {
    if (!$fsc->load('group.' . $name)) {
      $fsc->create($definition)->save();
      $logger->info('Created field storage: group.@name', ['@name' => $name]);
    }
  }

  // --- 4. Ensure all jur field instances exist ---
  $fc = $etm->getStorage('field_config');

  $fields = [
    'field_nuxt_config' => [
      'label' => 'Nuxt Configuration',
      'description' => 'JSON configuration for jurisdiction-specific Nuxt frontend settings (theme, features, map center, etc.)',
      'required' => FALSE,
      'translatable' => FALSE,
    ],
    'field_boundary' => [
      'label' => 'Boundary',
      'description' => 'GeoJSON boundary polygon for this jurisdiction. Used for map display and validation.',
      'required' => FALSE,
      'translatable' => FALSE,
    ],
    'field_custom_css' => [
      'label' => 'Custom CSS',
      'description' => 'Custom CSS for this jurisdiction.',
      'required' => FALSE,
    ],
    'field_slug' => [
      'label' => 'URL Slug',
      'description' => 'Short identifier for URLs (e.g., "bonn", "koeln")',
      'required' => FALSE,
    ],
    'field_logo_dark' => [
      'label' => 'Logo (Dark Mode)',
      'required' => FALSE,
    ],
    'field_logo_light' => [
      'label' => 'Logo (Light Mode)',
      'required' => FALSE,
    ],
    'field_font_body' => [
      'label' => 'Body Font',
      'description' => 'Font family for body text',
      'required' => FALSE,
    ],
    'field_font_heading' => [
      'label' => 'Heading Font',
      'description' => 'Font family for headings',
      'required' => FALSE,
    ],
    'field_parent_jurisdiction' => [
      'label' => 'Parent Jurisdiction',
      'description' => 'The parent jurisdiction in a hierarchy.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => ['jur' => 'jur'],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ],
  ];

  foreach ($fields as $name => $definition) {
    $field_id = 'group.jur.' . $name;
    if (!$fc->load($field_id)) {
      $storage = $fsc->load('group.' . $name);
      if ($storage) {
        $definition['field_storage'] = $storage;
        $definition['bundle'] = 'jur';
        $definition['entity_type'] = 'group';
        $definition['field_name'] = $name;
        $fc->create($definition)->save();
        $logger->info('Created field instance: @id', ['@id' => $field_id]);
      }
    }
  }

  // --- 5. Ensure jur form display has all fields ---
  $form_display = $etm->getStorage('entity_form_display')
    ->load('group.jur.default');
  if (!$form_display) {
    $form_display = $etm->getStorage('entity_form_display')->create([
      'targetEntityType' => 'group',
      'bundle' => 'jur',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }

  // nuxt_config_json_form extends json_form_widget's base class; fall back to a
  // plain textarea on tenants where json_form_widget is not enabled so saving
  // the jur form display does not abort the update with "plugin does not exist".
  $nuxt_config_widget = \Drupal::service('plugin.manager.field.widget')
    ->hasDefinition('nuxt_config_json_form') ? 'nuxt_config_json_form' : 'text_textarea';

  $display_components = [
    'field_slug' => [
      'type' => 'string_textfield',
      'weight' => 1,
      'region' => 'content',
      'settings' => [
        'size' => 60,
        'placeholder' => 'stadt-osnabrueck',
      ],
    ],
    'field_parent_jurisdiction' => [
      'type' => 'entity_reference_autocomplete',
      'weight' => 2,
      'region' => 'content',
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
    ],
    'field_logo_light' => [
      'type' => 'file_generic',
      'weight' => 3,
      'region' => 'content',
      'settings' => ['progress_indicator' => 'throbber'],
    ],
    'field_logo_dark' => [
      'type' => 'file_generic',
      'weight' => 4,
      'region' => 'content',
      'settings' => ['progress_indicator' => 'throbber'],
    ],
    'field_custom_css' => [
      'type' => 'text_textarea',
      'weight' => 5,
      'region' => 'content',
      'settings' => [
        'rows' => 5,
        'placeholder' => '',
      ],
    ],
    'field_nuxt_config' => [
      'type' => $nuxt_config_widget,
      'weight' => 6,
      'region' => 'content',
      'settings' => [],
    ],
    'field_boundary' => [
      'type' => 'text_textarea',
      'weight' => 7,
      'region' => 'content',
      'settings' => [
        'rows' => 5,
        'placeholder' => 'GeoJSON FeatureCollection',
      ],
    ],
    'field_font_heading' => [
      'type' => 'file_generic',
      'weight' => 10,
      'region' => 'content',
      'settings' => ['progress_indicator' => 'throbber'],
    ],
    'field_font_body' => [
      'type' => 'file_generic',
      'weight' => 11,
      'region' => 'content',
      'settings' => ['progress_indicator' => 'throbber'],
    ],
  ];

  foreach ($display_components as $field_name => $component) {
    if (!$form_display->getComponent($field_name) && $fc->load('group.jur.' . $field_name)) {
      $form_display->setComponent($field_name, $component);
    }
  }
  $form_display->save();

  // --- 6. Ensure jur group roles exist ---
  $role_storage = $etm->getStorage('group_role');
  $roles = [
    'jur-anonymous' => [
      'label' => 'Anonymous',
      'scope' => 'outsider',
      'global_role' => 'anonymous',
      'permissions' => [
        'view group',
        'view group_node:service_request entity',
      ],
    ],
    'jur-outsider' => [
      'label' => 'Outsider',
      'scope' => 'outsider',
      'global_role' => 'authenticated',
      'permissions' => [
        'view group',
        'view group_node:service_request entity',
      ],
    ],
    'jur-member' => [
      'label' => 'Member',
      'scope' => 'individual',
      'permissions' => [
        'view group',
        'view group_node:service_request entity',
      ],
    ],
    'jur-moderator' => [
      'label' => 'Moderator',
      'scope' => 'individual',
      'permissions' => [
        'view group',
        'view group_node:service_request entity',
        'update any group_node:service_request entity',
      ],
    ],
    'jur-editorial' => [
      'label' => 'Editorial',
      'scope' => 'individual',
      'permissions' => [
        'view group',
        'view group_node:service_request entity',
        'update any group_node:service_request entity',
      ],
    ],
    'jur-admin' => [
      'label' => 'Admin',
      'scope' => 'insider',
      'global_role' => 'administrator',
      'permissions' => [
        'administer group',
        'view group',
        'edit group',
        'delete group',
      ],
    ],
  ];

  foreach ($roles as $role_id => $role_def) {
    if (!$role_storage->load($role_id)) {
      $role_data = [
        'id' => $role_id,
        'label' => $role_def['label'],
        'group_type' => 'jur',
        'scope' => $role_def['scope'],
        'permissions' => $role_def['permissions'],
      ];
      if (isset($role_def['global_role'])) {
        $role_data['global_role'] = $role_def['global_role'];
      }
      $role_storage->create($role_data)->save();
      $logger->info('Created group role: @id', ['@id' => $role_id]);
    }
  }

  // --- 7. Ensure gnode module + group_roles field storage ---
  // gnode provides group_node:* plugins needed for relationship types.
  // group_roles field storage is needed by PostInstall handler for memberships.
  if (!\Drupal::moduleHandler()->moduleExists('gnode')) {
    \Drupal::service('module_installer')->install(['gnode']);
    $logger->info('Enabled gnode module.');
  }

  $group_roles_storage = $etm->getStorage('field_storage_config')
    ->load('group_relationship.group_roles');
  if (!$group_roles_storage) {
    $etm->getStorage('field_storage_config')->create([
      'field_name' => 'group_roles',
      'entity_type' => 'group_relationship',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'group_role'],
      'cardinality' => -1,
      'translatable' => FALSE,
    ])->save();
    $logger->info('Created group_relationship.group_roles field storage.');
  }

  // --- 8. Ensure jur relationship types exist ---
  $rel_storage = $etm->getStorage('group_relationship_type');

  $relationships = [
    'jur-group_membership' => ['content_plugin' => 'group_membership'],
    'jur-group_node-service_request' => ['content_plugin' => 'group_node:service_request'],
    'jur-group_node-page' => ['content_plugin' => 'group_node:page'],
  ];

  foreach ($relationships as $rel_id => $rel_def) {
    if (!$rel_storage->load($rel_id)) {
      $rel_storage->create([
        'id' => $rel_id,
        'group_type' => 'jur',
        'content_plugin' => $rel_def['content_plugin'],
        'plugin_config' => [
          'group_cardinality' => 0,
          'entity_cardinality' => 0,
          'use_creation_wizard' => FALSE,
        ],
      ])->save();
      $logger->info('Created relationship type: @id', ['@id' => $rel_id]);
    }
  }

  // --- 8b. Ensure group_roles field instance on jur-group_membership ---
  // GroupMembershipPostInstall handler doesn't fire for programmatically
  // created relationship types, so we create the instance manually.
  $fc = $etm->getStorage('field_config');
  if (!$fc->load('group_relationship.jur-group_membership.group_roles')) {
    $roles_storage = $etm->getStorage('field_storage_config')
      ->load('group_relationship.group_roles');
    if ($roles_storage) {
      $fc->create([
        'field_storage' => $roles_storage,
        'bundle' => 'jur-group_membership',
        'label' => 'Roles',
        'required' => FALSE,
        'settings' => [
          'handler' => 'default:group_role',
          'handler_settings' => [
            'sort' => ['field' => 'label', 'direction' => 'ASC'],
          ],
        ],
      ])->save();
      $logger->info('Created group_roles field instance on jur-group_membership.');
    }
  }

  // --- 9. Create default jurisdiction group if none exists ---
  $group_storage = $etm->getStorage('group');
  $existing = $group_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'jur')
    ->count()
    ->execute();

  if ((int) $existing === 0) {
    if (function_exists('_markaspot_create_default_jurisdiction')) {
      $group = _markaspot_create_default_jurisdiction('jur', $group_storage);
      if ($group) {
        $logger->info('Created default jurisdiction: "@label" (id=@id).', [
          '@label' => $group->label(),
          '@id' => $group->id(),
        ]);
      }
    }
    else {
      // Fallback: create a basic jurisdiction from site name.
      $site_name = $config_factory->get('system.site')->get('name') ?: 'Default';
      $group = $group_storage->create([
        'type' => 'jur',
        'label' => $site_name,
        'uid' => 1,
      ]);
      $group->save();
      $logger->info('Created default jurisdiction: "@label" (id=@id).', [
        '@label' => $group->label(),
        '@id' => $group->id(),
      ]);
    }
  }

  $logger->info('Reconciliation complete: jur/org types and all fields ensured.');
}

/**
 * Create the markaspot_group_invitations table for member invitations.
 */

/**
 * Create markaspot_group_invitations table.
 */
function markaspot_group_update_11908(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('markaspot_group_invitations')) {
    return;
  }

  $table_schema = markaspot_group_schema()['markaspot_group_invitations'];
  $schema->createTable('markaspot_group_invitations', $table_schema);

  \Drupal::logger('markaspot_group')->info('Created markaspot_group_invitations table.');
}

/**
 * Rename Moderator role to Moderation, fix scope to individual.
 */
function markaspot_group_update_11909(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('group_role');
  $logger = \Drupal::logger('markaspot_group');

  $roles_to_fix = [
    'jur-moderator' => 'Moderation',
    'org-moderator' => 'Moderation',
  ];

  foreach ($roles_to_fix as $role_id => $new_label) {
    /** @var \Drupal\group\Entity\GroupRoleInterface|null $role */
    $role = $storage->load($role_id);
    if (!$role) {
      $logger->warning('Group role @id not found, skipping.', ['@id' => $role_id]);
      continue;
    }

    $changed = FALSE;

    // Rename label.
    if ($role->label() !== $new_label) {
      $role->set('label', $new_label);
      $changed = TRUE;
    }

    // Fix scope from outsider to individual.
    if ($role->getScope() !== 'individual') {
      $role->set('scope', 'individual');
      $role->set('global_role', NULL);
      $changed = TRUE;
    }

    if ($changed) {
      $role->save();
      $logger->info('Updated group role @id: label=@label, scope=individual.', [
        '@id' => $role_id,
        '@label' => $new_label,
      ]);
    }
  }
}

/**
 * Add field_service_categories to jur group type.
 *
 * Update_11903 created this field on the org bundle. The jur instance was
 * added to config/install later, so existing sites never received it.
 * Causes 409 on workspace creation ("Field field_service_categories unknown").
 */
function markaspot_group_update_11910(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_group');

  // 1. Ensure field storage exists.
  $storage_id = 'group.field_service_categories';
  $field_storage = $etm->getStorage('field_storage_config')->load($storage_id);
  if (!$field_storage) {
    $field_storage = $etm->getStorage('field_storage_config')->create([
      'field_name' => 'field_service_categories',
      'entity_type' => 'group',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'taxonomy_term'],
      'cardinality' => -1,
    ]);
    $field_storage->save();
    $logger->info('Created field storage group.field_service_categories.');
  }

  // 2. Create field instance on jur, if missing.
  $field_id = 'group.jur.field_service_categories';
  if ($etm->getStorage('field_config')->load($field_id)) {
    return;
  }

  $etm->getStorage('field_config')->create([
    'field_storage' => $field_storage,
    'bundle' => 'jur',
    'label' => 'Service Categories',
    'description' => 'Optional: Restrict visible categories for this child jurisdiction. Leave empty to inherit all from the parent.',
    'required' => FALSE,
    'translatable' => TRUE,
    'settings' => [
      'handler' => 'default:taxonomy_term',
      'handler_settings' => [
        'target_bundles' => ['service_category' => 'service_category'],
        'sort' => ['field' => 'name', 'direction' => 'ASC'],
        'auto_create' => FALSE,
      ],
    ],
  ])->save();
  $logger->info('Created field instance @id.', ['@id' => $field_id]);

  // 3. Add to jur form display.
  $form_display = $etm->getStorage('entity_form_display')
    ->load('group.jur.default');
  if ($form_display && !$form_display->getComponent('field_service_categories')) {
    $form_display->setComponent('field_service_categories', [
      'type' => 'entity_reference_autocomplete',
      'weight' => 15,
      'region' => 'content',
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
    ]);
    $form_display->save();
  }
}

/**
 * Add field_legal_notice and field_privacy_policy to jur group type.
 *
 * These text_long fields store jurisdiction-specific legal content:
 * - field_legal_notice: Additional legal info (supervisory authority, VAT ID, etc.)
 * - field_privacy_policy: Jurisdiction-specific privacy policy text.
 *
 * Both are translatable and optional, exposed to the frontend via the
 * settings API operator section.
 */
function markaspot_group_update_11911(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_group');

  $fields_to_create = [
    'field_legal_notice' => [
      'label' => 'Legal Notice',
      'description' => 'Additional legal information for this jurisdiction (supervisory authority, VAT ID, registration number, etc.)',
    ],
    'field_privacy_policy' => [
      'label' => 'Privacy Policy',
      'description' => 'Jurisdiction-specific privacy policy text. Displayed alongside the platform privacy policy.',
    ],
  ];

  foreach ($fields_to_create as $field_name => $field_def) {
    // 1. Create field storage if it does not exist.
    $storage_id = 'group.' . $field_name;
    $field_storage = $etm->getStorage('field_storage_config')->load($storage_id);
    if (!$field_storage) {
      $field_storage = $etm->getStorage('field_storage_config')->create([
        'field_name' => $field_name,
        'entity_type' => 'group',
        'type' => 'text_long',
        'module' => 'text',
        'cardinality' => 1,
      ]);
      $field_storage->save();
      $logger->info('Created field storage group.@name.', ['@name' => $field_name]);
    }

    // 2. Create field instance on jur bundle.
    $field_id = 'group.jur.' . $field_name;
    if (!$etm->getStorage('field_config')->load($field_id)) {
      $etm->getStorage('field_config')->create([
        'field_storage' => $field_storage,
        'bundle' => 'jur',
        'label' => $field_def['label'],
        'description' => $field_def['description'],
        'required' => FALSE,
        'translatable' => TRUE,
        'settings' => [
          'allowed_formats' => [],
        ],
      ])->save();
      $logger->info('Created field instance @id.', ['@id' => $field_id]);
    }
  }

  // 3. Add fields to jur form display.
  $form_display = $etm->getStorage('entity_form_display')
    ->load('group.jur.default');
  if ($form_display) {
    if (!$form_display->getComponent('field_legal_notice')) {
      $form_display->setComponent('field_legal_notice', [
        'type' => 'text_textarea',
        'weight' => 24,
        'region' => 'content',
        'settings' => [
          'rows' => 5,
          'placeholder' => '',
        ],
      ]);
    }
    if (!$form_display->getComponent('field_privacy_policy')) {
      $form_display->setComponent('field_privacy_policy', [
        'type' => 'text_textarea',
        'weight' => 25,
        'region' => 'content',
        'settings' => [
          'rows' => 5,
          'placeholder' => '',
        ],
      ]);
    }
    $form_display->save();
    $logger->info('Added field_legal_notice and field_privacy_policy to jur form display.');
  }
}

/**
 * Move jurisdiction address and email fields from markaspot_escalation.
 *
 * These fields belong on the group entity regardless of whether escalation
 * is enabled. On existing installations they were already created by
 * markaspot_escalation; this hook ensures they exist for sites that install
 * markaspot_group without markaspot_escalation.
 */
function markaspot_group_update_11912(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_group');

  // --- field_jurisdiction_e_mail (email, unlimited cardinality) ---
  $email_storage = $etm->getStorage('field_storage_config')
    ->load('group.field_jurisdiction_e_mail');
  if ($email_storage) {
    $logger->info('Field storage group.field_jurisdiction_e_mail already exists, no action needed.');
  }
  else {
    $email_storage = $etm->getStorage('field_storage_config')->create([
      'field_name' => 'field_jurisdiction_e_mail',
      'entity_type' => 'group',
      'type' => 'email',
      'module' => 'core',
      'cardinality' => -1,
    ]);
    $email_storage->save();
    $logger->info('Created field storage group.field_jurisdiction_e_mail.');
  }

  if (!$etm->getStorage('field_config')->load('group.jur.field_jurisdiction_e_mail')) {
    $etm->getStorage('field_config')->create([
      'field_storage' => $email_storage,
      'bundle' => 'jur',
      'label' => 'Jurisdiction Email',
      'description' => 'Contact email address(es) for this jurisdiction. Used for escalation notifications and correspondence.',
      'required' => FALSE,
      'translatable' => FALSE,
    ])->save();
    $logger->info('Created field instance group.jur.field_jurisdiction_e_mail.');
  }

  // --- field_jurisdiction_address (address, cardinality 1) ---
  $address_storage = $etm->getStorage('field_storage_config')
    ->load('group.field_jurisdiction_address');
  if ($address_storage) {
    $logger->info('Field storage group.field_jurisdiction_address already exists, no action needed.');
  }
  else {
    $address_storage = $etm->getStorage('field_storage_config')->create([
      'field_name' => 'field_jurisdiction_address',
      'entity_type' => 'group',
      'type' => 'address',
      'module' => 'address',
      'cardinality' => 1,
    ]);
    $address_storage->save();
    $logger->info('Created field storage group.field_jurisdiction_address.');
  }

  if (!$etm->getStorage('field_config')->load('group.jur.field_jurisdiction_address')) {
    $etm->getStorage('field_config')->create([
      'field_storage' => $address_storage,
      'bundle' => 'jur',
      'label' => 'Jurisdiction Address',
      'description' => 'Official address for this jurisdiction. Used in email signatures and correspondence.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [
        'available_countries' => [],
        'langcode_override' => '',
        'field_overrides' => [],
      ],
    ])->save();
    $logger->info('Created field instance group.jur.field_jurisdiction_address.');
  }

  // Add fields to jur form display if not already present.
  $form_display = $etm->getStorage('entity_form_display')
    ->load('group.jur.default');
  if ($form_display) {
    $changed = FALSE;
    if (!$form_display->getComponent('field_jurisdiction_e_mail')) {
      $form_display->setComponent('field_jurisdiction_e_mail', [
        'type' => 'email_default',
        'weight' => 20,
        'region' => 'content',
        'settings' => [
          'size' => 60,
          'placeholder' => '',
        ],
      ]);
      $changed = TRUE;
    }
    if (!$form_display->getComponent('field_jurisdiction_address')) {
      $form_display->setComponent('field_jurisdiction_address', [
        'type' => 'address_default',
        'weight' => 21,
        'region' => 'content',
        'settings' => [],
      ]);
      $changed = TRUE;
    }
    if ($changed) {
      $form_display->save();
      $logger->info('Added jurisdiction fields to jur form display.');
    }
  }
}

/**
 * Uninstall markaspot_tenant_admin, move functionality into markaspot_group.
 *
 * The tenant admin module's UI (taxonomy overview at /admin/tenant) is
 * obsolete because the Nuxt dashboard handles category/status management.
 * The access control hooks (role sync, query filter, term access) are now
 * in markaspot_group.
 */
/**
 * Add default_jurisdiction_id config key for multi-tenant fallback.
 */

/**
 * Backfill field_jurisdiction on orphaned entities.
 *
 * Assigns the root jurisdiction to taxonomy terms (service_category,
 * service_status), org groups, and nodes (page, boilerplate) that are
 * missing field_jurisdiction. Uses two strategies:
 *   1. Explicit: field_service_categories on groups maps categories.
 *   2. Fallback: orphaned entities go to the first root jurisdiction.
 *
 * Fixes fresh installs where the default content migration created
 * entities without jurisdiction references.
 */
function markaspot_group_update_11915(): string {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_group');
  $config = \Drupal::config('markaspot_open311.settings');
  $jur_type = $config->get('jurisdiction_group_type') ?? 'jur';

  // Load all jurisdiction groups.
  $groups = $etm->getStorage('group')->loadByProperties(['type' => $jur_type]);
  if (empty($groups)) {
    return 'No jurisdiction groups found. Nothing to backfill.';
  }

  // Safety: skip automatic backfill on multi-tenant instances to prevent
  // cross-tenant data reassignment. Manual review required instead.
  if (count($groups) > 1) {
    $logger->warning('update_11915: Multiple jurisdictions detected (@count). Skipping automatic backfill to prevent cross-tenant data reassignment. Run manual backfill per jurisdiction.', [
      '@count' => count($groups),
    ]);
    return 'Skipped: ' . count($groups) . ' jurisdictions found. Manual backfill required for multi-tenant environments.';
  }

  // Determine the root jurisdiction (lowest ID without a parent).
  $root_group = NULL;
  foreach ($groups as $group) {
    $has_parent = $group->hasField('field_parent_jurisdiction')
      && !$group->get('field_parent_jurisdiction')->isEmpty();
    if (!$has_parent) {
      $root_group = $group;
      break;
    }
  }
  if (!$root_group) {
    $root_group = reset($groups);
  }
  $root_id = $root_group->id();

  $counts = [
    'categories' => 0,
    'statuses' => 0,
    'pages' => 0,
    'boilerplates' => 0,
    'orgs' => 0,
  ];

  // --- 1. Backfill service_category terms via field_service_categories ---
  foreach ($groups as $group) {
    if ($group->hasField('field_service_categories') && !$group->get('field_service_categories')->isEmpty()) {
      foreach ($group->get('field_service_categories') as $item) {
        $term = $etm->getStorage('taxonomy_term')->load($item->target_id);
        if ($term && $term->hasField('field_jurisdiction') && $term->get('field_jurisdiction')->isEmpty()) {
          $term->set('field_jurisdiction', ['target_id' => $group->id()]);
          $term->save();
          $counts['categories']++;
          $logger->info('Set field_jurisdiction=%gid on category %tid (%name) via field_service_categories.', [
            '%gid' => $group->id(),
            '%tid' => $term->id(),
            '%name' => $term->label(),
          ]);
        }
      }
    }
  }

  // --- 2. Orphaned category terms -> root jurisdiction ---
  $orphan_cat_tids = $etm->getStorage('taxonomy_term')->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'service_category')
    ->notExists('field_jurisdiction')
    ->execute();
  if (!empty($orphan_cat_tids)) {
    foreach ($etm->getStorage('taxonomy_term')->loadMultiple($orphan_cat_tids) as $term) {
      if ($term->hasField('field_jurisdiction')) {
        $term->set('field_jurisdiction', ['target_id' => $root_id]);
        $term->save();
        $counts['categories']++;
        $logger->info('Set field_jurisdiction=%gid on orphan category %tid (%name).', [
          '%gid' => $root_id,
          '%tid' => $term->id(),
          '%name' => $term->label(),
        ]);
      }
    }
  }

  // --- 3. Orphaned status terms -> root jurisdiction ---
  $orphan_status_tids = $etm->getStorage('taxonomy_term')->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'service_status')
    ->notExists('field_jurisdiction')
    ->execute();
  if (!empty($orphan_status_tids)) {
    foreach ($etm->getStorage('taxonomy_term')->loadMultiple($orphan_status_tids) as $term) {
      if ($term->hasField('field_jurisdiction')) {
        $term->set('field_jurisdiction', ['target_id' => $root_id]);
        $term->save();
        $counts['statuses']++;
        $logger->info('Set field_jurisdiction=%gid on orphan status %tid (%name).', [
          '%gid' => $root_id,
          '%tid' => $term->id(),
          '%name' => $term->label(),
        ]);
      }
    }
  }

  // --- 4. Orphaned page nodes -> root jurisdiction ---
  $orphan_page_nids = $etm->getStorage('node')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'page')
    ->notExists('field_jurisdiction')
    ->execute();
  if (!empty($orphan_page_nids)) {
    foreach ($etm->getStorage('node')->loadMultiple($orphan_page_nids) as $node) {
      if ($node->hasField('field_jurisdiction')) {
        $node->set('field_jurisdiction', ['target_id' => $root_id]);
        $node->save();
        $counts['pages']++;
        $logger->info('Set field_jurisdiction=%gid on orphan page %nid (%title).', [
          '%gid' => $root_id,
          '%nid' => $node->id(),
          '%title' => $node->label(),
        ]);
      }
    }
  }

  // --- 5. Orphaned boilerplate nodes -> root jurisdiction ---
  $orphan_bp_nids = $etm->getStorage('node')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'boilerplate')
    ->notExists('field_jurisdiction')
    ->execute();
  if (!empty($orphan_bp_nids)) {
    foreach ($etm->getStorage('node')->loadMultiple($orphan_bp_nids) as $node) {
      if ($node->hasField('field_jurisdiction')) {
        $node->set('field_jurisdiction', ['target_id' => $root_id]);
        $node->save();
        $counts['boilerplates']++;
        $logger->info('Set field_jurisdiction=%gid on orphan boilerplate %nid (%title).', [
          '%gid' => $root_id,
          '%nid' => $node->id(),
          '%title' => $node->label(),
        ]);
      }
    }
  }

  // --- 6. Orphaned org groups -> root jurisdiction ---
  $org_type = $config->get('organisation_group_type') ?? 'org';
  $org_groups = $etm->getStorage('group')->loadByProperties(['type' => $org_type]);
  foreach ($org_groups as $org) {
    if ($org->hasField('field_jurisdiction') && $org->get('field_jurisdiction')->isEmpty()) {
      $org->set('field_jurisdiction', ['target_id' => $root_id]);
      $org->save();
      $counts['orgs']++;
      $logger->info('Set field_jurisdiction=%gid on orphan org group %gid2 (%label).', [
        '%gid' => $root_id,
        '%gid2' => $org->id(),
        '%label' => $org->label(),
      ]);
    }
  }

  return sprintf(
    'Backfilled field_jurisdiction (root=%d): %d categories, %d statuses, %d pages, %d boilerplates, %d orgs.',
    $root_id, $counts['categories'], $counts['statuses'], $counts['pages'], $counts['boilerplates'], $counts['orgs']
  );
}

/**
 * Add default_jurisdiction_id config key for multi-tenant fallback.
 */
function markaspot_group_update_11914(): string {
  $config = \Drupal::configFactory()->getEditable('markaspot_group.settings');
  if ($config->get('default_jurisdiction_id') === NULL && !array_key_exists('default_jurisdiction_id', $config->getRawData())) {
    $config->set('default_jurisdiction_id', NULL)->save();
  }
  return 'Added default_jurisdiction_id config key for multi-tenant jurisdiction fallback.';
}

/**
 * Uninstall markaspot_tenant_admin, revoke obsolete permission.
 */
function markaspot_group_update_11913(): void {
  $module_handler = \Drupal::moduleHandler();

  // Uninstall the tenant_admin module if still present.
  if ($module_handler->moduleExists('markaspot_tenant_admin')) {
    \Drupal::service('module_installer')->uninstall(['markaspot_tenant_admin']);
    \Drupal::logger('markaspot_group')->notice(
      'Uninstalled markaspot_tenant_admin: functionality merged into markaspot_group.'
    );
  }

  // Remove the obsolete permission from tenant_admin role.
  $role = Role::load('tenant_admin');
  if ($role && $role->hasPermission('administer tenant taxonomy')) {
    $role->revokePermission('administer tenant taxonomy');
    $role->save();
    \Drupal::logger('markaspot_group')->notice(
      'Revoked obsolete "administer tenant taxonomy" permission from tenant_admin role.'
    );
  }
}

/**
 * Fix drifted jurisdiction group relationships on service_request nodes.
 *
 * Finds nodes where field_jurisdiction.target_id does not match the gid in
 * group_relationship_field_data and corrects the group relationship to point
 * to the jurisdiction referenced by field_jurisdiction.
 *
 * This is idempotent: re-running it on an already-fixed database is a no-op.
 */
function markaspot_group_update_11916(): string {
  $database = \Drupal::database();
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_group');
  $plugin_id = 'group_node:service_request';

  // Find all service_request nodes that have a jur group relationship
  // where the gid does NOT match field_jurisdiction.target_id.
  // We join node__field_jurisdiction with group_relationship_field_data
  // and filter for mismatches. Only consider jur groups (not org groups).
  $query = $database->select('node__field_jurisdiction', 'fj');
  $query->join('group_relationship_field_data', 'gr', 'gr.entity_id = fj.entity_id');
  $query->join('groups_field_data', 'g', 'g.id = gr.gid');
  $query->fields('fj', ['entity_id', 'field_jurisdiction_target_id']);
  $query->fields('gr', ['id', 'gid']);
  $query->condition('fj.bundle', 'service_request');
  $query->condition('gr.plugin_id', $plugin_id);
  $query->condition('g.type', 'jur');
  $query->where('[fj].[field_jurisdiction_target_id] <> [gr].[gid]');
  // Exclude nodes where field_jurisdiction is 0 (unset): those need manual
  // review, not automatic reassignment.
  $query->condition('fj.field_jurisdiction_target_id', 0, '>');

  $mismatches = $query->execute()->fetchAll();

  if (empty($mismatches)) {
    return 'No jurisdiction group relationship mismatches found. Nothing to fix.';
  }

  $group_storage = $etm->getStorage('group');
  $relationship_storage = $etm->getStorage('group_relationship');
  $fixed = 0;
  $skipped = 0;

  foreach ($mismatches as $row) {
    $nid = (int) $row->entity_id;
    $wrong_gid = (int) $row->gid;
    $correct_gid = (int) $row->field_jurisdiction_target_id;
    $relationship_id = (int) $row->id;

    // Validate the correct jurisdiction group exists and is type jur.
    $correct_group = $group_storage->load($correct_gid);
    if (!$correct_group || $correct_group->bundle() !== 'jur') {
      $logger->warning(
        'update_11916: Node @nid has field_jurisdiction=@jid but group @jid does not exist or is not type jur. Skipping.',
        ['@nid' => $nid, '@jid' => $correct_gid]
      );
      $skipped++;
      continue;
    }

    // Load the node for addRelationship().
    $node = $etm->getStorage('node')->load($nid);
    if (!$node) {
      $logger->warning(
        'update_11916: Node @nid no longer exists. Skipping.',
        ['@nid' => $nid]
      );
      $skipped++;
      continue;
    }

    // Delete the wrong relationship.
    $wrong_relationship = $relationship_storage->load($relationship_id);
    if ($wrong_relationship) {
      $wrong_relationship->delete();
    }

    // Check if correct relationship already exists (idempotent).
    $existing = $relationship_storage->loadByProperties([
      'entity_id' => $nid,
      'gid' => $correct_gid,
      'plugin_id' => $plugin_id,
    ]);

    if (empty($existing)) {
      try {
        $correct_group->addRelationship($node, $plugin_id);
      }
      catch (\Exception $e) {
        $logger->error(
          'update_11916: Failed to create relationship for node @nid to group @gid: @error',
          ['@nid' => $nid, '@gid' => $correct_gid, '@error' => $e->getMessage()]
        );
        $skipped++;
        continue;
      }
    }

    $logger->notice(
      'update_11916: Fixed node @nid: moved from group @old to group @new (@label).',
      [
        '@nid' => $nid,
        '@old' => $wrong_gid,
        '@new' => $correct_gid,
        '@label' => $correct_group->label(),
      ]
    );
    $fixed++;
  }

  return "Fixed $fixed jurisdiction group relationships ($skipped skipped) out of " . count($mismatches) . " mismatches found.";
}

/**
 * Fix bundle_field_map after group type rename organisation -> org.
 *
 * The Group module renamed the group type from "organisation" to "org" but
 * did not update the bundle_field_map in key_value. This causes
 * FieldStorageConfigInterface::getBundles() warnings and breaks
 * entity_views_query_alter() with "A valid cache entry key is required".
 * Idempotent: only touches entries that still reference "organisation-".
 */
function markaspot_group_update_11917(): string {
  $kv = \Drupal::keyValue('entity.definitions.bundle_field_map');
  $fixed = 0;

  foreach ($kv->getAll() as $entity_type => $fields) {
    $changed = FALSE;

    foreach ($fields as $field_name => $info) {
      if (!isset($info['bundles'])) {
        continue;
      }

      foreach ($info['bundles'] as $bundle => $val) {
        if (strpos($bundle, 'organisation-') === 0) {
          $new_bundle = 'org-' . substr($bundle, strlen('organisation-'));
          unset($fields[$field_name]['bundles'][$bundle]);
          $fields[$field_name]['bundles'][$new_bundle] = $new_bundle;
          $changed = TRUE;
          $fixed++;
        }
      }
    }

    if ($changed) {
      $kv->set($entity_type, $fields);
    }
  }

  return "Fixed $fixed bundle_field_map entries (organisation -> org).";
}

/**
 * Fix field_organisation target_bundles after group type rename.
 *
 * The entity reference field field_organisation on service_request may still
 * reference target_bundle "organisation" instead of "org". This causes
 * entity validation errors and broken reference widgets.
 * Idempotent: only changes if the old bundle name is present.
 */
function markaspot_group_update_11918(): string {
  $config = \Drupal::configFactory()
    ->getEditable('field.field.node.service_request.field_organisation');

  if ($config->isNew()) {
    return 'field_organisation config not found, skipping.';
  }

  $settings = $config->get('settings');
  $target_bundles = $settings['handler_settings']['target_bundles'] ?? [];

  if (isset($target_bundles['organisation'])) {
    unset($target_bundles['organisation']);
    $target_bundles['org'] = 'org';
    $settings['handler_settings']['target_bundles'] = $target_bundles;
    $config->set('settings', $settings)->save();
    return 'Updated field_organisation target_bundles: organisation -> org.';
  }

  return 'field_organisation target_bundles already correct.';
}

/**
 * Bump node.field_organisation cardinality from 1 to unlimited.
 *
 * Enables multi-org references on any bundle using this storage
 * (service_request, boilerplate, ...). Existing single-value data is
 * preserved. Per-bundle widget config still determines single vs multi UI.
 */
function markaspot_group_update_11919(): string {
  $field_storage = \Drupal::entityTypeManager()
    ->getStorage('field_storage_config')
    ->load('node.field_organisation');

  if (!$field_storage) {
    return 'node.field_organisation storage not found - nothing to do.';
  }

  if ($field_storage->getCardinality() === -1) {
    return 'node.field_organisation cardinality already unlimited.';
  }

  $field_storage->setCardinality(-1);
  $field_storage->save();
  return 'Bumped node.field_organisation cardinality to unlimited.';
}

/**
 * Sync process_apply_group ECA: method 'set:clear' -> 'append'.
 *
 * Coupled with update_11919 cardinality bump: with cardinality=-1, the old
 * 'set:clear' on field_organisation.target_id silently wiped any multi-org
 * values set upstream (manual staff selection, API payload). Append preserves
 * them and lets the category-derived GID join the list. Fresh installs get
 * the fixed ECA via profile config/optional; this hook propagates the fix to
 * existing tenants that already have the ECA in active config.
 */
function markaspot_group_update_11920(): string {
  $config = \Drupal::configFactory()
    ->getEditable('eca.eca.process_apply_group');

  if ($config->isNew()) {
    return 'eca.eca.process_apply_group not installed on this tenant - nothing to do.';
  }

  $current = $config->get('actions.Activiy_save_group.configuration.method');
  if ($current !== 'set:clear') {
    return "Activiy_save_group method already '$current' - nothing to do.";
  }

  $config
    ->set('actions.Activiy_save_group.configuration.method', 'append')
    ->save();
  return "Flipped Activiy_save_group method from 'set:clear' to 'append'.";
}

/**
 * Ensure jur-tenant_admin is owned by markaspot_group.
 */
function markaspot_group_update_11921(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('group_role');
  $role = $storage->load('jur-tenant_admin');
  $base_permissions = [
    'administer members',
    'create group_node:service_request entity',
    'create group_node:service_request relationship',
    'update any group_node:service_request entity',
    'update own group_node:service_request entity',
    'view group',
    'view group_node:service_request entity',
    'view group_node:service_request relationship',
    'view own unpublished group_node:service_request entity',
    'view unpublished group_node:service_request entity',
  ];
  $allowed_permissions = $base_permissions;

  if (\Drupal::moduleHandler()->moduleExists('markaspot_fastmap')) {
    $allowed_permissions = array_merge($allowed_permissions, [
      'create group_node:page entity',
      'create group_node:page relationship',
      'update any group_node:page entity',
      'view group_node:page entity',
      'view group_node:page relationship',
      'delete any group_node:page entity',
    ]);
  }

  if (\Drupal::moduleHandler()->moduleExists('markaspot_boilerplate')) {
    $allowed_permissions = array_merge($allowed_permissions, [
      'create group_node:boilerplate entity',
      'create group_node:boilerplate relationship',
      'delete any group_node:boilerplate entity',
      'update any group_node:boilerplate entity',
      'view group_node:boilerplate entity',
      'view group_node:boilerplate relationship',
    ]);
  }

  if (!$role) {
    $storage->create([
      'id' => 'jur-tenant_admin',
      'label' => 'Tenant Admin',
      'weight' => -1,
      'admin' => FALSE,
      'scope' => 'individual',
      'global_role' => NULL,
      'group_type' => 'jur',
      'permissions' => $allowed_permissions,
    ])->save();
    return 'Created jur-tenant_admin group role.';
  }

  $changed = FALSE;
  if ($role->isAdmin()) {
    $role->set('admin', FALSE);
    $changed = TRUE;
  }
  if ($role->label() !== 'Tenant Admin') {
    $role->set('label', 'Tenant Admin');
    $changed = TRUE;
  }
  if ($role->getScope() !== 'individual') {
    $role->set('scope', 'individual');
    $changed = TRUE;
  }
  if ($role->get('global_role') !== NULL) {
    $role->set('global_role', NULL);
    $changed = TRUE;
  }

  $permissions = $role->getPermissions();
  $normalized_permissions = array_values(array_intersect($allowed_permissions, $permissions));
  foreach ($allowed_permissions as $permission) {
    if (!in_array($permission, $normalized_permissions, TRUE)) {
      $normalized_permissions[] = $permission;
    }
  }
  if ($permissions !== $normalized_permissions) {
    $permissions = $normalized_permissions;
    $changed = TRUE;
  }

  if ($changed) {
    $role->set('permissions', $permissions);
    $role->save();
    return 'Updated jur-tenant_admin group role.';
  }

  return 'jur-tenant_admin group role already exists.';
}

/**
 * Require jurisdiction assignment on org groups.
 */
function markaspot_group_update_11922(): string {
  $config = \Drupal::configFactory()
    ->getEditable('field.field.group.org.field_jurisdiction');

  if ($config->isNew()) {
    return 'group.org.field_jurisdiction field config not found - nothing to do.';
  }

  $changed = FALSE;
  if ($config->get('required') !== TRUE) {
    $config->set('required', TRUE)->save();
    $changed = TRUE;
  }

  $database = \Drupal::database();
  $query = $database->select('groups', 'g');
  $query->leftJoin('group__field_jurisdiction', 'fj', 'fj.entity_id = g.id AND fj.deleted = 0');
  $orphan_count = (int) $query
    ->condition('g.type', 'org')
    ->isNull('fj.field_jurisdiction_target_id')
    ->countQuery()
    ->execute()
    ->fetchField();

  $message = $changed
    ? 'Set group.org.field_jurisdiction required.'
    : 'group.org.field_jurisdiction was already required.';

  if ($orphan_count > 0) {
    $message .= " Existing orphan org groups still require manual jurisdiction assignment: {$orphan_count}.";
  }

  return $message;
}

