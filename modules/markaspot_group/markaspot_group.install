<?php

/**
 * @file
 * Install, update and uninstall functions for markaspot_group module.
 */

/**
 * Fix jur-admin and org-admin group role scopes to individual.
 *
 * Previously jur-admin had scope=insider (all members became admins) and
 * org-admin had scope=outsider. Both need scope=individual so the admin role
 * can be assigned explicitly to specific members.
 */
function markaspot_group_update_11800(): void {
  $fixes = [
    'group.role.jur-admin' => 'individual',
    'group.role.org-admin' => 'individual',
  ];

  foreach ($fixes as $config_name => $scope) {
    $config = \Drupal::configFactory()->getEditable($config_name);
    if ($config->isNew()) {
      continue;
    }
    if ($config->get('scope') !== $scope) {
      $config->set('scope', $scope)->save();
      \Drupal::logger('markaspot_group')->info('Fixed @role scope to @scope.', [
        '@role' => $config_name,
        '@scope' => $scope,
      ]);
    }
  }
}

/**
 * Add 'edit group' permission to org-admin role.
 */
function markaspot_group_update_11801(): void {
  $config = \Drupal::configFactory()->getEditable('group.role.org-admin');
  if ($config->isNew()) {
    return;
  }
  $permissions = $config->get('permissions') ?? [];
  if (!in_array('edit group', $permissions)) {
    $permissions[] = 'edit group';
    $config->set('permissions', $permissions)->save();
  }
}

/**
 * Add field_jurisdiction to org group type and disable ECA rules.
 *
 * Creates an entity reference field on organisation groups pointing to
 * jurisdiction groups. Supports both legacy ('organisation') and modern ('org')
 * group type names via markaspot_open311.settings config.
 *
 * Also disables ECA rules replaced by code-based group assignment.
 */
function markaspot_group_update_11900(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $config = \Drupal::configFactory()->get('markaspot_open311.settings');
  $logger = \Drupal::logger('markaspot_group');

  // Read bundle names from config (legacy: 'organisation'/'jurisdiction').
  $org_type = $config->get('group_filter_type') ?? 'org';
  $jur_type = $config->get('jurisdiction_group_type') ?? 'jur';

  // Verify the org group type exists.
  $org_group_type = $entity_type_manager->getStorage('group_type')->load($org_type);
  if (!$org_group_type) {
    $logger->warning('Org group type "@type" not found. Skipping field_jurisdiction creation.', [
      '@type' => $org_type,
    ]);
    return;
  }

  // 1. Create field storage if it does not exist.
  $storage_id = 'group.field_jurisdiction';
  $field_storage = $entity_type_manager->getStorage('field_storage_config')
    ->load($storage_id);

  if (!$field_storage) {
    $field_storage = $entity_type_manager->getStorage('field_storage_config')
      ->create([
        'field_name' => 'field_jurisdiction',
        'entity_type' => 'group',
        'type' => 'entity_reference',
        'settings' => [
          'target_type' => 'group',
        ],
        'cardinality' => 1,
      ]);
    $field_storage->save();
    $logger->info('Created field storage group.field_jurisdiction.');
  }

  // 2. Create field instance on the detected org bundle.
  $field_id = "group.{$org_type}.field_jurisdiction";
  $field_config = $entity_type_manager->getStorage('field_config')
    ->load($field_id);

  if (!$field_config) {
    $field_config = $entity_type_manager->getStorage('field_config')
      ->create([
        'field_storage' => $field_storage,
        'bundle' => $org_type,
        'label' => 'Jurisdiction',
        'description' => 'The jurisdiction (city/district) this organisation belongs to.',
        'required' => FALSE,
        'settings' => [
          'handler' => 'default:group',
          'handler_settings' => [
            'target_bundles' => [$jur_type => $jur_type],
            'sort' => ['field' => 'label', 'direction' => 'ASC'],
            'auto_create' => FALSE,
          ],
        ],
      ]);
    $field_config->save();
    $logger->info('Created field instance @id.', ['@id' => $field_id]);
  }

  // 3. Add field to org form display.
  $form_display = $entity_type_manager->getStorage('entity_form_display')
    ->load("group.{$org_type}.default");

  if (!$form_display) {
    $form_display = $entity_type_manager->getStorage('entity_form_display')
      ->create([
        'targetEntityType' => 'group',
        'bundle' => $org_type,
        'mode' => 'default',
        'status' => TRUE,
      ]);
  }

  $form_display->setComponent('field_jurisdiction', [
    'type' => 'entity_reference_autocomplete',
    'weight' => 5,
    'settings' => [
      'match_operator' => 'CONTAINS',
      'match_limit' => 10,
      'size' => 60,
      'placeholder' => '',
    ],
  ]);
  $form_display->save();

  // 4. Disable ECA rules replaced by code-based group assignment.
  $eca_rules = [
    'eca.eca.process_apply_jurisdiction' => 'root jurisdiction assignment',
    'eca.eca.process_apply_group' => 'organisation assignment + notification',
  ];
  foreach ($eca_rules as $config_name => $description) {
    $eca_config = \Drupal::configFactory()->getEditable($config_name);
    if (!$eca_config->isNew()) {
      $eca_config->set('status', FALSE)->save();
      $logger->info(
        'Disabled ECA rule @name (replaced by code-based @desc).',
        ['@name' => $config_name, '@desc' => $description]
      );
    }
  }
}

/**
 * Backfill org->jur references and jur group memberships for existing data.
 *
 * Uses $sandbox for batch processing to handle sites with 100k+ nodes.
 *
 * Phase 1 (first call): Sets field_jurisdiction on all org groups.
 * Phase 2 (subsequent calls): Adds service_request nodes to root jur group
 * in batches of 100.
 */
function markaspot_group_update_11901(array &$sandbox): void {
  $etm = \Drupal::entityTypeManager();
  $group_storage = $etm->getStorage('group');
  $config = \Drupal::configFactory()->get('markaspot_open311.settings');
  $logger = \Drupal::logger('markaspot_group');

  // Resolve group type names.
  $org_type = $config->get('group_filter_type') ?? 'org';
  $jur_type = $config->get('jurisdiction_group_type') ?? 'jur';

  // First call: initialize sandbox.
  if (!isset($sandbox['phase'])) {
    $sandbox['phase'] = 'init';
    $sandbox['root_jur_id'] = NULL;
    $sandbox['processed'] = 0;
    $sandbox['total'] = 0;
  }

  // --- Phase: init (find root jur, validate) ---
  if ($sandbox['phase'] === 'init') {
    // Check if field_parent_jurisdiction is configured for this group type.
    $has_parent_field = $etm->getStorage('field_config')
      ->load("group.{$jur_type}.field_parent_jurisdiction") !== NULL;

    if ($has_parent_field) {
      $root_jur_ids = $group_storage->getQuery()
        ->accessCheck(FALSE)
        ->condition('type', $jur_type)
        ->notExists('field_parent_jurisdiction')
        ->execute();
    }
    else {
      // No parent field means all jur groups are roots.
      $root_jur_ids = $group_storage->getQuery()
        ->accessCheck(FALSE)
        ->condition('type', $jur_type)
        ->execute();
    }

    if (empty($root_jur_ids)) {
      $logger->warning('No root jurisdiction group found. Skipping backfill.');
      $sandbox['#finished'] = 1;
      return;
    }

    if (count($root_jur_ids) > 1) {
      $logger->warning(
        'Multiple root jurisdictions found (@count). Skipping automatic backfill. Assign field_jurisdiction on org groups manually.',
        ['@count' => count($root_jur_ids)]
      );
      $sandbox['#finished'] = 1;
      return;
    }

    $sandbox['root_jur_id'] = (int) reset($root_jur_ids);
    $root_jur = $group_storage->load($sandbox['root_jur_id']);

    $logger->info('Backfilling with root jurisdiction "@name" (id=@id).', [
      '@name' => $root_jur->label(),
      '@id' => $sandbox['root_jur_id'],
    ]);

    // Phase: org backfill (set field_jurisdiction on org groups).
    $org_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', $org_type)
      ->execute();

    $org_count = 0;
    foreach ($group_storage->loadMultiple($org_ids) as $org_group) {
      if (!$org_group->hasField('field_jurisdiction')) {
        continue;
      }
      if (!$org_group->get('field_jurisdiction')->isEmpty()) {
        continue;
      }
      $org_group->set('field_jurisdiction', ['target_id' => $sandbox['root_jur_id']]);
      $org_group->save();
      $org_count++;
    }

    if ($org_count > 0) {
      $logger->info('Set field_jurisdiction on @count org groups.', ['@count' => $org_count]);
    }

    // Prepare node backfill: find nodes NOT yet in the root jur group.
    $plugin_id = 'group_node:service_request';
    $db = \Drupal::database();

    // Direct DB query for existing nids (avoids loading 100k+ entities).
    $existing_nids = $db->select('group_relationship_field_data', 'gr')
      ->fields('gr', ['entity_id'])
      ->condition('gid', $sandbox['root_jur_id'])
      ->condition('plugin_id', $plugin_id)
      ->execute()
      ->fetchAllKeyed(0, 0);

    $all_nids = $etm->getStorage('node')->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'service_request')
      ->sort('nid', 'ASC')
      ->execute();

    $sandbox['missing_nids'] = array_values(array_diff($all_nids, array_keys($existing_nids)));
    $sandbox['total'] = count($sandbox['missing_nids']);
    $sandbox['processed'] = 0;
    $sandbox['phase'] = 'nodes';

    if ($sandbox['total'] === 0) {
      $logger->info('All service requests already assigned to root jurisdiction.');
      $sandbox['#finished'] = 1;
      return;
    }

    $logger->info('Starting node backfill: @count nodes to add.', [
      '@count' => $sandbox['total'],
    ]);
  }

  // --- Phase: nodes (batch add to jur group) ---
  if ($sandbox['phase'] === 'nodes') {
    $batch_size = 100;
    $root_jur = $group_storage->load($sandbox['root_jur_id']);
    $plugin_id = 'group_node:service_request';

    $offset = $sandbox['processed'];
    $chunk = array_slice($sandbox['missing_nids'], $offset, $batch_size);

    if (empty($chunk)) {
      $sandbox['#finished'] = 1;
      return;
    }

    $nodes = $etm->getStorage('node')->loadMultiple($chunk);
    $added = 0;

    foreach ($nodes as $node) {
      try {
        $root_jur->addRelationship($node, $plugin_id);
        $added++;
      }
      catch (\Exception $e) {
        // Cardinality constraint or other issue. Log and continue.
        $logger->error('Failed to add node @nid to jur group: @msg', [
          '@nid' => $node->id(),
          '@msg' => $e->getMessage(),
        ]);
      }
    }

    $sandbox['processed'] += count($chunk);

    // Free memory between batches.
    $etm->getStorage('node')->resetCache($chunk);
    $etm->getStorage('group_relationship')->resetCache();

    $sandbox['#finished'] = $sandbox['total'] > 0
      ? $sandbox['processed'] / $sandbox['total']
      : 1;

    if ($sandbox['#finished'] >= 1) {
      $logger->info('Backfill complete: added @count of @total nodes to jurisdiction.', [
        '@count' => $sandbox['processed'],
        '@total' => $sandbox['total'],
      ]);
    }
  }
}

/**
 * Set jur-admin and org-admin group roles to insider scope with global_role.
 *
 * Reverses update_11800 which set scope=individual. Insider scope ensures
 * that Drupal administrators automatically get group admin permissions in
 * all groups they are members of, without explicit per-group role assignment.
 */
function markaspot_group_update_11902(): void {
  $logger = \Drupal::logger('markaspot_group');
  $storage = \Drupal::entityTypeManager()->getStorage('group_role');

  $role_ids = ['jur-admin', 'org-admin'];

  foreach ($role_ids as $role_id) {
    /** @var \Drupal\group\Entity\GroupRoleInterface|null $role */
    $role = $storage->load($role_id);
    if (!$role) {
      $logger->warning('Group role @id not found, skipping.', ['@id' => $role_id]);
      continue;
    }

    $changed = FALSE;

    if ($role->getScope() !== 'insider') {
      $role->set('scope', 'insider');
      $changed = TRUE;
    }

    if ($role->get('global_role') !== 'administrator') {
      $role->set('global_role', 'administrator');
      $changed = TRUE;
    }

    if ($changed) {
      $role->save();
      $logger->info('Updated @id: scope=insider, global_role=administrator.', [
        '@id' => $role_id,
      ]);
    }
  }
}

/**
 * Add field_service_categories to org groups and delete obsolete ECA rules.
 *
 * Creates a multi-value entity reference field on org groups that maps each
 * organisation to the service categories it handles. This enables
 * jurisdiction-aware org derivation: when a request is created in a child
 * jurisdiction (e.g. Noord), the system first checks for an org in that
 * jurisdiction handling the category before falling back to the root-level org.
 *
 * Also deletes the ECA rules process_apply_jurisdiction and process_apply_group
 * which were only disabled in 11900 but still fired on cascading entity events.
 */
function markaspot_group_update_11903(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_group');
  $config = \Drupal::configFactory()->get('markaspot_open311.settings');
  $org_type = $config->get('group_filter_type') ?? 'org';

  // 1. Create field storage if it does not exist.
  $storage_id = 'group.field_service_categories';
  $field_storage = $etm->getStorage('field_storage_config')->load($storage_id);

  if (!$field_storage) {
    $field_storage = $etm->getStorage('field_storage_config')->create([
      'field_name' => 'field_service_categories',
      'entity_type' => 'group',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'taxonomy_term'],
      'cardinality' => -1,
    ]);
    $field_storage->save();
    $logger->info('Created field storage group.field_service_categories.');
  }

  // 2. Create field instance on org bundle.
  $field_id = "group.{$org_type}.field_service_categories";
  $field_config = $etm->getStorage('field_config')->load($field_id);

  if (!$field_config) {
    $field_config = $etm->getStorage('field_config')->create([
      'field_storage' => $field_storage,
      'bundle' => $org_type,
      'label' => 'Service Categories',
      'description' => 'The service categories this organisation handles. Used for jurisdiction-aware org derivation.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => ['service_category' => 'service_category'],
          'sort' => ['field' => 'name', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ]);
    $field_config->save();
    $logger->info('Created field instance @id.', ['@id' => $field_id]);
  }

  // 3. Add field to org form display.
  $form_display = $etm->getStorage('entity_form_display')
    ->load("group.{$org_type}.default");

  if ($form_display) {
    $form_display->setComponent('field_service_categories', [
      'type' => 'entity_reference_autocomplete',
      'weight' => 6,
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
    ]);
    $form_display->save();
  }

  // 4. Delete obsolete ECA rules (disabling alone is insufficient due to
  // cascading entity event bug where disabled ECA models still execute).
  $eca_rules = [
    'process_apply_jurisdiction',
    'process_apply_group',
  ];
  $eca_storage = $etm->getStorage('eca');
  foreach ($eca_rules as $eca_id) {
    // Log full config data before deletion for recovery purposes.
    $raw_config = \Drupal::configFactory()->getEditable("eca.eca.{$eca_id}");
    if (!$raw_config->isNew()) {
      $logger->notice('Pre-deletion backup of @name: @data', [
        '@name' => "eca.eca.{$eca_id}",
        '@data' => json_encode($raw_config->getRawData()),
      ]);
    }
    $eca = $eca_storage->load($eca_id);
    if ($eca) {
      $eca->delete();
      $logger->info('Deleted obsolete ECA rule @id.', ['@id' => $eca_id]);
    }
    elseif (!$raw_config->isNew()) {
      // Entity load failed but raw config exists: clean up directly.
      $raw_config->delete();
    }
  }
}

/**
 * Add group relationship for pages and field_jurisdiction on page nodes.
 *
 * Makes pages jurisdiction-aware so each tenant can have its own welcome
 * content and info pages. Creates field_jurisdiction on page nodes,
 * the jur-group_node-page relationship type, and assigns existing promoted
 * pages to the root jurisdiction.
 */
function markaspot_group_update_11904(): void {
  $etm = \Drupal::entityTypeManager();
  $config = \Drupal::configFactory()->get('markaspot_open311.settings');
  $logger = \Drupal::logger('markaspot_group');

  $jur_type = $config->get('jurisdiction_group_type') ?? 'jur';

  // 1. Create field storage for node.field_jurisdiction if it does not exist.
  $storage_id = 'node.field_jurisdiction';
  $field_storage = $etm->getStorage('field_storage_config')->load($storage_id);

  if (!$field_storage) {
    $field_storage = $etm->getStorage('field_storage_config')->create([
      'field_name' => 'field_jurisdiction',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'group',
      ],
      'cardinality' => -1,
    ]);
    $field_storage->save();
    $logger->info('Created field storage node.field_jurisdiction.');
  }
  elseif ($field_storage->getCardinality() === 1) {
    // Upgrade: allow multiple jurisdictions per page.
    $field_storage->setCardinality(-1);
    $field_storage->save();
    $logger->info('Updated node.field_jurisdiction cardinality to unlimited.');
  }

  // 2. Create field instance on the page bundle.
  $field_id = 'node.page.field_jurisdiction';
  $field_config = $etm->getStorage('field_config')->load($field_id);

  if (!$field_config) {
    $field_config = $etm->getStorage('field_config')->create([
      'field_storage' => $field_storage,
      'bundle' => 'page',
      'label' => 'Jurisdiction',
      'description' => 'The jurisdiction this page belongs to.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => [$jur_type => $jur_type],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ]);
    $field_config->save();
    $logger->info('Created field instance node.page.field_jurisdiction.');
  }

  // 3. Create group relationship type jur-group_node-page.
  $relationship_type_id = 'jur-group_node-page';
  $existing = $etm->getStorage('group_relationship_type')->load($relationship_type_id);

  if (!$existing) {
    $relationship_type = $etm->getStorage('group_relationship_type')->create([
      'id' => $relationship_type_id,
      'group_type' => $jur_type,
      'content_plugin' => 'group_node:page',
      'plugin_config' => [
        'group_cardinality' => 0,
        'entity_cardinality' => 0,
        'use_creation_wizard' => FALSE,
      ],
    ]);
    $relationship_type->save();
    $logger->info('Created group relationship type @id.', ['@id' => $relationship_type_id]);
  }
  else {
    // Upgrade: allow pages in multiple jurisdictions.
    $plugin_config = $existing->get('plugin_config');
    if (($plugin_config['entity_cardinality'] ?? 0) === 1) {
      $plugin_config['entity_cardinality'] = 0;
      $existing->set('plugin_config', $plugin_config);
      $existing->save();
      $logger->info('Updated @id entity_cardinality to unlimited.', ['@id' => $relationship_type_id]);
    }
  }

  // 4. Find root jurisdiction and assign promoted pages.
  $group_storage = $etm->getStorage('group');

  $has_parent_field = $etm->getStorage('field_config')
    ->load("group.{$jur_type}.field_parent_jurisdiction") !== NULL;

  if ($has_parent_field) {
    $root_jur_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', $jur_type)
      ->notExists('field_parent_jurisdiction')
      ->execute();
  }
  else {
    $root_jur_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', $jur_type)
      ->execute();
  }

  if (empty($root_jur_ids)) {
    $logger->warning('No root jurisdiction group found. Skipping page assignment.');
    return;
  }

  if (count($root_jur_ids) > 1) {
    $logger->warning(
      'Multiple root jurisdictions found (@count). Skipping automatic page assignment.',
      ['@count' => count($root_jur_ids)]
    );
    return;
  }

  $root_jur_id = (int) reset($root_jur_ids);
  $root_jur = $group_storage->load($root_jur_id);

  // Find promoted page nodes.
  $page_nids = $etm->getStorage('node')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'page')
    ->condition('promote', 1)
    ->sort('nid', 'ASC')
    ->execute();

  if (empty($page_nids)) {
    $logger->info('No promoted pages found to assign.');
    return;
  }

  $pages = $etm->getStorage('node')->loadMultiple($page_nids);
  $plugin_id = 'group_node:page';
  $assigned = 0;
  $first_page = NULL;

  foreach ($pages as $page) {
    if ($first_page === NULL) {
      $first_page = $page;
    }

    // Set field_jurisdiction on the page node.
    if ($page->hasField('field_jurisdiction') && $page->get('field_jurisdiction')->isEmpty()) {
      $page->set('field_jurisdiction', ['target_id' => $root_jur_id]);
      $page->save();
    }

    // Create group relationship (skip if already exists).
    $existing = $root_jur->getRelationshipsByEntity($page, $plugin_id);
    if (empty($existing)) {
      try {
        $root_jur->addRelationship($page, $plugin_id);
        $assigned++;
      }
      catch (\Exception $e) {
        $logger->error('Failed to add page @nid to jur group: @msg', [
          '@nid' => $page->id(),
          '@msg' => $e->getMessage(),
        ]);
      }
    }
  }

  $logger->info('Assigned @count pages to root jurisdiction "@name".', [
    '@count' => $assigned,
    '@name' => $root_jur->label(),
  ]);

  // 5. Set the first page as sticky (welcome/landing page).
  // Only if no page is already sticky (respect existing admin choices).
  $existing_sticky = $etm->getStorage('node')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'page')
    ->condition('sticky', 1)
    ->range(0, 1)
    ->execute();

  if (empty($existing_sticky) && $first_page) {
    $first_page->set('sticky', 1);
    $first_page->save();
    $logger->info('Set page "@title" (nid=@nid) as sticky.', [
      '@title' => $first_page->label(),
      '@nid' => $first_page->id(),
    ]);
  }

  // 5b. Migrate mas_custom block body into the sticky welcome page.
  // For existing installations, the mas_custom block holds the welcome content
  // that should now live in the sticky page.
  $sticky_nids = $existing_sticky ?: ($first_page ? [$first_page->id()] : []);
  if (!empty($sticky_nids)) {
    $sticky_page = $etm->getStorage('node')->load(reset($sticky_nids));
    $mas_custom_blocks = $etm->getStorage('block_content')
      ->loadByProperties(['type' => 'mas_custom']);

    if (!empty($mas_custom_blocks)) {
      $mas_block = reset($mas_custom_blocks);
      $block_body = $mas_block->get('body')->value ?? '';

      if (!empty($block_body) && $sticky_page) {
        // Migrate default language.
        $sticky_page->set('title', 'Welcome');
        $sticky_page->set('body', [
          'value' => $block_body,
          'format' => $mas_block->get('body')->format ?? 'full_html',
        ]);
        $sticky_page->save();

        // Migrate translations.
        foreach ($mas_block->getTranslationLanguages() as $langcode => $lang) {
          if ($langcode === $sticky_page->language()->getId()) {
            continue;
          }
          $block_trans = $mas_block->getTranslation($langcode);
          $trans_body = $block_trans->get('body')->value ?? '';
          if (empty($trans_body)) {
            continue;
          }
          $page_trans = $sticky_page->hasTranslation($langcode)
            ? $sticky_page->getTranslation($langcode)
            : $sticky_page->addTranslation($langcode);
          $page_trans->set('title', 'Welcome');
          $page_trans->set('body', [
            'value' => $trans_body,
            'format' => $block_trans->get('body')->format ?? 'full_html',
          ]);
          $page_trans->save();
        }

        $logger->info('Migrated mas_custom block body (+ @count translations) into sticky page "@title" (nid=@nid).', [
          '@title' => $sticky_page->label(),
          '@nid' => $sticky_page->id(),
          '@count' => count($mas_block->getTranslationLanguages()) - 1,
        ]);
      }
    }
  }

  // 6. Add field_jurisdiction to the page form display.
  $form_display = $etm->getStorage('entity_form_display')
    ->load('node.page.default');

  if (!$form_display) {
    $form_display = $etm->getStorage('entity_form_display')->create([
      'targetEntityType' => 'node',
      'bundle' => 'page',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }

  $form_display->setComponent('field_jurisdiction', [
    'type' => 'entity_reference_autocomplete',
    'weight' => 4,
    'region' => 'content',
    'settings' => [
      'match_operator' => 'CONTAINS',
      'match_limit' => 10,
      'size' => 60,
      'placeholder' => '',
    ],
  ]);
  $form_display->save();

  // 7. Update JSON:API resource config for node--page to include
  // field_jurisdiction.
  $jsonapi_config = \Drupal::configFactory()
    ->getEditable('jsonapi_extras.jsonapi_resource_config.node--page');

  if (!$jsonapi_config->isNew()) {
    $resource_fields = $jsonapi_config->get('resourceFields') ?? [];
    if (!isset($resource_fields['field_jurisdiction'])) {
      $resource_fields['field_jurisdiction'] = [
        'disabled' => FALSE,
        'fieldName' => 'field_jurisdiction',
        'publicName' => 'field_jurisdiction',
        'enhancer' => ['id' => ''],
      ];
      $jsonapi_config->set('resourceFields', $resource_fields)->save();
      $logger->info('Added field_jurisdiction to JSON:API node--page resource config.');
    }
  }
  else {
    $logger->notice('JSON:API resource config for node--page not found. field_jurisdiction will be available via default JSON:API config.');
  }

  // 8. Add page permissions to jur group roles.
  // Without these, group access control blocks anonymous page viewing.
  $role_storage = $etm->getStorage('group_role');
  $page_permissions = [
    "{$jur_type}-anonymous" => ['view group_node:page entity'],
    "{$jur_type}-outsider" => ['view group_node:page entity'],
    "{$jur_type}-moderator" => [
      'view group_node:page entity',
      'view group_node:page relationship',
    ],
    "{$jur_type}-member" => [
      'view group_node:page entity',
      'view group_node:page relationship',
      'create group_node:page entity',
      'update own group_node:page entity',
    ],
    "{$jur_type}-editorial" => [
      'view group_node:page entity',
      'view group_node:page relationship',
      'create group_node:page entity',
      'create group_node:page relationship',
      'update any group_node:page entity',
      'update own group_node:page entity',
      'delete any group_node:page entity',
    ],
    "{$jur_type}-tenant_admin" => [
      'view group_node:page entity',
      'view group_node:page relationship',
      'create group_node:page entity',
      'create group_node:page relationship',
      'update any group_node:page entity',
      'update own group_node:page entity',
      'delete any group_node:page entity',
    ],
    "{$jur_type}-admin" => [
      'view group_node:page entity',
      'view group_node:page relationship',
      'create group_node:page entity',
      'create group_node:page relationship',
      'update any group_node:page entity',
      'update own group_node:page entity',
      'delete any group_node:page entity',
      'delete own group_node:page entity',
    ],
  ];

  foreach ($page_permissions as $role_id => $new_perms) {
    $role = $role_storage->load($role_id);
    if (!$role) {
      continue;
    }
    $existing = $role->getPermissions();
    $added = 0;
    foreach ($new_perms as $perm) {
      if (!in_array($perm, $existing)) {
        $existing[] = $perm;
        $added++;
      }
    }
    if ($added > 0) {
      $role->set('permissions', $existing);
      $role->save();
      $logger->info('Added @count page permissions to @role.', [
        '@count' => $added,
        '@role' => $role_id,
      ]);
    }
  }
}

/**
 * Add jurisdiction metadata fields and field_jurisdiction on service_request.
 *
 * Phase 1: Creates field_platform_name and field_email_footer on jur groups.
 * Phase 2: Creates field_jurisdiction instance on service_request nodes.
 * Phase 3: Installs markaspot_group.settings config.
 * Phase 4: Backfills field_jurisdiction on existing service_requests.
 * Phase 5: Populates field_platform_name from field_nuxt_config JSON.
 */
function markaspot_group_update_11905(array &$sandbox): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_group');
  $config_factory = \Drupal::configFactory();

  // Read group type names from config (consistent with earlier update hooks).
  $o311_config = $config_factory->get('markaspot_open311.settings');
  $jur_type = $o311_config->get('jurisdiction_group_type') ?? 'jur';

  // Initialize sandbox on first call.
  if (!isset($sandbox['phase'])) {
    $sandbox['phase'] = 'fields';
  }

  // --- Phase: fields (create new fields, config, form displays) ---
  if ($sandbox['phase'] === 'fields') {

    // 1. field_platform_name on jur groups.
    $storage_id = 'group.field_platform_name';
    $field_storage = $etm->getStorage('field_storage_config')->load($storage_id);
    if (!$field_storage) {
      $field_storage = $etm->getStorage('field_storage_config')->create([
        'field_name' => 'field_platform_name',
        'entity_type' => 'group',
        'type' => 'string',
        'settings' => [
          'max_length' => 255,
          'is_ascii' => FALSE,
          'case_sensitive' => FALSE,
        ],
        'cardinality' => 1,
      ]);
      $field_storage->save();
      $logger->info('Created field storage group.field_platform_name.');
    }

    $field_id = "group.{$jur_type}.field_platform_name";
    if (!$etm->getStorage('field_config')->load($field_id)) {
      $etm->getStorage('field_config')->create([
        'field_storage' => $field_storage,
        'bundle' => $jur_type,
        'label' => 'Platform Name',
        'description' => 'Brand name for emails and UI (e.g. "Mängelmelder Bonn", "Mark-a-Spot").',
        'required' => FALSE,
        'translatable' => TRUE,
        'settings' => [],
      ])->save();
      $logger->info('Created field instance group.jur.field_platform_name.');
    }

    // 2. field_email_footer on jur groups.
    $storage_id = 'group.field_email_footer';
    $field_storage_footer = $etm->getStorage('field_storage_config')->load($storage_id);
    if (!$field_storage_footer) {
      $field_storage_footer = $etm->getStorage('field_storage_config')->create([
        'field_name' => 'field_email_footer',
        'entity_type' => 'group',
        'type' => 'string_long',
        'settings' => [],
        'cardinality' => 1,
      ]);
      $field_storage_footer->save();
      $logger->info('Created field storage group.field_email_footer.');
    }

    $field_id = "group.{$jur_type}.field_email_footer";
    if (!$etm->getStorage('field_config')->load($field_id)) {
      $etm->getStorage('field_config')->create([
        'field_storage' => $field_storage_footer,
        'bundle' => $jur_type,
        'label' => 'Email Footer',
        'description' => 'Closing text for citizen notification emails (e.g. "Your City Administration").',
        'required' => FALSE,
        'translatable' => TRUE,
        'settings' => [],
      ])->save();
      $logger->info('Created field instance group.jur.field_email_footer.');
    }

    // 3. Add new fields to jur form display.
    $form_display = $etm->getStorage('entity_form_display')
      ->load("group.{$jur_type}.default");
    if ($form_display) {
      if (!$form_display->getComponent('field_platform_name')) {
        $form_display->setComponent('field_platform_name', [
          'type' => 'string_textfield',
          'weight' => 22,
          'region' => 'content',
          'settings' => [
            'size' => 60,
            'placeholder' => 'e.g. Mängelmelder Bonn',
          ],
        ]);
      }
      if (!$form_display->getComponent('field_email_footer')) {
        $form_display->setComponent('field_email_footer', [
          'type' => 'string_textarea',
          'weight' => 23,
          'region' => 'content',
          'settings' => [
            'rows' => 3,
            'placeholder' => 'e.g. Your City Administration',
          ],
        ]);
      }
      $form_display->save();
      $logger->info('Added field_platform_name and field_email_footer to jur form display.');
    }

    // 4. field_jurisdiction instance on service_request.
    // Field storage already exists (created in update 11904 for pages).
    $sr_field_id = 'node.service_request.field_jurisdiction';
    if (!$etm->getStorage('field_config')->load($sr_field_id)) {
      $node_jur_storage = $etm->getStorage('field_storage_config')
        ->load('node.field_jurisdiction');
      if ($node_jur_storage) {
        $etm->getStorage('field_config')->create([
          'field_storage' => $node_jur_storage,
          'bundle' => 'service_request',
          'label' => 'Jurisdiction',
          'description' => 'The jurisdiction this service request belongs to. Set automatically on creation.',
          'required' => FALSE,
          'translatable' => FALSE,
          'settings' => [
            'handler' => 'default:group',
            'handler_settings' => [
              'target_bundles' => [$jur_type => $jur_type],
              'sort' => ['field' => 'label', 'direction' => 'ASC'],
              'auto_create' => FALSE,
            ],
          ],
        ])->save();
        $logger->info('Created field instance node.service_request.field_jurisdiction.');
      }
      else {
        $logger->warning('Field storage node.field_jurisdiction not found. Run update 11904 first.');
      }
    }

    // 5. Add field_jurisdiction to service_request form display.
    $sr_form_display = $etm->getStorage('entity_form_display')
      ->load('node.service_request.default');
    if ($sr_form_display && !$sr_form_display->getComponent('field_jurisdiction')) {
      $sr_form_display->setComponent('field_jurisdiction', [
        'type' => 'entity_reference_autocomplete',
        'weight' => 25,
        'region' => 'content',
        'settings' => [
          'match_operator' => 'CONTAINS',
          'match_limit' => 10,
          'size' => 60,
          'placeholder' => '',
        ],
      ]);
      $sr_form_display->save();
      $logger->info('Added field_jurisdiction to service_request form display.');
    }

    // 6. Update JSON:API resource config to expose field_jurisdiction.
    $jsonapi_config = $config_factory
      ->getEditable('jsonapi_extras.jsonapi_resource_config.node--service_request');
    if (!$jsonapi_config->isNew()) {
      $resource_fields = $jsonapi_config->get('resourceFields') ?? [];
      if (!isset($resource_fields['field_jurisdiction'])) {
        $resource_fields['field_jurisdiction'] = [
          'disabled' => FALSE,
          'fieldName' => 'field_jurisdiction',
          'publicName' => 'field_jurisdiction',
          'enhancer' => ['id' => ''],
        ];
        $jsonapi_config->set('resourceFields', $resource_fields)->save();
        $logger->info('Added field_jurisdiction to JSON:API node--service_request resource config.');
      }
    }

    // 7. Install markaspot_group.settings config if not present.
    $settings_config = $config_factory->getEditable('markaspot_group.settings');
    if ($settings_config->isNew()) {
      $settings_config->set('jurisdiction_field_strategy', 'most_specific')->save();
      $logger->info('Installed markaspot_group.settings with strategy=most_specific.');
    }

    // Move to backfill phase. Return to avoid cascading into next phase
    // within the same PHP request (prevents timeout on large datasets).
    $sandbox['phase'] = 'backfill_init';
    $sandbox['#finished'] = 0;
    return;
  }

  // --- Phase: backfill_init (count nodes to backfill) ---
  if ($sandbox['phase'] === 'backfill_init') {
    // Only store the count and a cursor (last processed NID), not all NIDs.
    // This keeps $sandbox small even for 70k+ nodes.
    $total = (int) $etm->getStorage('node')->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'service_request')
      ->notExists('field_jurisdiction')
      ->count()
      ->execute();

    $sandbox['backfill_total'] = $total;
    $sandbox['backfill_processed'] = 0;
    $sandbox['backfill_last_nid'] = 0;

    if ($total === 0) {
      $logger->info('No service requests need field_jurisdiction backfill.');
      $sandbox['phase'] = 'populate';
    }
    else {
      $logger->info('Starting field_jurisdiction backfill for @count service requests.', [
        '@count' => $total,
      ]);
      $sandbox['phase'] = 'backfill';
    }
  }

  // --- Phase: backfill (batch-fill field_jurisdiction) ---
  if ($sandbox['phase'] === 'backfill') {
    $batch_size = 50;
    $node_storage = $etm->getStorage('node');
    $relationship_storage = $etm->getStorage('group_relationship');

    // Cursor-based: query next batch starting after last processed NID.
    $nids = $node_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'service_request')
      ->notExists('field_jurisdiction')
      ->condition('nid', $sandbox['backfill_last_nid'], '>')
      ->sort('nid', 'ASC')
      ->range(0, $batch_size)
      ->execute();

    if (empty($nids)) {
      $logger->info('Backfill complete: processed @count service requests.', [
        '@count' => $sandbox['backfill_processed'],
      ]);
      $sandbox['phase'] = 'populate';
      $sandbox['#finished'] = 0;
      return;
    }
    else {
      $nodes = $node_storage->loadMultiple($nids);

      foreach ($nodes as $node) {
        $sandbox['backfill_last_nid'] = (int) $node->id();

        if (!$node->hasField('field_jurisdiction')) {
          $sandbox['backfill_processed']++;
          continue;
        }
        if (!$node->get('field_jurisdiction')->isEmpty()) {
          $sandbox['backfill_processed']++;
          continue;
        }

        // Find jur group relationships for this node.
        $jur_relationships = $relationship_storage->loadByProperties([
          'entity_id' => $node->id(),
          'plugin_id' => 'group_node:service_request',
        ]);

        // Collect all child jur IDs from relationships.
        $child_jur_ids = [];
        foreach ($jur_relationships as $rel) {
          $group = $rel->getGroup();
          if ($group && $group->bundle() === $jur_type) {
            if ($group->hasField('field_parent_jurisdiction')
                && !$group->get('field_parent_jurisdiction')->isEmpty()) {
              $child_jur_ids[] = (int) $group->id();
            }
          }
        }

        // Find the deepest child (not referenced as parent by another match).
        $child_jur_id = FALSE;
        if (count($child_jur_ids) === 1) {
          $child_jur_id = $child_jur_ids[0];
        }
        elseif (count($child_jur_ids) > 1) {
          $child_groups = $etm->getStorage('group')->loadMultiple($child_jur_ids);
          $parent_ids_in_set = [];
          foreach ($child_groups as $cg) {
            if ($cg->hasField('field_parent_jurisdiction') && !$cg->get('field_parent_jurisdiction')->isEmpty()) {
              $parent_ids_in_set[(int) $cg->get('field_parent_jurisdiction')->target_id] = TRUE;
            }
          }
          foreach ($child_jur_ids as $cid) {
            if (!isset($parent_ids_in_set[$cid])) {
              $child_jur_id = $cid;
              break;
            }
          }
          if ($child_jur_id === FALSE) {
            $child_jur_id = $child_jur_ids[0];
          }
        }

        // Use the helper function to set field_jurisdiction.
        if (_markaspot_group_set_jurisdiction_field($node, $child_jur_id)) {
          _markaspot_group_set_syncing(TRUE);
          try {
            $node->save();
          }
          finally {
            _markaspot_group_set_syncing(FALSE);
          }
        }

        $sandbox['backfill_processed']++;
      }

      // Free memory between batches.
      $node_storage->resetCache(array_values($nids));
      $relationship_storage->resetCache();
    }
  }

  // --- Phase: populate (fill field_platform_name from field_nuxt_config) ---
  if ($sandbox['phase'] === 'populate') {
    $group_storage = $etm->getStorage('group');
    $jur_ids = $group_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', $jur_type)
      ->execute();

    $populated = 0;
    foreach ($group_storage->loadMultiple($jur_ids) as $jur) {
      // Populate field_platform_name from field_nuxt_config JSON.
      if ($jur->hasField('field_platform_name')
          && $jur->get('field_platform_name')->isEmpty()
          && $jur->hasField('field_nuxt_config')
          && !$jur->get('field_nuxt_config')->isEmpty()) {
        $json = $jur->get('field_nuxt_config')->value;
        $config_data = json_decode($json, TRUE);
        $client_name = $config_data['client']['name'] ?? NULL;
        if ($client_name) {
          $jur->set('field_platform_name', $client_name);
          $jur->save();
          $populated++;
          $logger->info('Set field_platform_name on jur "@label" to "@name" (from field_nuxt_config).', [
            '@label' => $jur->label(),
            '@name' => $client_name,
          ]);
        }
      }
    }

    if ($populated > 0) {
      $logger->info('Populated field_platform_name on @count jur groups from field_nuxt_config.', [
        '@count' => $populated,
      ]);
    }

    $sandbox['phase'] = 'done';
  }

  // Calculate progress.
  if ($sandbox['phase'] === 'done') {
    $sandbox['#finished'] = 1;
  }
  elseif ($sandbox['phase'] === 'backfill' && ($sandbox['backfill_total'] ?? 0) > 0) {
    $sandbox['#finished'] = $sandbox['backfill_processed'] / $sandbox['backfill_total'];
  }
  else {
    // Still in field creation or populate phase.
    $sandbox['#finished'] = 0;
  }
}
