/**
 * Normalize org jurisdiction references from child jurisdictions to roots.
 */
function markaspot_group_update_11924(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('group');
  $logger = \Drupal::logger('markaspot_group');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'org')
    ->exists('field_jurisdiction')
    ->execute();

  if (empty($ids)) {
    return 'No organisation jurisdiction references found.';
  }

  $updated_groups = 0;
  $updated_values = 0;
  $skipped_groups = 0;

  foreach ($storage->loadMultiple($ids) as $org) {
    if (!$org->hasField('field_jurisdiction')) {
      continue;
    }

    $changed_values = 0;
    foreach (array_keys($org->getTranslationLanguages()) as $langcode) {
      $translation = $org->getTranslation($langcode);
      if ($translation->get('field_jurisdiction')->isEmpty()) {
        continue;
      }

      $current_id = (int) $translation->get('field_jurisdiction')->target_id;
      $root_id = markaspot_group_update_11924_root_jurisdiction_id($current_id);
      if ($root_id === NULL || $root_id === $current_id) {
        continue;
      }

      $translation->set('field_jurisdiction', ['target_id' => $root_id]);
      $changed_values++;
    }

    if ($changed_values === 0) {
      continue;
    }

    try {
      $org->save();
      $updated_groups++;
      $updated_values += $changed_values;
    }
    catch (\Throwable $e) {
      $skipped_groups++;
      $logger->warning('Skipped normalizing org @gid field_jurisdiction: @message', [
        '@gid' => $org->id(),
        '@message' => $e->getMessage(),
      ]);
    }
  }

  return sprintf(
    'Normalized org field_jurisdiction child references: %d values on %d groups, %d groups skipped.',
    $updated_values,
    $updated_groups,
    $skipped_groups,
  );
}

/**
 * Resolves a jurisdiction group ID to its root ancestor.
 */
function markaspot_group_update_11924_root_jurisdiction_id(int $jurisdiction_id): ?int {
  static $root_cache = [];

  if (array_key_exists($jurisdiction_id, $root_cache)) {
    return $root_cache[$jurisdiction_id];
  }

  $storage = \Drupal::entityTypeManager()->getStorage('group');
  $current_id = $jurisdiction_id;
  $seen = [];

  while ($current_id > 0) {
    if (isset($seen[$current_id])) {
      $root_cache[$jurisdiction_id] = NULL;
      return NULL;
    }
    $seen[$current_id] = TRUE;

    $group = $storage->load($current_id);
    if (!$group || $group->bundle() !== 'jur') {
      $root_cache[$jurisdiction_id] = NULL;
      return NULL;
    }

    if (!$group->hasField('field_parent_jurisdiction')
      || $group->get('field_parent_jurisdiction')->isEmpty()) {
      $root_cache[$jurisdiction_id] = $current_id;
      return $current_id;
    }

    $current_id = (int) $group->get('field_parent_jurisdiction')->target_id;
  }

  $root_cache[$jurisdiction_id] = NULL;
  return NULL;
}

/**
 * Ensures jur tenant-admin memberships also carry the jur-member role.
 */
function markaspot_group_update_11925(): string {
  $connection = \Drupal::database();
  $query = $connection->select('group_relationship_field_data', 'fd');
  $query->distinct();
  $query->fields('fd', ['id']);
  $query->innerJoin(
    'group_relationship__group_roles',
    'admin_role',
    'admin_role.entity_id = fd.id AND admin_role.deleted = 0 AND admin_role.langcode = fd.langcode AND admin_role.group_roles_target_id = :admin_role',
    [':admin_role' => 'jur-tenant_admin']
  );
  $query->leftJoin(
    'group_relationship__group_roles',
    'member_role',
    'member_role.entity_id = fd.id AND member_role.deleted = 0 AND member_role.langcode = fd.langcode AND member_role.group_roles_target_id = :member_role',
    [':member_role' => 'jur-member']
  );
  $ids = $query
    ->condition('fd.plugin_id', 'group_membership')
    ->condition('fd.type', 'jur-group_membership')
    ->isNull('member_role.entity_id')
    ->execute()
    ->fetchCol();

  if (empty($ids)) {
    return 'No jur tenant-admin memberships missing jur-member.';
  }

  $storage = \Drupal::entityTypeManager()->getStorage('group_relationship');
  $updated = 0;
  foreach ($storage->loadMultiple($ids) as $relationship) {
    if (!$relationship->hasField('group_roles')) {
      continue;
    }
    $role_ids = array_column($relationship->get('group_roles')->getValue(), 'target_id');
    $relationship->set('group_roles', \Drupal\markaspot_group\MembershipRoleNormalizer::normalize($role_ids, 'jur'));
    $relationship->save();
    $updated++;
  }

  return sprintf('Added jur-member to %d jur tenant-admin membership(s).', $updated);
}

/**
 * Keep obsolete process_apply_group ECA disabled if active config exists.
 */
function markaspot_group_update_11926(): string {
  if (!\Drupal::moduleHandler()->moduleExists('eca')) {
    $config = \Drupal::configFactory()
      ->getEditable('eca.eca.process_apply_group');
    if ($config->isNew()) {
      return 'eca module not installed and eca.eca.process_apply_group active config not found.';
    }
    if ($config->get('status') === FALSE) {
      return 'eca module not installed and eca.eca.process_apply_group is already disabled.';
    }
    $config->set('status', FALSE)->save();
    return 'Disabled obsolete eca.eca.process_apply_group raw config because eca module is not installed.';
  }

  $eca = \Drupal::entityTypeManager()
    ->getStorage('eca')
    ->load('process_apply_group');

  if (!$eca) {
    if (_markaspot_group_rebuild_eca_subscribed_events()) {
      return 'eca.eca.process_apply_group not installed on this tenant - rebuilt ECA subscribed-events state.';
    }
    return 'eca.eca.process_apply_group not installed on this tenant and ECA subscribed-events state was not rebuilt.';
  }

  if (!method_exists($eca, 'status') || !$eca->status()) {
    _markaspot_group_rebuild_eca_subscribed_events();
    return 'eca.eca.process_apply_group is already disabled.';
  }

  $eca->setStatus(FALSE);
  $eca->save();
  _markaspot_group_rebuild_eca_subscribed_events();
  return 'Disabled obsolete eca.eca.process_apply_group.';
}

/**
 * Rebuild ECA subscriptions after removing obsolete process_apply_group.
 */
function markaspot_group_update_11927(): string {
  if (!_markaspot_group_rebuild_eca_subscribed_events()) {
    $pruned = _markaspot_group_prune_obsolete_eca_subscriptions();
    return sprintf(
      'ECA module unavailable or storage does not support rebuilding subscribed events; pruned %d obsolete ECA model(s) from subscribed-events state.',
      $pruned
    );
  }

  $issues = _markaspot_group_obsolete_eca_runtime_issues();
  if (empty($issues)) {
    return 'Rebuilt ECA subscribed-events state; no obsolete process_apply_group references remain.';
  }

  return 'Rebuilt ECA subscribed-events state; remaining obsolete process_apply_group issues: ' . implode('; ', $issues);
}

/**
 * Backfill jurisdiction memberships implied by organisation memberships.
 */
function markaspot_group_update_11928(): string {
  _markaspot_group_ensure_derived_jurisdiction_role();

  $relationship_ids = \Drupal::entityTypeManager()
    ->getStorage('group_relationship')
    ->getQuery()
    ->accessCheck(FALSE)
    ->condition('plugin_id', 'group_membership')
    ->condition('type', 'org-group_membership')
    ->execute();

  if (empty($relationship_ids)) {
    return 'No organisation memberships found for derived jurisdiction backfill.';
  }

  $relationship_storage = \Drupal::entityTypeManager()->getStorage('group_relationship');
  $created = 0;
  $marked = 0;
  $skipped = 0;
  foreach ($relationship_storage->loadMultiple($relationship_ids) as $relationship) {
    if (!$relationship instanceof \Drupal\group\Entity\GroupRelationshipInterface) {
      $skipped++;
      continue;
    }

    $org_group = $relationship->getGroup();
    $user = $relationship->getEntity();
    $jur_group = _markaspot_group_resolve_org_backfill_jurisdiction($org_group);

    if (!$user instanceof \Drupal\user\UserInterface || !$jur_group) {
      $skipped++;
      continue;
    }

    $jur_relationship = \Drupal\group\Entity\GroupMembership::loadSingle($jur_group, $user);
    if ($jur_relationship) {
      if ($jur_relationship->bundle() !== _markaspot_group_update_jurisdiction_membership_bundle($jur_group)) {
        \Drupal::logger('markaspot_group')->error(
          'Skipped derived jurisdiction backfill for org membership @relationship because existing group membership @jur_relationship on jurisdiction @gid has bundle @bundle.',
          [
            '@relationship' => $relationship->id(),
            '@jur_relationship' => $jur_relationship->id(),
            '@gid' => $jur_group->id(),
            '@bundle' => $jur_relationship->bundle(),
          ]
        );
        $skipped++;
        continue;
      }
      if (!$jur_relationship->hasField('group_roles')) {
        $skipped++;
        continue;
      }
      $role_ids = array_column($jur_relationship->get('group_roles')->getValue(), 'target_id');
      $derived_role_id = _markaspot_group_update_derived_jurisdiction_role_id($jur_group);
      if (in_array($derived_role_id, $role_ids, TRUE)) {
        continue;
      }
      $role_ids = array_values(array_filter(
        $role_ids,
        static fn(string $role_id): bool => $role_id !== \Drupal\markaspot_group\MembershipRoleNormalizer::ORG_DERIVED_JUR_ROLE_ID
          || $derived_role_id === \Drupal\markaspot_group\MembershipRoleNormalizer::ORG_DERIVED_JUR_ROLE_ID
      ));
      $role_ids[] = $derived_role_id;
      $jur_relationship->set('group_roles', array_values(array_unique($role_ids)));
      $jur_relationship->save();
      $marked++;
      continue;
    }

    try {
      $jur_group->addMember($user, [
        'group_roles' => [
          _markaspot_group_update_derived_jurisdiction_role_id($jur_group),
        ],
      ]);
      $created++;
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot_group')->error(
        'Failed to backfill jurisdiction membership for user @uid and jurisdiction @gid from organisation membership @relationship: @message',
        [
          '@uid' => $user->id(),
          '@gid' => $jur_group->id(),
          '@relationship' => $relationship->id(),
          '@message' => $e->getMessage(),
        ]
      );
      $skipped++;
    }
  }

  return sprintf(
    'Backfilled %d and marked %d derived jurisdiction membership(s) implied by organisation memberships; skipped %d unresolved row(s).',
    $created,
    $marked,
    $skipped
  );
}

/**
 * Allows jurisdiction members to read boilerplate templates.
 */
function markaspot_group_update_11929(): string {
  $role_storage = \Drupal::entityTypeManager()->getStorage('group_role');
  $permission = 'view group_node:boilerplate entity';
  $role_ids = [
    _markaspot_group_update_derived_jurisdiction_role_id(),
    'jur-moderator',
    'jur-admin',
  ];
  $updated = [];

  foreach ($role_ids as $role_id) {
    /** @var \Drupal\group\Entity\GroupRoleInterface|null $role */
    $role = $role_storage->load($role_id);
    if (!$role || $role->getGroupTypeId() !== _markaspot_group_update_jurisdiction_group_type()) {
      continue;
    }

    $permissions = $role->getPermissions();
    if (in_array($permission, $permissions, TRUE)) {
      continue;
    }

    $permissions[] = $permission;
    $role->set('permissions', $permissions);
    $role->save();
    $updated[] = $role_id;
  }

  if (!$updated) {
    return 'Jurisdiction group roles already allow boilerplate reads.';
  }

  return sprintf(
    'Added boilerplate read permission to %s.',
    implode(', ', $updated)
  );
}

/**
 * Allows jurisdiction members to read public service requests.
 */
function markaspot_group_update_11930(): string {
  $group_type = _markaspot_group_update_jurisdiction_group_type();
  _markaspot_group_ensure_derived_jurisdiction_role();

  $role_storage = \Drupal::entityTypeManager()->getStorage('group_role');
  $permission = 'view group_node:service_request entity';
  $role_ids = [
    $group_type . '-member',
    _markaspot_group_update_derived_jurisdiction_role_id(),
  ];
  $updated = [];
  $skipped = [];

  foreach ($role_ids as $role_id) {
    /** @var \Drupal\group\Entity\GroupRoleInterface|null $role */
    $role = $role_storage->load($role_id);
    if (!$role) {
      $skipped[] = "$role_id (missing)";
      continue;
    }

    if ($role->getGroupTypeId() !== $group_type) {
      $skipped[] = sprintf('%s (group type %s)', $role_id, $role->getGroupTypeId());
      continue;
    }

    $permissions = $role->getPermissions();
    if (in_array($permission, $permissions, TRUE)) {
      continue;
    }

    $permissions[] = $permission;
    $role->set('permissions', $permissions);
    $role->save();
    $updated[] = $role_id;
  }

  if (!$updated && !$skipped) {
    return 'Jurisdiction member service-request visibility already aligned.';
  }

  $messages = [];
  if ($updated) {
    $messages[] = sprintf(
      'Added service-request read permission to %s',
      implode(', ', $updated)
    );
  }
  if ($skipped) {
    $messages[] = sprintf(
      'Skipped unexpected jurisdiction group roles: %s',
      implode(', ', $skipped)
    );
  }

  return implode('; ', $messages) . '.';
}

/**
 * Restores organisation notification mailbox field after org group migration.
 */
function markaspot_group_update_11931(): string {
  $created = [];
  $updated = [];

  if (_markaspot_group_update_ensure_org_head_email_storage()) {
    $created[] = 'group.field_head_organisation_e_mail storage';
  }
  if (_markaspot_group_update_ensure_org_head_email_field()) {
    $created[] = 'group.org.field_head_organisation_e_mail field';
  }
  if (_markaspot_group_update_ensure_org_head_email_form_display()) {
    $updated[] = 'group.org.default form display';
  }

  $migrated_rows = _markaspot_group_update_migrate_org_head_email_table_bundles();
  if ($migrated_rows > 0) {
    $updated[] = sprintf('%d legacy field data row(s)', $migrated_rows);
  }

  if (_markaspot_group_update_prune_legacy_org_head_email_config()) {
    $updated[] = 'legacy group.organisation field config';
  }

  _markaspot_group_update_register_org_head_email_field_map();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  \Drupal::service('cache_tags.invalidator')->invalidateTags(['entity_field_info']);

  if (!$created && !$updated) {
    return 'Organisation notification mailbox field already aligned.';
  }

  $messages = [];
  if ($created) {
    $messages[] = sprintf('Created %s', implode(', ', $created));
  }
  if ($updated) {
    $messages[] = sprintf('Updated %s', implode(', ', $updated));
  }

  return implode('; ', $messages) . '.';
}

/**
 * Ensures the internal derived jur role exists before backfilling.
 */
function _markaspot_group_ensure_derived_jurisdiction_role(): void {
  $group_type = _markaspot_group_update_jurisdiction_group_type();
  $role_id = \Drupal\markaspot_group\MembershipRoleNormalizer::orgDerivedJurRoleId($group_type);
  $role_storage = \Drupal::entityTypeManager()->getStorage('group_role');
  $permissions = [
    'view group',
    'view group_node:boilerplate entity',
    'view group_node:page entity',
    'view group_node:service_request entity',
  ];

  /** @var \Drupal\group\Entity\GroupRoleInterface|null $role */
  $role = $role_storage->load($role_id);
  if ($role) {
    if ($role->getGroupTypeId() !== $group_type) {
      \Drupal::logger('markaspot_group')->error(
        'Existing derived jurisdiction role @role belongs to group type @type and was not changed.',
        [
          '@role' => $role_id,
          '@type' => $role->getGroupTypeId(),
        ]
      );
      return;
    }

    $changed = FALSE;
    $expected_values = [
      'label' => 'Organisation member',
      'weight' => 1,
      'admin' => FALSE,
      'scope' => 'individual',
      'global_role' => NULL,
    ];
    foreach ($expected_values as $field => $expected_value) {
      if ($role->get($field) !== $expected_value) {
        $role->set($field, $expected_value);
        $changed = TRUE;
      }
    }
    $current_permissions = $role->getPermissions();
    foreach ($permissions as $permission) {
      if (!in_array($permission, $current_permissions, TRUE)) {
        $current_permissions[] = $permission;
        $changed = TRUE;
      }
    }
    if ($changed) {
      $role->set('permissions', $current_permissions);
    }
    if ($changed) {
      $role->save();
    }
    return;
  }

  $role_storage->create([
    'id' => $role_id,
    'label' => 'Organisation member',
    'weight' => 1,
    'admin' => FALSE,
    'scope' => 'individual',
    'global_role' => NULL,
    'group_type' => $group_type,
    'permissions' => $permissions,
  ])->save();
}

/**
 * Ensures the group mailbox field storage exists without dropping old tables.
 */
function _markaspot_group_update_ensure_org_head_email_storage(): bool {
  $table_state = _markaspot_group_update_legacy_org_head_email_table_state();
  if ($table_state === 'partial') {
    throw new \RuntimeException('Partial legacy field_head_organisation_e_mail schema found. Restore both group field data and revision tables before running this update.');
  }
  if (\Drupal\field\Entity\FieldStorageConfig::loadByName('group', 'field_head_organisation_e_mail')) {
    return FALSE;
  }

  if ($table_state === 'none') {
    \Drupal\field\Entity\FieldStorageConfig::create(_markaspot_group_update_org_head_email_storage_data())->save();
    return TRUE;
  }

  // Legacy 11.7.x migrations can already have populated data tables. In that
  // case, create only the config entity and keep the existing field tables.
  \Drupal::configFactory()
    ->getEditable('field.storage.group.field_head_organisation_e_mail')
    ->setData(_markaspot_group_update_org_head_email_storage_data())
    ->save(TRUE);

  return TRUE;
}

/**
 * Ensures the org group mailbox field config exists.
 */
function _markaspot_group_update_ensure_org_head_email_field(): bool {
  if (\Drupal\field\Entity\FieldConfig::load('group.org.field_head_organisation_e_mail')) {
    return FALSE;
  }

  $legacy = \Drupal\field\Entity\FieldConfig::load('group.organisation.field_head_organisation_e_mail');
  $data = $legacy
    ? _markaspot_group_update_retarget_org_head_email_field_data($legacy->toArray())
    : _markaspot_group_update_org_head_email_field_data();

  \Drupal\field\Entity\FieldConfig::create($data)->save();

  return TRUE;
}

/**
 * Adds the mailbox field to the org form display when that display exists.
 */
function _markaspot_group_update_ensure_org_head_email_form_display(): bool {
  $config = \Drupal::configFactory()
    ->getEditable('core.entity_form_display.group.org.default');
  if ($config->isNew()) {
    return FALSE;
  }

  $dependencies = $config->get('dependencies.config');
  $dependencies = is_array($dependencies) ? $dependencies : [];
  $changed = FALSE;
  if (!in_array('field.field.group.org.field_head_organisation_e_mail', $dependencies, TRUE)) {
    $dependencies[] = 'field.field.group.org.field_head_organisation_e_mail';
    sort($dependencies);
    $config->set('dependencies.config', $dependencies);
    $changed = TRUE;
  }

  if (!$config->get('content.field_head_organisation_e_mail')) {
    $config->set('content.field_head_organisation_e_mail', [
      'type' => 'email_default',
      'weight' => 7,
      'region' => 'content',
      'settings' => [
        'placeholder' => '',
        'size' => 60,
      ],
      'third_party_settings' => [],
    ]);
    $changed = TRUE;
  }

  if ($changed) {
    $config->save(TRUE);
  }

  return $changed;
}

/**
 * Migrates stored legacy org-mail field rows from organisation to org bundle.
 */
function _markaspot_group_update_migrate_org_head_email_table_bundles(): int {
  $db = \Drupal::database();
  $updated = 0;
  foreach (['group__field_head_organisation_e_mail', 'group_revision__field_head_organisation_e_mail'] as $table) {
    if (!$db->schema()->tableExists($table)) {
      continue;
    }
    $updated += (int) $db->update($table)
      ->fields(['bundle' => 'org'])
      ->condition('bundle', 'organisation')
      ->execute();
  }

  return $updated;
}

/**
 * Gets the legacy org-mail data table state.
 */
function _markaspot_group_update_legacy_org_head_email_table_state(): string {
  $schema = \Drupal::database()->schema();
  $data_exists = $schema->tableExists('group__field_head_organisation_e_mail');
  $revision_exists = $schema->tableExists('group_revision__field_head_organisation_e_mail');
  if ($data_exists && $revision_exists) {
    return 'both';
  }
  if (!$data_exists && !$revision_exists) {
    return 'none';
  }

  return 'partial';
}

/**
 * Checks whether legacy org-mail data tables already exist.
 */
function _markaspot_group_update_legacy_org_head_email_tables_exist(): bool {
  return _markaspot_group_update_legacy_org_head_email_table_state() === 'both';
}

/**
 * Removes stale legacy field config after the org bundle replacement exists.
 */
function _markaspot_group_update_prune_legacy_org_head_email_config(): bool {
  $legacy = \Drupal\field\Entity\FieldConfig::load('group.organisation.field_head_organisation_e_mail');
  if (!$legacy) {
    return FALSE;
  }

  $legacy->delete();
  return TRUE;
}

/**
 * Keeps the low-level bundle field map aligned for JSON:API and Field API.
 */
function _markaspot_group_update_register_org_head_email_field_map(): void {
  $kv = \Drupal::keyValue('entity.definitions.bundle_field_map');
  $fields = $kv->get('group') ?: [];
  if (!is_array($fields)) {
    $fields = [];
  }

  $field_info = $fields['field_head_organisation_e_mail'] ?? [];
  if (!is_array($field_info)) {
    $field_info = [];
  }
  $field_info['type'] = 'email';
  $bundles = $field_info['bundles'] ?? [];
  $bundles = is_array($bundles) ? $bundles : [];
  unset($bundles['organisation']);
  $bundles['org'] = 'org';
  $field_info['bundles'] = $bundles;
  $fields['field_head_organisation_e_mail'] = $field_info;

  $kv->set('group', $fields);
}

/**
 * Builds storage config for the organisation notification mailbox field.
 */
function _markaspot_group_update_org_head_email_storage_data(): array {
  return [
    'langcode' => 'en',
    'status' => TRUE,
    'dependencies' => [
      'module' => ['group'],
    ],
    'id' => 'group.field_head_organisation_e_mail',
    'field_name' => 'field_head_organisation_e_mail',
    'entity_type' => 'group',
    'type' => 'email',
    'settings' => [],
    'module' => 'core',
    'locked' => FALSE,
    'cardinality' => -1,
    'translatable' => FALSE,
    'indexes' => [],
    'persist_with_no_fields' => FALSE,
    'custom_storage' => FALSE,
  ];
}

/**
 * Builds org field config for the organisation notification mailbox field.
 */
function _markaspot_group_update_org_head_email_field_data(): array {
  return [
    'langcode' => 'en',
    'status' => TRUE,
    'dependencies' => [
      'config' => [
        'field.storage.group.field_head_organisation_e_mail',
        'group.type.org',
      ],
    ],
    'id' => 'group.org.field_head_organisation_e_mail',
    'field_name' => 'field_head_organisation_e_mail',
    'entity_type' => 'group',
    'bundle' => 'org',
    'label' => 'Head Organisation E-Mail',
    'description' => 'Use this field for one or multiple addresses for organisation assignment notifications.',
    'required' => FALSE,
    'translatable' => FALSE,
    'default_value' => [],
    'default_value_callback' => '',
    'settings' => [],
    'field_type' => 'email',
  ];
}

/**
 * Retargets legacy group.organisation mailbox config to group.org.
 */
function _markaspot_group_update_retarget_org_head_email_field_data(array $data): array {
  unset($data['uuid']);
  $data['id'] = 'group.org.field_head_organisation_e_mail';
  $data['bundle'] = 'org';

  $dependencies = $data['dependencies']['config'] ?? [];
  $dependencies = is_array($dependencies) ? $dependencies : [];
  $dependencies = array_map(
    static fn(string $dependency): string => $dependency === 'group.type.organisation' ? 'group.type.org' : $dependency,
    $dependencies
  );
  if (!in_array('field.storage.group.field_head_organisation_e_mail', $dependencies, TRUE)) {
    $dependencies[] = 'field.storage.group.field_head_organisation_e_mail';
  }
  if (!in_array('group.type.org', $dependencies, TRUE)) {
    $dependencies[] = 'group.type.org';
  }
  $dependencies = array_values(array_unique($dependencies));
  sort($dependencies);
  $data['dependencies']['config'] = $dependencies;

  return $data;
}

/**
 * Gets the configured jurisdiction group type for update hooks.
 */
function _markaspot_group_update_jurisdiction_group_type(): string {
  $configured = \Drupal::config('markaspot_open311.settings')
    ->get('jurisdiction_group_type');

  return is_string($configured) && $configured !== '' ? $configured : 'jur';
}

/**
 * Gets the membership relationship bundle for a jurisdiction group.
 */
function _markaspot_group_update_jurisdiction_membership_bundle($group = NULL): string {
  $group_type = $group instanceof \Drupal\group\Entity\GroupInterface
    ? $group->bundle()
    : _markaspot_group_update_jurisdiction_group_type();

  return $group_type . '-group_membership';
}

/**
 * Gets the internal derived org-member role ID for a jurisdiction group.
 */
function _markaspot_group_update_derived_jurisdiction_role_id($group = NULL): string {
  $group_type = $group instanceof \Drupal\group\Entity\GroupInterface
    ? $group->bundle()
    : _markaspot_group_update_jurisdiction_group_type();

  return \Drupal\markaspot_group\MembershipRoleNormalizer::orgDerivedJurRoleId($group_type);
}

/**
 * Resolves an org group's root jurisdiction for update 11928.
 */
function _markaspot_group_resolve_org_backfill_jurisdiction($org_group): ?\Drupal\group\Entity\GroupInterface {
  if (!$org_group instanceof \Drupal\group\Entity\GroupInterface
    || $org_group->bundle() !== 'org'
    || !$org_group->hasField('field_jurisdiction')
    || $org_group->get('field_jurisdiction')->isEmpty()) {
    return NULL;
  }

  $jurisdiction_id = (int) $org_group->get('field_jurisdiction')->target_id;
  if ($jurisdiction_id <= 0) {
    return NULL;
  }

  $root_jurisdiction_id = \Drupal::service('markaspot_group.hierarchy_resolver')
    ->getRootJurisdictionId($jurisdiction_id);
  if ($root_jurisdiction_id === NULL) {
    return NULL;
  }

  $jur_group = \Drupal\group\Entity\Group::load($root_jurisdiction_id);
  return $jur_group instanceof \Drupal\group\Entity\GroupInterface
    && $jur_group->bundle() === _markaspot_group_update_jurisdiction_group_type()
    ? $jur_group
    : NULL;
}

/**
 * Implements hook_install().
 *
 * Guarantees the service_request bundle carries field_jurisdiction and
 * field_organisation, which the whole group-assignment machinery
 * (markaspot_group_node_insert / _markaspot_group_set_jurisdiction_field /
 * _markaspot_group_reconcile_service_request_relationships) is gated on.
 *
 * These two bundle fields ship in markaspot_group/config/optional. Optional
 * config is evaluated once, at module-install time, and silently skipped when
 * ANY dependency is not yet present. On a fresh profile install that ordering is
 * not guaranteed, so the fields can be missing -> every hook_node_insert branch
 * no-ops -> service_request nodes are never added to the jurisdiction group ->
 * the GeoReport jurisdiction filter returns 0 and the frontend shows nothing.
 *
 * Mirrors the page-node repair in markaspot_group_update_11904(). Idempotent.
 */
function markaspot_group_install(): void {
  _markaspot_group_ensure_service_request_jurisdiction_fields();
}

/**
 * Ensures field_jurisdiction + field_organisation exist on service_request.
 *
 * Creates the field storages and bundle field instances programmatically when
 * the optional config did not install. Existing-site safe: every step is
 * guarded by an existence check, so on installs where the fields are already
 * present (the normal case) this is a no-op. Skips cleanly when the
 * service_request node type or the group types are not present.
 *
 * @return string[]
 *   Human-readable list of the fields that were created (empty when none).
 */
function _markaspot_group_ensure_service_request_jurisdiction_fields(): array {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_group');
  $created = [];

  // Bail cleanly if the node type is not present yet.
  if (!$etm->getStorage('node_type')->load('service_request')) {
    return $created;
  }

  $jur_type = \Drupal::config('markaspot_open311.settings')->get('jurisdiction_group_type') ?? 'jur';
  $org_type = \Drupal::config('markaspot_group.settings')->get('org_group_type') ?? 'org';

  // Adding a field to the bundle makes core's EntityDisplayRebuilder load every
  // service_request entity display. A display config left structurally
  // incomplete by a failed/partial fresh-install (missing targetEntityType /
  // bundle / mode) makes that load throw and aborts the field creation. Prune
  // such corrupt stubs first; the shipped optional config recreates the valid
  // display. Guarded: only removes configs that are genuinely missing required
  // structural keys, so it never touches a healthy display.
  _markaspot_group_prune_corrupt_service_request_displays();

  $field_storage_storage = $etm->getStorage('field_storage_config');
  $field_config_storage = $etm->getStorage('field_config');

  // --- field_jurisdiction ---------------------------------------------------
  // Storage ships in config/install, so it is normally present already.
  $jur_storage = $field_storage_storage->load('node.field_jurisdiction');
  if (!$jur_storage) {
    $jur_storage = $field_storage_storage->create([
      'field_name' => 'field_jurisdiction',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'group'],
      'cardinality' => -1,
    ]);
    $jur_storage->save();
    $created[] = 'node.field_jurisdiction storage';
  }
  if (!$field_config_storage->load('node.service_request.field_jurisdiction')) {
    $field_config_storage->create([
      'field_storage' => $jur_storage,
      'bundle' => 'service_request',
      'label' => 'Jurisdiction',
      'description' => 'The jurisdiction this service request belongs to. Set automatically on creation.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => [$jur_type => $jur_type],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
    $created[] = 'node.service_request.field_jurisdiction';
    $logger->info('Created field instance node.service_request.field_jurisdiction.');
  }

  // --- field_organisation ---------------------------------------------------
  // Both storage and field ship in config/optional, so either may be missing.
  $org_storage = $field_storage_storage->load('node.field_organisation');
  if (!$org_storage) {
    $org_storage = $field_storage_storage->create([
      'field_name' => 'field_organisation',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'group'],
      'cardinality' => -1,
    ]);
    $org_storage->save();
    $created[] = 'node.field_organisation storage';
  }
  if (!$field_config_storage->load('node.service_request.field_organisation')) {
    $field_config_storage->create([
      'field_storage' => $org_storage,
      'bundle' => 'service_request',
      'label' => 'Organisation',
      'description' => 'The organisation responsible for this service request.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:group',
        'handler_settings' => [
          'target_bundles' => [$org_type => $org_type],
          'sort' => ['field' => 'label', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
    $created[] = 'node.service_request.field_organisation';
    $logger->info('Created field instance node.service_request.field_organisation.');
  }

  if ($created) {
    \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  }

  return $created;
}

/**
 * Repairs structurally incomplete service_request entity display configs.
 *
 * A fresh install can leave a service_request form/view display config that has
 * a content payload but lacks the required structural keys (targetEntityType,
 * bundle, mode). Drupal's EntityDisplayRebuilder loads all displays whenever a
 * field is added to the bundle and throws on such a stub, which would abort
 * _markaspot_group_ensure_service_request_jurisdiction_fields().
 *
 * For each incomplete display this re-imports the shipped definition (restoring
 * the structural keys) when a matching config/optional or config/install YAML
 * exists in any installed module; otherwise it deletes the unusable stub.
 *
 * Guarded: only acts on configs that are actually missing a required key, so a
 * healthy display is never touched. Reads raw config to avoid instantiating the
 * corrupt entity (which is what throws).
 */
function _markaspot_group_prune_corrupt_service_request_displays(): void {
  $config_factory = \Drupal::configFactory();
  $prefixes = [
    'core.entity_form_display.node.service_request.',
    'core.entity_view_display.node.service_request.',
  ];
  $logger = \Drupal::logger('markaspot_group');

  foreach ($prefixes as $prefix) {
    foreach ($config_factory->listAll($prefix) as $name) {
      $data = $config_factory->get($name)->getRawData();
      $incomplete = empty($data['targetEntityType'])
        || empty($data['bundle'])
        || empty($data['mode']);
      if (!$incomplete) {
        continue;
      }

      $shipped = _markaspot_group_find_shipped_config($name);
      if ($shipped !== NULL) {
        if (empty($shipped['uuid']) && !empty($data['uuid'])) {
          $shipped['uuid'] = $data['uuid'];
        }
        if (empty($shipped['uuid'])) {
          $shipped['uuid'] = \Drupal::service('uuid')->generate();
        }
        $config_factory->getEditable($name)->setData($shipped)->save();
        $logger->warning('Repaired incomplete entity display config @name from shipped definition.', ['@name' => $name]);
      }
      else {
        $config_factory->getEditable($name)->delete();
        $logger->warning('Deleted incomplete entity display config @name (missing structural keys, no shipped source found).', ['@name' => $name]);
      }
    }
  }
}

/**
 * Locates a shipped config YAML by name across installed modules and profile.
 *
 * @param string $name
 *   The config object name (without .yml).
 *
 * @return array<string, mixed>|null
 *   The decoded YAML data, or NULL when no shipped source exists.
 */
function _markaspot_group_find_shipped_config(string $name): ?array {
  $extension_path_resolver = \Drupal::service('extension.path.resolver');
  $module_handler = \Drupal::moduleHandler();

  $providers = [];
  foreach (array_keys($module_handler->getModuleList()) as $module) {
    $providers[] = ['module', $module];
  }
  $providers[] = ['profile', 'markaspot'];

  foreach ($providers as [$type, $extension]) {
    try {
      $base = $extension_path_resolver->getPath($type, $extension);
    }
    catch (\Throwable) {
      continue;
    }
    foreach (['/config/optional/', '/config/install/'] as $dir) {
      $file = $base . $dir . $name . '.yml';
      if (is_file($file)) {
        $decoded = Yaml::decode(file_get_contents($file));
        return is_array($decoded) ? $decoded : NULL;
      }
    }
  }

  return NULL;
}

/**
 * Ensure service_request carries field_jurisdiction + field_organisation.
 *
 * Repairs existing sites where the optional bundle fields never installed,
 * which left service_request nodes unable to be assigned to their jurisdiction
 * group (GeoReport jurisdiction filter returned 0). After attaching the fields,
 * backfills field_jurisdiction on any service_request that lacks it and lets the
 * standard node-save reconciler create the missing jur group relationships.
 *
 * Idempotent and existing-site safe: fields are only created when missing, and
 * only nodes with an empty field_jurisdiction are touched. Multi-tenant safe:
 * the jurisdiction is derived per node from its category term's
 * field_jurisdiction (the canonical root link), falling back to the single root
 * jurisdiction only when exactly one exists.
 */
function markaspot_group_update_11932(): string {
  $created = _markaspot_group_ensure_service_request_jurisdiction_fields();

  // If field_jurisdiction is still absent we cannot backfill; report and stop.
  $field_config_storage = \Drupal::entityTypeManager()->getStorage('field_config');
  if (!$field_config_storage->load('node.service_request.field_jurisdiction')) {
    return $created
      ? 'Created ' . implode(', ', $created) . '.'
      : 'service_request field_jurisdiction unavailable; nothing changed.';
  }

  $etm = \Drupal::entityTypeManager();
  $node_storage = $etm->getStorage('node');
  $group_storage = $etm->getStorage('group');

  // Resolve the single root jurisdiction (used only when exactly one exists).
  $jur_type = \Drupal::config('markaspot_open311.settings')->get('jurisdiction_group_type') ?? 'jur';
  $has_parent_field = $etm->getStorage('field_storage_config')->load('group.field_parent_jurisdiction') !== NULL;
  $root_query = $group_storage->getQuery()->accessCheck(FALSE)->condition('type', $jur_type);
  if ($has_parent_field) {
    $root_query->notExists('field_parent_jurisdiction');
  }
  $root_ids = $root_query->execute();
  $single_root_id = count($root_ids) === 1 ? (int) reset($root_ids) : NULL;

  $nids = $node_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'service_request')
    ->notExists('field_jurisdiction')
    ->execute();

  $backfilled = 0;
  foreach ($nids as $nid) {
    $node = $node_storage->load($nid);
    if (!$node instanceof \Drupal\node\NodeInterface || !$node->hasField('field_jurisdiction')) {
      continue;
    }

    // Prefer the category term's field_jurisdiction (canonical root link).
    $jur_id = NULL;
    if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
      $term = $node->get('field_category')->entity;
      if ($term && $term->hasField('field_jurisdiction') && !$term->get('field_jurisdiction')->isEmpty()) {
        $jur_id = (int) $term->get('field_jurisdiction')->target_id;
      }
    }
    if ($jur_id === NULL) {
      $jur_id = $single_root_id;
    }
    if ($jur_id === NULL) {
      // Multiple roots and no category link: do not guess.
      continue;
    }

    $node->set('field_jurisdiction', ['target_id' => $jur_id]);
    // Saving fires markaspot_group_node_update() -> reconciler, which creates
    // the jur group relationship the frontend filters on.
    $node->save();
    $backfilled++;
  }

  $parts = [];
  if ($created) {
    $parts[] = 'Created ' . implode(', ', $created);
  }
  if ($backfilled > 0) {
    $parts[] = sprintf('backfilled field_jurisdiction on %d service request(s)', $backfilled);
  }

  return $parts
    ? implode('; ', $parts) . '.'
    : 'service_request jurisdiction fields already present and all nodes assigned.';
}
