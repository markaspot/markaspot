<?php

/**
 * @file
 * Install, update and uninstall functions for the Mark-a-Spot Emergency module.
 */

use Drupal\markaspot_emergency\Service\EmergencyModeService;

/**
 * Implements hook_install().
 */
function markaspot_emergency_install() {
  // Fields are created automatically from config/install.
  // Clear any leftover runtime state from a previous install.
  \Drupal::state()->delete(EmergencyModeService::STATE_STATUS);
  \Drupal::state()->delete(EmergencyModeService::STATE_ACTIVATED_AT);
  \Drupal::state()->delete(EmergencyModeService::STATE_ACTIVATED_BY);
  \Drupal::state()->delete('markaspot_emergency.original_published_tids');

  // Create emergency categories (unpublished by default) from presets.
  $config = \Drupal::config('markaspot_emergency.settings');
  $presets = $config->get('categories.emergency_presets');
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  if (!empty($presets)) {
    $createdCount = 0;
    foreach ($presets as $preset) {
      $existing = $storage->loadByProperties([
        'vid' => 'service_category',
        'name' => $preset['name'],
      ]);

      if (empty($existing)) {
        $term = $storage->create([
          'vid' => 'service_category',
          'name' => $preset['name'],
          'status' => 0,
          'field_emergency_category' => TRUE,
          'weight' => $preset['weight'] ?? 0,
        ]);

        // Use the canonical field names; skip if field absent.
        if ($term->hasField('field_category_icon') && !empty($preset['icon'])) {
          $term->set('field_category_icon', $preset['icon']);
        }
        if ($term->hasField('field_category_hex') && !empty($preset['color'])) {
          $term->set('field_category_hex', $preset['color']);
        }

        // Assign to first jurisdiction if the field exists (multi-tenant).
        if ($term->hasField('field_jurisdiction')) {
          $jids = \Drupal::entityTypeManager()
            ->getStorage('group')
            ->getQuery()
            ->condition('type', 'jur')
            ->range(0, 1)
            ->accessCheck(FALSE)
            ->execute();
          if (!empty($jids)) {
            $term->set('field_jurisdiction', reset($jids));
          }
        }

        $term->save();
        $createdCount++;
      }
    }

    if ($createdCount > 0) {
      \Drupal::messenger()->addMessage(t('Created @count emergency categories (unpublished).', [
        '@count' => $createdCount,
      ]));
    }
  }

  \Drupal::messenger()->addMessage(t('Mark-a-Spot Emergency module installed successfully.'));
  \Drupal::messenger()->addMessage(t('Emergency categories can now be configured at /admin/config/markaspot/emergency'));
}

/**
 * Implements hook_uninstall().
 *
 * Fields are deleted automatically via dependencies.enforced.module in
 * config/install -- no manual deletion needed here.
 */
function markaspot_emergency_uninstall() {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  // Restore regular categories from State API snapshot before uninstalling.
  $state = \Drupal::state();
  $snapshotKey = 'markaspot_emergency.original_published_tids';
  $snapshot = $state->get($snapshotKey, []);
  if (!empty($snapshot)) {
    $terms = $storage->loadMultiple($snapshot);
    foreach ($terms as $term) {
      if ($term) {
        $term->set('status', 1);
        $term->save();
      }
    }
    \Drupal::messenger()->addMessage(t('Restored @count regular categories to published status from emergency snapshot.', [
      '@count' => count($terms),
    ]));
    $state->delete($snapshotKey);
  }

  // Delete all emergency categories.
  $emergencyTerms = $storage->loadByProperties([
    'vid' => 'service_category',
    'field_emergency_category' => TRUE,
  ]);

  if (!empty($emergencyTerms)) {
    $storage->delete($emergencyTerms);
    \Drupal::messenger()->addMessage(t('Deleted @count emergency categories.', [
      '@count' => count($emergencyTerms),
    ]));
  }

  // Clear all runtime state keys.
  $state->delete(EmergencyModeService::STATE_STATUS);
  $state->delete(EmergencyModeService::STATE_ACTIVATED_AT);
  $state->delete(EmergencyModeService::STATE_ACTIVATED_BY);

  // Delete the global snapshot key and all jurisdiction-scoped variants
  // (e.g. 'markaspot_emergency.original_published_tids.7').
  $state->delete('markaspot_emergency.original_published_tids');
  \Drupal::database()
    ->delete('key_value')
    ->condition('collection', 'state')
    ->condition('name', 'markaspot_emergency.original_published_tids.%', 'LIKE')
    ->execute();

  \Drupal::messenger()->addMessage(t('Mark-a-Spot Emergency module uninstalled successfully.'));
}

/**
 * Implements hook_requirements().
 *
 * Reads runtime status from State API (not Config) so it is accurate even
 * after a deploy that resets config/sync.
 */
function markaspot_emergency_requirements($phase) {
  $requirements = [];

  if ($phase === 'runtime') {
    /** @var \Drupal\markaspot_emergency\Service\EmergencyModeService $service */
    $service = \Drupal::service('markaspot_emergency.service');
    $isActive = $service->isActive();

    if ($isActive) {
      $config = \Drupal::config('markaspot_emergency.settings');
      $activatedAt = $service->getActivatedAt();
      $activatedByUid = $service->getActivatedBy();
      $activatedBy = $activatedByUid
        ? \Drupal::entityTypeManager()->getStorage('user')->load($activatedByUid)
        : NULL;

      $requirements['markaspot_emergency_status'] = [
        'title' => t('Emergency Mode'),
        'value' => t('ACTIVE'),
        'severity' => REQUIREMENT_WARNING,
        'description' => t('Emergency mode is currently active. Activated @time by @user. Manage at /admin/config/markaspot/emergency', [
          '@time' => $activatedAt ? \Drupal::service('date.formatter')->format($activatedAt) : t('Unknown'),
          '@user' => $activatedBy ? $activatedBy->getDisplayName() : t('Unknown'),
        ]),
      ];

      $autoDeactivate = $config->get('auto_deactivate.enabled');
      $duration = (int) $config->get('auto_deactivate.duration');

      if ($autoDeactivate && $activatedAt && $duration) {
        $deactivateTime = $activatedAt + ($duration * 3600);
        if ($deactivateTime > time()) {
          $requirements['markaspot_emergency_status']['description'] .= t(' Auto-deactivation scheduled for @time.', [
            '@time' => \Drupal::service('date.formatter')->format($deactivateTime),
          ]);
        }
      }
    }
    else {
      $requirements['markaspot_emergency_status'] = [
        'title' => t('Emergency Mode'),
        'value' => t('Inactive'),
        'severity' => REQUIREMENT_OK,
        'description' => t('Emergency mode is not active. Configure at /admin/config/markaspot/emergency'),
      ];
    }
  }

  return $requirements;
}
