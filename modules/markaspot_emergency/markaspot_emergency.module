<?php

/**
 * @file
 * Mark-a-Spot Emergency module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityFormDisplayInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\markaspot_emergency\Hook\EmergencyEntityHooks;

/**
 * Implements hook_help().
 */
function markaspot_emergency_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.markaspot_emergency':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Mark-a-Spot Emergency module provides emergency mode functionality for rapid disaster response. It allows administrators to quickly switch the system into emergency mode, which unpublishes regular categories and activates emergency-specific categories optimized for crisis situations.') . '</p>';
      $output .= '<h3>' . t('Features') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Instant emergency mode activation') . '</li>';
      $output .= '<li>' . t('Batch category management (unpublish regular, publish emergency)') . '</li>';
      $output .= '<li>' . t('Pre-configured emergency category templates') . '</li>';
      $output .= '<li>' . t('Lite UI mode for low-bandwidth situations') . '</li>';
      $output .= '<li>' . t('API endpoints for frontend integration') . '</li>';
      $output .= '<li>' . t('Automatic mode deactivation after set duration') . '</li>';
      $output .= '</ul>';
      return $output;

    case 'markaspot_emergency.settings':
      return '<p>' . t('Configure emergency mode settings including activation triggers, category presets, and auto-deactivation rules.') . '</p>';
  }
}

/**
 * Implements hook_entity_form_display_alter().
 *
 * The service_category form display is owned by service_request. Applying the
 * widget at runtime makes the mode list configurable without replacing or
 * deleting that shared display on uninstall.
 */
function markaspot_emergency_entity_form_display_alter(EntityFormDisplayInterface $form_display, array $context): void {
  if ($form_display->getTargetEntityTypeId() !== 'taxonomy_term'
    || $form_display->getTargetBundle() !== 'service_category') {
    return;
  }

  $form_display->setComponent('field_emergency_modes', [
    'type' => 'options_buttons',
    'weight' => 15,
    'region' => 'content',
    'settings' => [],
    'third_party_settings' => [],
  ]);
  $form_display->removeComponent('field_emergency_category');
}

/**
 * Implements hook_entity_presave().
 *
 * Drupal 10 invokes this compatibility bridge. Drupal 11 discovers the native
 * attribute hook and skips this wrapper through #[LegacyHook].
 */
#[LegacyHook]
function markaspot_emergency_entity_presave(EntityInterface $entity): void {
  /** @var \Drupal\markaspot_emergency\Hook\EmergencyEntityHooks $hooks */
  $hooks = \Drupal::service(EmergencyEntityHooks::class);
  $hooks->entityPresave($entity);
}

/**
 * Implements hook_cron().
 *
 * Checks for auto-deactivation of emergency mode. Status is read from State
 * (not Config) so it survives deploys without being reset.
 */
function markaspot_emergency_cron() {
  /** @var \Drupal\markaspot_emergency\Service\EmergencyModeService $service */
  $service = \Drupal::service('markaspot_emergency.service');

  try {
    /** @var \Drupal\markaspot_emergency\Service\EmergencySubmissionIdempotencyLedger $ledger */
    $ledger = \Drupal::service('markaspot_emergency.submission_idempotency_ledger');
    $ledger->purgeExpired();
  }
  catch (\Throwable $exception) {
    \Drupal::logger('markaspot_emergency')->error(
      'Failed to purge expired emergency submission idempotency records: @message',
      ['@message' => $exception->getMessage()],
    );
  }

  foreach ($service->getActiveJurisdictionIds() as $rootId) {
    try {
      $policy = $service->getPolicy($rootId);
      $autoDeactivate = $policy['auto_deactivate']['enabled'];
      $duration = $policy['auto_deactivate']['duration'];
      if (!$autoDeactivate || $duration <= 0) {
        continue;
      }

      $activatedAt = $service->getActivatedAt($rootId);
      if ($activatedAt === NULL || time() < $activatedAt + ($duration * 3600)) {
        continue;
      }

      $service->deactivate($rootId);
      \Drupal::logger('markaspot_emergency')->notice(
        'Emergency mode auto-deactivated for root jurisdiction @jurisdiction after @hours hours.',
        [
          '@jurisdiction' => $rootId,
          '@hours' => $duration,
        ]
      );
    }
    catch (\Throwable $exception) {
      \Drupal::logger('markaspot_emergency')->error(
        'Failed to auto-deactivate root jurisdiction @jurisdiction: @message',
        [
          '@jurisdiction' => $rootId,
          '@message' => $exception->getMessage(),
        ]
      );
    }
  }
}
