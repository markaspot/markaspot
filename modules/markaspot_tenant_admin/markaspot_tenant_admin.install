<?php

/**
 * @file
 * Install/update functions for markaspot_tenant_admin.
 */

declare(strict_types=1);

use Drupal\user\UserInterface;
use Drupal\user\Entity\Role;
use Drupal\group\Entity\GroupMembership;
use Drupal\group\Entity\GroupRelationshipInterface;
use Drupal\markaspot_tenant_admin\TenantAdminHelper;
use Drupal\user\Entity\User;

/**
 * Grant AI and dashboard permissions to tenant_admin role.
 */
function markaspot_tenant_admin_update_10001(): void {
  $role = Role::load('tenant_admin');
  if (!$role) {
    return;
  }

  $permissions = [
    'access ai insights',
    'review ai duplicates',
    'view ai sentiment',
    'access dashboard kpis',
  ];

  foreach ($permissions as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
}

/**
 * Remove 'bypass node access' from tenant_admin role.
 *
 * This permission bypassed Group module access control, causing a
 * cross-tenant data leak where tenant admins could view unpublished
 * service requests from other jurisdictions.
 */
function markaspot_tenant_admin_update_10002(): void {
  $role = Role::load('tenant_admin');
  if (!$role) {
    return;
  }

  if ($role->hasPermission('bypass node access')) {
    $role->revokePermission('bypass node access');
    $role->save();
    \Drupal::logger('markaspot_tenant_admin')->notice(
      'Revoked "bypass node access" from tenant_admin role (cross-tenant security fix).'
    );
  }
}

/**
 * Remove global 'edit any page/service_request content' from tenant_admin.
 *
 * These core permissions bypass Group module access control, allowing
 * cross-tenant node editing. Group permissions (update any group_node:*)
 * correctly scope access to the user's jurisdiction.
 */
function markaspot_tenant_admin_update_10003(): void {
  $role = Role::load('tenant_admin');
  if (!$role) {
    return;
  }

  $revoked = [];
  $dangerous_permissions = [
    'edit any page content',
    'edit any service_request content',
  ];

  foreach ($dangerous_permissions as $permission) {
    if ($role->hasPermission($permission)) {
      $role->revokePermission($permission);
      $revoked[] = $permission;
    }
  }

  if (!empty($revoked)) {
    $role->save();
    \Drupal::logger('markaspot_tenant_admin')->warning(
      'Revoked cross-tenant permissions from tenant_admin: @perms',
      ['@perms' => implode(', ', $revoked)]
    );
  }
}

/**
 * Implements hook_install().
 *
 * Scans existing jur-admin memberships and retroactively grants the
 * tenant_admin Drupal role to those users.
 */
function markaspot_tenant_admin_install(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $group_storage = $entity_type_manager->getStorage('group');

  // Load all jur groups.
  $jur_groups = $group_storage->loadByProperties(['type' => 'jur']);
  if (empty($jur_groups)) {
    return;
  }

  $synced_users = [];

  foreach ($jur_groups as $group) {
    // Load memberships with jur-tenant_admin role in this group.
    $memberships = GroupMembership::loadByGroup($group, [TenantAdminHelper::GROUP_ROLE_ID]);

    foreach ($memberships as $membership) {
      assert($membership instanceof GroupRelationshipInterface);
      $user_entity = $membership->getEntity();

      if (!$user_entity instanceof UserInterface) {
        continue;
      }

      $uid = (int) $user_entity->id();
      if (isset($synced_users[$uid])) {
        continue;
      }

      $user = User::load($uid);
      if ($user && !$user->hasRole('tenant_admin')) {
        $user->addRole('tenant_admin');
        $user->save();
        $synced_users[$uid] = $user->getAccountName();
      }
    }
  }

  if (!empty($synced_users)) {
    \Drupal::messenger()->addStatus(t('Granted tenant_admin role to @count existing jur-admin users: @names.', [
      '@count' => count($synced_users),
      '@names' => implode(', ', $synced_users),
    ]));
  }
}
