<?php

/**
 * @file
 * Install/update functions for markaspot_tenant_admin.
 */

declare(strict_types=1);

use Drupal\user\UserInterface;
use Drupal\user\Entity\Role;
use Drupal\group\Entity\GroupMembership;
use Drupal\group\Entity\GroupRelationshipInterface;
use Drupal\markaspot_tenant_admin\TenantAdminHelper;
use Drupal\user\Entity\User;

/**
 * Grant AI and dashboard permissions to tenant_admin role.
 */
function markaspot_tenant_admin_update_10001(): void {
  $role = Role::load('tenant_admin');
  if (!$role) {
    return;
  }

  $permissions = [
    'access ai insights',
    'review ai duplicates',
    'view ai sentiment',
    'access dashboard kpis',
  ];

  foreach ($permissions as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
}

/**
 * Remove 'bypass node access' from tenant_admin role.
 *
 * This permission bypassed Group module access control, causing a
 * cross-tenant data leak where tenant admins could view unpublished
 * service requests from other jurisdictions.
 */
function markaspot_tenant_admin_update_10002(): void {
  $role = Role::load('tenant_admin');
  if (!$role) {
    return;
  }

  if ($role->hasPermission('bypass node access')) {
    $role->revokePermission('bypass node access');
    $role->save();
    \Drupal::logger('markaspot_tenant_admin')->notice(
      'Revoked "bypass node access" from tenant_admin role (cross-tenant security fix).'
    );
  }
}

/**
 * Remove global node edit/delete permissions from tenant_admin.
 *
 * Core permissions like 'edit any X content' bypass Group module access
 * control, allowing cross-tenant node editing. Group permissions
 * (update/delete any group_node:*) correctly scope access per jurisdiction.
 */
function markaspot_tenant_admin_update_10003(): void {
  $role = Role::load('tenant_admin');
  if (!$role) {
    return;
  }

  $revoked = [];
  $dangerous_permissions = [
    'edit any page content',
    'edit any service_request content',
    'edit own service_request content',
    'edit any boilerplate content',
    'edit own boilerplate content',
    'delete any boilerplate content',
    'delete own boilerplate content',
  ];

  foreach ($dangerous_permissions as $permission) {
    if ($role->hasPermission($permission)) {
      $role->revokePermission($permission);
      $revoked[] = $permission;
    }
  }

  if (!empty($revoked)) {
    $role->save();
    \Drupal::logger('markaspot_tenant_admin')->warning(
      'Revoked cross-tenant permissions from tenant_admin: @perms',
      ['@perms' => implode(', ', $revoked)]
    );
  }
}

/**
 * Remove global service-category edit permission from authenticated users.
 *
 * Plain authenticated users must not be able to patch service_category terms
 * through JSON:API. Tenant-scoped taxonomy management is handled by the
 * tenant_admin and editorial roles plus markaspot_tenant_admin access hooks.
 */
function markaspot_tenant_admin_update_10004(): void {
  $role = Role::load('authenticated');
  if (!$role || !$role->hasPermission('edit terms in service_category')) {
    return;
  }

  $role->revokePermission('edit terms in service_category');
  $role->save();
  \Drupal::logger('markaspot_tenant_admin')->warning(
    'Revoked "edit terms in service_category" from authenticated role.'
  );
}

/**
 * Implements hook_install().
 *
 * Scans existing jur-admin memberships and retroactively grants the
 * tenant_admin Drupal role to those users.
 */
function markaspot_tenant_admin_install(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $group_storage = $entity_type_manager->getStorage('group');

  // Load all jur groups.
  $jur_groups = $group_storage->loadByProperties(['type' => 'jur']);
  if (empty($jur_groups)) {
    return;
  }

  $synced_users = [];

  foreach ($jur_groups as $group) {
    // Load memberships with jur-tenant_admin role in this group.
    $memberships = GroupMembership::loadByGroup($group, [TenantAdminHelper::GROUP_ROLE_ID]);

    foreach ($memberships as $membership) {
      assert($membership instanceof GroupRelationshipInterface);
      $user_entity = $membership->getEntity();

      if (!$user_entity instanceof UserInterface) {
        continue;
      }

      $uid = (int) $user_entity->id();
      if (isset($synced_users[$uid])) {
        continue;
      }

      $user = User::load($uid);
      if ($user && !$user->hasRole('tenant_admin')) {
        $user->addRole('tenant_admin');
        $user->save();
        $synced_users[$uid] = $user->getAccountName();
      }
    }
  }

  if (!empty($synced_users)) {
    \Drupal::messenger()->addStatus(t('Granted tenant_admin role to @count existing jur-admin users: @names.', [
      '@count' => count($synced_users),
      '@names' => implode(', ', $synced_users),
    ]));
  }
}

/**
 * Grant field_sentiment view permissions to tenant_admin.
 *
 * field_sentiment uses field_permissions with permission_type: custom,
 * generating discrete "view field_sentiment" / "view own field_sentiment"
 * permissions. Without these, JSON:API omits the sentiment value from the
 * node--service_request collection response even when the user holds the
 * route-level "view ai sentiment" permission (which only gates the dedicated
 * SentimentController routes). This fix brings the live DB role in line with
 * the canonical config/optional/user.role.tenant_admin.yml.
 */
function markaspot_tenant_admin_update_10005(): void {
  $role = Role::load('tenant_admin');
  if (!$role) {
    return;
  }

  $permissions = [
    'view field_sentiment',
    'view own field_sentiment',
  ];

  $changed = FALSE;
  foreach ($permissions as $permission) {
    if (!$role->hasPermission($permission)) {
      $role->grantPermission($permission);
      $changed = TRUE;
    }
  }

  if ($changed) {
    $role->save();
    \Drupal::logger('markaspot_tenant_admin')->notice('Granted field_sentiment view permissions to tenant_admin.');
  }
}
