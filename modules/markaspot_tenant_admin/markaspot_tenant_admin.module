<?php

/**
 * @file
 * Mark-a-Spot Tenant Admin module.
 *
 * Provides per-jurisdiction taxonomy management for tenant administrators.
 * Syncs the jur-admin group role to the tenant_admin Drupal role, filters
 * taxonomy overviews by jurisdiction, and auto-fills field_jurisdiction
 * on taxonomy term forms.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityPublishedInterface;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\group\Entity\Group;
use Drupal\group\Entity\GroupRelationshipInterface;
use Drupal\markaspot_tenant_admin\TenantAdminHelper;
use Drupal\user\Entity\User;
use Drupal\user\UserInterface;

/**
 * Implements hook_ENTITY_TYPE_insert() for group_relationship entities.
 *
 * When a user is added as jur-admin to a jurisdiction group, automatically
 * grant the tenant_admin Drupal role.
 */
function markaspot_tenant_admin_group_relationship_insert(GroupRelationshipInterface $relationship): void {
  _markaspot_tenant_admin_sync_role($relationship, 'insert');
}

/**
 * Implements hook_ENTITY_TYPE_update() for group_relationship entities.
 *
 * When a membership's group roles change, sync tenant_admin accordingly.
 */
function markaspot_tenant_admin_group_relationship_update(GroupRelationshipInterface $relationship): void {
  _markaspot_tenant_admin_sync_role($relationship, 'update');
}

/**
 * Implements hook_ENTITY_TYPE_delete() for group_relationship entities.
 *
 * When a jur-admin membership is removed and the user has no remaining
 * jur-admin memberships, remove the tenant_admin Drupal role.
 */
function markaspot_tenant_admin_group_relationship_delete(GroupRelationshipInterface $relationship): void {
  _markaspot_tenant_admin_sync_role($relationship, 'delete');
}

/**
 * Syncs the jurisdiction tenant-admin group role to the Drupal role.
 *
 * @param \Drupal\group\Entity\GroupRelationshipInterface $relationship
 *   The group relationship entity.
 * @param string $operation
 *   One of 'insert', 'update', or 'delete'.
 */
function _markaspot_tenant_admin_sync_role(GroupRelationshipInterface $relationship, string $operation): void {
  // Only process membership relationships in jurisdiction groups.
  if ($relationship->getPluginId() !== 'group_membership') {
    return;
  }
  $jur_type = \Drupal::config('markaspot_open311.settings')
    ->get('jurisdiction_group_type') ?? 'jur';
  if ($relationship->getGroup()->bundle() !== $jur_type) {
    return;
  }

  $user_entity = $relationship->getEntity();
  if (!$user_entity instanceof UserInterface) {
    return;
  }

  // Reload the user to ensure fresh role state.
  $user = User::load($user_entity->id());
  if (!$user) {
    return;
  }

  // Check if this membership has the configured tenant-admin role.
  $group_roles = array_column(
    $relationship->get('group_roles')->getValue(),
    'target_id'
  );
  $has_jur_admin = (bool) array_intersect(
    TenantAdminHelper::getTenantAdminRoleIds(),
    $group_roles
  );

  if ($operation === 'delete' || ($operation === 'update' && !$has_jur_admin)) {
    // Membership removed or tenant-admin role removed from membership.
    // Check if user still has tenant-admin in any other jurisdiction group.
    $exclude_id = ($operation === 'delete') ? (int) $relationship->id() : NULL;
    $still_has_admin = TenantAdminHelper::userHasJurAdminInAnyGroup($user, $exclude_id);

    if (!$still_has_admin && $user->hasRole('tenant_admin')) {
      $user->removeRole('tenant_admin');
      $user->save();
      \Drupal::logger('markaspot_tenant_admin')->notice(
        'Removed tenant_admin role from user @name (no remaining jurisdiction tenant-admin memberships).',
        ['@name' => $user->getAccountName()]
      );
    }
  }
  elseif ($has_jur_admin && !$user->hasRole('tenant_admin')) {
    $user->addRole('tenant_admin');
    $user->save();
    \Drupal::logger('markaspot_tenant_admin')->notice(
      'Granted tenant_admin role to user @name (jurisdiction tenant-admin in @group).',
      [
        '@name' => $user->getAccountName(),
        '@group' => $relationship->getGroup()->label(),
      ]
    );
  }
}

/**
 * Implements hook_query_TAG_alter() for taxonomy_term_access.
 *
 * Filters taxonomy term queries to show only terms belonging to the current
 * user's jurisdictions. Full Drupal admins are unaffected.
 *
 * Child jurisdictions inherit taxonomy terms from their root parent, so the
 * filter resolves each direct jurisdiction to its full ancestor tree via
 * JurisdictionHierarchyResolver::getTermJurisdictionIds().
 */
function markaspot_tenant_admin_query_taxonomy_term_access_alter(AlterableInterface $query): void {
  $current_user = \Drupal::currentUser();

  // Full admins see everything.
  if ($current_user->hasPermission('administer taxonomy')) {
    return;
  }

  // Only filter for tenant_admin users.
  if (!in_array('tenant_admin', $current_user->getRoles(), TRUE)) {
    return;
  }

  $jur_ids = TenantAdminHelper::getUserJurisdictionIds($current_user);
  if (empty($jur_ids)) {
    // No jurisdictions: add an impossible condition to show nothing.
    $query->where('1 = 0');
    return;
  }

  // Resolve each direct jurisdiction to include the full tree (root + all
  // descendants). Child jurisdictions inherit their root parent's taxonomy
  // terms, so a Queens Park Ward admin (id=10) also needs to see BCP
  // Council's terms (id=8).
  $resolver = \Drupal::service('markaspot_group.hierarchy_resolver');
  $all_jur_ids = [];
  foreach ($jur_ids as $jur_id) {
    $all_jur_ids = array_merge($all_jur_ids, $resolver->getTermJurisdictionIds($jur_id));
  }
  $jur_ids = array_unique($all_jur_ids);

  // Find the base table alias dynamically. TermStorage::loadTree() uses 't',
  // but getNodeTerms() uses 'td' and Views may use other aliases.
  $tables = $query->getTables();
  $base_alias = NULL;
  foreach ($tables as $alias => $info) {
    if ($info['table'] === 'taxonomy_term_field_data') {
      $base_alias = $alias;
      break;
    }
  }
  if (!$base_alias) {
    // Cannot safely alter this query (e.g., no taxonomy_term_field_data table).
    return;
  }

  // Join field_jurisdiction and filter to user's jurisdictions.
  $query->leftJoin(
    'taxonomy_term__field_jurisdiction',
    'fj',
    "[$base_alias].[tid] = [fj].[entity_id]"
  );

  // Show terms belonging to user's jurisdictions OR unassigned terms.
  $or = $query->orConditionGroup()
    ->condition('fj.field_jurisdiction_target_id', $jur_ids, 'IN')
    ->isNull('fj.field_jurisdiction_target_id');
  $query->condition($or);
}

/**
 * Implements hook_form_alter().
 *
 * Pre-fills and restricts field_jurisdiction on taxonomy term forms for
 * tenant admin users.
 */
function markaspot_tenant_admin_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $target_forms = [
    'taxonomy_term_service_category_form',
    'taxonomy_term_service_status_form',
  ];
  if (!in_array($form_id, $target_forms, TRUE)) {
    return;
  }

  $current_user = \Drupal::currentUser();

  // Full admins keep full control.
  if ($current_user->hasPermission('administer taxonomy')) {
    return;
  }

  // Only alter for tenant_admin users.
  if (!in_array('tenant_admin', $current_user->getRoles(), TRUE)) {
    return;
  }

  $jur_ids = TenantAdminHelper::getUserJurisdictionIds($current_user);
  if (empty($jur_ids)) {
    return;
  }

  // Ensure field_jurisdiction exists in the form.
  if (!isset($form['field_jurisdiction'])) {
    return;
  }

  $term = $form_state->getFormObject()->getEntity();

  if (count($jur_ids) === 1) {
    // Single jurisdiction: auto-set and lock.
    $jur_id = reset($jur_ids);
    $group = Group::load($jur_id);

    if ($group) {
      // Hide the original widget and show a read-only display.
      $form['field_jurisdiction']['#access'] = FALSE;

      $form['field_jurisdiction_display'] = [
        '#type' => 'item',
        '#title' => t('Jurisdiction'),
        '#markup' => $group->label(),
        '#weight' => $form['field_jurisdiction']['#weight'] ?? 8,
      ];

      // For new terms or terms without jurisdiction, set the default.
      if ($term->isNew() || $term->get('field_jurisdiction')->isEmpty()) {
        $form['field_jurisdiction']['widget'][0]['target_id']['#default_value'] = $group;
      }

      // Ensure the value is always submitted even when hidden.
      $form['field_jurisdiction_value'] = [
        '#type' => 'hidden',
        '#value' => $jur_id,
      ];
      $form['#validate'][] = '_markaspot_tenant_admin_set_jurisdiction';
    }
  }
  else {
    // Multiple jurisdictions: replace autocomplete with select.
    $options = [];
    foreach (Group::loadMultiple($jur_ids) as $group) {
      $options[$group->id()] = $group->label();
    }

    $default_value = NULL;
    if (!$term->isNew() && !$term->get('field_jurisdiction')->isEmpty()) {
      $default_value = $term->get('field_jurisdiction')->target_id;
    }

    // Replace the widget entirely.
    $weight = $form['field_jurisdiction']['#weight'] ?? 8;
    $form['field_jurisdiction'] = [
      '#type' => 'select',
      '#title' => t('Jurisdiction'),
      '#options' => $options,
      '#default_value' => $default_value,
      '#required' => TRUE,
      '#weight' => $weight,
    ];
    $form['#validate'][] = '_markaspot_tenant_admin_set_jurisdiction_from_select';
  }

  // Always add server-side validation.
  $form['#validate'][] = '_markaspot_tenant_admin_validate_jurisdiction';
}

/**
 * Validation callback: sets field_jurisdiction from hidden value.
 */
function _markaspot_tenant_admin_set_jurisdiction(array &$form, FormStateInterface $form_state): void {
  $jur_id = $form_state->getValue('field_jurisdiction_value');
  if ($jur_id) {
    $form_state->setValue('field_jurisdiction', [['target_id' => $jur_id]]);
  }
}

/**
 * Validation callback: sets field_jurisdiction from select widget.
 */
function _markaspot_tenant_admin_set_jurisdiction_from_select(array &$form, FormStateInterface $form_state): void {
  $jur_id = $form_state->getValue('field_jurisdiction');
  if ($jur_id && !is_array($jur_id)) {
    $form_state->setValue('field_jurisdiction', [['target_id' => $jur_id]]);
  }
}

/**
 * Validation callback: ensures tenant admin can only set allowed jurisdictions.
 */
function _markaspot_tenant_admin_validate_jurisdiction(array &$form, FormStateInterface $form_state): void {
  $current_user = \Drupal::currentUser();
  $jur_ids = TenantAdminHelper::getUserJurisdictionIds($current_user);

  $field_value = $form_state->getValue('field_jurisdiction');
  if (empty($field_value)) {
    return;
  }

  // Extract target_id from field value.
  $target_id = NULL;
  if (is_array($field_value) && isset($field_value[0]['target_id'])) {
    $target_id = (int) $field_value[0]['target_id'];
  }

  if ($target_id && !in_array($target_id, $jur_ids, TRUE)) {
    $form_state->setErrorByName('field_jurisdiction', t('You can only assign terms to jurisdictions you administer.'));
  }
}

/**
 * Implements hook_entity_field_access().
 *
 * Grants jurisdiction-scoped write access to the node 'status' field
 * (published/unpublished) for tenant admins AND moderators on the
 * page + service_request bundles. Without this, JSON:API rejects
 * POST/PATCH requests that include the status field because the core
 * 'administer node published status' permission is not granted globally
 * (which would be a cross-tenant security risk in a multi-tenant setup).
 *
 * Coverage:
 *  - bundles: page, service_request
 *  - Drupal-site roles: tenant_admin, moderator
 *  - jurisdiction-scope: user must hold a jur-tenant_admin OR jur-moderator
 *    group role on the node's jurisdiction (see
 *    TenantAdminHelper::getUserPublishCapableJurisdictionIds).
 *  - editorial_board: not handled here; that role has the global core
 *    'administer nodes' permission already.
 */
function markaspot_tenant_admin_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResult {
  // Only handle edit operations on the status field.
  if ($operation !== 'edit' || $field_definition->getName() !== 'status') {
    return AccessResult::neutral();
  }

  // Only for node entities of supported bundles.
  $supported_bundles = ['page', 'service_request'];
  $bundle = $field_definition->getTargetBundle();
  if ($field_definition->getTargetEntityTypeId() !== 'node' || !in_array($bundle, $supported_bundles, TRUE)) {
    return AccessResult::neutral();
  }

  // Only for Drupal-site roles allowed to publish/unpublish in their
  // jurisdiction. Editorial_board is excluded here because the global
  // 'administer nodes' permission already covers it via core.
  $privileged_roles = ['tenant_admin', 'moderator'];
  if (empty(array_intersect($privileged_roles, $account->getRoles()))) {
    return AccessResult::neutral();
  }

  // For new nodes (POST), allow status if user has create-content for
  // the bundle. Cross-jurisdiction creation is prevented at node access
  // level by the Group module ('create group_node:<bundle> entity').
  if ($items === NULL || $items->getEntity()->isNew()) {
    return AccessResult::allowedIf($account->hasPermission("create $bundle content"))
      ->cachePerPermissions()
      ->addCacheContexts(['user.group_permissions']);
  }

  // For existing nodes (PATCH), check jurisdiction membership.
  // Use the original (persisted) entity to prevent a TOCTOU bypass where
  // an attacker PATCHes field_jurisdiction + status in a single request.
  $node = $items->getEntity();
  $check_node = $node->original ?? $node;
  if ($check_node->hasField('field_jurisdiction') && !$check_node->get('field_jurisdiction')->isEmpty()) {
    $node_jur_id = (int) $check_node->get('field_jurisdiction')->target_id;
    $user_jur_ids = TenantAdminHelper::getUserPublishCapableJurisdictionIds($account);

    if (in_array($node_jur_id, $user_jur_ids, TRUE)) {
      return AccessResult::allowed()
        ->addCacheableDependency($check_node)
        ->cachePerPermissions()
        ->addCacheContexts(['user.group_permissions']);
    }

    // Node belongs to a different jurisdiction: deny explicitly.
    return AccessResult::forbidden('Node belongs to a different jurisdiction.')
      ->addCacheableDependency($check_node)
      ->cachePerPermissions()
      ->addCacheContexts(['user.group_permissions']);
  }

  // Node has no jurisdiction: deny. Unassigned nodes are shared/system
  // content; only site admins may change their published status.
  return AccessResult::forbidden('Node has no jurisdiction; only site admins may change status.')
    ->cachePerPermissions()
    ->addCacheContexts(['user.group_permissions']);
}

/**
 * Implements hook_taxonomy_term_access().
 *
 * Grants tenant admins view access to unpublished terms in managed
 * vocabularies (service_category, service_status). Without this, Drupal's
 * TermAccessControlHandler denies view access to unpublished terms for
 * non-admins, which blocks the content_translation "Translate" operation
 * link from appearing.
 */
function markaspot_tenant_admin_taxonomy_term_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResult {
  $managed_vocabs = ['service_category', 'service_status'];
  if (!in_array($entity->bundle(), $managed_vocabs, TRUE)) {
    return AccessResult::neutral();
  }

  if (in_array($operation, ['create', 'update', 'delete'], TRUE)) {
    $scope_access = _markaspot_tenant_admin_taxonomy_write_scope_access($entity, $account);
    if ($scope_access->isForbidden()) {
      return $scope_access;
    }

    if ($operation === 'delete' && $entity->bundle() === 'service_status') {
      return $scope_access->andIf(_markaspot_tenant_admin_service_status_delete_access($entity));
    }

    return $scope_access;
  }

  // Only handle the 'view' operation for managed vocabularies.
  if ($operation !== 'view') {
    return AccessResult::neutral();
  }

  // Only apply to tenant_admin users.
  if (!in_array('tenant_admin', $account->getRoles(), TRUE)) {
    return AccessResult::neutral();
  }

  // Grant view access to unpublished terms so the taxonomy overview and
  // translation operations work correctly. Only grant access if the term
  // belongs to the user's jurisdiction or is unassigned (shared).
  if (!$entity->isPublished()) {
    $jur_ids = TenantAdminHelper::getUserJurisdictionIds($account);
    $term_jur = $entity->hasField('field_jurisdiction') && !$entity->get('field_jurisdiction')->isEmpty()
      ? (int) $entity->get('field_jurisdiction')->target_id
      : NULL;

    // Allow if term is unassigned (shared across jurisdictions) or belongs
    // to one of the user's jurisdictions.
    if ($term_jur === NULL || in_array($term_jur, $jur_ids, TRUE)) {
      return AccessResult::allowed()
        ->addCacheableDependency($entity)
        ->cachePerPermissions()
        ->addCacheContexts(['user.roles', 'user.group_permissions']);
    }
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_ENTITY_TYPE_presave() for taxonomy_term entities.
 *
 * Entity access protects UI and JSON:API updates. This presave hook protects
 * programmatic writes that bypass entity access.
 *
 * @throws \Drupal\Core\Entity\EntityStorageException
 *   Thrown when a tenant admin writes taxonomy outside their direct
 *   jurisdiction ownership scope.
 */
function markaspot_tenant_admin_taxonomy_term_presave(EntityInterface $entity): void {
  if (!in_array($entity->bundle(), ['service_category', 'service_status'], TRUE)) {
    return;
  }

  $account = \Drupal::currentUser();
  if (!$entity->isNew()) {
    $original = $entity->getOriginal();
    if (!$original instanceof EntityInterface && $entity->id()) {
      try {
        $original = \Drupal::entityTypeManager()
          ->getStorage($entity->getEntityTypeId())
          ->loadUnchanged($entity->id());
      }
      catch (\Throwable $exception) {
        \Drupal::logger('markaspot_tenant_admin')->warning(
          'Could not load original taxonomy term before write-scope check: @message',
          ['@message' => $exception->getMessage()]
        );
        throw new EntityStorageException(
          'Could not verify existing taxonomy ownership before save.'
        );
      }
    }

    if (!$original instanceof EntityInterface) {
      throw new EntityStorageException(
        'Could not verify existing taxonomy ownership before save.'
      );
    }

    $original_reason = _markaspot_tenant_admin_taxonomy_write_scope_block_reason(
      $original,
      $account
    );
    if ($original_reason !== NULL) {
      throw new EntityStorageException($original_reason);
    }
  }

  $reason = _markaspot_tenant_admin_taxonomy_write_scope_block_reason(
    $entity,
    $account
  );
  if ($reason !== NULL) {
    throw new EntityStorageException($reason);
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for taxonomy_term entities.
 *
 * Access checks protect UI and JSON:API deletes. This predelete hook protects
 * programmatic deletes that bypass entity access.
 *
 * @throws \Drupal\Core\Entity\EntityStorageException
 *   Thrown when deleting a service_status term would break request data or
 *   the required Open311 status mapping set.
 */
function markaspot_tenant_admin_taxonomy_term_predelete(EntityInterface $entity): void {
  if (!in_array($entity->bundle(), ['service_category', 'service_status'], TRUE)) {
    return;
  }

  $scope_reason = _markaspot_tenant_admin_taxonomy_write_scope_block_reason(
    $entity,
    \Drupal::currentUser()
  );
  if ($scope_reason !== NULL) {
    throw new EntityStorageException($scope_reason);
  }

  if ($entity->bundle() !== 'service_status') {
    return;
  }

  $reason = _markaspot_tenant_admin_service_status_delete_block_reason($entity);
  if ($reason !== NULL) {
    throw new EntityStorageException($reason);
  }
}

/**
 * Restricts managed taxonomy writes to direct jurisdiction ownership.
 */
function _markaspot_tenant_admin_taxonomy_write_scope_access(
  EntityInterface $entity,
  AccountInterface $account,
): AccessResult {
  if ($account->hasPermission('administer taxonomy')) {
    return AccessResult::neutral()
      ->addCacheableDependency($entity)
      ->cachePerPermissions();
  }

  if (!_markaspot_tenant_admin_account_has_managed_taxonomy_write_permission($account)) {
    return AccessResult::neutral()
      ->addCacheableDependency($entity)
      ->cachePerPermissions();
  }

  $reason = _markaspot_tenant_admin_taxonomy_write_scope_block_reason($entity, $account);
  if ($reason !== NULL) {
    return AccessResult::forbidden($reason)
      ->addCacheableDependency($entity)
      ->cachePerPermissions()
      ->addCacheContexts(['user.group_permissions']);
  }

  return AccessResult::neutral()
    ->addCacheableDependency($entity)
    ->cachePerPermissions()
    ->addCacheContexts(['user.group_permissions']);
}

/**
 * Returns a reason when an account writes outside its taxonomy scope.
 */
function _markaspot_tenant_admin_taxonomy_write_scope_block_reason(
  EntityInterface $entity,
  AccountInterface $account,
): ?string {
  if ($account->hasPermission('administer taxonomy')) {
    return NULL;
  }

  if (!_markaspot_tenant_admin_account_has_managed_taxonomy_write_permission($account)) {
    return NULL;
  }

  if (
    !$entity->hasField('field_jurisdiction')
    || $entity->get('field_jurisdiction')->isEmpty()
  ) {
    return 'Shared taxonomy terms can only be changed by site administrators.';
  }

  $allowed_jur_ids = _markaspot_tenant_admin_get_accessible_term_jurisdiction_ids($account);
  if ($allowed_jur_ids === []) {
    return 'No manageable jurisdiction could be resolved for this account.';
  }

  $term_jur_id = (int) $entity->get('field_jurisdiction')->target_id;
  if (!in_array($term_jur_id, $allowed_jur_ids, TRUE)) {
    return 'Taxonomy term belongs to a different jurisdiction.';
  }

  return NULL;
}

/**
 * Checks whether an account has non-admin write rights for managed taxonomy.
 */
function _markaspot_tenant_admin_account_has_managed_taxonomy_write_permission(
  AccountInterface $account,
): bool {
  if (in_array('tenant_admin', $account->getRoles(), TRUE)) {
    return TRUE;
  }

  foreach (['service_category', 'service_status'] as $vocabulary) {
    foreach (['create', 'edit', 'delete'] as $operation) {
      if ($account->hasPermission("$operation terms in $vocabulary")) {
        return TRUE;
      }
    }
  }

  return FALSE;
}

/**
 * Resolves direct tenant-admin jurisdictions for write ownership checks.
 *
 * Write scoping intentionally uses only direct jurisdiction memberships.
 * Child admins may view inherited parent terms, but they must not change
 * taxonomy owned by parent or sibling jurisdictions.
 *
 * @return int[]
 *   Jurisdiction group IDs the account may manage for taxonomy purposes.
 */
function _markaspot_tenant_admin_get_accessible_term_jurisdiction_ids(AccountInterface $account): array {
  $jur_ids = TenantAdminHelper::getUserJurisdictionIds($account);
  if ($jur_ids === []) {
    return [];
  }

  return array_values(array_unique(array_map('intval', $jur_ids)));
}

/**
 * Blocks unsafe deletes for service_status taxonomy terms.
 *
 * Status terms are part of the Open311 contract and are referenced from
 * service requests and status history paragraphs. Deleting a referenced term
 * or the last term for a required Open311 mapping would leave request data in
 * an invalid or unrecoverable state.
 */
function _markaspot_tenant_admin_service_status_delete_access(
  EntityInterface $entity,
): AccessResult {
  $reason = _markaspot_tenant_admin_service_status_delete_block_reason($entity);
  if ($reason !== NULL) {
    return AccessResult::forbidden($reason)
      ->addCacheableDependency($entity)
      ->setCacheMaxAge(0);
  }

  return AccessResult::neutral()
    ->addCacheableDependency($entity)
    ->setCacheMaxAge(0);
}

/**
 * Returns a reason when a service_status term must not be deleted.
 */
function _markaspot_tenant_admin_service_status_delete_block_reason(
  EntityInterface $entity,
): ?string {
  $is_referenced = _markaspot_tenant_admin_status_term_is_referenced($entity);
  if ($is_referenced === NULL) {
    return 'Could not verify service status references; deletion is blocked.';
  }
  if ($is_referenced) {
    return 'This status is used by service requests or status history and '
      . 'cannot be deleted.';
  }

  $is_last_mapping = _markaspot_tenant_admin_status_term_is_last_required_mapping($entity);
  if ($is_last_mapping === NULL) {
    return 'Could not verify required Open311 status mappings; deletion is blocked.';
  }
  if ($is_last_mapping) {
    return 'At least one status for each required Open311 mapping must remain.';
  }

  return NULL;
}

/**
 * Checks whether a status term is still referenced by current or history data.
 */
function _markaspot_tenant_admin_status_term_is_referenced(
  EntityInterface $entity,
): ?bool {
  $tid = (int) $entity->id();
  if ($tid <= 0) {
    return FALSE;
  }

  $node_references = _markaspot_tenant_admin_entity_reference_exists(
    'node',
    'type',
    'service_request',
    'field_status',
    $tid
  );
  if ($node_references === TRUE) {
    return TRUE;
  }

  $history_references = _markaspot_tenant_admin_entity_reference_exists(
    'paragraph',
    'type',
    'status',
    'field_status_term',
    $tid
  );
  if ($history_references === TRUE) {
    return TRUE;
  }

  if ($node_references === NULL || $history_references === NULL) {
    return NULL;
  }

  return FALSE;
}

/**
 * Checks whether deleting a term would remove a required Open311 mapping.
 */
function _markaspot_tenant_admin_status_term_is_last_required_mapping(
  EntityInterface $entity,
): ?bool {
  if (
    !$entity->hasField('field_open311_mapping')
    || $entity->get('field_open311_mapping')->isEmpty()
  ) {
    return FALSE;
  }

  if ($entity instanceof EntityPublishedInterface && !$entity->isPublished()) {
    return FALSE;
  }

  $mapping = (string) $entity->get('field_open311_mapping')->value;
  if (!in_array($mapping, ['initial', 'open', 'closed'], TRUE)) {
    return FALSE;
  }

  $query = \Drupal::entityQuery('taxonomy_term')
    ->accessCheck(FALSE)
    ->condition('vid', 'service_status')
    ->condition('status', 1)
    ->condition('field_open311_mapping', $mapping)
    ->condition('tid', (int) $entity->id(), '<>')
    ->count();

  if (
    $entity->hasField('field_jurisdiction')
    && !$entity->get('field_jurisdiction')->isEmpty()
  ) {
    $query->condition(
      'field_jurisdiction',
      (int) $entity->get('field_jurisdiction')->target_id
    );
  }

  try {
    return (int) $query->execute() === 0;
  }
  catch (\Throwable $exception) {
    \Drupal::logger('markaspot_tenant_admin')->warning(
      'Could not check service status Open311 mapping before delete: @message',
      ['@message' => $exception->getMessage()]
    );
    return NULL;
  }
}

/**
 * Checks whether an entity reference field points at a target ID.
 */
function _markaspot_tenant_admin_entity_reference_exists(
  string $entity_type,
  string $bundle_key,
  string $bundle,
  string $field_name,
  int $target_id,
): ?bool {
  try {
    $count = \Drupal::entityQuery($entity_type)
      ->accessCheck(FALSE)
      ->condition($bundle_key, $bundle)
      ->condition($field_name, $target_id)
      ->count()
      ->execute();
  }
  catch (\Throwable $exception) {
    \Drupal::logger('markaspot_tenant_admin')->warning(
      'Could not check @entity_type references for @field_name before '
      . 'service status delete: @message',
      [
        '@entity_type' => $entity_type,
        '@field_name' => $field_name,
        '@message' => $exception->getMessage(),
      ]
    );
    return NULL;
  }

  return (int) $count > 0;
}
