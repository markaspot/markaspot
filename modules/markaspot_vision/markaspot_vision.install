<?php

/**
 * @file
 * Install, update, and uninstall functions for the markaspot_vision module.
 */

use Drupal\Core\Config\FileStorage;
use Drupal\markaspot_ai\Utility\BlurAdvisory;
use Drupal\markaspot_vision\Service\OriginalImageStore;

/**
 * Install hazard level and category fields for media entities.
 *
 * These fields store AI-detected hazard data:
 * - field_ai_hazard_level: CAP severity (0=None to 4=Extreme)
 * - field_ai_hazard_category: CAP standard codes (Infra, Transport, Safety, Env, Fire, Health, Geo, Met, Other)
 */
function markaspot_vision_update_11801(): string {
  $config_factory = \Drupal::configFactory();
  $entity_type_manager = \Drupal::entityTypeManager();

  // Path to optional config in the module.
  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_vision');
  $config_path = $module_path . '/config/optional';
  $source = new FileStorage($config_path);

  // Define the configs to import in order (storage first, then field).
  $configs = [
    'field.storage.media.field_ai_hazard_level',
    'field.storage.media.field_ai_hazard_category',
    'field.field.media.request_image.field_ai_hazard_level',
    'field.field.media.request_image.field_ai_hazard_category',
  ];

  $imported = [];
  $skipped = [];

  foreach ($configs as $config_name) {
    // Skip if config already exists.
    if ($config_factory->get($config_name)->get('id')) {
      $skipped[] = $config_name;
      continue;
    }

    // Read from file.
    $config_data = $source->read($config_name);
    if (empty($config_data)) {
      \Drupal::logger('markaspot_vision')->warning('Config file not found: @name', ['@name' => $config_name]);
      continue;
    }

    // Determine entity type based on config name prefix.
    if (str_starts_with($config_name, 'field.storage.')) {
      $entity_type = 'field_storage_config';
    }
    elseif (str_starts_with($config_name, 'field.field.')) {
      $entity_type = 'field_config';
    }
    else {
      continue;
    }

    // Create the config entity.
    try {
      $entity_type_manager->getStorage($entity_type)->create($config_data)->save();
      $imported[] = $config_name;
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot_vision')->error('Failed to import @name: @error', [
        '@name' => $config_name,
        '@error' => $e->getMessage(),
      ]);
    }
  }

  $message = [];
  if (!empty($imported)) {
    $message[] = 'Imported: ' . implode(', ', $imported);
  }
  if (!empty($skipped)) {
    $message[] = 'Skipped (already exists): ' . implode(', ', $skipped);
  }

  return implode('. ', $message) ?: 'No changes made.';
}

/**
 * Install blur preprocessing config and field_media_image_blurred field.
 *
 * Adds the enable_blur_preprocessing and blur_service_url settings,
 * and creates the field_media_image_blurred image field on the
 * request_image media type for storing privacy-safe blurred versions.
 */
function markaspot_vision_update_11803(): string {
  // Add blur config defaults to existing settings.
  $config = \Drupal::configFactory()->getEditable('markaspot_vision.settings');
  if ($config->get('enable_blur_preprocessing') === NULL) {
    $config->set('enable_blur_preprocessing', FALSE);
    $config->set('blur_service_url', 'http://markaspot-vision:8200/blur');
    $config->save();
  }

  return 'Blur preprocessing config added.';
}

/**
 * Install per-jurisdiction AI system prompt field for group entities.
 *
 * Adds field_ai_system_prompt (text_long) to the jur group type,
 * allowing each jurisdiction to override the global AI system prompt.
 * Only runs when the group module is enabled.
 */
function markaspot_vision_update_11802(): string {
  // Skip if group module is not installed.
  if (!\Drupal::moduleHandler()->moduleExists('group')) {
    return 'Skipped: group module is not enabled.';
  }

  $entity_type_manager = \Drupal::entityTypeManager();

  // Skip if jur group type does not exist.
  if (!$entity_type_manager->getStorage('group_type')->load('jur')) {
    return 'Skipped: jur group type does not exist.';
  }

  $config_factory = \Drupal::configFactory();

  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_vision');
  $config_path = $module_path . '/config/optional';
  $source = new FileStorage($config_path);

  $configs = [
    'field.storage.group.field_ai_system_prompt',
    'field.field.group.jur.field_ai_system_prompt',
  ];

  $imported = [];
  $skipped = [];

  foreach ($configs as $config_name) {
    if ($config_factory->get($config_name)->get('id')) {
      $skipped[] = $config_name;
      continue;
    }

    $config_data = $source->read($config_name);
    if (empty($config_data)) {
      \Drupal::logger('markaspot_vision')->warning('Config file not found: @name', ['@name' => $config_name]);
      continue;
    }

    if (str_starts_with($config_name, 'field.storage.')) {
      $entity_type = 'field_storage_config';
    }
    elseif (str_starts_with($config_name, 'field.field.')) {
      $entity_type = 'field_config';
    }
    else {
      continue;
    }

    try {
      $entity_type_manager->getStorage($entity_type)->create($config_data)->save();
      $imported[] = $config_name;
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot_vision')->error('Failed to import @name: @error', [
        '@name' => $config_name,
        '@error' => $e->getMessage(),
      ]);
    }
  }

  $message = [];
  if (!empty($imported)) {
    $message[] = 'Imported: ' . implode(', ', $imported);
  }
  if (!empty($skipped)) {
    $message[] = 'Skipped (already exists): ' . implode(', ', $skipped);
  }

  return implode('. ', $message) ?: 'No changes made.';
}

/**
 * Remove orphaned field_media_image_blurred config (#250).
 *
 * The vision blur refactor (commit 51a20c5) replaced the separate
 * field_media_image_blurred with in-place file overwrite. This hook
 * cleans up the now-unused field config from existing sites.
 */
function markaspot_vision_update_11804(): string {
  $deleted = [];

  // Delete the field instance first (depends on storage).
  $field_config = \Drupal::configFactory()
    ->getEditable('field.field.media.request_image.field_media_image_blurred');
  if (!$field_config->isNew()) {
    $field_config->delete();
    $deleted[] = 'field.field.media.request_image.field_media_image_blurred';
  }

  // Then delete the field storage.
  $storage_config = \Drupal::configFactory()
    ->getEditable('field.storage.media.field_media_image_blurred');
  if (!$storage_config->isNew()) {
    $storage_config->delete();
    $deleted[] = 'field.storage.media.field_media_image_blurred';
  }

  if (!empty($deleted)) {
    \Drupal::logger('markaspot_vision')->notice(
      'Removed orphaned blur field config: @configs',
      ['@configs' => implode(', ', $deleted)]
    );
    return 'Deleted orphaned config: ' . implode(', ', $deleted);
  }

  return 'No orphaned blur field config found. Nothing to clean up.';
}

/**
 * Create the dedicated ai_analysis image style for the Vision API.
 *
 * Replaces the start.sh workaround that stripped AVIF from the core "wide"
 * style. OpenAI Vision only accepts PNG/JPEG/GIF/WebP, so the AI pipeline now
 * uses its own scale-only style (no format conversion), leaving "wide" intact
 * for web delivery with AVIF.
 */
function markaspot_vision_update_11805(): string {
  $config_name = 'image.style.ai_analysis';

  if (\Drupal::configFactory()->get($config_name)->get('name')) {
    return 'Skipped: ai_analysis image style already exists.';
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_vision');
  $source = new FileStorage($module_path . '/config/install');
  $config_data = $source->read($config_name);

  if (empty($config_data)) {
    \Drupal::logger('markaspot_vision')->warning('Config file not found: @name', ['@name' => $config_name]);
    return 'Skipped: config file image.style.ai_analysis.yml not found.';
  }

  \Drupal::entityTypeManager()->getStorage('image_style')->create($config_data)->save();

  return 'Created ai_analysis image style.';
}

/**
 * Implements hook_schema().
 */
function markaspot_vision_schema(): array {
  return [
    OriginalImageStore::TABLE => _markaspot_vision_original_table(),
  ];
}

/**
 * Schema of the table mapping media to their unblurred original.
 */
function _markaspot_vision_original_table(): array {
  return [
    'description' => 'Unblurred originals kept for staff; one private file per media.',
    'fields' => [
      'mid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Media id.',
      ],
      'uri' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Private URI of the original.',
      ],
      'mime' => [
        'type' => 'varchar',
        'length' => 100,
        'not null' => TRUE,
        'default' => 'application/octet-stream',
        'description' => 'MIME type of the original.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'When the original was kept.',
      ],
      'nid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'The report owning the original: the first that showed the photo.',
      ],
    ],
    'primary key' => ['mid'],
    'unique keys' => ['uri' => ['uri']],
    'indexes' => ['created' => ['created'], 'nid' => ['nid']],
  ];
}

/**
 * Implements hook_uninstall().
 *
 * The table goes with the module; the unblurred originals must go with it.
 */
function markaspot_vision_uninstall(): void {
  if (\Drupal::service('stream_wrapper_manager')->isValidScheme('private')) {
    \Drupal::service('file_system')->deleteRecursive(OriginalImageStore::DIRECTORY);
  }
  \Drupal::state()->delete(OriginalImageStore::PURGE_CURSOR);
}

/**
 * Keeps today's behaviour: hold residual findings, keep no originals.
 */
function markaspot_vision_update_11806(): string {
  $config = \Drupal::configFactory()->getEditable('markaspot_vision.settings');
  $set = [];
  foreach (['residual_privacy_handling' => 'hold', 'retain_originals' => FALSE] as $key => $default) {
    if ($config->get($key) === NULL) {
      $config->set($key, $default);
      $set[] = $key;
    }
  }
  if (!$set) {
    return 'Skipped: residual privacy settings already set.';
  }
  $config->save();
  return 'Set defaults for ' . implode(', ', $set) . '.';
}

/**
 * Creates the table of unblurred originals kept for staff.
 */
function markaspot_vision_update_11807(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists(OriginalImageStore::TABLE)) {
    return 'Skipped: table already exists.';
  }
  $schema->createTable(OriginalImageStore::TABLE, _markaspot_vision_original_table());
  return 'Created the table of unblurred originals.';
}

/**
 * Implements hook_requirements().
 */
function markaspot_vision_requirements($phase): array {
  if ($phase !== 'runtime') {
    return [];
  }
  $vision = \Drupal::service('markaspot_vision.image_processing');
  $mode = $vision->getBlurMode();
  $config = \Drupal::config('markaspot_vision.settings');
  $severity = REQUIREMENT_OK;
  $description = t('Images follow the configured blur preprocessing policy.');
  if ($vision->isBlurRequired() && !$vision->hasRequiredBlurConfiguration()) {
    $severity = REQUIREMENT_ERROR;
    $description = BlurAdvisory::errorMessage();
  }
  elseif ($mode === 'off') {
    $severity = REQUIREMENT_INFO;
    $description = t('The operator has explicitly opted out of mandatory blurring. The site switch decides.');
  }
  elseif ($mode === 'auto-unprotected' && !$config->get('enable_blur_preprocessing') && ($config->get('api_url') || trim(getenv('MARKASPOT_VISION_API_URL') ?: '') !== '')) {
    $severity = REQUIREMENT_WARNING;
    $description = BlurAdvisory::message();
  }
  $requirements = [
    'markaspot_vision_blur' => [
      'title' => t('Image blurring before AI analysis'),
      'value' => $mode,
      'severity' => $severity,
      'description' => $description,
    ],
  ];
  if ($config->get('retain_originals') && !\Drupal::service('stream_wrapper_manager')->isValidScheme('private')) {
    $requirements['markaspot_vision_originals'] = [
      'title' => t('Unblurred originals for staff'),
      'value' => t('Not kept'),
      'severity' => REQUIREMENT_WARNING,
      'description' => t('Keeping originals is switched on, but the site has no private file system. Set file_private_path; until then photos are blurred without keeping the original.'),
    ];
  }
  return $requirements;
}
