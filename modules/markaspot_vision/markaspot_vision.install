<?php

/**
 * @file
 * Install, update, and uninstall functions for the markaspot_vision module.
 */

use Drupal\Core\Config\FileStorage;

/**
 * Install hazard level and category fields for media entities.
 *
 * These fields store AI-detected hazard data:
 * - field_ai_hazard_level: CAP severity (0=None to 4=Extreme)
 * - field_ai_hazard_category: CAP standard codes (Infra, Transport, Safety, Env, Fire, Health, Geo, Met, Other)
 */
function markaspot_vision_update_11801(): string {
  $config_factory = \Drupal::configFactory();
  $entity_type_manager = \Drupal::entityTypeManager();

  // Path to optional config in the module.
  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_vision');
  $config_path = $module_path . '/config/optional';
  $source = new FileStorage($config_path);

  // Define the configs to import in order (storage first, then field).
  $configs = [
    'field.storage.media.field_ai_hazard_level',
    'field.storage.media.field_ai_hazard_category',
    'field.field.media.request_image.field_ai_hazard_level',
    'field.field.media.request_image.field_ai_hazard_category',
  ];

  $imported = [];
  $skipped = [];

  foreach ($configs as $config_name) {
    // Skip if config already exists.
    if ($config_factory->get($config_name)->get('id')) {
      $skipped[] = $config_name;
      continue;
    }

    // Read from file.
    $config_data = $source->read($config_name);
    if (empty($config_data)) {
      \Drupal::logger('markaspot_vision')->warning('Config file not found: @name', ['@name' => $config_name]);
      continue;
    }

    // Determine entity type based on config name prefix.
    if (str_starts_with($config_name, 'field.storage.')) {
      $entity_type = 'field_storage_config';
    }
    elseif (str_starts_with($config_name, 'field.field.')) {
      $entity_type = 'field_config';
    }
    else {
      continue;
    }

    // Create the config entity.
    try {
      $entity_type_manager->getStorage($entity_type)->create($config_data)->save();
      $imported[] = $config_name;
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot_vision')->error('Failed to import @name: @error', [
        '@name' => $config_name,
        '@error' => $e->getMessage(),
      ]);
    }
  }

  $message = [];
  if (!empty($imported)) {
    $message[] = 'Imported: ' . implode(', ', $imported);
  }
  if (!empty($skipped)) {
    $message[] = 'Skipped (already exists): ' . implode(', ', $skipped);
  }

  return implode('. ', $message) ?: 'No changes made.';
}

/**
 * Install blur preprocessing config and field_media_image_blurred field.
 *
 * Adds the enable_blur_preprocessing and blur_service_url settings,
 * and creates the field_media_image_blurred image field on the
 * request_image media type for storing privacy-safe blurred versions.
 */
function markaspot_vision_update_11803(): string {
  // Add blur config defaults to existing settings.
  $config = \Drupal::configFactory()->getEditable('markaspot_vision.settings');
  if ($config->get('enable_blur_preprocessing') === NULL) {
    $config->set('enable_blur_preprocessing', FALSE);
    $config->set('blur_service_url', 'http://markaspot-vision:8200/blur');
    $config->save();
  }

  // Install field storage + field instance for blurred image.
  $entity_type_manager = \Drupal::entityTypeManager();
  $config_factory = \Drupal::configFactory();

  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_vision');
  $config_path = $module_path . '/config/optional';
  $source = new FileStorage($config_path);

  $configs = [
    'field.storage.media.field_media_image_blurred',
    'field.field.media.request_image.field_media_image_blurred',
  ];

  $imported = [];
  $skipped = [];

  foreach ($configs as $config_name) {
    if ($config_factory->get($config_name)->get('id')) {
      $skipped[] = $config_name;
      continue;
    }

    $config_data = $source->read($config_name);
    if (empty($config_data)) {
      \Drupal::logger('markaspot_vision')->warning('Config file not found: @name', ['@name' => $config_name]);
      continue;
    }

    if (str_starts_with($config_name, 'field.storage.')) {
      $entity_type = 'field_storage_config';
    }
    elseif (str_starts_with($config_name, 'field.field.')) {
      $entity_type = 'field_config';
    }
    else {
      continue;
    }

    try {
      $entity_type_manager->getStorage($entity_type)->create($config_data)->save();
      $imported[] = $config_name;
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot_vision')->error('Failed to import @name: @error', [
        '@name' => $config_name,
        '@error' => $e->getMessage(),
      ]);
    }
  }

  $message = ['Blur preprocessing config added.'];
  if (!empty($imported)) {
    $message[] = 'Imported: ' . implode(', ', $imported);
  }
  if (!empty($skipped)) {
    $message[] = 'Skipped (already exists): ' . implode(', ', $skipped);
  }

  return implode(' ', $message);
}

/**
 * Install per-jurisdiction AI system prompt field for group entities.
 *
 * Adds field_ai_system_prompt (text_long) to the jur group type,
 * allowing each jurisdiction to override the global AI system prompt.
 * Only runs when the group module is enabled.
 */
function markaspot_vision_update_11802(): string {
  // Skip if group module is not installed.
  if (!\Drupal::moduleHandler()->moduleExists('group')) {
    return 'Skipped: group module is not enabled.';
  }

  $entity_type_manager = \Drupal::entityTypeManager();

  // Skip if jur group type does not exist.
  if (!$entity_type_manager->getStorage('group_type')->load('jur')) {
    return 'Skipped: jur group type does not exist.';
  }

  $config_factory = \Drupal::configFactory();

  $module_path = \Drupal::service('extension.list.module')->getPath('markaspot_vision');
  $config_path = $module_path . '/config/optional';
  $source = new FileStorage($config_path);

  $configs = [
    'field.storage.group.field_ai_system_prompt',
    'field.field.group.jur.field_ai_system_prompt',
  ];

  $imported = [];
  $skipped = [];

  foreach ($configs as $config_name) {
    if ($config_factory->get($config_name)->get('id')) {
      $skipped[] = $config_name;
      continue;
    }

    $config_data = $source->read($config_name);
    if (empty($config_data)) {
      \Drupal::logger('markaspot_vision')->warning('Config file not found: @name', ['@name' => $config_name]);
      continue;
    }

    if (str_starts_with($config_name, 'field.storage.')) {
      $entity_type = 'field_storage_config';
    }
    elseif (str_starts_with($config_name, 'field.field.')) {
      $entity_type = 'field_config';
    }
    else {
      continue;
    }

    try {
      $entity_type_manager->getStorage($entity_type)->create($config_data)->save();
      $imported[] = $config_name;
    }
    catch (\Exception $e) {
      \Drupal::logger('markaspot_vision')->error('Failed to import @name: @error', [
        '@name' => $config_name,
        '@error' => $e->getMessage(),
      ]);
    }
  }

  $message = [];
  if (!empty($imported)) {
    $message[] = 'Imported: ' . implode(', ', $imported);
  }
  if (!empty($skipped)) {
    $message[] = 'Skipped (already exists): ' . implode(', ', $skipped);
  }

  return implode('. ', $message) ?: 'No changes made.';
}
