<?php

/**
 * @file
 * Contains markaspot_vision.module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\media\MediaInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function markaspot_vision_help(string $route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.markaspot_vision':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('AI-powered image analysis for automatic categorization, hazard detection, and privacy screening using GPT-4 Vision.') . '</p>';
      return $output;

    default:
      return '';
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for media entities.
 */
function markaspot_vision_media_insert(EntityInterface $entity): void {
  if (!$entity instanceof MediaInterface) {
    return;
  }

  \Drupal::service('markaspot_vision.media_analysis_access_guard')->recordUpload($entity);
}

/**
 * Implements hook_node_insert().
 *
 * Publishes safe media and propagates hazard levels on node creation.
 */
function markaspot_vision_node_insert(NodeInterface $node): void {
  _markaspot_vision_publish_safe_media($node);
  _markaspot_vision_propagate_hazard_level($node);
}

/**
 * Implements hook_node_update().
 *
 * Publishes safe media and propagates hazard levels on node update.
 */
function markaspot_vision_node_update(NodeInterface $node): void {
  _markaspot_vision_publish_safe_media($node);
  _markaspot_vision_propagate_hazard_level($node);
}

/**
 * Publishes media on a service request based on AI screening results.
 *
 * When require_ai_screening is enabled (default), media stays unpublished
 * until AI analysis has completed successfully (field_ai_metadata is set)
 * and no privacy flag or privacy issue was raised. This prevents unanalyzed
 * images from being published (privacy by design, fail-closed).
 *
 * When require_ai_screening is disabled (legacy mode), media is published
 * unless it has been explicitly flagged by AI.
 */
function _markaspot_vision_publish_safe_media(NodeInterface $node): void {
  if ($node->bundle() !== 'service_request') {
    return;
  }
  $media_field = $node->get('field_request_media');
  if ($media_field->isEmpty()) {
    return;
  }

  $require_screening = \Drupal::config('markaspot_vision.settings')->get('require_ai_screening') ?? TRUE;

  $manual_publication = \Drupal::keyValue('markaspot_open311.media_publication_manual');

  foreach ($media_field->referencedEntities() as $media) {
    // Media whose publication was explicitly set through the GeoReport media
    // publication API is under editorial (human-in-the-loop / trusted
    // consumer) control. That decision is authoritative and wins over the
    // whole AI publication pipeline — including the PII safety net below.
    // The gating permission is restrict-access, so we assume the consumer
    // knows what it is doing; automatic (un)publishing must not override it.
    //
    // Default to "not manually controlled" if the keyvalue lookup fails: a
    // backend hiccup must not abort the whole node save. The AI branches
    // below fail closed on PII on their own, so degrading to them is safe.
    try {
      $is_manual = (bool) $manual_publication->get($media->id());
    }
    catch (\Exception $e) {
      $is_manual = FALSE;
    }
    if ($is_manual) {
      continue;
    }

    $ai_completed = !empty($media->get('field_ai_metadata')->value);
    $has_privacy_flag = !empty($media->get('field_ai_privacy_flag')->value);
    $privacy_issues = $media->hasField('field_ai_privacy_issues')
      ? trim((string) $media->get('field_ai_privacy_issues')->value)
      : '';
    $has_privacy_hold = $has_privacy_flag || $privacy_issues !== '';

    if ($has_privacy_hold && $media->isPublished()) {
      // Safety net: unpublish media held for PII (e.g. published by
      // ImageProcessingController before a late or inconsistent detection).
      $media->setUnpublished();
      $media->save();
    }
    elseif (!$media->isPublished()) {
      if ($require_screening) {
        // Strict mode: only publish if AI ran and found no privacy issues.
        if ($ai_completed && !$has_privacy_hold) {
          $media->setPublished();
          $media->save();
        }
      }
      else {
        // Legacy mode: publish unless explicitly flagged.
        if (!$has_privacy_hold) {
          $media->setPublished();
          $media->save();
        }
      }
    }
  }
}

/**
 * Propagates the highest hazard level from media entities to the node.
 *
 * Iterates all referenced media on a service request and sets
 * field_hazard_level to the maximum AI-detected hazard level.
 */
function _markaspot_vision_propagate_hazard_level(NodeInterface $node): void {
  if ($node->bundle() !== 'service_request') {
    return;
  }
  if (!$node->hasField('field_hazard_level') || !$node->hasField('field_request_media')) {
    return;
  }
  $media_field = $node->get('field_request_media');
  if ($media_field->isEmpty()) {
    return;
  }

  $max_hazard_level = 0;
  foreach ($media_field->referencedEntities() as $media) {
    if ($media->hasField('field_ai_hazard_level')) {
      $level = (int) $media->get('field_ai_hazard_level')->value;
      if ($level > $max_hazard_level) {
        $max_hazard_level = $level;
      }
    }
  }

  // Set directly on the entity object (mid-save), no $node->save() needed.
  $node->set('field_hazard_level', $max_hazard_level);
}
