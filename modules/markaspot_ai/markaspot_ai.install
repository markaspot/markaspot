        'length' => 32,
        'not null' => TRUE,
        'default' => 'content',
      ],
      'embedding' => [
        'description' => 'JSON-serialized vector embedding.',
        'type' => 'blob',
        'size' => 'big',
        'not null' => TRUE,
      ],
      'model' => [
        'description' => 'The AI model used to generate the embedding.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
