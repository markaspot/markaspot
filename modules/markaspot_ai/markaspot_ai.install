    'indexes' => [
      'source' => ['source_nid'],
      'match' => ['match_nid'],
      'status' => ['status'],
      'status_created' => ['status', 'created'],
      'reviewed_by' => ['reviewed_by'],
    ],
    'foreign keys' => [
      'source_node' => [
