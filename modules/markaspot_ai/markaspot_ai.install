/**
 * Add sentiment analysis table.
 */
function markaspot_ai_update_10001(): void {
  $schema = \Drupal::database()->schema();

  if (!$schema->tableExists('markaspot_ai_sentiment')) {
    $table_schema = [
      'description' => 'Stores sentiment analysis results for service requests.',
      'fields' => [
        'id' => [
          'description' => 'Primary key.',
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'entity_type' => [
          'description' => 'The entity type (e.g., node).',
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'default' => 'node',
        ],
        'entity_id' => [
          'description' => 'The entity ID.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'sentiment' => [
          'description' => 'Sentiment category: frustrated, neutral, positive.',
          'type' => 'varchar',
          'length' => 16,
          'not null' => TRUE,
          'default' => 'neutral',
        ],
        'score' => [
          'description' => 'Sentiment score from -1.0 (frustrated) to 1.0 (positive).',
          'type' => 'float',
          'not null' => TRUE,
          'default' => 0,
        ],
        'confidence' => [
          'description' => 'Confidence level from 0 to 1.',
          'type' => 'float',
          'not null' => TRUE,
          'default' => 0,
        ],
        'reasoning' => [
          'description' => 'Brief explanation of the sentiment classification.',
          'type' => 'text',
          'size' => 'normal',
          'not null' => FALSE,
        ],
        'analyzed_at' => [
          'description' => 'Unix timestamp when the sentiment was analyzed.',
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
      'primary key' => ['id'],
      'unique keys' => [
        'entity' => ['entity_type', 'entity_id'],
      ],
      'indexes' => [
        'sentiment' => ['sentiment'],
        'score' => ['score'],
        'analyzed_at' => ['analyzed_at'],
        'entity_type_idx' => ['entity_type'],
      ],
    ];

    $schema->createTable('markaspot_ai_sentiment', $table_schema);
  }
}

/**
 * Add AI analysis fields and update manager_fields config.
 *
 * Creates field_sentiment (from config/install), field_risk_score and
 * field_hazard_category (from config/optional) on service_request nodes.
 * Also adds field_risk_score and field_hazard_category to the
 * markaspot_open311 manager_fields config for API access control.
 */
function markaspot_ai_update_10002(): void {
  $module_path = \Drupal::service('extension.list.module')
    ->getPath('markaspot_ai');

  // Field configs to import: [config_name => subdirectory].
  $configs_to_import = [
    // Storages first (order matters).
    'field.storage.node.field_sentiment' => 'config/install',
    'field.storage.node.field_risk_score' => 'config/optional',
    'field.storage.node.field_hazard_category' => 'config/optional',
    // Then field instances.
    'field.field.node.service_request.field_sentiment' => 'config/install',
    'field.field.node.service_request.field_risk_score' => 'config/optional',
    'field.field.node.service_request.field_hazard_category' => 'config/optional',
  ];

  $config_factory = \Drupal::configFactory();

  foreach ($configs_to_import as $config_name => $subdir) {
    // Skip if config already exists.
    if (!$config_factory->get($config_name)->isNew()) {
      continue;
    }

    $file_path = $module_path . '/' . $subdir . '/' . $config_name . '.yml';
    if (!file_exists($file_path)) {
      \Drupal::logger('markaspot_ai')->warning('Config file not found: @file', [
        '@file' => $file_path,
      ]);
      continue;
    }

    $yaml = file_get_contents($file_path);
    $data = Yaml::decode($yaml);

    $entity_type = str_starts_with($config_name, 'field.storage.')
      ? 'field_storage_config'
      : 'field_config';

    $storage = \Drupal::entityTypeManager()->getStorage($entity_type);
    $entity = $storage->createFromStorageRecord($data);
    $entity->save();
  }

  // Add new fields to markaspot_open311 manager_fields for API access.
  $open311_config = $config_factory->getEditable('markaspot_open311.settings');
  $manager_fields = $open311_config->get('field_access.manager_fields') ?? [];

  $new_fields = ['field_hazard_category', 'field_risk_score'];
  foreach ($new_fields as $field) {
    if (!in_array($field, $manager_fields, TRUE)) {
      $manager_fields[] = $field;
    }
  }

  $open311_config->set('field_access.manager_fields', $manager_fields);
  $open311_config->save();
}

/**
 * Add Azure OpenAI provider configuration.
 */
function markaspot_ai_update_10003(): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_ai.settings');

  // Only add if not already present.
  if ($config->get('providers.azure') === NULL) {
    $config->set('providers.azure', [
      'api_key' => '',
      'api_url' => '',
      'api_version' => '2024-12-01-preview',
      'chat_model' => 'gpt-4.1-mini',
      'embedding_model' => 'text-embedding-3-large',
      'auth_type' => 'api_key_header',
    ]);
    $config->save();
  }
}

/**
 * Add IONOS AI provider configuration.
 */
function markaspot_ai_update_10004(): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_ai.settings');

  // Only add if not already present.
  if ($config->get('providers.ionos') === NULL) {
    $config->set('providers.ionos', [
      'api_key' => '',
      'api_url' => 'https://openai.inference.de-txl.ionos.com/v1',
      'chat_model' => 'mistralai/Mistral-Nemo-Instruct-2407',
      'embedding_model' => 'BAAI/bge-m3',
      'auth_type' => 'bearer',
    ]);
    $config->save();
  }
}

/**
 * Add PII redaction configuration.
 */
function markaspot_ai_update_10005(): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_ai.settings');

  if ($config->get('pii_redaction') === NULL) {
    $config->set('pii_redaction', [
      'enabled' => FALSE,
      'use_llm' => FALSE,
      'provider' => 'ionos',
    ]);
    $config->save();
  }
}

/**
 * Add nlp_service configuration for self-hosted Phi-3 container.
 */
function markaspot_ai_update_10006(): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_ai.settings');
  $changed = FALSE;

  if ($config->get('nlp_service') === NULL) {
    $config->set('nlp_service', [
      'enabled' => FALSE,
      'url' => 'http://markaspot-nlp:8100',
      'health_check_interval' => 300,
    ]);
    $changed = TRUE;
  }

  // Ensure pii_redaction.provider has a valid value now that the schema
  // constrains it to an enum.
  $allowed = ['openai', 'azure', 'ionos', 'local_nlp'];
  $current = $config->get('pii_redaction.provider');
  if (!in_array($current, $allowed, TRUE)) {
    $config->set('pii_redaction.provider', 'ionos');
    $changed = TRUE;
  }

  if ($changed) {
    $config->save();
  }
}

/**
 * Restore missing sentiment_analysis.model config key.
 */
function markaspot_ai_update_10007(): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_ai.settings');
  if (empty($config->get('sentiment_analysis.model'))) {
    $config->set('sentiment_analysis.model', 'gpt-4.1-mini')->save();
  }
}

/**
 * Copy pii_redaction.use_llm to pii_redaction.detect_names (deprecation).
 */
function markaspot_ai_update_10008(): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_ai.settings');
  if ($config->get('pii_redaction.detect_names') === NULL) {
    $legacy = $config->get('pii_redaction.use_llm');
    $config->set('pii_redaction.detect_names', (bool) $legacy)->save();
  }
}

/**
 * Disable implicit AI processing defaults for existing installations.
 */
function markaspot_ai_update_10009(): string {
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('markaspot_ai.settings');
  $config
    ->set('ai_processing.auto_backfill', FALSE)
    ->set('duplicate_detection.enabled', FALSE)
    ->set('duplicate_detection.auto_flag', FALSE)
    ->set('sentiment_analysis.enabled', FALSE)
    ->save();

  $views = [
    'views.view.ai_pending_duplicates',
    'views.view.ai_sentiment_overview',
  ];
  foreach ($views as $view_config_name) {
    $view = $config_factory->getEditable($view_config_name);
    if (!$view->isNew()) {
      $view
        ->set('display.default.display_options.access.type', 'perm')
        ->set('display.default.display_options.access.options.perm', 'administer markaspot ai')
        ->save();
    }
  }

  return 'Disabled implicit markaspot_ai processing defaults and restricted optional AI views to administer markaspot_ai. Tenants must set features.aiProcessing=true and re-enable desired AI tasks explicitly.';
}

/**
 * Implements hook_install().
 */
function markaspot_ai_install(): void {
  \Drupal::messenger()->addStatus(t('Mark-a-Spot AI module has been installed. Please configure the AI provider settings at /admin/config/services/markaspot-ai.'));
}

/**
 * Implements hook_uninstall().
 */
function markaspot_ai_uninstall(): void {
  // Delete module configuration.
  \Drupal::configFactory()->getEditable('markaspot_ai.settings')->delete();

  \Drupal::messenger()->addStatus(t('Mark-a-Spot AI module has been uninstalled. All embeddings and usage data have been removed.'));
}

/**
 * Implements hook_requirements().
 */
function markaspot_ai_requirements(string $phase): array {
  $requirements = [];

  if ($phase === 'runtime') {
    $config = \Drupal::config('markaspot_ai.settings');
    $default_provider = $config->get('default_provider') ?? 'openai';
    $api_key = $config->get("providers.{$default_provider}.api_key") ?? '';

    // Check environment variables for API key.
    if (empty($api_key)) {
      $env_vars = match ($default_provider) {
        'azure' => ['AZURE_OPENAI_API_KEY', 'MARKASPOT_AI_AZURE_KEY'],
        'openai' => ['OPENAI_API_KEY', 'MARKASPOT_AI_OPENAI_KEY'],
        'ionos' => ['IONOS_AI_API_KEY', 'MARKASPOT_AI_IONOS_KEY'],
        default => [],
      };
      foreach ($env_vars as $env_var) {
        $env_value = getenv($env_var);
        if (!empty($env_value)) {
          $api_key = $env_value;
          break;
        }
      }
    }

    $requirements['markaspot_ai_config'] = [
      'title' => t('Mark-a-Spot AI Configuration'),
      'severity' => REQUIREMENT_INFO,
    ];

    if (empty($api_key)) {
      $requirements['markaspot_ai_config']['value'] = t('Not configured');
      $requirements['markaspot_ai_config']['description'] = t('The AI provider API key is not configured. Please visit the <a href=":url">AI settings page</a> to configure.', [
        ':url' => '/admin/config/services/markaspot-ai',
      ]);
      $requirements['markaspot_ai_config']['severity'] = REQUIREMENT_WARNING;
    }
    else {
      $requirements['markaspot_ai_config']['value'] = t('Configured (@provider)', [
        '@provider' => $default_provider,
      ]);
    }

    // Check token tracking status.
    if ($config->get('token_tracking.enabled')) {
      /** @var \Drupal\markaspot_ai\Service\TokenTrackingService $tracking */
      $tracking = \Drupal::service('markaspot_ai.token_tracking');
      $daily_usage = $tracking->getDailyUsage();
      $daily_limit = (int) $config->get('token_tracking.daily_limit');

      $requirements['markaspot_ai_usage'] = [
        'title' => t('Mark-a-Spot AI Token Usage'),
        'value' => t('@used / @limit tokens today', [
          '@used' => number_format($daily_usage['total_tokens']),
          '@limit' => $daily_limit > 0 ? number_format($daily_limit) : t('unlimited'),
        ]),
        'severity' => REQUIREMENT_INFO,
      ];

      if ($daily_limit > 0 && $daily_usage['total_tokens'] >= $daily_limit * 0.9) {
        $requirements['markaspot_ai_usage']['severity'] = REQUIREMENT_WARNING;
        $requirements['markaspot_ai_usage']['description'] = t('Daily token limit is nearly reached.');
      }
    }
  }

  return $requirements;
}
