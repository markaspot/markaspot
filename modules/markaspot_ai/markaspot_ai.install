      'id' => [
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'entity_type' => [
        'description' => 'The entity type (e.g., node, taxonomy_term).',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'node',
      ],
      'entity_id' => [
        'description' => 'The entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'embedding_type' => [
        'description' => 'Type of embedding: content, title, address, etc.',
