<?php

/**
 * @file
 * Install, update and uninstall functions for the markaspot_nuxt module.
 */

use Drupal\Core\Config\FileStorage;

/**
 * Implements hook_install().
 */
function markaspot_nuxt_install() {
  $config_factory = \Drupal::configFactory();
  $nuxt_config = $config_factory->getEditable('markaspot_nuxt.settings');

  // If config doesn't exist, create it with defaults from config/install.
  if ($nuxt_config->isNew()) {
    $config_path = \Drupal::service('extension.list.module')->getPath('markaspot_nuxt') . '/config/install';
    $source = new FileStorage($config_path);
    $config_data = $source->read('markaspot_nuxt.settings');

    if ($config_data) {
      foreach ($config_data as $key => $value) {
        $nuxt_config->set($key, $value);
      }
    }
  }

  // Immediately migrate from markaspot_map if it exists.
  $map_config = $config_factory->get('markaspot_map.settings');
  if (!$map_config->isNew()) {
    $fields_to_migrate = [
      'mapbox_token',
      'mapbox_style',
      'mapbox_style_dark',
      'osm_custom_attribution',
      'zoom_initial',
      'center_lat',
      'center_lng',
    ];

    foreach ($fields_to_migrate as $field) {
      $value = $map_config->get($field);
      if ($value !== NULL && $value !== '') {
        $nuxt_config->set($field, $value);
      }
    }
  }

  $nuxt_config->save();
}

/**
 * Migrate map configuration from markaspot_map.settings to markaspot_nuxt.settings.
 */
function markaspot_nuxt_update_9001() {
  $config_factory = \Drupal::configFactory();
  $map_config = $config_factory->getEditable('markaspot_map.settings');
  $nuxt_config = $config_factory->getEditable('markaspot_nuxt.settings');

  // Check if markaspot_map.settings exists.
  if ($map_config->isNew()) {
    return t('No markaspot_map.settings found to migrate.');
  }

  // Define the fields to migrate from markaspot_map to markaspot_nuxt.
  $fields_to_migrate = [
    'mapbox_token',
    'mapbox_style',
    'mapbox_style_dark',
    'osm_custom_attribution',
    'zoom_initial',
    'center_lat',
    'center_lng',
  ];

  $migrated_count = 0;

  foreach ($fields_to_migrate as $field) {
    $value = $map_config->get($field);

    // Only migrate if the field has a non-null value.
    if ($value !== NULL) {
      $nuxt_config->set($field, $value);
      $migrated_count++;
    }
  }

  // Save the nuxt config only if we migrated any values.
  if ($migrated_count > 0) {
    $nuxt_config->save();
    return t('Migrated @count map configuration settings from markaspot_map.settings to markaspot_nuxt.settings.', ['@count' => $migrated_count]);
  }

  return t('No map configuration values found to migrate.');
}

/**
 * Ensure markaspot_nuxt.settings exists and migrate from markaspot_map if needed.
 */
function markaspot_nuxt_update_9002() {
  $config_factory = \Drupal::configFactory();
  $nuxt_config = $config_factory->getEditable('markaspot_nuxt.settings');

  // If config doesn't exist, create it with defaults from config/install.
  if ($nuxt_config->isNew()) {
    $config_path = \Drupal::service('extension.list.module')->getPath('markaspot_nuxt') . '/config/install';
    $source = new FileStorage($config_path);
    $config_data = $source->read('markaspot_nuxt.settings');

    if ($config_data) {
      foreach ($config_data as $key => $value) {
        $nuxt_config->set($key, $value);
      }
    }

    // Migrate from markaspot_map if it exists.
    $map_config = $config_factory->get('markaspot_map.settings');
    if (!$map_config->isNew()) {
      $fields_to_migrate = [
        'mapbox_token',
        'mapbox_style',
        'mapbox_style_dark',
        'osm_custom_attribution',
        'zoom_initial',
        'center_lat',
        'center_lng',
      ];

      $migrated_count = 0;
      foreach ($fields_to_migrate as $field) {
        $value = $map_config->get($field);
        if ($value !== NULL && $value !== '') {
          $nuxt_config->set($field, $value);
          $migrated_count++;
        }
      }

      $nuxt_config->save();
      return t('Created markaspot_nuxt.settings and migrated @count settings from markaspot_map.settings.', ['@count' => $migrated_count]);
    }

    $nuxt_config->save();
    return t('Created markaspot_nuxt.settings with default values.');
  }

  return t('markaspot_nuxt.settings already exists.');
}

/**
 * Enable jsonapi_extras resource configs for district and sublocality terms.
 *
 * Mark-a-Spot sets jsonapi_extras.settings.default_disabled to TRUE, which
 * means any taxonomy_term bundle without an explicit resource config is
 * silently hidden from JSON:API. Relationships pointing at such a bundle
 * are serialized with data: null regardless of the underlying field value
 * — which is exactly what happened on the dashboard edit form when the
 * Drupal side already had field_district / field_sublocality populated.
 *
 * This hook creates the two missing resource configs for existing tenants.
 * Fresh installs get them via config/optional on module install, once the
 * matching vocabulary exists.
 *
 * Idempotent: skips resources that already have a config entry.
 */
function markaspot_nuxt_update_9003(): string {
  $messages = [];
  $factory = \Drupal::configFactory();

  $resources = [
    'taxonomy_term--district' => [
      'vocabulary' => 'district',
      'label_dep' => 'taxonomy.vocabulary.district',
    ],
    'taxonomy_term--sublocality' => [
      'vocabulary' => 'sublocality',
      'label_dep' => 'taxonomy.vocabulary.sublocality',
    ],
  ];

  foreach ($resources as $id => $info) {
    // Skip bundles whose vocabulary is not installed on this tenant.
    $vocab = \Drupal::entityTypeManager()
      ->getStorage('taxonomy_vocabulary')
      ->load($info['vocabulary']);
    if (!$vocab) {
      $messages[] = "Skipped {$id}: vocabulary not installed.";
      continue;
    }

    $config_name = 'jsonapi_extras.jsonapi_resource_config.' . $id;
    $config = $factory->getEditable($config_name);

    if (!$config->isNew() && $config->get('disabled') === FALSE) {
      $messages[] = "Skipped {$id}: already enabled.";
      continue;
    }

    $config->setData([
      'langcode' => 'en',
      'status' => TRUE,
      'dependencies' => [
        'config' => [$info['label_dep']],
      ],
      'id' => $id,
      'disabled' => FALSE,
      'path' => 'taxonomy_term/' . $info['vocabulary'],
      'resourceType' => $id,
      'resourceFields' => [],
    ])->save();

    $messages[] = "Enabled {$id} in jsonapi_extras.";
  }

  return implode("\n", $messages);
}

/**
 * Decouple privacyNotice (UI modal) from field_gdpr.required (form consent).
 *
 * Tenants whose field_nuxt_config had features.privacyNotice.enabled=TRUE
 * implicitly required field_gdpr=TRUE on every service_request via the
 * presave hook. The 11.9.x decoupling refactor splits those concerns:
 * privacyNotice now controls only the disclosure modal/banner, while
 * fields.field_gdpr.required is the new explicit consent gate.
 *
 * To preserve behaviour for tenants that relied on the implicit coupling
 * (Munich style strict-disclosure), this hook reads the old privacyNotice
 * flag and seeds the new fields.field_gdpr.required flag where missing.
 *
 * Idempotent: skips groups whose fields.field_gdpr.required is already set.
 */
function markaspot_nuxt_update_11900(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('group');
  $gids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'jur')
    ->execute();

  $migrated = 0;
  $skipped = 0;
  foreach ($storage->loadMultiple($gids) as $group) {
    if (!$group->hasField('field_nuxt_config') || $group->get('field_nuxt_config')->isEmpty()) {
      $skipped++;
      continue;
    }
    $raw = (string) $group->get('field_nuxt_config')->value;
    $config = json_decode($raw, TRUE);
    if (!is_array($config)) {
      $skipped++;
      continue;
    }

    // Already has the explicit flag: leave alone.
    if (isset($config['fields']['field_gdpr']['required'])) {
      $skipped++;
      continue;
    }

    $privacyNoticeEnabled = (bool) ($config['features']['privacyNotice']['enabled'] ?? FALSE);
    if (!$privacyNoticeEnabled) {
      $skipped++;
      continue;
    }

    $config['fields']['field_gdpr']['required'] = TRUE;
    $group->set('field_nuxt_config', json_encode($config));
    // Write an explicit revision so the consent-relevant config change is
    // discoverable in the group's revision history (GoBD audit trail). The
    // hook runs once per jurisdiction, so this is a bounded one-time cost,
    // not the recurring revision bloat that setNewRevision(FALSE) guards
    // against on per-request saves.
    $group->setNewRevision(TRUE);
    $group->setRevisionLogMessage('Auto-migrated field_gdpr.required from features.privacyNotice.enabled (markaspot_nuxt update 11900).');
    $group->setRevisionCreationTime(\time());
    $group->save();
    $migrated++;
  }

  return sprintf(
    'Migrated %d jurisdictions from features.privacyNotice.enabled to fields.field_gdpr.required (skipped %d).',
    $migrated,
    $skipped,
  );
}

/**
 * Lock down user--user JSON:API sideloads to {uuid, name} only.
 *
 * Closes GDPR Art. 5(1)(c) data minimisation gap: when a node includes
 * `field_internal_remark.field_author`, Drupal sideloads the full user
 * resource. The dashboard only needs uuid + display_name/name, but the
 * historic config left mail, roles, access/login timestamps,
 * field_internal_phone, field_internal_orga and other PII enabled. Cross-org
 * staff browsers could read those off the wire via devtools.
 *
 * The fix mirrors the rewritten optional config so fresh installs and
 * existing tenants converge on the same minimal exposure surface.
 */
function markaspot_nuxt_update_11901(): string {
  $allow = ['uuid', 'name'];
  $config = \Drupal::configFactory()->getEditable('jsonapi_extras.jsonapi_resource_config.user--user');

  // Tenants that never installed this optional config fall through to the
  // default JSON:API resource handler, which exposes every user field with no
  // filter. Seed the config from the shipped optional yaml so the lockdown
  // applies regardless of the prior state.
  if ($config->isNew()) {
    $source = new FileStorage(__DIR__ . '/config/optional');
    $seed = $source->read('jsonapi_extras.jsonapi_resource_config.user--user');
    if ($seed === FALSE) {
      return 'Optional config source missing, cannot seed user--user lockdown.';
    }
    $config->setData($seed)->save();
    return 'Seeded jsonapi_extras.jsonapi_resource_config.user--user with locked-down fields (kept: ' . implode(', ', $allow) . ').';
  }

  $fields = $config->get('resourceFields') ?? [];
  $changed = 0;
  foreach ($fields as $key => $field) {
    $shouldDisable = !in_array($key, $allow, TRUE);
    if (($field['disabled'] ?? FALSE) !== $shouldDisable) {
      $fields[$key]['disabled'] = $shouldDisable;
      $changed++;
    }
  }

  // The resource itself must stay enabled so JSON:API can resolve user
  // relationships in includes (e.g. field_internal_remark.field_author).
  // Setting disabled=true on the resource also blocks sideload resolution.
  if ($config->get('disabled') === TRUE) {
    $config->set('disabled', FALSE);
    $changed++;
  }

  if ($changed === 0) {
    return 'No user--user resource fields needed updating.';
  }

  $config->set('resourceFields', $fields)->save();
  return sprintf('Locked down %d user--user resource field(s) to disabled=true (kept: %s).', $changed, implode(', ', $allow));
}

/**
 * Enable taxonomy_term--internal_status for existing JSON:API tenants.
 */
function markaspot_nuxt_update_11902(): string {
  $vocab = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_vocabulary')
    ->load('internal_status');
  if (!$vocab) {
    return 'Skipped taxonomy_term--internal_status: vocabulary not installed.';
  }

  $config_name = 'jsonapi_extras.jsonapi_resource_config.taxonomy_term--internal_status';
  $config = \Drupal::configFactory()->getEditable($config_name);
  if (!$config->isNew() && $config->get('disabled') === FALSE) {
    return 'Skipped taxonomy_term--internal_status: already enabled.';
  }

  $source = new FileStorage(__DIR__ . '/config/optional');
  $seed = $source->read($config_name);
  if ($seed === FALSE) {
    return 'Optional config source missing, cannot seed taxonomy_term--internal_status.';
  }

  if ($config->isNew()) {
    $config->setData($seed)->save(TRUE);
    return 'Seeded taxonomy_term--internal_status JSON:API resource config.';
  }

  $config
    ->set('disabled', FALSE)
    ->set('path', $seed['path'] ?? 'taxonomy_term/internal_status')
    ->set('resourceType', $seed['resourceType'] ?? 'taxonomy_term--internal_status');
  if (!$config->get('resourceFields') && isset($seed['resourceFields'])) {
    $config->set('resourceFields', $seed['resourceFields']);
  }
  $config->save(TRUE);

  return 'Enabled taxonomy_term--internal_status JSON:API resource config.';
}

/**
 * Hide internal organisation notification mailboxes from group--org JSON:API.
 */
function markaspot_nuxt_update_11903(): string {
  $config_name = 'jsonapi_extras.jsonapi_resource_config.group--org';
  $org_type = \Drupal::entityTypeManager()
    ->getStorage('group_type')
    ->load('org');
  if (!$org_type) {
    return 'Skipped group--org JSON:API resource config: org group type not installed.';
  }

  $config = \Drupal::configFactory()->getEditable($config_name);

  if ($config->isNew()) {
    return 'Skipped group--org JSON:API resource config: resource not enabled on this tenant.';
  }

  $fields = $config->get('resourceFields') ?? [];
  $fields = is_array($fields) ? $fields : [];
  $mail_field = $fields['field_head_organisation_e_mail'] ?? [];
  $mail_field = is_array($mail_field) ? $mail_field : [];
  $mail_field += [
    'fieldName' => 'field_head_organisation_e_mail',
    'publicName' => 'field_head_organisation_e_mail',
    'enhancer' => ['id' => ''],
  ];
  $mail_field['disabled'] = TRUE;
  $fields['field_head_organisation_e_mail'] = $mail_field;

  if ($config->get('resourceFields') === $fields) {
    return 'group--org JSON:API resource already hides field_head_organisation_e_mail.';
  }

  $config->set('resourceFields', $fields)->save(TRUE);
  return 'Disabled field_head_organisation_e_mail on group--org JSON:API resource.';
}

/**
 * Hide revision author / log / timestamp on the service_request JSON:API resource.
 *
 * revision_uid, revision_log and revision_timestamp were exposed (disabled:
 * false) on the public node--service_request JSON:API resource. Once revisions
 * carry a real editor (GeoreportRequestResource, markaspot-ui#472), revision_uid
 * becomes a staff-identity oracle readable by anonymous JSON:API callers. These
 * fields have no public/citizen audience, so disable them. Author identity for
 * the dashboard "last edited by" indicator (markaspot-ui#472) must be served
 * through a staff-gated channel, not this public relationship. Note: the
 * existing GeoReport extended_attributes.author exposes the node author (uid),
 * not the revision editor, so #472 needs its own gated revision-author field.
 *
 * Fresh installs ship the hardened config via config/optional; this hook
 * backfills already-installed tenants. Idempotent. The node author field (uid)
 * is hardened separately by markaspot_nuxt_update_11906().
 */
function markaspot_nuxt_update_11904(): string {
  // jsonapi_extras (which provides the jsonapi_resource_config entity type) is
  // optional and disabled on some tenants (e.g. FastMap). getStorage() throws
  // on a missing entity TYPE. The `if (!$resource)` guard below only covers a
  // missing config ENTITY, not a missing type, so without this check the hook
  // aborts updb on those tenants. Guard the type's existence first.
  if (!\Drupal::entityTypeManager()->hasDefinition('jsonapi_resource_config')) {
    return 'Skipped node--service_request JSON:API resource config: jsonapi_extras not enabled on this tenant.';
  }
  $storage = \Drupal::entityTypeManager()->getStorage('jsonapi_resource_config');
  $resource = $storage->load('node--service_request');

  if (!$resource) {
    return 'Skipped node--service_request JSON:API resource config: resource not enabled on this tenant.';
  }

  $fields = $resource->get('resourceFields') ?? [];
  $fields = is_array($fields) ? $fields : [];

  foreach (['revision_uid', 'revision_log', 'revision_timestamp'] as $field_name) {
    $field = $fields[$field_name] ?? [];
    $field = is_array($field) ? $field : [];
    $field += [
      'fieldName' => $field_name,
      'publicName' => $field_name,
      'enhancer' => ['id' => ''],
    ];
    $field['disabled'] = TRUE;
    $fields[$field_name] = $field;
  }

  if ($resource->get('resourceFields') === $fields) {
    return 'node--service_request JSON:API resource already hides revision_uid / revision_log / revision_timestamp.';
  }

  // Saving the config entity (not raw config) fires
  // JsonapiResourceConfig::postSave(), which rebuilds the JSON:API routes and
  // resets the resource-type repository, so the field-disable takes effect
  // immediately without relying on an external cache rebuild.
  $resource->set('resourceFields', $fields);
  $resource->save();
  return 'Disabled revision_uid / revision_log / revision_timestamp on node--service_request JSON:API resource.';
}

/**
 * Enable jsonapi_resources for the service request version-history endpoint.
 *
 * The dashboard "version history" view (markaspot-ui#329) lists a service
 * request's revisions through a custom JSON:API resource
 * (Drupal\markaspot_nuxt\Resource\ServiceRequestVersionHistory). That resource
 * is served by the jsonapi_resources contrib, which fresh installs already
 * enable via the profile install list. This hook backfills already-installed
 * tenants. Idempotent: a no-op when the module is already enabled.
 */
function markaspot_nuxt_update_11905(): string {
  if (\Drupal::moduleHandler()->moduleExists('jsonapi_resources')) {
    return 'jsonapi_resources already enabled.';
  }

  \Drupal::service('module_installer')->install(['jsonapi_resources']);

  return 'Enabled jsonapi_resources for the service request version-history endpoint.';
}

/**
 * Hide raw service request author relationships from public JSON:API.
 *
 * The dashboard creator/editor display is served through manager-gated Open311
 * fields. Raw JSON:API relationships (uid/revision_uid) expose Drupal user
 * identity and must remain disabled on existing tenants, independent of config
 * import. Idempotent.
 */
function markaspot_nuxt_update_11906(): string {
  if (!\Drupal::entityTypeManager()->hasDefinition('jsonapi_resource_config')) {
    return 'Skipped node--service_request JSON:API resource config: jsonapi_extras not enabled on this tenant.';
  }

  $storage = \Drupal::entityTypeManager()->getStorage('jsonapi_resource_config');
  $resource = $storage->load('node--service_request');

  if (!$resource) {
    return 'Skipped node--service_request JSON:API resource config: resource not enabled on this tenant.';
  }

  $fields = $resource->get('resourceFields') ?? [];
  $fields = is_array($fields) ? $fields : [];

  foreach (['uid', 'revision_uid'] as $field_name) {
    $field = $fields[$field_name] ?? [];
    $field = is_array($field) ? $field : [];
    $field += [
      'fieldName' => $field_name,
      'publicName' => $field_name,
      'enhancer' => ['id' => ''],
    ];
    $field['disabled'] = TRUE;
    $fields[$field_name] = $field;
  }

  if ($resource->get('resourceFields') === $fields) {
    return 'node--service_request JSON:API resource already hides uid / revision_uid.';
  }

  $resource->set('resourceFields', $fields);
  $resource->save();

  return 'Disabled uid / revision_uid on node--service_request JSON:API resource.';
}

/**
 * Backfill dashboard JSON:API resource configs for existing tenants.
 *
 * jsonapi_extras intentionally disables unconfigured resources on FastMap
 * tenants. Optional config is installed for fresh sites, but Drupal does not
 * retroactively install it for tenants that already had markaspot_nuxt. Seed
 * only the resources needed by the request dashboard and its included data.
 * Existing resource configs are left untouched so tenant-specific settings
 * remain authoritative.
 */
function markaspot_nuxt_update_11907(): string {
  if (!\Drupal::entityTypeManager()->hasDefinition('jsonapi_resource_config')) {
    return 'Skipped dashboard JSON:API resource backfill: jsonapi_extras is not enabled on this tenant.';
  }

  $source = new FileStorage(__DIR__ . '/config/optional');
  $configFactory = \Drupal::configFactory();
  $moduleHandler = \Drupal::moduleHandler();
  $storage = \Drupal::entityTypeManager()->getStorage('jsonapi_resource_config');
  $entityFieldManager = \Drupal::service('entity_field.manager');
  $hardenResourceFields = static function ($resource, string $entityTypeId, string $bundle, array $allowedFields) use ($entityFieldManager): bool {
    $fields = $resource->get('resourceFields') ?? [];
    $changed = FALSE;

    foreach (array_keys($entityFieldManager->getFieldDefinitions($entityTypeId, $bundle)) as $fieldName) {
      if (in_array($fieldName, $allowedFields, TRUE)) {
        continue;
      }
      $field = [
        'disabled' => TRUE,
        'fieldName' => $fieldName,
        'publicName' => $fieldName,
        'enhancer' => ['id' => ''],
      ];
      if (($fields[$fieldName] ?? NULL) === $field) {
        continue;
      }
      $fields[$fieldName] = $field;
      $changed = TRUE;
    }

    if ($changed) {
      $resource->set('resourceFields', $fields);
    }

    return $changed;
  };
  $hardeningPolicies = [
    'group--jur' => ['group', 'jur', ['id', 'label']],
    'paragraph--internal_remark' => ['paragraph', 'internal_remark', ['id', 'uuid', 'created', 'field_internal_remark_text', 'field_author']],
    'taxonomy_term--service_provider_status' => ['taxonomy_term', 'service_provider_status', ['tid', 'status', 'name', 'weight']],
    'node--boilerplate' => ['node', 'boilerplate', ['nid', 'title', 'body', 'field_jurisdiction', 'field_boilerplate_type', 'field_organisation']],
  ];
  $resourceIds = [
    'node--service_request',
    'group--jur',
    'group--org',
    'taxonomy_term--service_category',
    'taxonomy_term--service_status',
    'taxonomy_term--district',
    'taxonomy_term--sublocality',
    'media--request_image',
    'file--file',
    'paragraph--status',
    'paragraph--internal_remark',
    'taxonomy_term--service_provider',
    'taxonomy_term--service_provider_status',
    'node--boilerplate',
    'user--user',
  ];
  $seeded = [];
  $hardened = [];
  $skipped = [];

  foreach ($resourceIds as $resourceId) {
    $existing = $storage->load($resourceId);
    if ($existing) {
      if (isset($hardeningPolicies[$resourceId])) {
        [$entityTypeId, $bundle, $allowedFields] = $hardeningPolicies[$resourceId];
        // Tighten legacy copies as well as newly seeded resources. These
        // dashboard contracts deliberately expose only their allow-listed
        // fields, including tenant-specific group and billing data.
        if ($hardenResourceFields($existing, $entityTypeId, $bundle, $allowedFields)) {
          $existing->save();
          $hardened[] = $resourceId;
        }
      }
      continue;
    }

    $configName = 'jsonapi_extras.jsonapi_resource_config.' . $resourceId;
    $seed = $source->read($configName);
    if ($seed === FALSE) {
      $skipped[] = $resourceId . ' (source missing)';
      continue;
    }

    foreach ($seed['dependencies']['module'] ?? [] as $module) {
      if (!$moduleHandler->moduleExists($module)) {
        $skipped[] = $resourceId . ' (module ' . $module . ' missing)';
        continue 2;
      }
    }
    foreach ($seed['dependencies']['config'] ?? [] as $dependency) {
      if ($configFactory->get($dependency)->isNew()) {
        $skipped[] = $resourceId . ' (config dependency missing)';
        continue 2;
      }
    }

    $resource = $storage->create($seed);
    if (isset($hardeningPolicies[$resourceId])) {
      [$entityTypeId, $bundle, $allowedFields] = $hardeningPolicies[$resourceId];
      $hardenResourceFields($resource, $entityTypeId, $bundle, $allowedFields);
    }

    // Save through the config entity storage so jsonapi_extras rebuilds its
    // route and resource-type caches immediately.
    $resource->save();
    $seeded[] = $resourceId;
  }

  if (!$seeded && !$hardened && !$skipped) {
    return 'Dashboard JSON:API resource configs already exist.';
  }

  $message = $seeded
    ? 'Seeded dashboard JSON:API resource configs: ' . implode(', ', $seeded) . '.'
    : 'No dashboard JSON:API resource configs were seeded.';
  if ($skipped) {
    $message .= ' Skipped: ' . implode(', ', $skipped) . '.';
  }
  if ($hardened) {
    $message .= ' Hardened existing resource configs: ' . implode(', ', $hardened) . '.';
  }

  return $message;
}
