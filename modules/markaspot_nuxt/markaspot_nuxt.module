<?php

/**
 * @file
 * Contains Nuxt frontend integration hooks for Mark-a-Spot.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\file\Entity\File;
use Drupal\group\Entity\GroupInterface;
use Drupal\markaspot_nuxt\Field\DashboardMediaItemList;
use Drupal\markaspot_nuxt\Field\DashboardReferenceData;
use Drupal\markaspot_nuxt\Field\DashboardStatusNotesItemList;
use Drupal\node\NodeInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\user\UserInterface;
use Symfony\Component\HttpKernel\Exception\UnprocessableEntityHttpException;
use Symfony\Component\HttpKernel\Exception\BadRequestHttpException;

/**
 * Implements hook_entity_presave().
 */
function markaspot_nuxt_entity_presave(EntityInterface $entity) {
  // Check if the entity is a file and is temporary.
  if ($entity->getEntityTypeId() === 'file' && $entity->isTemporary()) {
    $original_uri = $entity->getFileUri();

    // Only process files that are in the request media directory
    // Skip views_data_export and other system temporary files.
    if (strpos($original_uri, 'public://') !== 0 ||
        strpos($original_uri, 'views_data_export') !== FALSE ||
        strpos($original_uri, 'batch') !== FALSE) {
      return;
    }

    // Load the file repository service.
    $file_repository = \Drupal::service('file.repository');

    // Use the file repository to load the file by URI.
    $existing_file = $file_repository->loadByUri($original_uri);

    if ($existing_file) {
      if ($existing_file->isTemporary()) {
        // Safety check: Don't delete if file has image derivatives or is in use.
        if (markaspot_nuxt_can_safely_delete_file($existing_file)) {
          $existing_file->delete();
          \Drupal::logger('markaspot_nuxt')->notice('Safely deleted existing temporary file: @uri', [
            '@uri' => $original_uri,
          ]);
        }
        else {
          // Generate unique filename instead of deleting.
          $directory = dirname($original_uri);
          $filename = basename($original_uri);
          $unique_filename = \Drupal::service('file.repository')->mungeFilename(uniqid() . '_' . $filename);
          $new_uri = $directory . '/' . $unique_filename;
          $entity->setFileUri($new_uri);

          \Drupal::logger('markaspot_nuxt')->notice('Preserved existing file and renamed new file: @old -> @new', [
            '@old' => $original_uri,
            '@new' => $new_uri,
          ]);
        }
      }
      else {
        // Generate a new unique filename if the existing file is permanent.
        $directory = dirname($original_uri);
        $filename = basename($original_uri);
        $unique_filename = basename(uniqid() . '_' . $filename);
        $new_uri = $directory . '/' . $unique_filename;
        $entity->setFileUri($new_uri);

        \Drupal::logger('markaspot_nuxt')->notice('Renamed conflicting file URI: @old -> @new', [
          '@old' => $original_uri,
          '@new' => $new_uri,
        ]);
      }
    }

    // Mark the file as permanent.
    $entity->setPermanent();
  }
}

/**
 * Implements hook_node_presave().
 *
 * Enforces the per-jurisdiction GDPR-consent requirement on service request
 * creation. When fields.field_gdpr.required is true for the report's
 * jurisdiction, the submission must set field_gdpr to TRUE.
 *
 * The check runs only on new nodes — editing an existing report does not
 * require re-consenting. The default when the flag is unset is FALSE.
 * Strict-disclosure tenants (e.g. Munich) opt in by setting
 * fields.field_gdpr.required=true in field_nuxt_config.
 *
 * Decoupled from features.privacyNotice (UI modal display only): showing
 * a privacy-disclosure modal and persisting a per-report consent are two
 * separate semantic concerns that historically shared a single flag.
 *
 * Covers all save paths: Open311 REST, JSON:API, admin forms, drush
 * imports. Throws UnprocessableEntityHttpException which Drupal's kernel
 * exception subscriber maps to a 422 response for both REST and JSON:API.
 */
function markaspot_nuxt_node_presave(NodeInterface $node): void {
  if ($node->bundle() !== 'service_request' || !$node->isNew()) {
    return;
  }

  // JSON:API is the current citizen frontend create path. Restrict this
  // request-level gate to anonymous JSON:API creates so staff intake, mail
  // promotion, imports, and other entity save paths remain unchanged.
  $request = \Drupal::service('request_stack')->getCurrentRequest();
  $route = $request?->attributes->get('_route');
  if (is_string($route)
    && str_starts_with($route, 'jsonapi.node--service_request.collection.post')
    && \Drupal::currentUser()->isAnonymous()) {
    /** @var \Drupal\markaspot_nuxt\Service\FeatureFlagChecker $checker */
    $checker = \Drupal::service('markaspot_nuxt.feature_flag_checker');
    $jurisdiction = $checker->resolveJurisdictionForNode($node);
    if ($jurisdiction instanceof GroupInterface) {
      /** @var \Drupal\markaspot_nuxt\Service\FeatureScopeResolver $resolver */
      $resolver = \Drupal::service('markaspot_nuxt.feature_scope_resolver');
      if ($resolver->isEnabledEffective('privacyBlockOnFlag', $jurisdiction, FALSE)
        && $node->hasField('field_request_media')
        && !$node->get('field_request_media')->isEmpty()) {
        foreach ($node->get('field_request_media')->referencedEntities() as $media) {
          if ($media->hasField('field_ai_privacy_flag')
            && !$media->get('field_ai_privacy_flag')->isEmpty()
            && (bool) $media->get('field_ai_privacy_flag')->value) {
            throw new BadRequestHttpException(
              'This report cannot be submitted anonymously because an attached image was flagged for privacy review.'
            );
          }
        }
      }
    }
  }

  if (!$node->hasField('field_gdpr')) {
    return;
  }

  /** @var \Drupal\markaspot_nuxt\Service\FeatureFlagChecker $checker */
  $checker = \Drupal::service('markaspot_nuxt.feature_flag_checker');
  $jurisdiction = $checker->resolveJurisdictionForNode($node);

  // Schema default is false — consent only required when explicitly enabled
  // via fields.field_gdpr.required in field_nuxt_config.
  $required = $checker->isEnabled('fields.field_gdpr.required', $jurisdiction, FALSE);
  if (!$required) {
    return;
  }

  $gdpr = $node->get('field_gdpr');
  $accepted = !$gdpr->isEmpty() && ((bool) $gdpr->value === TRUE);
  if ($accepted) {
    return;
  }

  throw new UnprocessableEntityHttpException(
    'Privacy notice consent (field_gdpr) is required for this jurisdiction but was not accepted.'
  );
}

/**
 * Implements hook_ENTITY_TYPE_update() for group entities.
 */
function markaspot_nuxt_group_update(GroupInterface $group): void {
  if (!$group->hasField('field_slug')) {
    return;
  }

  $original = $group->getOriginal();
  if (!$original instanceof GroupInterface || !$original->hasField('field_slug')) {
    Cache::invalidateTags(['group:' . $group->id(), 'group_list']);
    return;
  }

  $previous_slug = trim($original->get('field_slug')->getString());
  $current_slug = trim($group->get('field_slug')->getString());
  if ($previous_slug === $current_slug) {
    return;
  }

  Cache::invalidateTags(['group:' . $group->id(), 'group_list']);
}

/**
 * Implements hook_ENTITY_TYPE_access() for user entities.
 */
function markaspot_nuxt_user_access(UserInterface $user, $operation, AccountInterface $account): AccessResultInterface {
  if ($operation === 'view label' && $account->isAnonymous()) {
    return AccessResult::forbidden()
      ->addCacheContexts(['user.roles:anonymous']);
  }

  return AccessResult::neutral()
    ->addCacheContexts(['user.roles:anonymous']);
}

/**
 * Implements hook_entity_bundle_field_info().
 */
function markaspot_nuxt_entity_bundle_field_info(\Drupal\Core\Entity\EntityTypeInterface $entity_type, string $bundle, array $base_field_definitions): array {
  if ($entity_type->id() !== 'node' || $bundle !== 'service_request') {
    return [];
  }

  $fields['dashboard_media'] = BaseFieldDefinition::create('string_long')
    ->setLabel(t('Dashboard media'))
    ->setComputed(TRUE)
    ->setClass(DashboardMediaItemList::class)
    ->setReadOnly(TRUE)
    ->setTranslatable(FALSE);

  $fields['dashboard_status_notes'] = BaseFieldDefinition::create('string_long')
    ->setLabel(t('Dashboard status notes'))
    ->setComputed(TRUE)
    ->setClass(DashboardStatusNotesItemList::class)
    ->setReadOnly(TRUE)
    ->setTranslatable(FALSE);

  return $fields;
}

/**
 * Implements hook_ENTITY_TYPE_load() for node entities.
 */
function markaspot_nuxt_node_load(array $nodes): void {
  $request = \Drupal::requestStack()->getCurrentRequest();
  $route_name = $request?->attributes->get('_route');
  if (!is_string($route_name) || !str_starts_with($route_name, 'jsonapi.node--service_request.collection')) {
    return;
  }

  $fieldsets = $request->query->all('fields');
  $computed_fields = ['dashboard_media', 'dashboard_status_notes', 'assignee_label'];
  // Absent and empty sparse fieldsets are opposites, not synonyms. Without the
  // parameter JSON:API serializes every field, so all computed fields are about
  // to be built and preloading them pays off. An explicitly empty fieldset
  // serializes no attributes at all, so the intersection below is empty and we
  // bail out exactly as we do for a fieldset naming no computed field.
  if (array_key_exists('node--service_request', $fieldsets)) {
    $requested_fields = array_filter(array_map(
      'trim',
      explode(',', (string) $fieldsets['node--service_request'])
    ));
    $computed_fields = array_values(array_intersect($computed_fields, $requested_fields));
    if ($computed_fields === []) {
      return;
    }
  }

  $service_requests = array_filter(
    $nodes,
    static fn (NodeInterface $node): bool => $node->bundle() === 'service_request'
  );
  DashboardReferenceData::preload($service_requests, $computed_fields);
}

/**
 * Implements hook_entity_field_access().
 */
function markaspot_nuxt_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  if ($field_definition->getTargetEntityTypeId() === 'node'
    && $field_definition->getTargetBundle() === 'service_request'
    && in_array($field_definition->getName(), ['dashboard_media', 'dashboard_status_notes'], TRUE)) {
    $field_name = $field_definition->getName();
    if ($operation === 'edit') {
      return AccessResult::forbidden(sprintf('%s is computed and read-only.', $field_name));
    }
    if ($operation !== 'view') {
      return AccessResult::neutral();
    }

    // Status-note summaries are dashboard-only data. Some legacy tenant
    // configurations grant anonymous users access to field_status_notes, so
    // mirroring the source field alone is not sufficient to protect the
    // computed field when Drupal is exposed without the Nuxt proxy.
    if ($field_name === 'dashboard_status_notes' && $account->isAnonymous()) {
      return AccessResult::forbidden('Dashboard status notes require an authenticated account.')
        ->addCacheContexts(['user.roles:anonymous']);
    }

    $node = $items?->getEntity();
    if (!$node instanceof NodeInterface || $node->bundle() !== 'service_request') {
      return AccessResult::forbidden(sprintf('Service request context is required for %s access.', $field_name))
        ->cachePerPermissions()
        ->addCacheContexts(['user']);
    }

    $source_field = $field_name === 'dashboard_media'
      ? 'field_request_media'
      : 'field_status_notes';
    if (!$node->hasField($source_field)) {
      return AccessResult::neutral()->addCacheableDependency($node);
    }

    $result = $node->get($source_field)->access('view', $account, TRUE);
    return DashboardReferenceData::addCacheability($result, $node, $account, $source_field)
      ->cachePerPermissions()
      ->addCacheableDependency($node);
  }

  if ($operation === 'view' && $account->isAnonymous() && markaspot_nuxt_is_user_reference_field($field_definition)) {
    return AccessResult::forbidden()
      ->addCacheContexts(['user.roles:anonymous']);
  }

  return AccessResult::neutral()
    ->addCacheContexts(['user.roles:anonymous']);
}

/**
 * Implements hook_jsonapi_entity_field_filter_access().
 */
function markaspot_nuxt_jsonapi_entity_field_filter_access(FieldDefinitionInterface $field_definition, AccountInterface $account): AccessResultInterface {
  if ($account->isAnonymous() && markaspot_nuxt_is_user_reference_field($field_definition)) {
    return AccessResult::forbidden()
      ->addCacheContexts(['user.roles:anonymous']);
  }

  return AccessResult::neutral()
    ->addCacheContexts(['user.roles:anonymous']);
}

/**
 * Determines whether a field exposes user entity references.
 */
function markaspot_nuxt_is_user_reference_field(FieldDefinitionInterface $field_definition): bool {
  return $field_definition->getType() === 'entity_reference'
    && $field_definition->getSetting('target_type') === 'user';
}

/**
 * Implements hook_file_access().
 */
function markaspot_nuxt_file_access(File $file, $operation, AccountInterface $account) {
  // Always allow access to files.
  // This is more permissive - adjust based on your security needs.
  return AccessResult::allowed()
    ->addCacheableDependency($file)
    ->cachePerUser();
}

/**
 * Safely check if a file can be deleted without breaking references.
 *
 * @param \Drupal\file\Entity\File $file
 *   The file entity to check.
 *
 * @return bool
 *   TRUE if safe to delete, FALSE otherwise.
 */
function markaspot_nuxt_can_safely_delete_file(File $file) {
  $file_uri = $file->getFileUri();

  try {
    // Check 1: File usage tracking.
    $file_usage = \Drupal::service('file.usage');
    $usage = $file_usage->listUsage($file);
    if (!empty($usage)) {
      \Drupal::logger('markaspot_nuxt')->info('File has usage records, preserving: @uri', [
        '@uri' => $file_uri,
      ]);
      return FALSE;
    }

    // Check 2: Image style derivatives exist.
    $entity_type_manager = \Drupal::entityTypeManager();
    $image_styles = $entity_type_manager->getStorage('image_style')->loadMultiple();

    foreach ($image_styles as $style) {
      $derivative_uri = $style->buildUri($file_uri);
      if (file_exists($derivative_uri)) {
        \Drupal::logger('markaspot_nuxt')->info('File has image derivatives, preserving: @uri (derivative: @derivative)', [
          '@uri' => $file_uri,
          '@derivative' => $derivative_uri,
        ]);
        return FALSE;
      }
    }

    // Check 3: Referenced by media entities.
    $media_storage = $entity_type_manager->getStorage('media');
    $media_query = $media_storage->getQuery()
      ->condition('field_media_image.target_id', $file->id())
      ->accessCheck(FALSE)
      ->count();

    if ($media_query->execute() > 0) {
      \Drupal::logger('markaspot_nuxt')->info('File referenced by media entities, preserving: @uri', [
        '@uri' => $file_uri,
      ]);
      return FALSE;
    }

    // Check 4: Recent file (within grace period)
    // 1 hour.
    $grace_period = 3600;
    if ((time() - $file->getCreatedTime()) < $grace_period) {
      \Drupal::logger('markaspot_nuxt')->info('File is recent (within grace period), preserving: @uri', [
        '@uri' => $file_uri,
      ]);
      return FALSE;
    }

    // All checks passed - safe to delete.
    return TRUE;

  }
  catch (\Exception $e) {
    // On any error, err on the side of caution.
    \Drupal::logger('markaspot_nuxt')->error('Error checking file safety, preserving file: @uri - @error', [
      '@uri' => $file_uri,
      '@error' => $e->getMessage(),
    ]);
    return FALSE;
  }
}
