/**
 * Add tier-scoped assignable invitation roles to FastMap settings.
 */
function markaspot_fastmap_update_11918(): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_fastmap.settings');
  if ($config->get('assignable_roles')) {
    return;
  }

  $paid_roles = [
    'jur-member',
    'jur-moderator',
    'org-member',
    'org-moderator',
    'jur-tenant_admin',
    'org-tenant_admin',
  ];

  $config
    ->set('assignable_roles', [
      'free' => [
        'jur-member',
        'org-member',
      ],
      'starter' => $paid_roles,
      'pro' => $paid_roles,
      'heart' => $paid_roles,
    ])
    ->save();
}

/**
 * Backfill missing features.passwordless in jur field_nuxt_config.
 *
 * WorkspaceProvisioningService::buildNuxtConfig() emitted the features
 * array without the passwordless key until the fix in this release.
 * Tenants provisioned via the Self-Service onboarding path (observed on
 * civicspot.io GIDs 39/40/41 between 2026-05-05 and 2026-05-11) inherited
 * the defect and rendered /auth/login as 302 to / because
 * TenantSettingsController reads `$features['passwordless'] ?? FALSE`
 * with strict semantics. Catches the same drift the runtime
 * markaspot_health PasswordlessFeatureMissingCheck plugin detects.
 *
 * Idempotent: skips groups where the key is already present (true OR
 * false), so an operator who intentionally disabled passwordless keeps
 * that choice across deploys.
 */
function markaspot_fastmap_update_11919(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('group');
  $gids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'jur')
    ->execute();

  $patched = 0;
  foreach ($storage->loadMultiple($gids) as $group) {
    $raw = $group->get('field_nuxt_config')->value;
    $cfg = json_decode((string) $raw, TRUE);
    if (!is_array($cfg)) {
      continue;
    }
    if (isset($cfg['features']) && is_array($cfg['features']) && array_key_exists('passwordless', $cfg['features'])) {
      continue;
    }
    if (!isset($cfg['features']) || !is_array($cfg['features'])) {
      $cfg['features'] = [];
    }
    $cfg['features']['passwordless'] = TRUE;
    $group->set('field_nuxt_config', json_encode($cfg, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE));
    $group->save();
    $patched++;
  }

  \Drupal::logger('markaspot_fastmap')->info('Backfilled features.passwordless on @count jur group(s).', ['@count' => $patched]);
}

/**
 * Add the blocked workspace visibility mode.
 *
 * Live tenant DBs hold field_visibility.allowed_values in two shapes:
 *   - Flat map (older installs): ['public' => 'Public', ...]
 *   - List of mappings after the Drupal options migration.
 *
 * Appending the wrong shape produces a mixed-type array and TypedConfig
 * refuses to save it with errors like
 * "settings.allowed_values.<n>.label.0 doesn't exist". Detect the existing
 * shape and append in kind so the hook is idempotent across both layouts.
 */
function markaspot_fastmap_update_11920(): void {
  $field_storage = FieldStorageConfig::loadByName('group', 'field_visibility');
  if (!$field_storage) {
    return;
  }

  $allowed_values = $field_storage->getSetting('allowed_values') ?: [];

  // Idempotency: already present in either shape.
  foreach ($allowed_values as $key => $item) {
    if ($key === 'blocked') {
      return;
    }
    if (is_array($item) && ($item['value'] ?? NULL) === 'blocked') {
      return;
    }
  }

  // Detect shape from the first existing entry.
  $isListOfMappings = FALSE;
  foreach ($allowed_values as $item) {
    $isListOfMappings = is_array($item) && array_key_exists('value', $item);
    break;
  }

  if ($isListOfMappings) {
    $allowed_values[] = ['value' => 'blocked', 'label' => 'Blocked'];
  }
  else {
    $allowed_values['blocked'] = 'Blocked';
  }

  $field_storage->setSetting('allowed_values', $allowed_values);
  $field_storage->save();
}

/**
 * Recovers from an incomplete 11920 update.
 *
 * This applies when system.schema advanced to 11920 without the field write
 * landing.
 *
 * Background: 11.9.85 shipped 11920 with a shape-naive append that failed
 * mid-flight on flat-map tenants (cp1 fastmap). system.schema got nudged to
 * 11920 but the field stayed unchanged. The 11.9.86 fix could not run via
 * updb because the counter said "done". 11921 re-emits the shape-aware
 * recovery so the standard `drush updb` path picks it up.
 *
 * Shape preservation is intentional: a flat-to-list normalization would
 * trigger Drupal core's "A list field with existing data cannot have its
 * keys changed" guard. Keep the existing shape, only append 'blocked'.
 *
 * Idempotent: returns early when 'blocked' is already present in either
 * shape — safe on dev/demo/any-cleanly-updated tenant.
 */
function markaspot_fastmap_update_11921(): void {
  $field_storage = FieldStorageConfig::loadByName('group', 'field_visibility');
  if (!$field_storage) {
    return;
  }

  $allowed_values = $field_storage->getSetting('allowed_values') ?: [];

  // Idempotency: already present in either shape.
  foreach ($allowed_values as $key => $item) {
    if ($key === 'blocked') {
      return;
    }
    if (is_array($item) && ($item['value'] ?? NULL) === 'blocked') {
      return;
    }
  }

  // Detect shape from the first existing entry.
  $isListOfMappings = FALSE;
  foreach ($allowed_values as $item) {
    $isListOfMappings = is_array($item) && array_key_exists('value', $item);
    break;
  }

  if ($isListOfMappings) {
    $allowed_values[] = ['value' => 'blocked', 'label' => 'Blocked'];
  }
  else {
    $allowed_values['blocked'] = 'Blocked';
  }

  $field_storage->setSetting('allowed_values', $allowed_values);
  $field_storage->save();
}

/**
 * Defer the workspace tier to Stripe webhook activation (Bug #2).
 *
 * Until 11.9.x, `field.field.group.jur.field_tier` shipped with
 * `default_value: free`. Every new jur group entity that did not explicitly
 * set a tier was stamped 'free' on save. The billing GET endpoint then
 * reported "Current Plan: Free" before the user had ever seen a Stripe
 * checkout, a UX lie at best and a compliance risk at worst.
 *
 * The new contract: tier is set ONLY by the Stripe webhook
 * checkout.session.completed handler. Demo workspaces have field_tier=NULL.
 *
 * This hook:
 * 1. Strips the field default_value so future installs get NULL tier.
 * 2. Re-classifies mis-stamped demo workspaces:
 *    field_tier='free' AND field_expiry_date IS NOT NULL AND no Stripe
 *    subscription -> field_tier=NULL.
 *    Other tier states are left untouched (paid, free_permanent partners).
 *
 * Idempotent: re-running on a clean tenant finds nothing to fix.
 */
function markaspot_fastmap_update_11922(): void {
  // 1. Strip the eager default from the field config so future installs
  //    get NULL tier. Operates on the active config so tenants that have
  //    already imported the old default get the new behavior immediately.
  $field_config = FieldConfig::loadByName('group', 'jur', 'field_tier');
  if ($field_config) {
    $default_value = $field_config->getDefaultValueLiteral();
    if (!empty($default_value)) {
      $field_config->setDefaultValue([]);
      $field_config->save();
    }
  }

  // 2. Re-classify mis-stamped demo workspaces. Direct DB updates avoid
  //    triggering all the group-save hooks (tier-change webhooks etc.)
  //    on the potentially-large set of demo workspaces affected.
  $connection = \Drupal::database();

  // Find jur groups with field_tier='free', non-empty expiry, and no
  // active Stripe subscription. These are the eager-free demo bleed.
  $query = $connection->select('group__field_tier', 't');
  $query->fields('t', ['entity_id']);
  $query->innerJoin('groups', 'g', 'g.id = t.entity_id AND g.type = :type', [':type' => 'jur']);
  $query->innerJoin('group__field_expiry_date', 'e', 'e.entity_id = t.entity_id');
  $query->leftJoin(
    'group__field_stripe_subscription_id',
    's',
    "s.entity_id = t.entity_id AND s.field_stripe_subscription_id_value IS NOT NULL AND TRIM(s.field_stripe_subscription_id_value) <> ''"
  );
  $query->condition('t.field_tier_value', 'free');
  $query->condition('e.field_expiry_date_value', 0, '>');
  $query->isNull('s.entity_id');

  $affected_ids = $query->execute()->fetchCol();

  if (empty($affected_ids)) {
    \Drupal::logger('markaspot_fastmap')->info(
      'update_11922: no mis-classified demo workspaces found.'
    );
    return;
  }

  $connection->delete('group__field_tier')
    ->condition('entity_id', $affected_ids, 'IN')
    ->execute();

  // Invalidate cache so the next read on these groups picks up the change.
  $tags = array_map(static fn($id) => 'group:' . $id, $affected_ids);
  \Drupal::service('cache_tags.invalidator')->invalidateTags($tags);

  \Drupal::logger('markaspot_fastmap')->notice(
    'update_11922: reset field_tier=NULL on @count mis-classified demo workspaces (ids: @ids).',
    [
      '@count' => count($affected_ids),
      '@ids' => implode(', ', array_slice($affected_ids, 0, 50)) . (count($affected_ids) > 50 ? ', ...' : ''),
    ]
  );
}

/**
 * Stores retry metadata on verified FastMap tokens.
 */
function markaspot_fastmap_update_11923(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('markaspot_fastmap_verified')) {
    return;
  }

  // Guard against parallel updb runs (multi-node container deploys, repeated
  // drush updb after a stalled first run). Without the advisory lock, two
  // concurrent DDL "ADD COLUMN" calls can race: one succeeds, the other dies
  // with "Duplicate column name" while system.schema has already advanced,
  // leaving the table in a partially-migrated state. The lock keeps the field
  // existence check and the addField call inside the same critical section.
  $lock = \Drupal::lock();
  $lockName = 'markaspot_fastmap_update_11923';
  if (!$lock->acquire($lockName, 30)) {
    \Drupal::logger('markaspot_fastmap')->warning(
      'update_11923: another process holds the schema lock; skipping. The next updb run will retry.'
    );
    return;
  }

  try {
    if (!$schema->fieldExists('markaspot_fastmap_verified', 'selected_tier')) {
      try {
        $schema->addField('markaspot_fastmap_verified', 'selected_tier', [
          'description' => 'Pricing tier selected during workspace creation.',
          'type' => 'varchar',
          'length' => 16,
          'not null' => FALSE,
        ]);
      }
      catch (\Throwable $e) {
        // If another node added the column between the check and the call,
        // swallow the duplicate-column error and proceed.
        if (!$schema->fieldExists('markaspot_fastmap_verified', 'selected_tier')) {
          throw $e;
        }
      }
    }

    if (!$schema->fieldExists('markaspot_fastmap_verified', 'login_claimed')) {
      try {
        $schema->addField('markaspot_fastmap_verified', 'login_claimed', [
          'description' => 'Whether a login token from this verified email token has been claimed.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ]);
      }
      catch (\Throwable $e) {
        if (!$schema->fieldExists('markaspot_fastmap_verified', 'login_claimed')) {
          throw $e;
        }
      }
    }
  }
  finally {
    $lock->release($lockName);
  }
}

/**
 * Backfills missing top-level keys in markaspot_fastmap.mail.
 *
 * Workspace_welcome was added to config/install/markaspot_fastmap.mail.yml
 * after workspace_verification shipped. Fresh installs pick up both keys,
 * but config/install is only applied on hook_install(), so existing
 * tenants whose module was installed before workspace_welcome was added
 * never received it in their active config. markaspot_fastmap_mail() then
 * crashed with "strtr(): Argument #1 must be of type string, null given"
 * building the welcome mail, silently swallowed by
 * FastMapWorkspaceController's fail-safe catch.
 *
 * Idempotent and additive only: an existing top-level key (including one
 * an admin hand-edited) is never touched, only missing keys are added from
 * the shipped YAML. Safe to run on tenants where the backfill was already
 * applied manually (cp1 fastmap, demo) — finds nothing missing and no-ops.
 */
function markaspot_fastmap_update_11924(): string {
  $config = \Drupal::configFactory()->getEditable('markaspot_fastmap.mail');
  $path = \Drupal::service('extension.list.module')->getPath('markaspot_fastmap')
    . '/config/install/markaspot_fastmap.mail.yml';

  $shipped = is_file($path) ? Yaml::decode(file_get_contents($path)) : NULL;
  if (!is_array($shipped)) {
    return 'Could not read shipped markaspot_fastmap.mail.yml, nothing backfilled.';
  }

  $backfilled = [];
  foreach ($shipped as $key => $value) {
    if ($key === 'langcode') {
      continue;
    }
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $backfilled[] = $key;
    }
  }

  if (empty($backfilled)) {
    return 'markaspot_fastmap.mail already has all shipped top-level keys, nothing to backfill.';
  }

  $config->save();

  return 'Backfilled markaspot_fastmap.mail key(s): ' . implode(', ', $backfilled) . '.';
}

/**
 * Removes the provisioned 64px header height from jurisdiction configs.
 */
function markaspot_fastmap_update_11925(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('group');
  $groups = $storage->loadByProperties(['type' => 'jur']);
  if ($groups === []) {
    return 'No jurisdiction groups found, nothing to clean up.';
  }

  $cleaned = 0;
  $kept = 0;
  $skipped = 0;

  foreach ($groups as $group) {
    if (!$group->hasField('field_nuxt_config') || $group->get('field_nuxt_config')->isEmpty()) {
      $skipped++;
      continue;
    }

    $raw = $group->get('field_nuxt_config')->value;
    $config = json_decode((string) $raw, TRUE);
    if (!is_array($config) || !isset($config['ui']['headerHeight'])) {
      $skipped++;
      continue;
    }

    // Only drop the value the provisioning wrote. An operator who chose a
    // different height did so deliberately and keeps it, even if it is also
    // too small: overriding a deliberate choice is not this hook's job.
    if ($config['ui']['headerHeight'] !== '64px') {
      $kept++;
      continue;
    }

    unset($config['ui']['headerHeight']);
    $encoded = json_encode($config, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    if ($encoded === FALSE) {
      // Never write a truncated config: leaving the header too small is a
      // cosmetic defect, losing the tenant configuration is not.
      \Drupal::logger('markaspot_fastmap')->error(
        'Could not re-encode field_nuxt_config for group @gid; header height left unchanged.',
        ['@gid' => $group->id()],
      );
      $skipped++;
      continue;
    }

    $group->set('field_nuxt_config', $encoded);
    $group->save();
    $cleaned++;
  }

  return sprintf(
    'Header height cleanup: %d cleared, %d kept (custom value), %d skipped.',
    $cleaned,
    $kept,
    $skipped,
  );
}

/**
 * Repairs billing fields on sites where update 11912 did not take effect.
 */
function markaspot_fastmap_update_11926(): string {
  $created = _markaspot_fastmap_ensure_billing_fields();

  return $created === []
    ? 'Billing field repair: nothing to do.'
    : 'Billing field repair created: ' . implode(', ', $created) . '.';
}

/**
 * Regenerates legal notices from the operator address and contact email.
 */
function markaspot_fastmap_update_11927(): string {
  $group_storage = \Drupal::entityTypeManager()->getStorage('group');
  $jurisdiction_bundle = (string) (\Drupal::config('markaspot_open311.settings')
    ->get('jurisdiction_group_type') ?: 'jur');
  $group_ids = array_values($group_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', $jurisdiction_bundle)
    ->sort('id')
    ->execute());

  /** @var \Drupal\markaspot_fastmap\Service\LegalNoticeGenerator $generator */
  $generator = \Drupal::service('markaspot_fastmap.legal_notice_generator');
  $written = 0;
  $skipped = 0;
  $failed = 0;

  foreach (array_chunk($group_ids, 50) as $chunk) {
    foreach ($group_storage->loadMultiple($chunk) as $group) {
      try {
        $langcodes = $generator->syncGroup($group);
        if ($langcodes === []) {
          $skipped++;
        }
        else {
          $written++;
        }
      }
      catch (\Throwable $e) {
        $failed++;
        \Drupal::logger('markaspot_fastmap')->error(
          'update_11927 could not regenerate the legal notice for group @id: @message',
          [
            '@id' => $group->id(),
            '@message' => $e->getMessage(),
          ],
        );
      }
    }
  }

  return sprintf(
    'Legal notice regeneration: %d written, %d skipped, %d failed.',
    $written,
    $skipped,
    $failed,
  );
}

/**
 * Preserves independently managed publication state on page translations.
 */
function markaspot_fastmap_update_11928(): string {
  // Retain the update number for installations that already recorded it. There
  // is no reliable provenance distinguishing incomplete translations from
  // intentional editorial drafts, so existing publication and front-page
  // settings must not be normalized. New provisioning sets these explicitly.
  return 'Page translation publication settings preserved; no data changes required.';
}
