/**
 * Add checkout_grace_days config for tier-based workspace expiry.
 */
function markaspot_fastmap_update_11910(): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_fastmap.settings');
  if ($config->get('checkout_grace_days') === NULL) {
    $config->set('checkout_grace_days', 14)->save();
  }
}

/**
 * Create markaspot_ai_usage table and add ai_budgets config.
 */
function markaspot_fastmap_update_11909(): void {
  $db = \Drupal::database();
  $schema = markaspot_fastmap_schema();

  if (!$db->schema()->tableExists('markaspot_ai_usage')) {
    $db->schema()->createTable('markaspot_ai_usage', $schema['markaspot_ai_usage']);
    \Drupal::logger('markaspot_fastmap')->info('Created markaspot_ai_usage table.');
  }

  $config = \Drupal::configFactory()->getEditable('markaspot_fastmap.settings');
  if (!$config->get('ai_budgets')) {
    $config->set('ai_budgets', [
      'free' => 50,
      'starter' => 100,
      'pro' => 500,
      'heart' => 100,
      'partner' => 0,
    ])->save();
    \Drupal::logger('markaspot_fastmap')->info('Added ai_budgets config.');
  }
}

/**
 * Grant 'access workspace usage' to authenticated role.
 *
 * In FastMap SaaS, workspace owners only have the 'authenticated' global role.
 * The WorkspaceUsageController::access() check still requires group membership,
 * so cross-tenant access is prevented. The global permission is a first gate
 * that must pass before the membership check runs.
 */
function markaspot_fastmap_update_11911(): void {
  $role = Role::load('authenticated');
  if ($role && !$role->hasPermission('access workspace usage')) {
    $role->grantPermission('access workspace usage');
    $role->save();
    \Drupal::logger('markaspot_fastmap')->info('Granted "access workspace usage" to authenticated role.');
  }
}

/**
 * Add billing address fields to jur group type.
 *
 * These fields store the billing address synced from Stripe after checkout.
 * They are managed automatically via the BillingController and webhook,
 * not edited manually in Drupal admin.
 */
function markaspot_fastmap_update_11912(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_fastmap');
  $fsc = $etm->getStorage('field_storage_config');
  $fc = $etm->getStorage('field_config');

  $billing_fields = [
    'field_billing_name' => [
      'label' => 'Billing Name',
      'description' => 'Company or person name for billing. Synced from Stripe.',
      'max_length' => 255,
    ],
    'field_billing_email' => [
      'label' => 'Billing Email',
      'description' => 'Billing contact email. Synced from Stripe.',
      'max_length' => 255,
    ],
    'field_billing_address_line1' => [
      'label' => 'Billing Address Line 1',
      'description' => 'Street address. Synced from Stripe.',
      'max_length' => 255,
    ],
    'field_billing_address_line2' => [
      'label' => 'Billing Address Line 2',
      'description' => 'Apartment, suite, etc. Synced from Stripe.',
      'max_length' => 255,
    ],
    'field_billing_city' => [
      'label' => 'Billing City',
      'description' => 'City for billing. Synced from Stripe.',
      'max_length' => 255,
    ],
    'field_billing_postal_code' => [
      'label' => 'Billing Postal Code',
      'description' => 'Postal/ZIP code. Synced from Stripe.',
      'max_length' => 20,
    ],
    'field_billing_country' => [
      'label' => 'Billing Country',
      'description' => 'ISO 3166-1 alpha-2 country code. Synced from Stripe.',
      'max_length' => 2,
    ],
    'field_billing_tax_id' => [
      'label' => 'Billing Tax ID',
      'description' => 'VAT or tax registration number. Optional.',
      'max_length' => 50,
    ],
  ];

  foreach ($billing_fields as $field_name => $meta) {
    // Create field storage.
    if (!$fsc->load("group.$field_name")) {
      $fsc->create([
        'field_name' => $field_name,
        'entity_type' => 'group',
        'type' => 'string',
        'module' => 'core',
        'cardinality' => 1,
        'settings' => [
          'max_length' => $meta['max_length'],
          'is_ascii' => FALSE,
          'case_sensitive' => FALSE,
        ],
        'third_party_settings' => [
          'field_permissions' => [
            'permission_type' => 'custom',
          ],
        ],
      ])->save();
      $logger->info('Created field storage: group.@field', ['@field' => $field_name]);
    }

    // Create field instance on jur bundle.
    if (!$fc->load("group.jur.$field_name")) {
      $storage = $fsc->load("group.$field_name");
      if ($storage) {
        $fc->create([
          'field_storage' => $storage,
          'bundle' => 'jur',
          'entity_type' => 'group',
          'field_name' => $field_name,
          'label' => $meta['label'],
          'description' => $meta['description'],
          'required' => FALSE,
          'translatable' => FALSE,
          'default_value' => [],
        ])->save();
        $logger->info('Created field instance: group.jur.@field', ['@field' => $field_name]);
      }
    }
  }

  // Hide billing address fields from form display (managed by webhook only).
  $form_display = $etm->getStorage('entity_form_display')
    ->load('group.jur.default');
  if ($form_display) {
    foreach (array_keys($billing_fields) as $field_name) {
      $form_display->removeComponent($field_name);
    }
    $form_display->save();
  }
}

/**
 * Backfill missing start pages for existing workspaces.
 *
 * Some workspaces were created before createStartPage() existed, or the
 * creation silently failed. This hook finds all jur groups without a
 * promoted+sticky page node and creates a fallback start page using the
 * same template mechanism as WorkspaceProvisioningService::createStartPage().
 */
function markaspot_fastmap_update_11913(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_fastmap');
  $groupStorage = $etm->getStorage('group');
  $nodeStorage = $etm->getStorage('node');

  // Only en/de provided for backfill; other languages fall back to en.
  // Full template set lives in WorkspaceProvisioningService::START_PAGE_TEMPLATES.
  $templates = [
    'en' => [
      'title' => 'Welcome to %name',
      'body' => '<p>Welcome to <strong>%name</strong>, your citizen reporting platform.</p>'
      . '<p>Use the map to browse existing reports or create a new one. '
      . 'Select a category, pin the location, and describe the issue. '
      . 'Your report helps make %name better for everyone.</p>',
    ],
    'de' => [
      'title' => 'Willkommen bei %name',
      'body' => '<p>Willkommen bei <strong>%name</strong>, Ihrer Plattform für Bürgeranliegen.</p>'
      . '<p>Nutzen Sie die Karte, um bestehende Meldungen zu sehen oder eine neue zu erstellen. '
      . 'Wählen Sie eine Kategorie, markieren Sie den Standort und beschreiben Sie das Anliegen. '
      . 'Ihre Meldung hilft, %name für alle zu verbessern.</p>',
    ],
  ];

  // Find all jur groups.
  $groupIds = $groupStorage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'jur')
    ->execute();

  if (empty($groupIds)) {
    $logger->info('No jur groups found. Nothing to backfill.');
    return;
  }

  $backfilled = 0;

  foreach ($groupStorage->loadMultiple($groupIds) as $group) {
    $groupId = (int) $group->id();
    $name = $group->label() ?: ('Workspace ' . $groupId);

    // Check if this group already has a promoted+sticky page node.
    $existing = $nodeStorage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'page')
      ->condition('field_jurisdiction', $groupId)
      ->condition('promote', 1)
      ->condition('sticky', 1)
      ->range(0, 1)
      ->execute();

    if (!empty($existing)) {
      continue;
    }

    // Determine language from the group entity's langcode.
    $langcode = $group->get('langcode')->value ?: 'en';
    $template = $templates[$langcode] ?? $templates['en'];
    $title = str_replace('%name', $name, $template['title']);
    $body = str_replace('%name', $name, $template['body']);

    try {
      $node = $nodeStorage->create([
        'type' => 'page',
        'langcode' => $langcode,
        'title' => $title,
        'body' => [
          'value' => $body,
          'format' => 'basic_html',
        ],
        'uid' => 1,
        'promote' => TRUE,
        'sticky' => TRUE,
        'status' => TRUE,
        'field_jurisdiction' => ['target_id' => $groupId],
      ]);
      $node->save();

      // Add group relationship if the plugin is installed.
      try {
        $group->addRelationship($node, 'group_node:page');
      }
      catch (\Exception $e) {
        $logger->warning('Could not add page group relationship for group @id: @msg', [
          '@id' => $groupId,
          '@msg' => $e->getMessage(),
        ]);
      }

      $backfilled++;
      $logger->info('Backfilled start page for workspace @name (group @id).', [
        '@name' => $name,
        '@id' => $groupId,
      ]);
    }
    catch (\Exception $e) {
      $logger->error('Failed to backfill start page for group @id: @msg', [
        '@id' => $groupId,
        '@msg' => $e->getMessage(),
      ]);
    }
  }

  $logger->info('Start page backfill complete: @count pages created.', [
    '@count' => $backfilled,
  ]);
}

/**
 * Install workspace verification mail translations for existing sites.
 *
 * The config/install/language/* YAML files are only used on fresh installs.
 * This hook backfills translations for sites that already have the module.
 */
function markaspot_fastmap_update_11914(): void {
  $language_manager = \Drupal::languageManager();
  $installed = 0;

  $translations = [
    'de' => [
      'subject' => '@site_name: Workspace "@workspace_name" bestätigen',
      'body' => "Sie haben einen neuen Workspace angefordert: @workspace_name\n\nKlicken Sie auf den folgenden Link, um Ihren Workspace zu bestätigen und zu aktivieren:\n@verify_url\n\nDieser Link ist @cleanup_days Tage gültig.\n\nFalls Sie dies nicht angefordert haben, ignorieren Sie bitte diese E-Mail.\n",
    ],
    'nl' => [
      'subject' => '@site_name: Bevestig je werkruimte "@workspace_name"',
      'body' => "Je hebt een nieuwe werkruimte aangevraagd: @workspace_name\n\nKlik op de onderstaande link om je werkruimte te bevestigen en te activeren:\n@verify_url\n\nDeze link verloopt over @cleanup_days dagen.\n\nAls je dit niet hebt aangevraagd, kun je deze e-mail negeren.\n",
    ],
    'fr' => [
      'subject' => '@site_name: Confirmez votre espace de travail "@workspace_name"',
      'body' => "Vous avez demandé un nouvel espace de travail : @workspace_name\n\nCliquez sur le lien ci-dessous pour confirmer et activer votre espace de travail :\n@verify_url\n\nCe lien expirera dans @cleanup_days jours.\n\nSi vous n'avez pas fait cette demande, veuillez ignorer cet e-mail.\n",
    ],
    'es' => [
      'subject' => '@site_name: Confirma tu espacio de trabajo "@workspace_name"',
      'body' => "Has solicitado un nuevo espacio de trabajo: @workspace_name\n\nHaz clic en el siguiente enlace para confirmar y activar tu espacio de trabajo:\n@verify_url\n\nEste enlace caducará en @cleanup_days días.\n\nSi no has solicitado esto, ignora este correo electrónico.\n",
    ],
    'pt-br' => [
      'subject' => '@site_name: Confirme seu espaço de trabalho "@workspace_name"',
      'body' => "Você solicitou um novo espaço de trabalho: @workspace_name\n\nClique no link abaixo para confirmar e ativar seu espaço de trabalho:\n@verify_url\n\nEste link expirará em @cleanup_days dias.\n\nSe você não solicitou isso, ignore este e-mail.\n",
    ],
    'pl' => [
      'subject' => '@site_name: Potwierdź swoją przestrzeń roboczą "@workspace_name"',
      'body' => "Wysłałeś prośbę o nową przestrzeń roboczą: @workspace_name\n\nKliknij poniższy link, aby potwierdzić i aktywować swoją przestrzeń roboczą:\n@verify_url\n\nTen link wygaśnie za @cleanup_days dni.\n\nJeśli nie składałeś tej prośby, zignoruj tego e-maila.\n",
    ],
    'tr' => [
      'subject' => '@site_name: "@workspace_name" çalışma alanınızı doğrulayın',
      'body' => "Yeni bir çalışma alanı talep ettiniz: @workspace_name\n\nÇalışma alanınızı doğrulamak ve etkinleştirmek için aşağıdaki bağlantıya tıklayın:\n@verify_url\n\nBu bağlantının süresi @cleanup_days gün içinde dolacaktır.\n\nBu talebi siz yapmadıysanız, lütfen bu e-postayı dikkate almayın.\n",
    ],
    'ar' => [
      'subject' => '@site_name: قم بتأكيد مساحة العمل الخاصة بك "@workspace_name"',
      'body' => "لقد طلبت مساحة عمل جديدة: @workspace_name\n\nانقر على الرابط أدناه لتأكيد وتفعيل مساحة العمل الخاصة بك:\n@verify_url\n\nستنتهي صلاحية هذا الرابط خلال @cleanup_days أيام.\n\nإذا لم تقم بهذا الطلب، يرجى تجاهل هذا البريد الإلكتروني.\n",
    ],
    'da' => [
      'subject' => '@site_name: Bekræft dit arbejdsområde "@workspace_name"',
      'body' => "Du har anmodet om et nyt arbejdsområde: @workspace_name\n\nKlik på linket nedenfor for at bekræfte og aktivere dit arbejdsområde:\n@verify_url\n\nDette link udløber om @cleanup_days dage.\n\nHvis du ikke har anmodet om dette, kan du ignorere denne e-mail.\n",
    ],
    'uk' => [
      'subject' => '@site_name: Підтвердіть ваш робочий простір "@workspace_name"',
      'body' => "Ви запросили новий робочий простір: @workspace_name\n\nНатисніть на посилання нижче, щоб підтвердити та активувати ваш робочий простір:\n@verify_url\n\nТермін дії цього посилання закінчиться через @cleanup_days днів.\n\nЯкщо ви не надсилали цей запит, будь ласка, проігноруйте цей лист.\n",
    ],
    'it' => [
      'subject' => '@site_name: Conferma il tuo spazio di lavoro "@workspace_name"',
      'body' => "Hai richiesto un nuovo spazio di lavoro: @workspace_name\n\nClicca sul link qui sotto per confermare e attivare il tuo spazio di lavoro:\n@verify_url\n\nQuesto link scadrà tra @cleanup_days giorni.\n\nSe non hai effettuato questa richiesta, ignora questa e-mail.\n",
    ],
  ];

  foreach ($translations as $langcode => $mail) {
    if (!$language_manager->getLanguage($langcode)) {
      continue;
    }
    $override = $language_manager->getLanguageConfigOverride($langcode, 'markaspot_fastmap.mail');
    if (!$override->isNew()) {
      continue;
    }
    $override->set('workspace_verification', $mail)->save();
    $installed++;
  }

  \Drupal::logger('markaspot_fastmap')->info('Installed @count fastmap mail translation(s).', [
    '@count' => $installed,
  ]);
}

/**
 * Add field_tos_accepted_at (timestamp) to user entity for ToS tracking.
 */
function markaspot_fastmap_update_11915(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_fastmap');

  // 1. Create field storage if it does not exist.
  $storage_id = 'user.field_tos_accepted_at';
  $field_storage = $etm->getStorage('field_storage_config')->load($storage_id);

  if (!$field_storage) {
    $field_storage = $etm->getStorage('field_storage_config')->create([
      'field_name' => 'field_tos_accepted_at',
      'entity_type' => 'user',
      'type' => 'timestamp',
      'settings' => [],
      'cardinality' => 1,
    ]);
    $field_storage->save();
    $logger->info('Created field storage user.field_tos_accepted_at.');
  }

  // 2. Create field instance on user bundle.
  $field_id = 'user.user.field_tos_accepted_at';
  $field_config = $etm->getStorage('field_config')->load($field_id);

  if (!$field_config) {
    $field_config = $etm->getStorage('field_config')->create([
      'field_storage' => $field_storage,
      'bundle' => 'user',
      'label' => 'ToS Accepted At',
      'description' => 'Timestamp when the user accepted the Terms of Service.',
      'required' => FALSE,
      'settings' => [],
    ]);
    $field_config->save();
    $logger->info('Created field instance user.user.field_tos_accepted_at.');
  }
}
