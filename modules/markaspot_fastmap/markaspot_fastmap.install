/**
 * Add field_tos_accepted_at (timestamp) to user entity for ToS tracking.
 */
function markaspot_fastmap_update_11915(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_fastmap');

  // 1. Create field storage if it does not exist.
  $storage_id = 'user.field_tos_accepted_at';
  $field_storage = $etm->getStorage('field_storage_config')->load($storage_id);

  if (!$field_storage) {
    $field_storage = $etm->getStorage('field_storage_config')->create([
      'field_name' => 'field_tos_accepted_at',
      'entity_type' => 'user',
      'type' => 'timestamp',
      'settings' => [],
      'cardinality' => 1,
    ]);
    $field_storage->save();
    $logger->info('Created field storage user.field_tos_accepted_at.');
  }

  // 2. Create field instance on user bundle.
  $field_id = 'user.user.field_tos_accepted_at';
  $field_config = $etm->getStorage('field_config')->load($field_id);

  if (!$field_config) {
    $field_config = $etm->getStorage('field_config')->create([
      'field_storage' => $field_storage,
      'bundle' => 'user',
      'label' => 'ToS Accepted At',
      'description' => 'Timestamp when the user accepted the Terms of Service.',
      'required' => FALSE,
      'settings' => [],
    ]);
    $field_config->save();
    $logger->info('Created field instance user.user.field_tos_accepted_at.');
  }
}

/**
 * Grant page permissions to jur-tenant_admin group role.
 *
 * Tenant admins need full page management (create, view, update, delete)
 * to manage info panel and start pages in the dashboard. Pages are created
 * by the system (uid=1), so "update any" is required, not just "update own".
 */
function markaspot_fastmap_update_11916(): void {
  $logger = \Drupal::logger('markaspot_fastmap');
  $role = \Drupal::entityTypeManager()->getStorage('group_role')->load('jur-tenant_admin');

  if (!$role) {
    $logger->warning('Group role jur-tenant_admin not found, skipping.');
    return;
  }

  $permissions = $role->getPermissions();
  $page_permissions = [
    'create group_node:page entity',
    'create group_node:page relationship',
    'update any group_node:page entity',
    'view group_node:page entity',
    'view group_node:page relationship',
    'delete any group_node:page entity',
  ];

  $added = [];
  foreach ($page_permissions as $perm) {
    if (!in_array($perm, $permissions, TRUE)) {
      $permissions[] = $perm;
      $added[] = $perm;
    }
  }

  if ($added) {
    $role->set('permissions', $permissions);
    $role->save();
    $logger->info('Granted @count page permissions to jur-tenant_admin: @perms', [
      '@count' => count($added),
      '@perms' => implode(', ', $added),
    ]);
  }
  else {
    $logger->info('jur-tenant_admin already has all page permissions.');
  }
}

