<?php

/**
 * @file
 * Install, update and uninstall functions for the FastMap module.
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function markaspot_fastmap_schema(): array {
  $schema['markaspot_fastmap_pending'] = [
    'description' => 'Stores pending workspace creation requests awaiting email verification.',
    'fields' => [
      'id' => [
        'description' => 'Primary Key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'token' => [
        'description' => 'Verification token (hex, 64 chars).',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'email' => [
        'description' => 'Email address of the requester.',
        'type' => 'varchar',
        'length' => 254,
        'not null' => TRUE,
      ],
      'workspace_data' => [
        'description' => 'Serialized workspace parameters.',
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
      ],
      'created' => [
        'description' => 'Unix timestamp of request creation.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'token' => ['token'],
    ],
    'indexes' => [
      'email' => ['email'],
      'created' => ['created'],
    ],
  ];

  $schema['markaspot_fastmap_verified'] = [
    'description' => 'Tracks verified tokens so re-verify works after email prefetch.',
    'fields' => [
      'token' => [
        'description' => 'Original verification token.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'slug' => [
        'description' => 'Provisioned workspace slug.',
        'type' => 'varchar',
        'length' => 30,
        'not null' => TRUE,
      ],
      'created' => [
        'description' => 'Unix timestamp of verification.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['token'],
    'indexes' => [
      'created' => ['created'],
    ],
  ];

  $schema['markaspot_ai_usage'] = [
    'description' => 'Tracks AI analysis calls per jurisdiction for budget enforcement.',
    'fields' => [
      'id' => [
        'description' => 'Primary Key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'group_id' => [
        'description' => 'Jurisdiction group ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'nid' => [
        'description' => 'Service request node ID (nullable).',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'default' => NULL,
      ],
      'created' => [
        'description' => 'Unix timestamp of analysis.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'tokens_used' => [
        'description' => 'Tokens consumed (for future cost tracking).',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'group_created' => ['group_id', 'created'],
    ],
  ];

  return $schema;
}

/**
 * Add field_tier to jur group type for subscription management.
 */
function markaspot_fastmap_update_11900(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_fastmap');
  $fsc = $etm->getStorage('field_storage_config');
  $fc = $etm->getStorage('field_config');

  // Create field storage.
  if (!$fsc->load('group.field_tier')) {
    $fsc->create([
      'field_name' => 'field_tier',
      'entity_type' => 'group',
      'type' => 'list_string',
      'module' => 'options',
      'cardinality' => 1,
      'settings' => [
        'allowed_values' => [
          'free' => 'Free',
          'starter' => 'Starter',
          'pro' => 'Pro',
          'heart' => 'Heart',
        ],
        'allowed_values_function' => '',
      ],
      'third_party_settings' => [
        'field_permissions' => [
          'permission_type' => 'custom',
        ],
      ],
    ])->save();
    $logger->info('Created field storage: group.field_tier');
  }

  // Create field instance on jur bundle.
  if (!$fc->load('group.jur.field_tier')) {
    $storage = $fsc->load('group.field_tier');
    if ($storage) {
      $fc->create([
        'field_storage' => $storage,
        'bundle' => 'jur',
        'entity_type' => 'group',
        'field_name' => 'field_tier',
        'label' => 'Tier',
        'description' => 'Subscription tier. Controls feature availability in the dashboard.',
        'required' => FALSE,
        'translatable' => FALSE,
        'default_value' => [['value' => 'free']],
      ])->save();
      $logger->info('Created field instance: group.jur.field_tier');
    }
  }

  // Add to form display.
  $form_display = $etm->getStorage('entity_form_display')
    ->load('group.jur.default');
  if ($form_display && !$form_display->getComponent('field_tier')) {
    $form_display->setComponent('field_tier', [
      'type' => 'options_select',
      'weight' => 0,
      'region' => 'content',
      'settings' => [],
    ]);
    $form_display->save();
  }

  // Ensure tier_limits config exists (for sites updating from before TierConfigService).
  $config = \Drupal::configFactory()->getEditable('markaspot_fastmap.settings');
  if (!$config->get('tier_limits')) {
    $config->set('tier_limits', [
      'free' => ['limit' => 50, 'period' => 'monthly'],
      'starter' => ['limit' => 500, 'period' => 'monthly'],
      'pro' => ['limit' => 2000, 'period' => 'monthly'],
      'heart' => ['limit' => 500, 'period' => 'monthly'],
    ])->save();
    $logger->info('Set default tier_limits config.');
  }

  // Backfill existing jurisdictions.
  $group_storage = $etm->getStorage('group');
  $ids = $group_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'jur')
    ->execute();

  foreach ($group_storage->loadMultiple($ids) as $group) {
    if ($group->hasField('field_tier') && $group->get('field_tier')->isEmpty()) {
      $group->set('field_tier', 'free');
      $group->save();
    }
  }
}

/**
 * Add field_visibility to jur group type for workspace access control.
 */
function markaspot_fastmap_update_11901(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_fastmap');
  $fsc = $etm->getStorage('field_storage_config');
  $fc = $etm->getStorage('field_config');

  // Create field storage.
  if (!$fsc->load('group.field_visibility')) {
    $fsc->create([
      'field_name' => 'field_visibility',
      'entity_type' => 'group',
      'type' => 'list_string',
      'module' => 'options',
      'cardinality' => 1,
      'settings' => [
        'allowed_values' => [
          'public' => 'Public',
          'submission_only' => 'Submission Only',
          'authenticated' => 'Authenticated',
        ],
        'allowed_values_function' => '',
      ],
      'third_party_settings' => [
        'field_permissions' => [
          'permission_type' => 'custom',
        ],
      ],
    ])->save();
    $logger->info('Created field storage: group.field_visibility');
  }

  // Create field instance on jur bundle.
  if (!$fc->load('group.jur.field_visibility')) {
    $storage = $fsc->load('group.field_visibility');
    if ($storage) {
      $fc->create([
        'field_storage' => $storage,
        'bundle' => 'jur',
        'entity_type' => 'group',
        'field_name' => 'field_visibility',
        'label' => 'Visibility',
        'description' => 'Controls anonymous access to this workspace.',
        'required' => FALSE,
        'translatable' => FALSE,
        'default_value' => [['value' => 'public']],
      ])->save();
      $logger->info('Created field instance: group.jur.field_visibility');
    }
  }

  // Add to form display.
  $form_display = $etm->getStorage('entity_form_display')
    ->load('group.jur.default');
  if ($form_display && !$form_display->getComponent('field_visibility')) {
    $form_display->setComponent('field_visibility', [
      'type' => 'options_select',
      'weight' => 2,
      'region' => 'content',
      'settings' => [],
    ]);
    $form_display->save();
  }

  // Backfill existing jurisdictions with 'public'.
  $group_storage = $etm->getStorage('group');
  $ids = $group_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'jur')
    ->execute();

  foreach ($group_storage->loadMultiple($ids) as $group) {
    if ($group->hasField('field_visibility') && $group->get('field_visibility')->isEmpty()) {
      $group->set('field_visibility', 'public');
      $group->save();
    }
  }
}

/**
 * Grant 'access workspace usage' permission to api_user role.
 */
function markaspot_fastmap_update_11902(): void {
  $logger = \Drupal::logger('markaspot_fastmap');
  foreach (['api_user', 'tenant_admin', 'moderator', 'editorial_board'] as $role_id) {
    $role = \Drupal\user\Entity\Role::load($role_id);
    if ($role && !$role->hasPermission('access workspace usage')) {
      $role->grantPermission('access workspace usage');
      $role->save();
      $logger->info('Granted "access workspace usage" to @role role.', ['@role' => $role_id]);
    }
  }
}

/**
 * Add verified tokens table (re-verify after email prefetch).
 */
function markaspot_fastmap_update_11904(): void {
  $schema = markaspot_fastmap_schema();
  if (!$schema['markaspot_fastmap_verified']) {
    return;
  }
  $db = \Drupal::database();
  if (!$db->schema()->tableExists('markaspot_fastmap_verified')) {
    $db->schema()->createTable('markaspot_fastmap_verified', $schema['markaspot_fastmap_verified']);
    \Drupal::logger('markaspot_fastmap')->info('Created markaspot_fastmap_verified table.');
  }
}

/**
 * Add member_limits config to markaspot_fastmap.settings.
 */
function markaspot_fastmap_update_11903(): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_fastmap.settings');
  if (!$config->get('member_limits')) {
    $config->set('member_limits', [
      'free' => 1,
      'starter' => 5,
      'pro' => 20,
      'heart' => 5,
    ])->save();
    \Drupal::logger('markaspot_fastmap')->info('Added member_limits config.');
  }
}

/**
 * Migrate tier limits from monthly creation limits to concurrent published.
 *
 * Free tier: 50 concurrent published reports.
 * Starter, Pro, Heart: unlimited (null limit).
 */
function markaspot_fastmap_update_11906(): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_fastmap.settings');
  $config->set('tier_limits', [
    'free' => ['limit' => 50, 'period' => 'published'],
    'starter' => ['limit' => NULL, 'period' => 'published'],
    'pro' => ['limit' => NULL, 'period' => 'published'],
    'heart' => ['limit' => NULL, 'period' => 'published'],
  ])->save();
  \Drupal::logger('markaspot_fastmap')->info('Migrated tier limits to concurrent published model.');
}

/**
 * Add Stripe billing fields to jur group type.
 */
function markaspot_fastmap_update_11905(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_fastmap');
  $fsc = $etm->getStorage('field_storage_config');
  $fc = $etm->getStorage('field_config');

  $stripe_fields = [
    'field_stripe_customer_id' => [
      'label' => 'Stripe Customer ID',
      'description' => 'Stripe customer identifier for billing. Managed automatically.',
    ],
    'field_stripe_subscription_id' => [
      'label' => 'Stripe Subscription ID',
      'description' => 'Active Stripe subscription identifier. Managed automatically.',
    ],
  ];

  foreach ($stripe_fields as $field_name => $meta) {
    // Create field storage.
    if (!$fsc->load("group.$field_name")) {
      $fsc->create([
        'field_name' => $field_name,
        'entity_type' => 'group',
        'type' => 'string',
        'module' => 'core',
        'cardinality' => 1,
        'settings' => [
          'max_length' => 255,
          'is_ascii' => TRUE,
          'case_sensitive' => FALSE,
        ],
        'third_party_settings' => [
          'field_permissions' => [
            'permission_type' => 'custom',
          ],
        ],
      ])->save();
      $logger->info('Created field storage: group.@field', ['@field' => $field_name]);
    }

    // Create field instance on jur bundle.
    if (!$fc->load("group.jur.$field_name")) {
      $storage = $fsc->load("group.$field_name");
      if ($storage) {
        $fc->create([
          'field_storage' => $storage,
          'bundle' => 'jur',
          'entity_type' => 'group',
          'field_name' => $field_name,
          'label' => $meta['label'],
          'description' => $meta['description'],
          'required' => FALSE,
          'translatable' => FALSE,
          'default_value' => [],
        ])->save();
        $logger->info('Created field instance: group.jur.@field', ['@field' => $field_name]);
      }
    }
  }

  // Hide Stripe fields in form display (admin should not edit these manually).
  $form_display = $etm->getStorage('entity_form_display')
    ->load('group.jur.default');
  if ($form_display) {
    foreach (array_keys($stripe_fields) as $field_name) {
      $form_display->removeComponent($field_name);
    }
    $form_display->save();
  }
}

/**
 * Create jur-tenant_admin group role for workspace provisioning.
 *
 * Previously lived in markaspot_tenant_admin module which has unmet
 * dependencies (content_translation, markaspot_ai, toolbar). Moved here
 * since markaspot_fastmap requires this role for workspace creation.
 */
function markaspot_fastmap_update_11907(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('group_role');
  if ($storage->load('jur-tenant_admin')) {
    return;
  }

  $storage->create([
    'id' => 'jur-tenant_admin',
    'label' => 'Tenant Admin',
    'weight' => -1,
    'admin' => FALSE,
    'scope' => 'individual',
    'global_role' => NULL,
    'group_type' => 'jur',
    'permissions' => [
      'administer members',
      'create group_node:service_request entity',
      'create group_node:service_request relationship',
      'update any group_node:service_request entity',
      'update own group_node:service_request entity',
      'view group',
      'view group_node:service_request entity',
      'view group_node:service_request relationship',
      'view own unpublished group_node:service_request entity',
      'view unpublished group_node:service_request entity',
    ],
  ])->save();

  \Drupal::logger('markaspot_fastmap')->info('Created jur-tenant_admin group role.');
}

/**
 * Add field_expiry_date to jur group type for demo workspace auto-delete.
 */
function markaspot_fastmap_update_11908(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_fastmap');
  $fsc = $etm->getStorage('field_storage_config');
  $fc = $etm->getStorage('field_config');

  // Create field storage.
  if (!$fsc->load('group.field_expiry_date')) {
    $fsc->create([
      'field_name' => 'field_expiry_date',
      'entity_type' => 'group',
      'type' => 'timestamp',
      'module' => 'core',
      'cardinality' => 1,
      'settings' => [],
    ])->save();
    $logger->info('Created field storage: group.field_expiry_date');
  }

  // Create field instance on jur bundle.
  if (!$fc->load('group.jur.field_expiry_date')) {
    $storage = $fsc->load('group.field_expiry_date');
    if ($storage) {
      $fc->create([
        'field_storage' => $storage,
        'bundle' => 'jur',
        'entity_type' => 'group',
        'field_name' => 'field_expiry_date',
        'label' => 'Expiry Date',
        'description' => 'Unix timestamp when this demo workspace expires and will be auto-deleted.',
        'required' => FALSE,
        'translatable' => FALSE,
        'default_value' => [],
      ])->save();
      $logger->info('Created field instance: group.jur.field_expiry_date');
    }
  }

  // Add demo_expiry_days config if not present.
  $config = \Drupal::configFactory()->getEditable('markaspot_fastmap.settings');
  if (!$config->get('demo_expiry_days')) {
    $config->set('demo_expiry_days', 5)->save();
    $logger->info('Set default demo_expiry_days config.');
  }
}

/**
 * Add checkout_grace_days config for tier-based workspace expiry.
 */
function markaspot_fastmap_update_11910(): void {
  $config = \Drupal::configFactory()->getEditable('markaspot_fastmap.settings');
  if ($config->get('checkout_grace_days') === NULL) {
    $config->set('checkout_grace_days', 14)->save();
  }
}

/**
 * Create markaspot_ai_usage table and add ai_budgets config.
 */
function markaspot_fastmap_update_11909(): void {
  $db = \Drupal::database();
  $schema = markaspot_fastmap_schema();

  if (!$db->schema()->tableExists('markaspot_ai_usage')) {
    $db->schema()->createTable('markaspot_ai_usage', $schema['markaspot_ai_usage']);
    \Drupal::logger('markaspot_fastmap')->info('Created markaspot_ai_usage table.');
  }

  $config = \Drupal::configFactory()->getEditable('markaspot_fastmap.settings');
  if (!$config->get('ai_budgets')) {
    $config->set('ai_budgets', [
      'free' => 50,
      'starter' => 100,
      'pro' => 500,
      'heart' => 100,
      'partner' => 0,
    ])->save();
    \Drupal::logger('markaspot_fastmap')->info('Added ai_budgets config.');
  }
}

/**
 * Grant 'access workspace usage' to authenticated role.
 *
 * In FastMap SaaS, workspace owners only have the 'authenticated' global role.
 * The WorkspaceUsageController::access() check still requires group membership,
 * so cross-tenant access is prevented. The global permission is a first gate
 * that must pass before the membership check runs.
 */
function markaspot_fastmap_update_11911(): void {
  $role = \Drupal\user\Entity\Role::load('authenticated');
  if ($role && !$role->hasPermission('access workspace usage')) {
    $role->grantPermission('access workspace usage');
    $role->save();
    \Drupal::logger('markaspot_fastmap')->info('Granted "access workspace usage" to authenticated role.');
  }
}

/**
 * Add billing address fields to jur group type.
 *
 * These fields store the billing address synced from Stripe after checkout.
 * They are managed automatically via the BillingController and webhook,
 * not edited manually in Drupal admin.
 */
function markaspot_fastmap_update_11912(): void {
  $etm = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_fastmap');
  $fsc = $etm->getStorage('field_storage_config');
  $fc = $etm->getStorage('field_config');

  $billing_fields = [
    'field_billing_name' => [
      'label' => 'Billing Name',
      'description' => 'Company or person name for billing. Synced from Stripe.',
      'max_length' => 255,
    ],
    'field_billing_email' => [
      'label' => 'Billing Email',
      'description' => 'Billing contact email. Synced from Stripe.',
      'max_length' => 255,
    ],
    'field_billing_address_line1' => [
      'label' => 'Billing Address Line 1',
      'description' => 'Street address. Synced from Stripe.',
      'max_length' => 255,
    ],
    'field_billing_address_line2' => [
      'label' => 'Billing Address Line 2',
      'description' => 'Apartment, suite, etc. Synced from Stripe.',
      'max_length' => 255,
    ],
    'field_billing_city' => [
      'label' => 'Billing City',
      'description' => 'City for billing. Synced from Stripe.',
      'max_length' => 255,
    ],
    'field_billing_postal_code' => [
      'label' => 'Billing Postal Code',
      'description' => 'Postal/ZIP code. Synced from Stripe.',
      'max_length' => 20,
    ],
    'field_billing_country' => [
      'label' => 'Billing Country',
      'description' => 'ISO 3166-1 alpha-2 country code. Synced from Stripe.',
      'max_length' => 2,
    ],
    'field_billing_tax_id' => [
      'label' => 'Billing Tax ID',
      'description' => 'VAT or tax registration number. Optional.',
      'max_length' => 50,
    ],
  ];

  foreach ($billing_fields as $field_name => $meta) {
    // Create field storage.
    if (!$fsc->load("group.$field_name")) {
      $fsc->create([
        'field_name' => $field_name,
        'entity_type' => 'group',
        'type' => 'string',
        'module' => 'core',
        'cardinality' => 1,
        'settings' => [
          'max_length' => $meta['max_length'],
          'is_ascii' => FALSE,
          'case_sensitive' => FALSE,
        ],
        'third_party_settings' => [
          'field_permissions' => [
            'permission_type' => 'custom',
          ],
        ],
      ])->save();
      $logger->info('Created field storage: group.@field', ['@field' => $field_name]);
    }

    // Create field instance on jur bundle.
    if (!$fc->load("group.jur.$field_name")) {
      $storage = $fsc->load("group.$field_name");
      if ($storage) {
        $fc->create([
          'field_storage' => $storage,
          'bundle' => 'jur',
          'entity_type' => 'group',
          'field_name' => $field_name,
          'label' => $meta['label'],
          'description' => $meta['description'],
          'required' => FALSE,
          'translatable' => FALSE,
          'default_value' => [],
        ])->save();
        $logger->info('Created field instance: group.jur.@field', ['@field' => $field_name]);
      }
    }
  }

  // Hide billing address fields from form display (managed by webhook only).
  $form_display = $etm->getStorage('entity_form_display')
    ->load('group.jur.default');
  if ($form_display) {
    foreach (array_keys($billing_fields) as $field_name) {
      $form_display->removeComponent($field_name);
    }
    $form_display->save();
  }
}
