<?php

/**
 * @file
 * Hook implementations for the FastMap module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\group\Entity\GroupInterface;
use Drupal\markaspot_validation\Plugin\Validation\Geo\GeoJsonBoundary;
use Drupal\node\NodeInterface;
use Drupal\user\EntityOwnerInterface;
use Drupal\user\UserInterface;
use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;

/**
 * Implements hook_entity_access().
 *
 * A blocked workspace must stop authenticated tenant activity as well as
 * anonymous access. This generic access backstop covers existing jurisdiction-
 * scoped content before edit/delete/view routes reach their controller.
 */
function markaspot_fastmap_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResult {
  if (!in_array($operation, ['view', 'update', 'delete'], TRUE)) {
    return AccessResult::neutral();
  }

  $jurisdictionId = _markaspot_fastmap_resolve_blockable_entity_jurisdiction_id($entity);
  if (!$jurisdictionId) {
    return AccessResult::neutral();
  }

  if (_markaspot_fastmap_account_can_bypass_workspace_block($account)) {
    return AccessResult::neutral()
      ->cachePerUser()
      ->addCacheTags(['group:' . $jurisdictionId]);
  }

  /** @var \Drupal\markaspot_fastmap\Service\WorkspaceVisibilityService $service */
  $service = \Drupal::service('markaspot_fastmap.workspace_visibility');
  if ($service->isBlocked($jurisdictionId)) {
    return AccessResult::forbidden('Workspace is blocked.')
      ->cachePerUser()
      ->addCacheTags(['group:' . $jurisdictionId]);
  }

  return AccessResult::neutral()
    ->cachePerUser()
    ->addCacheTags(['group:' . $jurisdictionId]);
}

/**
 * Implements hook_entity_presave().
 *
 * Blocks new or changed jurisdiction-scoped content even when the caller
 * reaches storage through a path that skipped entity access checks.
 */
function markaspot_fastmap_entity_presave(EntityInterface $entity): void {
  $jurisdictionId = _markaspot_fastmap_resolve_blockable_entity_jurisdiction_id($entity);
  if (!$jurisdictionId) {
    return;
  }

  if (_markaspot_fastmap_account_can_bypass_workspace_block(\Drupal::currentUser())) {
    return;
  }

  /** @var \Drupal\markaspot_fastmap\Service\WorkspaceVisibilityInterface $service */
  $service = \Drupal::service('markaspot_fastmap.workspace_visibility');
  if ($service->isBlocked($jurisdictionId)) {
    // Log the bypass attempt so silent-failure callers (ECA action_save_entity,
    // VBO bulk publish, custom code calling $node->save() directly) leave a
    // detection signal even when the AccessDeniedHttpException is swallowed
    // upstream. Flood-gated to 1/60s per (workspace, uid) so a runaway ECA
    // loop or batch-process retry cannot fill the watchdog table.
    $uid = (int) \Drupal::currentUser()->id();
    $floodKey = 'markaspot_fastmap.blocked_presave.' . $jurisdictionId . '.' . $uid;
    $flood = \Drupal::service('flood');
    if ($flood->isAllowed($floodKey, 1, 60)) {
      $flood->register($floodKey, 60);
      \Drupal::logger('markaspot_fastmap')->warning(
        'Blocked workspace save rejected: entity_type=@type bundle=@bundle id=@id jid=@jid uid=@uid',
        [
          '@type' => $entity->getEntityTypeId(),
          '@bundle' => $entity->bundle(),
          '@id' => $entity->id() ?: 'new',
          '@jid' => $jurisdictionId,
          '@uid' => $uid,
        ]
      );
    }
    throw new AccessDeniedHttpException('Workspace is blocked.');
  }
}

/**
 * Implements hook_entity_field_access().
 *
 * Bypasses core's 'administer nodes' requirement for specific base fields
 * on service_request and page nodes, scoped to Group membership:
 *
 * - 'status': allows toggling published/unpublished (core requires
 *   'administer nodes' or 'administer node published status').
 * - 'promote': allows "Promote to info panel" (core requires
 *   'administer nodes').
 * - 'sticky': allows "Start page" toggle (core requires
 *   'administer nodes').
 *
 * Access is granted when the user has the Group-level 'update any' or
 * 'update own' permission for the node's bundle within its jurisdiction.
 */
function markaspot_fastmap_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResult {
  // Only act on edit operations for specific base fields.
  $gated_fields = ['status', 'promote', 'sticky'];
  if ($operation !== 'edit' || !in_array($field_definition->getName(), $gated_fields, TRUE)) {
    return AccessResult::neutral();
  }

  if (!$items) {
    return AccessResult::neutral();
  }

  $entity = $items->getEntity();
  if (!$entity instanceof NodeInterface) {
    return AccessResult::neutral();
  }

  // Only apply to bundles that are jurisdiction-scoped.
  $bundle = $entity->bundle();
  $supported_bundles = ['service_request', 'page'];
  if (!in_array($bundle, $supported_bundles, TRUE)) {
    return AccessResult::neutral();
  }

  if (!$entity->hasField('field_jurisdiction') || $entity->get('field_jurisdiction')->isEmpty()) {
    return AccessResult::neutral();
  }

  $group = $entity->get('field_jurisdiction')->entity;
  if (!$group) {
    return AccessResult::neutral();
  }

  $member = $group->getMember($account);
  if (!$member) {
    return AccessResult::neutral()->cachePerUser()->addCacheableDependency($group);
  }

  $hasPermission = $member->hasPermission("update any group_node:{$bundle} entity")
    || ($member->hasPermission("update own group_node:{$bundle} entity")
      && $entity instanceof EntityOwnerInterface
      && (int) $entity->getOwnerId() === (int) $account->id());

  return $hasPermission
    ? AccessResult::allowed()->cachePerUser()->addCacheableDependency($group)->addCacheableDependency($entity)
    : AccessResult::neutral()->cachePerUser()->addCacheableDependency($group);
}

/**
 * Implements hook_node_access().
 *
 * Enforces workspace visibility for all node access (JSON:API, REST, Views).
 * Anonymous users are denied view access to nodes in restricted jurisdictions.
 */
function markaspot_fastmap_node_access(NodeInterface $node, string $op, AccountInterface $account): AccessResult {
  $jurisdictionId = _markaspot_fastmap_resolve_blockable_entity_jurisdiction_id($node);
  if ($jurisdictionId) {
    /** @var \Drupal\markaspot_fastmap\Service\WorkspaceVisibilityService $service */
    $service = \Drupal::service('markaspot_fastmap.workspace_visibility');
    if ($service->isBlocked($jurisdictionId) && !_markaspot_fastmap_account_can_bypass_workspace_block($account)) {
      return AccessResult::forbidden('Workspace is blocked.')
        ->cachePerUser()
        ->addCacheTags(['group:' . $jurisdictionId]);
    }
  }

  // Only gate view operations for anonymous users.
  if ($op !== 'view' || !$account->isAnonymous()) {
    return AccessResult::neutral();
  }

  // Only gate nodes that belong to a jurisdiction.
  if (!$node->hasField('field_jurisdiction') || $node->get('field_jurisdiction')->isEmpty()) {
    return AccessResult::neutral();
  }

  $jurisdictionId = (int) $node->get('field_jurisdiction')->target_id;
  if (!$jurisdictionId) {
    return AccessResult::neutral();
  }

  /** @var \Drupal\markaspot_fastmap\Service\WorkspaceVisibilityService $service */
  $service = \Drupal::service('markaspot_fastmap.workspace_visibility');
  if (!$service->canAnonymousView($jurisdictionId)) {
    return AccessResult::forbidden('Workspace requires authentication for viewing.')
      ->addCacheContexts(['user.roles:anonymous'])
      ->addCacheTags(['group:' . $jurisdictionId]);
  }

  return AccessResult::neutral()
    ->addCacheContexts(['user.roles:anonymous'])
    ->addCacheTags(['group:' . $jurisdictionId]);
}

/**
 * Resolves the jurisdiction ID for content covered by workspace blocking.
 */
function _markaspot_fastmap_resolve_blockable_entity_jurisdiction_id(EntityInterface $entity): ?int {
  if (!_markaspot_fastmap_entity_is_blockable_workspace_content($entity)) {
    return NULL;
  }

  if ($entity instanceof ContentEntityInterface
    && $entity->hasField('field_jurisdiction')
    && !$entity->get('field_jurisdiction')->isEmpty()) {
    $jurisdictionId = (int) $entity->get('field_jurisdiction')->target_id;
    $group = \Drupal::entityTypeManager()
      ->getStorage('group')
      ->load($jurisdictionId);

    if (_markaspot_fastmap_is_jurisdiction_group($group)) {
      return $jurisdictionId;
    }
  }

  if ($entity instanceof NodeInterface && $entity->bundle() === 'service_request') {
    $categoryRootId = _markaspot_fastmap_resolve_category_root_jurisdiction_id($entity);
    $boundaryJurisdictionId = _markaspot_fastmap_resolve_boundary_jurisdiction_id($entity);

    if ($boundaryJurisdictionId) {
      return $boundaryJurisdictionId;
    }

    $requestJurisdictionId = _markaspot_fastmap_get_request_jurisdiction_id();
    if ($requestJurisdictionId) {
      $group = _markaspot_fastmap_load_allowed_jurisdiction_group((int) $requestJurisdictionId, $categoryRootId, $boundaryJurisdictionId);
      if ($group) {
        return (int) $group->id();
      }
    }
  }

  if ($entity instanceof NodeInterface && $entity->bundle() === 'service_request') {
    $categoryRootId ??= _markaspot_fastmap_resolve_category_root_jurisdiction_id($entity);
    if ($categoryRootId) {
      return $categoryRootId;
    }
  }

  return NULL;
}

/**
 * Checks whether an entity type/bundle is covered by workspace blocking.
 */
function _markaspot_fastmap_entity_is_blockable_workspace_content(EntityInterface $entity): bool {
  if ($entity instanceof NodeInterface) {
    return in_array($entity->bundle(), ['service_request', 'page'], TRUE);
  }

  if ($entity->getEntityTypeId() === 'taxonomy_term') {
    return in_array($entity->bundle(), ['service_category', 'service_status'], TRUE);
  }

  return FALSE;
}

/**
 * Checks whether an account can continue privileged work on blocked tenants.
 */
function _markaspot_fastmap_account_can_bypass_workspace_block(AccountInterface $account): bool {
  return (int) $account->id() === 1
    || in_array('administrator', $account->getRoles(), TRUE);
}

/**
 * Implements hook_mail().
 */
function markaspot_fastmap_mail(string $key, array &$message, array $params): void {
  if ($key === 'workspace_verification' || $key === 'workspace_welcome') {
    $langcode = $message['langcode'] ?? 'en';
    $template = _markaspot_fastmap_mail_template($key, $langcode);

    // Both fields still missing after config + shipped-YAML fallback means
    // there is nothing sensible to send. Suppress delivery instead of
    // reaching strtr(NULL); MailManager checks $message['send'] and reports
    // result NULL, which callers (FastMapWorkspaceController) already treat
    // as a failure worth a warning log.
    if ($template['subject'] === '' || $template['body'] === '') {
      \Drupal::logger('markaspot_fastmap')->error(
        'Mail template @key has no usable subject/body after config and shipped-YAML fallback; suppressing send.',
        ['@key' => $key]
      );
      $message['send'] = FALSE;
      return;
    }

    $replacements = $key === 'workspace_verification'
      ? [
        '@site_name' => $params['site_name'] ?? 'FastMap',
        '@workspace_name' => $params['workspace_name'] ?? '',
        '@verify_url' => $params['verify_url'] ?? '',
        '@cleanup_days' => $params['cleanup_days'] ?? '7',
      ]
      : [
        '@site_name' => $params['site_name'] ?? 'FastMap',
        '@workspace_name' => $params['workspace_name'] ?? '',
        '@workspace_url' => $params['workspace_url'] ?? '',
      ];

    $message['subject'] = strtr($template['subject'], $replacements);
    $message['body'][] = strtr($template['body'], $replacements);
  }
  elseif ($key === 'demo_expiry_reminder') {
    // Bcc the technical admin (uid 1) when the cron passes one. Set on the
    // header array so it survives the markaspot_mail builder alter — which
    // overwrites body/subject but leaves Bcc untouched — and is only stripped
    // by the non-production recipient-override fence. Strip CR/LF/NUL as
    // defense-in-depth against header injection (CWE-93), mirroring the
    // sanitization the mail pipeline applies to every other header sink.
    if (!empty($params['bcc'])) {
      $message['headers']['Bcc'] = str_replace(["\r", "\n", "\0"], '', (string) $params['bcc']);
    }
    $message['subject'] = t('Your demo workspace "@name" expires soon', [
      '@name' => $params['workspace_name'] ?? '',
    ]);
    $message['body'][] = t('Your demo workspace "@name" will be automatically removed on @date.', [
      '@name' => $params['workspace_name'] ?? '',
      '@date' => $params['expiry_date'] ?? '',
    ]);

    // Build workspace URL and login link from slug + config.
    $slug = $params['workspace_slug'] ?? '';
    $base_url = \Drupal::config('markaspot_fastmap.settings')->get('workspace_base_url') ?: '';
    $workspace_url = _markaspot_fastmap_build_workspace_url($slug, $base_url);
    if ($workspace_url) {
      $message['body'][] = t('Your workspace: @url', ['@url' => $workspace_url]);
      $message['body'][] = t('Log in: @url', ['@url' => $workspace_url . '/auth/login']);
    }

    $message['body'][] = t('Create a permanent workspace anytime at https://civicspot.io');
  }
}

/**
 * Builds a workspace URL from a slug and the configured base URL template.
 *
 * Supports both template URLs (https://example.com/{slug}) and plain base
 * URLs (https://example.com), appending the slug when no placeholder is
 * present. Shared by the demo-expiry reminder and the post-verification
 * welcome mail so both compute the same canonical workspace URL.
 */
function _markaspot_fastmap_build_workspace_url(string $slug, string $baseUrl): ?string {
  if ($slug === '' || $baseUrl === '') {
    return NULL;
  }

  if (str_contains($baseUrl, '{slug}')) {
    return str_replace(['{slug}', '{id}'], [$slug, ''], $baseUrl);
  }

  return rtrim($baseUrl, '/') . '/' . $slug;
}

/**
 * Resolves the subject/body template pair for a markaspot_fastmap mail key.
 *
 * Per-field fallback chain, so a partially-configured tenant (missing one
 * field, or missing the entire top-level key because it predates
 * markaspot_fastmap_update_11924()) never reaches strtr(NULL):
 *   1. Language-config override for $langcode (per-locale admin edit).
 *   2. Active markaspot_fastmap.mail config (admin default-language edit).
 *   3. Shipped config/install/markaspot_fastmap.mail.yml (module default).
 *
 * Steps 1+2 are merged with '+' (override wins per top-level key present),
 * then subject/body are individually backfilled from the shipped YAML if
 * still empty after that merge.
 *
 * @return array{subject: string, body: string}
 *   Both keys always present; empty string when even the shipped YAML has
 *   no usable value for that field.
 */
function _markaspot_fastmap_mail_template(string $key, string $langcode): array {
  $override = \Drupal::languageManager()
    ->getLanguageConfigOverride($langcode, 'markaspot_fastmap.mail')
    ->get($key);
  $default = \Drupal::config('markaspot_fastmap.mail')->get($key);

  $template = (is_array($override) ? $override : []) + (is_array($default) ? $default : []);

  if (empty($template['subject']) || empty($template['body'])) {
    $shipped = _markaspot_fastmap_shipped_mail_template($key);
    foreach (['subject', 'body'] as $field) {
      if (empty($template[$field]) && !empty($shipped[$field])) {
        $template[$field] = $shipped[$field];
      }
    }
  }

  return [
    'subject' => (string) ($template['subject'] ?? ''),
    'body' => (string) ($template['body'] ?? ''),
  ];
}

/**
 * Reads a single mail template key from the shipped config/install YAML.
 *
 * Static-cached per request: config/install/markaspot_fastmap.mail.yml is
 * a static file shipped with the module, safe to parse once and reuse for
 * every locale miss within the same request.
 */
function _markaspot_fastmap_shipped_mail_template(string $key): array {
  $shipped = &drupal_static(__FUNCTION__);
  if ($shipped === NULL) {
    $path = \Drupal::service('extension.list.module')->getPath('markaspot_fastmap')
      . '/config/install/markaspot_fastmap.mail.yml';
    $decoded = is_file($path) ? \Drupal\Component\Serialization\Yaml::decode(file_get_contents($path)) : NULL;
    $shipped = is_array($decoded) ? $decoded : [];
  }

  $template = $shipped[$key] ?? [];
  return is_array($template) ? $template : [];
}

/**
 * Implements hook_ENTITY_TYPE_update() for group entities.
 *
 * Invalidates the workspace visibility cache entry when a group is saved,
 * ensuring visibility changes take effect immediately within the same request.
 *
 * Also triggers a legal-notice regeneration when billing fields changed.
 * The generator itself calls $group->save() with setNewRevision(TRUE), so a
 * static guard prevents the inner save from recursing into this hook a
 * second time. Manual overrides (sentinel <!-- manual-override -->) are
 * skipped by the generator and never get auto-regenerated.
 */
function markaspot_fastmap_group_update(GroupInterface $group): void {
  \Drupal::service('markaspot_fastmap.workspace_visibility')->resetCache((int) $group->id());

  if ($group->bundle() !== 'jur') {
    return;
  }

  // Recursion guard: the generator calls $group->save() which fires this
  // hook again. We only want to enter the generator once per outer save.
  $regenerating = &drupal_static(__FUNCTION__ . ':regenerating', []);
  $gid = (int) $group->id();
  if (!empty($regenerating[$gid])) {
    return;
  }

  $billing_fields = [
    'field_billing_name',
    'field_billing_email',
    'field_billing_address_line1',
    'field_billing_address_line2',
    'field_billing_city',
    'field_billing_postal_code',
    'field_billing_country',
    'field_billing_tax_id',
    'field_jurisdiction_e_mail',
    'field_jurisdiction_address',
  ];

  $original = $group->original ?? NULL;
  if (!$original instanceof GroupInterface) {
    return;
  }

  $changed = FALSE;
  foreach ($billing_fields as $field_name) {
    if (!$group->hasField($field_name) || !$original->hasField($field_name)) {
      continue;
    }
    if (!$group->get($field_name)->equals($original->get($field_name))) {
      $changed = TRUE;
      break;
    }
  }

  if (!$changed) {
    return;
  }

  $regenerating[$gid] = TRUE;
  try {
    /** @var \Drupal\markaspot_fastmap\Service\LegalNoticeGenerator $generator */
    $generator = \Drupal::service('markaspot_fastmap.legal_notice_generator');
    $generator->syncGroup($group);
  }
  catch (\Throwable $e) {
    // Sync failures must NOT block the outer billing save: that's a
    // payment-side write that already completed. Log and move on; the
    // operator can re-trigger via the admin form or a follow-up edit.
    \Drupal::logger('markaspot_fastmap')->error(
      'legal_notice auto-sync failed for group @id: @msg',
      ['@id' => $gid, '@msg' => $e->getMessage()]
    );
  }
  finally {
    unset($regenerating[$gid]);
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for group entities.
 *
 * Same intent as the update hook: newly provisioned workspaces (FastMap
 * signup, migration) must not see a stale 'public' default cached from an
 * earlier same-request probe.
 */
function markaspot_fastmap_group_insert(GroupInterface $group): void {
  \Drupal::service('markaspot_fastmap.workspace_visibility')->resetCache((int) $group->id());
}

/**
 * Implements hook_ENTITY_TYPE_delete() for group entities.
 *
 * Drops the orphan cache entry. Avoids handing out a stale visibility value
 * if a later test or migration reuses the same GID.
 */
function markaspot_fastmap_group_delete(GroupInterface $group): void {
  \Drupal::service('markaspot_fastmap.workspace_visibility')->resetCache((int) $group->id());
}

/**
 * Implements hook_node_presave().
 *
 * Silently sets new service_request nodes to unpublished when the
 * jurisdiction's published-reports limit is reached. This avoids rejecting
 * anonymous submissions with a validation error. The report is still created
 * but stays unpublished until a slot is freed.
 *
 * Existing request publish transitions are still validated by the TierLimit
 * constraint. This hook also acts as a race-safe backstop and throws before
 * saving when the published limit is reached.
 */
function markaspot_fastmap_node_presave(NodeInterface $node): void {
  if ($node->bundle() !== 'service_request' || !$node->isPublished()) {
    return;
  }

  $is_new = $node->isNew();
  $is_publish_transition = FALSE;
  if (!$is_new) {
    $original = $node->getOriginal()
      ?: \Drupal::entityTypeManager()->getStorage('node')->loadUnchanged($node->id());
    if (!$original instanceof NodeInterface || $original->isPublished()) {
      return;
    }
    $is_publish_transition = TRUE;
  }

  if (!$is_new && !$is_publish_transition) {
    return;
  }

  // GDPR Art. 26 demo-compliance gate: workspaces still in demo state (expiry
  // set + no Stripe subscription) must not produce publicly visible reports.
  // This gate runs BEFORE the admin-bypass below because demo compliance is a
  // workspace property, not a submitter property: even an admin save must be
  // queued for moderation until the workspace is Stripe-activated.
  $demoGroup = _markaspot_fastmap_resolve_jurisdiction_group_for_node($node);

  // Fallback: when the structured resolver returns NULL (no category, no
  // boundary hit, no validated field), trust the raw Open311 jurisdiction_id
  // from the request. Without this, a citizen submitting an Open311 POST with
  // a demo workspace's jurisdiction_id but a missing/invalid service_code
  // bypasses the gate and produces a published report.
  if (!$demoGroup) {
    $rawJurisdictionId = _markaspot_fastmap_get_request_jurisdiction_id();
    if ($rawJurisdictionId) {
      $rawGroup = \Drupal::entityTypeManager()
        ->getStorage('group')
        ->load($rawJurisdictionId);
      if (_markaspot_fastmap_is_jurisdiction_group($rawGroup)) {
        $demoGroup = $rawGroup;
      }
    }
  }

  if ($demoGroup && _markaspot_fastmap_workspace_in_demo_state($demoGroup)) {
    $node->setUnpublished();
    \Drupal::logger('markaspot_fastmap')->debug(
      'Report queued for moderation: workspace @gid is in demo-mode (Stripe activation pending).',
      ['@gid' => $demoGroup->id()]
    );
    return;
  }

  // Admins bypass tier limits.
  $currentUser = \Drupal::currentUser();
  if ($currentUser->hasPermission('bypass mas validation')
    || $currentUser->hasPermission('administer nodes')) {
    return;
  }

  // Resolve the jurisdiction group for tier-limit enforcement. The API request
  // fallback is critical for child jurisdictions: without it, category fallback
  // resolves to the root (e.g., BCP Council) instead of the child workspace.
  $group = _markaspot_fastmap_resolve_jurisdiction_group_for_node($node);

  if (!$group || !$group->hasField('field_tier')) {
    return;
  }

  $tier = !$group->get('field_tier')->isEmpty()
    ? $group->get('field_tier')->value
    : 'free';

  /** @var \Drupal\markaspot_fastmap\Service\TierConfigService $tierConfig */
  $tierConfig = \Drupal::service('markaspot_fastmap.tier_config');
  $tierLimits = $tierConfig->getLimits($tier);

  if ($tierLimits === NULL || !empty($tierLimits['unlimited'])) {
    return;
  }

  // Only apply silent unpublish for the published-count period.
  if ($tierLimits['period'] !== 'published') {
    return;
  }

  $group_id = (int) $group->id();
  if (!_markaspot_fastmap_acquire_tier_limit_lock($group_id)) {
    throw new EntityStorageException(sprintf('Cannot acquire tier limit lock for jurisdiction %d.', $group_id));
  }
  _markaspot_fastmap_track_node_tier_limit_lock($node, $group_id);
  // Release after SqlContentEntityStorage::save() has returned. Releasing in
  // hook_node_insert()/hook_node_update() can expose an uncommitted row with
  // non-transactional lock backends.
  drupal_register_shutdown_function('_markaspot_fastmap_release_node_tier_limit_lock', $node);

  $count = $tierConfig->countRequests($group_id, 'published');
  if ($count >= $tierLimits['limit']) {
    if ($is_new) {
      $node->setUnpublished();
      _markaspot_fastmap_release_node_tier_limit_lock($node);
      \Drupal::logger('markaspot_fastmap')->notice(
        'New service request silently unpublished: jurisdiction @jid has @count/@limit published reports.',
        [
          '@jid' => $group_id,
          '@count' => $count,
          '@limit' => $tierLimits['limit'],
        ]
      );
      return;
    }

    _markaspot_fastmap_release_node_tier_limit_lock($node);
    throw new EntityStorageException(sprintf(
      'Cannot publish service request: jurisdiction %d has reached the published report limit of %d.',
      $group_id,
      (int) $tierLimits['limit'],
    ));
  }
}

/**
 * Builds the lock name for a jurisdiction tier limit check.
 */
function _markaspot_fastmap_tier_limit_lock_name(int $group_id): ?string {
  if ($group_id <= 0) {
    return NULL;
  }

  return 'markaspot_fastmap:tier_limit:' . $group_id;
}

/**
 * Acquires a jurisdiction tier limit lock.
 */
function _markaspot_fastmap_acquire_tier_limit_lock(int $group_id): bool {
  $lock_name = _markaspot_fastmap_tier_limit_lock_name($group_id);
  if ($lock_name === NULL) {
    return FALSE;
  }

  $held_locks = &drupal_static('_markaspot_fastmap_tier_limit_locks', []);
  if (!empty($held_locks[$lock_name])) {
    return TRUE;
  }

  $lock = \Drupal::lock();
  if (!$lock->acquire($lock_name, 30.0)) {
    $lock->wait($lock_name, 1);
    if (!$lock->acquire($lock_name, 30.0)) {
      return FALSE;
    }
  }

  $held_locks[$lock_name] = TRUE;
  return TRUE;
}

/**
 * Releases a jurisdiction tier limit lock.
 */
function _markaspot_fastmap_release_tier_limit_lock(int $group_id): void {
  $lock_name = _markaspot_fastmap_tier_limit_lock_name($group_id);
  if ($lock_name === NULL) {
    return;
  }

  $held_locks = &drupal_static('_markaspot_fastmap_tier_limit_locks', []);
  if (empty($held_locks[$lock_name])) {
    return;
  }

  unset($held_locks[$lock_name]);
  \Drupal::lock()->release($lock_name);
}

/**
 * Tracks the tier limit lock held for a node save.
 */
function _markaspot_fastmap_track_node_tier_limit_lock(NodeInterface $node, int $group_id): void {
  $node_locks = &drupal_static('_markaspot_fastmap_tier_limit_node_locks', []);
  $node_locks[spl_object_id($node)] = $group_id;
}

/**
 * Releases the tier limit lock held by a node save operation.
 */
function _markaspot_fastmap_release_node_tier_limit_lock(NodeInterface $node): void {
  $node_locks = &drupal_static('_markaspot_fastmap_tier_limit_node_locks', []);
  $node_key = spl_object_id($node);
  if (empty($node_locks[$node_key])) {
    return;
  }

  $group_id = (int) $node_locks[$node_key];
  unset($node_locks[$node_key]);
  _markaspot_fastmap_release_tier_limit_lock($group_id);
}

/**
 * Loads a jurisdiction group only when it belongs to the category tree.
 */
function _markaspot_fastmap_load_allowed_jurisdiction_group(int $jurisdictionId, ?int $categoryRootId, int|false $boundaryJurisdictionId): ?GroupInterface {
  $allowedJurisdictionId = _markaspot_fastmap_resolve_allowed_jurisdiction_id($jurisdictionId, $categoryRootId, $boundaryJurisdictionId);
  if (!$allowedJurisdictionId) {
    return NULL;
  }

  $group = \Drupal::entityTypeManager()
    ->getStorage('group')
    ->load($allowedJurisdictionId);

  return _markaspot_fastmap_is_jurisdiction_group($group)
    ? $group
    : NULL;
}

/**
 * Resolves an allowed tier jurisdiction from request or field input.
 */
function _markaspot_fastmap_resolve_allowed_jurisdiction_id(int $jurisdictionId, ?int $categoryRootId, int|false $boundaryJurisdictionId): ?int {
  $group = \Drupal::entityTypeManager()
    ->getStorage('group')
    ->load($jurisdictionId);
  if (!_markaspot_fastmap_is_jurisdiction_group($group)) {
    return NULL;
  }

  if ($categoryRootId === NULL || $jurisdictionId === $categoryRootId) {
    return $jurisdictionId;
  }

  if (!_markaspot_fastmap_jurisdiction_matches_category_root($jurisdictionId, $categoryRootId)) {
    return NULL;
  }

  return $boundaryJurisdictionId === FALSE || $boundaryJurisdictionId === $jurisdictionId
    ? $jurisdictionId
    : NULL;
}

/**
 * Resolves the root jurisdiction from a service request category.
 */
function _markaspot_fastmap_resolve_category_root_jurisdiction_id(NodeInterface $node): ?int {
  if (!$node->hasField('field_category') || $node->get('field_category')->isEmpty()) {
    return NULL;
  }

  $categoryTerm = $node->get('field_category')->entity;
  if (!$categoryTerm || !$categoryTerm->hasField('field_jurisdiction') || $categoryTerm->get('field_jurisdiction')->isEmpty()) {
    return NULL;
  }

  $jurisdictionId = (int) $categoryTerm->get('field_jurisdiction')->target_id;
  if ($jurisdictionId <= 0) {
    return NULL;
  }

  if (\Drupal::hasService('markaspot_group.hierarchy_resolver')) {
    /** @var \Drupal\markaspot_group\Service\JurisdictionHierarchyResolverInterface $resolver */
    $resolver = \Drupal::service('markaspot_group.hierarchy_resolver');
    return $resolver->getRootJurisdictionId($jurisdictionId);
  }

  return $jurisdictionId;
}

/**
 * Resolves the most specific boundary jurisdiction for a node location.
 */
function _markaspot_fastmap_resolve_boundary_jurisdiction_id(NodeInterface $node): int|false {
  if (!$node->hasField('field_geolocation') || $node->get('field_geolocation')->isEmpty()) {
    return FALSE;
  }

  $geolocation = $node->get('field_geolocation')->first();
  $lat = (float) $geolocation->get('lat')->getValue();
  $lng = (float) $geolocation->get('lng')->getValue();
  if ($lat === 0.0 && $lng === 0.0) {
    return FALSE;
  }

  return _markaspot_fastmap_resolve_boundary_jurisdiction_id_from_coordinates($lat, $lng);
}

/**
 * Resolves the deepest boundary jurisdiction from raw coordinates.
 *
 * Exposed for callers that have a (lat, lng) pair without a node entity
 * — most importantly the Open311 POST path, which performs an early
 * isBlockedForSubmission() check before any node is constructed.
 *
 * @return int|false
 *   The deepest matching jurisdiction group ID, or FALSE when no boundary
 *   matches.
 */
function _markaspot_fastmap_resolve_boundary_jurisdiction_id_from_coordinates(float $lat, float $lng): int|false {
  if ($lat === 0.0 && $lng === 0.0) {
    return FALSE;
  }

  $groupStorage = \Drupal::entityTypeManager()->getStorage('group');
  $groupIds = $groupStorage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', _markaspot_fastmap_jurisdiction_group_type())
    ->exists('field_boundary')
    ->execute();

  if (empty($groupIds)) {
    return FALSE;
  }

  $matchedIds = [];
  $groups = $groupStorage->loadMultiple($groupIds);
  foreach ($groups as $group) {
    if (!_markaspot_fastmap_is_jurisdiction_group($group)) {
      continue;
    }
    if (!$group->hasField('field_parent_jurisdiction') || $group->get('field_parent_jurisdiction')->isEmpty()) {
      continue;
    }
    if (!$group->hasField('field_boundary') || $group->get('field_boundary')->isEmpty()) {
      continue;
    }

    $boundary = GeoJsonBoundary::fromJson((string) $group->get('field_boundary')->value);
    if ($boundary && $boundary->contains($lng, $lat)) {
      $matchedIds[] = (int) $group->id();
    }
  }

  return _markaspot_fastmap_resolve_deepest_boundary_jurisdiction_id($matchedIds, $groups);
}

/**
 * Returns the deepest jurisdiction ID from matching boundary groups.
 *
 * @param int[] $matchedIds
 *   Matching jurisdiction IDs.
 * @param array<int, \Drupal\group\Entity\GroupInterface> $groups
 *   Loaded group entities keyed by ID.
 */
function _markaspot_fastmap_resolve_deepest_boundary_jurisdiction_id(array $matchedIds, array $groups): int|false {
  if (empty($matchedIds)) {
    return FALSE;
  }
  if (count($matchedIds) === 1) {
    return $matchedIds[0];
  }

  $parentIdsInSet = [];
  foreach ($groups as $group) {
    if (!$group instanceof GroupInterface || !in_array((int) $group->id(), $matchedIds, TRUE)) {
      continue;
    }
    if ($group->hasField('field_parent_jurisdiction') && !$group->get('field_parent_jurisdiction')->isEmpty()) {
      $parentIdsInSet[(int) $group->get('field_parent_jurisdiction')->target_id] = TRUE;
    }
  }

  foreach ($matchedIds as $id) {
    if (!isset($parentIdsInSet[$id])) {
      return $id;
    }
  }

  return $matchedIds[0];
}

/**
 * Gets a jurisdiction_id from query, form data, or JSON request content.
 */
function _markaspot_fastmap_get_request_jurisdiction_id(): ?int {
  $request = \Drupal::request();
  $jurisdictionId = $request->request->get('jurisdiction_id')
    ?? $request->query->get('jurisdiction_id');

  if (!$jurisdictionId) {
    $content = $request->getContent();
    if ($content) {
      $data = json_decode($content, TRUE);
      if (is_array($data)) {
        $jurisdictionId = $data['jurisdiction_id']
          ?? $data['jurisdiction']
          ?? $data['gid']
          ?? NULL;
      }
    }
  }

  return $jurisdictionId ? (int) $jurisdictionId : NULL;
}

/**
 * Checks that a jurisdiction is in the same tree as the category root.
 */
function _markaspot_fastmap_jurisdiction_matches_category_root(int $jurisdictionId, ?int $categoryRootId): bool {
  if ($categoryRootId === NULL || $jurisdictionId === $categoryRootId) {
    return TRUE;
  }

  if (!\Drupal::hasService('markaspot_group.hierarchy_resolver')) {
    return FALSE;
  }

  /** @var \Drupal\markaspot_group\Service\JurisdictionHierarchyResolverInterface $resolver */
  $resolver = \Drupal::service('markaspot_group.hierarchy_resolver');
  return $resolver->getRootJurisdictionId($jurisdictionId) === $categoryRootId;
}

/**
 * Resolves the jurisdiction group a service_request node belongs to.
 *
 * Single source of truth for jurisdiction resolution on save: boundary match
 * first, then explicit request jurisdiction (Open311 payload), then a
 * pre-stamped field_jurisdiction value, then category-root fallback. Returns
 * NULL when no jurisdiction can be resolved. Used by both the demo-compliance
 * gate and the tier-limit enforcement path in hook_node_presave().
 */
function _markaspot_fastmap_resolve_jurisdiction_group_for_node(NodeInterface $node): ?GroupInterface {
  $group = NULL;
  $categoryRootId = _markaspot_fastmap_resolve_category_root_jurisdiction_id($node);
  $boundaryJurisdictionId = _markaspot_fastmap_resolve_boundary_jurisdiction_id($node);
  if ($boundaryJurisdictionId) {
    $group = \Drupal::entityTypeManager()
      ->getStorage('group')
      ->load($boundaryJurisdictionId);
  }

  // Prefer explicit request jurisdiction over a pre-stamped field. Open311
  // carries the selected workspace in request data, while field_jurisdiction
  // may still be root/default before group insert hooks run.
  if (!$group && $jurisdictionId = _markaspot_fastmap_get_request_jurisdiction_id()) {
    $group = _markaspot_fastmap_load_allowed_jurisdiction_group((int) $jurisdictionId, $categoryRootId, $boundaryJurisdictionId);
  }

  if ($node->hasField('field_jurisdiction') && !$node->get('field_jurisdiction')->isEmpty()) {
    $fieldJurisdictionId = (int) $node->get('field_jurisdiction')->target_id;
    if (!$group && $fieldJurisdictionId && _markaspot_fastmap_resolve_allowed_jurisdiction_id($fieldJurisdictionId, $categoryRootId, $boundaryJurisdictionId)) {
      $group = $node->get('field_jurisdiction')->entity;
    }
  }

  // Final fallback: use the category root jurisdiction directly.
  if (!$group && $categoryRootId) {
    $group = \Drupal::entityTypeManager()
      ->getStorage('group')
      ->load($categoryRootId);
  }

  return $group instanceof GroupInterface ? $group : NULL;
}

/**
 * Checks whether a workspace is in demo state (GDPR demo-compliance gate).
 *
 * A workspace is in demo state when it has an expiry date set AND no Stripe
 * subscription. Empty/missing expiry means permanent. Existing subscription
 * (even with a checkout grace expiry) means activated. field_tier is not
 * considered: free permanent workspaces are activated, not demo.
 */
function _markaspot_fastmap_workspace_in_demo_state(GroupInterface $group): bool {
  if (!$group->hasField('field_expiry_date') || $group->get('field_expiry_date')->isEmpty()) {
    return FALSE;
  }
  // Treat a literal 0 expiry as "not in demo" because epoch 0 (1970-01-01) is
  // always in the past and unambiguously not a future expiry timestamp.
  if ((int) $group->get('field_expiry_date')->value <= 0) {
    return FALSE;
  }
  if (!$group->hasField('field_stripe_subscription_id')) {
    return TRUE;
  }
  if ($group->get('field_stripe_subscription_id')->isEmpty()) {
    return TRUE;
  }
  // Whitespace-only subscription ID is not a real activation.
  return trim((string) $group->get('field_stripe_subscription_id')->value) === '';
}

/**
 * Implements hook_entity_type_alter().
 */
function markaspot_fastmap_entity_type_alter(array &$entity_types): void {
  if (isset($entity_types['node'])) {
    $entity_types['node']->addConstraint('TierLimit');
  }
}

/**
 * Implements hook_markaspot_nuxt_settings_alter().
 */
function markaspot_fastmap_markaspot_nuxt_settings_alter(array &$settings, $group): void {
  if ($group && $group->hasField('field_tier') && !$group->get('field_tier')->isEmpty()) {
    $settings['jurisdiction']['tier'] = $group->get('field_tier')->value;
  }

  // Workspace visibility (public, submission_only, authenticated).
  if ($group && $group->hasField('field_visibility') && !$group->get('field_visibility')->isEmpty()) {
    $settings['jurisdiction']['visibility'] = $group->get('field_visibility')->value;
  }
  else {
    $settings['jurisdiction']['visibility'] = 'public';
  }

  // Whether the workspace is permanent. This must use the same predicate as
  // the report publication gate: a Stripe customer only proves that checkout
  // started, not that a subscription activated the workspace.
  if ($group) {
    $has_stripe_customer = $group->hasField('field_stripe_customer_id') && !$group->get('field_stripe_customer_id')->isEmpty();
    $settings['jurisdiction']['is_permanent'] = !_markaspot_fastmap_workspace_in_demo_state($group);
    // Boolean signal that a Stripe customer is linked. Avoids leaking the
    // pseudonymous Stripe ID (PII under GDPR) through this public, cacheable
    // settings endpoint. The frontend useTierGating resolver only needs
    // truthiness to disambiguate enterprise workspaces from demo workspaces
    // in the tier=NULL state.
    $settings['jurisdiction']['has_stripe_customer'] = $has_stripe_customer;
  }

  // Workspace expiry timestamp (demo or checkout grace period).
  if ($group && $group->hasField('field_expiry_date') && !$group->get('field_expiry_date')->isEmpty()) {
    $settings['jurisdiction']['expiry_date'] = (int) $group->get('field_expiry_date')->value;
  }

  // AI budget: expose limit, used, and remaining to the frontend.
  if ($group && $group->hasField('field_tier')) {
    $tier = !$group->get('field_tier')->isEmpty()
      ? $group->get('field_tier')->value
      : 'free';

    /** @var \Drupal\markaspot_fastmap\Service\TierConfigService $tierConfig */
    $tierConfig = \Drupal::service('markaspot_fastmap.tier_config');
    $aiBudget = $tierConfig->getAIBudget($tier);
    $aiUsage = $tierConfig->countAIAnalyses((int) $group->id());

    $settings['jurisdiction']['ai_budget'] = [
      'limit' => $aiBudget,
      'used' => $aiUsage,
      // -1 signals unlimited to the frontend.
      'remaining' => $aiBudget === 0 ? -1 : max(0, $aiBudget - $aiUsage),
    ];
  }
}

/**
 * Implements hook_cron().
 *
 * Two hourly tasks:
 * 1. Enforces tier published-report limits retroactively (FIFO unpublish).
 * 2. Sends expiry reminders and deletes expired demo workspaces.
 *
 * Each task tracks its own last-run timestamp independently.
 */
function markaspot_fastmap_cron(): void {
  $state = \Drupal::state();
  $now = \Drupal::time()->getRequestTime();
  $entityTypeManager = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('markaspot_fastmap');

  // --- Tier limit enforcement (once per hour). ---
  $lastLimitCheck = (int) $state->get('markaspot_fastmap.last_limit_check', 0);
  if (($now - $lastLimitCheck) >= 3600) {
    $state->set('markaspot_fastmap.last_limit_check', $now);

    /** @var \Drupal\markaspot_fastmap\Service\TierConfigService $tierConfig */
    $tierConfig = \Drupal::service('markaspot_fastmap.tier_config');

    $groupIds = $entityTypeManager->getStorage('group')->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', _markaspot_fastmap_jurisdiction_group_type())
      ->exists('field_tier')
      ->execute();

    if (!empty($groupIds)) {
      $groups = $entityTypeManager->getStorage('group')->loadMultiple($groupIds);

      foreach ($groups as $group) {
        $tier = !$group->get('field_tier')->isEmpty()
          ? $group->get('field_tier')->value
          : 'free';

        $tierLimits = $tierConfig->getLimits($tier);

        if ($tierLimits === NULL || !empty($tierLimits['unlimited'])) {
          continue;
        }

        if ($tierLimits['period'] !== 'published') {
          continue;
        }

        $gid = (int) $group->id();
        $limit = $tierLimits['limit'];
        $count = $tierConfig->countRequests($gid, 'published');

        if ($count <= $limit) {
          continue;
        }

        $excess = $count - $limit;

        $nids = $entityTypeManager->getStorage('node')->getQuery()
          ->accessCheck(FALSE)
          ->condition('type', 'service_request')
          ->condition('status', 1)
          ->condition('field_jurisdiction', $gid)
          ->sort('created', 'ASC')
          ->range(0, $excess)
          ->execute();

        if (empty($nids)) {
          continue;
        }

        $nodes = $entityTypeManager->getStorage('node')->loadMultiple($nids);
        $unpublished = 0;

        foreach ($nodes as $node) {
          $node->setUnpublished();
          $node->save();
          $unpublished++;
        }

        \Drupal::service('cache_tags.invalidator')
          ->invalidateTags(['group:' . $gid]);

        $logger->notice(
          'Cron: unpublished @unpublished excess reports for jurisdiction @jid (@count/@limit published).',
          [
            '@unpublished' => $unpublished,
            '@jid' => $gid,
            '@count' => $count,
            '@limit' => $limit,
          ]
        );
      }
    }
  }

  // --- Demo workspace cleanup (once per hour). ---
  $demoLastRun = (int) $state->get('markaspot_fastmap.last_demo_cleanup', 0);
  if (($now - $demoLastRun) >= 3600) {
    $state->set('markaspot_fastmap.last_demo_cleanup', $now);

    $groupStorage = $entityTypeManager->getStorage('group');

    // Send reminder emails for workspaces expiring within 24 hours.
    $reminderThreshold = $now + 86400;
    $reminderIds = $groupStorage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', _markaspot_fastmap_jurisdiction_group_type())
      ->condition('field_expiry_date', $now, '>')
      ->condition('field_expiry_date', $reminderThreshold, '<=')
      ->execute();

    foreach ($groupStorage->loadMultiple($reminderIds) as $group) {
      // A successful subscription may briefly coexist with the checkout grace
      // expiry. It is activated, so it must not receive a demo-expiry notice.
      if (!_markaspot_fastmap_workspace_in_demo_state($group)) {
        continue;
      }
      $stateKey = 'markaspot_fastmap.demo_reminder_sent.' . $group->id();
      if (!$state->get($stateKey)) {
        // Resolve recipients: the workspace creator (tenant member) becomes the
        // To, the technical admin (uid 1) the Bcc. Demo workspaces are owned by
        // uid 1 and the 'jur' group type has creator_membership enabled, so
        // uid 1 is ALWAYS the first member — the previous "first member" pick
        // mailed the operator and the customer never heard about the expiry.
        // See _markaspot_fastmap_resolve_reminder_recipients() for the rule.
        $memberUsers = [];
        foreach ($group->getMembers() as $member) {
          $memberUser = $member->getUser();
          if ($memberUser !== NULL) {
            $memberUsers[] = $memberUser;
          }
        }
        $recipients = _markaspot_fastmap_resolve_reminder_recipients($memberUsers);
        if ($recipients !== NULL) {
          $toUser = $recipients['to'];
          $params = [
            'workspace_name' => $group->label(),
            'workspace_slug' => $group->hasField('field_slug') ? ($group->get('field_slug')->value ?? '') : '',
            'expiry_date' => \Drupal::service('date.formatter')->format(
              (int) $group->get('field_expiry_date')->value,
              'medium'
            ),
          ];
          if ($recipients['bcc'] !== '') {
            $params['bcc'] = $recipients['bcc'];
          }
          \Drupal::service('plugin.manager.mail')->mail(
            'markaspot_fastmap',
            'demo_expiry_reminder',
            $toUser->getEmail(),
            $toUser->getPreferredLangcode(),
            $params
          );
        }
        $state->set($stateKey, TRUE);
      }
    }

    // Delete expired workspaces.
    $expiredIds = $groupStorage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', _markaspot_fastmap_jurisdiction_group_type())
      ->condition('field_expiry_date', $now, '<=')
      ->execute();

    if (!empty($expiredIds)) {
      $provisioning = \Drupal::service('markaspot_fastmap.workspace_provisioning');
      foreach ($groupStorage->loadMultiple($expiredIds) as $expiredGroupId => $group) {
        // EntityQuery can only select by expiry. Recheck the canonical demo
        // predicate before teardown so a persisted grace expiry never deletes
        // an activated workspace with a valid Stripe subscription.
        if (!_markaspot_fastmap_workspace_in_demo_state($group)) {
          continue;
        }
        $logger->notice('Auto-deleting expired demo workspace @id.', ['@id' => $expiredGroupId]);
        $state->delete('markaspot_fastmap.demo_reminder_sent.' . $expiredGroupId);
        $provisioning->teardownWorkspace((int) $expiredGroupId);
      }
    }
  }

  // --- AI usage cleanup: delete records older than 2 months (once daily). ---
  $aiCleanupLastRun = (int) $state->get('markaspot_fastmap.last_ai_usage_cleanup', 0);
  if (($now - $aiCleanupLastRun) >= 86400) {
    $state->set('markaspot_fastmap.last_ai_usage_cleanup', $now);

    $twoMonthsAgo = (int) strtotime('first day of -2 months 00:00:00', $now);
    /** @var \Drupal\markaspot_fastmap\Service\TierConfigService $tierConfig */
    $aiTierConfig = \Drupal::service('markaspot_fastmap.tier_config');
    $deleted = $aiTierConfig->pruneAIUsage($twoMonthsAgo);

    if ($deleted > 0) {
      $logger->notice('AI usage cleanup: removed @count records older than 2 months.', [
        '@count' => $deleted,
      ]);
    }
  }
}

/**
 * Resolves the To + Bcc recipients for a demo-expiry reminder.
 *
 * Demo workspaces are created with uid 1 as the technical owner, and the
 * 'jur' group type enables creator_membership, so uid 1 is always present as
 * a member (and, being created first, would win a naive "first member" pick).
 * The reminder must reach the workspace creator — the tenant member added
 * during provisioning — while uid 1 (the operator) is kept as a silent Bcc.
 *
 * Rules:
 *   - To  = first member with an email whose uid is not 1 (the creator).
 *           Falls back to uid 1 when no such member exists, so the reminder is
 *           never silently dropped on a malformed workspace.
 *   - Bcc = uid 1's email, but only when a distinct tenant member is the To.
 *           Empty when uid 1 is itself the To (no self-Bcc) or absent.
 *
 * @param \Drupal\user\UserInterface[] $memberUsers
 *   The workspace group's member users (already resolved, may include users
 *   without an email address, which are skipped).
 *
 * @return array{to: \Drupal\user\UserInterface, bcc: string}|null
 *   The resolved recipients, or NULL when no member carries an email.
 */
function _markaspot_fastmap_resolve_reminder_recipients(array $memberUsers): ?array {
  $ownerUser = NULL;
  $tenantUser = NULL;
  foreach ($memberUsers as $user) {
    if (!$user instanceof UserInterface || !$user->getEmail()) {
      continue;
    }
    if ((int) $user->id() === 1) {
      $ownerUser = $user;
    }
    elseif ($tenantUser === NULL) {
      $tenantUser = $user;
    }
  }

  $toUser = $tenantUser ?? $ownerUser;
  if ($toUser === NULL) {
    return NULL;
  }

  $bcc = ($tenantUser !== NULL && $ownerUser !== NULL)
    ? (string) $ownerUser->getEmail()
    : '';

  return ['to' => $toUser, 'bcc' => $bcc];
}

/**
 * Gets the configured jurisdiction group type.
 */
function _markaspot_fastmap_jurisdiction_group_type(): string {
  return \Drupal::config('markaspot_open311.settings')
    ->get('jurisdiction_group_type') ?: 'jur';
}

/**
 * Checks whether a group uses the configured jurisdiction type.
 */
function _markaspot_fastmap_is_jurisdiction_group(mixed $group): bool {
  return $group instanceof GroupInterface
    && $group->bundle() === _markaspot_fastmap_jurisdiction_group_type();
}
