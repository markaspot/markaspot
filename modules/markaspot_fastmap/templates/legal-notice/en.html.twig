{#
/**
 * @file
 * English legal notice template (Imprint) - structurally TMG §5 conforming.
 *
 * Available variables:
 * - operator_name: string (HTML-escaped legal operator name)
 * - address_line1, address_line2: string (escaped)
 * - postal_code, city, country: string (escaped)
 * - email: string (escaped contact email)
 * - tax_id: string (escaped VAT-ID)
 * - has_complete_data: bool — false when one of name/address/email is empty
 *
 * Operators can opt out of auto-regeneration by inserting the comment
 * <!-- manual-override --> anywhere in the saved field value.
 */
#}
<h2>Imprint</h2>

<p>Information pursuant to § 5 TMG (German Telemedia Act):</p>

<p class="legal-notice-address">
  {{ operator_name ?: '[Company name not yet provided]' }}<br>
  {{ address_line1 ?: '[Address not yet provided]' }}<br>
  {% if address_line2 %}{{ address_line2 }}<br>{% endif %}
  {{ postal_code }} {{ city }}<br>
  {{ country }}
</p>

<h3>Contact</h3>
<p>
  Email:
  {% if email %}
    <a href="mailto:{{ email }}">{{ email }}</a>
  {% else %}
    [Email not yet provided]
  {% endif %}
</p>

{% if tax_id %}
<h3>VAT ID</h3>
<p>VAT identification number pursuant to § 27 a German VAT Act: {{ tax_id }}</p>
{% endif %}

{% if not has_complete_data %}
<p><em>Note: This imprint is incomplete. Please complete the billing data in the workspace settings to publish a TMG-conforming imprint.</em></p>
{% endif %}
