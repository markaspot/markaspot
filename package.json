{
  "name": "markaspot",
  "version": "11.9.80",
  "private": true,
  "description": "Mark-a-Spot Drupal Installation Profile",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markaspot/markaspot.git"
  },
  "scripts": {
